v":["喜欢 ",["f","ConcessionLike.png",24]]}],[["其他一切"]]]]]}]]]]],["好感度事件",2,[]],["邮寄礼物",3,[["p",["当潘姆对玩家的",["l","友谊","好感度"],"大于0，潘姆就有可能会给玩家邮寄一份礼物。好感度越高，收到礼物的可能性越大。"]],["d","详情",[["t",[[{"h":1,"v":["物品"]},{"h":1,"v":["信件内容"]}],[[["i","(O)787","电池组"],["i","(O)346","啤酒"],["i","(O)349","能量滋补水"]],["嘿。\n我在抽屉里找到了这个。我想你可能用得着。 \n-潘姆"]]]]]]]],["3心事件",3,[["p",["与潘姆好感度到达3心后，她将通过信件赠送一份食谱。"]],["d","详情",[["t",[[{"h":1,"v":["食谱"]},{"h":1,"v":["信件内容"]}],[[["l","乳酪花椰菜","乳酪花椰菜"]],["孩子你好，\n这是我老爸常做的一道小菜的配方。要小火慢炖才行。\n-潘姆"]]]]]]]],["7心事件",3,[["p",["与潘姆好感度到达7心后，她将通过信件赠送一份食谱。"]],["d","详情",[["t",[[{"h":1,"v":["食谱"]},{"h":1,"v":["信件内容"]}],[[["l","塞料面包","塞料面包"]],["孩子你好，\n这是我老爸常做的一道小菜的配方。要小火慢炖才行。 \n-潘姆"]]]]]]]],["9心事件",3,[["p",["在",["l","木匠的商店","木匠的商店"],"购入“社区升级”，待完成后四日，且与潘姆达到9心后到访她家。与她是否在家无关（因为如果公交修复，她几乎总是不在家的）。"]],["d","详情",[["p",["她正在船标前祈祷。她为无法戒酒而忏悔。她希望神能帮助她戒酒。\n我很高兴你又有了希望。（不影响好感度）"]],["p",["她表示在晚年终于高兴了一回。"]],["p",["很抱歉，但神并不存在……（好感度 -1000）"]],["p",["她说你侮辱了她的信仰，把你赶走了。"]]]],["p",["船标之后会出现在新房子二楼的餐桌右边，玩家可以使用工具敲击获得。"]]]],["对话",2,[["d","常规",[["p",["初次见面"]],["q",["你好，孩子。我叫潘姆。只要你态度不恶劣，我们一定会成为朋友的。"],[]],["p",["日常"]],["q",["如果有钱的话，谁不想吃得健康点啊。喂，你那农场上一定种了不少好吃的，对吧？"],[]],["q",["喂！你可不要趁我不在偷偷溜进我的房车！懂了吗？不好意思，只是不太信得过陌生人而已。"],[]],["q",["我今天早上本来是在读报纸的，结果搞得很郁闷。这世界简直是烂透了。你也得当心啊，不然早晚会搞得头破血流……我老爸以前一直对我这么说。呵呵。"],[]],["q",["最近我过得不太好。前几天被公司给辞了，丢了巴士司机的工作。如果能重新当回巴士司机，就能载你去卡利科沙漠了。"],[]],["q",["虽然我这房子不怎么样，但至少就在河边。"],[]],["q",["潘姆似乎睡过去了。还是不要打扰她吧。"],[]],["q",["潘妮说我在酒吧待的时间太久了……"],[]],["q",["其实，我一直在想……要是自己有个什么爱好就好了。这样也就不会每天晚上都去酒吧鬼混。你有没有什么好主意？……唔，要么我自己和自己下五子棋怎么样？"],[]],["q",["每天都是这么的单调，简直无聊透顶……如果出生在有钱人家就好了……"],[]],["q",["进来之前，你最好在门口把鞋上的泥都擦干净。擦地板实在是太麻烦了。你也应该体谅一下。"],[]],["q",["如果每天晚上有些小妖精出来替我打扫房间就好了。\n还真想吃些防风草呢。\n如果我的腿没事的话，偶尔也想去山里看看呢。"],[]],["p",["雨天"]],["q",["孩子，你好啊。没被淋湿吧？"],[]],["p",["绿雨"]],["l",0,[[2,["第一年"]]]],["q",["这是上帝的信号……我们要完蛋了……"],[]],["l",0,[[2,["第二年及以后"]]]],["q",["我觉得这场雨是在宣示力量……是一种告诫。\n至于是来自大自然还是来自由巴，这就随便你怎么想了……反正我觉得是这样。\n说白了就是咱们不能太狂妄，不然下的可能不是绿雨而是血雨了……懂我意思不？"],[]],["p",["醉酒"]],["q",["噢……我的头……"],[]],["q",["唉唉……昨晚稍微喝多了些，现在不舒服……快走开。"],[]],["p",["巴士恢复运营"]],["q",["嘿，你听说过那辆老巴士吗？听说过...我又坐上驾驶座了，孩子...嘿嘿。感觉不错。"],[]],["q",["这巴士重新开始运行，我真是再高兴不过了！感觉整个人又活了过来。"],[]],["p",["玩家与",["l","潘妮","潘妮"],"结婚后"]],["q",["一个人在拖车里面简直孤独得可怕……"],[]],["q",["喂。你在农场里一定要好好对待潘妮。我就只剩她一个人了！"],[]],["q",["我除了潘妮一无所有。你可要好好待她。"],[]],["p",["看医生"]],["q",["嘟囔*……自以为无所不知的医生……*嘟囔*"],[]],["q",["我每天喝了多少酒？这算哪门子问题？"],[]],["p",["社区升级，不匿名"]],["q",["不敢相信，你给我买了房子！有什么陷井（原文如此）吗？对不起，我还不习惯人们对我这么好..."],[]],["p",["社区升级，匿名"]],["q",["我不敢相信有人给我买了房子！我想知道这是不是某种骗局？对不起，我还不习惯人们对我这么好..."],[]],["p",["在酒吧里"]],["q",["我这把老骨头，就靠喝点小酒才能暖和过来……"],[]],["q",["你好，孩子。如果我有钱的话，一定请你喝一杯！"],[]],["q",["喂，格斯！再来一杯！*打嗝*"],[]],["q",["唉* ……喂，小子，你这样的年轻人不该在这里逛游。"],[]],["q",["大口喝酒*……一下午就盼着能来这里喝一口了。呵呵。"],[]],["q",["格斯！最烈的酒再给我来一杯！"],[]],["q",["潘姆没有任何反应。"],[]],["q",["潘姆似乎睡过去了。还是不要打扰她吧。"],[]],["p",["夏季"]],["q",["你好啊，陌生人。"],[]],["q",["哦，这位是（玩家名）先生。^哦，这位是（玩家名）小姐。需要我帮你做些什么吗？"],[]],["q",["当地拥有一座农场对小镇来说可是件好事。"],[]],["q",["如果你的农场景气的话，或许当地的经济也会好转。然后大家就都有工作了，然后就皆大欢喜了不是吗？"],[]],["q",["你好啊，农夫。我不太习惯和陌生人讲话。"],[]],["q",["我总是不知不觉得就跑到酒吧坐坐。大概是离我家太近了吧。这生活方式太不健康。"],[]],["q",["别怕附近那条狗。虽然看起来可能有点凶，不过那狗是不会冲过来咬你的。你想知道那狗叫什么？就叫达斯迪啊。"],[]],["q",["有人在到处抱怨我的院子太乱。是你吗？嗯……"],[]],["p",["男性玩家"]],["q",["……是吗？你这小伙子年轻英俊，干嘛要来和我这老女人搭讪？"],[]],["p",["女性玩家"]],["q",["你这么年轻貌美，为什么要来特意和我说话？"],[]],["p",["好感度 6 心以上"]],["q",["我以前也像你一样，有梦想也有希望……现在还不是落得这个下场。生活总是不尽人意。不过话说回来，在这里自怨自艾也不是办法。"],[]],["p",["秋季"]],["q",["如果和你更熟的话，可能会更谈的开吧。"],[]],["q",["别看我现在这样，很久以前我也像你这么年轻呢。人老了，感觉时间也过得飞快。"],[]],["q",["唉* ……看来今天的晚餐又要吃速冻食品了。"],[]],["q",["嘿。潘妮可是我的宝贝女儿，你别欺负她，知道了吗？"],[]],["q",["每天都是一成不变……你有没有这么觉得呢，农夫？"],[]],["q",["你能不能帮帮忙，打扫一下我家？说笑呢。"],[]],["q",["你没活干吗？有工作就知足吧，至少不用每天在镇上游荡。"],[]],["q",["真想念以前当卡车司机的时候。以前我开着大卡到处跑，能见到各种各样的人，还能天天听广播。人生真是说变就变呢。"],[]],["p",["冬季"]],["q",["你的农场有没有野猪？"],[]],["q",["你找我是想要点什么吗？还是去别处吧。"],[]],["q",["我就是想让潘妮以后有好日子过。等你有了自己的孩子，就明白我的心情了。\n……冬天还真是干燥。感觉皮肤都皱成了羊皮纸。"],[]],["q",["喂，孩子！你这是要去干什么？我只是和平常一样，消磨时间而已。"],[]],["q",["今天还真是冷。或许去酒吧一趟，喝几杯就暖和了。呵呵。不如你晚上也来酒吧坐坐，和我一起喝两杯？"],[]],["q",["潘妮还真是喜欢旧书。我小时候脑子可没她那么聪明。我很欣慰。"],[]],["q",["河就在眼前，我是不是该学学钓鱼……"],[]],["q",["啊啊……我的前院还真乱。"],[]],["p",["在",["l","姜岛","姜岛"],"上"]],["q",["看来周围有不少罕见的鱼，下次我必须得把鱼竿带上！"],[]],["q",["啊……在路上，威利给每个人分了一块鱼干，非常美味！"],[]],["q",["真是舒服啊！我想把鞋子也脱掉！孩子，最好别凑近了看我的脚。"],[]],["q",["孩子，情况特殊……我要点一杯特别的。要烈一点的！"],[]]]],["d","节日",[["p",[["l","复活节","复活节"]]],["p",["奇数年"]],["q",["哈哈……我在潘趣酒里加了料。嘘……别告诉其他人哦，小伙子。"],[]],["p",["偶数年"]],["q",["嘿……孩子，如果你要让我吃鸡蛋的话，我还要配一点辣酱！"],[]],["p",[["l","沙漠节","沙漠节"]]],["q",["哎，孩子……你今天休息吗？偶尔放松一下也挺好的，是不是？\n对啊……即使是我这把老骨头偶尔也要晒晒太阳！在我晒干之前叫醒我就行……呵呵……"],[]],["p",[["l","花舞节","花舞节"]]],["p",["奇数年"]],["q",["这才是生活嘛……对吧，小子？小桥美酒人家……咦，我说美酒来着吗？"],[]],["p",["偶数年"]],["q",["风中飘散着红色果冻，就像在跳舞一样！\n呃……我大概是喝醉了吧。"],[]],["p",[["l","夏威夷宴会","夏威夷宴会"]]],["p",["奇数年"]],["q",["嘿嘿……免费大餐。住在星露谷真是福利多多啊。好好享受吧，小子！"],[]],["p",["偶数年"]],["q",["（咕嘟咕嘟）太棒啦！这个我要多来一点！"],[]],["p",[["l","月光水母起舞","月光水母起舞"]]],["p",["奇数年"]],["q",["今晚没有大餐我好失望啊，不过你别告诉格斯。"],[]],["p",["偶数年"]],["q",["哎，孩子，你经营着农场吧，我问你……用这些玩意儿能做果酱吗？\n可以的话，我用来涂面包就能省不少钱！"],[]],["p",[["l","星露谷展览会","星露谷展览会"]]],["p",["奇数年"]],["q",["最好快点，孩子……在老潘姆来这儿之前把帐篷里所有大鱼都钓走！呵呵。"],[]],["p",["偶数年"]],["q",["孩子，这生活真是太好了！"],[]],["p",[["l","万灵节","万灵节"]]],["p",["奇数年"]],["q",["凡是有免费食物可以吃吃吃的活动我都会去！不过闹鬼迷宫什么的就别算上我了。"],[]],["p",["偶数年"]],["q",["再来一瓶一瓶南瓜啤酒！……嗝……"],[]],["p",[["l","冰雪节","冰雪节"]]],["p",["奇数年"]],["q",["我想赢得冰钓比赛！可是威利不是吃素的……钓鱼对他来说是家常便饭。"],[]],["p",["偶数年"]],["q",["我去年输了是因为我选的地方不好，我感觉今年会很顺利。"],[]],["p",["我觉得在哪里都一样。（不影响好感度）"]],["p",["无所谓，我会赢你的。（不影响好感度）"]],["p",["嗯，祝你好运。（不影响好感度）\n“祝你也好运，孩子。”"]],["p",[["l","鱿鱼节","鱿鱼节"]]],["q",["我没有钓鱿鱼的本事，不过没关系，我会在这里为你加油的。"],[]],["p",[["l","冬日星盛宴","冬日星盛宴"]]],["p",["奇数年"]],["q",["唉……没有赢得冰钓比赛，我好难过。"],[]],["p",["偶数年"]],["q",["大冷天只有喝一杯热酒才能让我暖和起来！"],[]]]]]],["肖像",2,[["g",[["Pam.png",64,[]],["Pam_Happy.png",64,[]],["Pam_Concerned.png",64,[]],["Pam_Neutral.png",64,[]],["Pam_Annoyed.png",64,[]],["Pam_Winter_00.png",64,[]],["Pam_Winter_01.png",64,[]],["Pam_Winter_02.png",64,[]],["Pam_Winter_04.png",64,[]],["Pam_Winter_03.png",64,[]],["Pam_Beach.png",64,[]],["Pam_Beach_Happy.png",64,[]],["Pam_Beach_Concerned.png",64,[]],["Pam_Beach_Neutral.png",64,[]],["Pam_Beach_Annoyed.png",64,[]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.3","1.3"],"：新增9心事件。改变了巴士站的动画。"]],[1,[["l","版本历史#1.4","1.4"],"：修正了所有菜谱会在3颗友谊之心时发送的错误。"]],[1,[["l","版本历史#1.5","1.5"],"：新增海滩肖像。"]],[1,[["l","版本历史#1.6","1.6"],"：新增冬季肖像。新增收到特定礼物时的对话。现在如果潘姆由于某种原因不会来",["l","巴士站","巴士站"],"，她会留下一个告示通知你，并且你可以自己开车去",["l","沙漠","卡利科沙漠"],"。潘姆现在对Joja可乐的喜好为普通。"]]]]]]]}