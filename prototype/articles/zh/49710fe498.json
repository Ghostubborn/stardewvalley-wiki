{"s":[[null,1,[["p",["宝藏图腾是一种",["l","打造","消耗品"],"，",["l","打造","打造"],"配方在达到",["l","精通山洞","采集精通"],"后获得。当在室外可挖掘的地块上使用时，它会在",["l","玩家角色","玩家"],"周围的一个圆圈中产生 16 个",["l","远古斑点","远古斑点"],"：在北部、东部、南部和西部各生成 3 个，在东北部、东南部、西南部和西北部各生成 1 个。如果有障碍物占据了某格地块，对应位置就不会生成远古斑点。"]]]],["送礼",2,[["t",[[{"h":1,"v":["讨厌"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","雷欧","雷欧"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"]]]]]]],["收集包",2,[["p",["宝藏图腾不被用于任何",["l","收集包","收集包"],"。"]]]],["裁制",2,[["p",["宝藏图腾可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成",["i","(H)44","图腾面具"],"。\n宝藏图腾可用于",["l","染色","染色"],"。放置在",["l","染色","染料罐"],"内时，可用作橙色染料。放置在",["l","染色","缝纫机"],"内时，宝藏图腾还可用作棕色染料。"]]]],["任务",2,[["p",["宝藏图腾不被用于任何",["l","任务","任务"],"。"]]]],["提示",2,[["p",["在",["l","姜岛","姜岛"],"的可挖掘地形使用宝藏图腾，并使用带有",["l","锻造","丰富"],"附魔的锄头，平均可产出价值3,000金的宝藏（这需要将获得的",["l","万象晶球","万象晶球"],"兑换为",["l","古物宝藏","古物宝藏"],"，并在",["l","采矿","铁匠"],"处砸开它们）。"]]]]]}