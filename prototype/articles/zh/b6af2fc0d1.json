{"s":[[null,1,[["p",["蒜油是一种可食用的",["l","打造#食物和药水","打造物品"],"，其制作配方可在达到战斗 6 级后获得。还可以在",["l","矮人#出售货物","矮人的商店"],"以3,000金购买。"]],["p",["旅行货车会以 3,000–5,000金 的价格随机出售。"]],["p",["喝下蒜油会获得一个持续 10 分钟的",["l","效果#Oil of Garlic","蒜油效果"],"，这种效果是一种特殊的效果，它不会被其它的饮料的效果覆盖，反之亦然。蒜油效果会使得玩家来到",["l","矿井","矿井"],"时不会再刷新",["l","怪物","怪物"],"，除了",["l","矿井#采石场层","采石场层"],"。在",["l","骷髅洞穴","骷髅洞穴"],"中，该效果会阻止",["l","矿井#史莱姆层","史莱姆层"],"与",["l","矿井#怪物层","怪物层"],"的怪物生成，但不影响",["l","骷髅洞穴#恐龙层","恐龙层"],"生成。该效果也能防止任何层内生成",["l","矿井#群虫攻击","群虫攻击"],"。"]],["p",[["l","效果#Oil of Garlic","蒜油效果"],"在",["l","矿井#挑战之神庙","危险的矿井"],"和",["l","骷髅洞穴#骷髅洞穴入侵","危险的骷髅洞穴"],"中不会生效。"]],["p",["注意：这是一个可盈利的配方，但需要使用最低品质的原料。"]]]],["送礼",2,[["t",[[{"h":1,"v":["讨厌"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]]]]]],["裁制",2,[["p",["蒜油可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成可染色的 ",["l","裁缝","男款深色荧光衬衫"]," 或 ",["l","裁缝","女款深色荧光衬衫"],"。蒜油可用于",["l","染色","染色"],"。放置在",["l","染色#染料罐","染料罐"],"内时，蒜油可用作绿色染料。放置在",["l","染色#缝纫机","缝纫机"],"内时，蒜油还可用作黄绿色染料。"]]]],["任务",2,[["p",["蒜油不用于任何",["l","任务","任务"],"。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.4#1.4","1.4"],"：现在可用于",["l","裁缝","裁缝"],"。"]]]]]]],"f":[["来源",[["l","打造","打造"]," • ",["l","矮人","矮人"]]],["原料",[["i","(O)248","蒜×10"],["i","(O)247","油×1"]]],["售价",["1,000金"]]]}