{"s":[[null,1,[["p",["蕨菜是一种",["l","蔬菜","蔬菜"],"，也是唯一一种被划入蔬菜类别的可",["l","采集","采集"],"物品。可以在",["l","夏季","夏季"],"的",["l","秘密森林","秘密森林"],"里、",["l","姜岛东部","姜岛东部"],"的丛林里或",["l","骷髅洞穴#恐龙层","骷髅洞穴的恐龙层"],["l","采集","采集"],"获得。也可以在",["l","绿雨树","蕨菜树"],"上放置树液采集器或在",["l","天气","绿雨"],"时砍伐蕨菜树获得。在激活了",["l","矿井#挑战之神庙","挑战之神庙"],"，或处于",["l","任务#Danger In The Deep","“深处的危险”任务"],"期间，在",["l","矿井","矿井"],"（ 41~69 层）中也有可能生成蕨菜。"]],["p",["旅行货车会以 270–1,000金 的价格随机出售。",["l","沙漠节","沙漠节"],"期间，",["l","肯特","肯特"],"也会在其",["l","沙漠节#村民商铺","商铺"],"以10卡利科蛋 ",["l","卡利科三花蛋","卡利科三花蛋"],"的价格出售蕨菜（限 5 个）。"]],["p",["由于蕨菜在游戏内的分类是蔬菜，因此它的售价和其他",["l","农作物","农作物"],"一样受到",["l","技能#耕种","农耕人"],"职业加成影响。蕨菜又同时作为一种可采集物品，也会受到多个相关的",["l","采集#采集技能","采集技能"],"的增益影响，例如",["l","采集#采集技能","收集者"],"20% 的双倍采集收获，以及",["l","采集#采集技能","植物学家"],"所有采集物品均为铱星品质的效果。"]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","哈维","哈维"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","威利","威利"],"、",["l","法师","法师"]]],[{"h":1,"v":["不喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","山姆","山姆"],"、",["l","文森特","文森特"]]]]]]],["收集包",2,[["l",0,[[1,["厨师收集包需要 1 个蕨菜；"]],[1,["野生药材收集包需要 5 个蕨菜（作为可选项）。"]]]]]],["食谱",2,[["t",[[{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["所需原料"]},{"h":1,"v":["能量 / 生命值"]},{"h":1,"v":["食谱来源"]},{"h":1,"v":["售出价格"]}],[[["l","意式蕨菜炖饭","意式蕨菜炖饭"]],["香软的米饭拌上清炒的蕨菜芽。汤有点淡。"],[["i","(O)247","油×1"],["i","(O)259","蕨菜×1"],["i","(O)248","蒜×1"]],["能量 225\n生命值 101"],["烹饪频道（偶数年秋季 28 日）"],["350金"]]]]]],["打造",2,[["p",["蕨菜不用于任何",["l","打造#可打造物品","配方"],"。"]]]],["裁制",2,[["p",["蕨菜可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","绿色背带裤"],"。蕨菜可用于",["l","染色","染色"],"。放置在",["l","染色#染料罐","染料罐"],"内时，蕨菜可用作绿色染料。放置在",["l","染色#缝纫机","缝纫机"],"内时，蕨菜还可用作绿色染料，染色强度为强烈。"]]]],["任务",2,[["p",["蕨菜不用于任何",["l","任务","任务"],"。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.4#1.4","1.4"],"：现在可在骷髅洞穴中找到蕨菜。现在在缝纫中可用。"]],[1,[["l","版本历史/1.5#1.5","1.5"],"：现在可在姜岛东部找到蕨菜。现在是野生药材收集包的选项物品之一。"]],[1,[["l","版本历史#1.6","1.6"],"：现在可以通过",["l","绿雨树#种类3","绿雨树（种类3）"],"获得。现在可以在",["l","沙漠节","沙漠节"],"期间获得。"]]]]]]],"f":[["来源",[["l","采集","采集"]]],["季节",["夏季（秘密森林）\n任意季节（",["l","姜岛东部","姜岛东部"],"、",["l","骷髅洞穴","骷髅洞穴"],"和",["l","矿井#挑战之神庙","危险矿井"],"）"]],["售价",["90金"]]]}