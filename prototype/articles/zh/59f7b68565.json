{"s":[[null,1,[["p",["蕨菜是唯一一种被划入蔬菜类别的可采集物品。所以作为一种蔬菜，蕨菜的售价会因为",["l","耕种#耕种技能","“农耕人”职业"],"而获得10%的提升，并且可以放入",["l","小桶","小桶"],"或者",["l","罐头瓶","罐头瓶"],"进一步加工成",["l","果汁","果汁"],"或者",["l","果酱和腌菜","腌菜"],"。同时作为一种可采集物品，蕨菜也会受到多个相关的",["l","采集#采集技能","采集技能"],"的增益影响。具体来说，每采集到一个蕨菜，可以获得7点",["l","采集#经验点数","采集经验值"],"。蕨菜会受到",["l","采集#采集技能","采集等级 5（收集者）"],"的双倍采集获得物和",["l","采集#采集技能","采集等级 10（植物学家）"],"的所有采集物为铱星品质的增益效果。"]],["p",["蕨菜可以通过以下方式获得："]],["l",0,[[1,["在",["l","夏季","夏季"],"的",["l","秘密森林","秘密森林"],["l","采集","采集"],"。"]],[1,["在",["l","姜岛#岛屿东部","姜岛的丛林区"],"采集。"]],[1,["在",["l","骷髅洞穴#史前层","骷髅洞穴的史前层"],"采集。"]],[1,["当",["l","矿井#挑战之神庙","挑战之神庙"],"被激活时，在",["l","矿井","矿井"],"的41-69层采集。"]],[1,["偶尔出现在",["l","旅行货车","旅行货车"],"的商品列表中，售价270–1,000金。"]],[1,["在",["l","天气","绿雨"],"日期间砍伐",["l","绿雨树#种类3","绿雨树（种类3）"],"。"]],[1,["把",["l","树液采集器","树液采集器"],"放置在蕨菜形状的",["l","绿雨树#种类3","绿雨树"],"上提取。"]],[1,[["l","沙漠节","沙漠节"],"期间在",["l","肯特","肯特"],"的",["l","沙漠节#村民商铺","商铺"],"以10卡利科蛋 ",["l","卡利科三花蛋","卡利科三花蛋"],"购买（限5个）。"]]]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","雷欧","雷欧"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"]]],[{"h":1,"v":["不喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","山姆","山姆"]]]]]]],["收集包",2,[["l",0,[[1,["厨师收集包需要蕨菜。"]],[1,["野生药材收集包选项之一为5个蕨菜。"]]]]]],["食谱",2,[["t",[[{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["所需原料"]},{"h":1,"v":["能量 / 生命值"]},{"h":1,"v":["食谱来源"]},{"h":1,"v":["售出价格"]}],[[["l","意式蕨菜炖饭","意式蕨菜炖饭"]],["香软的米饭拌上清炒的蕨菜芽。汤有点淡。"],[["i","(O)247","油×1"],["i","(O)259","蕨菜×1"],["i","(O)248","蒜×1"]],["能量 225\n生命值 101"],["烹饪频道（偶数年秋28日）"],["350金"]]]]]],["裁制",2,[["p",["蕨菜可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","绿色背带裤"],"。蕨菜可用于",["l","染色","染色"],"。放置在",["l","染色#染料罐","染料罐"],"内时，蕨菜可用作绿色染料。放置在",["l","染色#缝纫机","缝纫机"],"内时，蕨菜还可用作绿色染料，染色强度为强烈。"]]]],["任务",2,[["p",["不用于任何求助任务。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.4","1.4"],"：现在可在骷髅洞穴中找到蕨菜。现在在缝纫中可用。"]],[1,[["l","版本历史#1.5","1.5"],"：现在可在姜岛东部找到蕨菜。现在是野生药材收集包的选项物品之一。"]],[1,[["l","版本历史#1.6","1.6"],"：现在可以通过",["l","绿雨树#种类3","绿雨树（种类3）"],"获得。现在可以在",["l","沙漠节","沙漠节"],"期间获得。"]]]]]]],"f":[["来源",[["l","采集","采集"]]],["季节",["夏季\n任意季节在",["l","姜岛#岛屿东部","姜岛丛林"],"、",["l","骷髅洞穴","骷髅洞穴"],"和",["l","矿井#挑战之神庙","危险矿井"]]],["售价",["90金"]]]}