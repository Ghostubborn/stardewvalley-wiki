{"s":[[null,1,[["p",["蔬菜是游戏内的一种物品类型，它们几乎都是通过",["l","耕种","耕种"],"获得的",["l","农作物","农作物"],"，",["l","蕨菜","蕨菜"],"是唯一的例外，它通过",["l","采集","采集"],"获得，但也被视为一种蔬菜。其他在现实生活中被视为蔬菜，但在游戏内被分类为",["l","采集","采集品"],"或其它分类的物品（例如",["l","韭葱","韭葱"],"、",["l","大葱","大葱"],"、",["l","辣椒","辣椒"],"等）不在此处列出。"]],["p",["所有蔬菜都具备以下共同特征："]],["l",0,[[1,["如果玩家有",["l","耕种","农耕人"],"职业，售价增加10%；"]],[1,["蔬菜可以放进",["l","罐头瓶","罐头瓶"],"中制成",["l","腌菜","腌菜"],"；"]],[1,["蔬菜可以放进",["l","小桶","小桶"],"中，大部分可制成",["l","果汁","果汁"],"，例外：",["l","小麦","小麦"],"产出",["l","啤酒","啤酒"],"、",["l","啤酒花","啤酒花"],"产出",["l","淡啤酒","淡啤酒"],"、",["l","茶叶","茶叶"],"产出",["l","绿茶","绿茶"],"；"]],[1,["蔬菜（",["l","小麦","小麦"],"、",["l","啤酒花","啤酒花"],"、",["l","茶叶","茶叶"],"、",["l","未碾米","未碾米"],"除外）是给",["l","居民","居民"],"送礼时",["l","友谊#喜欢的礼物","普遍喜欢的礼物"],"（除了",["l","阿比盖尔","阿比盖尔"],"、",["l","海莉","海莉"],"、",["l","山姆","山姆"],"、",["l","贾斯","贾斯"],"和",["l","文森特","文森特"],"的所有村民）。也有个别例外，详见：",["l","友谊#喜欢的礼物","喜欢的礼物中的例外"],"，以及个别蔬菜和村民的页面；"]],[1,["在",["l","星露谷展览会","星露谷展览会"],"的",["l","星露谷展览会#农庄展览","农庄展览"],"评分环节中，蔬菜是其中一项类别；"]],[1,["蔬菜可以通过",["l","出货箱","出货箱"],"以及",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"出售。通过",["l","出货箱","出货箱"],"出售过的物品会显示在",["l","收集品","收集品"],"中。"]]]],["p",["下表列出了游戏中的所有蔬菜，包括其获取方式、售价、以及使用",["l","罐头瓶","罐头瓶"],"或",["l","小桶","小桶"],"制成的",["l","工匠物品","工匠物品"],"的售价。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.5#1.5","1.5"],"：当使用",["l","顶级肥料","顶级肥料"],"时，可以获得铱星品质的农作物。"]],[1,[["l","版本历史#1.6","1.6"],"：新增蔬菜",["l","胡萝卜","胡萝卜"],"、",["l","金皮西葫芦","金皮西葫芦"],"和",["l","西蓝花","西蓝花"],"。"]]]]]]]}