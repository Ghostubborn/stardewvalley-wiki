{"s":[[null,1,[["p",["岛屿办事处 可以在",["l","姜岛","姜岛北部"],"找到。"]],["p",["在将",["l","蜗牛教授","蜗牛教授"],"从帐篷旁边的山洞救出来之前，岛屿办事处内部处于没有物品可交互的状态。在解救",["l","蜗牛教授","蜗牛教授"],"后，你就可以向他捐赠化石和回答靠近墙壁的",["l","岛屿办事处","岛屿调查"],"问题以获得",["l","金色核桃","金色核桃"],"。"]]]],["捐赠",2,[["p",["你可以在岛屿办事处捐赠化石或者木乃伊来重建4种动物的骨骼或身体形态。需要注意的是，部分部位的化石需要多块。"]],["p",["玩家可以通过捐赠界面选择“提示”来获得捐赠物品所在位置的提示。"]],["t",[[{"h":1,"v":["动物"]},{"h":1,"v":["物品"]},{"h":1,"v":["个数"]},{"h":1,"v":["获取途径和概率"]}],[{"r":5,"v":["熊"]},[["i","(O)823","腿骨化石"]],["2"],{"b":[["l",0,[[1,["开采",["l","姜岛","姜岛挖掘场"],"的",["l","采矿","骨头矿"]," (10%)"]]]]]}],[[["i","(O)824","肋骨化石"]],["1"],{"b":[["l",0,[[1,["开采",["l","姜岛","姜岛挖掘场"],"的",["l","采矿","骨头矿"]," (1.35%)"]],[1,["挖掘",["l","姜岛","姜岛南部"],"的",["l","远古斑点","远古斑点"]," (25%)"]]]]]}],[[["i","(O)820","颅骨化石"]],["1"],{"b":[["l",0,[[1,["打开",["l","金色椰子","金色椰子"]," (14%, 首次打开不会出现)"]]]]]}],[[["i","(O)821","脊柱化石"]],["1"],{"b":[["l",0,[[1,["在",["l","姜岛","姜岛挖掘场"],"旁的小河",["l","钓鱼","钓鱼"]," (10%)"]]]]]}],[[["i","(O)822","尾巴化石"]],["1"],{"b":[["l",0,[[1,["在",["l","姜岛","姜岛挖掘场"],"旁的小河",["l","淘盘","淘金"]," (20%)"]]]]]}],[["青蛙"],[["i","(O)828","青蛙木乃伊"]],["1"],{"b":[["l",0,[[1,["清除",["l","姜岛","姜岛东部丛林"],"内的",["l","杂草","杂草"]]],[1,["清除危险",["l","矿井","矿井"],"内部的可以掉落",["l","芋头块茎","芋头块茎"],"的杂草"]]]]]}],[["蝙蝠"],[["i","(O)827","蝙蝠木乃伊"]],["1"],{"b":[["l",0,[[1,["在",["l","火山地牢","火山地牢"],"开采石头 (0.5%)"]]]]]}],[{"r":2,"v":["蛇"]},[["i","(O)825","蛇头骨"]],["1"],{"b":[["l",0,[[1,[["l","姜岛","姜岛挖掘场"],"的",["l","远古斑点","远古斑点"]," (10%)"]],[1,["挖掘",["l","姜岛","姜岛西部"],"的",["l","远古斑点","远古斑点"]," (10%)"]],[1,["在",["l","姜岛","姜岛西部"],["l","钓鱼","钓鱼"]," (10%)"]]]]]}],[[["i","(O)826","蛇脊椎骨"]],["2"],{"b":[["l",0,[[1,["挖掘",["l","姜岛","姜岛西部"],"的",["l","远古斑点","远古斑点"]," (22.5%)"]],[1,["开采",["l","姜岛","姜岛西部"],"的蚌矿(2.5%)"]],[1,["开采",["l","姜岛","姜岛西部"],"的石头(1%)"]]]]]}]]]]],["岛屿调查",2,[["p",["玩家与岛屿办事处内靠近北侧墙壁上的物品交互后，会被依次询问",["l","姜岛","姜岛"],"上紫色花和紫色海星的数量。"]],["p",["玩家游戏中每天只能回答一次，答对为止。"]]]],["紫色花",3,[["d","答案",[["p",["一共有22朵紫色花。完成后奖励1个",["l","金色核桃","金色核桃"],"。"]]]]]],["紫色海星",3,[["d","答案",[["p",["一共有18个