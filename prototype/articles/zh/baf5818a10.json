{"s":[[null,1,[["p",["初级保湿土壤是一种可以让土壤保持湿润的",["l","肥料","肥料"],"。可以手工",["l","打造","打造"],"或在第一年春季15日后前往",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"用 100金 购买。"]],["p",["初级保湿土壤可以在种植种子之前或之后，或是作物的任何生长阶段施在犁过的土壤中。土壤保湿的几率是33%。"]]]],["送礼",2,[["t",[[{"h":1,"v":["不喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","雷欧","雷欧"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"]]]]]]],["收集包",2,[["p",["不用于任何",["l","收集包","收集包"],"。"]]]],["裁制",2,[["p",["初级保湿土壤可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成下半部分可染色的 ",["l","裁缝","高腰上衣"],"。初级保湿土壤可用于",["l","染色","染色"],"。放置在",["l","染色#染料罐","染料罐"],"内时，初级保湿土壤可用作橙色染料。放置在",["l","染色#缝纫机","缝纫机"],"内时，初级保湿土壤还可用作棕色染料。"]]]],["任务",2,[["p",["不用于任何任务。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.4","1.4"],"：初级保湿土壤可用于已播种的种子（只能在种子没有发芽前放置）。现在在裁缝中可用。"]]]]]]]}