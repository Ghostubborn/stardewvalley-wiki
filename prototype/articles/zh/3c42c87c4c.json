{"s":[[null,1,[["p",["万象晶球是一种包含着",["l","矿物","矿物"],"、",["l","古物","古物"],"、",["l","矿石","矿石"],"或基础资源的一种",["l","矿物#晶球","晶球"],"。可以通过多种方式获得。万象晶球可以用于和",["l","沙漠商人","沙漠商人"],"交换购买一系列的物品。"]],["p",["万象晶球可以交给",["l","铁匠铺","铁匠铺"],"的",["l","克林特","克林特"],"敲开以获取内含的物品，费用为 ",["f","Gold.png",18],"25。它也可使用",["l","晶球破开器","晶球破开器"],"打开。"]],["p",[["l","运气#每日运气","每日运气"],"和运气",["l","效果","增益效果"],"都不会影响万象晶球的开出物品。"]]]],["获取",2,[["l",false,[[1,["击杀石碳幽灵掉落（几率为 99%）。"]],[1,["破坏矿井（21 层之后）或骷髅洞穴中的岩石。"]],[1,["敲碎火山地牢的万象晶球矿。"]],[1,["打破矿井（80 层之后）、骷髅洞穴或火山地牢中的木箱和木桶。"]],[1,["挖掘矿井或骷髅洞穴中的沙地。"]],[1,["击杀荒野石魔和铱石魔掉落（几率为 5%，需要达到 战斗 5 级）。"]],[1,["击杀幽灵头骨掉落（几率为 1.3%，仅当金库收集包未完成时）。"]],[1,["使用淘盘淘金。"]],[1,["在姜岛上挖掘远古斑点。"]],[1,["饲养有章鱼的鱼塘，在数量达到 9 之后，每天可能会产出 1、3 或 10 个万象晶球。"]],[1,["每周的星期二在科罗布斯商店以",["f","Gold.png",18],"300 购买（限 1 个）。"]],[1,["每周的星期三在绿洲商店以",["f","Gold.png",18],"500 购买（限 3 个）。"]],[1,["完成",["l","收集包#锅炉房","锅炉房"],"的",["f","Bundle_Purple.png",24]," ",["l","收集包#地理学家的收集包","地理学家的收集包"],"可以获得 5 个万象晶球。"]],[1,["鳟鱼大赛的奖励之一是 3 个万象晶球。"]],[1,["兑奖机的第 18 个奖品是 8 个万象晶球。"]],[1,["在骷髅洞穴的宝箱层里打开宝箱也可能会获得 5 个或 10 个万象晶球。"]],[1,["选择海滩农场，在升级一次农舍后，有概率在补给箱中找到2-4个万象晶球。"]],[1,["电影院的抓娃娃机奖品（任何季节）。"]],[1,["翻动博物馆外面的垃圾桶。"]],[1,["在危险的矿井或危险的骷髅洞穴中击杀特殊怪物（特殊史莱姆会有黄色星形触角的明显特征，其他特殊怪物与正常怪物无明显差异）也有概率获得万象晶球。"]]]]]],["万象晶球内的物品",2,[]],["古物",3,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["售价"]},{"h":1,"v":["出现几率"]}],[[["f","Dwarvish_Helm.png",48]],[["l","矮人头盔","矮人头盔"]],["这是矮人常戴的头盔之一。厚厚的金属镀层能保护他们不受落石伤害。"],[["f","Gold.png",18],"100"],["31/2750*"]],[[["f","Dwarf_Gadget.png",48]],[["l","矮人小工具","矮人小工具"]],["这个小工具是矮人先进工艺的一小块结晶。它还在发光和响动，但是你无法理解它的工作原理。"],[["f","Gold.png",18],"200"],["31/2750*"]],[[["f","Ancient_Drum.png",48]],[["l","古代鼓","古代鼓"]],["这是一个用木头和动物皮做的鼓。它能发出低沉、经久不息的声音。"],[["f","Gold.png",18],"100"],["31/2750*"]]]]]],["可采集矿物",3,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["售价"]},{"h":1,"v":["出现几率"]}],[[["f","Earth_Crystal.png",48]],[["l","地晶","地晶"]],["在地表附近发现的树脂状物质。"],[["f","Gold.png",18],"50"],["1/48"]],[