{"s":[[null,1,[["p",["万象晶球是一种",["l","矿物#晶球","晶球"],"，主要通过在",["l","矿井","矿井"],"中敲碎岩石获得。万象晶球可以交给",["l","克林特","克林特"],"敲开（费用：25金）或使用",["l","晶球破开器","晶球破开器"],"破开，才能获得内部包裹的矿物。万象晶球可能包含了",["l","矿物","矿物"],"、",["l","古物","古物"],"、晶球或者资源。万象晶球可以用于和",["l","沙漠商人","沙漠商人"],"交换购买一系列的物品。"]],["p",["注意：",["l","运气#每日运气","每日运气"],"和运气",["l","效果","效果"],"都不会影响万象晶球的开出物品。"]]]],["出现位置",2,[["l",0,[[1,["破坏",["l","矿井","矿井"],"（21层之后）或",["l","骷髅洞穴","骷髅洞穴"],"（任何层数）中的岩石。"]],[1,[["l","火山地牢","火山地牢"],"的",["l","采矿#采矿点","万象晶球矿"],"。"]],[1,["打破矿井（80层之后）、骷髅洞穴或火山地牢中的",["l","矿井#木箱和木桶","木箱和木桶"],"。"]],[1,["矿井或骷髅洞穴中的",["l","矿井#沙地","沙地"],"。"]],[1,[["l","石碳幽灵","石碳幽灵"],"的掉落物（几率为99%）。"]],[1,[["l","幽灵头骨","幽灵头骨"],"的掉落物（几率为1.3%，仅当",["l","收集包#金库","金库收集包"],"未完成时）。"]],[1,[["l","荒野石魔","荒野石魔"],"和",["l","铱石魔","铱石魔"],"的掉落物（几率为5%，需要战斗技能达到5级之后）。"]],[1,[["l","淘盘","淘金"],"。"]],[1,[["l","姜岛","姜岛"],"上挖掘",["l","远古斑点","远古斑点"],"。"]],[1,["饲养有",["l","章鱼","章鱼"],"的",["l","鱼塘","鱼塘"],"，在数量达到9之后，每天可能会产出1、3或10个万象晶球。"]],[1,["每周三",["l","绿洲","绿洲"],"会以 500金 的单价出售3个万象晶球。"]],[1,[["l","科罗布斯","科罗布斯"],"的商店每周二会出售1个万象晶球，价格为 300金。"]],[1,["完成地理学家的收集包的奖品是5个万象晶球。"]],[1,[["l","鳟鱼大赛","鳟鱼大赛"],"的奖励之一是3个万象晶球。"]],[1,[["l","镇长的庄园#兑奖机","兑奖机"],"的第18个奖品是8个万象晶球。"]],[1,["骷髅洞穴",["l","骷髅洞穴#宝藏房间","宝藏房间"],"有概率获得5个或10个万象晶球。"]],[1,["选择",["l","农场地图#Beach","海滩农场"],"，在升级一次",["l","农舍","农舍"],"后，有概率在",["l","补给箱","补给箱"],"中找到2-4个万象晶球。"]],[1,[["l","电影院","电影院"],"的抓娃娃机奖品（任何季节）。"]],[1,[["l","博物馆","博物馆"],"外面的",["l","垃圾桶","垃圾桶"],"。"]],[1,["敲碎落到",["l","农场","农场"],"上的",["l","随机事件#陨石","陨石"],"可以获得2个万象晶球。"]]]]]],["万象晶球的内含物",2,[["p",["玩家永远不可能在敲开至少15个万象晶球前就得到五彩碎片。因此，在敲开15个万象晶球前，五彩碎片出现的几率是0，收到其他矿物的几率是1/88。下方表格显示的概率为敲开15个万象晶球后的实际概率。"]]]],["古物",3,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["出现几率"]}],[[["f","Dwarvish_Helm.png",24]],[["l","矮人头盔","矮人头盔"]],["31/2750"]],[[["f","Dwarf_Gadget.png",24]],[["l","矮人小工具","矮人小工具"]],["31/2750"]],[[["f","Ancient_Drum.png",24]],[["l","古代鼓","古代鼓"]],["31/2750"]]]]]],["可采集矿物",3,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["出现几率"]}],[[["f","Earth_Cr