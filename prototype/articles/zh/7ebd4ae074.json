],["3心事件II",3,[["p",["在与肯特达成三心后，他将在邮件中给玩家发送一份食谱。"]],["d","具体情节",[["t",[[{"h":1,"v":["配方"]},{"h":1,"v":["描述"]}],[[["l","香酥鲈鱼","香酥鲈鱼"]],["在海外买了这个食谱，好好享受。\n谢谢你让我觉得受欢迎。\n-肯特"]]]]]]]],["7心事件",3,[["p",["在与肯特达成七心后，他将在邮件中给玩家发送一份食谱。"]],["d","具体情节",[["t",[[{"h":1,"v":["配方"]},{"h":1,"v":["描述"]}],[[["l","巨无霸餐","巨无霸餐"]],["在海外买了这个食谱，好好享受。\n谢谢你让我觉得受欢迎。\n-肯特"]]]]]]]],["对话",2,[["d","常规",[["p",["初次见面"]],["q",["呃，你好啊，我的名字是肯特。我昨晚才回来……从海外回来。我老婆告诉我，在我不在的这段时间有个农夫搬过来了。\n我只是来自我介绍一下……回头见。"],[]],["p",["日常"]],["q",["你好啊。我离开好久了啊……觉得自己就是个异乡客。"],[]],["q",["我不知道我还能不能适应家里的生活。镇子里的平静祥和像是一种掩饰。可能只有我觉得这样吧。"],[]],["q",["我离开了之后，这里好像也没什么变化。好吧，只不过多了个你。"],[]],["q",["我离开了之后，这里好像也没什么变化。只不过镇子里多了一个新的农夫啦。"],[]],["q",["你已经在这儿呆了一段时间了，不是吗？你的农场现在一定是蒸蒸日上。"],[]],["q",["我4点钟就起来了……有时候我会怀疑自己能不能回到正常的生活作息上来。"],[]],["q",["在我离开之后，山姆真的长大了。他现在是个真正的男人了。我真希望能一直陪着他。"],[]],["q",["你们是我儿子的朋友吗？你们大概比我还了解他……"],[]],["q",["今天真是个钓鱼的好日子，不是吗？"],[]],["q",["乔迪跟我说你已经完全融入到这个集体当中了。我很高兴。"],[]],["q",["虽然我回来了，但是我却不知道自己该做些什么。我已经习惯了更有组织，有纪律的生活了。"],[]],["p",["绿雨"]],["l",0,[[2,["第二年及以后"]]]],["q",["哎呀……下这场雨是一件好事，能提醒我们山外有山，天外有天。\n[玩家名]啊，这反而能让人放心下来。"],[]],["p",["（肯特第一年处于军队服役状态，没有相应对话。）"]],["p",["好感度 6 心以上"]],["q",["……我在战争中失去了好多朋友。最可悲的是我居然连他们的面孔都想不起来了。……"],[]],["p",["好感度 8 心以上"]],["q",["我有失眠的毛病，所以如果我看起来很疲惫的话，请你不要介意。我知道你可以理解的。"],[]],["p",["玩家与",["l","山姆","山姆"],"结婚后"]],["q",["嘿，（玩家名）。结婚了开心吗？"],[]],["p",["在",["l","姜岛","姜岛"],"上"]],["q",["嗨，（玩家名）。见到你真好。"],[]],["q",["这段航程挺有趣的，在导航的时候，我所接受的航海训练居然派上了一点用场。"],[]],["q",["站在这片沙滩上……我感受到难得的平静。这片海相当特别。"],[]],["q",["这个地方非常适合家庭成员加深感情。我真的很高兴你把这里修好了。"],[]],["q",["来点水就好。"],[]],["q",["是时候回家了。"],[]]]],["d","节日",[["p",[["l","复活节","复活节"]]],["q",["讲真，我不是很喜欢吃鸡蛋。"],[]],["p",[["l","沙漠节","沙漠节"]]],["q",["哎，[玩家名]，你喜欢这种炎热的天气吗？"],[]],["p",[["l","花舞节","花舞节"]]],["p",["奇数年"]],["q",["这么大的场合……好紧张啊。*细语* 冷静冷静。我要冷静。"],[]],["p",["偶数年"]],["q",["你有没有想过……为什么我们会觉得花很漂亮？\n如果乔迪和我生了女儿的话，我们可能会用花的名字给她取名。"],[]],["p",[["l","夏威夷宴会","夏威夷宴会"]]],["p",["奇数年"]],["q",["嘿，很高兴见到你。"],[]],["p",["偶数年"]],["q",["（闻了一下）……气味总能唤起以前的记忆……\n有好也有坏……"],[]],["p",[["l","月光水母起舞","月光水母起舞"]]],["p",["奇数年"]],["q",["晚上好，（玩家名）。希望你能在收获季节前找点时间放松一下。"],[]],["p",["偶数年"]],["q",["哎，秋季有什么计划吗？"],[]],["p",[["l","星露谷展览会","星露谷展览会"]]],["p",["奇数年"]],["q",["我在等着看小丑的滑稽表演。相当令人失望。"],[]],["p",["偶数年"]],["q",["呵呵，我儿子的准头很好，不知道是不是遗传我的。"],[]],["p",[["l","万灵节","万灵节"]]],["p",["奇数年"]],["q",["嘿，（玩家名）。今晚天色不错。"],[]],["p",["偶数年"]],["q",["这些玩意儿看起来也不是很强啊。"],[]],["p",[["l","冰雪节","冰雪节"]]],["p",["奇数年"]],["q",["我喜欢冬天。很宁静。"],[]],["p",["偶数年"]],["q",["你做好比赛的准备了吗？我们一致觉得你会赢。"],[]],["p",[["l","冬日星盛宴","冬日星盛宴"]]],["p",["奇数年"]],["q",["下午好，（玩家名）。节日快乐。"],[]],["p",["偶数年"]],["q",["能看到儿子健康快乐，我很感激。"],[]]]]]],["趣闻",2,[["l",0,[[1,["经过战争的肯特患有PTSD（创伤后压力综合征）。这从他在三心事件中对爆米花声音的反应和他在花舞节中对开阔场地表现的不适可以看出。肯特也可以在对话中向玩家解释，他的疲劳是由于睡眠困难，一种创伤后应激障碍的症状。"]],[1,["虽然肯特肖像上的徽章是颠倒的，但在美国陆军中，两个徽章表明肯特是一名下士。"]],[1,["在一个可以在周五被触发的对话中，",["l","山姆","山姆"],"透露在他们以前住在祖祖城时，肯特是个清洁工。"]],[1,["在一个可以在夏季周一被触发的对话中，",["l","山姆","山姆"],"说在他小时候肯特会带他去沙漠玩。"]],[1,["尽管肯特喜欢鸡蛋，但在复活节时他会说他不喜欢鸡蛋。"]]]]]],["任务",2,[["l",0,[[1,[["l","任务","士兵的星星"],"：肯特将在第二年夏15日寄信来要一只",["l","杨桃","杨桃"],"。 奖励 500金 和 1心 ",["l","友谊","好感度"],"."]],[1,["肯特可能会随机在",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"外面的布告栏上发布",["l","任务","求助任务"],"，请求玩家带给他某个随机物品。奖励为3倍普通品质需求物品的价格以及150点",["l","友谊","好感度"],"。"]],[1,["在",["l","任务","\"海盗的妻子\""],"任务中，玩家需要将",["l","任务","战争纪念物"],"交给肯特。"]]]]]]]}