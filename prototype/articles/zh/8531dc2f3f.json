{"s":[[null,1,[["p",["玉米是一种",["l","蔬菜","蔬菜"],"，也是一种",["l","农作物","农作物"],"，可以通过种植",["l","玉米种子","玉米种子"],"生长 14 天成熟后获得。成熟后，每 4 天可以收获一次。"]],["p",["旅行货车会以 150–1,000金 的价格随机出售。"]],["p",["玉米可以放进",["l","产油机","产油机"],"里加工成",["l","油","油"],"。"]]]],["作物生长日历",2,[["p",["玉米可以在夏季和秋季种植。如果一株处于任何生长阶段的玉米在夏季 28 日仍处于耕地里未被收获，那么在次日换季后其并不会枯萎，且耕地中的",["l","化肥","化肥"],"也不会消失。"]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","哈维","哈维"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","罗宾","罗宾"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","威利","威利"],"、",["l","法师","法师"]]],[{"h":1,"v":["不喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","山姆","山姆"],"、",["l","文森特","文森特"]]],[{"h":1,"v":["讨厌"]},[["l","皮埃尔","皮埃尔"]]]]]]],["收集包",2,[["l",0,[[1,["秋季作物收集包需要 1 个玉米；"]],[1,["高品质作物收集包需要 5 个金星品质的玉米（作为可选项）；"]],[1,["高品质作物收集包需要 5 个金星品质的玉米（作为随机项）。"]]]]]],["食谱",2,[["t",[[{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["所需原料"]},{"h":1,"v":["能量 / 生命值"]},{"h":1,"v":["食谱来源"]},{"h":1,"v":["售出价格"]}],[[["l","墨西哥薄饼","墨西哥薄饼"]],["可以用来盛食物，也可以直接吃。"],[["i","(O)270","玉米×1"]],["能量 50\n生命值 22"],["*烹饪频道（奇数年秋季 7 日） *",["l","星之果实酒吧","星之果实酒吧"],"以100金 购买"],["50金"]]]]]],["打造",2,[["p",["玉米不用于任何",["l","打造#可打造物品","配方"],"。"]]]],["裁制",2,[["p",["玉米可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成可染色的 ",["l","裁缝","条纹衫"],"。玉米可用于",["l","染色","染色"],"。放置在",["l","染色#染料罐","染料罐"],"内时，玉米可用作黄色染料。放置在",["l","染色#缝纫机","缝纫机"],"内时，玉米还可用作黄色染料，染色强度为中等。"]]]],["任务",2,[["l",0,[[1,["玉米在",["l","秋季","秋季"],"会出现在",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"外边的布告栏上的随机",["l","任务#求助任务","求助任务"],"之中，奖励有150金和150",["l","友谊","友谊"],"点。"]]]]]],["你知道吗",2,[["l",0,[[1,["普通品质的玉米只能卖出50金，但 2 包",["l","玉米种子","玉米种子"],"总共能卖出150金的价格。这和玉米腌菜的价格相同(假设不受",["l","技能#耕种","工匠"],"技能加成)，但是在",["l","罐头瓶","罐头瓶"],"中生产玉米腌菜需要 4000 分钟，使用",["l","种子生产器","种子生产器"],"生产玉米种子只需要 20 分钟。"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.4#1.4","1.4"],"：修正了在",["l","冬季","冬季"],"第一天继续存活的漏洞。现在可用于",["l","裁缝","裁缝"],"。"]],[1,[["l","版本历史/1.5#1.5","1.5"],"：使用",["l","顶级肥料","顶级肥料"],"可获得铱星品质。"]],[1,[["l","版本历史#1.6","1.6"],"：现在可用于",["l","重新混合的收集包","重新混合的收集包"],"。"]]]]]]],"f":[["来源",[["l","耕种","耕种"]]],["季节",["夏季 • 秋季"]],["生长时间",["14 天"]],["种子",[["i","(O)487","玉米种子"]]],["售价",["50金"]]]}