{"s":[[null,1,[["p",["蘑菇树种子是一种",["l","树","野树"],"种子，可以长出",["l","蘑菇树","蘑菇树"],"。蘑菇树种子可以在",["l","齐先生的核桃房","齐先生的核桃房"],"花费5齐钻 ",["l","齐钻","齐钻"],"购买，也可以用",["l","斧头","斧头"],"、",["l","十字镐","十字镐"],"或",["l","锄头","锄头"],"从土地中挖出成熟",["l","蘑菇树","蘑菇树"],"掉落的未发芽的种子获得。摇晃或砍倒",["l","蘑菇树","蘑菇树"],"不会掉落蘑菇树种子。"]],["p",["蘑菇树种子可以种植在农场内外任何未占用的可耕种方格中，但该方格必须未使用",["l","锄头","锄头"],"开垦过。"]],["p",["除了",["l","冬季","冬季"],"，蘑菇树种子每晚都有大约 20% 的概率生长到下一阶段。总共有 5 个生长阶段，平均成熟时间约为 25 天，超过 90% 的蘑菇树种子能在 38 天内完全成熟。"]],["p",["使用",["l","树肥","树肥"],"可以让蘑菇树种子每晚都生长到下一个阶段，包括",["l","冬季","冬季"],"。"]]]],["送礼",2,[["t",[[{"h":1,"v":["不喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]]]]]],["裁制",2,[["p",["蘑菇树种子可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["i","(H)87","星星头盔"],"。蘑菇树种子还可用作",["l","染色#染料罐","染料罐"],"和",["l","染色#缝纫机","缝纫机"],"的红色染料。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.5#1.5","1.5"],"：加入游戏。"]],[1,[["l","版本历史#1.6","1.6"],"：蘑菇树散播的蘑菇树种子现在可以挖出了（更新日志未记录的改动）。"]]]]]]]}