{"s":[[null,1,[["p",["矮人卷轴 I是一种",["l","古物","古物"],"，可以通过在",["l","矿井","矿井"],"或",["l","骷髅洞穴","骷髅洞穴"],"的任何一层",["l","锄头","锄地"],"找到。",["l","蝙蝠","蝙蝠"],"、",["l","臭虫","臭虫"],"、",["l","苍蝇","苍蝇"],"、",["l","掘地虫","掘地虫"],"、",["l","史莱姆（怪物）","绿色史莱姆"],"、",["l","蛆","蛆"],"、",["l","岩石蟹","岩石蟹"],"或是",["l","石魔","石魔"],"被击杀后也有几率掉落。"]]]],["捐赠",2,[["p",["捐赠该物品可以增加",["l","博物馆","博物馆"],"的捐赠总数。"]],["p",["此外，捐赠所有四种矮人卷轴后，玩家会获得",["l","矮人语教程","矮人语教程"],"。"]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","矮人","矮人"],"、",["l","潘妮","潘妮"]]],[{"h":1,"v":["不喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]]]]]],["裁制",2,[["p",["矮人卷轴 I可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成可染色的 ",["l","裁缝","金边T恤"],"。矮人卷轴 I可用于",["l","染色","染色"],"。放置在",["l","染色#染料罐","染料罐"],"内时，矮人卷轴 I可用作红色染料。放置在",["l","染色#缝纫机","缝纫机"],"内时，矮人卷轴 I还可用作红色染料，染色强度为强烈。"]]]],["任务",2,[["p",[["l","鱼塘#任务","鱼塘"],"中的",["l","鬼鱼","鬼鱼"],"可能会需要矮人卷轴 I，用于将鱼塘容量从7条增加到10条。"]]]],["提示",2,[["l",0,[[1,["矿井第95层入口处有可开垦土壤，玩家可以搭乘电梯反复进入95层挖掘以获取矮人卷轴 I或矮人卷轴 IV。"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.4","1.4"],"：现在矮人卷轴 I可以被用于缝纫，并有几率出现在鱼塘任务中了。"]],[1,[["l","版本历史#1.5","1.5"],"：",["l","潘妮","潘妮"],"和",["l","矮人","矮人"],"现在喜欢上了",["l","古物","古物"],"，而其他NPC对古物的喜好程度从讨厌变成了不喜欢。"]]]]]]]}