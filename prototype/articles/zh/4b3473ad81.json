{"s":[[null,1,[["p",["蟹黄糕是一道",["l","烹饪","菜肴"],"，可通过升级后的",["l","农舍","农舍"],"内的厨房或",["l","野炊工具","野炊工具"],"制作。"]],["p",["旅行货车会以 825–1,375金 的价格随机出售。击杀",["l","骷髅洞穴","骷髅洞穴"],"中的铱蟹有 50% 的概率掉落蟹黄糕。",["l","沙漠节","沙漠节"],"期间，",["l","沙漠节#卡利科三花蛋商人","卡利科三花蛋商人"],"有 20% 的概率以10卡利科蛋 ",["l","卡利科三花蛋","卡利科三花蛋"],"的出售蟹黄糕（限 5 份）。打开",["l","谜之盒","谜之盒"],"也有概率获得 1 份蟹黄糕。在",["l","兑奖券","兑奖机"],"处获取到第 22 个奖励后，循环奖励档位的第 8 档有 20% 的概率是 5 份蟹黄糕。在",["l","矿井#挑战之神庙","危险的矿井"],"或",["l","骷髅洞穴","危险的骷髅洞穴"],"中击杀",["l","矿井#特殊物品","特殊怪物"],"（",["l","史莱姆#特殊史莱姆","特殊史莱姆"],"会有黄色星形触角的明显特征，其他特殊怪物与正常怪物无明显差异）也有概率获得蟹黄糕。"]],["p",["当经历过",["l","威利","威利"],"的 6 心事件后，",["l","格斯","格斯"],"会于接下来的 4 天在",["l","星之果实酒吧","星之果实酒吧"],"以550金 的价格不限量出售蟹黄糕。"]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","艾利欧特","艾利欧特"]]],[{"h":1,"v":["喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","莉亚","莉亚"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]],[{"h":1,"v":["不喜欢"]},[["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]]]]]],["收集包",2,[["p",["蟹黄糕不用于任何",["l","收集包","收集包"],"。"]]]],["裁制",2,[["p",["蟹黄糕可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","蟹黄膏上衣"],"。蟹黄糕可用于",["l","染色","染色"],"。放置在",["l","染色#染料罐","染料罐"],"内时，蟹黄糕可用作橙色染料。放置在",["l","染色#缝纫机","缝纫机"],"内时，蟹黄糕还可用作棕色染料。"]]]],["任务",2,[["p",["蟹黄糕不用于任何",["l","任务","任务"],"。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.3#1.3","1.3"],"：现在可在",["l","威利","威利"],"的6心事件后接下来的4天，于",["l","星之果实酒吧","星之果实酒吧"],"不限量地购买蟹黄糕。"]],[1,[["l","版本历史/1.4#1.4","1.4"],"：现在可用于",["l","裁缝","裁缝"],"。"]],[1,[["l","版本历