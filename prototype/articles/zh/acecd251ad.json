{"s":[[null,1,[["p",["青豆种子是一种种子，成熟的植株会产出",["l","青豆","青豆"],"。"]],["p",["青豆种子可以在",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"、",["l","Joja超市","Joja超市"],"和",["l","冬季","冬季"],"15日",["l","夜市","夜市上的魔法商船"],"买到，偶尔也会在",["l","旅行货车","旅行货车"],"上出售。青豆种子也可以通过",["l","种子生产器","种子生产器"],"获得。骷髅洞穴",["l","骷髅洞穴","宝藏房间"],"的宝箱偶尔也能开出5-20个青豆种子。在",["l","春季","春季"],"和",["l","冬季","冬季"],"打开",["l","谜之盒","谜之盒"],"有概率获得8个或20个青豆种子，打开",["l","金色谜之盒","金色谜之盒"],"有概率获得20个青豆种子。"]]]],["生长阶段",2,[["p",["青豆种子一旦种下，不管处在任何生长阶段，玩家都不能穿过青豆植株。"]],["t",[[{"h":1,"v":["阶段1"]},{"h":1,"v":["阶段2"]},{"h":1,"v":["阶段3"]},{"h":1,"v":["阶段4"]},{"h":1,"v":["阶段5"]},{"c":2,"h":1,"v":["收成"]}],[[["f","Green_Bean_Stage_2.png",39]],[["f","Green_Bean_Stage_3.png",39]],[["f","Green_Bean_Stage_4.png",39]],[["f","Green_Bean_Stage_5.png",39]],[["f","Green_Bean_Stage_6.png",39]],[["f","Green_Bean_Stage_7.png",39]],[["f","Green_Bean_Stage_8.png",39]]],[["1天"],["1天"],["1天"],["3天"],["4天"],["共: 10天"],["每隔3天持续产出。"]]]]]],["送礼",2,[["t",[[{"h":1,"v":["不喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]]]]]]]}