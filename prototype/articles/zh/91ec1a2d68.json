{"s":[[null,1,[["p",["骨笛是一种",["l","古物","古物"],"，可以通过挖掘",["l","深山","深山"],"、",["l","煤矿森林","煤矿森林"],"和",["l","鹈鹕镇","鹈鹕镇"],"的",["l","远古斑点","远古斑点"],"获得，也有 3.57% 的概率通过砸开",["l","古物宝藏","古物宝藏"],"获得。此外，打开",["l","钓鱼#宝箱","钓鱼宝箱"],"也有较小概率获得骨笛。"]]]],["捐赠",2,[["p",["捐赠包含骨笛在内的任意 3 种古物后，玩家可获得一个",["l","长笛块","长笛块"],"。"]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","矮人","矮人"],"、",["l","潘妮","潘妮"]]],[{"h":1,"v":["不喜欢"]},[["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]]]]]],["裁制",2,[["p",["骨笛可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","蓝色长背心"],"。骨笛可用于",["l","染色","染色"],"。放置在",["l","染色#染料罐","染料罐"],"内时，骨笛可用作黄色染料。放置在",["l","染色#缝纫机","缝纫机"],"内时，骨笛还可用作沙色染料，染色强度为强烈。"]]]],["任务",2,[["p",["在",["l","任务#Fragments of the past","特别任务：“历史的碎片”"],"期间，玩家需要提交 100 件骨头类物品，骨笛可作为其中的一个可选项。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.0#1.0","1.0"],"：加入游戏。"]],[1,[["l","版本历史/1.4#1.4","1.4"],"：新增",["l","古物宝藏","古物宝藏"],"作为获取来源之一。现在可用于",["l","裁缝","裁缝"],"。"]],[1,[["l","版本历史/1.5#1.5","1.5"],"：现在",["l","潘妮","潘妮"],"和",["l","矮人","矮人"],"喜欢",["l","古物","古物"],"，其他",["l","居民","居民"],"对古物的态度从讨厌变成了不喜欢。"]],[1,[["l","版本历史#1.6","1.6"],"：现在可以放入",["l","碎骨机","碎骨机"],"中转化成肥料了。现在",["l","阿比盖尔","阿比盖尔"],"喜欢骨笛。"]]]]]]]}