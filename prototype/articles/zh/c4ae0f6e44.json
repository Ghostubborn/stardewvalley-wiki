{"s":[[null,1,[["p",["大门是一件",["l","打造","可打造物品"],"，用于让玩家穿过围栏。一个大门可以维持完好状态 360 天（然后就会因逐渐破损而消失）。"]]]],["送礼",2,[["t",[[{"h":1,"v":["不喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","雷欧","雷欧"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"]]]]]]],["注意",2,[["l",0,[[1,["如果你打开大门并站在大门所在的方格上，然后再关闭大门。继续占据大门所在方格并再次打开大门的时候，大门会被破坏成为掉落物。"]],[1,["虽然大门只有一格宽，但是依旧可以骑着马从任何方向穿越任何朝向的大门。"]],[1,["用",["l","十字镐","十字镐"],"敲击大门不会破坏它，所以你可以用镐子将大门取下来，然后重新放置它。"]],[1,["大门可用于替换一个已经放置在地上的围栏（把大门放到工具栏，然后点击待替换的围栏方格）。如果大门被其他围栏环绕，大门的颜色会变成和围栏一样的颜色，这个效果会持续到退出游戏为止。"]]]]]]],"f":[["来源",[["l","打造","打造"]]],["原料",[["i","(O)388","木材×10"]]],["售价",["4金"]]]}