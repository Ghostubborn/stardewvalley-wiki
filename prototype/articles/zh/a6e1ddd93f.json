{"s":[[null,1,[["p",["有缺口的土罐是一种",["l","古物","古物"],"，挖掘在",["l","鹈鹕镇","鹈鹕镇"],"的",["l","远古斑点","远古斑点"],"有机会找到，也有几率通过砸开",["l","古物宝藏","古物宝藏"],"获得。",["l","沙漠节","沙漠节"],"期间，",["l","文森特","文森特"],"会在其",["l","沙漠节#村民商铺","商铺"],"以1卡利科蛋 ",["l","卡利科三花蛋","卡利科三花蛋"],"的价格出售有缺口的土罐（限1个）。",["l","动物#宠物","宠物"],"狗达到最大",["l","动物#好感度","好感度"],"后，每天第一次被抚摸也有可能掉落有缺口的土罐。"]]]],["捐赠",2,[["p",["捐赠该物品可以增加",["l","博物馆","博物馆"],"的捐赠总数。"]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","矮人","矮人"],"、",["l","潘妮","潘妮"]]],[{"h":1,"v":["不喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]]]]]],["裁制",2,[["p",["有缺口的土罐可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","古老T恤"],"。有缺口的土罐可用于",["l","染色","染色"],"。放置在",["l","染色#染料罐","染料罐"],"内时，有缺口的土罐可用作橙色染料。放置在",["l","染色#缝纫机","缝纫机"],"内时，有缺口的土罐还可用作棕色染料，染色强度为强烈。"]]]],["任务",2,[["p",["有缺口的土罐不用于任何",["l","任务","任务"],"。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.0","1.0"],"：加入游戏。"]],[1,[["l","版本历史#1.4","1.4"],"：新增",["l","古物宝藏","古物宝藏"],"作为获取来源之一。现在可用于",["l","裁缝","裁缝"],"。"]],[1,[["l","版本历史#1.5","1.5"],"：",["l","古物","古物"],"现在是",["l","潘妮","潘妮"],"和",["l","矮人","矮人"],"喜欢的礼物，而其他NPC对古物的喜好程度从讨厌变成了不喜欢。"]],[1,[["l","版本历史#1.6","1.6"],"：现在可以在",["l","沙漠节","沙漠节"],"期间购买。现在抚摸达到最大",["l","动物#好感度","好感度"],"的",["l","动物#宠物","宠物"],"狗有概率掉落。"]]]]]]]}