{"s":[[null,1,[["p",["塞料面包是一道",["l","烹饪","菜肴"],"，可通过升级后的",["l","农舍","农舍"],"内的厨房或",["l","野炊工具","野炊工具"],"制作。"]],["p",[["l","旅行货车","旅行货车"],"会在",["l","冬日星盛宴","冬日星盛宴"],"上以200金的价格出售塞料面包。玩家阅读过",["l","铜墙铁壁","铜墙铁壁"],"后，可在",["l","书摊老板","书摊老板"],"处用1本",["l","铜墙铁壁","铜墙铁壁"],"兑换3个塞料面包。塞料面包于",["l","周循环#周六","周六"],"有概率出现在",["l","科罗布斯#滚动出售","科罗布斯"],"的商店，或是随机出现在",["l","星之果实酒吧#不固定商品","星之果实酒吧"],"的菜单中。翻动酒吧外的",["l","垃圾桶","垃圾桶"],"也有可能找到。骷髅洞穴",["l","骷髅洞穴#宝藏房间","宝藏房间"],"的宝箱偶尔也能开出5份塞料面包。打开",["l","谜之盒","谜之盒"],"也有概率获得1份塞料面包。"]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","艾芙琳","艾芙琳"]]],[{"h":1,"v":["喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"]]],[{"h":1,"v":["不喜欢"]},[["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]]]]]],["收集包",2,[["p",["塞料面包是 冬日之星收集包的可选项之一。"]]]],["食谱",2,[["p",["塞料面包不用于任何食谱。"]]]],["裁制",2,[["p",["塞料面包可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["i","(H)63","平顶帽"],"。塞料面包可用于",["l","染色","染色"],"。放置在",["l","染色#染料罐","染料罐"],"内时，塞料面包可用作橙色染料。放置在",["l","染色#缝纫机","缝纫机"],"内时，塞料面包还可用作棕色染料。"]]]],["任务",2,[["p",["塞料面包不用于任何",["l","任务","任务"],"。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.0","1.0"],"：加入游戏。"]],[1,[["l","版本历史#1.1","1.1"],"：将售价从220金降低到165金。"]],[1,[["l","版本历史#1.4","1.4"],"：现在可用于",["l","裁缝","裁缝"],"。"]],[1,[["l","版本历史#1.5","1.5"],"：现在可以用",["l","野炊工具","野炊工具"],"烹饪。现在",["l","旅行货车","旅行货车"],"会在",["l","冬日星盛宴","冬日星盛宴"],"上出售塞料面包。"]],[1,[["l","版本历史#1.6","1.6"],"：现在塞料面包可用于",["l","重新混合的收集包","重新混合的收集包"]