{"s":[[null,1,[["p",["玫瑰仙子种子是一种种子，播种并生长 12 天成熟后可以长出带有多种颜色的",["l","玫瑰仙子","玫瑰仙子"],"。玫瑰仙子种子可以在",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"、",["l","Joja超市","Joja 超市"],"和",["l","冬季","冬季"]," 17 日",["l","夜市#魔法商船","夜市上的魔法商船"],"处买到。"]],["p",["旅行货车会以 300–1,000金 的价格随机出售。玫瑰仙子种子也可以通过将玫瑰仙子放入",["l","种子生产器","种子生产器"],"中获得。",["l","沙漠节","沙漠节"],"期间，",["l","贾斯","贾斯"],"也会在其",["l","沙漠节#村民商铺","商铺"],"以5卡利科蛋 ",["l","卡利科三花蛋","卡利科三花蛋"],"的价格出售玫瑰仙子种子（限 25 个）。在",["l","秋季","秋季"],"或",["l","冬季","冬季"],"的温室中种下",["l","混合花卉种子","混合花卉种子"],"也有可能变为玫瑰仙子种子。"]]]],["送礼",2,[["t",[[{"h":1,"v":["不喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.0#1.0","1.0"],"：加入游戏。"]],[1,[["l","版本历史/1.4#1.4","1.4"],"：更新了材质贴图。"]],[1,[["l","版本历史#1.6","1.6"],"：现在可以在",["l","沙漠节","沙漠节"],"期间获得。"]]]]]]]}