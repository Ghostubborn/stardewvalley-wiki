{"s":[[null,1,[["p",["火把是一种可通过",["l","打造","打造"],"获得的",["l","打造#光源","光源"],"，可以拿在手中或放在地面上以提供照明。把",["l","湿透的报纸","湿透的报纸"],"放进",["l","回收机","回收机"],"有概率产出 3 个火把。"]],["p",["火把可以提供大约半径 3 格的照明。放置后，需要通过使用",["l","锄头","锄头"],"、",["l","十字镐","十字镐"],"或者",["l","斧头","斧头"],"移除。玩家可以站在火把所占用的格子上。"]],["p",["火把还可以被放置在",["l","打造#围栏","围栏"],"和",["l","打造#洒水器","洒水器"],"上。"]]]],["送礼",2,[["t",[[{"h":1,"v":["讨厌"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]]]]]],["打造",2,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["配方来源"]},{"h":1,"v":["所需原料"]}],[[["f","Jack-O-Lantern.png",48]],[["l","南瓜灯","南瓜灯"]],["秋天的怪异装饰品。"],[["l","万灵节#商店","万灵节商店"],"以2,000金 购买"],[["i","(O)276","南瓜×1"],["i","(O)93","火把×1"]]]]]]],["裁制",2,[["p",["火把可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","高热T恤"],"。火把还可用作",["l","染色#染料罐","染料罐"],"和",["l","染色#缝纫机","缝纫机"],"的黄色染料。"]]]],["你知道吗",2,[["p",["如果用",["l","喷壶","喷壶"],"给火把浇水，火不会熄灭，将一直保持发光。"]],["p",[["l","矿井","矿井"],"和",["l","骷髅洞穴","骷髅洞穴"],"的地面上也会出现火把，可以用工具把它们敲下来带走（但各种爆炸物都会摧毁它们）。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.4#1.4","1.4"],"：加入游戏。"]],[1,[["l","版本历史#1.6","1.6"],"：火把现在可以放在洒水器上。"]]]]]]],"f":[["来源",[["l","打造","打造"]]],["原料",[["i","(O)388","木材×1"],["i","(O)92","树液×2"]]],["售价",["5金"]]]}