{"s":[[null,1,[["p",["葡萄干是在",["l","烘干机","烘干机"],"中用五个",["l","葡萄","葡萄"],"制成的",["l","工匠物品","工匠物品"],"，在游戏中过夜即可完成。"]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","艾芙琳","艾芙琳"]]],[{"h":1,"v":["喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","谢恩","谢恩"],"、",["l","威利","威利"],"、",["l","法师","法师"]]],[{"h":1,"v":["讨厌"]},[["l","贾斯","贾斯"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","文森特","文森特"]]]]]]],["收集包",2,[["p",["葡萄干不被用于任何",["l","收集包","收集包"],"。"]]]],["食谱",2,[["p",["葡萄干不被用于任何",["l","烹饪","食谱"],"。"]]]],["裁缝",2,[["p",["葡萄干不用于任何",["l","裁缝","裁缝"],"。葡萄干可用于",["l","染色","染色"],"。放置在",["l","染色#缝纫机","缝纫机"],"内时，葡萄干可用作紫色染料。"]]]],["任务",2,[["p",["葡萄干不被用于任何",["l","任务","任务"],"。"]]]],["秘密",2,[["p",["如果将葡萄干放进",["l","祝尼魔屋","祝尼魔屋"],"里，那么",["l","祝尼魔","祝尼魔"],"有 20% 的几率收获双倍作物。",["l","秘密纸条#秘密纸条 #26","秘密纸条#26"]," 中有所暗示。葡萄干并不会提升祝尼魔收获作物的速度。",["l","祝尼魔","祝尼魔"],"每周都会吃掉一袋葡萄干（",["l","冬季","冬季"],"除外），祝尼魔屋外还会放一个小牌子用于提示。祝尼魔屋内可以堆放多个葡萄干，随着时间的推移被消耗掉。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.6","1.6"],"：加入游戏。"]]]]]]],"f":[["来源",[["l","工匠物品","工匠物品"]]],["加工设备",[["i","(BC)Dehydrator","烘干机"]]],["原料",[["i","(O)398","葡萄×5"]]],["加工时间",["过夜"]],["售价",["600金"]]]}