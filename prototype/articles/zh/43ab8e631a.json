{"s":[[null,1,[["p",["翡翠是一种",["l","矿物","矿物"],"，可通过开采",["l","采矿","翡翠矿"],"和",["l","采矿","宝石矿"],"获得，也可由",["l","史莱姆（怪物）","蓝色史莱姆"],"、",["l","史莱姆（怪物）","老虎史莱姆"],"、",["l","矮人哨兵","矮人哨兵"],"掉落，或从",["l","钓鱼","钓鱼宝箱"],"中获得。在",["l","冬日星盛宴","冬日星盛宴"],"期间，玩家可能会收到翡翠作为礼物。玩家抵达",["l","矿井","矿井"],"底部后，翻动",["l","垃圾桶","垃圾桶"],"偶尔也可以找到翡翠。"]],["p",["在",["l","游戏内时间","星期天"],"时，玩家可用一个翡翠向",["l","沙漠商人","沙漠商人"],"交换一个",["l","楼梯","楼梯"],"。"]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","克林特","克林特"],"、",["l","艾米丽","艾米丽"],"、",["l","矮人","矮人"]]],[{"h":1,"v":["喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]],[{"h":1,"v":["不喜欢"]},[["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","莉亚","莉亚"]]]]]]],["收集",2,[["p",["不用于任何",["l","收集包","收集包"],"。"]]]],["配方",2,[["p",["不用于任何配方。"]]]],["裁制",2,[["p",["翡翠可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","上衣"],"。翡翠可用于",["l","染色","染色"],"。放置在",["l","染色","染料罐"],"内时，翡翠可用作绿色染料。放置在",["l","染色","缝纫机"],"内时，翡翠还可用作绿玉色染料。"]]]],["任务",2,[["l",0,[[1,["当玩家到达",["l","矿井","矿井"],"40层后，翡翠可能会在任何季节出现在",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"外边的",["l","任务","“布告栏”"],"上的随机求助任务中。完成任务的奖励是600金和150",["l","友谊","友谊点"],"。"]],[1,["饲养有某几种鱼类的",["l","鱼塘","鱼塘"],"会出现要求玩家提供2个翡翠的",["l","鱼塘","鱼塘任务"],"。"]],[1,["在",["l","刘易斯","刘易斯"],"房子外边的特别任务板上出现的",["l","任务","“宝石能量”任务"],"中，",["l","艾米丽","艾米丽"],"会要求玩家提供一个翡翠。"]]]]]],["锻造",2,[["p",["可用于提高武器 ",["l","暴击力量","暴击伤害"],"（每级 +10%）"]]]]]}