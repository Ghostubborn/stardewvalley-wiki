{"s":[[null,1,[["p",["翡翠是一种",["l","矿物","矿物"],"。主要通过挖掘",["l","翡翠矿","翡翠矿"],"或",["l","紫色宝石矿","紫色宝石矿"],"获得。击杀",["l","火山地牢","火山地牢"],"的",["l","矮人哨兵","矮人哨兵"],"有 10% 的概率掉落翡翠，击杀",["l","矿井","矿井"]," 41~69 层里的蓝色史莱姆与",["l","姜岛","姜岛"],"上的老虎史莱姆有 2% 的概率掉落翡翠。在矿井 41~79 层打破",["l","矿井#木箱和木桶","木箱和木桶"],"也有 2.24% 的概率获得翡翠。在",["l","冬日星盛宴","冬日星盛宴"],"上，如果给玩家送礼物的村民是除",["l","克林特","克林特"],"、",["l","艾芙琳","艾芙琳"],"、",["l","玛妮","玛妮"],"、",["l","罗宾","罗宾"],"或",["l","威利","威利"],"以外的成人，玩家也可能获得一颗翡翠。翡翠也有小概率通过打开",["l","钓鱼#宝箱","钓鱼宝箱"],"、使用淘盘",["l","淘盘","淘金"],"或在到达矿井 40 层后翻动",["l","垃圾桶","垃圾桶"],"获得。"]],["p",["每周的星期天，可以在",["l","沙漠商人","沙漠商人"],"处使用一颗翡翠交换一个",["l","楼梯","楼梯"],"。"]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","克林特","克林特"],"、",["l","矮人","矮人"],"、",["l","艾米丽","艾米丽"]]],[{"h":1,"v":["喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]],[{"h":1,"v":["不喜欢"]},[["l","莉亚","莉亚"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"]]]]]]],["收集包",2,[["p",["翡翠不用于任何",["l","收集包","收集包"],"。"]]]],["打造",2,[["p",["翡翠不用于任何",["l","打造#可打造物品","配方"],"。"]]]],["裁制",2,[["p",["翡翠可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","上衣"],"。翡翠可用于",["l","染色","染色"],"。放置在",["l","染色#染料罐","染料罐"],"内时，翡翠可用作绿色染料。放置在",["l","染色#缝纫机","缝纫机"],"内时，翡翠还可用作绿玉色染料。"]]]],["任务",2,[["l",0,[[1,["在玩家到达矿井 40 层后，翡翠可能会出现在",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"门前",["l","任务#求助任务","“布告栏”"],"上的随机任务中。任务完成的奖励是600金 和 150 ",["l","友谊","友谊点"],"。"]],[1,["在",["l","任务#Rock Rejuvenation","特别任务“宝石能量”"],"中，玩家需要将 1 颗翡翠交付给",["l","艾米丽","艾米丽"],"。"]],[1,["饲养有某几种鱼类的",["l","鱼塘","鱼塘"],"会出现要求玩家提供 2 个翡翠的",["l","鱼塘#任务","鱼塘任务"],"。"]]]]]],["锻造",2,[["n",["主条目：",["l","锻造","锻造"]]],["p",["翡翠在用于锻造时可提高武器的 ",["l","暴击力量","暴击伤害"],"（每级 +10%）。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.4#1.4","1.4"],"：现在可用于",["l","裁缝","裁缝"],"。可能在",["l","鱼塘#任务","鱼塘任务"],"中需要。"]],[1,[["l","版本历史/1.5#1.5","1.5"],"：现在可用于",["l","任务#鹈鹕镇的特别任务","特别任务"],"中。可用于",["l","锻造","锻造"],"。现在",["l","矮人哨兵","矮人哨兵"],"会掉落翡翠。"]]]]]]]}