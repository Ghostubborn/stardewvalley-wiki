{"s":[[null,1,[["p",["河凝胶是一种可在任意季节的河流、湖泊（包括沙漠湖泊）中使用",["l","钓鱼#钓鱼竿","钓鱼竿"],["l","钓鱼","钓鱼"],"获得的物品。每提升1点运气增益都会显著增加捕获河凝胶的概率。",["l","运气#每日运气","每日运气"],"对此无影响。"]],["p",[["l","午夜鲤鱼","午夜鲤鱼"],["l","鱼塘","鱼塘"],"中鱼的数量达到至少7条后，有概率产出河凝胶。玩家可以在",["l","书摊老板","书摊老板"],"处用1本",["l","海之宝石","海之宝石"],"兑换3个河凝胶，前提是玩家已经阅读过这本书。",["l","动物#宠物","宠物"],"猫达到最大",["l","动物#好感度","好感度"],"后，每天第一次被抚摸也有可能掉落河凝胶。"]],["p",["河凝胶会显示在",["l","收集品#鱼","收集品 - 鱼"],"的页面之中，也会计入四项和钓鱼相关的",["l","成就","成就"],"。然而，河凝胶在分类上并不属于鱼，所以也不能在",["l","鱼店","鱼店"],"卖给",["l","威利","威利"],"。"]]]],["打造",2,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["配方"]},{"h":1,"v":["配方来源"]}],[[["f","Fish_Smoker.png",48]],[["l","熏鱼机","熏鱼机"]," (1)"],["放入鱼和一块煤炭即可烟熏，熏鱼价格是普通的两倍。"],[["i","(O)709","硬木×10"],["i","(O)SeaJelly","海凝胶×1"],["i","(O)RiverJelly","河凝胶×1"],["i","(O)CaveJelly","洞穴凝胶×1"]],[["l","鱼店","鱼店"],"花费10,000金解锁配方"]]]]]],["送礼",2,[["t",[[{"h":1,"v":["讨厌"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","雷欧","雷欧"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"]]]]]]],["裁制",2,[["p",["河凝胶不用于任何",["l","裁缝","裁缝"],"。河凝胶可用于",["l","染色","染色"],"。放置在",["l","染色#染料罐","染料罐"],"内时，河凝胶可用作绿色染料。放置在",["l","染色#缝纫机","缝纫机"],"内时，河凝胶可用作绿色染料。"]]]],["收集包",2,[["p",["河凝胶不用于任何",["l","收集包","收集包"],"。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.6","1.6"],"：加入游戏。"]],[1,[["l","版本历史#1.6.2","1.6.2"],"：现在是可食用的了。"]]]]]]],"f":[["来源",[["l","钓鱼#钓鱼竿","钓鱼竿"]," • ",["l","