{"s":[[null,1,[["p",["长柄锤是一种",["l","武器#锤","锤"],"。在",["l","矿井","矿井"]," 101~119 层击杀",["l","矿井#特殊物品","特殊怪物"],"（",["l","史莱姆#特殊史莱姆","特殊史莱姆"],"会有黄色星形触角的明显特征，其他特殊怪物与正常怪物无明显差异）或打破",["l","矿井#特殊物品","木箱和木桶"],"有小概率获得。打开",["l","矿井#重新混合的奖励层","重新混合后的矿井"],"第 80 层的宝箱也有概率获得。"]]]],["漏洞",2,[["p",["由于游戏源码有误，游戏内显示的",["l","重量","重量"],"值未必准确，长柄锤重量显示为 +2 ，实际重量为 +1。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.5#1.5","1.5"],"：加入游戏，先前无法获得。"]],[1,[["l","版本历史#1.6","1.6"],"：暴击力量从 +4 升至 +50。"]]]]]]]}