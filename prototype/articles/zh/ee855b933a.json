{"s":[[null,1,[["p",["红叶卷心菜是一种",["l","蔬菜","蔬菜"],"，也是一种",["l","农作物","农作物"],"，可以通过种植",["l","红叶卷心菜种子","红叶卷心菜种子"],"生长 9 天成熟后获得。"]],["p",["，但在",["l","皮埃尔的杂货店","杂货店"],"中，",["l","红叶卷心菜种子","红叶卷心菜种子"],"第二年",["l","夏季","夏季"],"才会出售。在第一年，玩家可以通过旅行货车购买或通过",["l","骷髅洞穴","骷髅洞穴"],"获得。如果玩家想保证在第一年完成",["l","收集包","收集包"],"，可以在创建存档时勾选",["l","选项#高级游戏设置","高级游戏设置"],"中的“确保第一年可完成”，确保旅行商人在第一年的某个时间出售红叶卷心菜种子。"]],["p",["勾选“确保第一年可完成”后，旅行商人必定会在第 2 次到第 30 次出现期间，也就是 春季 7 日（",["l","煤矿森林","煤矿森林"],"）到 冬季 16 日（",["l","夜市","夜市"],"）期间出售至少一次红叶卷心菜种子。具体日期会在创建存档时确定，保底机制只会生效一次。玩家查看旅行货车与否不会影响红叶卷心菜种子的上架。如果上架当天玩家没有查看旅行货车，则会直接错过。"]],["p",["除此之外，玩家还有较小的概率通过其他方式在此之前获取到",["l","红叶卷心菜种子","红叶卷心菜种子"],"，例如杀死",["l","骷髅洞穴","骷髅洞穴"],"中的",["l","飞蛇","飞蛇"],"或",["l","木乃伊","木乃伊"],"或在",["l","旅行货车","旅行货车"],"中购买。"]],["p",["旅行货车会以 780–1,300金 的价格随机出售。"]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","哈维","哈维"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","威利","威利"],"、",["l","法师","法师"]]],[{"h":1,"v":["不喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","山姆","山姆"],"、",["l","文森特","文森特"]]]]]]],["收集包",2,[["p",["染料收集包需要 1 个红叶卷心菜"]]]],["食谱",2,[["t",[[{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["所需原料"]},{"h":1,"v":["能量 / 生命值"]},{"h":1,"v":["增益效果"]},{"h":1,"v":["增益时长"]},{"h":1,"v":["食谱来源"]},{"h":1,"v":["售出价格"]}],[[["l","卷心菜沙拉","卷心菜沙拉"]],["口味清淡、新鲜，还很有益健康。"],[["i","(O)266","红叶卷心菜×1"],["i","(O)419","醋×1"],["i","(O)306","蛋黄酱×1"]],["能量 213\n生命值 95"],["无"],["无"],["烹饪频道（奇数年春季 14 日）"],["345金"]],[[["l","鱼肉卷","鱼肉卷"]]