{"s":[[null,1,[["p",["甜豌豆是花的一种，可以在",["l","夏季","夏季"],"通过",["l","采集","采集"],"获得。它在鹈鹕镇最为常见，夏季可采集物品中仅有它能在镇里找到。甜豌豆也会在",["l","秘密森林","秘密森林"],"、",["l","巴士站","巴士站"],"、",["l","铁路","铁路"],"和",["l","农场地图","森林农场地图"],"中生长。它也可以通过种植",["l","夏季种子","夏季种子"],"获得。在夏季翻动",["l","垃圾桶","垃圾桶"],"也有概率找到甜豌豆。"]]]],["治疗效果",2,[["p",["甜豌豆可以食用，但是不会增加",["l","生命值","生命值"],"和",["l","能量","能量"],"。"]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","桑迪","桑迪"]]],[{"h":1,"v":["喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]],[{"h":1,"v":["不喜欢"]},[["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","乔治","乔治"],"、",["l","克林特","克林特"]]]]]]],["收集包",2,[["p",["夏季采集收集包需要一个甜豌豆。"]]]],["配方",2,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["配料"]},{"h":1,"v":["配方来源"]},{"h":1,"v":["售价"]}],[[["f","Summer_Seeds.png",48]],[["l","夏季种子","夏季种子"]],["各种各样的夏季种子。\n(每次制造生产10份夏季种子。)"],[["i","(O)396","香味浆果×1"],["i","(O)398","葡萄×1"],["i","(O)402","甜豌豆×1"]],[["f","Foraging_Skill_Icon.png",24]," ",["l","采集","采集"]," 等级 4"],["55金"]]]]]],["裁制",2,[["p",["甜豌豆可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","上衣"],"。甜豌豆可用于",["l","染色","染色"],"。放置在",["l","染色","染料罐"],"内时，甜豌豆可用作紫色染料。放置在",["l","染色","缝纫机"],"内时，甜豌豆还可用作紫色染料，染色强度为中等。"]]]],["任务",2,[["l",0,[[1,["在夏季，甜豌豆会出现在",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"外边的",["l","任务","布告栏"],"上的随机任务之中，完成该任务的奖励是 150金 和150 ",["l","友谊","友谊点"]," 。"]]]]]]],"f":[["来源",[["l","采集","采集"]," • ",["l","夏季种子","夏季种子"]]],["季节",["Summer"]],["售价",["