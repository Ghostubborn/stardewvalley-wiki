{"s":[[null,1,[["p",["矮人卷轴 II 是一种",["l","古物","古物"],"，可以通过击杀",["l","矿井","矿井"]," 41~79 层的怪物或",["l","秘密森林","秘密森林"],"里的",["l","史莱姆#蓝色史莱姆","蓝色史莱姆"],"获得，概率为 0.5%。此外，在",["l","矿井","矿井"]," 1~39 层中使用锄头或炸弹挖掘沙地也有 0.1% 的概率获得矮人卷轴 II。"]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","矮人","矮人"],"、",["l","潘妮","潘妮"]]],[{"h":1,"v":["不喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]]]]]],["任务",2,[["p",["饲养有",["l","鬼鱼","鬼鱼"],"的",["l","鱼塘#任务","鱼塘"],"在数量从 7 提升到 10 的时候，可能会出现要求玩家提供一个矮人卷轴 II 的鱼塘任务。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.0#1.0","1.0"],"：加入游戏。"]],[1,[["l","版本历史/1.4#1.4","1.4"],"：现在可用于缝纫，并有几率出现在鱼塘任务中了。"]],[1,[["l","版本历史/1.5#1.5","1.5"],"：现在",["l","潘妮","潘妮"],"和",["l","矮人","矮人"],"喜欢",["l","古物","古物"],"，其他居民对古物的态度从讨厌变成了不喜欢。"]]]]]]]}