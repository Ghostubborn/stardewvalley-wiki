{"s":[[null,1,[["p",["生鱼片是一道",["l","烹饪","菜肴"],"，可通过升级后的",["l","农舍","农舍"],"内的厨房或",["l","野炊工具","野炊工具"],"制作。"]],["p",["生鱼片于",["l","周循环","周六"],"有概率出现在",["l","科罗布斯","科罗布斯"],"的商店，或是随机出现在",["l","星之果实酒吧","星之果实酒吧"],"的菜单中。翻动酒吧外的",["l","垃圾桶","垃圾桶"],"也有可能找到。",["l","莱纳斯","莱纳斯"],"有时会送给玩家一份生鱼片作为随信礼物。打开",["l","谜之盒","谜之盒"],"也有概率获得1份生鱼片。"]],["p",["注意：如果使用的",["l","鱼","鱼"],"价值小于75金，这个食谱是",["l","烹饪","有利润的"],"。但是，将价值低于75金的鱼用于",["l","任务","求助任务"],"的利润会更高（鱼基础价值的3倍）, 虽然这样的任务会比较罕见。（",["l","玉黍螺","玉黍螺"],"是一个例外——它的价格是20金，所以做成生鱼片的利润比较高）。"]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","塞巴斯蒂安","塞巴斯蒂安"]]],[{"h":1,"v":["喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"]]],[{"h":1,"v":["一般"]},[["l","威利","威利"]]],[{"h":1,"v":["不喜欢"]},[["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]],[{"h":1,"v":["讨厌"]},[["l","艾芙琳","艾芙琳"],"、",["l","艾米丽","艾米丽"],"、",["l","肯特","肯特"]]]]]]],["收集包",2,[["p",["生鱼片不用于任何",["l","收集包","收集包"],"。"]]]],["食谱",2,[["p",["生鱼片不用于任何食谱。"]]]],["裁制",2,[["p",["生鱼片可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","上衣"],"。生鱼片可用于",["l","染色","染色"],"。放置在",["l","染色","染料罐"],"内时，生鱼片可用作红色染料。放置在",["l","染色","缝纫机"],"内时，生鱼片还可用作粉色染料。"]]]],["任务",2,[["p",["在剧情任务",["l","任务","“皮埃尔的布告”"],"中，皮埃尔会在第2年春季21日写信向玩家索要1份生鱼片。任务奖励是1,000金和1心",["l","友谊","友谊"],"。"]]]]]}