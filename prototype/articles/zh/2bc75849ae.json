{"s":[[null,1,[["p",["虞美人籽松糕是一道",["l","烹饪","菜肴"],"，可以通过在升级后的",["l","农舍","农舍"],"内的厨房或",["l","野炊工具","野炊工具"],"制作。"]],["p",["虞美人籽松糕可以在",["l","冬日星盛宴","冬日星盛宴"],"上作为礼物收到，或是在",["l","旅行货车","旅行货车"],"处以750–1,250金的价格购买。另外，如果",["l","科罗布斯","科罗布斯"],"是你的室友，他也可能向你赠送虞美人籽松糕作礼物。"]],["p",["注意：当使用低品质的虞美人花以及",["l","磨坊","磨坊"],"制作的小麦粉和糖时，这道菜是",["l","烹饪#食谱的利润","有利润"],"的。"]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","潘妮","潘妮"],"、",["l","莉亚","莉亚"]]],[{"h":1,"v":["喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"]]],[{"h":1,"v":["不喜欢"]},[["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]]]]]],["收集包",2,[["p",["虞美人籽松糕不用于任何",["l","收集包","收集包"],"。"]]]],["裁制",2,[["p",["虞美人籽松糕可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成可染色的 ",["l","裁缝","白点上衣"],"。虞美人籽松糕可用于",["l","染色","染色"],"。放置在",["l","染色#染料罐","染料罐"],"内时，虞美人籽松糕可用作紫色染料。放置在",["l","染色#缝纫机","缝纫机"],"内时，虞美人籽松糕还可用作罂粟紫染料。"]]]],["任务",2,[["p",["虞美人籽松糕不用于任何",["l","任务","任务"],"。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.3.27","1.3.27"],"：中文名称从“罂粟籽松糕”改为“虞美人籽松糕”。"]],[1,[["l","版本历史#1.4","1.4"],"：现在可用于",["l","裁缝","裁缝"],"。"]],[1,[["l","版本历史#1.5","1.5"],"：现在可以用",["l","野炊工具","野炊工具"],"烹饪。"]]]]]]]}