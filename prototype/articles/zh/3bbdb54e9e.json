{"s":[[null,1,[["p",["煎鸡蛋是一道",["l","烹饪","菜肴"],"，可通过升级后的",["l","农舍","农舍"],"内的厨房或",["l","野炊工具","野炊工具"],"制作。"]],["p",["旅行货车会以 105–1,000金 的价格随机出售。煎鸡蛋可能作为每日特色菜出现在",["l","星之果实酒吧#不固定商品","星之果实酒吧"],"的菜单中，售价为70金。当天翻动酒吧外的",["l","垃圾桶","垃圾桶"],"时也有概率获得 1 份煎鸡蛋。也有可能在每周周六出现在",["l","科罗布斯#滚动出售","科罗布斯商店"],"中，售价为50金 ~ 500金。",["l","沙漠节","沙漠节"],"期间，",["l","亚历克斯","亚历克斯"],"也会在其",["l","沙漠节#村民商铺","商铺"],"以10卡利科蛋 ",["l","卡利科三花蛋","卡利科三花蛋"],"的价格出售煎鸡蛋（限 5 份）。打开",["l","谜之盒","谜之盒"],"也有概率获得 1 份煎鸡蛋。"]]]],["送礼",2,[["t",[[{"h":1,"v":["一般"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]],[{"h":1,"v":["不喜欢"]},[["l","莉亚","莉亚"]]]]]]],["收集包",2,[["p",["厨师收集包需要 1 个煎鸡蛋。"]]]],["食谱",2,[["t",[[{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["所需原料"]},{"h":1,"v":["能量 / 生命值"]},{"h":1,"v":["增益效果"]},{"h":1,"v":["增益时长"]},{"h":1,"v":["食谱来源"]},{"h":1,"v":["售出价格"]}],[[["l","完美早餐","完美早餐"]],["你会准备好征服世界的！"],[["i","(O)194","煎鸡蛋×1"],["i","(O)184","牛奶×1"],["i","(O)210","薯饼×1"],["i","(O)211","薄煎饼×1"]],["能量 200\n生命值 90"],[["l","耕种","耕种（+2）"],"体力值上限（+50）"],["7 分 00 秒"],["烹饪频道（偶数年春季 21 日）"],["350金"]]]]]],["裁制",2,[["p",["煎鸡蛋可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","煎蛋T恤"],"。煎鸡蛋可用于",["l","染色","染色"],"。放置在",["l","染色#缝纫机","缝纫机"],"内时，煎鸡蛋可用作白色染料。"]]]],["任务",2,[["p",["煎鸡蛋不用于任何",["l","任务","任务"],"。"]]]],["你知道吗",2,[["l",0,[[1,["1.3版本中，该物品中文命名由“煎鸡蛋”变更为“荷包蛋”。"]],[2,["由于不明原因，现版本游戏