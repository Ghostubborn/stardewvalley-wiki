{"s":[[null,1,[["p",["腐烂的植物是一种",["l","垃圾","垃圾"],"，由腐烂后的",["l","南瓜灯","南瓜灯"],"产生。如果没有被存放至",["l","宝箱","宝箱"],"或玩家的",["l","物品栏","物品栏"],"中，",["l","南瓜灯","南瓜灯"],"会在冬季的第一天变为腐烂的植物。腐烂的植物无法被放入",["l","回收机","回收机"],"中。"]]]],["送礼",2,[["t",[[{"h":1,"v":["讨厌"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","雷欧","雷欧"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"]]]]]]],["收集包",2,[["p",["腐烂的植物不被用于任何",["l","收集包","收集包"],"。"]]]],["食谱",2,[["p",["腐烂的植物不被用于任何",["l","烹饪","食谱"],"。"]]]],["裁制",2,[["p",["腐烂的植物可用作",["l","染色","染料罐"],"的橙色染料。"]]]],["任务",2,[["p",["腐烂的植物是",["l","莱纳斯","莱纳斯"],"的",["l","任务","特别任务：社区清理"],"任务期间的其中一个需求物品，该任务要求玩家收集并提交20件",["l","垃圾","垃圾"],"类物品。"]]]],["彩蛋",2,[["p",["在玩家解决",["l","秘密纸条","秘密纸条 #19"],"并获得",["l","刘易斯黄金像","刘易斯黄金像"],"后，腐烂的植物可能会在一定条件下出现。"]],["d","细节",[["p",[["l","刘易斯黄金像","刘易斯黄金像"],"可以被放置在",["l","鹈鹕镇","鹈鹕镇"],"的任何地方。如果雕像没有被路过的村民摧毁，第二天会被替换成腐烂的植物。玩家只能使用",["l","工具","工具"],"来移除这些腐烂的植物，只点击或按住左键是无法移除腐烂的植物的."]]]]]]],"f":[["来源",[["l","南瓜灯","南瓜灯"]]],["售价",["0金"]]]}