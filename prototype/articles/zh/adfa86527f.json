{"s":[[null,1,[["p",["Joja超市为",["l","设定#Joja公司","Joja公司"],"旗下的一所超市。",["l","莫里斯","莫里斯"],"负责超市的管理和客户的服务。"]],["p",["Joja超市是",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"的主要竞争对手，出售与其类似的商品。Joja超市的主要优势在于其营业时间更长。Joja超市每天营业到22:00，且周三不会闭店休息。如果没有加入会员，那么其商品的价格通常比皮埃尔处的要高。玩家可以在第三个结账通道中不知名店员处购买商品。"]],["p",["在工作日，",["l","谢恩","谢恩"],"每天早上8点到17:00在Joja超市工作。就算周末当天下雨，他也会去工作。",["l","山姆","山姆"],"每周一和周三12:50到17:00打扫卫生。工作期间玩家无法和他们交谈。"]],["p",["玩家可以在商店右下角找到莫里斯。触发过",["l","社区中心","社区中心"],"的解锁动画后，玩家可在此处即可花",["f","Gold.png",18],"5,000加入Joja超市会员。加入Joja超市会员后社区中心会变为",["l","Joja仓库","Joja仓库"],"，玩家可以通过",["l","Joja社区发展申请书","Joja社区发展申请书"],"购得整修服务，且不再能够通过",["l","社区中心","社区中心"],"完成收集包。"]],["p",["如果玩家选择帮助社区中心而放弃付款成为Joja超市的会员，当社区中心的所有收集包都完成后，Joja超市将会停止营业，",["l","莫里斯","莫里斯"],"将永远离开。"]]]],["城镇整修服务",2,[["t",[[{"h":1,"v":["价格"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]}],[[["f","Gold.png",18],"15,000"],[["l","矿车","矿车"],"修理"],["所有",["l","矿车","矿车"],"会被修理。"]],[[["f","Gold.png",18],"20,000"],["闪闪发光的圆形巨石"],["在",["l","矿井","矿井"],"周围的闪闪发光的圆形巨石会被移除。\n解锁",["l","淘盘","淘金"],"。"]],[[["f","Gold.png",18],"25,000"],["桥梁修理"],[["l","矿井","矿井"],"东边坏掉的桥梁会被修理，将能够到达",["l","采石场","采石场"],"。"]],[[["f","Gold.png",18],"35,000"],[["l","温室","温室"]],["位于你的",["l","农场","农场"],"的荒废的",["l","温室","温室"],"将会被重建。"]],[[["f","Gold.png",18],"40,000"],["公交车站整修"],["公交车将被修理。\n",["l","潘姆","潘姆"],"将会成为司机，车票费用为",["f","Gold.png",18],"500，返程免费。"]]]],["p",["完成 Joja 社区发展申请书总共需要花费",["f","Gold.png",18],"135,000。如果将加入Joja会员的费用也计入，则总共需要花费",["f","Gold.png",18],"140,000。"]],["p",["如果玩家在完成了",["l","社区中心","社区中心"],"的整组",["l","收集包","收集包"],"后再加入会员，对应项目将显示为已完成且不再需要支付。如果只完成了整组收集包的一小部分，不会产生任何费用减免。"]],["p",["和",["l","社区中心","社区中心"],"的",["l","收集包","收集包"],"不同，完成 Joja 社区发展申请书不会给予任何额外奖励。"]]]],["废弃Joja超市",2,[["g",[["JojaMart_Abandoned.png",160,["失踪的收集包"]]]],["p",["在完成修复",["l","社区中心","社区中心"],"后的第一个雨天或是雷雨的前一天晚上睡觉时将会触发过场动画，一道闪电击中了废弃Joja超市并打开了原本封住的入口。 在里面玩家能找到失踪的收集包。 完成这个收集包后将会触发一段剧情，第二天废弃Joja超市将会被改造成",["l","电影院","电影院"],"。玩家可以邀请村民一同前往看电影。"]]]],["提示",2,[["l",false,[[1,["在非会员的情况下，Joja超市的种子、草籽、糖、大麦粉和大米的价格高于皮埃尔的杂货店。"]],[2,["唯一的例外是向日葵种子，Joja超市中向日葵种子的价格为",["f","Gold.png",18],"125，而皮埃尔处则为",["f","Gold.png",18],"200。"]],[1,["购买会员后，Joja超市内商品的价格与皮埃尔的杂货店相同，向日葵降价为",["f","Gold.png",18],"100。"]],[2,["Joja可乐、Joja可乐灯、墙纸和地板都不受影响。"]],[1,["以下物品Joja超市不销售，因此只能在皮埃尔的杂货店中买到："]],[2,["普通物品：花束、目录、草籽 配方。"]],[2,["烹饪原料：油、醋。"]],[2,["种子：玉米种子（夏季没有，但秋季有）、大蒜种子、稻苗、蓝莓种子、红叶卷心菜种子、洋蓟种子。"]],[2,["化肥：初级肥料、高级肥料、初级保湿土壤、高级保湿土壤、生长激素、高级生长激素。"]],[2,["树苗：樱桃树苗、杏子树苗、橙子树苗、桃子树苗、石榴树苗、苹果树苗。"]],[1,["皮埃尔丢失的存货单不会对Joja超市起作用，因此玩家无法从Joja超市购买过季的种子。"]]]]]],["全年出售货物",2,[["t",[[{"h":1,"v":["图标"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["价格"]}],[[["f","Joja_Cola.png",48]],[["l","Joja可乐","Joja可乐"]],["Joja 公司的旗舰产品。"],[["f","Gold.png",18],"75"]],[[["f","Wallpaper_022_Icon.png",56]],["Joja墙纸"],["装饰一间房间的墙面。"],[["f","Gold.png",18],"20"]],[[["f","J._Cola_Light_ZH.png",50]],[["l","Joja可乐灯","Joja可乐灯"]],["可以放置在你的房间内。"],[["f","Gold.png",18],"500"]],[[["f","Grass_Starter.png",48]],[["l","草籽","草籽"]],["把它种在你的农场上，来得到一块新的草坪。"],[["f","Gold.png",18],"125"]],[[["f","Sugar.png",48]],[["l","糖","糖"]],["加入面团中可以使小点心更加酥甜。吃多了对健康无益。"],[["f","Gold.png",18],"125"]],[[["f","Wheat_Flour.png",48]],[["l","大麦粉","大麦粉"]],["碾碎麦粒后得到的普通食材。"],[["f","Gold.png",18],"125"]],[[["f","Rice.png",48]],[["l","大米","大米"]],["基本的粮食，可以配菜食用。"],[["f","Gold.png",18],"250"]],[[["f","Wallpaper_001_Icon.png",56]],[["l","墙纸","墙纸"]," (每天随机变化)"],["装饰一间房间的墙面。"],[["f","Gold.png",18],"250"]],[[["f","Flooring_01_Icon.png",64]],[["l","地板","地板"]," (每天随机变化)"],["装饰一间房间的地板。"],[["f","Gold.png",18],"250"]],[[["f","Auto-Petter.png",40]],[["l","自动抚摸机","自动抚摸机"],"\n（完成",["l","Joja社区发展申请书","Joja社区发展申请书"],"方可解锁）"],["Joja 公司专利技术，适用于鸡舍和畜棚。可以让动物们满足，但是无法实现亲自抚摸的所有好处。使用后仍可手动抚摸来补足。"],[["f","Gold.png",18],"50,000"]],[[["f","Joja_Furniture_Catalogue.png",48]],[["l","Joja家具目录","Joja家具目录"]],["可以获得Joja官方“拥抱成功”套装的一份终身订阅，包含40款独家家具！"],[["f","Gold.png",18],"25,000"]]]]]],["春季出售货物",2,[["t",[[{"h":1,"v":["图标"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["价格"]}],[[["f","Parsnip_Seeds.png",48]],[["l","防风草种子","防风草种子"]],["春天播种。4 天成熟。"],[["f","Gold.png",18],"25"]],[[["f","Bean_Starter.png",48]],[["l","青豆种子","青豆种子"]],["春天播种。10 天成熟，但是之后会不断结果。在架子上生长。"],[["f","Gold.png",18],"75"]],[[["f","Cauliflower_Seeds.png",48]],[["l","花椰菜种子","花椰菜种子"]],["春天播种。12 天后长成大花椰菜。"],[["f","Gold.png",18],"100"]],[[["f","Potato_Seeds.png",48]],[["l","土豆种子","土豆种子"]],["春天播种。6 天成熟，有一定几率一次收获多个土豆。"],[["f","Gold.png",18],"62"]],[[["f","Tulip_Bulb.png",48]],[["l","郁金香球茎","郁金香球茎"]],["春天下种。6 天产出鲜艳花朵。多种颜色。"],[["f","Gold.png",18],"25"]],[[["f","Kale_Seeds.png",48]],[["l","甘蓝种子","甘蓝种子"]],["春天播种。6 天成熟。用镰刀收获。"],[["f","Gold.png",18],"87"]],[[["f","Jazz_Seeds.png",48]],[["l","蓝爵士种子","蓝爵士种子"]],["春天下种。7 天产出蓝色绒球花朵。"],[["f","Gold.png",18],"37"]]]]]],["夏季出售货物",2,[["t",[[{"h":1,"v":["图标"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["价格"]}],[[["f","Tomato_Seeds.png",48]],[["l","西红柿种子","西红柿种子"]],["夏天播种。11 天成熟，收获之后还能继续结果。"],[["f","Gold.png",18],"62"]],[[["f","Pepper_Seeds.png",48]],[["l","辣椒种子","辣椒种子"]],["夏天播种。5 天成熟，收获之后还能继续结果。"],[["f","Gold.png",18],"50"]],[[["f","Wheat_Seeds.png",48]],[["l","小麦种子","小麦种子"]],["夏天或秋天播种。4 天成熟。用镰刀收获。"],[["f","Gold.png",18],"12"]],[[["f","Radish_Seeds.png",48]],[["l","萝卜种子","萝卜种子"]],["夏天播种。6 天成熟。"],[["f","Gold.png",18],"50"]],[[["f","Melon_Seeds.png",48]],[["l","甜瓜种子","甜瓜种子"]],["夏天播种。12 天成熟。"],[["f","Gold.png",18],"100"]],[[["f","Hops_Starter.png",48]],[["l","啤酒花种子","啤酒花种子"]],["夏天播种。11 天成熟，之后循环生产。在架子上生长。"],[["f","Gold.png",18],"75"]],[[["f","Poppy_Seeds.png",48]],[["l","虞美人种子","虞美人种子"]],["夏天下种。7 天产出大红花。"],[["f","Gold.png",18],"125"]],[[["f","Spangle_Seeds.png",48]],[["l","夏季亮片种子","夏季亮片种子"]],["夏天下种。8 天产出夺目的热带花朵。多种颜色。"],[["f","Gold.png",18],"62"]],[[["f","Sunflower_Seeds.png",48]],[["l","向日葵种子","向日葵种子"]],["夏天或秋天播种。8 天产出巨大向日葵。收割时产出更多种子。"],[["f","Gold.png",18],"125"]]]]]],["秋季出售货物",2,[["t",[[{"h":1,"v":["图标"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["价格"]}],[[["f","Corn_Seeds.png",48]],[["l","玉米种子","玉米种子"]],["夏天或秋天播种。14 天成熟，收获之后还能继续结果。"],[["f","Gold.png",18],"187"]],[[["f","Eggplant_Seeds.png",48]],[["l","茄子种子","茄子种子"]],["秋天播种。5 天成熟，收获之后还能继续结果。"],[["f","Gold.png",18],"25"]],[[["f","Pumpkin_Seeds.png",48]],[["l","南瓜种子","南瓜种子"]],["秋天播种。13 天成熟。"],[["f","Gold.png",18],"125"]],[[["f","Amaranth_Seeds.png",48]],[["l","苋菜种子","苋菜种子"]],["秋天播种。7 天成熟。用镰刀收获。"],[["f","Gold.png",18],"87"]],[[["f","Grape_Starter.png",48]],[["l","葡萄种子","葡萄种子"]],["秋天播种。10 天成熟，之后循环生产。在架子上生长。"],[["f","Gold.png",18],"75"]],[[["f","Yam_Seeds.png",48]],[["l","山药种子","山药种子"]],["秋天播种。10 天成熟。"],[["f","Gold.png",18],"75"]],[[["f","Bok_Choy_Seeds.png",48]],[["l","小白菜种子","小白菜种子"]],["秋天播种。4 天成熟。"],[["f","Gold.png",18],"62"]],[[["f","Cranberry_Seeds.png",48]],[["l","蔓越莓种子","蔓越莓种子"]],["秋天播种。7 天成熟，收获之后还能继续结果。"],[["f","Gold.png",18],"300"]],[[["f","Sunflower_Seeds.png",48]],[["l","向日葵种子","向日葵种子"]],["夏天或秋天播种。8 天产出巨大向日葵。收割时产出更多种子。"],[["f","Gold.png",18],"125"]],[[["f","Fairy_Seeds.png",48]],[["l","玫瑰仙子种子","玫瑰仙子种子"]],["秋天下种。12 天产出神秘的花朵。多种颜色。"],[["f","Gold.png",18],"250"]],[[["f","Wheat_Seeds.png",48]],[["l","小麦种子","小麦种子"]],["夏天或秋天播种。4 天成熟。用镰刀收获。"],[["f","Gold.png",18],"12"]]]]]],["你知道吗",2,[["l",false,[[1,["星期五（完成社区中心的收集包之前），乔迪可能会说：“Joja超市的食物虽说可能不是特别健康，但是那么低的价格真是让人发疯！”尽管Joja超市的大多数商品都比皮埃尔的杂货店要贵。或许她可能是Joja会员，亦或是皮埃尔可能会为玩家提供折扣以鼓励蔬菜销售。潘妮在星期五的对话中进一步提到了这一点：“Joja超市开了之后，镇上的事情都不一样了。皮埃尔的商店现在很不景气。不过妈妈特别喜欢Joja。比起皮埃尔商店，在那里可以买到很多很便宜的东西。”"]]]],["l",false,[[1,["获得“Joja公司年度会员”的成就需要购买所有Joja社区发展申请书，这至少需要六天的时间：购买Joja会员资格后，需要一天建造Joja仓库，五个项目各需要一天。"]]]],["l",false,[[1,["“Joja”标志与流行的YouTube公司频道WatchMojo有着惊人的相似之处。"]]]],["l",false,[[1,["Joja超市内没有背景音乐。"]]]],["l",false,[[1,["可以和货架交互查看货架上面有什么物品。"]]]],["l",false,[[1,["Joja超市后方的冷冻区宣传“鱼”和“牛奶”，但这两种产品都不能在超市中购买。"]]]],["l",false,[[1,["如果社区中心完工，山姆会去博物馆工作，而谢恩会失业。"]]]]]],["画廊",2,[["g",[["Jojamart.png",120,["Joja超市内部图"]],["JojaMart_Closed.webp",120,["冬季，已停业的Joja超市"]],["JojaDev_ZH.png",120,[["l","Joja社区发展申请书","Joja社区发展申请书"]]]]]]],["历史",2,[["l",false,[[1,["1.6：出售货物新增Joja家具目录。"]]]]]]]}