{"s":[[null,1,[["p",["Joja超市为",["l","设定#Joja公司","Joja公司"],"旗下的一所超市。",["l","莫里斯","莫里斯"],"负责超市的管理和客户的服务。"]],["p",["Joja超市是",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"的主要竞争对手，出售与其类似的商品。Joja超市的主要优势在于其营业时间更长。Joja超市每天营业到晚上 11 点，且周三不会闭店休息。如果没有加入会员，那么其商品的价格通常比皮埃尔处的要高。玩家可以在第三个结账通道中不知名店员处购买商品。"]],["p",["在工作日，",["l","谢恩","谢恩"],"每天早上8点到下午5点在Joja超市工作。如果周末当天下雨，那么他也会去工作。",["l","山姆","山姆"],"每周一和周三中午12:50到下午5点打扫卫生。工作期间玩家无法和他们交谈。"]],["p",["玩家可以在商店右下角找到莫里斯。触发过",["l","社区中心","社区中心"],"的解锁动画后，玩家可在此处即可花5,000金加入Joja超市会员。加入Joja超市会员后社区中心会变为",["l","Joja仓库","Joja仓库"],"，玩家可以通过",["l","Joja社区发展申请书","Joja社区发展申请书"],"购得整修服务，且不再能够通过",["l","社区中心","社区中心"],"完成收集包。"]],["p",["如果玩家选择帮助社区中心而放弃付款成为Joja超市的会员，当社区中心的所有收集包都完成后，Joja超市将会停止营业，",["l","莫里斯","莫里斯"],"将永远离开。"]]]],["城镇整修服务",2,[["t",[[{"h":1,"v":["价格"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]}],[["15,000金"],[["l","矿车","矿车"],"修理"],["所有",["l","矿车","矿车"],"会被修理。"]],[["20,000金"],["闪闪发光的圆形巨石"],["在",["l","矿井","矿井"],"周围的闪闪发光的圆形巨石会被移除。\n解锁",["l","淘盘","淘金"],"。"]],[["25,000金"],["桥梁修理"],[["l","矿井","矿井"],"东边坏掉的桥梁会被修理，将能够到达",["l","采石场","采石场"],"。"]],[["35,000金"],[["l","温室","温室"]],["位于你的",["l","农场","农场"],"的荒废的",["l","温室","温室"],"将会被重建。"]],[["40,000金"],["公交车站整修"],["公交车将被修理。\n",["l","潘姆","潘姆"],"将会成为司机，车票费用为500金，返程免费。"]]]],["p",["完成 Joja 社区发展申请书总共需要花费135,000金。如果将加入Joja会员的费用也计入，则总共需要花费140,000金。"]],["p",["如果玩家在完成了",["l","社区中心","社区中心"],"的整组",["l","收集包","收集包"],"后再加入会员，对应项目将显示为已完成且不再需要支付。如果只完成了整组收集包的一小部分，不会产生任何费用减免。"]],["p",["和",["l","社区中心","社区中心"],"的",["l","收集包","收集包"],"不同，完成 Joja 社区发展申请书不会给予任何额外奖励。"]]]],["提示",2,[["l",0,[[1,["在非会员的情况下，Joja超市的种子、",["l","草籽","草籽"],"、",["l","糖","糖"],"、",["l","大麦粉","大麦粉"],"和",["l","大米","大米"],"的价格高于",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"。"]],[2,["唯一的例外是",["l","向日葵种子","向日葵种子"],"，Joja超市中向日葵种子的价格为125金，而皮埃尔处则为200金。"]],[1,["购买会员后，Joja超市内商品的价格与",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"相同，向日葵降价为100金。"]],[2,[["l","Joja可乐","Joja可乐"],"、",["l","Joja可乐灯","Joja可乐灯"],"、",["l","墙纸","墙纸"],"和",["l","地板","地板"],"都不受影响。"]],[1,["以下物品Joja超市不销售，因此只能在",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"中买到："]],[2,["普通物品：",["l","花束","花束"],"、",["l","目录","目录"],"、",["l","草籽","草籽"]," 配方。"]],[2,["烹饪原料：",["l","油","油"],"、",["l","醋","醋"],"。"]],[2,["种子：",["l","玉米种子","玉米种子"],"（夏季没有，但秋季有）、",["l","大蒜种子","大蒜种子"],"、",["l","稻苗","稻苗"],"、",["l","蓝莓种子","蓝莓种子"],"、",["l","红叶卷心菜种子","红叶卷心菜种子"],"、",["l","洋蓟种子","洋蓟种子"],"。"]],[2,["肥料：",["l","初级肥料","初级肥料"],"、",["l","高级肥料","高级肥料"],"、",["l","初级保湿土壤","初级保湿土壤"],"、",["l","高级保湿土壤","高级保湿土壤"],"、",["l","生长激素","生长激素"],"、",["l","高级生长激素","高级生长激素"],"。"]],[2,["树苗：",["l","樱桃树苗","樱桃树苗"],"、",["l","杏子树苗","杏子树苗"],"、",["l","橙子树苗","橙子树苗"],"、",["l","桃子树苗","桃子树苗"],"、",["l","石榴树苗","石榴树苗"],"、",["l","苹果树苗","苹果树苗"],"。"]],[1,[["l","皮埃尔丢失的存货单","皮埃尔丢失的存货单"],"不会对Joja超市起作用，因此你不能从Joja超市购买过季的种子。"]]]]]],["全年出售货物",2,[["t",[[{"h":1,"v":["图标"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["价格"]}],[[["f","Joja_Cola.png",48]],[["l","Joja可乐","Joja可乐"]],["Joja 公司的旗舰产品。"],["75金"]],[[["f","Wallpaper_022_Icon.png",56]],["Joja墙纸"],["装饰一间房间的墙面。"],["20金"]],[[["f","J._Cola_Light_ZH.png",50]],[["l","Joja可乐灯","Joja可乐灯"]],["可以放置在你的房间内。"],["500金"]],[[["f","Grass_Starter.png",48]],[["l","草籽","草籽"]],["把它种在你的农场上，来得到一块新的草坪。"],["125金"]],[[["f","Sugar.png",48]],[["l","糖","糖"]],["加入面团中可以使小点心更加酥甜。吃多了对健康无益。"],["125金"]],[[["f","Wheat_Flour.png",48]],[["l","大麦粉","大麦粉"]],["碾碎麦粒后得到的普通食材。"],["125金"]],[[["f","Rice.png",48]],[["l","大米","大米"]],["基本的粮食，可以配菜食用。"],["250金"]],[[["f","Wallpaper_001_Icon.png",56]],[["l","墙纸","墙纸"]," (每天随机变化)"],["装饰一间房间的墙面。"],["250金"]],[[["f","Flooring_01_Icon.png",64]],[["l","地板","地板"]," (每天随机变化)"],["装饰一间房间的地板。"],["250金"]],[[["f","Auto-Petter.png",40]],[["l","自动抚摸机","自动抚摸机"],"\n（完成",["l","Joja社区发展申请书","Joja社区发展申请书"],"方可解锁）"],["Joja 公司专利技术，适用于鸡舍和畜棚。可以让动物们满足，但是无法实现亲自抚摸的所有好处。使用后仍可手动抚摸来补足。"],["50,000金"]],[[["f","Joja_Furniture_Catalogue.png",48]],[["l","Joja家具目录","Joja家具目录"]],["可以获得Joja官方“拥抱成功”套装的一份终身订阅，包含40款独家家具！"],["25,000金"]]]]]],["春季出售货物",2,[["t",[[{"h":1,"v":["图标"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["价格"]}],[[["f","Parsnip_Seeds.png",48]],[["l","防风草种子","防风草种子"]],["春天播种。4 天成熟。"],["25金"]],[[["f","Be