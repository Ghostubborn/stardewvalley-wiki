{"s":[[null,1,[["q",["装饰一间房间的墙面。"],[]],["p",["关于家具，请见",["l","家具","家具"],"。"]],["p",["关于地板，请见",["l","地板","地板"],"。"]],["p",["墙纸是一种物品，在",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"和",["l","Joja超市","Joja超市"],"皆有出售，其价格分别为200金和250金。除了列表最后位置的",["l","温室","温室"],"风格墙纸，每天都有一种新的随机",["l","目录","目录"],"墙纸在售。两家店铺在同一天出售的随机墙纸相同。"]],["p",["墙纸是一次性消耗品，并且无法堆叠。除了可以放置在墙壁上覆盖整个房间，它们也可以放置在两屋之间的走廊墙壁上。除非走廊已经在开放或打通的装修下变为房间一部分，否则放置在走廊墙壁上的墙纸只能覆盖其上半部分。"]],["p",["在房间内放置墙纸时，角色必须面对墙壁；在走廊放置墙纸时，角色必须面对相邻房间的其中一侧。在这两种情况中，玩家和墙壁之间的障碍物诸如装饰品或设备等都会影响墙纸放置。"]]]],["目录墙纸",2,[["p",[["l","家具","目录"],"是一类家具物品，放置后与之交互可以免费获得墙纸、",["l","地板","地板"],"和家具。大多数墙纸都可以从目录中获得。这些目录所提供的墙纸种类都是固定的且不会轮换。由于墙纸没有特定名字，所以下方表格按照其在游戏中的展示顺序列出了每个目录中的可获得墙纸。"]],["p",["以下墙纸可以从",["l","目录","目录"],"中获得。目录是一种购自",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"的",["l","家具","家具"],"，售价为30,000金。"]],["t",[[{"h":1,"v":["墙纸"]},{"h":1,"v":["图标"]},{"h":1,"v":["墙纸"]},{"h":1,"v":["图标"]},{"h":1,"v":["墙纸"]},{"h":1,"v":["图标"]},{"h":1,"v":["墙纸"]},{"h":1,"v":["图标"]},{"h":1,"v":["墙纸"]},{"h":1,"v":["图标"]},{"h":1,"v":["墙纸"]}]]],["p",["以下墙纸也可以从",["l","Joja家具目录","Joja家具目录"],"中获得。该墙纸还可以在",["l","Joja超市","Joja超市"],"还开张时以20金直接从轮转库存中购买。"]],["p",[["l","Joja家具目录","Joja家具目录"],"是一种购自Joja超市的家具，售价为25,000金。完成",["l","社区中心","社区中心"],"修复后，该目录会有概率出现在",["l","旅行货车","旅行货车"],"中并以30,000金的价格出售。"]],["t",[[{"h":1,"v":["墙纸"]}]]],["p",["以下墙纸可以从",["l","祝尼魔目录","祝尼魔目录"],"中获得。完成",["l","社区中心","社区中心"],"修复或",["l","Joja社区发展申请书","Joja社区发展申请书"],"后，该目录会有概率出现在",["l","旅行货车","旅行货车"],"中并以70,000金的价格出售。"]],["t",[[{"h":1,"v":["墙纸"]},{"h":1,"v":["图标"]},{"h":1,"v":["墙纸"]},{"h":1,"v":["图标"]},{"h":1,"v":["墙纸"]}]]],["p",["以下墙纸可以从",["l","复古目录","复古目录"],"中获得。该目录会有概率出现在",["l","旅行货车","旅行货车"],"中并以110,000金的价格出售。"]],["t",[[{"h":1,"v":["墙纸"]},{"h":1,"v":["图标"]},{"h":1,"v":["墙纸"]},{"h":1,"v":["图标"]},{"h":1,"v":["墙纸"]}]]],["p",["以下墙纸可以从",["l","垃圾目录","垃圾目录"],"中获得。该目录在翻动",["l","垃圾桶","垃圾桶"],"时有概率获得。"]],["t",[[{"h":1,"v":["墙纸"]},{"h":1,"v":["图标"]},{"h":1,"v":["墙纸"]}]]],["p",["以下墙纸可以从",["l","法师目录","法师目录"],"中获得。砖块风格墙纸也可以从",["l","目录","目录"],"中获得。"]],["p",[["l","法师目录","法师目录"],"可以在",["l","科罗布斯","科罗布斯的商店"],"以150,000金购买。"]],["t",[[{"h":1,"v":["墙纸"]},{"h":1,"v":["图标"]},{"h":1,"v":["墙纸"]},{"h":1,"v":["图标"]},{"h":1,"v":["墙纸"]}]]]]],["非目录来源墙纸",2,[["p",["以下墙纸无法从目录中获得，需要从列出的来源单独获得。"]],["t",[[{"h":1,"v":["墙纸"]},{"h":1,"v":["来源"]},{"h":1,"v":["图标"]},{"h":1,"v":["墙纸"]},{"h":1,"v":["来源"]}],[[],[["l","贾斯","贾斯"],"在",["l","沙漠节","沙漠节"],"期间以20卡利科蛋出售。"],[],[],[["l","肯特","肯特"],"在",["l","沙漠节","沙漠节"],"期间以20卡利科蛋出售。"]],[[],[["l","乔迪","乔迪"],"在",["l","沙漠节","沙漠节"],"期间以20卡利科蛋出售。"],[],[],[["l","罗宾","罗宾"],"在",["l","沙漠节","沙漠节"],"期间以20卡利科蛋出售。"]],[[],[["l","玛妮","玛妮"],"在",["l","沙漠节","沙漠节"],"期间以20卡利科蛋出售。"],[],[],[["l","艾芙琳","艾芙琳"],"在",["l","沙漠节","沙漠节"],"期间以20卡利科蛋出售。"]],[[],[["l","雷欧","雷欧"],"在",["l","沙漠节","沙漠节"],"期间以20卡利科蛋出售。"],[],[],["打开",["l","谜之盒","谜之盒"],"有概率找到。"]],[[],[["l","木匠的商店","阁楼建成"],"后的默认墙纸。\n无法以物品形式获得。"],[],[],[["l","冬日星盛宴","冬日星盛宴"],"期间以500金从",["l","皮埃尔","皮埃尔"],"处购买。\n",["l","冰雪节","冰雪节"],"期间以500金从",["l","旅行货车","旅行商人"],"处购买。"]],[[],["每晚有0.1%的几率被 ",["l","被诅咒的假人模特","被诅咒的模特"]," 用它重新装饰附近的墙壁。\n无法以物品的形式获得。"],[],[],["以10,000齐币从",["l","赌场","赌场"],"购买。"]],[[],["以100,000齐币从",["l","赌场","赌场"],"购买。"]]]]]],["无法获得的墙纸",2,[["p",["以下墙纸无法从正常游戏过程中获得。"]],["t",[[{"h":1,"v":["墙纸"]},{"h":1,"v":["图标"]},{"h":1,"v":["墙纸"]}]]]]],["趣闻",2,[["p",["这张墙纸上的图案和泥土与游戏《Minecraft》的草方块和泥土相似。"]]]]]}