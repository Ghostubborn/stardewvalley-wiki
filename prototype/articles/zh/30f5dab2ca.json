"f","Heavy_Furnace.png",48]],[["l","重型熔炉","重型熔炉"]],["比普通熔炉效率更高。每次使用需要 25 个矿石和 3 块煤炭。"],["采矿精通"],[["i","(BC)13","熔炉×2"],["i","(O)335","铁锭×3"],["i","(O)390","石头×50"]]]]]]],["建筑",2,[["p",["建造以下建筑需要石头。"]]]],["送礼",2,[["t",[[{"h":1,"v":["不喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]]]]]],["收集包",2,[["p",["建筑收集包需要 99 个石头"]]]],["裁制",2,[["p",["石头可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","工作服"],"。"]]]],["任务",2,[["l",0,[[1,["罗宾在特别任务“",["l","任务#Robins Resource Rush","罗宾的资源活动"],"”中可能会要求玩家在一周内收集1000个石头。玩家可以保留这些石头。首次按时完成任务后，罗宾会寄来",["l","石箱","石箱"],"配方。"]]]]]],["提示",2,[["l",0,[[1,["如果你想快速获取大量石头，最简单方法就是去",["l","矿井","矿井"],"开采大岩石。进入矿井以后，从楼梯进入第一层，你会看到许多岩石。请无视那些小岩石，只开采大岩石。大岩石开采完以后，从楼梯回到矿井的入口，然后重复上述过程即可。因为每次你进入矿井层，系统都会重新随机生成岩石。反复开采第一层的大岩石，你可以在一天内轻松获取超过 500 个石头。"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.3#1.3.27","1.3.27"],"：",["l","木匠的商店","木匠的商店"],"售卖的石头在第二年会从20金涨价到100金。可用于制作",["l","石牌","石牌"],"和",["l","花盆","花盆"],"。"]],[1,[["l","版本历史/1.4#1.4","1.4"],"：用于建造",["l","鱼塘","鱼塘"],"，且可由",["l","鱼塘","鱼塘"],"产出。可用于制作",["l","树肥","树肥"],"和",["l","红砖地板","红砖地板"],"。可用于",["l","裁缝","裁缝"],"。"]],[1,[["l","版本历史/1.5#1.5","1.5"],"：现可放入",["l","鱼缸","鱼缸"],"作为装饰。可用于制作",["l","顶级保湿土壤","顶级保湿土壤"],"、",["l","碎骨机","碎骨机"],"、",["l","晶球破开器","晶球破开器"],"、",["l","石制走道地板","石制走道地板"],"、",["l","石箱","石箱"],"和",["l","荆棘戒指","荆棘戒指"],"。"]],[1,[["l","版本历史#1.6","1.6"],"：可用于制作",["l","石制大箱子","石制大箱子"],"、",["l","祝福雕像","祝福雕像"],"与",["l","重型熔炉","重型熔炉"],"。现在可以在沙漠节购买。建造",["l","联机小屋","联机小屋"],"不再需要石头。现在抚摸达到最大",["l","动物#好感度","好感度"],"的",["l","宠物","宠物"],"狗有概率掉落。"]]]]]]],"f":[["来源",[["l","采矿","采矿"]," • ",["l","木匠的商店","木匠的商店"]]],["售价",["2金"]]]}