{"s":[[null,1,[["p",["训练用鱼竿是一种用于",["l","钓鱼","钓鱼"],"的",["l","工具","工具"],"，可以在",["l","鱼店","鱼店"],"以25金的价格购买。"]],["p",["或者，在第1年",["l","春季","春季"],"28日或之后，如果玩家已获得",["l","竹鱼竿","竹鱼竿"],"但尚未达到",["l","技能#钓鱼","钓鱼等级1"],"，在晴朗的一天上午11:30之前进入",["l","农场","农场"],"将导致威利来访并给玩家一根训练用鱼竿和一节钓鱼课，使玩家达到钓鱼等级1。"]],["p",["如果玩家在钓鱼小游戏中遇到困难，此鱼杆非常有用，因为它将玩家的钓鱼技能设置为5级，以便在尚未达到5级的情况下确定绿色条（136像素）的大小。它不能装备",["l","鱼饵","鱼饵"],"或",["l","渔具","渔具"],"。但是，使用训练用鱼竿会导致进度条比其他鱼杆慢33%，与",["l","陷阱浮标","陷阱浮标"],"的效果相同。"]],["p",["训练用鱼竿只能钓到基本的鱼（难度低于50的鱼），所有钓到的鱼都是正常质量的。然而，用此竿钓到的鱼会获得与其他任何钓竿相同的经验值，并计入",["l","成就","成就"],"和",["l","收集品#鱼","鱼类收集图鉴"],"。",["l","钓鱼#宝箱","宝箱"],"也可以用此竿钓到。所有符合条件的鱼类的生成几率也增加了10%。"]]]],["基础鱼类",2,[["p",["训练用鱼竿只能钓到以下鱼类："]],["p",[["l","鳀鱼","鳀鱼"],"、",["l","鲷鱼","鲷鱼"],"、",["l","大头鱼","大头鱼"],"、",["l","鲤鱼","鲤鱼"],"、",["l","鲢鱼","鲢鱼"],"、",["l","鲱鱼","鲱鱼"],"、",["l","河鲈","河鲈"],"、",["l","虹鳟鱼","虹鳟鱼"],"、",["l","红鲷鱼","红鲷鱼"],"、",["l","沙丁鱼","沙丁鱼"],"、",["l","海参","海参"],"、",["l","西鲱","西鲱"],"、",["l","小嘴鲈鱼","小嘴鲈鱼"],"、",["l","太阳鱼","太阳鱼"],"、",["l","大眼鱼","大眼鱼"],"。"]],["p",["同样地，训练用鱼竿也会钓到",["l","垃圾","垃圾"],"、",["l","海草","海草"],"、",["l","绿藻","绿藻"],"、",["l","白藻","白藻"],"、",["l","海凝胶","海凝胶"],"、",["l","河凝胶","河凝胶"],"和",["l","洞穴凝胶","洞穴凝胶"],"。"]]]],["备注",2,[["l",0,[[1,["在",["l","矿井","矿井"],"中使用训练用鱼竿只会产生",["l","垃圾","垃圾"],"，因为所有的一般渔获，包括",["l","绿藻","绿藻"],"、",["l","白藻","白藻"],"和",["l","洞穴凝胶","洞穴凝胶"],"，都被排除在掉落池之外。"]]]]]],["漏洞",2,[["l",0,[[1,["使用训练用鱼竿可能在",["l","矿井","矿井"],"的第100层钓到",["l","岩浆鳗鱼","岩浆鳗鱼"],"，因为这个地方不会核对训练用鱼竿的难度限制。"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.4","1.4"],"：加入游戏。"]],[1,[["l","版本历史#1.6","1.6"],"：修复了训练用鱼竿可以钓到",["l","农场地图#Forest","森林农场"],"的",["l","木跃鱼","木跃鱼"],"、",["l","夜市","夜市"],"鱼类、",["l","矿井","矿井"],"鱼类和",["l","鱼#传说鱼类","传说鱼类"],"的漏洞。如果玩家在第一年",["l","春季","春季"],"28日之前还没有达到钓鱼等级1，",["l","威利","威利"],"现在会给玩家一根训练用鱼竿。"]]]]]]]}