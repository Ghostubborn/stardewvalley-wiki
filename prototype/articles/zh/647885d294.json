{"s":[[null,1,[["p",["海之菜肴是一道",["l","烹饪","菜肴"],"，可通过升级后的",["l","农舍","农舍"],"内的厨房或",["l","野炊工具","野炊工具"],"制作。"]],["p",[["l","旅行货车","旅行货车"],"会以 ",["f","Gold.png",18],"660 ~ ",["f","Gold.png",18],"1,100 的价格随机出售 1 个或 5 个海之菜肴 。海之菜肴可能在每周周六出现在",["l","科罗布斯#滚动出售","科罗布斯商店"],"中，售价为",["f","Gold.png",18],"50 ~ ",["f","Gold.png",18],"500。在",["l","骷髅洞穴#宝藏房间","骷髅洞穴"],"的宝箱层里打开宝箱也可能会获得 5 份海之菜肴。打开",["l","谜之盒","谜之盒"],"或",["l","金色谜之盒","金色谜之盒"],"也有概率获得 2 份海之菜肴。在",["l","鱿鱼节","鱿鱼节"]," 12 日和 13 日通过领取银星奖励可以获得合计 2 份海之菜肴。完成",["l","收集包#鱼缸","鱼缸"],"的",["f","Bundle_Red.png",24]," ",["l","收集包#特色鱼类收集包","特色鱼类收集包"],"或",["l","重新混合的收集包#鱼缸","鱼缸（重新混合后）"],"的",["f","Bundle_Red.png",24]," ",["l","重新混合的收集包#钓鱼大师收集包","钓鱼大师收集包"],"和",["l","重新混合的收集包#鱼缸","鱼缸（重新混合后）"],"的",["f","Bundle_Red.png",24]," ",["l","重新混合的收集包#优质鱼收集包","优质鱼收集包"],"都可以获得 5 份海之菜肴作为奖励。在",["l","矿井#挑战之神庙","危险的矿井"],"或",["l","骷髅洞穴","危险的骷髅洞穴"],"中击杀",["l","矿井#特殊物品","特殊怪物"],"（",["l","史莱姆#特殊史莱姆","特殊史莱姆"],"会有黄色星形触角的明显特征，其他特殊怪物与正常怪物无明显差异）也有概率获得海之菜肴。"]]]],["送礼",2,[["t",[[{"h":1,"c":2,"v":["收到海之菜肴后"]}],[{"h":1,"v":["最爱\n+80"]},[["f","Linus_Icon.png",24]," ",["l","莱纳斯","莱纳斯"]]],[{"h":1,"v":["喜欢\n+45"]},[["f","Harvey_Icon.png",24]," ",["l","哈维","哈维"]," • ",["f","Sam_Icon.png",24]," ",["l","山姆","山姆"]," • ",["f","Shane_Icon.png",24]," ",["l","谢恩","谢恩"]," • ",["f","Alex_Icon.png",24]," ",["l","亚历克斯","亚历克斯"]," • ",["f","Elliott_Icon.png",24]," ",["l","艾利欧特","艾利欧特"]," • ",["f","Sebastian_Icon.png",24]," ",["l","塞巴斯蒂安","塞巴斯蒂安"]," • ",["f","Haley_Icon.png",24]," ",["l","海莉","海莉"]," • ",["f","Leah_Icon.png",24]," ",["l","莉亚","莉亚"]," • ",["f","Maru_Icon.png",24]," ",["l","玛鲁","玛鲁"]," • ",["f","Penny_Icon.png",24]," ",["l","潘妮","潘妮"]," • ",["f","Emily_Icon.png",24]," ",["l","艾米丽","艾米丽"]," • ",["f","Abigail_Icon.png",24]," ",["l","阿比盖尔","阿比盖尔"]," • ",["f","Pierre_Icon.png",24]," ",["l","皮埃尔","皮埃尔"]," • ",["f","Caroline_Icon.png",24]," ",["l","卡洛琳","卡洛琳"]," • ",["f","Lewis_Icon.png",24]," ",["l","刘易斯","刘易斯"]," • ",["f","Marnie_Icon.png",24]," ",["l","玛妮","玛妮"]," • ",["f","Rob