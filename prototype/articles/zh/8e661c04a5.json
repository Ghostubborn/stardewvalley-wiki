{"s":[[null,1,[["p",["工作小食是一种",["l","打造","可食用的打造物品"],"。制作配方可在",["l","采集","采集技能"],"等级达到1级时获得。在任何季节的任何时间，翻动",["l","垃圾桶","垃圾桶"],"也有概率找到工作小食。"]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","亚历克斯","亚历克斯"]]],[{"h":1,"v":["不喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]]]]]],["裁制",2,[["p",["工作小食可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","牛仔夹克"],"。工作小食可用于",["l","染色","染色"],"。放置在",["l","染色","染料罐"],"内时，工作小食可用作橙色染料。放置在",["l","染色","缝纫机"],"内时，工作小食还可用作棕色染料。"]],["p",["可以用作橙色",["l","染色","染料"],"。"]]]],["任务",2,[["p",["饲养有",["l","小龙虾","小龙虾"],"、",["l","玉黍螺","玉黍螺"],"或",["l","蜗牛","蜗牛"],"的",["l","鱼塘","鱼塘"],"在容量从7条鱼提升到10条鱼的时候，会出现要求玩家提供一个工作小食的",["l","鱼塘","鱼塘任务"],"。"]]]]]}