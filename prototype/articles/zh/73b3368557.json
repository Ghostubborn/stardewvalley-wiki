{"s":[[null,1,[["p",["鹦鹉螺是一种",["l","采集#沙滩","沙滩采集品"],"，可以在",["l","冬季","冬季"],"的",["l","沙滩","沙滩"],"上或任何",["l","季节","季节"],"的",["l","农场地图#Beach","海滩农场"],"上",["l","采集","采集"],"获得。在激活了",["l","矿井#挑战之神庙","挑战之神庙"],"，或处于",["l","任务#Danger In The Deep","“深处的危险”任务"],"期间，在",["l","矿井","矿井"],"（1~29 层）中也有可能生成鹦鹉螺。"]],["p",["旅行货车会以 360–1,000金 的价格随机出售。当玩家与",["l","德米特里厄斯","德米特里厄斯"],"的友谊值大于 0 时，他可能会随信赠送一个鹦鹉螺作为礼物。所有咸水",["l","蟹笼","蟹笼"],"鱼类的",["l","鱼塘","鱼塘"],"在数量到达 5 时都有概率产出 1 个鹦鹉螺。在",["l","冬日星盛宴","冬日星盛宴"],"上，如果给玩家送礼物的村民是除",["l","克林特","克林特"],"、",["l","艾芙琳","艾芙琳"],"、",["l","玛妮","玛妮"],"、",["l","罗宾","罗宾"],"或",["l","威利","威利"],"以外的成人，玩家也可能获得一个鹦鹉螺。"]],["p",["鹦鹉螺可以作为装饰品放入",["l","鱼缸","鱼缸"],"中。"]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","艾芙琳","艾芙琳"],"、",["l","雷欧","雷欧"]]],[{"h":1,"v":["一般"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]],[{"h":1,"v":["讨厌"]},[["l","哈维","哈维"]]]]]]],["收集包",2,[["p",["土地研究收集包需要 1 个鹦鹉螺"]]]],["配方",2,[["p",["鹦鹉螺不用于任何",["l","打造#可打造物品","配方"],"。"]]]],["裁制",2,[["p",["鹦鹉螺可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成可染色的 ",["l","裁缝","吊带上衣"],"。鹦鹉螺还可用作",["l","染色#染料罐","染料罐"],"和",["l","染色#缝纫机","缝纫机"],"的橙色染料。"]]]],["任务",2,[["p",["饲养有",["l","鲟鱼","鲟鱼"],"的",["l","鱼塘","鱼塘"],"在数量从7提升到10的时候，会出现要求玩家提供1个鹦鹉螺的鱼塘任务。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.4#1.4","1.4"],"：现在可用于",["l","裁缝","裁缝"],"。现在可用于",["l","鱼塘","鱼塘"],"任务。现在可由",["l","鱼塘","鱼塘"],"产出。"]],[1,[["l","版本历史/1.5#1.5","1.5"],"：现在可以在任何季节于",["l","农场地图#Beach","海滩农场"],"以及",["l","矿井#危险矿井","危险矿井"],["l","采集","采集"],"获得。"]],[1,[["l","版本历史#1.6","1.6"],"：现在可以在",["l","沙漠节","沙漠节"],"期间购买。现在可以作为装饰品放入",["l","鱼缸","鱼缸"],"中。"]]]]]]],"f":[["来源",[["l","采集","采集"]]],["季节",["冬季"]],["售价",["120金"]]]}