{"s":[[null,1,[["p",["鹦鹉螺可以在",["l","冬季","冬季"],["l","沙滩","沙滩"],"、任何季节的",["l","农场地图#Beach","海滩农场"],"以及",["l","矿井#挑战之神庙","危险矿井"],"1-29层通过",["l","采集","采集"],"获得。玩家可以从",["l","德米特里厄斯","德米特里厄斯"],"邮件中随机收到一个。它也可以作为礼物在",["l","冬日星盛宴","冬日星盛宴"],"时收到。",["l","动物#宠物","宠物"],"乌龟达到最大",["l","动物#好感度","好感度"],"后，每天第一次被抚摸也有可能掉落一个鹦鹉螺。它也会在",["l","旅行货车","旅行货车"],"中以360–1,000金的价格随机出售。",["l","沙漠节","沙漠节"],"期间，",["l","德米特里厄斯","德米特里厄斯"],"会在其",["l","沙漠节#村民商铺","商铺"],"以50卡利科蛋 ",["l","卡利科三花蛋","卡利科三花蛋"],"的价格出售鹦鹉螺（限1个）。"]],["p",["当",["l","鱼塘","鱼塘"],"中饲养有",["l","蟹笼","蟹笼"],["l","鱼","生物"],"的数量达到9时，它们会有概率在",["l","鱼塘","鱼塘"],"中生产1个鹦鹉螺。"]],["p",["鹦鹉螺可以作为装饰品放入",["l","鱼缸","鱼缸"],"中。"]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","雷欧","雷欧"],"、",["l","艾芙琳","艾芙琳"]]],[{"h":1,"v":["一般"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"]]],[{"h":1,"v":["讨厌"]},[["l","哈维","哈维"]]]]]]],["收集包",2,[["p",["它用于土地研究收集包。"]]]],["配方",2,[["p",["没有任何配方需要鹦鹉螺。"]]]],["裁制",2,[["p",["鹦鹉螺可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成可染色的 ",["l","裁缝","吊带上衣"],"。鹦鹉螺还可用作",["l","染色#染料罐","染料罐"],"和",["l","染色#缝纫机","缝纫机"],"的橙色染料。"]]]],["任务",2,[["p",["饲养有",["l","鲟鱼","鲟鱼"],"的",["l","鱼塘","鱼塘"],"在数量从7提升到10的时候，会出现要求玩家提供1个鹦鹉螺的鱼塘任务。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.4","1.4"],"：现在可用于",["l","裁缝","裁缝"],"。现在可用于",["l","鱼塘","鱼塘"],"任务。现在可由",["l","鱼塘","鱼塘"],"产出。"]],[1,[["l","版本历史#1.5","1.5"],"：现在可以在任何季节于",["l","农场地图#Beach","海滩农场"],"以及",["l","矿井#危险矿井","危险矿井"],[