{"s":[[null,1,[["p",["草莓种子是一种种子，成熟后得到",["l","草莓","草莓"],"。"]],["p",["草莓种子可以在",["l","复活节","复活节"],"花费100金买到。",["l","沙漠节","沙漠节"],"第1日和第3日，",["l","沙漠节#卡利科三花蛋商人","卡利科三花蛋商人"],"会分别以5卡利科蛋和6卡利科蛋 ",["l","卡利科三花蛋","卡利科三花蛋"],"的价格出售草莓种子。",["l","玛鲁","玛鲁"],"也会在其沙漠节的",["l","沙漠节#村民商铺","商铺"],"以10卡利科蛋 ",["l","卡利科三花蛋","卡利科三花蛋"],"的价格出售草莓种子（限20个）。草莓种子也可以使用",["l","种子生产器","种子生产器"],"获得。"]],["p",["成熟时，植株每4天产出1个草莓，有小概率得到额外的草莓。"]]]],["生长阶段",2,[["t",[[{"h":1,"v":["阶段1"]},{"h":1,"v":["阶段2"]},{"h":1,"v":["阶段3"]},{"h":1,"v":["阶段4"]},{"h":1,"v":["阶段5"]},{"c":2,"h":1,"v":["收成"]}],[[["f","Strawberry_Stage_1.png",48]],[["f","Strawberry_Stage_2.png",48]],[["f","Strawberry_Stage_3.png",48]],[["f","Strawberry_Stage_4.png",48]],[["f","Strawberry_Stage_5.png",48]],[["f","Strawberry_Stage_6.png",48]],[["f","Strawberry_Stage_7.png",48]]],[["1天"],["1天"],["2天"],["2天"],["2天"],["共: 8天"],["每隔4天继续产出。"]]]]]],["送礼",2,[["t",[[{"h":1,"v":["不喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]]]]]],["注意",2,[["l",0,[[1,["与大多数其他种子不同，草莓种子售价为0。"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.0","1.0"],"：加入游戏。"]],[1,[["l","版本历史#1.6","1.6"],"：现在可以在",["l","沙漠节","沙漠节"],"期间购买。"]]]]]]]}