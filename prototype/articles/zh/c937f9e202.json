{"s":[[null,1,[["p",["鼓块是",["l","家具","家具"],"一种。打造鼓块的配方可以在",["l","罗宾","罗宾的六心事件"],"中获得。当玩家向",["l","博物馆","博物馆"],"捐赠三件",["l","古物","古物"],"（包含",["l","古代鼓","古代鼓"],"）的时候，",["l","冈瑟","冈瑟"],"会给玩家一个鼓块作为",["l","博物馆","奖励"],"。"]],["p",["如果玩家用鼠标右键单击鼓块，可以改变从鼓块旁经过时触发的声音。"]],["p",["鼓块共有七种音色，按右键次数从0-6分别是嗵鼓3，军鼓，闭镲，开镲，底鼓，嗵鼓，节拍器。"]]]],["送礼",2,[["t",[[{"h":1,"v":["讨厌"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","雷欧","雷欧"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"]]]]]]]],"f":[["来源",[["l","打造","打造"],["l","博物馆","博物馆"],"捐赠"]],["原料",[["i","(O)390","石头×10"],["i","(O)378","铜矿石×2"],["i","(O)771","纤维×20"]]],["售价",["100金"]]]}