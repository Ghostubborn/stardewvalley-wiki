{"s":[[null,1,[["p",["卡利科沙漠是",["l","鹈鹕镇","鹈鹕镇"],"西北方向上远方的一个地图外部区域。这里的天气永远晴朗，并且四季如一。"]],["p",["在完成",["l","社区中心","社区中心"],"的",["l","收集包#金库","金库收集包"],"或者在",["l","Joja社区发展申请书","Joja社区发展申请书"],"以",["f","Gold.png",18],"40,000的价格购买“公共汽车”，修复",["l","巴士站","巴士站"],"的巴士之前，沙漠是无法进入的。"]]]],["特征",2,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]}],[[["f","Skull_Cavern_1.thumb.webp",200]],[["l","骷髅洞穴","骷髅洞穴"]],[["l","骷髅洞穴","骷髅洞穴"],"的入口位于沙漠西北角。",["l","头骨钥匙","头骨钥匙"],"可以用来打开洞穴的门。"]],[[["f","Oasis_ZH.thumb.webp",120]],[["l","绿洲","绿洲"]],{"b":[["p",[["l","绿洲","绿洲"],"是位于沙漠西南部的一间商店。它由",["l","桑迪","桑迪"],"经营，售卖一些在鹈鹕镇买不到的种子，以及一个额外的物品，具体取决于当天是星期几。"]],["l",false,[[1,["完成\"神秘的齐\"任务后，玩家可以通过绿洲进入赌场。"]]]]]}],[[["f","Desert_Trader.thumb.webp",200]],[["l","沙漠商人","沙漠商人"]],[["l","沙漠商人","沙漠商人"],"的帐篷位于沙漠地图的东部。"]],[[["f","Pillars.thumb.webp",200]],["三根柱子"],["在沙漠的东北部可以找到三根柱子，此处与游戏中的一个",["l","彩蛋#银河剑","彩蛋"],"有关。"]],[[["f","Warp_Totem_Desert_location.thumb.webp",200]],["传送雕像"],["玩家可以使用",["l","传送图腾：沙漠","传送图腾：沙漠"],"或",["l","沙漠图腾柱","沙漠图腾柱"],"传送到沙漠，这两种方法都会把玩家传送到位于沙漠商人南边的传送雕像处。巴士也会在玩家传送时出现在沙漠，以便玩家像平常一样乘车返程。"]],[[["f","Bones.thumb.webp",200]],["沙之巨龙"],["在",["l","绿洲","绿洲"],"商店正北方的一座沙丘之上，有一堆沙之巨龙遗留下来的巨大骨头。站在该生物的头骨附近时，可以与其交互，显示文字“它张着大嘴，对着沙漠太阳。即使死后也贪得无厌。”它与",["l","齐先生","齐先生"],"的任务线有关。"]]]]]],["采集",2,[["g",[["DesertForageLocations.thumb.webp",320,["沙漠中可以生成可采集物品的位置。"],"DesertForageLocations.webp"]]],["p",["沙漠中的",["l","采集","可采集物品"],"全年相同："]],["l",false,[[1,[["f","Coconut.png",24]," ",["l","椰子","椰子"],"（50%）和",["f","Cactus_Fruit.png",24]," ",["l","仙人掌果子","仙人掌果子"],"（50%）"]]]],["p",["可采集物品全年都以平均每晚2.0个的速率生成。 地图上的红色和洋红色地块即为可生成采集物品的位置。当原生的树存在时，洋红色地块生成物品的几率降低90%，因为它们被判定为在原生树的后面。"]],["p",["沙漠中的原生",["l","树","树"],"均为",["l","树#棕榈树","棕榈树"],"，可以被砍倒。棕榈树不掉落种子，但偶尔会在被砍倒或摇晃时掉落椰子。棕榈树上不能放置",["l","树液采集器","树液采集器"],"。"]],["p",["此外，常规树木（枫树、橡树、松树和桃花心木）均可种植在整个沙漠之中。"]]]],["古物",2,[["p",["在沙漠挖掘",["l","远古斑点","远古斑点"],"可发现的",["l","古物","古物"],"如下："]],["l",false,[[1,[["f","Palm_Fossil.png",24]," ",["l","棕榈化石","棕榈化石"],"（7%）"]],[1,[["f","Golden_Relic.png",24]," ",["l","黄金遗物","黄金遗物"],"（6%）"]],[1,[["f","Golden_Mask.png",24]," ",["l","黄金面具","黄金面具"],"（3%）"]]]],["p",["其他可能发现的物品如下："]],["l",false,[[1,["1-3 ",["f","Clay.png",24]," ",["l","粘土","粘土"],"（48%）"]],[1,[["f","Lost_Book.png",24]," ",["l","遗失之书","遗失之书"],"（20%）；如果已找到全部遗失之书，任何潜在的遗失之书都将被替换为",["f","Mixed_Seeds.png",24]," ",["l","混合种子","混合种子"],"。"]],[1,["1-3 ",["f","Stone.png",24]," ",["l","石头","石头"],"（16%）"]],[1,["未发现的",["f","Secret_Note.png",24]," ",["l","秘密纸条","秘密纸条"],"：高达4%的几率，仅当玩家拥有放大镜。"]]]],["p",["沙漠中永远不会发现",["l","雪山药","雪山药"],"、",["l","冬根","冬根"],"和",["l","稻苗","稻苗"],"。"]],["p",["远古斑点的平均生成速率是每晚1.0个，冬季除外，其速率会增至每晚1.4个。"]]]],["钓鱼",2,[["p",["在沙漠中钓鱼的主要地点是西北部的池塘。玩家在这里可以钓到两种独特的鱼：",["l","沙鱼","沙鱼"],"和",["l","蝎鲤鱼","蝎鲤鱼"],"。其中沙鱼是",["l","收集包#鱼缸","鱼缸"],"的",["f","Bundle_Red.png",24]," ",["l","收集包#特色鱼类收集包","特色鱼类收集包"],"所需要的。"]],["p",["如果玩家的",["l","钓鱼","钓鱼"],"技能足够高，就可以在钓鱼时把鱼钩抛入地图南边的水池，从而在水池中钓鱼。但是，从这个水池中的钓到的鱼只有普通品质，因为整个水池的",["l","钓鱼#钓鱼区","钓鱼区"],"为0。",["l","金字塔贴纸","金字塔贴纸"],"在这里有10%的几率被钓到。"]],["g",[["DesertPondSouth.png",200,["南边的水池"]]]],["t",[[{"h":1,"c":2,"v":[]},{"h":1,"c":20,"v":["时间"]}],[{"c":2,"v":[["f","All_Seasons_Icon.png",24]," ",["l","季节","任意季节"]]},{"h":1,"v":["06"]},{"h":1,"v":["07"]},{"h":1,"v":["08"]},{"h":1,"v":["09"]},{"h":1,"v":["10"]},{"h":1,"v":["11"]},{"h":1,"v":["12"]},{"h":1,"v":["13"]},{"h":1,"v":["14"]},{"h":1,"v":["15"]},{"h":1,"v":["16"]},{"h":1,"v":["17"]},{"h":1,"v":["18"]},{"h":1,"v":["19"]},{"h":1,"v":["20"]},{"h":1,"v":["21"]},{"h":1,"v":["22"]},{"h":1,"v":["23"]},{"h":1,"v":["00"]},{"h":1,"v":["01"]}],[{"c":2,"v":[["i","(O)164","沙鱼"]]},{"c":14,"v":[]},{"c":6,"v":[]}],[{"c":2,"v":[["i","(O)165","蝎鲤鱼"]]},{"c":14,"v":[]},{"c":6,"v":[]}],[{"c":2,"v":[["i","(O)153","绿藻"]]},{"c":20,"v":[]}]]]]],["你知道吗",2,[["l",false,[[1,["巴士穿过隧道来到沙漠的部分可能是借鉴了任天堂的游戏“地球冒险2”。"]]]]]],["历史",2,[["l",false,[[1,["1.0：加入游戏。"]],[1,["1.07：修复了沙漠中会出现雪山药的问题。"]],[1,["1.4：新增沙漠商人。修复了冬季可以挖出雪山药和冬根的问题。修复了一些界面上的错误。"]],[1,["1.4.1：沙漠商人周四魔法糖冰棍的购买数量的限制修改为每周一个。"]],[1,["1.4.4：修复了蟹笼放置在沙漠池塘中时渲染出现错误的问题。修