{"s":[[null,1,[["p",["财宝箱是一种特殊物品，可通过多种途径获得。"]],["p",["财宝箱可以作为",["l","友谊#喜欢的礼物","普遍喜欢的礼物"],"送给",["l","居民","居民"],"，除",["l","莱纳斯","莱纳斯"],"外的其他",["l","居民","居民"],"对财宝箱的态度均为喜欢。财宝箱也可以作为装饰品放进",["l","鱼缸","鱼缸"],"中。"]]]],["获取",2,[["p",["财宝箱可通过以下方式找到："]],["l",0,[[1,["在",["l","兑奖券","兑奖机"],"处获取到第 22 个奖励后，循环奖励档位的第 2 档可固定获得 1 个财宝箱。"]],[1,["打开",["l","古物宝藏","古物宝藏"],"时有 3.7% 的概率获得。"]],[1,["打开",["l","金色谜之盒","金色谜之盒"],"时有 1.57% 的概率获得。"]],[1,["打开",["l","谜之盒","谜之盒"],"时有 0.8% 的概率获得。"]],[1,[["l","鱿鱼节","鱿鱼节"],"的第二天通过钓取 7 只",["l","鱿鱼","鱿鱼"],"后领取金星奖励获得。"]],[1,["在",["l","秘密纸条#秘密纸条 #16","秘密纸条 #16"],"描述的红“X”上挖掘可得到 1 个财宝箱。"]],[1,["达到钓鱼 2 级后，打开",["l","钓鱼#宝箱","钓鱼宝箱"],"有 0.24% 的概率获得。"]],[1,["当饲养有",["l","幽灵鱼","幽灵鱼"],"的",["l","鱼塘","鱼塘"],"在数量到达 9 时，每天有 0.3% 的几率产出 1 个财宝箱。"]]]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]],[{"h":1,"v":["不喜欢"]},[["l","莱纳斯","莱纳斯"]]]]]]],["收集包",2,[["p",["财宝箱不用于任何",["l","收集包","收集包"],"。"]]]],["裁制",2,[["p",["财宝箱可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["i","(H)62","海盗帽"],"。财宝箱还可用作",["l","染色#染料罐","染料罐"],"和",["l","染色#缝纫机","缝纫机"],"的黄色染料。"]]]],["任务",2,[["p",["财宝箱不用于任何",["l","任务","任务"],"。"]]]],["你知道吗",2,[["l",0,[[1,["如果尝试将财宝箱送给",["l","莱纳斯","莱纳斯"],"，他将会把礼物退还给玩家，但计入送礼次数且产生好感度变动。"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.0#1.0","1.0"],"：加入游戏。"]],[1,[["l","版本历史/1.3#1.3","1.3"],"：在找到",["l","秘密纸条","秘密