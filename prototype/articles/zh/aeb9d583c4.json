[1,[["i","(W)46","长柄锤"]]],[1,[["i","(W)19","暗影匕首"]]]]]]},[]],[["90"],{"b":[["l",0,[[1,[["i","(W)8","黑曜石之刃"]]],[1,[["i","(W)52","淬火阔剑"]]],[1,[["i","(W)45","蛇形邪剑"]]],[1,[["i","(W)5","骨剑"]]],[1,[["i","(W)60","骨化剑"]]]]]]},[]],[["100"],[["i","(O)434","星之果实"]],["未变化"]],[["110"],{"b":[["l",0,[[1,[["i","(B)514","太空之靴"]]],[1,[["i","(B)878","水晶鞋"]]],[1,[["i","(W)50","钢刀"]]],[1,[["i","(W)28","巨锤"]]]]]]},[]],[["120"],["头骨钥匙"],["未变化"]]]]]],["楼梯",3,[["p",["怪物、岩石、矿层刷新都有概率直接出现楼梯。"]],["p",["矿层加载后，有 95% 的概率会加载一个楼梯。游戏会随机选择一个方格，且如果是没有矿石或岩石在方格上时，楼梯会直接出现在矿层内。这会阻止楼梯在岩石下生成。"]],["p",["某些矿层开始时就自带楼梯（第 12、52、92 层，骷髅洞穴的宝箱层）。这不会影响楼梯在岩石下生成。"]],["p",["当怪物在空白的地块上被击杀时，都有 15% 的初始概率在此处出现一个楼梯。拥有",["l","矮人之王雕像","矮人之王雕像"],"对应增益效果时会将此概率额外提高7%，达到22%。 这不会影响楼梯在岩石下生成。"]],["p",["每个被破坏的岩石都有概率生成梯子，所剩岩石越少，则生成概率越高。若成功生成梯子，那么将阻止其他岩石继续生成梯子。与之相反的是，骷髅洞穴里每个被摧毁的岩石会有20%概率生成竖井而非梯子，且成功生成竖井后，不会阻止其他岩石继续生成梯子或竖井。"]],["p",["具体而言：每个被摧毁的岩石都有 2% 的基础概率生成梯子。这一概率会受每日",["l","运气","运气"],"影响，最高增加2.5%（其中0.5%来自",["l","特殊的魅力","特殊的魅力"],"），最低减少2%。与此同时，运气增益、楼层是否有敌人、",["l","矮人之王雕像","矮人之王雕像"],"的对应增益（找到梯子和竖井的几率更高）也会影响该概率。举例来说，已知食物提供的运气增益每点可增加1%概率，假设玩家拥有最高每日运气和+1运气增益，那么每摧毁一块岩石，生成梯子的基础概率就是2% + 2.5% + 1% = 5.5%。在此基础之上，还需要加上剩余岩石数量的倒数（例如：若剩余 5 块岩石，则1/5 = 0.2 = 20%，岩石生成梯子的概率增加 20%；若剩余 100 块岩石，则1/100 = 0.01 = 1%，概率增加1%）。如果本层没有剩余的怪物，那么再增加 4%。最后，在计算完每日运气、运气增益和无剩余怪物的加成后，",["l","矮人之王雕像","矮人之王雕像"],"的对应增益（找到梯子和竖井的几率更高）会使最终概率再乘以1.25。"]]]],["木箱和木桶",3,[["p",["矿井中的木箱和木桶在被破坏的时候，会随机掉落下表罗列的物品。木箱和木桶的外观与",["l","售卖","发货箱"],"和",["l","木桶","木桶"],"设备的外观十分类似；但不论是木箱还是木桶，掉落物品的几率是一样的。大多数时候，木箱和木桶只掉落一个物品，偶尔会掉落多个物品。"]],["p",["大多数木箱和木桶会在进入该层的时候生成，每年年初，都会重新刷新。木箱和木桶只在玩家第一次进入该层的时候生成一次。当你再次进入该层的时候，木箱和木桶不会再度生成。"]],["p",["一些物品会取代其他物品，这取决于玩家是否已经到达矿井的底部。有两个值，第一个值在到达矿井底部之前，第二个值在之后。"]],["p",["木箱和木桶的掉落物几率表："]],["t",[[{"h":1,"v":["掉落物品"]},{"h":1,"v":["0~39"]},{"h":1,"v":["40~79"]},{"h":1,"v":["80+ (包括 ",["l","骷髅洞穴","骷髅洞穴"],")"]},{"h":1,"v":["困难模式/骷髅洞穴(可能掉落多个物品)"]}],[["无"],["41.42%"],["41.42%"],["42%"],["44%"]],[[["i","(O)390","石头×2~5"]],["9.24%"],["9.24%"],["5.2%"],["8%"]],[[["i","(O)388","木材