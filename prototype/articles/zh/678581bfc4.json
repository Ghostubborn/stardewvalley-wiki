{"s":[[null,1,[["p",["松露是一种只能由",["l","猪","猪"],"在",["l","畜棚","畜棚"],"外生产的蘑菇。松露的基本售价为625金。"]],["p",["尽管松露是由猪产出的，但它们并不像鸡蛋或牛奶那样属于动物产品，也无法从",["l","技能#耕种","畜牧人"],"技能中获得售价加成。猪不会在冬季走出畜棚，因此它们无法在此期间生产松露。"]],["p",["尽管松露也是蘑菇，但在游戏中，松露并没有被分类为",["l","采集","采集"],"物品。它们不在",["l","星露谷展览会","星露谷展览会"],"的采集类别之列，在",["l","物品栏","物品栏"],"中也没有贴上“采集”的标签。然而，它们仍受",["l","技能#采集","收集者"],"和",["l","技能#采集","植物学家"],"技能加成。"]],["p",["每次季节更替会清除上个季节地上没有收集起来的松露。"]],["p",["猪每次刨松露时有0.2%几率出现会移动的",["l","松露蟹","松露蟹"],"，击杀后掉落1~3颗不受",["l","技能#采集","收集者"],"和",["l","技能#采集","植物学家"],"技能影响的松露，小概率掉落",["l","松露油","松露油"],"。",["l","松露蟹","松露蟹"],"不被计算入猪刨出来的松露个数中，这意味着",["l","松露蟹","松露蟹"],"额外增加了",["l","猪","猪"],"的收益。"]],["p",[["l","旅行货车","旅行货车"],"会有微小的几率出售松露，售价为1,875–3,125金。"]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","莉亚","莉亚"]]],[{"h":1,"v":["喜欢"]},[["l","格斯","格斯"]]],[{"h":1,"v":["一般"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","雷欧","雷欧"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"]]],[{"h":1,"v":["讨厌"]},[["l","玛鲁","玛鲁"]]]]]]],["收集包",2,[["p",["松露被用于厨师收集包。"]]]],["工匠物品",2,[["p",["另见：",["l","加工动物制品的收益","加工动物制品的收益"]]],["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名字"]},{"h":1,"v":["描述"]},{"h":1,"v":["材料"]},{"h":1,"v":["设备"]},{"h":1,"v":["时间"]},{"h":1,"v":["恢复"]},{"h":1,"v":["售价"]}],[[["f","Truffle_Oil.png",48]],[["l","松露油","松露油"]],["佳肴必备的原料。"],[["i","(O)430","松露×1"]],[["f","Oil_Maker.png",48],"產油機"],["360分钟 (6小时)"],["能量 38生命值 17"],["1,065金"]]]]]],["配方",2,[["p",["松露不被用于任何配方。"]]]],["裁制",2,[["p",["松露可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成可染色的 ",["l","裁缝","男款深色丝巾上衣"]," 或 ",["l","裁缝","女款深色丝巾上衣"],"。松露可用于",["l","染色","染色"],"。放置在",["l","染色#染料罐","染料罐"],"内时，松露可用作橙色染料。放置在",["l","染色#缝纫机","缝纫机"],"内时，松露还可用作棕色染料。"]]]],["任务",2,[["l",0,[[1,["松露会随机地出现在",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"外的",["l","任务#求助任务","\"需要帮助\" 公告板"],"中，奖励为1,875金和150 ",["l","友谊","友谊"],"点数。在你养猪之前，松露将不会出现在",["l","任务#求助任务","\"需要帮助\" 公告板"],"中。"]],[1,["在",["l","任务#镇长的需求","镇长的需求"],"任务中，刘易斯需要松露油。无论你是否养了一头猪，这个任务都会触发。"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.0","1.0"],"：加入游戏。"]],[1,[["l","版本历史#1.1","1.1"],"：售价从500金上升到625金。"]],[1,[["l","版本历史#1.6","1.6"],"：猪刨地时可能出现松露蟹。现在格斯喜欢松露。"]]]]]]],"f":[["来源",[["l","猪","猪"]]],["季节",["春季\n夏季\n秋季"]],["售价",["625金"]]]}