{"s":[[null,1,[["p",["装饰碗是一种",["l","家具","家具"],"。可能会作为",["l","木匠的商店","木匠的商店"],"的",["l","木匠的商店#随机商品","随机商品"],"以250金出售，或是在",["l","旅行货车","旅行货车"],"中以250–2,500金的价格随机出售，也可以从",["l","家具目录","家具目录"],"中免费获取。"]],["p",["杀死",["l","怪物","怪物"],"、",["l","矿井#木箱和木桶","打破木箱和木桶"],"、摇晃或砍伐",["l","树","树"],"、用",["l","锄头","锄头"],"锄",["l","远古斑点","远古斑点"],"或",["l","淘盘","淘金"],"也有很小的概率找到装饰碗。"]],["p",["玩家在创建存档时如果选择",["l","农场地图#Standard","标准农场"],"，那么游戏开始后",["l","农舍","农舍"],"内默认会有一个装饰碗作为初始家具。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.1","1.1"],"：加入游戏。"]],[1,[["l","版本历史#1.5","1.5"],"：现在可放置在室外。"]],[1,[["l","版本历史#1.6","1.6"],"：现在可以通过玩家的一些活动获得。"]]]]]]]}