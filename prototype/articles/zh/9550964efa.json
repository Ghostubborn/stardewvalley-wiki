{"s":[[null,1,[["p",["橙子树是一种",["l","果树","果树"],"，由",["l","橙子树苗","橙子树苗"],"生长 28 天成熟。成熟的橙子树在星露谷",["l","农场","农场"],"的",["l","夏季","夏季"],"每天都会产出一个",["l","橙子","橙子"],"，种植在",["l","温室","温室"],"和",["l","姜岛","姜岛"],"中时全年结果。"]],["p",[["l","果树","果树"],"树苗只能生长在 3x3 的方格的中央，周围 8 格在生长期间都必须保证没有任何物体、",["l","地板","地板"],"和地形特征（包括",["l","草","草"],"），",["l","果树","果树"],"成熟后不再有此限制。"]],["p",[["l","果树","果树"],"结出的",["l","水果","水果"],"品质会逐年提升，在第三年后可以达到铱星品质。被",["l","闪电","闪电"],"击中的果树会产出",["l","煤炭","煤炭"],"，4 天后恢复为对应的",["l","水果","水果"],"。"]]]],["生长阶段",2,[["t",[[{"h":1,"v":["阶段 1"]},{"h":1,"v":["阶段 2"]},{"h":1,"v":["阶段 3"]},{"h":1,"v":["阶段 4"]},{"h":1,"v":["阶段 5 - 春季、夏季、秋季、冬季"]}],[[["f","Orange_Stage_1.png",86]],[["f","Orange_Stage_2.png",86]],[["f","Orange_Stage_3.png",86]],[["f","Orange_Stage_4.png",86]],[]],[["7 天"],["7 天"],["7 天"],["7 天"],["共：28 天"]]]]]],["画廊",2,[["g",[["OrangeTreeLightning.png",120,["被闪电击中后的橙子树"]]]]]],["历史",2,[["l",false,[[1,["1.0：加入游戏。"]],[1,["1.1：加入成长机制，果树成熟后产出的水果的品质逐年提高。"]],[1,["1.4：果实品质的提升不再需要留空周围 3x3 的地块。修复远古斑点会导致果树无法生长的问题。修复果树树苗周围能够种植普通树苗种子的问题。"]],[1,["1.6：现在砍倒一个果树会产出相应的树苗。如果果树结出的果实品质大于普通品质，它会产出一个与其果实相同品质的树苗。树苗品质越高，果树成熟得越快。"]]]]]]],"f":[["树苗",[["i","(O)630","橙子树苗"]]],["生长时间",["28 天"]],["丰收季节",["星露谷：",["f","Summer.png",24]," ",["l","夏季","夏季"],"\n",["l","姜岛","姜岛"],"：",["f","All_Seasons_Icon.png",24]," ",["l","季节","任意季节"]]],["产出",[["i","(O)635","橙子"]]]]}