]],[1,["复制石英只需要 7 个小时，在所有可复制的物品中时间最短。如果想要获取精炼石英，复制火水晶来制作精炼石英相比直接复制石英制作同等数量的精炼石英会节省 2 个煤炭。"]],[2,["在沙漠商人处可以使用 5 个石英换取一个炸弹，收益略高于用宝石复制机复制钻石并出售所得的资金购买原料制作炸弹，详情参见成本比较。"]],[1,["由于周日可以在沙漠商人处用翡翠换楼梯，复制翡翠用于骷髅洞穴或许是收益最高的方案。"]],[1,["复制红宝石在沙漠商人处兑换香辣鳗鱼食用可以提供一段时间的 +1 速度和 +1 运气，可能是前期使用宝石复制机性价比最高的方案。"]]]]]],["历史",2,[["l",false,[[1,["1.3：修复了可以把一个将复制完成但未取出的宝石换成一个更加贵重的宝石的漏洞。"]],[1,["1.4：在背包和箱子中可以堆叠。"]],[1,["1.5：现在在宝石复制机还未完成复制前移动设备可以掉落投入的物品。"]],[1,["1.6：现在将新宝石插入运作中的宝石复制机时，会自动弹出之前复制的宝石，而不是直接替换。"]],[1,["1.6.9：现在无法将新宝石插入已经含有宝石的宝石复制机，只能通过移除宝石复制机重新放置替换其中的宝石。"]]]]]]],"f":[["来源",[["l","打造","打造"]," • ",["l","博物馆","博物馆"],"捐赠奖励"]],["售出价格",["不可出售"]],["配方来源",[["f","Mining_Skill_Icon.png",24]," ",["l","采矿","采矿"]," 9 级"]],["所需原料",[["i","(O)390","石头"],"（99）",["i","(O)336","金锭"],"（5）",["i","(O)337","铱锭"],"（2）",["i","(O)787","电池组"],"（1）"]],["物品编号",["(BC)21"]]]}