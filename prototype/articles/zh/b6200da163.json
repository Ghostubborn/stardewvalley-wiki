{"s":[[null,1,[["p",["火水晶是一种",["l","矿物","矿物"],"，可以通过在",["l","矿井","矿井"],"（主要是81~119 层）和",["l","骷髅洞穴","骷髅洞穴"],"中",["l","采集","采集"],"获得。敲开",["l","岩浆晶球","岩浆晶球"],"或",["l","万象晶球","万象晶球"],"也有可能会得到火水晶。打开",["l","钓鱼#宝箱","钓鱼宝箱"],"或使用淘盘",["l","淘盘","淘金"],"也有概率获得火水晶。当玩家到达矿井第 80 层后，翻动",["l","垃圾桶","垃圾桶"],"也有概率找到火水晶。"]],["p",["冬日星盛宴上皮埃尔的摊位有概率以 2,500金 的价格出售火水晶"]],["p",["生成在地上的火水晶可以被",["l","打造#炸弹","炸弹"],"炸毁。"]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]],[{"h":1,"v":["不喜欢"]},[["l","莉亚","莉亚"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"]]]]]]],["收集包",2,[["p",["地理学家的收集包需要 1 颗火水晶。"]]]],["打造",2,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["配方来源"]},{"h":1,"v":["所需原料"]}],[[["f","Slime_Egg-Press.png",48]],[["l","史莱姆压蛋器","史莱姆压蛋器"]],["将 100 团史莱姆泥压成一个史莱姆蛋。简直是奇迹！"],["战斗 6 级"],[["i","(O)382","煤炭×25"],["i","(O)82","火水晶×1"],["i","(O)787","电池组×1"]]],[[["f","Dehydrator.png",48]],[["l","烘干机","烘干机"]],["放入 5 个水果或可食用的蘑菇即可烘干。"],[["l","皮埃尔的杂货店","皮埃尔的杂货店"],"以10,000金 购买"],[["i","(O)388","木材×30"],["i","(O)330","粘土×2"],["i","(O)82","火水晶×1"]]]]]]],["熔炼",2,[["p",["要熔炼火水晶，必须把它放入到熔炉中，同时",["l","物品栏","物品栏"],"中必须有至少一个",["l","煤炭","煤炭"],"。使用普通熔炉熔炼火水晶，每次消耗的火水晶数和煤炭数为1:1，使用重型熔炉则为5:3。"]],["t",[[{"h":1,"v":["原料"]},{"h":1,"v":["设备"]},{"h":1,"v":["熔炼加工时间"]},{"h":1,"v":["产品"]}],[[["i","(O)82","火水晶×1"],["i","(O)382","煤炭×1"]],[["f","Furnace.png",48],["l","熔炉"