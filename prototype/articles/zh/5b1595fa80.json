{"s":[[null,1,[["p",["木锤是一种",["l","武器#锤","锤"],"。到达",["l","矿井","矿井"]," 40 层后可在",["l","探险家公会","探险家公会"],"以",["f","Gold.png",18],"2,000 的价格购买。在",["l","矿井","矿井"]," 41~59 层击杀",["l","矿井#特殊物品","特殊怪物"],"（",["l","史莱姆#特殊史莱姆","特殊史莱姆"],"会有黄色星形触角的明显特征，其他特殊怪物与正常怪物无明显差异）或打破",["l","矿井#特殊物品","木箱和木桶"],"也有小概率获得。打开",["l","矿井#重新混合的奖励层","重新混合后的矿井"],"第 60 层的宝箱也有概率获得。"]]]],["漏洞",2,[["p",["由于游戏源码有误，游戏内显示的重量值未必准确，木锤",["l","重量","重量"],"显示为 +3 ，实际重量为 -2。"]]]],["历史",2,[["l",false,[[1,["1.5：武器等级从 2 升至 3，售出价格从",["f","Gold.png",18],"100 升至",["f","Gold.png",18],"150。现在是重新混合后的矿井 60 层宝箱中可能的奖励。"]]]]]]]}