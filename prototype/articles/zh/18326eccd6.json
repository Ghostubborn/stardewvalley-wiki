{"s":[[null,1,[["p",["茶苗需要20日生长成为",["l","茶树","茶树"],"，之后会在",["l","春季","春季"],"、",["l","夏季","夏季"],"、",["l","秋季","秋季"],"（如果在室内则包括",["l","冬季","冬季"],"）的最后一周里每天产出一个",["l","茶叶","茶叶"],"。"]],["p",["茶苗可以像普通的树一样种在地上，也可以种在",["l","花盆","花盆"],"中。茶苗不需要浇水就可以生长，在冬天也可以在室外生长。"]],["p",["茶苗可以在",["l","旅行货车","旅行货车"],"购买到，",["l","沙漠节","沙漠节"],"期间",["l","卡洛琳","卡洛琳"],"也会在其",["l","沙漠节","商铺"],"以30卡利科蛋 ",["l","卡利科三花蛋","卡利科三花蛋"],"的价格出售茶苗（限10个）。除此之外，只能由打造获得。制造配方由触发",["l","卡洛琳","卡洛琳"],"的",["l","卡洛琳","2心事件"],"后第二天的信件中获得。"]]]],["生长阶段",2,[["t",[[{"h":1,"v":["阶段1"]},{"h":1,"v":["阶段2"]},{"h":1,"v":["阶段3"]},{"c":2,"h":1,"v":["收成"]}],[["10天"],["10天"],["最多至并包括\n每个季节的21日"],["共：20天"],["每天持续产出"]]]]]],["送礼",2,[["t",[[{"h":1,"v":["不喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","雷欧","雷欧"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"]]]]]]],["注意",2,[["l",0,[[1,["茶树可当作障碍物以阻挡动物。"]]]]]]]}