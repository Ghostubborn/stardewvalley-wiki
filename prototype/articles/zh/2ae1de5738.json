{"s":[[null,1,[["p",["金蛋是一种动物制品，可由",["l","金色的鸡","金色的鸡"],"产出。金蛋会在当",["l","鸡舍","鸡舍"],"内有足够的空间时生成在鸡舍的地板上，玩家拾取后可获得 5 点耕种经验值。玩家也可以在鸡舍内放置",["l","自动采集器","自动采集器"],"以收集金蛋，但这样不会获得任何经验值。"]],["p",["要想获取金蛋，必须达到",["l","完美","完美"],"。完美进度可在",["l","齐先生的核桃房","齐先生的核桃房"],"内的",["l","齐先生的核桃房#进度跟踪器","进度跟踪器"],"处查看。"]],["p",["达到",["l","完美","完美"],"后，可以通过以下 4 种方式获得第一颗金蛋："]],["l",0,[[1,["在",["l","玛妮的牧场","玛妮的牧场"],"花费100,000金 购买；"]],[1,["在",["l","齐先生的核桃房","齐先生的核桃房"],"花费100齐钻 购买；"]],[1,["触发",["l","随机事件#女巫","女巫事件"],"时，可能会有一个金色女巫会飞过",["l","鸡舍","鸡舍"],"并且在里面留下一颗金蛋；"]],[1,["打开",["l","钓鱼#宝箱","钓鱼宝箱"],"获得（0.12% 概率）。"]]]],["p",["金蛋可以放入",["l","鸡舍","大鸡舍或豪华鸡舍"],"的",["l","孵化器","孵化器"],"中孵化出金鸡。孵化需要9000 分钟（5 天 16 小时 40 分钟），如果玩家选择了",["l","耕种#耕种技能","鸡舍大师"],"职业，则孵化时间减半。"]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","亚历克斯","亚历克斯"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","莉亚","莉亚"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","山姆","山姆"],"、",["l","谢恩","谢恩"]]],[{"h":1,"v":["一般"]},[["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","哈维","哈维"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","玛鲁","玛鲁"],"、",["l","潘妮","潘妮"],"、",["l","罗宾","罗宾"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"]]],[{"h":1,"v":["不喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","矮人","矮人"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","潘姆","潘姆"],"、",["l","文森特","文森特"],"、",["l","法师","法师"]]],[{"h":1,"v":["讨厌"]},[["l","塞巴斯蒂安","塞巴斯蒂安"]]]]]]],["工匠物品",2,[["n",["另见：",["l","加工动物制品的收益","加工动物制品的收益"]]],["p",["金蛋可用于制作",["l","蛋黄酱","蛋黄酱"],"。金蛋本身的品质不影响制成的蛋黄酱的品质，不论将什么品质的金蛋放入蛋黄酱机中加工，都会得到 3 份金星品质的蛋黄酱。"]]]],["缝纫",2,[["p",["金蛋不可用于",["l","裁缝","裁制"],"。"]]]],["任务",2,[["l",0,[[1,[["l","格斯","格斯"],"的",["l","任务#Gus' Famous Omelet","特别任务：格斯的著名煎蛋卷"],"将会需要玩家在任务期间收集并提交24个蛋（任何蛋都适用）。"]],[1,["在",["l","大树桩（地点）#任务线","浣熊的请求"],"的第三个任务、第六个以及之后的任务中，浣熊可能会要求玩家提供 5 个蛋（除恐龙蛋外的任何蛋）。"]]]]]],["历史",2,[["l",0,[[1,[["l","版