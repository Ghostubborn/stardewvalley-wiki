{"s":[[null,1,[["p",["冰封晶球是一种包含着",["l","矿物","矿物"],"、",["l","古物","古物"],"、",["l","矿石","矿石"],"或基础资源的一种",["l","矿物#晶球","晶球"],"。冰封晶球可以通过在",["l","矿井","矿井"],"的 41~79 层中敲碎石头、破坏木桶或使用锄头挖掘土地获得。也可以通过",["l","秋季","秋季"]," 4 日后破坏“",["l","采矿#石头和采矿点","矿井外的石头"],"”，打开",["l","钓鱼#宝箱","钓鱼宝箱"],"获得。在",["l","冬日星盛宴","冬日星盛宴"],"上，如果给玩家送礼物的村民是",["l","克林特","克林特"],"或儿童，玩家也可能获得 5 个或 1 个冰封晶球。",["l","沙漠节","沙漠节"],"期间，",["l","塞巴斯蒂安","塞巴斯蒂安"],"也会在其",["l","沙漠节#村民商铺","商铺"],"以",["f","Calico_Egg.png",20]," 10 ",["l","卡利科三花蛋","卡利科三花蛋"],"的价格出售冰封晶球（限 5 个）。当饲养有",["l","冰柱鱼","冰柱鱼"],"的",["l","鱼塘","鱼塘"],"在数量到达 9 时，每天有一定几率产出 1 个或 5 个冰封晶球。"]],["p",["冰封晶球也可以通过敲碎",["l","采矿#Frozen_Geode_Node","冰封晶球矿"],"获得，这种石头只会出现在",["l","农场地图#Hilltop","山顶农场"],"和",["l","农场地图#Four_Corners","四角农场"],"的小型采石场中。在解锁",["l","铁路","铁路"],"以后，",["l","冬季","冬季"],"时经过的火车也有概率掉落冰封晶球。"]],["p",["冰封晶球可以交给",["l","铁匠铺","铁匠铺"],"的",["l","克林特","克林特"],"敲开以获取其中的物品，费用为",["f","Gold.png",18],"25。它也可使用",["l","晶球破开器","晶球破开器"],"打开。"]],["p",[["l","运气#每日运气","每日运气"],"和",["l","运气#增益效果","运气增益"],"都不会影响冰封晶球的开出物品。"]]]],["冰封晶球内的物品",2,[]],["古物",3,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["售价"]},{"h":1,"v":["出现几率"]}],[[["f","Ancient_Drum.png",48]],[["l","古代鼓","古代鼓"]],["这是一个用木头和动物皮做的鼓。它能发出低沉、经久不息的声音。"],[["f","Gold.png",18],"100"],["1/30"]]]]]],["可采集矿物",3,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["售价"]},{"h":1,"v":["出现几率"]}],[[["f","Frozen_Tear.png",48]],[["l","泪晶","泪晶"]],["传说是由雪怪眼泪结成的晶体。"],[["f","Gold.png",18],"75"],["1/16"]]]]]],["晶球矿物",3,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["售价"]},{"h":1,"v":["出现几率"]}],[[["f","Aerinite.png",48]],[["l","青泥石","青泥石"]],["这个晶石不可思议地轻。"],[["f","Gold.png",18],"125"],["1/30"]],[[["f","Esperite.png",48]],[["l","硅钙石","硅钙石"]],["受到激发后，这种晶石会发出明亮的绿色荧光。"],[["f","Gold.png",18],"100"],["1/30"]],[[["f","Fairy_Stone.png",48]],[["l","精灵石","精灵石"]],["古老的矿工歌谣里说，这些石头是古代精灵的骨头做的。"],[["f","Gold.png",18],"250"],["1/30"]],[[["f","Fluorapatite.png",48]],[["l","氟磷灰石","氟磷