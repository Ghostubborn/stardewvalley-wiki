{"s":[[null,1,[["p",["冰封晶球是一种可能包裹着",["l","矿物","矿物"],"、",["l","古物","古物"],"、矿石或基础资源的一种",["l","矿物","晶球"],"。冰封晶球可以在",["l","矿井","矿井"],"的41~79层、",["l","冬季","冬季"],"的",["l","农场","农场"],"或者",["l","钓鱼","钓鱼宝箱"],"中找到。同",["l","晶球","晶球"],"一样，在",["l","冬日星盛宴","冬日星盛宴"],"期间，玩家可能会收到作为礼物的冰封晶球。饲养有",["l","冰柱鱼","冰柱鱼"],"的",["l","鱼塘","鱼塘"],"的数量达到9条鱼后，可能会产出1或5个冰封晶球。"]],["p",["冰封晶球也可以通过敲碎",["l","采矿","冰封晶球矿"],"获得，这些矿藏可在",["l","农场地图","山顶农场"],"和",["l","农场地图","四角农场"],"的小型采石场中找到。沙漠节期间，",["l","塞巴斯蒂安","塞巴斯蒂安"],"也会在其",["l","沙漠节","商铺"],"以10卡利科蛋 ",["l","卡利科三花蛋","卡利科三花蛋"],"的价格出售冰封晶球（限5个）。"]],["p",["冰封晶球可以交给",["l","铁匠铺","铁匠铺"],"的",["l","克林特","克林特"],"敲开以获取内含的物品，费用为 25金。它也可使用",["l","晶球破开器","晶球破开器"],"打开。"]],["p",[["l","运气","每日运气"],"和运气",["l","效果","效果"],"都不会影响冰封晶球的开出物品。"]]]],["冰封晶球的内容物",2,[]],["古物",3,[["t",[[{"h":1,"v":["名称"]},{"h":1,"v":["出现几率"]}],[[["l","古代鼓","古代鼓"]],["1/30"]]]]]],["可采集矿物",3,[["t",[[{"h":1,"v":["名称"]},{"h":1,"v":["出现几率"]}],[[["l","泪晶","泪晶"]],["1/16"]]]]]],["晶球矿物",3,[["p",["每种晶球矿物的出现几率均为 1/30。"]],["t",[[{"h":1,"v":["名称"]}],[[["l","青泥石","青泥石"]]],[[["l","硅钙石","硅钙石"]]],[[["l","精灵石","精灵石"]]],[[["l","氟磷灰石","氟磷灰石"]]],[[["l","杰明石","杰明石"]]],[[["l","幽灵水晶","幽灵水晶"]]],[[["l","赤铁矿","赤铁矿"]]],[[["l","蓝晶石","蓝晶石"]]],[[["l","酸性月岩","酸性月岩"]]],[[["l","大理石","大理石"]]],[[["l","海洋石","海洋石"]]],[[["l","猫眼石","猫眼石"]]],[[["l","黄铁矿","黄铁矿"]]],[[["l","皂石","皂石"]]]]]]],["资源",3,[["p",["注意，玩家只有在达到矿井的第76层后，才能在敲开冰封晶球时获得",["l","黄金矿石","黄金矿石"],"。在达到76层前，交给",["l","克林特","克林特"],"敲开的冰封晶球获得的黄金矿石都会被替换成铁矿石。除了石头和粘土，表格其他物品都将按以下数量概率获得：30%概率获得1个，30%概率获得3个，30%概率获得5个，9%概率获得10个，1%概率获得20个。石头有50%概率采用以上数值，另有50%概率只获得1个。每开启一个晶球仅能获得1个粘土。"]],["t",[[{"h":1,"v":["名称"]},{"h":1,"v":["出现几率"]}],[[["l","石头","石头"]],["1/8"]],[[["l","粘土","粘土"]],["1/16"]],[[["l","煤炭","煤炭"]],["1/16"]],[[["l","铜矿石","铜矿石"]],["1/16"]],[[["l","铁矿石","铁矿石"]],["1/16"]],[[["l","黄金矿石","黄金矿石"]],["1/16"]]]]]],["收集包",2,[["p",["冰封晶球用于土地研究收集包。"]]]],["送礼",2,[["t",[[{"h":1,"v":["不喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]]]]]],["裁制",2,[["p",["冰封晶球可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","蓝色卫衣"],"。冰封晶球可用于",["l","染色","染色"],"。放置在",["l","染色","染料罐"],"内时，冰封晶球可用作蓝色染料。放置在",["l","染色","缝纫机"],"内时，冰封晶球还可用作青色染料。"]]]],["任务",2,[["l",0,[[1,["饲养有",["l","冰柱鱼","冰柱鱼"],"的",["l","鱼塘","鱼塘"],"在数量从5提升到7的时候，会出现要求玩家提供5个冰封晶球的",["l","鱼塘","鱼塘任务"],"。"]],[1,["饲养有某几种咸水鱼类的",["l","鱼塘","鱼塘"],"在数量从3提升到5的时候，会出现要求玩家提供1个冰封晶球的",["l","鱼塘","鱼塘任务"],"。"]],[1,[["l","大树桩（地点）","大树桩"],"浣熊的第五个任务、第六个以及之后的任务可能会要求玩家提供5个冰封晶球。"]]]]]]]}