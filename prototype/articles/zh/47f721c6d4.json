{"s":[[null,1,[["p",["黄金标签是一种特殊的物品，可以通过在",["l","鳟鱼大赛","鳟鱼大赛"],"节期间捕获",["l","虹鳟鱼","虹鳟鱼"],"获得。获取后可将其交给",["l","鳟鱼大赛#摊位","鳟鱼大赛摊位"],"以兑换各种",["l","鳟鱼大赛#奖品","奖品"],"。"]],["p",["在节日期间，每次捕获虹鳟鱼有 33% 的机会获得一个黄金标签。钓到黄金标签的概率与玩家一次钓上的虹鳟鱼数量成正比，即若一次捕获 2 条虹鳟鱼，钓到黄金标签的概率增加到 66%；一次捕获 3 条虹鳟鱼，则增加到 99%，但每次只能获得 1 个黄金标签。黄金标签通常会直接进入物品栏中，但如果钓上了",["l","钓鱼#宝箱","钓鱼宝箱"],"，那么黄金标签将出现在钓鱼宝箱里。"]],["p",["黄金标签在节日结束后并不会消失，可以保存到以后的节日。"]]]],["送礼",2,[["t",[[{"h":1,"v":["讨厌"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.6","1.6"],"：加入游戏。"]]]]]]],"f":[["来源",[["l","鳟鱼大赛","鳟鱼大赛"]]],["售价",["0金"]]]}