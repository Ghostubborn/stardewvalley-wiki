{"s":[[null,1,[["p",["神怪之鞋是一种",["l","鞋类","鞋类"],"。它拥有游戏内第二高的",["l","免疫","免疫"],"加成，仅次于",["l","美人鱼靴","美人鱼靴"],"的 8 点。"]]]],["获取",2,[["l",0,[[1,["在",["l","矿井","矿井"]," 81~119 层、",["l","骷髅洞穴","骷髅洞穴"],"或",["l","采石场矿井","采石场矿井"],"中击杀",["l","矿井#特殊物品","特殊怪物"],"（",["l","史莱姆#特殊史莱姆","特殊史莱姆"],"会有黄色星形触角的明显特征，其他特殊怪物与正常怪物无明显差异）或打破",["l","矿井#特殊物品","木箱和木桶"]]],[1,["达到钓鱼 2 级后，打开",["l","钓鱼#宝箱","钓鱼宝箱"],"有极小的概率（约 0.012%）获得"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.0#1.0","1.0"],"：加入游戏。"]]]]]]]}