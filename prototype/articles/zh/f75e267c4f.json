{"s":[[null,1,[["p",["金色椰子可在",["l","姜岛","姜岛"],"上通过多种途径获取。当",["l","棕榈树","棕榈树"],"上能看见",["l","椰子","椰子"],"时，摇晃棕榈树有10%的概率获得一个金色椰子。挖掘姜岛上的",["l","远古斑点","远古斑点"],"也可能获得金色椰子。"]],["p",["饲养有至少9条",["l","蓝铁饼鱼","蓝铁饼鱼"],"的",["l","鱼塘","鱼塘"],"每天有概率产出一个金色椰子。"]],["p",["与晶球类似，金色椰子可以由",["l","铁匠铺","铁匠铺"],"的",["l","克林特","克林特"],"敲开，每次需要花费 25金。但是金色椰子无法用",["l","晶球破开器","晶球破开器"],"打开。"]],["p",["在找到并且打开至少一个金色椰子后，可在",["l","姜岛商人","姜岛商人"],"处用10个",["l","椰子","椰子"],"交换一个金色椰子。"]]]],["内容物",2,[["p",["第一次敲开金色椰子时，总是能获得一个",["l","金色核桃","金色核桃"],"。之后，打开金色椰子有几率获得下列物品："]],["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]}],[[["f","Banana_Sapling.png",24]],[["l","香蕉树苗","香蕉树苗"]]],[[["f","Mango_Sapling.png",24]],[["l","芒果幼苗","芒果幼苗"]]],[[["f","Pineapple_Seeds.png",24]],[["l","菠萝种子","菠萝种子"],"（5）"]],[[["f","Taro_Tuber.png",24]],[["l","芋头块茎","芋头块茎"],"（5）"]],[[["f","Mahogany_Seed.png",24]],[["l","桃花心木种子","桃花心木种子"]]],[[["f","Fossilized_Skull.png",24]],[["l","颅骨化石","颅骨化石"]]],[[["f","Iridium_Ore.png",24]],[["l","铱矿石","铱矿石"],"（5）"]],[[["f","Golden_Helmet.png",24]],[["l","金色头盔","金色头盔"]]]]]]],["送礼",2,[["t",[[{"h":1,"v":["讨厌"]},[["l","潘妮","潘妮"],"、",["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","雷欧","雷欧"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"]]]]]]],["裁制",2,[["p",["金色椰子可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成可染色的 ",["i","(S)1297","姜岛比基尼"],"。金色椰子还可用作",["l","染色#染料罐","染料罐"],"和",["l","染色#缝纫机","缝纫机"],"的黄色染料。"]]]],["提示",2,[["l",0,[[1,["玩家可