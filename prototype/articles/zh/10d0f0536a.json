{"s":[[null,1,[["p",["磁铁是一种",["l","鱼饵","鱼饵"],"，可以使玩家在",["l","钓鱼","钓鱼"],"时找到",["l","钓鱼#宝箱","钓鱼宝箱"],"的概率翻倍（从 15% 的基础概率提升到 30%）。尽管描述中说“鱼儿可不喜欢它的味道”，但其同样可以减少 50% 等待鱼上钩的时间。它可以在达到钓鱼 9 级解锁配方后通过",["l","打造","打造"],"获得，此后即可在",["l","鱼店","鱼店"],"以1,000金 购买。也可在",["l","赌场","赌场"],"以1,000齐币 的价格购买（每天限购 20 个）。第一次在",["l","冰雪节","冰雪节"],"的钓鱼比赛中取得胜利时，奖品之一是一个磁铁。还可以在每周的星期三在",["l","科罗布斯","科罗布斯"],"的商店以200金 购买（限 5 个）。"]],["p",["旅行货车会以 100–1,000金 的价格随机出售。达到钓鱼精通后打开",["l","钓鱼#金宝箱","金色钓鱼宝箱"],"时也有 7% 的概率找到磁铁。",["l","威利","威利"],"也有可能会在",["l","冬日星盛宴","冬日星盛宴"],"时把一个磁铁作为礼物送给玩家。"]],["p",["磁铁也可以在",["l","蟹笼","蟹笼"],"中使用，不过效果与",["l","鱼饵（物品）","普通鱼饵"],"完全相同，因为蟹笼并不会产生",["l","钓鱼#宝箱","钓鱼宝箱"],"。"]]]],["使用",2,[["p",["使用"]],["p",[["l","训练用鱼竿","训练用鱼竿"],"和",["l","竹鱼竿","竹鱼竿"],"不能使用鱼饵。只有",["l","玻璃纤维鱼竿","玻璃纤维鱼竿"],"、",["l","铱金鱼竿","铱金鱼竿"],"和",["l","高级铱金鱼竿","高级铱金鱼竿"],"可以使用鱼饵。\n每次抛竿都会消耗一块鱼饵。鱼饵用光时，游戏会弹出一个通知提醒“你已经用掉了最后一块鱼饵”。"]],["p",["键鼠"]],["l",0,[[1,["若要把鱼饵放进鱼竿里，打开背包，鼠标点击鱼饵（ 左键或 右键，取决于你要放置多少鱼饵），然后 右键鱼竿。"]],[1,["若要移除鱼饵， 右键鱼竿。"]]]],["p",["手柄"]],["l",0,[[1,["在 Xbox 手柄上，按 A 选取一组鱼饵（或按 X 选取单个鱼饵），然后按 X 放在鱼竿上。"]],[1,["在 PS4 手柄上， 按 叉键 选取一组鱼饵（或按 方块键 选取单个鱼饵），然后按 方块键 放在鱼竿上。"]],[1,["在 Nintendo Switch 手柄上，打开背包，按 A 选取一组鱼饵（或按 Y 选取单个鱼饵），然后按 Y 放在鱼竿上。"]],[1,["按手柄上的 叉键（NS 上是 Y）来移除鱼饵。"]]]],["p",["移动端"]],["p",["对于移动版，若要把鱼饵放进鱼竿里，打开背包并将鱼饵拖到鱼竿上即可。"]]]],["送礼",2,[["t",[[{"h":1,"v":["讨厌"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]]]]]],["收集包",2,[["p",["磁铁不用于任何",["l","收集包","收集包"],"。"]]]],["任务",2,[["p",["磁铁不用于任何",["l","任务","任务"],"。"]]]],["注意",2,[["l",0,[[1,["尽管描述中说“鱼儿可不喜欢它的味道”，但磁铁对鱼咬钩时间的影响与",["l","鱼饵（物品）","普通鱼饵"],"相同。"]]]],["l",0,[[1,["虽然磁铁可以在",["l","鱼店","鱼店"],"以1,000金的价格购买，但",["l","打造","手工制作"],"更为划算，即使打造",["l","铁锭","铁锭"],"所需的原料完全通过购买获得。在第1年，从",["l","铁匠铺","铁匠铺"],"中购买5个",["l","铁矿石","铁矿石"],"和1个",["l","煤炭","煤炭"],"需要花费900金(即每个磁铁 300金)。在第2年及以后，购买5个",["l","铁矿石","铁矿石"],"和1个",["l","煤炭","煤炭"],"需要花费1,500金（即每个磁铁 500金）。"]]]],["l",0,[[1,["如果玩家能够在",["l","赌场","赌场"],"中通过赌博赚取大量",["f","QiCoin.png",24],"齐币，之后便可以从",["l","赌场#商店","赌场商店"],"中获得几乎免费的磁铁。"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.0#1.0","1.0"],"：加入游戏。"]],[1,[["l","版本历史#1.6","1.6"],"：现在可以从",["l","钓鱼#金宝箱","钓鱼金宝箱"],"中获得。现在可以用在",["l","高级铱金鱼竿","高级铱金鱼竿"],"上。"]]]]]]],"f":[["来源",[["l","打造","打造"]," • ",["l","鱼店","鱼店"]," • ",["l","钓鱼#金宝箱","金色钓鱼宝箱"]," • ",["l","冰雪节","冰雪节"]," • ",["l","科罗布斯","科罗布斯"]," • ",["l","赌场","赌场"]]],["产出",["3"]],["原料",[["i","(O)335","铁锭×1"]]],["售价",["15金"]]]}