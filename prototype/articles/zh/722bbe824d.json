{"s":[[null,1,[["p",["苹果树是一种",["l","果树","果树"],"，由",["l","苹果树苗","苹果树苗"],"生长28天成熟。成熟的苹果树在星露谷",["l","农场","农场"],"的",["l","秋季","秋季"],"每天都会产出一个",["l","苹果","苹果"],"，种植在",["l","温室","温室"],"和",["l","姜岛","姜岛"],"中时全年结果。"]],["p",[["l","果树","果树"],"树苗只能生长在 3x3 的方格的中央，周围8格在生长期间都必须保证没有任何物体、",["l","地板","地板"],"和地形特征（包括",["l","草","草"],"），",["l","果树","果树"],"成熟后不再有此限制。"]],["p",[["l","果树","果树"],"结出的",["l","水果","水果"],"品质会逐年提升，在第三年后可以达到铱星品质。\n在",["l","天气","暴风雨"],"期间，如果闪电击中了果树，果树会连续四天产出",["l","煤炭","煤炭"],"而不是",["l","水果","水果"],"。"]]]],["生长阶段",2,[["t",[[{"h":1,"v":["阶段 1"]},{"h":1,"v":["阶段 2"]},{"h":1,"v":["阶段 3"]},{"h":1,"v":["阶段 4"]},{"h":1,"v":["阶段 5 - 春-夏-秋-冬"]}],[[["f","Apple_Stage_1.png",96]],[["f","Apple_Stage_2.png",96]],[["f","Apple_Stage_3.png",96]],[["f","Apple_Stage_4.png",96]],[["f","Apple_Stage_5.png",384]]],[["7天"],["7天"],["7天"],["7天"],["共：28天"]]]]]]],"f":[["树苗",[["i","(O)633","苹果树苗"]]],["树苗价格",["皮埃尔的杂货店 4,000金；旅行货车 3,000–5,000金"]],["出产",[["i","(O)613","苹果"]]],["成长时间",["28天"]],["丰收季节",["秋季"]]]}