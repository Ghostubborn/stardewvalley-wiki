{"s":[[null,1,[["p",["蛤是一种",["l","鱼","鱼"],"，可以在任何季节的海洋中使用",["l","蟹笼","蟹笼"],"捕获。它也可以在",["l","沙滩","海滩"],"采集获得。",["l","动物","宠物"],"乌龟达到最大",["l","动物","好感度"],"后，每天第一次被抚摸也有可能掉落蛤。偶尔会出现在",["l","旅行货车","旅行货车"],"中，售价150–1,000金。",["l","冬日星盛宴","冬日星盛宴"],"期间，皮埃尔的摊位可能会以500金的价格出售一个蛤。在",["l","矿井","挑战之神庙"],"已激活，或处于",["l","任务","“深处的危险”任务"],"期间时，在",["l","矿井","矿井"],"1~29层也有可能采集到蛤。"]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","艾芙琳","艾芙琳"]]],[{"h":1,"v":["一般"]},[["l","德米特里厄斯","德米特里厄斯"],"、",["l","艾利欧特","艾利欧特"],"、",["l","雷欧","雷欧"],"、",["l","莱纳斯","莱纳斯"],"、",["l","潘姆","潘姆"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","威利","威利"]]],[{"h":1,"v":["不喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","矮人","矮人"],"、",["l","艾米丽","艾米丽"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","刘易斯","刘易斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘妮","潘妮"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","法师","法师"]]],[{"h":1,"v":["讨厌"]},[["l","海莉","海莉"],"、",["l","皮埃尔","皮埃尔"]]]]]]],["收集包",2,[["p",["蛤是蟹笼收集包的一个可选项。"]]]],["配方",2,[["t",[[{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["所需原料"]},{"h":1,"v":["能量 / 生命值"]},{"h":1,"v":["增益效果"]},{"h":1,"v":["增益时长"]},{"h":1,"v":["食谱来源"]},{"h":1,"v":["售出价格"]}],[[["l","生鱼寿司","生鱼寿司"]],["紫菜裹着的鱼和米饭。"],[["f","Fish.png",24]," 任意",["l","鱼","鱼"],"（1）",["i","(O)152","海草×1"],["i","(O)423","大米×1"]],["能量 100\n生命值 45"],["无"],["无"],["烹饪频道（奇数年夏季21日） ",["f","Gus_Icon.png",22]," ",["l","星之果实酒吧","星之果实酒吧"]," 购买 300金"],["220金"]],[[["l","高级肥料","高级肥料"]],["提高土壤品质，增加你种出高品质作物的可能性。使用时加到犁过的土地中。"],[["i","(O)92","树液×4"],["f","Fish.png",24]," 任意",["l","鱼","鱼"],"（1）"],["无"],["无"],["无"],[["f","Farming_Skill_Icon.png",24]," ",["l","耕种","耕种"]," 9 级"],["10金"]],[[["l","生鱼片","生鱼片"]],["切成薄片的生鱼。"],[["f","Fish.png",24]," 任意",["l","鱼","鱼"],"（1）"],["能量 75\n生命值 33"],["无"],["无"],[["