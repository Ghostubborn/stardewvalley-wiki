{"s":[[null,1,[["p",["向日葵种子是一种种子，播种并生长 8 天成熟后可以长出",["l","向日葵","向日葵"],"。向日葵种子可以在",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"、",["l","Joja超市","Joja 超市"],"和",["l","冬季","冬季"]," 16、17 日",["l","夜市#魔法商船","夜市上的魔法商船"],"处买到。"]],["p",[["l","旅行货车","旅行货车"],"会以 ",["f","Gold.png",18],"100 ~ ",["f","Gold.png",18],"1,000 的价格随机出售 1 个或 5 个向日葵种子 。向日葵种子也可以通过将向日葵放入",["l","种子生产器","种子生产器"],"中获得。收获向日葵时会随机掉落 0~2 个向日葵种子。在",["l","夏季","夏季"],"、",["l","秋季","秋季"],"或",["l","冬季","冬季"],"的温室中种下",["l","混合花卉种子","混合花卉种子"],"也有可能变为向日葵种子。"]],["p",["向日葵种子是唯一一种在 ",["l","Joja超市","Joja 超市"],"购买比在",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"要更便宜的种子。"]]]],["生长阶段",2,[["t",[[{"h":1,"v":["阶段 1"]},{"h":1,"v":["阶段 2"]},{"h":1,"v":["阶段 3"]},{"h":1,"v":["阶段 4"]},{"h":1,"v":["收获"]}],[[["f","Sunflower_Stage_1.png",48]],[["f","Sunflower_Stage_2.png",48]],[["f","Sunflower_Stage_3.png",48]],[["f","Sunflower_Stage_4.png",48]],[["f","Sunflower_Stage_5.png",48]],[["f","Sunflower.png",48]]],[["1 天"],["2 天"],["3 天"],["2 天"],["共 8 天"]]]]]],["送礼",2,[["t",[[{"h":1,"c":2,"v":["收到向日葵种子后"]}],[{"h":1,"v":["不喜欢\n-20"]},[["f","Harvey_Icon.png",24]," ",["l","哈维","哈维"]," • ",["f","Sam_Icon.png",24]," ",["l","山姆","山姆"]," • ",["f","Shane_Icon.png",24]," ",["l","谢恩","谢恩"]," • ",["f","Alex_Icon.png",24]," ",["l","亚历克斯","亚历克斯"]," • ",["f","Elliott_Icon.png",24]," ",["l","艾利欧特","艾利欧特"]," • ",["f","Sebastian_Icon.png",24]," ",["l","塞巴斯蒂安","塞巴斯蒂安"]," • ",["f","Haley_Icon.png",24]," ",["l","海莉","海莉"]," • ",["f","Leah_Icon.png",24]," ",["l","莉亚","莉亚"]," • ",["f","Maru_Icon.png",24]," ",["l","玛鲁","玛鲁"]," • ",["f","Penny_Icon.png",24]," ",["l","潘妮","潘妮"]," • ",["f","Emily_Icon.png",24]," ",["l","艾米丽","艾米丽"]," • ",["f","Abigail_Icon.png",24]," ",["l","阿比盖尔","阿比盖尔"]," • ",["f","Pierre_Icon.png",24]," ",["l","皮埃尔","皮埃尔"]," • ",["f","Caroline_Icon.png",24]," ",["l","卡洛琳","卡洛琳"]," • ",["f","Lewis_Icon.png",24]," ",["l","刘易斯","刘易斯"]," • ",["f","Marnie_Icon.png",24]," ",["l","玛妮","玛妮"]," • ",["f","Robin_Icon.png",24]," ",["l","罗宾","罗宾"]," • ",["f","Demetrius_Icon.png",24]," ",["l","德米特里厄斯"