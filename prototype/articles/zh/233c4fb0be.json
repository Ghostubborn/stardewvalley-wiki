{"s":[[null,1,[["p",["向日葵种子是一种种子，成熟后得到",["l","向日葵","向日葵"],"，以及0-2颗向日葵种子。"]],["p",["向日葵种子可以在",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"、",["l","Joja超市","Joja超市"],"买到，",["l","旅行货车","旅行货车"],"也会随机出售。也可以通过",["l","种子生产器","种子生产器"],"或种植",["l","混合花卉种子","混合花卉种子"],"获得。",["l","夜市","夜市"],"的",["l","夜市","魔法商船"],"在",["l","冬季","冬季"],"16和17日也会以200金的价格出售向日葵种子。"]],["p",["向日葵种子是唯一一种在",["l","Joja超市","Joja超市"],"购买比",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"要更便宜的种子。"]]]],["生长阶段",2,[["t",[[{"h":1,"v":["阶段1"]},{"h":1,"v":["阶段2"]},{"h":1,"v":["阶段3"]},{"h":1,"v":["阶段4"]},{"h":1,"v":["收成"]}],[[["f","Sunflower_Stage_1.png",50]],[["f","Sunflower_Stage_2.png",50]],[["f","Sunflower_Stage_3.png",50]],[["f","Sunflower_Stage_4.png",50]],[["f","Sunflower_Stage_5.png",50]]],[["1天"],["2天"],["3天"],["2天"],["共: 8天"]]]]]],["食谱",2,[["p",["不用于任何食谱。"]]]],["工匠物品",2,[["p",["注意，",["l","油","油"],"在游戏中不属于",["l","工匠物品","工匠物品"],"，因此不会受",["l","耕种","工匠技能"],"加成。"]],["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名字"]},{"h":1,"v":["描述"]},{"h":1,"v":["材料"]},{"h":1,"v":["设备"]},{"h":1,"v":["时间"]},{"h":1,"v":["恢复"]},{"h":1,"v":["售价"]}],[[["f","Oil.png",48]],[["l","油","油"]],["可煎可炸的万用食用油。"],[["i","(O)431","向日葵种子×1"]],[["f","Oil_Maker.png",48],["l","产油机","产油机"]],["3200分钟 (≈53.33小时)"],["能量 13生命值 5"],["100金"]]]]]],["漏洞",2,[["l",0,[[1,["通过种植收获的向日葵种子或从",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"购买的种子在",["l","皮埃尔","皮埃尔"],"处出售时，每颗售出价格为20金，而从",["l","Joja超市","Joja超市"],"购买的种子每颗售价是100金。因此，如果从",["l","Joja超市","Joja超市"],"购买向日葵种子，再将种植收获的向日葵种子在物品栏中向其堆叠，所有种子每颗售价都会变成100金。反之亦然：如果将从",["l","Joja超市","Joja超市"],"购买的种子向种植收获的堆叠，所有种子每颗的售价都会变成20金。"]]]]]],["送礼",2,[["t",[[{"h":1,"v":["不喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","