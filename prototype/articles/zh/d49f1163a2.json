{"s":[[null,1,[["p",["烩鱼汤是一道",["l","烹饪","菜肴"],"，可通过升级后的",["l","农舍","农舍"],"内的厨房或",["l","野炊工具","野炊工具"],"制作。"]],["p",["旅行货车会以 525–1,000金 的价格随机出售。打开",["l","钓鱼#金宝箱","金色钓鱼宝箱"],"有 7% 的概率获得 1 份烩鱼汤。打开",["l","谜之盒","谜之盒"],"也有概率获得 1 份烩鱼汤。"]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","莉亚","莉亚"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]],[{"h":1,"v":["不喜欢"]},[["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]]]]]],["收集包",2,[["p",["烩鱼汤不用于任何",["l","收集包","收集包"],"。"]]]],["裁制",2,[["p",["烩鱼汤可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","上衣"],"。烩鱼汤可用于",["l","染色","染色"],"。放置在",["l","染色#缝纫机","缝纫机"],"内时，烩鱼汤可用作灰色染料。"]]]],["任务",2,[["p",["烩鱼汤不用于任何",["l","任务","任务"],"。"]]]],["你知道吗",2,[["p",["虽然名称叫“鱼汤”，但是原料中并没有真正意义上的鱼，只是在游戏内被分类为“",["l","鱼#蟹笼鱼类","蟹笼鱼类"],"”。此外，虽然物品描述中写道“大海的味道扑面而来”，但原料中的",["l","小龙虾","小龙虾"],"和",["l","玉黍螺","玉黍螺"],"都是淡水生物，游戏中也只能在淡水中用",["l","蟹笼","蟹笼"],"捕获。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.4#1.4","1.4"],"：对照玩家菜单的烹饪页面标准化炉灶界面位置。现在可用于",["l","裁缝","裁缝"],"。"]],[1,[["l","版本历史/1.5#1.5","1.5"],"：现在可以用",["l","野炊工具","野炊工具"],"烹饪。"]],[1,[["l","版本历史#1.6","1.6"],"：现在可以从",["l","钓鱼#金宝箱","金色钓鱼宝箱"],"中获得。"]]]]]]]}