l","冬季","冬季"],"限定： ",["i","(O)412","冬根"]," (18%)"]],[1,[["l","冬季","冬季"],"限定： ",["i","(O)416","雪山药"]," (12%)"]],[1,["1-3 ",["i","(O)390","石头"]," (5-10%)"]],[1,["1-3 ",["i","(O)378","铜矿石"]," (2.4-5%)"]],[1,[["l","春季","春季"],"限定： 2-5 ",["i","(O)273","稻苗"]," (4%)"]],[1,["任何没有看过的 ",["i","(O)79/1","秘密纸条"],": 如果玩家有",["l","放大镜","放大镜"],"，则有3%的几率获得该物品。"]]]],["p",["古物每晚以0.1个的平均速度生成，但在冬季，古物则会以每晚1.0个的平均速度生成。"]]]],["钓鱼",2,[["p",["煤矿森林中有两处水体：河流和池塘，且两处水体间的鱼类不同。"]],["p",["钓鱼也是",["l","冰雪节","冰雪节"],"庆祝活动的一部分。"]],["p",["煤矿森林的南部和海洋接壤。虽然可以从悬崖上把鱼线抛到海里（在通往",["l","花舞节","花舞节"],"举办地的桥附近），但在那里只能钓到河鱼，钓不到海鱼。"]]]],["河流",3,[["g",[[null,0,["煤矿森林河流的",["l","钓鱼","钓鱼区域"]],"ForestRiverFishingZones.png"]]],["p",["最主要的",["l","钓鱼","钓鱼"],"地点是横贯煤矿森林的河流。它是横贯",["l","鹈鹕镇","鹈鹕镇"],"河流的延展部分之一，因此包含了可在",["l","鹈鹕镇","鹈鹕镇"],"捕获的大部分",["l","鱼","鱼"],"。"]],["p",[["l","鲢鱼","鲢鱼"],"和",["l","麻哈脂鲤","麻哈脂鲤"],"这两种鱼只能在煤矿森林的河里面钓到（且麻哈脂鲤只能在",["l","夏季","夏季"],"钓到），不能在鹈鹕镇里面钓到；",["l","小嘴鲈鱼","小嘴鲈鱼"],"可以在鹈鹕镇钓到，但不能在煤矿森林的河里面钓到（然而这种鱼却可以在煤矿森林的池塘里面钓到）。"]],["p",["同样，煤矿森林的河也是",["l","鱼","传说鱼类"],"中的",["l","冰川鱼","冰川鱼"],"在",["l","冬季","冬季"],"居住的地方。"]]]],["池塘",3,[["g",[["ForestPondFishingZones.png",200,["煤矿森林池塘的",["l","钓鱼","钓鱼区域"]]]]],["p",["煤矿森林第二个水体就是位于煤矿森林西北部的池塘。在此可钓到鱼类相较于河流少了很多（可钓鱼类：",["l","鲤鱼","鲤鱼"],"、",["l","鲶鱼","鲶鱼"],"、",["l","午夜鲤鱼","午夜鲤鱼"],"、",["l","河鲈","河鲈"],"、",["l","狗鱼","狗鱼"],"、",["l","小嘴鲈鱼","小嘴鲈鱼"],"和",["l","大眼鱼","大眼鱼"],"；能钓到什么取决于鱼出现的季节和时间）。"]],["t",[[{"h":1,"v":["鱼"]},{"h":1,"v":["地点"]},{"h":1,"v":["时间"]},{"h":1,"v":["天气"]}],[{"c":4,"h":1,"v":["春季"]}],[[["i","(O)145","太阳鱼"]],["河流"],["6:00–19:00"],["晴天"]],[[["i","(O)143","鲶鱼"]],["河流"],["6:00–0:00"],["雨天"]],[[["i","(O)702","鲢鱼"]],["河流"],["全天"],["任意"]],[[["i","(O)153","绿藻"]],["河流 / 池塘"],["全天"],["任意"]],[[["i","(O)137","小嘴鲈鱼"]],["池塘"],["全天"],["任意"]],[[["i","(O)706","西鲱"]],["河流"],["9:00–2:00"],["雨天"]],[[["i","(O)132","鲷鱼"]],["河流"],["18:00–2:00"],["任意"]],[[["i","(O)Goby","虾虎鱼"]],["瀑布"],["全天"],["任意"]],[{"c":4,"h":1,"v":["夏季"]}],[[["i","(O)704","麻哈脂鲤"]],["河流"],["6:00–19:00"],["任意"]],[[["i","(O)138","虹