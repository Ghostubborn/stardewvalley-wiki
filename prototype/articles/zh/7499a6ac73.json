,["p",["工具的附魔有迅捷、强力、省力、范围、无底洞、考古学家、丰富、自动上钩、精通、耐用、捕鱼和木屑。（",["l","日记残页","日记残页#8"]," 记录了部分附魔）"]]]],["裁制",2,[["p",["五彩碎片可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"随机制成以下物品之一（可能重复）："]],["l",false,[[1,[["f","Shirt223.png",24]," ",["l","裁缝#上衣","五彩T恤"],"（短袖，胸前有五彩方块图案）"]],[1,[["f","Shirt288a.png",24]," ",["l","裁缝#上衣","男款五彩上衣"]," 或 ",["f","Shirt288b.png",24]," ",["l","裁缝#上衣","女款五彩上衣"],"（白袖子）"]],[1,[["f","Shirt289a.png",24]," ",["l","裁缝#上衣","男款五彩上衣"]," 或 ",["f","Shirt289b.png",24]," ",["l","裁缝#上衣","女款五彩上衣"],"（黑袖子）"]],[1,[["f","Farmer_Pants.png",24]," ",["l","裁缝#下装","五彩裤子"]]],[1,[["f","Genie_Pants.png",24]," ",["l","裁缝#下装","五彩神怪裤"]]]]],["p",["五彩碎片可用于",["l","染色","染色"],"。放置在",["l","染色#缝纫机","缝纫机"],"内时，可以自选颜色。"]]]],["任务",2,[["p",["在",["l","任务#Four_Precious_Stones","“四颗宝石”任务"],"中，需要在 28 天之内收集 4 个五彩碎片并放进",["l","齐先生的核桃房","齐先生的核桃房"],"中的收集箱里。"]]]],["注意",2,[["p",["五彩碎片不能在宝石复制机中复制，根据遗失之书《",["l","遗失之书","科技报告！"],"》，“这种碎片的电动势会对机器产生不良的影响。”"]]]],["历史",2,[["l",false,[[1,["1.0：加入游戏。"]],[1,["1.3.27：现在当玩家到达过矿井底部后，所有怪物均有概率掉落五彩碎片。"]],[1,["1.4：现在可用于失踪的收集包。修正了获取银河剑时一次性消失多个的漏洞。现在可用于裁缝。现在虹鳟鱼鱼塘会有极低的概率生产。"]],[1,["1.5：现在可用于给工具和武器附魔。现在可在火山地牢顶层宝箱获得一个。真正完美的雕像每天产出一个。现在可用于“四颗宝石”任务。"]],[1,["1.6：降低了从铱矿中获得五彩碎片的概率（4%→3.5%）。现在可以从谜之盒、金色谜之盒中概率获得。现在可以敲碎陨石和击杀铱石魔获得。现在可在沙漠节期间购买。"]],[1,["1.6.3：降低了从陨石中获得五彩碎片的概率（100%→25%）。现在“四颗宝石”任务需要玩家在任务期间收集4个五彩碎片。"]]]]]]]}