],[["i","(O)709","硬木×5"],["i","(O)MysticSyrup","神秘糖浆×1"],["i","(O)Moss","苔藓×10"]]]]]]],["裁制",2,[["p",["苔藓不用于",["l","裁缝","裁缝"],"。苔藓可用作",["l","染色#染料罐","染料罐"],"和",["l","染色#缝纫机","缝纫机"],"的绿色染料。"]]]],["任务",2,[["p",["位于",["l","大树桩（地点）","大树桩"],"的",["l","大树桩（地点）","浣熊"],"可能会请求10个苔藓。"]]]],["交易",2,[["p",["一旦解锁，可以在",["l","大树桩（地点）","大树桩（地点）"],"附近与浣熊的妻子交易。"]],["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["售价"]},{"h":1,"v":["要求"]}],[[["f","Broccoli_Seeds.png",48]],[["l","西蓝花种子","西蓝花种子"]],["秋天播种，8 天成熟，收获之后还能继续生长。"],[["i","(O)Moss","苔藓×5"]],["完成第一个任务"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.6","1.6"],"：加入游戏。"]],[1,[["l","版本历史#1.6.3","1.6.3"],"：现在，收获每一片苔藓都可以让你获得1点",["l","技能","采集"],"的经验。苔藓在",["l","天气#天气种类","晴天"],"和",["l","夏季","夏季"],"生长较慢。收获后恢复较慢。成年的",["l","树#绿雨树","绿雨树"],"会提高附近树木的苔藓生长速度。"]],[1,[["l","版本历史#1.6.4","1.6.4"],"：现在可以将",["l","醋","醋"],"倒在树上阻止生长苔藓。"]]]]]]],"f":[["来源",[["l","树","树"]," • ",["l","杂草#特殊杂草","绿雨杂草"]]],["售价",["5金"]]]}