{"s":[[null,1,[["p",["混合花卉种子是一种能种出随机",["l","花","花"],"的种子，可种植出一定种类的花卉（如下表所列）。混合花卉种子在种植时，会随机选择其生长的具体作物。即使是在室内的",["l","温室","温室"],"和",["l","花盆","花盆"],"中，选择通常也仅限于当季作物。混合花卉种子于",["l","冬季","冬季"],"不能在室外种植。但在该季节的室内种植的场合，作物类型是从所有季节的作物中随机选择的。任何时候在",["l","姜岛","姜岛"],"上种植的混合花卉种子也会随机产生任何季节的作物。"]]]],["来源",2,[["l",0,[[1,["在",["l","夏季","夏季"],"用",["l","锄头","锄头"],"挖掘泥土或沙子获得。"]],[1,["在",["l","夏季","夏季"],"用",["l","镰刀","镰刀"],"、",["l","斧头","斧头"],"、",["l","十字镐","十字镐"],"、",["l","锄头","锄头"],"、",["l","武器#剑","剑"],"或",["l","打造#炸弹","炸弹"],"收割",["l","杂草","杂草"],"，如果没有则掉落",["l","纤维","纤维"],"或",["l","混合种子","混合种子"],"（掉落几率：阅读过",["l","浣熊日记","浣熊日记"],"则有9%的几率，否则为5%）"]],[1,[["l","沙漠节","沙漠节"],"期间，",["l","艾米丽","艾米丽"],"会以8卡利科蛋 ",["l","卡利科三花蛋","卡利科三花蛋"],"的价格出售1组混合花卉种子（每组5个，限4组）、",["l","艾芙琳","艾芙琳"],"会以2卡利科蛋 ",["l","卡利科三花蛋","卡利科三花蛋"],"的价格出售（限50个）、",["l","乔迪","乔迪"],"会以2卡利科蛋 ",["l","卡利科三花蛋","卡利科三花蛋"],"的价格出售（限50个）。"]],[1,["在",["l","农场#Beach","海滩农场"],"的",["l","补给箱","补给箱"],"中可能会发现4-5个。"]],[1,["打开",["l","谜之盒","谜之盒"],"可能获得10个（约5.9%的几率）。"]],[1,[["l","镇长的庄园","镇长的庄园"],"里的",["l","镇长的庄园#兑奖机","兑奖机"],"的第3个奖品有50%几率获得15个。"]]]]]],["种子清单",2,[["p",["种植时，混合花卉种子会变为下列种子中的一种。"]],["t",[[{"h":1,"v":["季节"]},{"h":1,"v":["种子"]}],[{"h":1,"v":["春天"]},[["i","(O)427","郁金香球茎"]," • ",["i","(O)429","蓝爵士种子"]]],[{"h":1,"v":["夏天"]},[["i","(O)431","向日葵种子"]," • ",["i","(O)455","夏季亮片种子"]," • ",["i","(O)453","虞美人种子"]]],[{"h":1,"v":["秋天"]},[["i","(O)431","向日葵种子"]," • ",["i","(O)425","玫瑰仙子种子"]]],[{"h":1,"v":["冬天"]},["以上任何一种（只可种在",["l","温室","温室"],"里或室内",["l","花盆","花盆"],"）。"]],[{"h":1,"v":["姜岛"]},[["i","(O)431","向日葵种子"]," • ",["i","(O)455","夏季亮片种子"]," • ",["i","(O)453","虞美人种子"]]]]]]],["送礼",2,[["t",[[{"h":1,"v":["不喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米