{"s":[[null,1,[["p",["樱桃树是一种",["l","果树","果树"],"，由",["l","樱桃树苗","樱桃树苗"],"生长28天成熟。成熟的樱桃树在星露谷",["l","农场","农场"],"的",["l","春季","春季"],"每天都会产出一个",["l","樱桃","樱桃"],"，种植在",["l","温室","温室"],"和",["l","姜岛","姜岛"],"中时全年结果。"]],["p",[["l","果树","果树"],"树苗只能生长在 3x3 的方格的中央，周围8格在生长期间都必须保证没有任何物体、",["l","地板","地板"],"和地形特征（包括",["l","草","草"],"），",["l","果树","果树"],"成熟后不再有此限制。"]],["p",[["l","果树","果树"],"结出的",["l","水果","水果"],"品质会逐年提升，在第三年后可以达到铱星品质。\n在",["l","天气#暴风雨","暴风雨"],"期间，如果闪电击中了果树，果树会连续四天产出",["l","煤炭","煤炭"],"而不是",["l","水果","水果"],"。"]]]],["生长阶段",2,[["t",[[{"h":1,"v":["阶段 1"]},{"h":1,"v":["阶段 2"]},{"h":1,"v":["阶段 3"]},{"h":1,"v":["阶段 4"]},{"h":1,"v":["阶段 5 - 春季，夏季，秋季，冬季"]}],[[["f","Cherry_Stage_1.png",96]],[["f","Cherry_Stage_2.png",96]],[["f","Cherry_Stage_3.png",96]],[["f","Cherry_Stage_4.png",96]],[["f","Cherry_Stage_5.png",384]]],[["7天"],["7天"],["7天"],["7天"],["共：28天"]]]]]],["画廊",2,[["g",[["CherryTreeLightning.png",120,["被闪电击中后的樱桃树"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.4","1.4"],"：果实品质的提升不再需要留空周围3x3的地块了。"]]]]]]],"f":[["树苗",[["i","(O)628","樱桃树苗"]]],["树苗价格",["皮埃尔的杂货店 3,400金；旅行货车 2,550–4,250金"]],["出产",[["i","(O)638","樱桃"]]],["成长时间",["28天"]],["丰收季节",["春季"]]]}