{"s":[[null,1,[["p",["神秘树种是一种",["l","树","野树"],"种子，可以长出",["l","神秘树","神秘树"],"。神秘树种可以在获取采集精通解锁配方后通过打造获得。与其他野树种子不同的是，神秘树种只能通过制作获得，摇晃或砍伐",["l","神秘树","神秘树"],"无法获得神秘树种，神秘树成熟后也不会掉落任何种子。"]],["p",["神秘树种可以种植在土地和沙地上，但是部分地块由于属性设置问题也可以种植它。"]],["p",["除了",["l","冬季","冬季"],"，神秘树种每晚都有大约 15% 的概率生长到下一阶段。总共有 5 个生长阶段，平均成熟时间约为 33.3 天，超过 90% 的神秘树种能在 52 天内完全成熟。"]],["p",["使用",["l","树肥","树肥"],"可以让神秘树种每晚都有 30% 的概率生长到下一个阶段，包括",["l","冬季","冬季"],"，此时的平均成熟时间约为 16.7 天。"]]]],["送礼",2,[["t",[[{"h":1,"v":["不喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]]]]]],["收集包",2,[["p",["神秘树种不用于任何",["l","收集包","收集包"],"。"]]]],["任务",2,[["p",["神秘树种不用于任何",["l","任务","任务"],"。"]]]],["裁缝",2,[["p",["神秘树种不用于任何",["l","裁缝","裁缝"],"和",["l","染色","染色"],"。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.6","1.6"],"：加入游戏。"]]]]]]]}