{"s":[[null,1,[["p",["高级鱼饵是一种",["l","鱼饵","鱼饵"],"，可以使玩家在",["l","钓鱼","钓鱼"],"时鱼的上钩时间减少 67%，同时增加 12 像素的",["l","钓鱼#绿条尺寸","绿条尺寸"],"。它可以在达到钓鱼 4 级解锁配方后通过",["l","打造","打造"],"获得，此后即可在",["l","鱼店","鱼店"],"以100金购买。完成河鱼收集包可以获得 30 个高级鱼饵作为奖励。也可以在",["l","书摊老板","书摊老板"],"处用 1 本",["l","鱼饵和浮漂","鱼饵和浮漂"],"兑换 30 个高级鱼饵。",["l","高级虫饵盒","高级虫饵盒"],"每天会产出 4~5 个高级鱼饵。20 个高级鱼饵还作为",["l","鳟鱼大赛","鳟鱼大赛"],"可能的奖励，以及冬季 12 日",["l","鱿鱼节","鱿鱼节"],"的铜牌奖励。"]],["p",["在达到钓鱼 6 级后打开",["l","钓鱼#宝箱","钓鱼宝箱"],"时也有可能获得若干个高级鱼饵。"]],["p",["在",["l","蟹笼","蟹笼"],"中使用高级鱼饵会降低一半捕获垃圾的概率（如果玩家没有",["l","钓鱼#钓鱼技能","水手"],"职业），同时蟹笼产出的",["l","鱼","鱼"],"类均会变为银星品质。"]]]],["使用",2,[["p",["使用"]],["p",[["l","训练用鱼竿","训练用鱼竿"],"和",["l","竹鱼竿","竹鱼竿"],"不能使用鱼饵。只有",["l","玻璃纤维鱼竿","玻璃纤维鱼竿"],"、",["l","铱金鱼竿","铱金鱼竿"],"和",["l","高级铱金鱼竿","高级铱金鱼竿"],"可以使用鱼饵。\n每次抛竿都会消耗一块鱼饵。鱼饵用光时，游戏会弹出一个通知提醒“你已经用掉了最后一块鱼饵”。"]],["p",["键鼠"]],["l",0,[[1,["若要把鱼饵放进鱼竿里，打开背包，鼠标点击鱼饵（ 左键或 右键，取决于你要放置多少鱼饵），然后 右键鱼竿。"]],[1,["若要移除鱼饵， 右键鱼竿。"]]]],["p",["手柄"]],["l",0,[[1,["在 Xbox 手柄上，按 A 选取一组鱼饵（或按 X 选取单个鱼饵），然后按 X 放在鱼竿上。"]],[1,["在 PS4 手柄上， 按 叉键 选取一组鱼饵（或按 方块键 选取单个鱼饵），然后按 方块键 放在鱼竿上。"]],[1,["在 Nintendo Switch 手柄上，打开背包，按 A 选取一组鱼饵（或按 Y 选取单个鱼饵），然后按 Y 放在鱼竿上。"]],[1,["按手柄上的 叉键（NS 上是 Y）来移除鱼饵。"]]]],["p",["移动端"]],["p",["对于移动版，若要把鱼饵放进鱼竿里，打开背包并将鱼饵拖到鱼竿上即可。"]]]],["送礼",2,[["t",[[{"h":1,"v":["讨厌"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]]]]]],["收集包",2,[["p",["高级鱼饵不用于任何",["l","收集包","收集包"],"。"]]]],["任务",2,[["p",["高级鱼饵不用于任何",["l","任务","任务"],"。"]]]],["裁制",2,[["p",["高级鱼饵不用于",["l","裁缝","裁缝"],"或",["l","染色","染色"],"。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.6","1.6"],"：加入游戏。现在是完成河鱼收集包的奖励。"]],[1,[["l","版本历史#1.6.14","1.6.14"],"：",["l","钓鱼","水手"],"技能无视鱼饵类型的bug被修复，玩家选择",["l","钓鱼","水手"],"技能时，高级鱼饵可正常提升收获的品质。"]]]]]]],"f":[["来源",[["l","打造","打造"]," • ",["l","鱼店","鱼店"]," • ",["l","钓鱼#宝箱","钓鱼宝箱"]," • ",["l","高级虫饵盒","高级虫饵盒"]," • ",["l","书摊老板","书摊老板"]]],["产出",["5"]],["原料",[["l","鱼饵","鱼饵×5"],["i","(O)Moss","苔藓×2"]]],["售价",["1金"]]]}