{"s":[[null,1,[["p",["蘑菇干是一种由",["l","烘干机","烘干机"],"制成的",["l","工匠物品","工匠物品"],"，在游戏中过夜即可完成。"]],["p",["生产1袋蘑菇干需要5个相同质量的蘑菇。",["l","红蘑菇","红蘑菇"],"无法制成蘑菇干。蘑菇干恢复的能量和生命值是基础蘑菇能量/生命值恢复的3倍。蘑菇干的售价取决于使用的蘑菇（7.5倍基本蘑菇价格+25）。"]],["p",["由于烘干机每次使用需要相同质量的5个蘑菇，因此干燥蘑菇的净优势是每使用一个蘑菇（1.5倍蘑菇基本价格+5）。"]],["p",["对于",["l","耕种","工匠"],"，每种蘑菇的收益为（2.1倍蘑菇基本价格+7），总价为（10.5倍蘑菇基本价格+35）。"]],["p",["由于价值仅基于蘑菇的基本价格，与销售蘑菇相比，如果蘑菇质量更高，实际效益会下降。"]],["p",["例如，如果不选择",["l","耕种","工匠"],"，铱星蘑菇通常会在烘干后亏损，而金星蘑菇每个只盈利5金。"]]]],["食谱",2,[["p",["蘑菇干不被用于任何",["l","烹饪","食谱"],"。"]]]],["收集包",2,[["p",["蘑菇干不被用于任何",["l","收集包","收集包"],"。"]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","乔迪","乔迪"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","谢恩","谢恩"],"、",["l","威利","威利"],"、",["l","法师","法师"]]],[{"h":1,"v":["讨厌"]},[["l","贾斯","贾斯"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","文森特","文森特"]]]]]]],["裁缝",2,[["p",["蘑菇干不被用于任何",["l","染色","染料"],"。"]]]],["任务",2,[["p",[["l","大树桩（地点）","大树桩"],"的浣熊会在第三个任务时请求蘑菇干，也可能作为第六个以及之后的任务的一部分请求蘑菇干。"]]]],["提示",2,[["l",0,[[1,[["l","松露","松露"],"不属于蘑菇类别，因此无法放入烘干机。"]]]]]]],"f":[["来源",[["l","工匠物品","工匠物品"]]],["加工设备",[["i","(BC)Dehydrator","烘干机"]]],["原料",["任何相同的蘑菇(5)（除了",["l","红蘑菇","红蘑菇"],"）"]],["加工时间",["过夜"]],["售价",["7.5 × 蘑菇基础售价 + 25"]]]}