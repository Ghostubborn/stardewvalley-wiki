{"s":[[null,1,[["p",["稻苗是一种种子。播种并生长 8 天成熟后可以获得",["l","未碾米","未碾米"],"，需要使用",["l","镰刀","镰刀"],"来收获。稻苗可以从第二年起在",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"处买到。"]],["p",["旅行货车会以 100–1,000金 的价格随机出售。稻苗也可以通过将未碾米放入",["l","种子生产器","种子生产器"],"中获得。除此之外，稻苗还可以通过在",["l","春季","春季"],"除沙滩以外的任意水域的",["l","钓鱼#宝箱","钓鱼宝箱"],"中或挖掘春季的",["l","远古斑点","远古斑点"],"获得，在",["l","冬季","冬季"],"击杀",["l","幽灵头骨","幽灵头骨"],"有 21.43% 的几率掉落稻苗，击杀",["l","矿井","矿井"],"中的",["l","蛆","蛆"],"以及",["l","突变虫穴","突变虫穴"],"或",["l","骷髅洞穴#恐龙层","骷髅洞穴恐龙层"],"的",["l","突变蛆","突变蛆"],"有 10% 的几率掉落稻苗，在",["l","春季","春季"],"击杀",["l","荒野石魔","荒野石魔"],"有 6.25% 的几率掉落稻苗。"]],["p",["若将稻苗种植在水源附近 3 格内，那么只需要 6 天即可成熟，且不需要浇水。"]]]],["送礼",2,[["t",[[{"h":1,"v":["不喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]]]]]],["地图",2,[["p",["下图展示了各类",["l","农场地图","农场地图"],"的可灌溉区域。"]],["g",[["Rice_standard_farm.thumb.webp",320,["标准农场"],"Rice_standard_farm.webp"],["Rice_riverland_farm.thumb.webp",320,["河边农场"],"Rice_riverland_farm.webp"],["Rice_forest_farm.thumb.webp",320,["森林农场"],"Rice_forest_farm.webp"],["Rice_hilltop_farm.thumb.webp",320,["山顶农场"],"Rice_hilltop_farm.webp"],["Rice_wilderness_farm.thumb.webp",320,["荒野农场"],"Rice_wilderness_farm.webp"],["Rice_four_corners_farm.thumb.webp",320,["四角农场"],"Rice_four_corners_farm.webp"],["Rice_beach_farm.thumb.webp",320,["海滩农场"],"Rice_beach_farm.webp"]]]]],["历史",2,[["l",0,[[1,[["l","版