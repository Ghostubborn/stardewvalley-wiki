{"s":[[null,1,[["p",["稻苗是一种种子。稻苗成熟后产出",["l","未碾米","未碾米"],"，需要用",["l","镰刀","镰刀"],"收割。"]],["p",["第二年开始，玩家可以在",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"购买稻苗。稻苗有时会出现在",["l","旅行货车","旅行货车"],"的货物中。",["l","钓鱼","钓鱼宝箱"],"、",["l","春季","春季"],"的",["l","远古斑点","远古斑点"],"都有几率出现稻苗。",["l","矿井","矿井"],"中的",["l","蛆","蛆"],"有10%的几率掉落，",["l","突变虫穴","突变虫穴"],"或",["l","骷髅洞穴","骷髅洞穴史前层"],"的",["l","突变蛆","突变蛆"],"也有一定概率掉落。",["l","幽灵头骨","幽灵头骨"],"在",["l","冬季","冬季"],"有21.43%的几率掉落稻苗。",["l","荒野石魔","荒野石魔"],"在",["l","春季","春季"],"有6.25%的几率掉落稻苗。同样，",["l","种子生产器","种子生产器"],"也可以制作稻苗。"]],["p",["稻苗可以种植在大多数的农田里面，同其他作物一样，每天持续浇水可以让水稻在8天内成熟。然而，如果将稻苗种植在距离",["l","农场池塘","农场池塘"],"或任何水源（",["l","水井","水井"],"和",["l","鱼塘","鱼塘"],"除外）3格内的地方，稻苗会默认已被灌溉，就像被种在稻田里一样。稻田不需要相互连成片，也不需要与池塘相邻，只要在水源3格以内就能算作灌溉。被灌溉的稻苗只需要六天成熟，并且不需要浇水。"]]]],["生长阶段",2,[["p",["当收割的时候，每株水稻都能产出一个未碾米，水稻有10%的可能性会产出更多的未碾米（平均增加0.11个未碾米）。"]],["t",[[{"h":1,"v":["种植区域"]},{"h":1,"v":["阶段 1"]},{"h":1,"v":["阶段 2"]},{"h":1,"v":["阶段 3"]},{"h":1,"v":["阶段 4"]},{"h":1,"v":["收获"]}],[[],[["f","Unmilled_Rice_Stage_1.png",48]],[["f","Unmilled_Rice_Stage_2.png",48]],[["f","Unmilled_Rice_Stage_3.png",48]],[["f","Unmilled_Rice_Stage_4.png",48]],[["f","Unmilled_Rice_Stage_5.png",48]]],[["非灌溉区域"],["1 天"],["2 天"],["2 天"],["3 天"],["总计: 8 天"]],[["可灌溉区域"],["1 天"],["1 天"],["1 天"],["3 天"],["总计: 6 天"]]]]]],["送礼",2,[["t",[[{"h":1,"v":["不喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","山姆","山姆"],"、",["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]]]]]],["地图",2,[["p",["下图展示了各类",["l","农场地图","农场地图"],"的可灌溉区域。"]],["g",[[null,0,["标准农场"],"Rice_standard_farm.png"],[null,0,["河边农场"],"Rice_riverland_farm.png"],[null,0,["森林农场"],"Rice_forest_farm.png"],[null,0,["山顶农场"],"Rice_hilltop_farm.png"],[null,0,["荒野农场"],"Rice_wilderness_farm.png"],[null,0,["四角农场"],"Rice_four_corners_farm.png"],[null,0,["海滩农场"],"Rice_beach_farm.png"]]]]]]}