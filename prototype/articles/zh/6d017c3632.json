{"s":[[null,1,[["p",["稻草人是一种可打造的物品，它可以防止",["l","动物","乌鸦"],"吃掉",["l","农作物","农作物"],"。稻草人的",["l","打造","制作"],"配方可以在",["l","耕种","耕种"],"等级达到1级时获得。"]],["p",["乌鸦不会攻击",["l","打造","野生种子"],"种植出的作物，所以野生种子不需要稻草人来保护。"]],["p",[["l","姜岛","姜岛"],"上没有乌鸦，因此姜岛农场上也不需要放置稻草人。"]]]],["范围",2,[["p",["稻草人会保护周围248个地块的圆形区域：东、南、西、北方向上8格，东北、东南、西南和西北各6格。换句话说，它保护一片17x17的区域，但不包括每个角落的10个空格。想要以正方形计算方便规划领域的话，那就是13x13的区域。"]]]],["稀有稻草人",2,[["p",["稀有稻草人的作用与普通的稻草人相同。“稀有稻草人”和“珍奇乌鸦”是对同一类物品的不同称呼。"]],["p",["注：仅有3号稀有稻草人的头上可以戴",["l","帽子","帽子"],"。"]],["p",["集齐8个稀有稻草人后，“Z.C.珍奇乌鸦协会”会通过",["l","信件","信件"],"送给玩家",["l","豪华稻草人","豪华稻草人"],"的制作配方。"]],["t",[[{"h":1,"v":["编号"]},{"h":1,"v":["如何获得"]}],[["1"],["在",["l","星露谷展览会","星露谷展览会"],"上以800奖券的价格购买。"]],[["2"],["在",["l","万灵节","万灵节"],"以5,000金的价格购买。"]],[["3"],["在",["l","赌场","赌场"],"以10,000齐币的价格购买。"]],[["4"],["在",["l","冰雪节","冰雪节"],"以5,000金的价格购买；或在",["l","秋季","秋季"],"和",["l","冬季","冬季"],"随机出现在",["l","旅行货车","旅行货车"],"中，以4,000金的价格购买。"]],[["5"],["在",["l","花舞节","花舞节"],"中以2,500金的价格购买。"]],[["6"],["在",["l","矮人","矮人"],"的商店中以2,500金的价格购买。"]],[["7"],["向",["l","博物馆","博物馆"],"捐赠20件",["l","古物","古物"],"。\n如果已经拥有了一个，则可以在",["l","夜市","夜市"],"中购买更多同款稻草人。"]],[["8"],["向",["l","博物馆","博物馆"],"捐赠40件物品。\n如果已经拥有了一个，则可以在",["l","夜市","夜市"],"中购买更多同款稻草人。"]]]]]],["任务",2,[["l",0,[[1,["为了完成",["l","任务","“进阶”"],"任务，玩家需要达到",["l","耕种","耕种"],"等级1，并制作一个稻草人。"]]]]]],["趣闻",2,[["l",0,[[1,["珍奇乌鸦 #1来自宫崎骏的《哈尔的移动城堡》中的角色“菜头”。"]],[1,["与稻草人互动的时候，会出现一条信息，显示它已经赶走了多少乌鸦。当拾起稻草人的时候，计数会被重置。"]]]]]],["秘密",2,[["p",[["l","彩蛋","3号珍奇乌鸦（外星人）的头上可以戴帽子。"]]]]]],"f":[["来源",[["l","打造","打造"]]],["季节",[["l","春季","春季"]," • ",["l","夏季","夏季"]," • ",["l","秋季","秋季"]]],["原料",[["i","(O)388","木材×50"],["i","(O)382","煤炭×1"],["i","(O)771","纤维×20"]]]]}