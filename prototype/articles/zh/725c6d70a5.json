{"s":[[null,1,[["p",["窃贼戒指是一种",["l","戒指","戒指"],"。完成",["l","探险家公会#Dust Sprite","击杀 500 只灰尘精灵"],"的目标后可前往",["l","探险家公会","探险家公会"],"向",["l","吉尔","吉尔"],"领取，此后即可在",["l","探险家公会","探险家公会"],"以20,000金 的价格购买。"]],["p",["佩戴窃贼戒指后，击杀",["l","怪物","怪物"],"掉落物品时将判定两次（这意味着可能获得双倍的战利品）。多个窃贼戒指的效果不会叠加，但是可以与书籍",["l","怪物图鉴","怪物图鉴"],"的效果叠加。"]]]],["染色",2,[["p",["窃贼戒指可用作",["l","染色#染料罐","染料罐"],"的绿色染料，放置在",["l","染色#缝纫机","缝纫机"],"内时还可用作玉绿色染料。"]]]],["备注",2,[["p",["由于窃贼戒指能使玩家更容易获取",["l","怪物战利品","怪物战利品"],"，因此尤其利于完成需要大量",["l","怪物战利品","怪物战利品"],"的",["l","任务#鹈鹕镇的特别任务","特别任务"],"："]],["l",0,[[1,[["l","任务#Fragments of the past","“历史的碎片”"],"任务中需要玩家收集并提交100块骨头。"]],[1,[["l","任务#Juicy Bugs Wanted","“需要多汁的虫子！”"],"任务中需要玩家收集并提交100块",["l","虫肉","虫肉"],"。"]]]]]],["漏洞",2,[["p",["有一系列的物品不受这个戒指双倍掉落效果的影响，因为这些物品被添加为潜在掉落物。\n这些物品包括："]],["l",0,[[1,["抵达",["l","矿井","矿井"],"底层后所有怪物可能掉落的",["l","五彩碎片","五彩碎片"],"和",["l","钻石","钻石"],"。"]],[1,[["l","史莱姆","史莱姆"],"掉落的",["l","史莱姆蛋","史莱姆蛋"],"。"]],[1,["紫色史莱姆掉落的",["l","铱矿石","铱矿石"],"和",["l","铱锭","铱锭"],"。"]],[1,[["l","突变蛆","突变蛆"],"掉落的",["l","海藻汤","海藻汤"],"。"]],[1,[["l","荒野石魔","荒野石魔"],"和",["l","铱石魔","铱石魔"],"的特别掉落物：达到",["l","战斗","战斗"],"等级5后掉落的",["l","混合种子","混合种子"],"(20%)和",["l","万象晶球","万象晶球"],"(5%)，达到",["l","战斗","战斗"],"等级10掉落的",["l","铱矿石","铱矿石"]," (1%)和",["l","五彩碎片","五彩碎片"]," (0.1%)。"]],[1,[["l","铱石魔","铱石魔"],"掉落的",["l","铱锭","铱锭"],"。"]],[1,[["l","竹节虫","竹节虫"],"掉落的",["l","齐钻","齐钻"],"和",["l","姜","姜"],"。"]],[1,["装备",["l","鹦鹉蛋","鹦鹉蛋"],"后所有",["l","怪物","怪物"],"可能掉落的金币。"]]]]]],["你知道吗",2,[["l",0,[[1,["尽管装备窃贼戒指不会影响在",["l","骷髅洞穴","骷髅洞穴"],"中",["l","史莱姆#巨型史莱姆","巨型史莱姆"],"的特殊掉落（例如",["l","粉红蛋糕","粉红蛋糕"],"、",["l","齐钻","齐钻"],"、",["l","银河之魂","银河之魂"],"），但是玩家确实通过装备窃贼戒指获取双倍的掉落。"]],[1,["装备窃贼戒指并不会使",["l","矿井","矿井"],"中特殊怪物掉落双倍的",["l","矿井#特殊物品","特殊物品"],"。"]],[1,["装备窃贼戒指可以获取两份",["l","五彩胶冻","五彩胶冻"],"或",["l","灵外质","灵外质"],"，尽管它们分别仅需要一份用于提交",["l","任务#A Curious Substance","法师的特别任务"],"，并没有其它作用。"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.6","1.6"],"：添加了更多不享受双倍掉落效果的掉落物。该戒指的双倍掉落效果现在可以与",["l","怪物图鉴","怪物图鉴"],"叠加。"]]]]]]]}