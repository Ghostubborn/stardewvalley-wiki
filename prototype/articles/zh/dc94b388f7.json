{"s":[[null,1,[["p",["草帽是一顶",["l","帽子","帽子"],"，是在",["l","复活节","复活节"],"上收集至少9个彩蛋而赢得寻蛋活动的奖励，每个玩家只能通过",["l","复活节","复活节"],"获得一顶草帽，此后赢得寻蛋游戏的奖励会变为",["l","兑奖券","兑奖券"],"。"]],["p",["赢得一次比赛后，也可以向",["l","废弃的屋子","废弃的屋子"],"的老鼠以1,000金 购买草帽。玩家在",["l","沙漠节","沙漠节"],"中进入提供服装服务的小屋，并接受",["l","沙漠节#艾米丽的服装服务","艾米丽的服装服务"],"后，有约 2% 的概率获得带有草帽的一套服装。"]]]],["备注",2,[["l",0,[[1,["带有草帽的一套男性服装还包括 ",["f","Yellow_Suit.png",24]," ",["l","裁缝#上衣","黄色西装"]," 和 ",["f","Farmer_Pants.png",24]," ",["l","裁缝#下装","农夫裤"],"（染色RGB值 242,189,2）。"]],[1,["带有草帽的一套女性服装还包括 ",["f","Shirt281b.png",24]," ",["l","裁缝#上衣","绿色纽扣汗衫"],"（袖子染红） 和 ",["f","Skirt.png",24]," ",["l","裁缝#下装","短裙"],"（染色RGB值 30,150,71）。"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.0","1.0"],"：加入游戏。"]],[1,[["l","版本历史#1.4","1.4"],"：在你赢得比赛后，住在",["l","废弃的屋子","帽子店"],"的老鼠会出售草帽。"]],[1,[["l","版本历史#1.6","1.6"],"：现在可以作为一套服装的部件从沙漠节随机获得。"]]]]]]]}