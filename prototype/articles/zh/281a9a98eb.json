{"s":[[null,1,[["p",[["l","胡萝卜种子","胡萝卜种子"],"是一种种子，成熟后得到",["l","胡萝卜","胡萝卜"],"。"]],["p",["胡萝卜种子无法使用金币购买，而是可以通过各种其他方式找到："]],["l",0,[[1,["使用",["l","锄头","锄头"],"挖掘",["l","绿色斑点","绿色斑点"]]],[1,["完成",["l","大树桩（地点）","浣熊的请求"]]],[1,["在",["l","大树桩（地点）","浣熊妻子的商店"],"以1个",["l","枫树种子","枫树种子"],"交换1个胡萝卜种子"]],[1,["打开钓鱼发现的",["l","钓鱼","金钓鱼宝箱"],"获得(7%几率)"]],[1,["将",["l","胡萝卜","胡萝卜"],"放入",["l","种子生产器","种子生产器"],"获得1~3个种子"]],[1,["使用",["l","镇长的庄园","兑奖机"],"也有机会获得胡萝卜种子"]],[1,["打开",["l","谜之盒","谜之盒"],"或",["l","金色谜之盒","金色谜之盒"],"可能获得"]],[1,["在",["l","矿井","矿井"],"、",["l","骷髅洞穴","骷髅洞穴"],"或",["l","火山地牢","火山地牢"],"中打碎",["l","矿井","木箱和木桶"],"(2%几率)"]],[1,["击杀",["l","怪物","铱石魔"],"(50%几率)"]]]],["p",["除了在",["l","大树桩（地点）","浣熊妻子的商店"],"交易和使用",["l","种子生产器","种子生产器"],"外，所有方法只有在",["l","冬季","冬季"],"21日至",["l","春季","春季"],"23日之间才会生产胡萝卜种子。"]]]],["生长阶段",2,[["t",[[{"h":1,"v":["阶段 1"]},{"h":1,"v":["阶段 2"]},{"h":1,"v":["阶段 3"]},{"h":1,"v":["收获"]}],[["1 天"],["1 天"],["1 天"],["共: 3 天"]]]]]],["送礼",2,[["t",[[{"h":1,"v":["不喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","山姆","山姆"],"、",["l","文森特","文森特"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","哈维","哈维"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","刘易斯","刘易斯"],"、",["l","雷欧","雷欧"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","桑迪","桑迪"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]]]]]],["裁缝",2,[["p",["胡萝卜种子不用于任何",["l","裁缝","裁缝"],"。胡萝卜种子可用于",["l","染色","染色"],"。放置在",["l","染色","染料罐"],"内时，胡萝卜种子可用作橙色染料。放置在",["l","染色","缝纫机"],"内时，胡萝卜种子还可用作棕色染料。"]]]]]}