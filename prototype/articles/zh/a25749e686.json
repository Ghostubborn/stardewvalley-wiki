{"s":[[null,1,[["p",["优质洒水器是一件可以在每天早晨灌溉临近的8个土壤方格（3×3的区域）的",["l","打造","可打造"],"物品。灌溉仅限于已开垦的土壤方格。优质洒水器的合成配方在",["l","耕种#耕种技能","耕种等级"],"达到6级时解锁。"]],["p",["完成夏季作物收集包或花园收集包时，都可以获得一个优质洒水器作为奖励。优质洒水器也可能会随机出现在",["l","旅行货车","旅行货车"],"中，售价为1,350–2,250金。玩家可能会在",["l","骷髅洞穴#宝藏房间","骷髅洞穴的宝箱层"],"找到4个优质洒水器。",["l","鳟鱼大赛","鳟鱼大赛"],"的奖品之一为1个优质洒水器。打开",["l","谜之盒","谜之盒"],"或",["l","金色谜之盒","金色谜之盒"],"也有概率获得1个优质洒水器。",["l","兑奖券#奖品","兑奖机"],"的第7个奖品有33%概率获得4个优质洒水器。"]],["p",["优质洒水器可以给",["l","史莱姆屋","史莱姆屋"],"里的水槽添水，但不能给",["l","花盆","花盆"],"浇水或给",["l","动物#猫和狗","宠物"],"的碗中添水。优质洒水器不能放置在沙地上。"]],["p",["可以将",["l","火把","火把"],"放置在优质洒水器上。"]],["g",[["Qualitysprinklerexample.png",150,[]]]]]],["种类",2,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["材料"]},{"h":1,"v":["配方来源"]}],[[["f","Sprinkler.png",48]],[["l","洒水器","洒水器"]],["每天早上给四块邻近的土地浇水。"],[["i","(O)334","铜锭×1"],"\n",["i","(O)335","铁锭×1"]],[["f","Farming_Skill_Icon.png",24]," ",["l","耕种","耕种"]," 2 级"]],[[["f","Quality_Sprinkler.png",48]],[["l","优质洒水器","优质洒水器"]],["每天早晨灌溉临近的 8 个地块。"],[["i","(O)335","铁锭×1"],"\n",["i","(O)336","金锭×1"],"\n",["i","(O)338","精炼石英×1"]],[["f","Farming_Skill_Icon.png",24]," ",["l","耕种","耕种"]," 6 级"]],[[["f","Iridium_Sprinkler.png",48]],[["l","铱制洒水器","铱制洒水器"]],["每天早晨灌溉临近的 24 个地块。"],[["i","(O)336","金锭×1"],"\n",["i","(O)337","铱锭×1"],"\n",["i","(O)787","电池组×1"]],[["f","Farming_Skill_Icon.png",24]," ",["l","耕种","耕种"]," 9 级"]]]]]],["升级部件",2,[["p",["升级部件可以安装在已放置的洒水器上，拾取洒水器时可以在不破坏它的情况下卸下升级部件。"]],["p",["同一个洒水器一次只能安装一个升级部件。"]],["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["洒水器图片"]},{"h":1,"v":["售价"]}],[[["f","Pressure_Nozzle.png",48]],[["l","加压喷头","加压喷头"]],["安装在洒水器上，增加灌溉范围。"],[["f","PressureNozzleSprinklers.png",167]],["20齐钻"]],[[["f","Enricher.png",48]],[["l","施肥器","施肥器"]],["安装在洒水器上并装入肥料，在其附近播撒种子时便会自动施肥。"],[["f","EnricherSprinklers.png",134]],["20齐钻"]]]]]],["送礼",2,[["t",[[{"h":1,"v":["不喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","雷欧","雷欧"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"]]]]]]],["收集包",2,[["p",["不用于任何",["l","收集包","收集包"],"。"]]]],["任务",2,[["p",["不用于任何任务。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.5","1.5"],"：已放置的优质洒水器现在不再能被锄头破坏了。"]],[1,[["l","版本历史#1.6","1.6"],"：现在可以将",["l","火把","火把"],"放置在洒水器上了。现在是",["l","鳟鱼大赛","鳟鱼大赛"],"的奖品之一。现在有概率从",["l","谜之盒","谜之盒"],"或",["l","金色谜之盒","金色谜之盒"],"中开出。现在是",["l","镇长的庄园","兑奖机"],"的奖品之一。"]]]]]]],"f":[["来源",[["l","打造","打造"]]],["原料",[["i","(O)335","铁锭×1"],["i","(O)336","金锭×1"],["i","(O)338","精炼石英×1"]]],["售价",["450金"]]]}