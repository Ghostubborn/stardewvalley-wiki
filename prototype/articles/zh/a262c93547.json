{"s":[[null,1,[["p",["传送图腾：沙漠是一种",["l","传送图腾","传送图腾"],"，在物品栏中选中并右键点击屏幕中无法直接交互的任意处，便可传送玩家至",["l","沙漠","沙漠"],"。它可在",["l","沙漠商人","沙漠商人"],"处花费10个",["l","铱锭","铱锭"],"购买配方后",["l","打造","打造"],"获得，也可以直接花费3个",["l","万象晶球","万象晶球"],"从",["l","沙漠商人","沙漠商人"],"那里购买。"]]]],["送礼",2,[["t",[[{"h":1,"v":["讨厌"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","雷欧","雷欧"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"]]]]]]],["收集包",2,[["p",["传送图腾：沙漠不用于任何",["l","收集包","收集包"],"。"]]]],["裁制",2,[["p",["传送图腾可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["i","(H)44","图腾面具"],"。传送图腾可用于",["l","染色","染色"],"。放置在",["l","染色","染料罐"],"内时，传送图腾可用作橙色染料。放置在",["l","染色","缝纫机"],"内时，传送图腾还可用作棕色染料。"]]]],["任务",2,[["p",["传送图腾：沙漠不用于任何",["l","任务","任务"],"。"]]]],["趣闻",2,[["p",["如果传送至沙漠后，在",["l","潘姆","潘姆"],"到达巴士站之前返回小镇，那么会出现玩家驾驶巴士的动画。"]]]]]}