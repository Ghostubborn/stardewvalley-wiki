{"s":[[null,1,[["p",["能量滋补水是一种可食用的消耗品，可用于回复大量的能量。可以在",["l","哈维的诊所","哈维的诊所处"],"花费1,000金 购买。",["l","沙漠节","沙漠节"],"期间，",["l","塞巴斯蒂安","塞巴斯蒂安"],"也会在其",["l","沙漠节#村民商铺","商铺"],"以25卡利科蛋 ",["l","卡利科三花蛋","卡利科三花蛋"],"的价格出售 5 瓶能量滋补水（限 1 组）。击杀",["l","骷髅洞穴","骷髅洞穴"],"内的",["l","蝙蝠#变种","铱蝠"],"也有 5% 的概率会掉落一瓶能量滋补水。在",["l","骷髅洞穴#宝藏房间","骷髅洞穴"],"的宝箱层里打开宝箱也可能会获得 2~4 瓶能量滋补水。当玩家与",["l","潘姆","潘姆"],"的友谊值大于 0 时，她可能会随信赠送一瓶能量滋补水作为礼物。在",["l","矿井#挑战之神庙","危险的矿井"],"或",["l","骷髅洞穴","危险的骷髅洞穴"],"中击杀",["l","矿井#特殊物品","特殊怪物"],"（",["l","史莱姆#特殊史莱姆","特殊史莱姆"],"会有黄色星形触角的明显特征，其他特殊怪物与正常怪物无明显差异）也有概率获得能量滋补水。"]],["p",["尽管游戏内显示的能量回复数值为 500，但实际上能量滋补水总是会回复满额的能量值。"]]]],["送礼",2,[["t",[[{"h":1,"v":["讨厌"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]]]]]],["裁制",2,[["p",["能量滋补水可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成可染色的 ",["l","裁缝","运动员夹克衫"],"。能量滋补水可用于",["l","染色","染色"],"。放置在",["l","染色#缝纫机","缝纫机"],"内时，能量滋补水可用作红色染料。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.4#1.4","1.4"],"：能量滋补水与肌肉回复药可用于裁缝。"]],[1,[["l","版本历史#1.6.4","1.6.4"],"：能量滋补水现在只能回复能量。"]]]]]]],"f":[["来源",[["l","哈维的诊所","哈维的诊所"]," • ",["l","铱蝠","铱蝠"]]],["售价",["500金"]]]}