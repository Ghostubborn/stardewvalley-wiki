{"s":[[null,1,[["p",["雪山药是一种",["l","采集","采集品"],"，可以在",["l","冬季","冬季"],"使用",["l","锄头","锄头"],"锄地、挖掘",["l","远古斑点","远古斑点"],"或种植",["l","冬季种子","冬季种子"],"获得。与一般的采集品不同的是，雪山药不会自然生成在地面上，而是“埋”在整个星露谷的地下，只能通过使用",["l","锄头","锄头"],"锄地或挖掘远古斑点获得。需要注意的是，在",["l","农场","农场"],"中锄地不会获得雪山药（但是挖掘在农场中的远古斑点里可能会获得雪山药）。"]],["p",["挖掘",["l","远古斑点","远古斑点"],"是找到雪山药几率最高的方式（11% ~ 16%，每张地图间的出现概率互相独立）。在除农场外星露谷中的任意室外地点，挖掘可耕种地块时也有 4% 的几率获得一个雪山药。"]],["p",["旅行货车会以 300–1,000金 的价格随机出售。在冬季翻动",["l","垃圾桶","垃圾桶"],"时也有概率找到雪山药。"]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","哈维","哈维"],"、",["l","莉亚","莉亚"],"、",["l","莱纳斯","莱纳斯"]]],[{"h":1,"v":["一般"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","刘易斯","刘易斯"],"、",["l","玛妮","玛妮"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","罗宾","罗宾"],"、",["l","桑迪","桑迪"]]],[{"h":1,"v":["不喜欢"]},[["l","卡洛琳","卡洛琳"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"],"、",["l","皮埃尔","皮埃尔"],"、",["l","山姆","山姆"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]],[{"h":1,"v":["讨厌"]},[["l","玛鲁","玛鲁"]]]]]]],["收集包",2,[["l",0,[[1,["冬季采集收集包需要 1 个雪山药；"]],[1,["冬季采集收集包需要 1 个雪山药（作为随机项）。"]]]]]],["食谱",2,[["p",["雪山药不用于任何",["l","烹饪#食谱","食谱"],"。"]]]],["打造",2,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["配方来源"]},{"h":1,"v":["所需原料"]}],[[["f","Winter_Seeds.png",48]],["野生种子（冬季）（10）"],["各种各样的冬季种子。"],["采集 7 级"],[["i","(O)412","冬根×1"],["i","(O)414","水晶果×1"],["i","(O)416","雪山药×1"],["i","(O)418","番红花×1"]]]]]]],["裁制",2,[["p",["雪山药可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","上衣"],"。雪山药可用于",["l","染色","染色"],"。放置在",["l","染色#缝纫机","缝纫机"],"内时，雪山药可用作白色染料。"]]]],["任务",2,[["l",0,[[1,["需要雪山药的",["l","任务#求助任务","求助任务"],"可能在",["l","冬季","冬季"],"期间随机出现在",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"外的“布告栏”上，报酬是300金和150",["l","友谊","友谊点"],"。"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.4#1.4","1.4"],"：现可用于",["l","裁缝","裁缝"],"。不能再从沙漠中挖出。"]]]]]]],"f":[["来源",[["l","锄头","挖掘"]," • ",["l","远古斑点","远古斑点"]," • ",["l","冬季种子","冬季种子"]]],["季节",["冬季"]],["售价",["100金"]]]}