{"s":[[null,1,[["p",["蜥怪的爪子是一种",["l","饰品","饰品"],"，可以通过在",["l","矿井","矿井"],"、",["l","骷髅洞穴","骷髅洞穴"],"或",["l","采石场矿井","采石场矿井"],"中击杀",["l","怪物","怪物"],"或打碎",["l","矿井","木箱和木桶"],"来获得。这两种方法的掉落几率都会受到",["l","运气","每日运气"],"和",["l","运气","运气增益"],"等因素的影响。",["l","窃贼戒指","窃贼戒指"],"和",["l","怪物图鉴","怪物图鉴"],"不会影响从",["l","怪物","怪物"],"那里获得饰品的几率。 从",["l","骷髅洞穴","骷髅洞穴"],"中的",["l","骷髅洞穴","宝箱"],"获得蜥怪的爪子的几率约为0.6%。"]],["p",["当蜥怪的爪子装备在饰品栏时，",["l","玩家角色","玩家"],"完全不受",["l","怪物","怪物"],"造成的（例如，",["l","效果","“黏滑的”减益效果"],"或",["l","效果","“倒霉的”减益效果"],"）所有",["l","效果","敌对生物效果"],"的影响。这并不能阻止除此以外的任何效果，例如喝酒所带来的",["l","效果","眩晕"],"。蜥怪的爪子产生的效果与",["l","效果","墨汁意大利饺"],"相同。"]],["p",["蜥怪的爪子无法使用",["l","铁砧","铁砧"],"重铸。"]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","法师","法师"]]],[{"h":1,"v":["不喜欢"]},[["l","亚历克斯","亚历克斯"],"、",["l","雷欧","雷欧"],"、",["l","艾米丽","艾米丽"],"、",["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"]]]]]]]]}