{"s":[[null,1,[["p",["鹦鹉螺化石是一种",["l","古物","古物"],"，可以通过挖掘",["l","沙滩","沙滩"],"上的",["l","远古斑点","远古斑点"],"获得。此外，挖掘",["l","姜岛北部#挖掘场","姜岛挖掘场"],"上的",["l","骨矿","骨矿"],"或打开",["l","钓鱼#宝箱","钓鱼宝箱"],"也有较小概率获得鹦鹉螺化石。"]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","矮人","矮人"],"、",["l","潘妮","潘妮"]]],[{"h":1,"v":["不喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]]]]]],["裁制",2,[["p",["鹦鹉螺化石可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","挖掘机上衣"],"。鹦鹉螺化石可用于",["l","染色","染色"],"。放置在",["l","染色#缝纫机","缝纫机"],"内时，鹦鹉螺化石可用作白色染料。"]]]],["任务",2,[["p",["在",["l","任务#Fragments of the past","特别任务：“历史的碎片”"],"期间，玩家需要提交 100 件骨头类物品，鹦鹉螺化石可作为其中的一个可选项。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.0#1.0","1.0"],"：加入游戏。"]],[1,[["l","版本历史/1.4#1.4","1.4"],"：修复了无法在沙滩的",["l","远古斑点","远古斑点"],"挖掘出鹦鹉螺化石的错误。现在可用于",["l","裁缝","裁缝"],"。"]],[1,[["l","版本历史/1.5#1.5","1.5"],"：现在可以放入",["l","碎骨机","碎骨机"],"中转化成肥料了。现在",["l","潘妮","潘妮"],"和",["l","矮人","矮人"],"喜欢",["l","古物","古物"],"，其他",["l","居民","居民"],"对古物的态度从讨厌变成了不喜欢。"]]]]]]]}