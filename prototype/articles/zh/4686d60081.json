{"s":[[null,1,[["p",["传送图腾可以通过",["l","打造","打造"],"、收取礼物或是在",["l","赌场","赌场"],"购买获得，主要可以节省时间直接瞬间移动到其他地区；道具使用方法是放在你的工具栏中并右键点击。"]],["p",[["l","打造","打造"],"配方需要提升一定的",["l","采集","采集"],"等级才能获得。游戏后期可解锁各种永久图腾，与传送图腾拥有相同的功能，且可以重复使用。"]],["p",["总共有五个可以通过传送到达的地点，分别为：",["l","农场","农场"],"、",["l","深山","深山"],"、",["l","沙滩","沙滩"],"、",["l","沙漠","沙漠"],"和",["l","姜岛","姜岛"],"。"]],["p",["注意：在",["l","夏威夷宴会","夏威夷宴会"],"和",["l","月光水母起舞","月光水母起舞"],"当天，玩家在节日还没开始时使用",["l","传送图腾：海滩","传送图腾：海滩"],"不会被传送到沙滩，但会把图腾消耗掉。屏幕上会显示“今天的节日还在准备中，请稍后再来”。"]]]],["农场",2,[["p",[["l","传送图腾：农场","传送图腾：农场"],"可以传送玩家到",["l","农场","农场传送点"],"；属于消耗品。\n",["i","(T)ReturnScepter","回程魔杖"],"可以传送玩家到",["l","农场","农舍"],"；可重复使用。\n",["l","农场图腾柱","农场图腾柱"],"可以传送玩家到",["l","农场","农场传送点"],"；是",["l","姜岛","姜岛农场"],"的待解锁建筑，可重复使用。\n ",["l","迷你图腾尖塔","迷你图腾尖塔"],"成对使用时可以在农场的两个地点传送，使用时不消耗。"]]]],["深山",2,[["p",[["l","传送图腾：山岭","传送图腾：山岭"],"可以传送玩家到",["l","深山","深山"],"；属于消耗品。\n ",["l","土之图腾柱","土之图腾柱"],"可以传送玩家到",["l","深山","深山"],"；这是一栋放在农场上的永久建筑物，可重复使用。"]]]],["沙滩",2,[["p",[["l","传送图腾：海滩","传送图腾：海滩"],"可以传送玩家到",["l","沙滩","沙滩"],"；属于消耗品。\n ",["l","水之图腾柱","水之图腾柱"],"可以传送玩家到",["l","沙滩","沙滩"],"；这是一栋放在农场上的永久建筑物，可重复使用。"]]]],["沙漠",2,[["p",[["l","传送图腾：沙漠","传送图腾：沙漠"],"可以传送玩家到",["l","沙漠","沙漠"],"；属于消耗品。\n沙漠图腾柱可以传送玩家到",["l","沙漠","沙漠"],"；这是一栋放在农场上的永久建筑物，可重复使用。"]]]],["姜岛",2,[["p",[["l","传送图腾：姜岛","传送图腾：岛屿"],"可以传送玩家到",["l","姜岛","姜岛"],"。属于消耗品。\n",["l","姜岛图腾柱","姜岛图腾柱"],"可以传送玩家到",["l","姜岛","姜岛"],"。这是一栋放在农场上的永久建筑物，可重复使用。"]]]]]}