{"s":[[null,1,[["p",["橙子是一种",["l","水果","水果"],"，是由种植",["l","橙子树苗","橙子树苗"],"后经28天生长成熟结出的果实。",["l","橙子树","橙子树"],"在星露谷",["l","农场","农场"],"时只会在",["l","夏季","夏季"],"结果，或者种植在",["l","温室","温室"],"或",["l","姜岛","姜岛"],"之中全年结果。"]],["p",[["l","旅行货车","旅行货车"],"有时会以 300–1,000金的价格出售橙子。如果玩家在",["l","德米特里厄斯","德米特里厄斯"],"的研究项目中选择了果蝠，那么玩家可以在",["l","山洞","山洞"],"中找到橙子。"]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","格斯","格斯"]]],[{"h":1,"v":["喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]]]]]],["收集包",2,[["p",["橙子是 工匠收集包 可选收集项目之一。"]]]],["食谱",2,[["p",["橙子不用于任何食谱。"]]]],["裁制",2,[["p",["橙子可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成可染色的 ",["i","(P)13","休闲短裤"],"。橙子还可用作",["l","染色#染料罐","染料罐"],"和",["l","染色#缝纫机","缝纫机"],"的橙色染料。"]]]],["任务",2,[["p",["不用于任何求助任务。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.4","1.4"],"：现在在裁缝中可用。"]]]]]]],"f":[["来源",[["l","橙子树","橙子树"]]],["季节",["Summer"]],["生长时间",["28 天"]],["种子",[["l","橙子树苗","橙子树苗"]]],["售价",["100金"]]]}