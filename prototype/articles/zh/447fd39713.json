{"s":[[null,1,[["p",["丛林鱼缸是一件4格宽的",["l","家具","家具"],"。是完成",["l","大树桩（地点）","大树桩（地点）"],"浣熊",["l","大树桩（地点）","第五项请求"],"的奖励，之后可以从",["l","大树桩（地点）","浣熊妻子的商店"]," 用 5 个",["i","(O)170","破损的眼镜"],"购买。"]],["p",[["l","家具目录","家具目录"],"中没有提供。"]]]],["用途",2,[["p",["某些物品可以添加到鱼缸中，通过按住物品并右键单击鱼缸来改变其外观。要获取内部物品的列表或将其移除，请空手右键单击鱼缸。装饰品和放置在里面的任何静止动物的位置和外观都是随机的，可以通过捡起并重新放置鱼缸来更改装位置而无需移除物品。"]]]],["允许的内容",2,[["t",[[{"h":1,"v":["类别"]},{"h":1,"v":["数量"]},{"c":2,"h":1,"v":["物品"]}],[["装饰品"],["每种1个"],{"c":2,"v":[["i","(O)117","锚"]," ",["i","(O)109","古剑"]," ",["i","(O)330","粘土"]," ",["i","(O)393","珊瑚"]," ",["i","(O)709","硬木"]," ",["i","(O)167","Joja可乐"]," ",["l","彩蛋","幸运紫色短裤"]," ",["i","(O)392","鹦鹉螺"]," ",["i","(O)797","珍珠"]," ",["i","(O)832","菠萝"]," ",["i","(O)394","彩虹贝壳"]," ",["i","(O)152","海草"]," ",["i","(O)390","石头"]," ",["i","(O)166","财宝箱"]]}],[["底部生物"],["最多4个"],["可移动生物： ",["i","(O)800","水滴鱼"]," ",["i","(O)717","螃蟹"]," ",["i","(O)716","小龙虾"]," ",["i","(O)267","比目鱼"]," ",["l","青蛙蛋","青蛙蛋"]," ",["i","(O)715","龙虾"]," ",["i","(O)164","沙鱼"]," ",["i","(O)721","蜗牛"]," ",["i","(O)158","石鱼"]],["静止生物： ",["i","(O)372","蛤"]," ",["i","(O)718","鸟蛤"]," ",["i","(O)719","蚌"]," ",["i","(O)722","玉黍螺"]," ",["i","(O)723","牡蛎"]," ",["i","(O)154","海参"]," ",["i","(O)397","海胆"]," ",["i","(O)155","大海参"]]],[["可游动生物"],["最多3个"],{"c":2,"v":[["i","(O)720","虾"]," 所有其他的鱼"]}]]]]],["动画",2,[["p",["大多数游泳生物要么在没有动画的情况下四处移动(例如",["l","河豚","河豚"],"、",["l","章鱼","章鱼"],")，要么在游泳时以不同的速度移动尾巴/身体后部。然而，一些游泳生物有独特的动画："]],["l",0,[[1,[["l","鳗鱼","鳗鱼"],"和",["l","岩浆鳗鱼","岩浆鳗鱼"],"像",["l","河豚","河豚"],"或鲸鱼一样上下波动（而不是像鳗鱼或其他鱼类那样左右波动）。"]],[1,[["l","鱿鱼","鱿鱼"],"和",["l","午夜鱿鱼","午夜鱿鱼"],"用触手推动，就像在挑战神殿活跃的矿井中发现的",["l","蓝鱿鱼","蓝鱿鱼"],"一样。"]],[1,[["l","黄貂鱼","黄貂鱼"],"上下翻转鳍，同时移动尾巴。"]]]],["p",["对于底层生物来说，青蛙有独特的动画来跳跃和膨胀它们的声带。"]]]],["彩蛋",2,[["d","详情",[["p",["可以给任何鱼缸中的",["l","海胆","海胆"],"戴上",["l","帽子","帽子"],"，只需要在物品栏中选中帽子并右键点击鱼缸即可。"]]]]]]]}