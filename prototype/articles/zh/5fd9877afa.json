{"s":[[null,1,[["p",["鸭毛是一种动物制品，在玩家同鸭子的",["l","动物#友谊","友谊"],"足够高、鸭子有足够的",["l","动物#心情","心情"],"、",["l","运气#每日运气","每日运气"],"足够高的情况下，鸭子就有概率产出鸭毛。"]],["p",["鸭毛也会偶尔出现在",["l","旅行货车","旅行货车"],"的售卖货物中，价格是 250金。此外，如果玩家同",["l","艾米丽","艾米丽"],["l","婚姻","结婚"],"，她偶尔会把鸭毛当作礼物送给玩家。",["l","无尽财富之雕像","无尽财富之雕像"],"会在",["l","雷欧","雷欧"],"生日时（夏26日）会生产一根普通品质的鸭毛。",["l","动物#宠物","宠物"],"猫达到最大",["l","动物#好感度","好感度"],"后，每天第一次被抚摸也有可能掉落一根鸭毛。"]],["p",[["l","运气#运气增益","运气增益"],"对获得鸭毛的概率无影响。"]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","艾利欧特","艾利欧特"],"、",["l","雷欧","雷欧"]]],[{"h":1,"v":["喜欢"]},[["l","哈维","哈维"]]],[{"h":1,"v":["一般"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"]]],[{"h":1,"v":["不喜欢"]},[["l","潘妮","潘妮"]]]]]]],["收集包",2,[["p",["鸭毛用于染料收集包。"]]]],["配方",2,[["p",["鸭毛不用于任何配方。"]]]],["裁制",2,[["p",["鸭毛可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","黄绿色条纹衫"],"。鸭毛还可用作",["l","染色#染料罐","染料罐"],"和",["l","染色#缝纫机","缝纫机"],"的绿色染料。"]]]],["任务",2,[["p",["鸭毛不用于任何",["l","任务","任务"],"。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.0","1.0"],"：加入游戏。"]],[1,[["l","版本历史#1.1","1.1"],"：售价从 100金 提升到 125金。"]],[1,[["l","版本历史#1.4","1.4"],"：现在在裁缝中可用。"]],[1,[["l","版本历史#1.5","1.5"],"：售价从 125金 提升到 250金。"]],[1,[["l","版本历史#1.6","1.6"],"：现在抚摸达到最大",["l","动物#好感度","好感度"],"的",["l","动物#宠物","宠物"],"猫有概率掉落。"]]]]]]],"f":[["来源",[["l","鸭","鸭"]," • ",["l","动物#猫和狗","猫"]]],["售价",["250金"]]]}