{"s":[[null,1,[["p",["树肥是一种可以使野生的",["l","树","树"],"加速生长的",["l","肥料","肥料"],"，但是不能加速",["l","果树","果树"],"和",["l","茶树","茶树"],"。它必须洒在树种或树苗上，而不是未种植的地面上。配方在达到",["l","采集","采集等级"]," 7 级时解锁。"]],["p",["施肥后，撒上树肥的种子/幼树将呈现红色，并且每晚将提前一个生长阶段，直到第四个阶段，两天后再达到生长的最后阶段。例外的是，施肥后的",["l","桃花心木树","桃花心木树"],"每晚只有 60% 的机会进入下一阶段，施肥后的",["l","神秘树","神秘树"],"每晚只有30%的机会进入下一阶段。"]],["p",["施肥后的树种和树苗即使在",["l","冬季","冬季"],"也能生长。未施肥的树不会在冬季生长。"]]]],["送礼",2,[["t",[[{"h":1,"v":["不喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","雷欧","雷欧"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"]]]]]]],["裁制",2,[["p",["树肥可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成下半部分可染色的 ",["l","裁缝","高腰上衣"],"。树肥可用于",["l","染色","染色"],"。放置在",["l","染色","染料罐"],"内时，树肥可用作橙色染料。放置在",["l","染色","缝纫机"],"内时，树肥还可用作棕色染料。"]]]],["趣闻",2,[["p",["如果冬季在",["l","蘑菇树","蘑菇树"],"幼树上施肥会使它们第二天变成树桩。"]]]]]}