{"s":[[null,1,[["p",["桃花心木树是一种由",["l","桃花心木种子","桃花心木种子"],"生长而成的树。"]],["p",["挂上",["l","树液采集器","树液采集器"],"后每天都会生产",["l","树液","树液"],"。使用",["l","斧头","斧头"],"砍伐后，掉落 8-13 根",["l","硬木","硬木"],"。"]],["p",["其他树种使用",["l","树肥","树肥"],"后，次日必然会成长到下一阶段。桃花心木树种使用",["l","树肥","树肥"],"后，每天只有 60% 的几率成长到下一阶段。未施肥的桃花心木树种每天只有 15% 的几率成长到下一阶段。也就是说，未施肥的桃花心木树大概需要14~38天（26±12）成熟，已施肥的则大约需要5~9天（7±2天）成熟。"]]]],["生长阶段",2,[["t",[[{"h":1,"v":["阶段1"]},{"h":1,"v":["阶段2"]},{"h":1,"v":["阶段3"]},{"h":1,"v":["阶段4"]},{"h":1,"v":["阶段5 - 春季，夏季，秋季，冬季"]},{"h":1,"v":["树桩 - 春季，夏季，秋季，冬季"]}]]]]]],"f":[["种子",[["i","(O)292","桃花心木种子"]]],["树液采集器产出",[["i","(O)92","树液"]]],["生长时间",["不定"]]]}