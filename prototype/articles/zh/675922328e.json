{"s":[[null,1,[["p",["桃花心木树是一种",["l","树","树"],"，可以通过",["l","桃花心木种子","桃花心木种子"],"种植。"]],["p",["在成熟的桃花心木树上放置",["l","树液采集器","树液采集器"],"，每天都会产出树液。"]]]],["生长",2,[["p",["除了",["l","冬季","冬季"],"，桃花心木树每晚都有大约 15% 的概率生长到下一阶段。总共有 5 个生长阶段，平均成熟时间约为 33.3 天，超过 90% 的桃花心木树能在 52 天内完全成熟。"]],["p",["使用",["l","树肥","树肥"],"可以让桃花心木树每晚都有 60% 的概率生长到下一个阶段，包括",["l","冬季","冬季"],"，此时的平均成熟时间约为 8.3 天。"]],["p",["桃花心木树上不会生长",["l","苔藓","苔藓"],"。"]]]],["砍伐",2,[["p",["桃花心木树可使用",["l","斧头","斧头"],"砍伐，砍伐后会掉落 8~13 块",["l","硬木","硬木"],"和",["l","树液","树液"],"。当玩家达到",["f","Foraging_Skill_Icon.png",24]," ",["l","采集","采集"]," 1 级后还可能会掉落",["l","桃花心木种子","桃花心木种子"],"。"]],["p",["当桃花心木树处于于生长的第 1 阶段和第 2 阶段时，使用",["l","斧头","斧头"],"砍掉树苗可能会掉落 1 个木材，概率为 当前采集等级 × 10%（包括",["l","效果","增益效果"],"加成），即当达到 ",["f","Foraging_Skill_Icon.png",24]," ",["l","采集","采集"]," 10 级 时必然掉落一个木材。使用其他",["l","工具","工具"],"清除不会掉落木头。"]],["p",["桃花心木树还会在",["l","姜岛","姜岛"],"上出现，这些姜岛上原本就存在的桃花心木树可以放置",["l","树液采集器","树液采集器"],"或被砍伐。这些树在完全砍伐后，每天有 20% 的几率重新生成。重新生成时默认为第 2 阶段，之后按正常规律成长至成熟。"]],["p",["如果保留树桩，则不会重新生成。"]]]],["生长阶段",2,[["d","春季",[["t",[[{"h":1,"v":["种子"]},{"h":1,"v":["阶段 0"]},{"h":1,"v":["阶段 1"]},{"h":1,"v":["阶段 2"]},{"h":1,"v":["阶段 3~4"]},{"h":1,"v":["阶段 5~15"]},{"h":1,"v":["树桩"]}],[[["f","Mahogany_Seed.png",36],"\n\n",["l","桃花心木种子","桃花心木种子"]],[],[],[],[],[],[]]]]]],["d","夏季",[["t",[[{"h":1,"v":["种子"]},{"h":1,"v":["阶段 0"]},{"h":1,"v":["阶段 1"]},{"h":1,"v":["阶段 2"]},{"h":1,"v":["阶段 3~4"]},{"h":1,"v":["阶段 5~15"]},{"h":1,"v":["树桩"]}],[[["f","Mahogany_Seed.png",36],"\n\n",["l","桃花心木种子","桃花心木种子"]],[],[],[],[],[],[]]]]]],["d","秋季",[["t",[[{"h":1,"v":["种子"]},{"h":1,"v":["阶段 0"]},{"h":1,"v":["阶段 1"]},{"h":1,"v":["阶段 2"]},{"h":1,"v":["阶段 3~4"]},{"h":1,"v":["阶段 5~15"]},{"h":1,"v":["树桩"]}],[[["f","Mahogany_Seed.png",36],"\n\n",["l","桃花心木种子","桃花心木种子"]],[],[],[],[],[],[]]]]]],["d","冬季",[["t",[[{"h":1,"v":["种子"]},{"h":1,"v":["阶段 0"]},{"h":1,"v":["阶段 1"]},{"h":1,"v":["阶段 2"]},{"h":1,"v":["阶段 3~4"]},{"h":1,"v":["阶段 5~15"]},{"h":1,"v":["树桩"]}],[[["f","Mahogany_Seed.png",36],"\n\n",["l