{"s":[[null,1,[["p",["鱼籽酱是一种使用",["l","罐头瓶","罐头瓶"],"加工",["l","鲟鱼","鲟鱼"],"的",["l","鱼籽","鱼籽"],"而获得的一种",["l","工匠物品","工匠产品"],"。鱼籽酱可能会随机出现在",["l","旅行货车","旅行货车"],"的售卖货物中，售价为 1,500–2,500金 。"]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","谢恩","谢恩"],"、",["l","雷欧","雷欧"]]],[{"h":1,"v":["讨厌"]},[["l","贾斯","贾斯"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","文森特","文森特"]]]]]]],["收集包",2,[["p",["鱼籽酱可用于失踪的收集包。"]]]],["裁制",2,[["p",["鱼籽酱可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["i","(H)47","时尚帽"],"。鱼籽酱可用于",["l","染色","染色"],"。放置在",["l","染色#缝纫机","缝纫机"],"内时，鱼籽酱可用作黑色染料。"]]]],["任务",2,[["p",["鱼籽酱不用于任何任务。"]]]],["趣闻",2,[["p",["在现实中，虽然几乎所有种类的鱼卵都可被做成鱼籽酱，但严格来说以鲟科的卵制成的才是鱼籽酱，详见维基百科上对“鱼子酱”的定义。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.4","1.4"],"：加入游戏。"]]]]]]],"f":[["来源",[["l","工匠物品","工匠物品"]]],["加工设备",[["i","(BC)15","罐头瓶"]]],["原料",[["i","(O)812/698","鱼籽×1"],"(",["l","鲟鱼","鲟鱼"],"鱼籽）"]],["加工时间",["6000 分钟"]],["售价",["500金"]]]}