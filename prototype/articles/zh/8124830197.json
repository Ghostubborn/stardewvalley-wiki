,2,[["l",0,[[1,["在 iOS 版本和 Android 版本中，大多数地点的水深计算存在漏洞。水深使用了浮标实际位置的西北方（左上方）一格作为基准计算。因此，向东或向南（右方和下方）抛竿会导致水深变小，向西或向北（左方和上方）抛竿水深会更大。这个问题会影响鱼的尺寸与品质以及钓鱼宝箱中的物品，但捕获传说鱼类的区域不受影响，没有发生偏移。"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.4#1.4","1.4"],"：加入",["l","训练用鱼竿","训练用鱼竿"],"。打开钓鱼宝箱后可以直接向鱼竿添加",["l","鱼饵","鱼饵"],"、",["l","渔具","渔具"],"。渔具条的底边稍微更大了一些。取消了钓鱼等级对鱼的尺寸的影响最多为 10 的上限。修复了打开日志、时间暂停后，鱼仍然会上钩的问题。修复了错过了鱼首次咬钩的情况后，钓鱼等级和鱼饵对等待时间的减免不再生效的问题。"]],[1,[["l","版本历史/1.5#1.5","1.5"],"：加入钓鱼礼品。钓鱼宝箱加入",["l","金蛋","金蛋"],"和",["l","齐豆","齐豆"],"。钓到非鱼类的物品不再触发小游戏。可以自定义上钩音效了。"]],[1,[["l","版本历史/1.5#1.5.2","1.5.2"],"：修复了在",["l","农场","农场"],"上使用",["l","魔法鱼饵","魔法鱼饵"],"钓鱼，游戏会崩溃的问题。"]],[1,[["l","版本历史/1.5#1.5.4","1.5.4"],"：修复了捕获钓鱼宝箱后，切换钓竿可能会导致钓竿无法使用的问题。"]],[1,[["l","版本历史/1.5#1.5.5","1.5.5"],"：修复了",["l","深山","山区湖泊"],"中某些区域不会出现气泡的问题。"]],[1,[["l","版本历史#1.6","1.6"],"：加入",["l","高级铱金鱼竿","高级铱金鱼竿"],"。根据水面颜色为落入水中的钓鱼浮漂进行了重新上色。钓鱼宝箱加入",["l","谜之盒","谜之盒"],"、",["l","金色谜之盒","金色谜之盒"],"、",["l","金色动物饼干","金色动物饼干"],"、",["l","声纳浮漂","声纳浮漂"],"、",["l","高级鱼饵","高级鱼饵"],"、",["l","书#技能之书","技能之书"],"、",["l","黄金浮漂","黄金浮漂"],"、",["l","鱼籽","鱼籽"],"、",["l","海之宝石","海之宝石"],"和",["l","黄金标签","黄金标签"],"。加入金色钓鱼宝箱。现在玩家第一次钓到某种鱼时会有提示。如果玩家获得了",["l","竹鱼竿","竹鱼竿"],"，且第一年春季第28天前没有获得钓鱼经验，威利会来到玩家的农舍，简短地教玩家基础的钓鱼知识，以帮玩家达到钓鱼 1 级，并给玩家一个",["l","训练用鱼竿","训练用鱼竿"],"。"]],[1,[["l","版本历史#1.6.3","1.6.3"],"：修复了一个 1.6 版本中意料之外的漏洞，该漏洞会导致玩家钓到过多的垃圾。"]],[1,[["l","版本历史#1.6.4","1.6.4"],"：加入鱼的狂潮事件。稍微降低了钓到",["l","谜之盒","谜之盒"],"和",["l","金色谜之盒","金色谜之盒"],"的概率。"]]]]]]]}