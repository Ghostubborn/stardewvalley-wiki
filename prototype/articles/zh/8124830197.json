],["0"],["0"],["100"],["13"],["21"]],[["3"],["18-19"],["1.00"],["1.00"],["0"],["0"],["100"],["13"],["21"]],[["5"],["0-1"],["0.18"],["1.00"],["20"],["39"],["41"],["3 - 13"],["11 - 21"]],[["5"],["2-3"],["0.36"],["1.00"],["0"],["49"],["51"],["5 - 13"],["13 - 21"]],[["5"],["4-5"],["0.54"],["1.00"],["0"],["32"],["68"],["7 - 13"],["15 - 21"]],[["5"],["6-7"],["0.72"],["1.00"],["0"],["0"],["100"],["9 - 13"],["17 - 21"]],[["5"],["8-9"],["0.90"],["1.00"],["0"],["0"],["100"],["11 - 13"],["19 - 21"]],[["5"],["10-11"],["1.00"],["1.00"],["0"],["0"],["100"],["13"],["21"]],[["5"],["12-13"],["1.00"],["1.00"],["0"],["0"],["100"],["13"],["21"]],[["5"],["14-15"],["1.00"],["1.00"],["0"],["0"],["100"],["13"],["21"]],[["5"],["16-17"],["1.00"],["1.00"],["0"],["0"],["100"],["13"],["21"]],[["5"],["18-19"],["1.00"],["1.00"],["0"],["0"],["100"],["13"],["21"]]]]]],["气泡",3,[["p",["有时水中会出现一团气泡，把鱼钩甩入气泡位置会使鱼更快咬钩。如果水中有蓝色闪光，说明玩家恰好甩竿到了气泡位置。在气泡处钓鱼有两个奖励："]],["l",0,[[1,["鱼上钩速度变为四倍。"]],[1,["钓鱼区等级提高一级。"]],[2,["此时的钓鱼区等级提高对鱼的尺寸和基础品质没有影响，对宝箱奖励也没有影响。"]]]],["p",["每个地点同时至多存在一处气泡。有时气泡可能会出现在鱼竿不可及的位置。此外，除非选择了",["l","农场地图","河边农场"],"，否则气泡不会出现在农场内，。"]]]],["鱼的狂潮",3,[["p",["鱼的狂潮是一类发生于晚上11点前的随机事件，它会出现于",["l","沙滩","沙滩"],"、",["l","煤矿森林","煤矿森林"],"、",["l","鹈鹕镇","鹈鹕镇"],"或者",["l","深山","深山"],"。这类事件会在玩家至少抓到3条鱼和游玩至少3天后发生，或者游玩至少14天（此时可忽略钓上鱼的数量）。鱼的狂潮无法在",["l","节日","节日"],"时间触发。"]],["p",["当一个鱼的狂潮发生时，指定鱼类的气泡会出现在指定的区域（这种鱼必须符合对应的出现条件），这时玩家会收到一条消息“[某地]掀起了[某鱼]的狂潮”。当玩家在这些气泡中钓鱼时，狂潮对应的鱼上钩概率显著增加。这种气泡的效果相当于",["l","钓鱼","正常气泡"],"和",["l","针对性鱼饵","针对性鱼饵"],"的组合。",["l","鱼","传说鱼类"],"和钓竿可捕获的其它物品（凝胶，海草，绿藻等）不会生成对应的狂潮。"]]]],["消耗能量",3,[["p",["钓鱼等级为0时，抛竿消耗8能量。钓鱼等级每提升一级，消耗能量减少0.1。钓鱼等级为10时，抛竿消耗7能量。"]]]],["倾斜抛竿",3,[["p",["除默认的上下左右四个方向可以钓鱼之外，在抛竿的过程中（即从鱼钩甩出到入水之间的空中阶段），玩家可以按移动键(WASD)微调鱼钩入水的位置，从而更好地控制抛竿角度，实现倾斜抛竿。倾斜抛竿在两​​种情况下很有用："]],["p",["1. 在一些形状不规则的钓鱼区，需要通过倾斜抛竿才能钓到深水区的鱼。"]],["p",["2. 部分气泡生成的位置需要调整抛竿角度才能使鱼钩落入气泡中。"]]]],["时间",3,[["l",0,[[1,["单人游戏时"]],[2,["钓鱼游戏中和查看钓鱼宝箱时，时间暂停。"]],[1,["多人游戏时，时间不会暂停。"]],[1,["如果玩家受到攻击（例如在秘密森林钓鱼被史莱姆攻击），即使时间暂停，敌人仍在攻击并伤害玩家。"]],[1,["在",["l