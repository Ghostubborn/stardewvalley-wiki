{"s":[[null,1,[["p",["玛妮的牧场位于",["l","煤矿森林","煤矿森林"],"的东北部，靠近",["l","鹈鹕镇","鹈鹕镇"],"的西南入口。牧场也是",["l","玛妮","玛妮"],"以及她的侄女",["l","贾斯","贾斯"],"和侄子",["l","谢恩","谢恩"],"的家。"]],["p",["玛妮的营业时间是每天上午9:00至下午4:00（除了每周一、每周二、秋季的18日和冬季的18日之外）。玛妮的牧场从上午9:00到下午6:00一直都是可以进入的，即使玛妮已停止营业。"]],["p",["学会了",["l","动物目录","动物目录"],"后，即使玛妮不在，也可以使用商店。"]]]],["出售商品",2,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["价格"]}],[[["f","Hay.png",48]],[["l","干草","干草"]],["晾干的草料，可以用来喂动物。"],["50金"]],[[["f","Heater.png",48]],[["l","加热器","加热器"]],["为你的动物在冬天中保暖。"],["2,000金"]],[[["f","Animal_Catalogue.png",48]],[["l","动物目录","动物目录"]],["玛妮不在的时候也可以进入她的商店。\n只能在第二年后购买"],["5,000金"]],[[["f","Milk_Pail.png",48]],[["l","挤奶桶","挤奶桶"]],["给牲畜挤奶。"],["1,000金"]],[[["f","Shears.png",48]],[["l","剪刀","剪刀"]],["用这个来从羊身上剪毛。"],["1,000金"]],[[["f","Auto-Grabber.png",36]],[["l","自动采集器","自动采集器"]],["每天早晨自动采集动物产品。必须放在鸡舍或畜棚内。\n",["l","耕种","耕种"]," 10 级后解锁"],["25,000金"]],[[["f","Ornamental_Hay_Bale.png",48]],[["l","装饰干草捆","装饰干草捆"]],["农场的装饰件。"],["250金"]],[[["f","Golden_Egg.png",48]],[["l","金蛋","金蛋"]],["非常独特、罕见的蛋，金色的蛋壳非常坚固。\n游戏进度达到",["l","完美","完美"],"后解锁"],["100,000金"]],[[["f","Cow_Decal.png",48]],[["l","奶牛贴纸","奶牛贴纸"]],["这件家具不能布置在户外。\n从镇长的庄园里的",["l","镇长的庄园#兑奖机","兑奖机"],"处获得后解锁"],["10,000金"]],[[["f","Doghouse.png",48]],[["l","狗屋","狗屋"]],["能布置在户外。"],["10,000金"]],[[["f","Dark_Doghouse.png",48]],[["l","深色狗屋","深色狗屋"]],["能布置在户外。"],["10,000金"]],[[["f","Cat_Tree.png",48]],[["l","猫爬架","猫爬架"]],["可以作为装饰品摆放。"],["10,000金"]],[[["f","Dark_Cat_Tree.png",48]],[["l","深色猫爬架","深色猫爬架"]],["可以作为装饰品摆放。"],["10,000金"]],[[["f","Bird_House.png",32]],[["l","鸟屋","鸟屋"]],["能布置在户外。"],["5,000金"]]]]]],["牲畜",2,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["价格"]},{"h":1,"v":["需要的建筑"]}],[[["f","White_Chicken.png",48]," ",["f","Brown_Chicken.png",48]," ",["f","Blue_Chicken.png",48]],[["l","鸡","鸡"]],["精心培育的成年母鸡每天都能下蛋。饲养在鸡舍里。"],["800金"],[["l","鸡舍","鸡舍"]]],[[["f","White_Cow.png",90]," ",["f","Brown_Cow.png",90]],[["l","牛","牛"]],["成年奶牛每天都能产奶。需要奶桶来盛这些奶。饲养在畜棚里。"],["1,500金"],[["l","畜棚","畜棚"]]],[[["f","Goat.png",84]],[["l","山羊","山羊"]],["快乐的成年山羊每隔一天都会产奶。需要奶桶来盛这些奶。饲养在畜棚里。"],["4,000金"],[["l","畜棚","大畜棚"]]],[[["f","Duck.png",48]],[["l","鸭","鸭"]],["快乐的成年鸭子每隔一天都下鸭蛋。饲养在鸡舍里。"],["1,200金"],[["l","鸡舍","大鸡舍"]]],[[["f","Sheep.png",81]],[["l","绵羊","绵羊"]],["成年绵羊身上的羊毛可以剪下来。与主人关系密切的绵羊长毛更快。需要一把剪刀来剪羊毛。饲养在畜棚里。"],["8,000金"],[["l","畜棚","高级畜棚"]]],[[["f","Rabbit.png",48]],[["l","兔子","兔子"]],["毛绒绒的兔子！它们每隔几天就脱下珍贵的毛。饲养在鸡舍里。"],["8,000金"],[["l","鸡舍","高级鸡舍"]]],[[["f","Pig.png",93]],[["l","猪","猪"]],["这些猪在寻找松露方面训练有素！饲养在畜棚里。"],["16,000金"],[["l","畜棚","高级畜棚"]]]]]]],["注意",3,[["l",0,[[1,["在你升级或者建造建筑期间，玛妮不会出售动物给你。"]],[1,["在支付之前，你可以看到将收到什么颜色的动物。当玛妮要求选择你的动物将存放在哪栋建筑时，屏幕上方的备注会显示该动物是哪种颜色。 这时取消购买会返回到购买菜单。"]]]]]],["宠物领养",2,[["p",["在初始",["l","动物","宠物"],"达到最大",["l","动物#好感度","好感度"],"，或在第二年还没有宠物的情况下，玩家可以购买宠物饲养证以领养新的宠物。"]],["p",["玩家需要为额外的宠物建造宠物碗，否则宠物会感到不安。任何不需要的宠物可以对其使用",["l","蝴蝶粉","蝴蝶粉"],"进行移除。"]],["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["价格"]}],[[["f","Cat_1.png",48]],[["l","动物#猫和狗","猫"]],["邀请一只新宠物到你家。如果室外的宠物碗数量不够，宠物会不高兴。"],["40,000金"]],[[["f","Cat_2.png",48]],[["l","动物#猫和狗","猫"]],["邀请一只新宠物到你家。如果室外的宠物碗数量不够，宠物会不高兴。"],["40,000金"]],[[["f","Cat_3.png",48]],[["l","动物#猫和狗","猫"]],["邀请一只新宠物到你家。如果室外的宠物碗数量不够，宠物会不高兴。"],["40,000金"]],[[["f","Cat_4.png",48]],[["l","动物#猫和狗","猫"]],["邀请一只新宠物到你家。如果室外的宠物碗数量不够，宠物会不高兴。"],["40,000金"]],[[["f","Cat_5.png",48]],[["l","动物#猫和狗","猫"]],["邀请一只新宠物到你家。如果室外的宠物碗数量不够，宠物会不高兴。"],["40,000金"]],[[["f","Dog_1.png",48]],[["l","动物#猫和狗","狗"]],["邀请一只新宠物到你家。如果室外的宠物碗数量不够，宠物会不高兴。"],["40,000金"]],[[["f","Dog_2.png",48]],[["l","动物#猫和狗","狗"]],["邀请一只新宠物到你家。如果室外的宠物碗数量不够，宠物会不高兴。"],["40,000金"]],[[["f","Dog_3.png",48]],[["l","动物#猫和狗","狗"]],["邀请一只新宠物到你家。如果室外的宠物碗数量不够，宠物会不高兴。"],["40,000金"]],[[["f","Dog_4.png",48]],[["l","动物#猫和狗","狗"]],["邀请一只新宠物到你家。如果室外的宠物碗数量不够，宠物会不高兴。"],["40,000金"]],[[["f","Dog_5.png",48]],[["l","动物#猫和狗","狗"]],["邀请一只新宠物到你家。如果室外的宠物碗数量不够，宠物会不高兴。"],["40,000金"]],[[["f","Turtle.png",48]],[["l","动物#宠物","乌龟"]],["邀请一只新