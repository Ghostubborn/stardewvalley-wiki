{"s":[[null,1,[["p",["古代玩偶是一种",["l","古物","古物"],"，挖掘在",["l","深山","深山"],"、",["l","鹈鹕镇","鹈鹕镇"],"、",["l","煤矿森林","煤矿森林"],"和",["l","巴士站","巴士站"],"的",["l","远古斑点","远古斑点"],"有机会找到，或是打开",["l","钓鱼","釣魚宝箱"],"和",["l","古物宝藏","古物宝藏"],"也有机会获得。"]],["p",["在",["l","冬日星盛宴","冬日星盛宴"],"，",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"或",["l","雷欧","雷欧"],"也有可能将它作为礼物送给你。",["l","动物","宠物"],"狗达到最大",["l","动物","好感度"],"后，每天第一次被抚摸也有可能掉落古代玩偶。"]],["p",[["l","沙漠节","沙漠节"],"期间，",["l","贾斯","贾斯"],"会在其",["l","沙漠节","商铺"],"以1卡利科蛋 ",["l","卡利科三花蛋","卡利科三花蛋"],"的价格出售古代玩偶（限1个）。"]]]],["捐赠",2,[["p",["捐赠该物品可以增加",["l","博物馆","博物馆"],"的捐赠总数。"]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","贾斯","贾斯"]]],[{"h":1,"v":["喜欢"]},[["l","矮人","矮人"],"、",["l","潘妮","潘妮"]]],[{"h":1,"v":["不喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]]]]]],["收集包",2,[["p",["古代玩偶是儿童收集包的一个可选项。"]]]],["裁制",2,[["p",["古代玩偶可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","玩偶T恤"],"。古代玩偶可用于",["l","染色","染色"],"。放置在",["l","染色","染料罐"],"内时，古代玩偶可用作蓝色染料。放置在",["l","染色","缝纫机"],"内时，古代玩偶还可用作蓝色染料，染色强度为强烈。"]]]],["任务",2,[["p",["古代玩偶不用于任何",["l","任务","任务"],"。"]]]],["秘密",2,[["l",0,[[1,[["l","彩蛋","将孩子变成鸽子"],"后会收到古代玩偶。"]],[1,["将古代玩偶丢入",["l","矿井","矿井"],"100层岩浆池或",["l","火山地牢","火山口"],"岩浆池，可以获得秘密物品",["l","异界晶石","异界晶石"],"。"]]]]]]]}