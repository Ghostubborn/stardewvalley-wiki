{"s":[[null,1,[["p",["果酒是一种由",["l","小桶","小桶"],"制造的",["l","工匠物品","工匠物品"],"。酿造一瓶果酒需要",["l","游戏内时间","游戏内时间"],"10000分钟（约7日）。"]],["p",["无论在小桶内放入什么品质的水果，产出的果酒均为基础品质。更高品质的果酒通常由地窖",["l","木桶","木桶"],"进行陈酿获得。"]],["p",["基础品质果酒的售价均为原材料",["l","水果","水果"],"的基础品质价格的3倍，而非随水果品质增加。"]],["p",["无论用什么水果制作，果酒的功效都是一样的。饮用后会获得",["l","效果","眩晕"],"减益，效果为",["l","速度","速度"],"-1。"]],["p",["注意： 没有水果名字前缀的“果酒”可以通过从",["l","旅行货车","旅行货车"],"购买、从",["l","无尽财富之雕像","无尽财富之雕像"],"获得，或者",["l","冬日星盛宴","冬日星盛宴"],"上作为礼物收到。如果玩家与",["l","莉亚","莉亚"],"或",["l","艾利欧特","艾利欧特"],["l","婚姻","结婚"],"，在每年",["l","冬季","冬季"],"28日，也可能获得一瓶“果酒”作为新年礼物。它的售价是400金（选择",["l","耕种#耕种技能","工匠"],"技能后价格为560金）。"]]]],["陈酿价值",2,[["p",["果酒可以放置在",["l","木桶","木桶"],"中进行陈酿，从普通品质升到银星、金星，最终达到铱星品质。铱星果酒的价格是普通果酒的2倍。"]],["p",["果酒在",["l","木桶","木桶"],"中的陈酿时间是最长的。从基础到铱星品质需要陈酿两个季节(56天)。"]],["p",["通常情况下，可以随时通过用",["l","斧头","斧头"],"、",["l","锄头","锄头"],"或",["l","十字镐","十字镐"],"取下木桶，从木桶提前取出普通，银星或金星果酒。"]],["p",["另外，使用",["l","仙尘","仙尘"],"只会立即提升一个品质，即立即完成当前阶段的陈酿。"]],["t",[[{"h":1,"v":["普通品质"]},{"h":1,"v":["银星品质（x 1.25）"]},{"h":1,"v":["金星品质（x 1.5）"]},{"h":1,"v":["铱星品质（x 2）"]}],[["3 x 水果基础价值"],["（3 x 基础值）x 1.25 陈酿：14天"],["（3 x 基础值）x 1.50 陈酿：14天\n共：28天"],["（3 x 基础值）x 2 陈酿：28天\n共：56天"]]]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","莉亚","莉亚"],"、",["l","哈维","哈维"]]],[{"h":1,"v":["喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"]]],[{"h":1,"v":["讨厌"]},[["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","潘妮","潘妮"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","雷欧","雷欧"]]]]]]],["收集包",2,[[