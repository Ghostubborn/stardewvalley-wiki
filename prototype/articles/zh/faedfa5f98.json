{"s":[[null,1,[["p",["果汁是一件",["l","工匠物品","工匠物品"],"，由",["l","小桶","小桶"],"做成，所需时间大约为4",["l","游戏内时间","天"],"。售卖价格为放入小桶的",["l","蔬菜","蔬菜"],"(除茶叶、啤酒花、小麦外)价格乘2.25。一些野生",["l","采集","采集品"],"也可放入小桶制成果汁，例如",["l","蒲公英","蒲公英"],"、",["l","韭葱","韭葱"],"、",["l","野山葵","野山葵"],"、",["l","大葱","大葱"],"、",["l","榛子","榛子"],"、",["l","冬根","冬根"],"、",["l","雪山药","雪山药"],"、",["l","山洞萝卜","山洞萝卜"],"和",["l","姜","姜"],"等。原料均为蔬菜，因此该物品的准确译名应为蔬菜汁。"]],["p",["果汁的治疗效果全部相同，不会因为所用蔬菜的不同而变化。果汁不能放入木桶陈酿。"]],["p",["虽然",["l","小麦","小麦"],"、",["l","啤酒花","啤酒花"],"和",["l","茶叶","茶叶"],"被分类为蔬菜，但是在放入",["l","小桶","小桶"],"的后，小麦会产出",["l","啤酒","啤酒"],"，",["l","啤酒花","啤酒花"],"会产出",["l","淡啤酒","淡啤酒"],"，茶叶会产出",["l","绿茶","绿茶"],"。"]],["p",["果汁不能放进",["l","木桶","木桶"],"里陈酿。"]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]],[{"h":1,"v":["讨厌"]},[["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"]]]]]]],["收集包",2,[["p",["果汁是酿酒师收集包的其中一件所需物品。"]]]],["配方",2,[["p",["不用于任何配方"]]]],["裁制",2,[["p",["果汁可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成袖子可染色的 ",["l","裁缝","运动衫"],"。果汁可用于",["l","染色","染色"],"。放置在",["l","染色","缝纫机"],"内时，果汁可用作绿色染料。"]]]],["任务",2,[["p",[["l","潘姆","潘姆"],"在",["l","任务","特别任务“烈酒”"],"任务期间要求玩家收集并提交12瓶",["l","果汁","土豆果汁"],"。"]]]],["趣闻",2,[["p",[["l","旅行货车","旅行货车"],"所售的果汁不包含任何种类的蔬菜，售价一律为150金（若选择了工匠职业则为210金）。"]]]]],"f":[["来源",[["l","工匠物品","工匠物品"]]],["加工设备",[["i","(BC)12","小桶"]]],["原料",["任何",["l","蔬菜","蔬菜"],"（1）（",["l","小麦","小麦"],"、",["l","啤酒花","啤酒花"],"和",["l","茶叶","茶叶"],"除外）"]],["加工时间",["6000分钟（≈4天）"]],["售价",["2.25 × ",["l","蔬菜","蔬菜"],"价格"]]]}