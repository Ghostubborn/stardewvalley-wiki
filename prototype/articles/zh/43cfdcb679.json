{"s":[[null,1,[["p",["美洲大树莓是一种",["l","水果","水果"],"，可以于每年树莓季(",["l","春季","春季"],"15-18日)在星露谷的灌木丛中",["l","采集#夏季","采集"],"获得。在其他的日子里野外不会发现它们。"]],["p",[["l","采集#采集技能","采集技能"],"到4级之后，从每个灌木丛中可以收获两个浆果。",["l","采集#采集技能","采集技能"],"到8级之后，从每个灌木丛中可以收获3个浆果。如果暫時提高到12級可以一次收获4个浆果。\n每收获1个美洲大树莓会获得1点采集经验值。"]],["p",["在所有可采集的物品中，美洲大树莓的售价是最低的。所以送礼或吃掉比出售更有价值。这也是少有的制成",["l","果酱和腌菜","果酱"],"比制成",["l","果酒","果酒"],"卖的更贵的水果之一。如果有了",["l","熊的知识","熊的知识"],"，直接出售的价格甚至超过",["l","果酒","果酒"],"。"]]]],["送礼",2,[]],["美洲大树莓",3,[["t",[[{"h":1,"v":["喜欢"]},[["l","德米特里厄斯","德米特里厄斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","莉亚","莉亚"],"、",["l","莱纳斯","莱纳斯"],"、",["l","潘姆","潘姆"],"、",["l","罗宾","罗宾"],"、",["l","桑迪","桑迪"],"、",["l","谢恩","谢恩"]]],[{"h":1,"v":["不喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","克林特","克林特"],"、",["l","矮人","矮人"],"、",["l","艾米丽","艾米丽"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","山姆","山姆"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]],[{"h":1,"v":["讨厌"]},[["l","卡洛琳","卡洛琳"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾芙琳","艾芙琳"],"、",["l","哈维","哈维"]]]]]]],["美洲大树莓果酒",3,[["p",["美洲大树莓",["l","果酒","果酒"],"是同类中最便宜的。"]],["t",[[{"h":1,"v":["最爱"]},[["l","莉亚","莉亚"],"、",["l","哈维","哈维"]]],[{"h":1,"v":["喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"]]],[{"h":1,"v":["讨厌"]},[["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","潘妮","潘妮"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","雷欧","雷欧"]]]]]]],["美洲大树莓果酱",3,[["p",["美洲大树莓",["l","果酱和腌菜","果酱"],"是同类中最便宜的。"]],["t",[[{"h":1,"v":["喜欢"]},[["l","潘姆","潘姆"],"、",["l","海莉","海莉"],"、",["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","哈维","哈维"],"、",["l","潘妮","潘妮"],"、",["l","格斯","格斯"],"、",["l","艾芙琳","艾芙琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","乔治","乔治"],"、",["l","亚历克斯","亚历克斯"],"、",["l","克林特","克林特"],"、",["l","谢恩","谢恩"],"、",["l","威利","威利"],"、",["l","艾利欧特","艾利欧特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","乔迪","乔迪"],"、",["l","山姆","山姆"],"、",["l","玛妮","玛妮"],"、",["l","法师","法师"],"、",["l","肯特","肯特"],"、",["l","矮人","矮人"],"、",["l","刘易斯","刘易斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","桑迪","桑迪"],"、",["l","艾米丽","艾米丽"],"、",["l","玛鲁","玛鲁"],"、",["l","文森特","文森特"],"、",["l","贾斯","贾斯"],"、",["l","雷欧","雷欧"]]],[{"h":1,"v":["讨厌"]},[["l","塞巴斯蒂安","塞巴斯蒂安"]]]]]]],["收集包",2,[["l",0,[[1,["采集者收集包需要五十只美洲大树莓。"]],[1,["儿童收集包需要十只美洲大树莓。"]],[1,["美洲大树莓可以被放进",["l","小桶","小桶"],"来制作",["l","果酒","果酒"],"，果酒可以用于魔法师收集包，这是最便宜的选择。"]],[1,["美洲大树莓",["l","果酒","果酒"],"可以放在",["l","木桶","木桶"],"陈酿至银星品质，可用于完成失踪的收集包."]]]]]],["配方",2,[["p",["不用于任何配方，不过可以放入",["l","罐头瓶","罐头瓶"],"中，制成果酱。"]]]],["任务",2,[["p",["不能用在任何",["l","任务","任务"],"中"]]]],["裁制",2,[["p",["美洲大树莓可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","上衣"],"。美洲大树莓还可用作",["l","染色#染料罐","染料罐"],"和",["l","染色#缝纫机","缝纫机"],"的红色染料。"]]]],["提示",2,[["l",0,[[1,["尽管游戏提示出售美洲大树莓赚钱，但它很便宜，不如吃掉与送礼。尤其是第一年很多东西未解锁时美洲大树莓特别有效。 迅速将采集提升至4级可以在第一个树莓季收获400个美洲大树莓(超过10,000能量)。"]],[1,["在夜间更新时，每个灌木丛都有20%的几率生成美洲大树莓。在重新加载的存档中增加到50%，这意味着退出并重新加载游戏将平均多获得2.5倍的浆果。重新加载将在同一个位置始终生成相同的生成物，并且即使再次重新加载也不会改变。(详情可见 Reddit 上的帖子。)"]]]]]]],"f":[["来源",[["l","采集","采集"]]],["季节",["春季 15-18 日"]],["售价",["5金"]]]}