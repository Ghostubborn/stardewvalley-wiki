{"s":[[null,1,[["p",["黄水晶是一种",["l","矿物","矿物"],"。黄水晶主要来源于",["l","采矿","黄水晶矿"],"、",["l","采矿","宝石矿"],"、",["l","淘盘","淘金"],"和",["l","钓鱼","钓鱼宝箱"],"。击杀",["l","火山地牢","火山地牢"],"的",["l","矮人哨兵","矮人哨兵"],"也有10%的概率掉落黄水晶。在翻找",["l","垃圾桶","垃圾桶"],"的时候，偶尔也可以找到黄水晶。"]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","克林特","克林特"],"、",["l","艾米丽","艾米丽"],"、",["l","矮人","矮人"]]],[{"h":1,"v":["喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","雷欧","雷欧"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"]]],[{"h":1,"v":["不喜欢"]},[["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","莉亚","莉亚"]]]]]]],["收集包",2,[["p",["黄水晶用于宝藏猎人收集包."]]]],["配方",2,[["p",["不用于任何配方。"]]]],["裁制",2,[["p",["黄水晶可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","上衣"],"。黄水晶可用于",["l","染色","染色"],"。放置在",["l","染色","染料罐"],"内时，黄水晶可用作黄色染料。放置在",["l","染色","缝纫机"],"内时，黄水晶还可用作金色染料。"]]]],["任务",2,[["l",0,[[1,["黄水晶可能会在任何季节出现在",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"外边的",["l","任务","“布告栏”"],"上的随机任务中。任务完成的奖励是 240金 和 150",["l","友谊","友谊点"],"。"]],[1,["饲养有",["l","鲶鱼","鲶鱼"],"的",["l","鱼塘","鱼塘"],"在数量从3提升到5的时候，会出现要求玩家提供2个黄水晶的",["l","鱼塘","鱼塘任务"],"。"]],[1,["在",["l","刘易斯","刘易斯"],"房子外边的",["l","任务","特别任务"],"板上出现的“宝石能量”任务中，",["l","艾米丽","艾米丽"],"会要求玩家提供一个黄水晶。"]],[1,["黄水晶可用于解开",["l","姜岛","姜岛"],"的",["l","姜岛","宝石鸟谜题"],"。"]]]]]],["锻造",2,[["p",["可用于提高武器 ",["l","防御","防御"],"（每级 +1）"]]]]]}