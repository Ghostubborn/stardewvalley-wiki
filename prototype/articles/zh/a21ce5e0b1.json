{"s":[[null,1,[["p",["香辣鳗鱼是一道",["l","烹饪","菜肴"],"，可通过升级后的",["l","农舍","农舍"],"内的厨房或",["l","野炊工具","野炊工具"],"制作。"]],["p",["香辣鳗鱼于",["l","周循环#周六","周六"],"有概率出现在",["l","科罗布斯#滚动出售","科罗布斯"],"的商店，或是随机出现在",["l","星之果实酒吧#不固定商品","星之果实酒吧"],"的菜单中。翻动酒吧外的",["l","垃圾桶","垃圾桶"],"也有可能找到。玩家阅读过",["l","古代珍宝鉴定指南","古代珍宝鉴定指南"],"后，可在",["l","书摊老板","书摊老板"],"处用1本古代珍宝鉴定指南兑换3份香辣鳗鱼。",["l","沙漠节","沙漠节"],"的卡利科三花蛋商人也有概率以10卡利科蛋 ",["l","卡利科三花蛋","卡利科三花蛋"],"的价格出售（限5份）。"]],["p",["击杀",["l","骷髅洞穴","骷髅洞穴"],"中的",["l","飞蛇","飞蛇"],"有6%概率掉落香辣鳗鱼。",["l","沙漠商人","沙漠商人"],"会以一个",["l","红宝石","红宝石"],"的价格出售香辣鳗鱼。饲养",["l","岩浆鳗鱼","岩浆鳗鱼"],"的",["l","鱼塘","鱼塘"],"也会在数量达到9后以每天3%~4%的概率生产5份香辣鳗鱼。打开",["l","谜之盒","谜之盒"],"有概率获得1份香辣鳗鱼。",["l","镇长的庄园#兑奖机","兑奖机"],"第22个奖励后无限循环的9个档位，档位8奖励有可能为5份香辣鳗鱼。"]],["p",["注意：这个食谱需要使用低品质的食材才能",["l","烹饪#食谱的利润","获得利润"],"。"]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","阿比盖尔","阿比盖尔"]]],[{"h":1,"v":["喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"]]],[{"h":1,"v":["不喜欢"]},[["l","艾米丽","艾米丽"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]],[{"h":1,"v":["讨厌"]},[["l","艾芙琳","艾芙琳"]]]]]]],["收集包",2,[["p",["香辣鳗鱼不用于任何",["l","收集包","收集包"],"。"]]]],["食谱",2,[["p",["香辣鳗鱼不用于任何食谱。"]]]],["裁制",2,[["p",["香辣鳗鱼可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","火焰T恤"],"。香辣鳗鱼还可用作",["l","染色#染料罐","染料罐"],"和",["l","染色#缝纫机","缝纫机"],"的红色染料。"]]]],["任务",2,[["p",["香辣鳗鱼不用于任何",["l","任务","任务"],"。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.4","1.4"],"：现在可在",["l","沙漠商人","沙漠商人"],"处获得。现在可用于",["l","裁缝","裁缝"],"。现在可由",["l","岩浆鳗鱼","岩浆鳗鱼"],["l","鱼塘","鱼塘"],"产出。"]],[1,[["l","版本历史#1.5","1.5"],"：现在可以用",["l","野炊工具","野炊工具"],"烹饪。"]],[1,[["l","版本历史#1.6","1.6"],"：现在可以打开",["l","谜之盒","谜之盒"],"获得。现在可以从",["l","沙漠节","沙漠节"],"的卡利科三花蛋商人处购买。现在可以在",["l","书摊老板","书摊老板"],"处兑换。现在可以作为奖励从",["l","镇长的庄园#兑奖机","兑奖机"],"获得。"]]]]]]]}