{"s":[[null,1,[["p",["香蕉树是一种",["l","果树","果树"],"，由",["l","香蕉树苗","香蕉树苗"],"生长 28 天成熟。成熟的香蕉树在星露谷",["l","农场","农场"],"的",["l","夏季","夏季"],"每天都会产出一个",["l","香蕉","香蕉"],"，种植在",["l","温室","温室"],"和",["l","姜岛","姜岛"],"中时全年结果。"]],["p",[["l","果树","果树"],"树苗只能生长在 3x3 的方格的中央，周围 8 格在生长期间都必须保证没有任何物体、",["l","地板","地板"],"和地形特征（包括",["l","草","草"],"），",["l","果树","果树"],"成熟后不再有此限制。"]],["p",[["l","果树","果树"],"结出的",["l","水果","水果"],"品质会逐年提升，在第三年后可以达到铱星品质。被",["l","闪电","闪电"],"击中的果树会产出",["l","煤炭","煤炭"],"，4 天后恢复为对应的",["l","水果","水果"],"。"]],["p",[["l","香蕉树苗","香蕉树苗"],"可以在",["l","姜岛商人","姜岛商人"],"处以 5 个",["i","(O)852","龙牙"],"的价格购买获得，敲开",["l","金色椰子","金色椰子"],"也有 1/7 的几率获得香蕉树苗。"]]]],["画廊",2,[["g",[["BananaTreeLightning.png",120,["被闪电击中的香蕉树"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.5#1.5","1.5"],"：加入游戏。"]],[1,[["l","版本历史#1.6","1.6"],"：现在砍倒一个果树会产出相应的树苗。如果果树结出的果实品质大于普通品质，它会产出一个与其果实相同品质的树苗。树苗品质越高，果树成熟得越快。"]]]]]]],"f":[["树苗",[["i","(O)69","香蕉树苗"]]],["出产",[["i","(O)91","香蕉"]]],["成长时间",["28 天"]],["丰收季节",["夏季"]]]}