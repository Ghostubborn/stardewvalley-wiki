{"s":[[null,1,[["p",["铜矿石可以通过使用",["l","十字镐","十字镐"],"开采",["l","采矿#Copper Node","铜矿"],"获得。每开采一块铜矿会获得1~3个铜矿石，选择了",["l","采矿#采矿技能","“矿工”职业"],"时会产出更多。"]]]],["获取途径",2,[["l",0,[[1,["可以无限量在",["l","铁匠铺","铁匠铺"],"中购买，第一年售价75金，第二年及之后售价150金。"]],[1,["开采",["f","Copper_Node.png",24],["l","采矿#Copper Node","铜矿"],"："]],[2,[["l","矿井","矿井"],"(2-39层)中含有大量铜矿，其他楼层中也可能出现，但相对较少。铜矿脉周边的普通石头也有很高概率掉落1个铜矿石。"]],[2,[["l","采石场","采石场"],"、",["l","采石场矿井","采石场矿井"],"、",["l","农场地图#Hilltop","山顶农场"],"和",["l","农场地图#Four Corners","四角农场"],"的采矿区中都会生成铜矿。"]],[2,[["l","骷髅洞穴","骷髅洞穴"],"和",["l","火山地牢","火山地牢"],"的任意层中都可以生成铜矿。"]],[1,["打破矿井中的",["l","矿井#木箱和木桶","木箱和木桶"],"时有可能获得铜矿石。"]],[1,["挖掘",["l","矿井#沙地","矿井中的沙地"],"时有可能会获得铜矿石。"]],[1,["有概率掉落自",["l","矿井","矿井"],"81~119层的",["l","金属大头","金属大头"],"。"]],[1,[["l","采石场矿井","采石场矿井"],"和",["l","矿井#地牢层","矿井的地牢层"],"中的",["l","史莱姆（怪物）#变种","铜史莱姆"],"有概率掉落。"]],[1,[["l","矿物#晶球","四种晶球"],"中都有可能出现。"]],[1,["有几率出现在",["l","钓鱼#宝箱","釣魚宝箱"],"中。"]],[1,["翻动铁匠铺外的",["l","垃圾桶","垃圾桶"],"也有概率找到铜矿石。"]],[1,["使用",["l","淘盘","淘盘"],"淘金时有几率获得。"]],[1,["在",["l","鹈鹕镇","鹈鹕镇"],"、",["l","铁路","铁路"],"、",["l","巴士站","巴士站"],"、",["l","边远森林","边远森林"],"、",["l","煤矿森林","煤矿森林"],"和",["l","深山","深山"],"中挖掘",["l","远古斑点","远古斑点"],"时有可能获得。"]],[1,["偶尔可以在",["l","旅行货车","旅行货车"],"中以100–1,000金的价格购买。"]],[1,[["l","石鱼","石鱼"],"的",["l","鱼塘","鱼塘"],"中至少有3条鱼的时候，有可能产出5个铜矿石。"]],[1,[["l","沙漠节","沙漠节"],"期间",["l","克林特","克林特"],"会以2卡利科蛋 ",["l","卡利科三花蛋","卡利科三花蛋"],"的价格出售铜矿石（限100个）。"]]]]]],["熔炼",2,[["p",["铜矿石可以在",["l","熔炉","熔炉"],"中熔炼出",["l","铜锭","铜锭"],"。熔炼消耗5个铜矿石和1个",["l","煤炭","煤炭"],"，耗时30分钟（游戏内时间）。"]]]],["制作",2,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["材料"]},{"h":1,"v":["配方来源"]}],[[["f","Cherry_Bomb.png",48]],[["l","樱桃炸弹","樱桃炸弹"]],["会发生小爆炸。靠后站！"],[["i","(O)378","铜矿石×4"],["i","(O)382","煤炭×1"]],[["f","Mining_Skill_Icon.png",24]," ",["l","采矿","采矿"],"技能1级"]],[[["f","Furnace.png",48]],[["l","熔炉","熔炉"]],["将矿石和煤炭转换为金属方块。"],[["i","(O)378","铜矿石×20"],["i","(O)390","石头×25"]],[["f","Clint_Icon.png",32]," ",["l","克林特","克林特"]]],[[["f","Flute_Blo