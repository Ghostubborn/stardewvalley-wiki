{"s":[[null,1,[["p",["绿宝石是一种",["l","矿物","矿物"],"。绿宝石主要来源于",["l","采矿#采矿点","绿宝石矿"],"、",["l","采矿#采矿点","宝石矿"],"、",["l","淘盘","淘金"],"和",["l","钓鱼#宝箱","钓鱼宝箱"],"。在玩家抵达",["l","矿井","矿井"],"的最后一层后，翻找",["l","垃圾桶","垃圾桶"],"的时候，偶尔也可以找到绿宝石。",["l","无尽财富之雕像","无尽财富之雕像"],"也会在",["l","艾米丽","艾米丽"],"、",["l","潘妮","潘妮"],"、",["l","克林特","克林特"],"生日时生产一个绿宝石。击杀",["l","火山地牢","火山地牢"],"中的",["l","矮人哨兵","矮人哨兵"],"也有10%的概率掉落。在",["l","冬日星盛宴","冬日星盛宴"],"期间，玩家可能会收到作为礼物的绿宝石。"]],["p",["玩家可在",["l","游戏内时间","星期五"],"，用一个绿宝石向",["l","沙漠商人","沙漠商人"],"交换购买一个",["l","奶酪","奶酪"],"。"]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","艾米丽","艾米丽"],"、",["l","矮人","矮人"]]],[{"h":1,"v":["喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","潘姆","潘姆"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]],[{"h":1,"v":["不喜欢"]},[["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","莉亚","莉亚"]]]]]]],["收集",2,[["p",["绿宝石用于宝藏猎人收集包。"]]]],["配方",2,[["p",["不用于任何配方。"]]]],["裁制",2,[["p",["绿宝石可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","上衣"],"。绿宝石还可用作",["l","染色#染料罐","染料罐"],"和",["l","染色#缝纫机","缝纫机"],"的绿色染料。"]]]],["任务",2,[["l",0,[[1,["绿宝石可能会在任何季节出现在",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"外边的",["l","任务#求助任务","“布告栏”"],"上的随机任务中。任务完成的奖励是750金 和150",["l","友谊","友谊点"],"。在你达到矿井80层及以上之前，绿宝石不会出现在布告栏中。"]],[1,["饲养有",["l","章鱼","章鱼"],"、",["l","虹鳟鱼","虹鳟鱼"],"、",["l","幽灵鱼","幽灵鱼"],"或",["l","大海参","大海参"],"的",["l","鱼塘","鱼塘"],"在数量从5提升到7的时候，会出现要求玩家提供2个绿宝石的",["l","鱼塘#任务","鱼塘任务"],"。"]],[1,["在",["l","刘易斯","刘易斯"],"房子外边的",["l","任务#鹈鹕镇的特别任务列表","特别任务"],"板上出现的“宝石能量”任务中，",["l","艾米丽","艾米丽"],"