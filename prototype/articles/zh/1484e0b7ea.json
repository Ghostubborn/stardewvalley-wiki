{"s":[[null,1,[["p",["绿宝石是一种",["l","矿物","矿物"],"。主要通过挖掘",["l","绿宝石矿","绿宝石矿"],"或",["l","紫色宝石矿","紫色宝石矿"],"获得。击杀",["l","火山地牢","火山地牢"],"的",["l","矮人哨兵","矮人哨兵"],"有 10% 的概率掉落绿宝石。在火山地牢内打破",["l","火山地牢#金属板条箱","金属板条箱"],"或在矿井 81~119 层和",["l","骷髅洞穴","骷髅洞穴"],"中打破",["l","矿井#木箱和木桶","木箱和木桶"],"也有概率获得绿宝石，概率分别为 2.4% 和 1.87%。在",["l","冬日星盛宴","冬日星盛宴"],"上，如果给玩家送礼物的村民是除",["l","克林特","克林特"],"、",["l","艾芙琳","艾芙琳"],"、",["l","玛妮","玛妮"],"、",["l","罗宾","罗宾"],"或",["l","威利","威利"],"以外的成人，玩家也可能获得一颗绿宝石。绿宝石也有小概率通过打开",["l","钓鱼#宝箱","钓鱼宝箱"],"、使用淘盘",["l","淘盘","淘金"],"或在到达矿井 80 层后翻动",["l","垃圾桶","垃圾桶"],"获得。"]],["p",["每周的星期五，可以在",["l","沙漠商人","沙漠商人"],"处使用一颗绿宝石交换一个",["l","奶酪","奶酪"],"。"]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","克林特","克林特"],"、",["l","矮人","矮人"],"、",["l","艾米丽","艾米丽"],"、",["l","潘妮","潘妮"]]],[{"h":1,"v":["喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]],[{"h":1,"v":["不喜欢"]},[["l","莉亚","莉亚"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"]]]]]]],["收集包",2,[["p",["宝藏猎人收集包需要 1 颗绿宝石（作为可选项）。"]]]],["打造",2,[["p",["绿宝石不用于任何",["l","打造#可打造物品","配方"],"。"]]]],["裁制",2,[["p",["绿宝石可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","上衣"],"。绿宝石还可用作",["l","染色#染料罐","染料罐"],"和",["l","染色#缝纫机","缝纫机"],"的绿色染料。"]]]],["任务",2,[["l",0,[[1,["在玩家到达矿井 80 层后，绿宝石可能会出现在",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"门前",["l","任务#求助任务","“布告栏”"],"上的随机任务中。任务完成的奖励是750金 和 150 ",["l","友谊","友谊点"],"。"]],[1,["在",["l","任务#Rock Rejuvenation","特别任务“宝石能量”"],"中，玩家需要将 1 颗绿宝石交付给",["l","艾米丽","艾米丽"],"。"]],[1,["绿宝石可用于解开",["l","姜岛","姜岛"],"的",["l","姜岛#宝石鸟","宝石鸟谜题"],"。"]],[1,["饲养有",["l","章鱼","章鱼"],"、",["l","虹鳟鱼","虹鳟鱼"],"、",["l","幽灵鱼","幽灵鱼"],"或",["l","大海参","大海参"],"的",["l","鱼塘","鱼塘"],"在数量从 5 提升到 7 的时候，会出现要求玩家提供 2 个绿宝石的",["l","鱼塘#任务","鱼塘任务"],"。"]]]]]],["锻造",2,[["n",["主条目：",["l","锻造","锻造"]]],["p",["绿宝石在用于锻造时可提高武器的 ",["l","速度","攻击速度"],"（第一、三级 +2，第二级 +3）。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.4#1.4","1.4"],"：现在可用于",["l","裁缝","裁缝"],"。现在可出现在鱼塘的任务中。"]],[1,[["l","版本历史/1.5#1.5","1.5"],"：现在会出现在特别任务列表中。现在可用于解开",["l","姜岛","姜岛"],"的",["l","姜岛#宝石鸟","宝石鸟谜题"],"。现在绿宝石可以用于",["l","锻造#武器强化","武器强化"],"。现在矮人哨兵会掉落绿宝石。"]]]]]]]}