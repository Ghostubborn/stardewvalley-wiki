{"s":[[null,1,[["p",["豆类火锅是一道",["l","烹饪","菜肴"],"，可通过升级后的",["l","农舍","农舍"],"内的厨房或",["l","野炊工具","野炊工具"],"制作。"]],["p",["豆类火锅于",["l","周循环","周六"],"有概率出现在",["l","科罗布斯","科罗布斯"],"的商店，或是随机出现在",["l","星之果实酒吧","星之果实酒吧"],"的菜单中。翻动酒吧外的",["l","垃圾桶","垃圾桶"],"也有可能找到。",["l","无尽财富之雕像","无尽财富之雕像"],"也会在",["l","德米特里厄斯","德米特里厄斯"],"生日时（夏19日）生产一个豆类火锅。打开",["l","谜之盒","谜之盒"],"也有概率获得1份豆类火锅。"]],["p",["注意：这个食谱需要使用低品质的食材才能",["l","烹饪","获得利润"],"。"]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","德米特里厄斯","德米特里厄斯"]]],[{"h":1,"v":["喜欢"]},[["l","罗宾","罗宾"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"]]],[{"h":1,"v":["不喜欢"]},[["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]]]]]],["收集包",2,[["p",["豆类火锅不用于任何",["l","收集包","收集包"],"。"]]]],["食谱",2,[["p",["豆类火锅不用于任何",["l","烹饪","食谱"],"。"]]]],["裁制",2,[["p",["豆类火锅可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","绿色背心"],"。豆类火锅还可用作",["l","染色","染料罐"],"和",["l","染色","缝纫机"],"的绿色染料。"]]]],["任务",2,[["p",["豆类火锅不用于任何",["l","任务","任务"],"。"]]]]]}