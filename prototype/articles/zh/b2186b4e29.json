{"s":[[null,1,[["p",["冬季种子是一种通过",["l","打造","打造"],"得到的种子。打造配方的名字是“野生种子（冬季）”，但得到的物品是“冬季种子”。作物成熟时，会随机变为",["l","番红花","番红花"],"、",["l","水晶果","水晶果"],"、",["l","雪山药","雪山药"],"和",["l","冬根","冬根"],"。"]],["p",["冬季种子和",["l","春季种子","春季种子"],"、",["l","夏季种子","夏季种子"],"以及",["l","秋季种子","秋季种子"],"一样，是一种只能在特定",["l","季节","季节"],"种下的野生种子，长出的作物通常也是对应季节的",["l","采集","采集物品"],"。通常，",["l","耕种","耕种"],"技能可以提升长出高质量作物的几率，但冬季种子长出高质量作物的几率是由",["l","采集","采集"],"技能决定的。选择",["l","采集","“植物学家”职业"],"可以保证收获的作物都是铱星品质。"]],["p",["由冬季种子长成的作物可能会在收获阶段使所在的地块变为没有锄过的地块。这时，所有使用过的肥料效果都会消失。"]],["p",["乌鸦不会侵害由冬季种子长成的作物，因此并没有必要使用",["l","稻草人","稻草人"],"。"]]]],["来源",2,[["l",0,[[1,[["l","打造","打造"]," (每次制造生产10份冬季种子。)"]],[1,["把一个",["l","冬根","冬根"],"放进",["l","种子生产器","种子生产器"],"（产出：1-3份冬季种子）"]],[1,["完成冬季采集收集包 （奖励：30份冬季种子）"]],[1,[["l","旅行货车","旅行货车"]," (售价100–1,000金)"]],[1,["有时也可以从",["l","骷髅洞穴","骷髅洞穴宝箱"],"中找到5-20个"]],[1,["每",["l","周循环","周六"],"在",["l","沙漠商人","沙漠商人"],"处以2个",["l","春季种子","春季种子"],"兑换"]],[1,[["l","鱿鱼节","鱿鱼节"],"：冬季12日铁级别奖励有50%概率获得10个，冬季13日铁级别奖励有50%概率获得15个"]]]]]],["收获作物",2,[["p",["冬季种子收获时，变为下面任一",["l","农作物","农作物"],"的几率是相同的。"]],["t",[[{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["来源"]}],[[["l","番红花","番红花"]],["冬天开花的一种花朵。"],[["l","采集","冬季采集"]," • 冬季种子"]],[[["l","水晶果","水晶果"]],["一种在冬天出现的美味水果。"],[["l","采集","冬季采集"]," • 冬季种子"]],[[["l","雪山药","雪山药"]],["这种小山药隐藏在雪地下。"],[["l","采集","冬季采集"]," • 冬季种子"]],[[["l","冬根","冬根"]],["一种淀粉块茎植物。"],[["l","采集","冬季采集"]," • 冬季种子"]]]]]],["生长阶段",2,[["t",[[{"h":1,"v":["阶段 1"]},{"h":1,"v":["阶段 2"]},{"h":1,"v":["收获"]}],[["3 天"],["4 天"],["总计 7 天"]]]]]],["作物生长日历",2,[["t",[[{"c":7,"h":1,"v":["基本"]}],[{"h":1,"v":["一"]},{"h":1,"v":["二"]},{"h":1,"v":["三"]},{"h":1,"v":["四"]},{"h":1,"v":["五"]},{"h":1,"v":["六"]},{"h":1,"v":["日"]}]]],["t",[[{"c":4,"h":1,"v":["农业学家和生长激素之间的比较"]}],[{"h":1,"v":[]},{"h":1,"v":[["l","生长激素","生长激素"]]},{"h":1,"v":[["l","高级生长激素","高级生长激素"]]},{"h":1,"v":[["l","顶级生长激素","顶级生长激素"]]}],[{"r":2,"h":1,"v":["通常"]},{"b":[["t",[[{"c":7,"h":1,"v":["10%※"]}],[{"h":1,"v":["一"]},{"h":1,"v":["二"]},{"h":1,"v":["三"]},{"