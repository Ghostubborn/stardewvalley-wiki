{"s":[[null,1,[["p",["辣椒种子是一种种子，播种并生长 5 天成熟后可以持续产出",["l","辣椒","辣椒"],"。辣椒种子可以在",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"、",["l","Joja超市","Joja 超市"],"和",["l","冬季","冬季"]," 16 日",["l","夜市#魔法商船","夜市上的魔法商船"],"处买到。"]],["p",["旅行货车会以 100–1,000金 的价格随机出售。辣椒种子也可以通过将辣椒放入",["l","种子生产器","种子生产器"],"中获得。在",["l","夏季","夏季"],"或",["l","冬季","冬季"],"的温室中种下",["l","混合种子","混合种子"],"可能变为辣椒种子。在",["l","骷髅洞穴#宝藏房间","骷髅洞穴"],"的宝箱层里打开宝箱也可能会获得 5~20 个辣椒种子。在",["l","夏季","夏季"],"和",["l","冬季","冬季"],"打开",["l","谜之盒","谜之盒"],"或",["l","金色谜之盒","金色谜之盒"],"也有概率获得 8 个或 20 个辣椒种子。在",["l","矿井#挑战之神庙","危险的矿井"],"或",["l","骷髅洞穴","危险的骷髅洞穴"],"中击杀",["l","矿井#特殊物品","特殊怪物"],"（",["l","史莱姆#特殊史莱姆","特殊史莱姆"],"会有黄色星形触角的明显特征，其他特殊怪物与正常怪物无明显差异）也有概率获得辣椒种子。"]]]],["送礼",2,[["t",[[{"h":1,"v":["不喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]]]]]]]}