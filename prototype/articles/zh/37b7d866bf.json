{"s":[[null,1,[["p",["辣椒种子是一种种子，成熟后得到",["l","辣椒","辣椒"],"。"]],["p",["辣椒种子可以在",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"、",["l","Joja超市","Joja超市"],"和",["l","冬季","冬季"],"16日",["l","夜市","夜市上的魔法商船"],"买到，偶尔也会在",["l","旅行货车","旅行货车"],"上出售。辣椒种子也可以通过",["l","种子生产器","种子生产器"],"获得。种下",["l","混合种子","混合种子"],"也有可能变为辣椒种子。骷髅洞穴",["l","骷髅洞穴","宝藏房间"],"的宝箱偶尔也能开出5-20个辣椒种子。在",["l","夏季","夏季"],"和",["l","冬季","冬季"],"打开",["l","谜之盒","谜之盒"],"有概率获得8个或20个辣椒种子，打开",["l","金色谜之盒","金色谜之盒"],"有概率获得20个辣椒种子。"]]]],["生长阶段",2,[["p",["收获后，每个辣椒植株每三天产出1个辣椒，并有3%概率产出更多辣椒。"]],["t",[[{"h":1,"v":["阶段 1"]},{"h":1,"v":["阶段 2"]},{"h":1,"v":["阶段 3"]},{"h":1,"v":["阶段 4"]},{"h":1,"v":["阶段 5"]},{"c":2,"h":1,"v":["收成"]}],[[["f","Hot_Pepper_Stage_1.png",42]],[["f","Hot_Pepper_Stage_2.png",42]],[["f","Hot_Pepper_Stage_3.png",42]],[["f","Hot_Pepper_Stage_4.png",42]],[["f","Hot_Pepper_Stage_4b.png",42]],[["f","Hot_Pepper_Stage_5.png",42]],[["f","Hot_Pepper_Stage_6.png",42]]],[["1天"],["1天"],["1天"],["1天"],["1天"],["共：5天"],["每3天继续生产"]]]]]],["送礼",2,[["t",[[{"h":1,"v":["不喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]]]]]]]}