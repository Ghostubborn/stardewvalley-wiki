{"s":[[null,1,[["p",["椰林飘香是一种在",["l","格斯","格斯"],"到访姜岛时可以从",["l","姜岛","度假村酒吧"],"花费 600金 购买到的饮料。它不能经",["l","烹饪","烹饪"],"、",["l","打造","打造"],"或者从其他任何方式获取。"]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","潘姆","潘姆"]]],[{"h":1,"v":["喜欢"]},[["l","亚历克斯","亚历克斯"],"、",["l","艾利欧特","艾利欧特"],"、",["l","哈维","哈维"],"、",["l","山姆","山姆"],"、",["l","谢恩","谢恩"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","莉亚","莉亚"],"、",["l","玛鲁","玛鲁"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","乔迪","乔迪"],"、",["l","科罗布斯","科罗布斯"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","法师","法师"]]],[{"h":1,"v":["不喜欢"]},[["l","肯特","肯特"]]],[{"h":1,"v":["讨厌"]},[["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","潘妮","潘妮"],"、",["l","贾斯","贾斯"],"、",["l","雷欧","雷欧"],"、",["l","文森特","文森特"]]]]]]],["裁制",2,[["p",["椰林飘香可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","黑皮夹克"],"。椰林飘香可用于",["l","染色","染色"],"。放置在",["l","染色","缝纫机"],"内时，椰林飘香可用作白色染料。"]]]],["注意",2,[["l",0,[[1,["尽管椰林飘香不可以被",["l","烹饪","烹饪"],"，但它在游戏文件中显示的也是“烹饪”得到的，当你将椰林飘香作为",["l","友谊","礼物"],"赠送给",["l","居民","居民"],"的时候，它会显示为菜肴一类物品。"]],[1,["椰林飘香不可以加入",["l","夏威夷宴会","百乐汤"],"当中。"]]]]]],["趣闻",2,[["l",0,[[1,["椰林飘香实质上是一款鸡尾酒。和其他的酒精饮品一样，“请适量饮酒”这一提示也会出现在它的描述中，但它不会带来",["l","效果","眩晕"],"的效果。"]]]]]]],"f":[["来源",["在",["l","姜岛","姜岛度假村"],"向",["f","Gus_Icon.png",22],["l","格斯","格斯"],"花600金购买"]],["售价",["300金"]]]}