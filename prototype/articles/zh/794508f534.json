{"s":[[null,1,[["p",["粉红蛋糕是一道",["l","烹饪","菜肴"],"，可通过升级后的",["l","农舍","农舍"],"内的厨房或",["l","野炊工具","野炊工具"],"制作。"]],["p",["粉红蛋糕可以作为礼物在",["l","冬日星盛宴","冬日星盛宴"],"上收到。它于",["l","周循环","周六"],"有概率出现在",["l","科罗布斯","科罗布斯"],"的商店，或是随机出现在",["l","星之果实酒吧","星之果实酒吧"],"的菜单中。翻动酒吧外的",["l","垃圾桶","垃圾桶"],"也有可能找到。打开",["l","谜之盒","谜之盒"],"也有概率获得1份粉红蛋糕。",["l","沙漠节","沙漠节"],"期间，",["l","海莉","海莉"],"会在其",["l","沙漠节","商铺"],"以20卡利科蛋 ",["l","卡利科三花蛋","卡利科三花蛋"],"的价格出售粉红蛋糕（限5个）。如果玩家角色是男性，那么在赚到120,000金后就会收到",["l","妈妈和爸爸","妈妈随信寄来的"],"粉红蛋糕。"]],["p",["完成厨师收集包可获得 3 个粉红蛋糕作为奖励。击杀",["l","史莱姆（怪物）","巨型史莱姆"],"也有 0.1% 几率掉落粉红蛋糕，如果玩家装备了",["l","窃贼戒指","窃贼戒指"],"，则会掉落两个粉红蛋糕。"]],["p",[["l","无尽财富之雕像","无尽财富之雕像"],"每年会生产三个粉红蛋糕，分别是",["l","海莉","海莉"],"生日时（春季14日）、",["l","文森特","文森特"],"生日时（春季10日）和",["l","贾斯","贾斯"],"生日时（夏季4日）。"]],["p",["注意：这个食谱是",["l","烹饪","有利润"],"的，使用低品质的",["l","蛋","蛋"],"和",["l","甜瓜","甜瓜"],"以及",["l","磨坊","磨坊"],"制作的",["l","糖","糖"],"和",["l","大麦粉","大麦粉"],"就能获得利润。"]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","玛妮","玛妮"]]],[{"h":1,"v":["喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","谢恩","谢恩"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","桑迪","桑迪"]]],[{"h":1,"v":["不喜欢"]},[["l","哈维","哈维"],"、",["l","莉亚","莉亚"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]]]]]],["收集包",2,[["p",["粉红蛋糕不用于任何",["l","收集包","收集包"],"。"]]]],["配方",2,[["p",["粉红蛋糕不用于任何配方。"]]]],["裁制",2,[["p",["粉红蛋糕可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","上衣"],"。粉红蛋糕可用于",["l","染色","染色"],"。放置在",["l","染色","染料罐"],"内时，粉红蛋糕可用作红色染料。放置在",["l","染色","缝纫机"],"内时，粉红蛋糕还可用作粉色染料。"]]]],["任务",2,[["p",["粉红蛋糕不用于任何",["l","任务","任务"],"。"]]]]]}