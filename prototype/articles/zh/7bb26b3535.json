{"s":[[null,1,[["p",["魔法发胶是一种",["l","饰品","饰品"],"，可通过在",["l","沙漠节","沙漠节"],"期间从",["l","亚历克斯","亚历克斯"],"处以100卡利科蛋 ",["l","卡利科三花蛋","卡利科三花蛋"],"的价格购买获得。它是唯一不能通过",["l","怪物","怪物"],"、",["l","矿井#木箱和木桶","木箱和木桶"],"或",["l","骷髅洞穴#宝藏房间","骷髅洞穴宝箱"],"掉落获得的",["l","饰品","饰品"],"。"]],["p",["将魔法发胶装备在饰品栏中，",["l","玩家角色","玩家"],"的头发颜色会不断地在",["l","五彩碎片","五彩碎片"],"的颜色之间循环。这种“五彩碎片”效果与",["l","魔法牛仔帽","魔法牛仔帽"],"或",["l","魔法头巾","魔法头巾"],"上看到的效果相同。"]],["p",["魔法发胶无法使用",["l","铁砧","铁砧"],"重铸。"]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","法师","法师"]]],[{"h":1,"v":["不喜欢"]},[["l","亚历克斯","亚历克斯"],"、",["l","雷欧","雷欧"],"、",["l","艾米丽","艾米丽"],"、",["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"]]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.6","1.6"],"：加入游戏。"]]]]]]]}