{"s":[[null,1,[["p",["虚空精华是一种",["l","怪物战利品","怪物战利品"],"。可以通过击杀",["l","飞蛇","飞蛇"],"、",["l","暗影狂徒","暗影狂徒"],"、",["l","暗影萨满","暗影萨满"],"、",["l","暗影狙击手","暗影狙击手"],"、",["l","蜘蛛","蜘蛛"],"和",["l","幽灵头骨","幽灵头骨"],"获得。"]],["p",["旅行货车会以 150–1,000金 的价格随机出售。虚空精华也可以每天在",["l","科罗布斯#滚动出售","科罗布斯商店"],"以100金 的价格购买（限 10 个）。当饲养有",["l","虚空鲑鱼","虚空鲑鱼"],"的",["l","鱼塘","鱼塘"],"在数量到达 8 时，每天有 6.3~7.2% 的几率产出 5~10 个虚空精华。"]],["p",["玩家可以在",["l","沙漠商人","沙漠商人"],"处使用 200 个虚空精华交换一个",["l","虚空幽灵吊坠","虚空幽灵吊坠"],"。将它送给",["l","科罗布斯","科罗布斯"],"后可以使科罗布斯以室友的身份住进农舍中，与美人鱼吊坠求婚的用法相似。"]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","法师","法师"]]],[{"h":1,"v":["一般"]},[["l","矮人","矮人"]]],[{"h":1,"v":["不喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"]]]]]]],["收集包",2,[["p",["冒险家的收集包需要 1 个虚空精华（作为可选项）。"]]]],["打造",2,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["配方来源"]},{"h":1,"v":["所需原料"]}],[[["f","Iridium_Band.png",48]],[["l","铱环","铱环"]],["光辉，吸引物品，增加 10% 的攻击伤害。"],["战斗 9 级"],[["i","(O)337","铱锭×5"],["i","(O)768","太阳精华×50"],["i","(O)769","虚空精华×50"]]],[[["f","Mega_Bomb.png",48]],[["l","超级炸弹","超级炸弹"]],["会发生大爆炸。使用时请格外小心。"],["采矿 8 级"],[["i","(O)384","黄金矿石×4"],["i","(O)768","太阳精华×1"],["i","(O)769","虚空精华×1"]]]]]]],["裁制",2,[["p",["虚空精华可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","神秘衣"],"。虚空精华还可用作",["l","染色#染料罐","染料罐"],"和",["l","染色#缝纫机","缝纫机"],"的紫色染料。"]]]],["任务",2,[["l",0,[