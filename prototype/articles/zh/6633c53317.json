{"s":[[null,1,[["p",["芋头块茎是一种种子，播种并生长 10 天成熟后可以获得",["l","芋头","芋头"],"。芋头块茎可以在",["l","姜岛商人","姜岛商人"],"处花费 2 个",["i","(O)881","骨头碎片"],"购买。"]],["p",["芋头块茎也可以通过将芋头放入",["l","种子生产器","种子生产器"],"中获得。打开",["l","金色椰子","金色椰子"],"有 1/7 的概率获得 5 个芋头块茎。除此之外，芋头块茎还可以通过破坏",["l","姜岛#岛屿东部","姜岛丛林"],"的",["l","杂草","杂草"],"、",["l","矿井","危险的矿井"]," 41 层至 69 层内生成的",["l","杂草#特殊杂草","特殊杂草"],"，以及在",["l","姜岛","姜岛"],"上挖掘",["l","远古斑点","远古斑点"],"或使用",["l","淘盘","淘盘"],"淘金获得。击杀",["l","史莱姆#变种","老虎史莱姆"],"或",["l","火山地牢","火山地牢"],"内的",["l","熔岩掘地虫","熔岩掘地虫"],"也有几率会掉落芋头块茎。当饲养有",["l","狮子鱼","狮子鱼"],"的",["l","鱼塘","鱼塘"],"在数量到达 4 时，每天有 4.7 ~ 26.1% 的几率产出 2~5 个芋头块茎。"]],["p",["若将芋头块茎种植在水源附近 3 格内，那么只需要 7 天即可成熟，且不需要浇水。"]]]],["送礼",2,[["t",[[{"h":1,"v":["不喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]]]]]],["地图",2,[["p",["下面显示的是每种",["l","农场#农场地图","农场类型"],"自动灌溉芋头块茎的区域："]],["g",[["Taro_standard_farm.thumb.webp",320,["标准农场"],"Taro_standard_farm.webp"],["Taro_riverland_farm.thumb.webp",320,["河边农场"],"Taro_riverland_farm.webp"],["Taro_forest_farm.thumb.webp",320,["森林农场"],"Taro_forest_farm.webp"],["Taro_hilltop_farm.thumb.webp",320,["山顶农场"],"Taro_hilltop_farm.webp"],["Taro_wilderness_farm.thumb.webp",320,["荒野农场"],"Taro_wilderness_farm.webp"],["Taro_four_corners_farm.thumb.webp",320,["四角农场"],"Taro_four_corners_farm.webp"],["Taro_beach_farm.thumb.webp",320,["海滩农场"],"Tar