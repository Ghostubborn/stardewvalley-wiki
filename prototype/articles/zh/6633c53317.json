{"s":[[null,1,[["p",["芋头块茎是一种种子，成熟后得到",["l","芋头","芋头"],"。"]],["p",["芋头块茎可以通过杀死",["l","火山地牢","火山地牢"],"的",["l","熔岩掘地虫","熔岩掘地虫"],"、",["l","史莱姆（怪物）","老虎史莱姆"],"掉落、打开",["l","金色椰子","金色椰子"],"、在",["l","姜岛商人","姜岛商人"],"处使用2个",["l","骨头碎片","骨头碎片"],"兑换、破坏",["l","姜岛","姜岛丛林"],"的",["l","杂草","杂草"],"掉落、饲养有4条或以上",["l","狮子鱼","狮子鱼"],"的",["l","鱼塘","鱼塘"],"产出、挖掘",["l","姜岛","姜岛"],"的",["l","远古斑点","远古斑点"],"、在",["l","姜岛","姜岛"],["l","淘盘","淘金"],"等途径获得。"]],["p",["在农场的大多数土壤方格上种植的芋头块茎，同其他作物一样需要每天浇水并需要10天成熟。然而，当把芋头块茎种植在距离水源3格内任意方位的地方时（例如",["l","农场池塘","农场池塘"],"或者小河），芋头块茎每天会自动被灌溉（不需要浇水）且只需要7天即可成熟。"]]]],["生长阶段",2,[["t",[[{"h":1,"v":["种植类型"]},{"h":1,"v":["阶段1"]},{"h":1,"v":["阶段2"]},{"h":1,"v":["阶段3"]},{"h":1,"v":["阶段4"]},{"h":1,"v":["收获"]}],[[],[["f","Taro_Stage_1.png",45]],[["f","Taro_Stage_2.png",45]],[["f","Taro_Stage_3.png",45]],[["f","Taro_Stage_4.png",45]],[["f","Taro_Stage_5.png",45]]],[["没有灌溉"],["1 天"],["2 天"],["3 天"],["4 天"],["总计：10天"]],[["有灌溉"],["1 天"],["1 天"],["2 天"],["3 天"],["总计：7 天"]]]]]],["送礼",2,[["t",[[{"h":1,"v":["不喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","山姆","山姆"],"、",["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"]]]]]]],["地图",2,[["p",["下面显示的是每种",["l","农场","农场类型"],"自动灌溉芋头块茎的区域："]],["g",[[null,0,["标准农场"],"Taro_standard_farm.png"],[null,0,["河边农场"],"Taro_riverland_farm.png"],[null,0,["森林农场"],"Taro_forest_farm.png"],[null,0,["山顶农场"],"Taro_hilltop_farm.png"],[null,0,["荒野农场"],"Taro_wilderness_farm.p