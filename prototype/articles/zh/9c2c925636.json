{"s":[[null,1,[["p",["魔法鱼饵是一种",["l","鱼饵","鱼饵"],"，可以使玩家在",["l","钓鱼","钓鱼"],"时无视",["l","季节","季节"],"、",["l","游戏内时间","时间"],"、",["l","天气","天气"],"的限制。可以在",["l","齐先生的核桃房","齐先生的核桃房"],"中花费 5齐钻",["l","齐钻","齐钻"]," 购买20个魔法鱼饵，也可以花费 20齐钻",["l","齐钻","齐钻"]," 购买",["l","打造","打造"],"配方。"]],["p",["与",["l","鱼饵（物品）","普通鱼饵"],"相似，魔法鱼饵也可以使鱼上钩的时间减少50%。"]],["p",["魔法鱼饵也可以在",["l","蟹笼","蟹笼"],"中使用，不过效果与",["l","鱼饵（物品）","普通鱼饵"],"完全相同，但并不会改变产出的",["l","鱼","蟹笼鱼类"],"的种类。"]]]],["用法",2,[["p",["条件：",["l","训练用鱼竿","训练用鱼竿"],"和",["l","竹鱼竿","竹鱼竿"],"不能使用鱼饵。只有",["l","玻璃纤维鱼竿","玻璃纤维鱼竿"],"、",["l","铱金鱼竿","铱金鱼竿"],"和",["l","高级铱金鱼竿","高级铱金鱼竿"],"可以使用鱼饵。"]],["p",["每次抛竿都会消耗一块鱼饵。鱼饵用光时，游戏会弹出一个通知提醒“你已经用掉了最后一块鱼饵”。"]],["p",["键鼠"]],["p",["若要把鱼饵放进鱼竿里，打开背包，鼠标点击鱼饵（左键 左键或 右键 右键，取决于你要放置多少鱼饵），然后 右键 右键鱼竿。"]],["p",["若要移除鱼饵，右键 右键鱼竿。"]],["p",["手柄"]],["p",["在 Xbox 手柄上，按 A 选取一组鱼饵（或按 X 选取单个鱼饵），然后按 X 放在鱼竿上。"]],["p",["在 PS4 手柄上， 按 叉键 选取一组鱼饵（或按 方块键 选取单个鱼饵），然后按 方块键 放在鱼竿上。"]],["p",["在 Nintendo Switch 手柄上，打开背包，按 A 选取一组鱼饵（或按 Y 选取单个鱼饵），然后按 Y 放在鱼竿上。"]],["p",["按手柄上的 叉键（NS 上是 Y）来移除鱼饵。"]],["p",["移动端"]],["p",["对于移动版，若要把鱼饵放进鱼竿里，打开背包并将鱼饵拖到鱼竿上即可。"]]]],["送礼",2,[["t",[[{"h":1,"v":["讨厌"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]]]]]],["钓鱼地点",2,[["g",[["NightMarketMagicBaitArea.png",120,["使用魔法鱼饵时可以钓到",["l","鱼","夜市鱼"],"的区域"]]]],["p",["有关各地点能钓到的",["l","鱼","鱼"],"的种类，请查看：",["l","钓鱼攻略","钓鱼攻略"],"。"]],["p",["只要装备了魔法鱼饵，无论鱼的出现有什么季节、天气或时间的限制，都可以在对应的地点钓起。",["l","鱼","夜市鱼类"],"可以在",["l","沙滩","沙滩"],"的西南角（如右图所示）钓起。",["l","鱼","传说鱼类"],"也可在各自对应的位置使用魔法鱼饵钓起。"]]]],["任务",2,[["p",["魔法鱼饵不被用于任何任务。"]]]]],"f":[["来源",[["l","齐先生的核桃房","齐先生的核桃房"],"：5齐钻"]],["产出",["每次打造产生五个鱼饵"]],["原料",[["i","(O)909","放射性矿石×1"],["i","(O)684","虫肉×3"]]],["售价",["1金"]]]}