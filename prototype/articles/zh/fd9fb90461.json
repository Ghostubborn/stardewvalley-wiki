{"s":[[null,1,[["p",["图腾面具是一种",["l","帽子","帽子"],"，玩家可以在",["l","缝纫机","缝纫机"],"上使用",["l","布料","布料"],"和一个",["l","雨水图腾","雨水图腾"],"、",["l","传送图腾：农场","传送图腾：农场"],"、",["l","传送图腾：山岭","传送图腾：山岭"],"、",["l","传送图腾：海滩","传送图腾：海滩"],"、",["l","传送图腾：沙漠","传送图腾：沙漠"],"、",["l","传送图腾：姜岛","传送图腾：姜岛"],"或",["l","宝藏图腾","宝藏图腾"],"缝制该帽子。男性玩家角色在",["l","沙漠节","沙漠节"],"中进入提供服装服务的小屋，并接受",["l","沙漠节#艾米丽的服装服务","艾米丽的服装服务"],"后，有约 2% 的概率获得带有图腾面具的一套服装。"]]]],["笔记",2,[["l",0,[[1,["带有图腾面具的一套服装还包括 ",["f","Shirt153.png",24]," ",["l","裁缝#上衣","冒充肌肉T恤"],"（染色RGB值249,174,137） 和 ",["f","Shorts.png",24]," ",["l","裁缝#下装","短裤"],"（染色RGB值18,140,23）。"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.4","1.4"],"：加入游戏。"]],[1,[["l","版本历史#1.5","1.5"],"：现在可以使用",["l","传送图腾：姜岛","传送图腾：姜岛"],"作为原料。"]],[1,[["l","版本历史#1.6","1.6"],"：现在可以使用",["l","宝藏图腾","宝藏图腾"],"来制作图腾面具。现在可以作为一套服装的部件从沙漠节随机获得。"]]]]]]]}