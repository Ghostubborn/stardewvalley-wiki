{"s":[[null,1,[["p",["谜之书是一种",["l","书#能力之书","能力之书"],"。可以打开",["l","谜之盒","谜之盒"],"或",["l","金色谜之盒","金色谜之盒"],"获得。在",["l","谜之盒","谜之盒"],"中的出现概率大约 ~1% ，在",["l","金色谜之盒","金色谜之盒"],"中的出现概率大约 ~2%，每打开一个",["l","谜之盒","谜之盒"],"或",["l","金色谜之盒","金色谜之盒"],"，出现概率就会增加 0.04% ，直到出现为止，后续",["l","谜之盒","谜之盒"],"出现的概率将会固定在 ~0.5%，后续",["l","金色谜之盒","金色谜之盒"],"出现的概率将会固定在 ~1%。在玩家打开10个谜之盒或金色谜之盒之前，此书不会从盒子里开出。"]],["p",["阅读这本书可以使玩家在任何能够获得",["l","谜之盒","谜之盒"],"或",["l","金色谜之盒","金色谜之盒"],"（在选择",["l","精通山洞#精通","采集精通"],"后）的情况下的概率提升大约 33.3% 。 并且它会在特殊物品和能力的选项卡上被点亮。再次阅读可以为每项技能提供 20点 经验值。"]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","潘妮","潘妮"],"、",["l","法师","法师"]]],[{"h":1,"v":["喜欢"]},[["l","艾利欧特","艾利欧特"]]],[{"h":1,"v":["一般"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","乔迪","乔迪"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","雷欧","雷欧"]]],[{"h":1,"v":["不喜欢"]},[["l","亚历克斯","亚历克斯"]]]]]]],["收集包",2,[["p",["谜之书不用于任何",["l","收集包","收集包"],"。"]]]],["裁制",2,[["p",["谜之书不用于任何",["l","裁缝","裁缝"],"。可用于",["l","染色","染色"],"。放置在",["l","染色#染料罐","染料罐"],"内时，它可用作蓝色染料。放置在",["l","染色#缝纫机","缝纫机"],"内时，它还可用作蓝色染料。"]]]],["任务",2,[["p",["谜之书不用于任何",["l","任务","任务"],"。"]]]],["交易",2,[["p",["在阅读过谜之书之后，可以在",["l","书摊老板","书摊老板"],"处用一本谜之书，兑换 7 个",["l","谜之盒","谜之盒"],"。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.6","1.6"],"：加入游戏。"]]]]]]],"f":[["来源",[["l","谜之盒","谜之盒"]," · ",["l","金色谜之盒","金色谜之盒"]]],["售价",["3,000金"]]]}