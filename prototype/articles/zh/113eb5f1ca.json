{"s":[[null,1,[["p",["石英是一种",["l","矿物","矿物"],"，可以通过在",["l","矿井","矿井"],"和",["l","骷髅洞穴","骷髅洞穴"],"中",["l","采集","采集"],"获得。翻动",["l","垃圾桶","垃圾桶"],"也有概率找到石英。击杀",["l","石魔","石魔"],"也有 10% 的概率掉落石英。饲养有",["l","鬼鱼","鬼鱼"],"的",["l","鱼塘","鱼塘"],"在数量达到 3 的时候，可能会产出 1 个石英；在数量达到 9 的时候，可能会产出 3 个石英。"]],["p",["生成在地上的石英会被",["l","打造#炸弹","炸弹"],"炸毁，无法再拾取。"]],["p",["可以在沙漠商人处使用 5 个石英交换一个",["l","炸弹","炸弹"],"。"]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","矮人","矮人"],"、",["l","艾米丽","艾米丽"],"、",["l","哈维","哈维"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","罗宾","罗宾"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","威利","威利"],"、",["l","法师","法师"]]],[{"h":1,"v":["不喜欢"]},[["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","艾芙琳","艾芙琳"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","莉亚","莉亚"],"、",["l","莱纳斯","莱纳斯"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","山姆","山姆"],"、",["l","文森特","文森特"]]],[{"h":1,"v":["讨厌"]},[["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","艾利欧特","艾利欧特"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","刘易斯","刘易斯"],"、",["l","谢恩","谢恩"]]]]]]],["收集包",2,[["p",["地理学家的收集包需要 1 个石英"]]]],["配方",2,[["p",["石英不用于任何",["l","打造#可打造物品","配方"],"。"]]]],["熔炼",2,[["p",["把1个石英和1个",["l","煤炭","煤炭"],"放进",["l","熔炉","熔炉"],"里可以产生",["l","精炼石英","精炼石英"],", 需耗费游戏内1.5小时。每次熔炼操作都需要一个单位的煤，不管是什么材料或持续时间。"]],["t",[[{"h":1,"v":["原料"]},{"h":1,"v":["设备"]},{"h":1,"v":["熔炼加工时间"]},{"h":1,"v":["产品"]}],[[["i","(O)80","石英×1"],["i","(O)382","煤炭×1"]],[["f","Furnace.png",48],["l","熔炉","熔炉"]],["1.5 小时"],[["i","(O)338","精炼石英×1"]]]]]]],["裁制",2,[["p",["石英可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","灰色背心"],"。石英可用于",["l","染色","染色"],"。放置在",["l","染色#缝纫机","缝纫机"],"内时，石英可用作白色染料。"]]]],["任务",2,[["l",0,[[1,["石英会在任意季节出现在",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"外边的",["l","任务#求助任务","“布告栏”"],"上，任务完成的奖励是 75金 和 150 ",["l","友谊","友谊点"],"。"]],[1,["饲养有",["l","鬼鱼","鬼鱼"],"的",["l","鱼塘","鱼塘"],"在数量从1提升到3的时候，会出现要求玩家提供五个石英的",["l","鱼塘#任务","求助任务"],"。"]],[1,["饲养有",["l","螃蟹","螃蟹"],"、",["l","鸟蛤","鸟蛤"],"、",["l","龙虾","龙虾"],"、",["l","蚌","蚌"],"、",["l","牡蛎","牡蛎"],"或",["l","虾","虾"],"的",["l","鱼塘","鱼塘"],"在数量从5提升到7的时候，会出现要求玩家提供五个石英的",["l","鱼塘#任务","求助任务"],"。"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.4#1.4","1.4"],"：现在在裁缝中可用。现在可出现在鱼塘的任务中。现在可由鱼塘产出。"]]]]]]]}