{"s":[[null,1,[["p",["海之宝石是一本可以从",["l","钓鱼#钓鱼宝箱","钓鱼宝箱"],"中获得的",["l","书#能力之书","能力之书"],"。宝箱中包含这本书的概率从2%开始，每打开一个宝箱概率就会增加0.1%，直到玩家第一次获得为止。然后宝箱开出这本书的概率永久保持在2.1%。"]],["p",["从第3年开始，玩家也可以用20,000金从",["l","书摊老板","书摊老板"],"处购买这本书（出现概率 ~9%）。"]],["p",["首次阅读后，玩家将获得一种能力，使所有",["l","钓鱼#钓鱼宝箱","钓鱼宝箱"],"都有25%的几率获得鱼籽。并且它会在特殊物品和能力的选项卡上被点亮。再次阅读可以提供 100点 ",["f","Fishing_Skill_Icon.png",20]," ",["l","技能#钓鱼","钓鱼经验值"],"。"]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","潘妮","潘妮"],"、",["l","威利","威利"]]],[{"h":1,"v":["喜欢"]},[["l","艾利欧特","艾利欧特"]]],[{"h":1,"v":["一般"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","乔迪","乔迪"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","科罗布斯","科罗布斯"],"、",["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","雷欧","雷欧"]]],[{"h":1,"v":["不喜欢"]},[["l","亚历克斯","亚历克斯"]]]]]]],["趣闻",2,[["p",["获得这本书的能力之后，有概率在",["l","鱿鱼","鱿鱼"],"和",["l","午夜鱿鱼","午夜鱿鱼"],"这种养殖在",["l","鱼塘","鱼塘"],"不会产出鱼籽的海洋生物的",["l","钓鱼#钓鱼宝箱","钓鱼宝箱"],"中，获得其对应的",["l","鱼籽","鱼籽"],"。"]]]],["收集包",2,[["p",["海之宝石不用于任何",["l","收集包","收集包"],"。"]]]],["裁制",2,[["p",["海之宝石不用于任何",["l","裁缝","裁缝"],"。可用于",["l","染色","染色"],"。放置在",["l","染色#染料罐","染料罐"],"内时，它可用作橙色染料。放置在",["l","染色#缝纫机","缝纫机"],"内时，它还可用作橙色染料。"]]]],["任务",2,[["p",["海之宝石不用于任何",["l","任务","任务"],"。"]]]],["交易",2,[["p",["在阅读过海之宝石之后，可以在",["l","书摊老板","书摊老板"],"处用一本海之宝石，兑换 3 个",["l","洞穴凝胶","洞穴凝胶"],"、3 个",["l","河凝胶","河凝胶"],"或 3 个",["l","海凝胶","海凝胶"],"。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.6","1.6"],"：加入游戏。"]]]]]]],"f":[["来源",[["l","钓鱼#宝箱","钓鱼宝箱"]," · ",["l","书摊老板","书摊老板"]]],["售价",["800金"]]]}