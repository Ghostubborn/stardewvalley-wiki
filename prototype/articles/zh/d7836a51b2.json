{"s":[[null,1,[["p",["蔓越莓种子是一种种子，成熟的植株可以产出",["l","蔓越莓","蔓越莓"],"。"]],["p",["蔓越莓种子可以在",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"、",["l","Joja超市","Joja超市"],"、冬季17日的",["l","夜市","魔法商船"],"或者",["l","旅行货车","旅行货车"],"（偶尔出现）购买获得。同样地，玩家可以使用",["l","种子生产器","种子生产器"],"制作蔓越莓种子。"]],["p",["收获时，每株蔓越莓植株可以产出两个蔓越莓，每次成熟的间隔时间是5天。一株蔓越莓有10%概率多收获1个或1个以上蔓越莓(平均增加0.11个)"]]]],["生长阶段",2,[["t",[[{"h":1,"v":["阶段 1"]},{"h":1,"v":["阶段 2"]},{"h":1,"v":["阶段 3"]},{"h":1,"v":["阶段 4"]},{"h":1,"v":["阶段 5"]},{"c":2,"h":1,"v":["收获"]}],[[["f","Cranberry_Stage_1.png",45]],[["f","Cranberry_Stage_2.png",45]],[["f","Cranberry_Stage_3.png",45]],[["f","Cranberry_Stage_4.png",45]],[["f","Cranberry_Stage_5.png",50]],[["f","Cranberry_Stage_6.png",50]],[["f","Cranberry_Stage_7.png",48]]],[["1 天"],["2 天"],["1 天"],["1 天"],["2 天"],["总计:\n7 天"],["可持续收割\n每次间隔5天"]]]]]],["送礼",2,[["t",[[{"h":1,"v":["不喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]]]]]]]}