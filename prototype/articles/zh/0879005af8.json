{"s":[[null,1,[["p",["蛇齿单线鱼是一种",["l","鱼","鱼"],"，可以在",["l","冬季","冬季"],"的河流和",["l","深山","深山湖泊"],"钓到。"]],["p",["旅行货车会以 360–1,000金 的价格随机出售。蛇尺单线鱼也有可能在每周的星期三随机出现在",["l","科罗布斯#滚动出售","科罗布斯商店"],"中，售价为200金。",["l","宠物","宠物"],"猫达到最大",["l","宠物#好感度","好感度"],"后，每天第一次被抚摸也有可能掉落蛇齿单线鱼。"]],["p",["可以使用",["l","魔法鱼饵","魔法鱼饵"],"不受季节的限制钓到蛇齿单线鱼。"]],["p",["蛇尺单线鱼在鹈鹕镇和深山的上钩概率显著高于煤矿森林河流。在鹈鹕镇和深山湖泊钓到蛇尺单线鱼的概率大约在 12.0~17.8% 之间。"]]]],["地图",2,[["p",["蛇齿单线鱼可以在河流和深山湖泊中钓到。"]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","威利","威利"]]],[{"h":1,"v":["一般"]},[["l","德米特里厄斯","德米特里厄斯"],"、",["l","艾利欧特","艾利欧特"],"、",["l","雷欧","雷欧"],"、",["l","莱纳斯","莱纳斯"],"、",["l","潘姆","潘姆"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"]]],[{"h":1,"v":["不喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","矮人","矮人"],"、",["l","艾米丽","艾米丽"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","刘易斯","刘易斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘妮","潘妮"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","法师","法师"]]],[{"h":1,"v":["讨厌"]},[["l","艾芙琳","艾芙琳"],"、",["l","海莉","海莉"],"、",["l","皮埃尔","皮埃尔"]]]]]]],["收集包",2,[["p",["蛇齿单线鱼不用于任何",["l","收集包","收集包"],"。"]]]],["食谱",2,[["t",[[{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["所需原料"]},{"h":1,"v":["能量 / 生命值"]},{"h":1,"v":["增益效果"]},{"h":1,"v":["增益时长"]},{"h":1,"v":["食谱来源"]},{"h":1,"v":["售出价格"]}],[[["l","生鱼片","生鱼片"]],["切成薄片的生鱼。"],[["f","Fish.png",24]," 任意",["l","鱼","鱼"],"（1）"],["能量 75\n生命值 33"],["无"],["无"],[["l","莱纳斯","莱纳斯"],"（邮件 - 3+ ❤）"],["75金"]],[[["l","生鱼寿司","生鱼寿司"]],["紫菜裹着的鱼和米饭。"],[["f","Fish.png",24]," 任意",["l","鱼","鱼"],"（1） ",["i","(O)152","海草×1"],["i","(O)423","大米×1"]],["能量 100\n生命值 45"],["无"],["无"],["*烹饪频道（奇数年夏季 21 日） *",["l","星之果实酒吧","星之果实酒吧"],"以300金 购买"],["220金"]]]]]],["打造",2,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["配方来源"]},{"h":1,"v":[