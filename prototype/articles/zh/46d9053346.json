{"s":[[null,1,[["p",["香蕉树苗是一种",["l","果树","果树"],"树苗。种下并生长 28 天可以长成",["l","香蕉树","香蕉树"],"。香蕉树苗可以在",["l","姜岛商人","姜岛商人"],"处花费 5 个",["i","(O)852","龙牙"],"购买。在星露谷",["l","农场","农场"],"时，香蕉树只会在",["l","夏季","夏季"],"结果，若种植在",["l","温室","温室"],"里或",["l","姜岛西部#姜岛农场","姜岛农场"],"上则会全年结果。"]],["p",["向",["l","岛屿办事处","岛屿办事处"],"捐赠整套巨大动物的化石后，可以获得 1 个香蕉树苗作为捐赠奖励。打开",["l","金色椰子","金色椰子"],"有 1/7 的概率获得 1 个香蕉树苗。",["l","沙漠节","沙漠节"],"期间，",["l","雷欧","雷欧"],"也会在其",["l","沙漠节#村民商铺","商铺"],"以100卡利科蛋 ",["l","卡利科三花蛋","卡利科三花蛋"],"的价格出售香蕉树苗（限 1 个）。"]]]],["送礼",2,[["t",[[{"h":1,"v":["不喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.5#1.5","1.5"],"：加入游戏。"]],[1,[["l","版本历史#1.6","1.6"],"：可以在",["l","沙漠节","沙漠节"],"期间购买。现在砍倒一个果树会产出相应的树苗。如果树是成熟的（即果实品质>基础），它会产出一个与其果实相同品质的树苗。品质越高，果树成熟得越快。"]]]]]]]}