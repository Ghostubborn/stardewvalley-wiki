{"s":[[null,1,[["p",["香蕉树苗是一种",["l","果树","果树"],"幼苗。种下后经28天生长可以长成",["l","香蕉树","香蕉树"],"。香蕉树在",["l","夏季","夏季"],"每一天都会结出一个香蕉。像其他果树一样，如果种植在",["l","温室","温室"],"里或",["l","姜岛","姜岛"],"上，它会全年结果。"]],["p",["玩家可以在",["l","姜岛商人","姜岛商人"],"处用5个",["l","龙牙","龙牙"],"交换一个香蕉树苗。敲开",["l","金色椰子","金色椰子"],"也有几率获得香蕉树苗。完成",["l","岛屿办事处","岛屿办事处"],"的巨大动物化石收集后，玩家可以从",["l","蜗牛教授","蜗牛教授"],"处领取1个香蕉树苗。",["l","沙漠节","沙漠节"],"期间，",["l","雷欧","雷欧"],"会在其",["l","沙漠节","商铺"],"以100卡利科蛋 ",["l","卡利科三花蛋","卡利科三花蛋"],"的价格出售香蕉树苗（限1个）。"]]]],["生长阶段",2,[["t",[[{"h":1,"v":["阶段 1"]},{"h":1,"v":["阶段 2"]},{"h":1,"v":["阶段 3"]},{"h":1,"v":["阶段 4"]},{"h":1,"v":["阶段 5 - 春季，夏季，秋季，冬季"]},{"h":1,"v":["收成"]}],[[["f","Banana_Stage_1.png",100]],[["f","Banana_Stage_2.png",100]],[["f","Banana_Stage_3.png",100]],[["f","Banana_Stage_4.png",100]],[["f","Banana_Stage_5.png",384]],[["f","Banana_Stage_5_Fruit.png",96]]],[["7 天"],["7 天"],["7 天"],["7 天"],["总计: 28 天"],["夏季"]]]]]],["送礼",2,[["t",[[{"h":1,"v":["不喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","雷欧","雷欧"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"]]]]]]]]}