{"s":[[null,1,[["p",["毛线帽是一顶",["l","帽子","帽子"],"，可以在",["l","缝纫机","缝纫机"],"上使用",["l","布料","布料"],"和",["l","橡子","橡子"],"、",["l","桃花心木种子","桃花心木种子"],"、",["l","枫树种子","枫树种子"],"或",["l","松果","松果"],"裁制获得。此外，男性玩家角色在",["l","沙漠节","沙漠节"],"中接受",["l","沙漠节#艾米丽的服装服务","艾米丽的服装服务"],"后，有约 2.13% 的概率获得带有毛线帽的一套服装。"]],["p",["这顶帽子还有小概率通过以下方式获得：击杀",["l","怪物","怪物"],"、打破矿井内的",["l","矿井#木箱和木桶","木箱和木桶"],"、摇晃或砍伐",["l","树","树"],"、使用",["l","锄头","锄头"],"挖掘",["l","远古斑点","远古斑点"],"、",["l","淘盘","淘金"],"。"]]]],["备注",2,[["l",false,[[1,["带有毛线帽的一套服装还包括  骷髅T恤 和  农夫裤（染色RGB值 40,40,40）。"]]]]]],["历史",2,[["l",false,[[1,["1.4：加入游戏。"]],[1,["1.5：现在可以使用桃花心木种子缝制而成。"]],[1,["1.6：现在可以作为一套服装的部件从沙漠节随机获得。现在有小概率通过玩家的多种行为活动获得。"]]]]]]]}