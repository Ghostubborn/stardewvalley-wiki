{"s":[[null,1,[["p",["毛线帽是一种",["l","帽子","帽子"],"，可以在",["l","缝纫机","缝纫机"],"上使用",["l","布料","布料"],"和一个",["l","橡子","橡子"],"、",["l","桃花心木种子","桃花心木种子"],"、",["l","枫树种子","枫树种子"],"或",["l","松果","松果"],"缝制而成。男性玩家角色在",["l","沙漠节","沙漠节"],"中进入提供服装服务的小屋，并接受",["l","沙漠节#艾米丽的服装服务","艾米丽的服装服务"],"后，有约 2% 的概率获得带有毛线帽的一套服装。"]],["p",["这顶帽子还有小概率通过以下方式获得：击杀",["l","怪物","怪物"],"；",["l","矿井#木箱和木桶","打破木箱和木桶"],"；砍",["l","树","树"],"；摇晃树木；挖掘",["l","远古斑点","远古斑点"],"；",["l","淘盘","淘金"],"。"]]]],["备注",2,[["l",0,[[1,["带有毛线帽的一套服装还包括 ",["f","Shirt004.png",24]," ",["l","裁缝#上衣","骷髅T恤"]," 和 ",["f","Farmer_Pants.png",24]," ",["l","裁缝#下装","农夫裤"],"（染色RGB值 40,40,40）。"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.4","1.4"],"：加入游戏。"]],[1,[["l","版本历史#1.5","1.5"],"：现在可以使用",["l","桃花心木种子","桃花心木种子"],"缝制而成。"]],[1,[["l","版本历史#1.6","1.6"],"：现在可以作为一套服装的部件从",["l","沙漠节","沙漠节"],"随机获得。现在有小概率通过玩家的多种行为活动获得。"]]]]]]]}