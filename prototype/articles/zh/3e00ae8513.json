{"s":[[null,1,[["p",["安全帽是一种",["l","帽子","帽子"],"，完成",["l","探险家公会#Duggy","杀死30只掘地虫的目标"],"后可前往",["l","探险家公会","探险家公会"],"向",["l","吉尔","吉尔"],"领取，此后可以以20,000金的价格从",["l","探险家公会","探险家公会"],"购买。男性玩家角色在",["l","沙漠节","沙漠节"],"中进入提供服装服务的小屋，并接受",["l","沙漠节#艾米丽的服装服务","艾米丽的服装服务"],"后，有约 2% 的概率获得带有安全帽的一套服装。"]]]],["备注",2,[["l",0,[[1,["带有安全帽的一套服装还包括 ",["f","Shirt256.png",24]," ",["l","裁缝#上衣","油渍上衣"]," 和 ",["f","Relaxed_Fit_Pants.png",24]," ",["l","裁缝#下装","休闲裤"],"（染色RGB值 99,132,96）。"]]]]]],["漏洞",2,[["l",0,[[1,["当玩家的角色朝向侧面时，某些发型会导致头发在帽子后面，也就是在帽子外面显现。"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.0","1.0"],"：加入游戏。"]],[1,[["l","版本历史#1.6","1.6"],"：现在可以作为一套服装的部件从沙漠节随机获得。"]]]]]]]}