{"s":[[null,1,[["p",["顶级保湿土壤是一种可以让土壤保持湿润的",["l","保湿土壤","保湿土壤"],"。顶级保湿土壤能够在",["l","姜岛商人","姜岛商人"],"以",["i","(O)848","火山晶石×50"],"购买制造配方后通过",["l","打造","打造"],"获得，破坏",["l","矿井","危险的矿井"],"里或",["l","骷髅洞穴","危险的骷髅洞穴"],"里的木桶也有极小的概率（0.23%）掉落一个顶级保湿土壤。"]],["p",["顶级保湿土壤可以在作物播种前后以及生长的任何阶段添加到犁过的土壤中。保湿的几率是 100%，这意味着一次浇水就可以使土壤永久保持湿润，这在",["l","洒水器","洒水器"],"不能工作的地方特别有用，如",["l","花盆","花盆"],"和海滩农场。"]]]],["送礼",2,[["t",[[{"h":1,"v":["不喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]]]]]],["任务",2,[["p",["顶级保湿土壤不用于任何",["l","任务","任务"],"。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.5#1.5","1.5"],"：加入游戏。"]]]]]]],"f":[["来源",[["l","打造","打造"]]],["原料",[["i","(O)390","石头×5"],["i","(O)771","纤维×3"],["i","(O)330","粘土×1"]]],["售价",["30金"]]]}