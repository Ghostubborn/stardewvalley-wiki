{"s":[[null,1,[["p",["怪物分布在",["l","矿井","矿井"],"、",["l","骷髅洞穴","骷髅洞穴"],"、",["l","突变虫穴","突变虫穴"],"、",["l","采石场","采石场"],"、",["l","火山地牢","火山地牢"],"以及特定选项的",["l","农场","农场"],"。怪物会攻击",["l","玩家角色","玩家"],"，使其失去",["l","生命值","生命值"],"。杀死怪物后，怪物有几率掉落",["l","怪物战利品","怪物战利品"],"和其他物品。击杀怪物可提升玩家的",["l","战斗","战斗"],"经验和等级。"]],["p",["在喝下",["l","怪兽香水","怪兽香水"],"后，将会使",["l","矿井","矿井"],"、",["l","骷髅洞穴","骷髅洞穴"],"或",["l","火山地牢","火山地牢"],"的怪物数量翻倍。在喝下",["l","蒜油","蒜油"],"以后，",["l","矿井","矿井"],"将不会再刷新怪物。"]]]],["农场里的怪物",2,[["p",["晚上可以在",["l","农场","农场"],"找到怪物，怪物种类取决于农场类型。在",["l","农场地图#Wilderness","荒野农场"],"中，怪物刷新默认为“打开”，或者在创建新游戏时选择",["l","选项","高级选项"],"“在农场生成怪物”（注意，怪物的生成与荒野农场无异，同样会随着战斗等级增长而增加怪物种类）。在",["l","女巫小屋","女巫小屋"],"中向",["l","夜惊之黑暗神殿","夜惊之黑暗神殿"],"献祭",["l","奇怪的小面包","奇怪的小面包"],"会打开/关闭农场怪物刷新。"]],["p",[["l","农场","农场"],"中的怪物种类会随着玩家的",["l","战斗","战斗等级"],"而扩展。（在更高的等级中，将生成更难对付的怪物，并且",["l","荒野石魔","荒野石魔"],"变得更加难以杀死）"]],["p",["无论是否启用农场怪物刷新，",["l","猪","猪"],"挖出的",["l","松露","松露"],"都有0.2%的概率变成",["l","松露蟹","松露蟹"],"。"]]]],["危险怪物",2,[["p",[["l","矿井","矿井"],"和",["l","骷髅洞穴","骷髅洞穴"],"中的怪物在任务",["l","任务#Danger In The Deep","“深处的危险”"],"和",["l","任务#Skull Cavern Invasion","“骷髅洞穴入侵”"],"中变得更加危险，在",["l","矿井#挑战之神庙","挑战之神庙"],"切换到“开启”位置时亦然。"]],["p",["与普通怪物相比，危险的怪物具有独特的贴图和统计数据。",["l","腐臭幽灵","腐臭幽灵"],"、",["l","骷髅法师","骷髅法师"],"和",["l","暗影狙击手","暗影狙击手"],"也具有独特的",["l","效果#敌对生物效果","敌对生物效果"],"。"]]]],["怪物列表",2,[["t",[[{"c":5,"h":1,"v":[["l","矿井","矿井"]]}],[{"h":1,"v":["所有层"]},{"h":1,"v":["1-29层"]},{"h":1,"v":["31-39层"]},{"h":1,"v":["41-79层"]},{"h":1,"v":["81-119层"]}],[[["l","史莱姆（怪物）","绿色史莱姆"]],[["l","臭虫","臭虫"],["l","苍蝇","苍蝇"],["l","掘地虫","掘地虫"],["l","蛆","蛆"],["l","岩石蟹","岩石蟹"]],[["l","蝙蝠","蝙蝠"],["l","臭虫","臭虫"],["l","石魔","石魔"]],[["l","灰尘精灵","灰尘精灵"],"冰冻蝙蝠蓝色史莱姆",["l","幽灵","幽灵"],["i","(F)1304","骷髅"]],["熔岩蝙蝠",["l","熔岩蟹","熔岩蟹"],["l","金属大头","金属大头"],"红色史莱姆",["l","暗影狂徒","暗影狂徒"],["l","暗影萨满","暗影萨满"],["l","鱿鱼娃","鱿鱼娃"]]]]],["t",[[{"h":1,"v":[["l","骷髅洞穴","骷髅洞穴"]]},{"h":1,"v":[["l","采石场矿井","采石场矿井"]]},{"h":1,"v":[["l","突变虫穴","突变虫穴"]]},{"h":1,"v":[["l","火山地牢","火山地牢"]]}