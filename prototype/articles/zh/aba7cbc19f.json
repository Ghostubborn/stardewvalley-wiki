{"s":[[null,1,[["p",["鹦鹉蛋是一种",["l","饰品","饰品"],"，可通过在",["l","矿井","矿井"],"、",["l","骷髅洞穴","骷髅洞穴"],"或",["l","采石场矿井","采石场矿井"],"中击杀",["l","怪物","怪物"],"或打碎",["l","矿井","木箱和木桶"],"获得。这两种方法的掉落几率都会受到",["l","运气","每日运气"],"和",["l","运气","增益效果"],"等因素的影响。",["l","窃贼戒指","窃贼戒指"],"和",["l","怪物图鉴","怪物图鉴"],"不会影响从",["l","怪物","怪物"],"那里获得",["l","饰品","饰品"],"的几率。从",["l","骷髅洞穴","骷髅洞穴"],"的",["l","骷髅洞穴","宝箱"],"获得鹦鹉蛋的几率约为0.6%。"]],["p",["将鹦鹉蛋装备在饰品栏会召唤一只跟随你的鹦鹉。鹦鹉在击杀",["l","怪物","怪物"],"时有Y的几率会掉落金币，每枚金币价值250金。",["l","怪物","怪物"],"掉落金币的几率（“Y”）取决于鹦鹉的等级（“X”），从1到4之间。",["l","怪物","怪物"],"每掉落一枚金币，就有可能再一次投下一枚金币。掉落金币的几率和数量不受",["l","运气","运气"],"、",["l","怪物","怪物类型"],"、地点、",["l","窃贼戒指","窃贼戒指"],"或",["l","怪物图鉴","怪物图鉴"],"的影响。"]]]],["级别",2,[["p",["当鹦鹉蛋掉落时，其等级在1到4之间，限制取决于",["l","玩家角色","玩家"],"的总收入。一旦",["l","玩家角色","玩家"],"达到收入阈值，每个可能的等级的概率是相同的（“例如”，如果",["l","玩家角色","玩家"],"的收入在750,000金到1,500,000金之间，则有50%的几率获得2级鹦鹉）。如果消耗3个",["l","铱锭","铱锭"],"在",["l","铁砧","铁砧"],"上重铸，鹦鹉蛋的等级将可以是1-4之间的任意一个（计入玩家的收入）。"]],["t",[[{"h":1,"v":["等级"]},{"h":1,"v":["金币掉落概率"]},{"h":1,"v":["平均掉落金币"]},{"h":1,"v":["平均收益"]},{"h":1,"v":["最低总收入"]}],[["1"],["10%"],["0.11"],["27.78"],["0金"]],[["2"],["20%"],["0.25"],["62.50"],["750,000金"]],[["3"],["30%"],["0.43"],["107.14"],["1,500,000金"]],[["4"],["40%"],["0.67"],["166.67"],["2,250,000金"]]]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","雷欧","雷欧"],"、",["l","艾米丽","艾米丽"]]],[{"h":1,"v":["喜欢"]},[["l","亚历克斯","亚历克斯"],"、",["l","法师","法师"]]],[{"h":1,"v":["不喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"]]]]]]],["提示",2,[["l",0,[[1,["如果玩家在与",["l","姜岛","姜岛海盗湾"],"上的海盗调酒师对话时装备了鹦鹉蛋，他会送你一瓶",["l","蜜蜂酒","蜜蜂酒"],"（每天只能触发一次）。"]],[1,["在面对大量",["l","怪物","怪物"],"时，鹦鹉蛋的收益很高，因为每个",["l","怪物","怪物"],"都会单独计算金币，比如",["l","骷髅洞穴","骷髅洞穴"],"中的",["l","史莱姆（怪物）","史莱姆"],"或",["l","灰尘精灵","灰尘精灵"],"。玩家可以搭配",["l","怪兽香水","怪兽香水"],"来大大提高鹦鹉蛋的收益。"]]]]]],["趣闻",2,[["l",0,[[1,["如果",["l","玩家角色","玩家"],"静止不动，且刚好在鹦鹉正下方时，鹦鹉就会停止飞行并站在",["l","玩家角色","玩家"],"头顶上。"]],[1,["如果玩家携带了“鹦鹉蛋”进入了",["l","电影院","电影院"],"中的放映厅，那么鹦鹉还会在电影途中鸣叫（也许应该从饰品栏上拿下来）。"]],[1,["鹦鹉偶尔也发出和",["l","姜岛","姜岛鹦鹉"],"一样的叫声，鹦鹉站在",["l","玩家角色","玩家"],"头顶时鸣叫有独特的动画，鹦鹉在",["l","玩家角色","玩家闲置"],"、",["l","钓鱼","钓鱼"],"甚至是游戏处于暂停时都可以鸣叫。"]],[1,["鹦鹉蛋可以作为",["l","艾米丽","艾米丽"],"最爱的礼物送给她，同时，也可以作为",["l","亚历克斯","亚历克斯"],"喜欢的礼物。",["l","艾米丽","艾米丽"],"表示会好好照顾它，而",["l","亚历克斯","亚历克斯"],"犹豫之后表示可以试试吃掉它。"]]]]]],["漏洞",2,[["l",0,[[1,["如果玩家的总收入低于750,000金，那么玩家只能获得1级的鹦鹉蛋，并且如果玩家尝试使用",["l","铁砧","铁砧"],"重新锻造其等级并不会发生变化，这样做仍会消耗3个",["l","铱锭","铱锭"],"。"]]]]]]]}