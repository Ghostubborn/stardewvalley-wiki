{"s":[[null,1,[["p",["黄金马刺是一种",["l","饰品","饰品"],"，可以通过在",["l","矿井","矿井"],"、",["l","骷髅洞穴","骷髅洞穴"],"或",["l","采石场矿井","采石场矿井"],"中杀死",["l","怪物","怪物"],"或打碎",["l","矿井","木箱和木桶"],"来获得。这两种方法的掉落几率都会受到",["l","运气","每日运气"],"和",["l","运气","运气增益"],"等因素的影响。",["l","窃贼戒指","窃贼戒指"],"和",["l","怪物图鉴","怪物图鉴"],"不会影响从",["l","怪物","怪物"],"那里获得黄金马刺的几率。从",["l","骷髅洞穴","骷髅洞穴"],"中的",["l","骷髅洞穴","宝箱"],"获得黄金马刺的几率约为0.6%。"]],["p",["当黄金马刺装备在饰品槽中，玩家每次",["l","暴击力量","暴击"],"时，都会获得一个短暂的",["l","速度","速度（+1）"],"增益。速度提升的持续时间范围为5到10秒，此时间确定为秒。掉落的六个时间概率的值是相等的，如果在",["l","铁砧","铁砧"],"上重新锻造饰品，则可以更改持续时间。"]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","法师","法师"]]],[{"h":1,"v":["不喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"]]]]]]],["趣闻",2,[["p",["最开始黄金马刺被命名为“Iridium Spur（铱马刺）”。"]]]]]}