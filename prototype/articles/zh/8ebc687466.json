{"s":[[null,1,[["p",["金色的鸡是一种农场",["l","动物","动物"],"，至少升级到",["l","鸡舍","大鸡舍"],"后才可饲养。金鸡通过使用",["l","孵化器","孵化器"],"孵化",["l","金蛋","金蛋"],"而来。孵化需要9,000分钟（即5天16小时40分钟）。如果玩家选择了",["l","耕种#耕种技能","鸡舍大师"],"职业，则只需4,500分钟（即2天21小时40分钟）。"]]]],["产品",2,[["n",["主条目：",["l","动物#产出","动物"]]],["p",["如果一只幼年的金鸡每天都得到喂食，孵化三天后它会长大。每只得到喂食的成年金鸡会每天产出一个",["l","金蛋","金蛋"],"。金蛋可以放进",["l","孵化器","孵化器"],"中孵化，或者以500金的价格售出。"]],["p",["将一个",["l","金蛋","金蛋"],"放入",["l","蛋黄酱机","蛋黄酱机"],"可以产出三个金星的",["l","蛋黄酱","蛋黄酱"],"。"]],["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["售价"]}],[[["f","Golden_Egg.png",48]],[["l","金蛋","金蛋"]],["非常独特、罕见的蛋，金色的蛋壳非常坚固。"],["500金"]]]]]],["出售",2,[["p",["金鸡的出售与普通",["l","鸡","鸡"],"相同。友谊值越高，售价越高。出售一只新生的金鸡可获得252金，出售一只满心的金鸡可获得1,040金。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.5","1.5"],"：加入游戏。"]]]]]]]}