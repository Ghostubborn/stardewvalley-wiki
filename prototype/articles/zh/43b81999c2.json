{"s":[[null,1,[["p",["蜂蜜是一种由",["l","蜂房","蜂房"],"每4天产出的",["l","工匠物品","工匠物品"],"，",["l","冬季","冬季"],"除外。也可以每周五在",["l","绿洲","绿洲"],"以200金购买。在蜂房附近种植花，成熟后的花会影响蜂房产出对应的花蜜，并且提高蜂蜜的价格。花蜜不会消耗花，且一株花可以影响到多个蜂房。"]],["p",["如果蜂房附近没有种植花，或是蜂房在生产出花蜜前将花收获，那么蜂房只会产出“野蜂蜜”（游戏内显示为“野外”），是最基础的蜂蜜。同理，如果将可收获花蜜的蜂房使用",["l","工具","工具"],"拆除，那么玩家会收获一瓶“蜂蜜”，其性质与“野蜂蜜”是相同的。从",["l","绿洲","绿洲"],"或",["l","旅行货车","旅行货车"],"买到的同样也写为“蜂蜜”，用处售价都与野蜂蜜相同。"]],["p",["蜂蜜可放入",["l","小桶","小桶"],"中制作",["l","蜜蜂酒","蜜蜂酒"],"。"]]]],["售价",2,[["p",["以下没有列出的",["l","花","花"],"（例如，",["l","番红花","番红花"],"和",["l","甜豌豆","甜豌豆"],"）不会影响蜂蜜的价格。",["l","黄水仙","黄水仙"],"和",["l","蒲公英","蒲公英"],"在游戏中被分类为“采集品”而不是“花”，因此它们也不会影响蜂蜜的价格。"]],["p",["计算蜂蜜售价的公式为 基础蜂蜜售价 + (花的基础售价 × 2)."]],["t",[[{"h":1,"v":["花蜜"]},{"h":1,"v":["花的季节"]},{"h":1,"v":["花的生长周期"]},{"h":1,"v":["蜂蜜售价"]},{"h":1,"v":["工匠专精\n售价 (+40%)"]}],[["不适用（野蜂蜜）"],["春季 \n 夏季 \n 秋季"],["不适用"],["100金"],["140金"]],[[["i","(O)591","郁金香"]],["春季"],["6天"],["160金"],["224金"]],[[["i","(O)597","蓝爵"]],["春季"],["7天"],["200金"],["280金"]],[[["i","(O)593","夏季亮片"]],["夏季"],["8天"],["280金"],["392金"]],[[["i","(O)376","虞美人花"]],["夏季"],["7天"],["380金"],["532金"]],[[["i","(O)421","向日葵"]],["夏季 \n 秋季"],["8天"],["260金"],["364金"]],[[["i","(O)595","玫瑰仙子"]],["秋季"],["12天"],["680金"],["952金"]]]]]],["范围",2,[["p",["蜂房周围5格内的花可以影响产出的花蜜。"]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","雷欧","雷欧"]]],[{"h":1,"v":["讨厌"]},[["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"]]]]]]],["收集包",2,[["p",["用于工匠收集包。"]]]],["配方",2,[["t",[[{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["所需原料"]},{"h":1,"v":["配方来源"]},{"h":1,"v":["售出价格"]}]]]]],["裁制",2,[["p",["蜂蜜可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成可染色的 ",["i","(P)11","简单长裙"],"。蜂蜜可用于",["l","染色","染色"],"。放置在",["l","染色","缝纫机"],"内时，蜂蜜可用作黄色染料。"]]]],["工匠物品",2,[["p",["蜂蜜可以放入",["l","小桶","小桶"],"中制成",["l","蜜蜂酒","蜜蜂酒"],"。蜜蜂酒可以放入",["l","木桶","木桶"],"中发酵以提升品质。"]],["t",[[{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["材料"]},{"h":1,"v":["制作来源"]}],[[["l","蜜蜂酒","蜜蜂酒"]],["蜂蜜制成的发酵饮料。适度饮用。"],[["l","蜂蜜","蜂蜜×1"]],[["i","(BC)12","小桶"]]]]]]],["任务",2,[["p",["某些",["l","鱼塘","鱼塘"],"任务可能会需要一个蜂蜜。"]]]],["趣闻",2,[["p",["虽然1.6的游戏代码中出现了",["l","甜豌豆","甜豌豆"],"蜂蜜和",["l","番红花","番红花"],"蜂蜜，但这两种蜂蜜并不能在游戏中使用蜂房正常获取。"]]]],["提示",2,[["p",["采集蜂蜜前，物品栏仅留一格空位是有好处的。这样采到的蜂蜜将会填满最后一格，以防误采用于制作花蜜的花朵。"]]]]],"f":[["来源",[["l","工匠物品","工匠物品"]," • ",["l","绿洲","绿洲"]]],["季节",[["l","春季","春季"]," • ",["l","夏季","夏季"]," • ",["l","秋季","秋季"]]],["加工设备",[["i","(BC)10","蜂房"]]],["原料",["作物",["l","花","花"]]],["加工时间",["6100分钟 (≈4天)"]],["售价",["100金"]]]}