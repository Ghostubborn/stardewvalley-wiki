{"s":[[null,1,[["p",["诡异玩偶是一种",["l","古物","古物"],"，挖掘",["l","远古斑点","远古斑点"],"有机会找到，打开",["l","钓鱼#宝箱","釣魚宝箱"],"也有机会获得。此外，用",["l","锄头","锄头"],"在",["l","矿井","矿井"],"或",["l","骷髅洞穴","骷髅洞穴"],"中挖掘也有几率获得。得到",["l","秘密纸条#秘密纸条 #17","秘密纸条 #17"],"后也可以在纸条中描述的位置挖出一个绿色的诡异玩偶。"]]]],["捐赠",2,[["p",["捐赠该物品可以增加",["l","博物馆","博物馆"],"的捐赠总数。"]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","贾斯","贾斯"]]],[{"h":1,"v":["喜欢"]},[["l","矮人","矮人"],"、",["l","潘妮","潘妮"]]],[{"h":1,"v":["不喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]]]]]],["裁制",2,[["p",["诡异玩偶（绿）可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成可染色的 ",["l","裁缝","温布斯T恤"],"。诡异玩偶（绿）可用于",["l","染色","染色"],"。放置在",["l","染色#染料罐","染料罐"],"内时，诡异玩偶（绿）可用作绿色染料。放置在",["l","染色#缝纫机","缝纫机"],"内时，诡异玩偶（绿）还可用作绿色染料，染色强度为强烈。"]]]],["任务",2,[["p",["诡异玩偶（绿）不用于任何",["l","任务","任务"],"中。"]]]],["趣闻",2,[["l",0,[[1,["游戏的作者",["l","ConcernedApe","ConcernedApe"],"曾经在2011年创作了一部名为《温布斯世界》的漫画。这只绿色玩偶与",["l","温布斯雕像","温布斯雕像"],"以及游戏中的电影",["l","电影院#电影","温布斯"],"内的主角很相似，它们也都是对那篇漫画的致敬。"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.3","1.3"],"：可以通过",["l","秘密纸条#秘密纸条 #17","秘密纸条 #17"],"获取"]],[1,[["l","版本历史#1.4","1.4"],"：现在诡异玩偶（绿）可被用于",["l","裁缝","裁缝"],"。"]],[1,[["l","版本历史#1.5","1.5"],"：",["l","潘妮","潘妮"],"和",["l","矮人","矮人"],"现在喜欢",["l","古物","古物"],"，而其他NPC对古物的喜好程度从讨厌变成了不喜欢。"]],[1,[["l","版本历史#1.6","1.6"],"：现在诡异玩偶（绿）是",["l","贾斯","贾斯"],"的最爱。"]]]]]]]}