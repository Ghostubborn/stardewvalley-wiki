{"s":[[null,1,[["p",["高级弹弓是一种",["l","武器","武器"],"，可在",["l","矿井","矿井"],"70层宝箱中发现，此后能在",["l","探险家公会","探险家公会"],"以1,000金的价格购买。尽管中说“需要石子当弹药”，事实上",["l","石头","石头"],"以外的许多物品也可以用作弹药。"]],["p",["不同于大多数",["l","武器","武器"],"，对",["l","居民","居民"],"使用高级弹弓会使玩家与他们之间的",["l","友谊","友谊"],"减少30点，而对",["l","动物","宠物"],"使用会使其产生一个表示“反感”的对话气泡，但不会减少友谊。"]]]],["弹药",2,[["p",["要让弹弓装备上弹药，选取要使用的弹药，然后右键点击弹弓。"]],["p",["弹药类型决定了弹弓所造成的伤害，具体数值由以下公式计算："]],["p",["弹弓："]],["p",["伤害 = 弹药系数 + [-(弹药系数 / 2), 弹药系数 + 1]之间的随机数"]],["p",["高级弹弓："]],["p",["伤害 = 2 * (弹药系数 + [-(弹药系数 / 2), 弹药系数 + 1]之间的随机数)"]],["p",["使用最差的弹药（即：",["l","水果","水果"],"、",["l","蔬菜","蔬菜"],"和蛋类）时，普通弹弓能造成1-3点伤害，高级弹弓能造成2-6点伤害。使用最好的弹药",["l","铱矿石","铱矿石"],"时，普通弹弓能造成25-101点伤害，高级弹弓能造成50-202点伤害。"]],["p",["下列物品可用作弹药："]],["t",[[{"h":1,"v":["物品"]},{"h":1,"v":["弹药系数"]},{"h":1,"v":["普通弹弓伤害范围"]},{"h":1,"v":["高级弹弓伤害范围"]}],[["所有",["l","水果","水果"]," • 所有",["l","蔬菜","蔬菜"]," • 所有蛋"],["1"],["1-3"],["2-6"]],[[["l","煤炭","煤炭"]],["15"],["8-31"],["16-62"]],[[["l","铜矿石","铜矿石"]],["10"],["5-21"],["10-42"]],[[["l","爆炸弹丸","爆炸弹丸"]],["20"],["10-41"],["20-82"]],[[["l","黄金矿石","黄金矿石"]],["30"],["15-61"],["30-122"]],[[["l","铱矿石","铱矿石"]],["50"],["25-101"],["50-202"]],[[["l","铁矿石","铁矿石"]],["20"],["10-41"],["20-82"]],[[["l","石头","石头"]],["5"],["3-11"],["6-22"]],[[["l","木材","木材"]],["2"],["1-5"],["2-10"]]]]]],["备注",2,[["l",0,[[1,["关于武器的一个",["l","武器","漏洞"],"（允许玩家进入地图周围通常无法到达的区域）并不适用于高级弹弓。"]]]]]]]}