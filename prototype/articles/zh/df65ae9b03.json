{"s":[[null,1,[["p",["莉亚的农舍位于",["l","煤矿森林","煤矿森林"],"中",["l","玛妮的牧场","玛妮的牧场"],"的南边，是",["l","莉亚","莉亚"],"的家。"]],["p",["如果当前季节为",["l","春季","春季"],"、",["l","夏季","夏季"],"或",["l","秋季","秋季"],"，需要与",["l","莉亚","莉亚"],"好感度达到2心后才能进入。如果为",["l","冬季","冬季"],"，则免除好感度的要求。"]],["p",["开放时间为上午10:00到下午6:00，即使和",["l","莉亚","莉亚"],"结婚了，也不能在非开放时间进入她的房子。"]]]]]}