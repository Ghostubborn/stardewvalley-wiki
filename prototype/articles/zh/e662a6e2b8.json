{"s":[[null,1,[["p",["鸡雕像是一种",["l","古物","古物"],"，可以通过挖掘",["l","农场","农场"],"上的",["l","远古斑点","远古斑点"],"获得，也有 3.57% 的概率通过砸开",["l","古物宝藏","古物宝藏"],"获得。此外，打开",["l","钓鱼#宝箱","钓鱼宝箱"],"也有较小概率获得鸡雕像。",["l","宠物","宠物"],"狗达到最大",["l","宠物#好感度","好感度"],"后，每天第一次被抚摸也有可能掉落鸡雕像。"]]]],["捐赠",2,[["p",["捐赠包含鸡雕像在内的任意 5 种古物后，玩家可获得",["l","鸡雕像（家具）","鸡雕像（家具）"],"。"]]]],["裁制",2,[["p",["鸡雕像可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","绒毛T恤"],"。鸡雕像可用于",["l","染色","染色"],"。放置在",["l","染色#染料罐","染料罐"],"内时，鸡雕像可用作黄色染料。放置在",["l","染色#缝纫机","缝纫机"],"内时，鸡雕像还可用作沙色染料，染色强度为强烈。"]]]],["任务",2,[["p",["鸡雕像不用于任何",["l","任务","任务"],"。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.0#1.0","1.0"],"：加入游戏。"]],[1,[["l","版本历史/1.4#1.4","1.4"],"：新增",["l","古物宝藏","古物宝藏"],"作为获取来源之一。现在可用于",["l","裁缝","裁缝"],"。"]],[1,[["l","版本历史/1.5#1.5","1.5"],"：现在",["l","潘妮","潘妮"],"和",["l","矮人","矮人"],"喜欢",["l","古物","古物"],"，其他",["l","居民","居民"],"对古物的态度从讨厌变成了不喜欢。"]],[1,[["l","版本历史#1.6","1.6"],"：现在抚摸达到最大",["l","宠物#好感度","好感度"],"的",["l","宠物","宠物"],"狗有概率掉落。"]]]]]]]}