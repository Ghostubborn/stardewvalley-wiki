{"s":[[null,1,[["p",["矮人卷轴 IV是一种",["l","古物","古物"],"，可能从除了",["l","骷髅","骷髅"],"、",["l","飞蛇","飞蛇"],"、",["l","荒野石魔","荒野石魔"],"、",["l","石碳幽灵","石碳幽灵"],"、",["l","蝙蝠","铱蝠"],"、",["l","铱蟹","铱蟹"],"和",["l","幽灵头骨","幽灵头骨"],"以外的任何",["l","怪物","怪物"],"身上掉落，或是用",["l","锄头","锄头"],"在第80层以后的",["l","矿井","矿井"],"挖掘获得。"]]]],["捐赠",2,[["p",["捐赠该物品可以增加",["l","博物馆","博物馆"],"的捐赠总数。"]],["p",["此外，捐赠所有四种矮人卷轴后，玩家会获得",["l","矮人语教程","矮人语教程"],"。"]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","矮人","矮人"],"、",["l","潘妮","潘妮"]]],[{"h":1,"v":["不喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]]]]]],["裁制",2,[["p",["矮人卷轴 IV可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成可染色的 ",["l","裁缝","金边T恤"],"。矮人卷轴 IV可用于",["l","染色","染色"],"。放置在",["l","染色","染料罐"],"内时，矮人卷轴 IV可用作黄色染料。放置在",["l","染色","缝纫机"],"内时，矮人卷轴 IV还可用作黄色染料，染色强度为强烈。"]]]],["提示",2,[["p",["矿井第95层入口处有可开垦土壤，玩家可以搭乘电梯反复进入95层挖掘以获取矮人卷轴 I或矮人卷轴 IV。"]]]]]}