{"s":[[null,1,[["p",["宝石甜莓是一种",["l","农作物","农作物"],"，可以通过种植",["l","稀有种子","稀有种子"],"生长 24 天成熟后获得。它既不属于水果，也不属于蔬菜，因此不能放入任何",["l","打造","工匠设备"],"中，其品质与售价也不会受到任何技能的影响。"]],["p",["在",["l","春季","春季"],"和",["l","夏季","夏季"],"，",["l","旅行货车","旅行货车"],"会以",["f","Gold.png",18],"1,000 的价格将",["i","(O)347","稀有种子"],"作为",["l","旅行货车#特殊商品","“特殊商品”"],"固定出售，每次 1 个或 5 个。除此之外，",["l","旅行货车","旅行货车"],"还有 1.26% 的概率以",["f","Gold.png",18],"600 ~ 1,000 的价格将稀有种子作为",["l","旅行货车#普通商品","“普通商品”"],"随机出售，数量也为 1 个或 5 个。作为“普通商品”出售的稀有种子不限季节，但是作为“特殊商品”和“普通商品”出售的稀有种子不会同时出现在旅行货车中。"]],["p",["尽管宝石甜莓售价高昂，但作为礼物时，所有村民的反应都是",["l","友谊#一般的礼物","一般"],"。"]],["p",["把一个宝石甜莓送给",["l","秘密森林","秘密森林"],"的",["l","老坎诺利大师","老坎诺利大师"],"后，可以获得到一个",["l","星之果实","星之果实"],"。"]]]],["生长阶段",2,[["t",[[{"h":1,"v":["阶段 1"]},{"h":1,"v":["阶段 2"]},{"h":1,"v":["阶段 3"]},{"h":1,"v":["阶段 4"]},{"h":1,"v":["阶段 5"]},{"h":1,"v":["收获"]}],[[["f","Sweet_Gem_Berry_Stage_1.png",26]],[["f","Sweet_Gem_Berry_Stage_2.png",26]],[["f","Sweet_Gem_Berry_Stage_3.png",26]],[["f","Sweet_Gem_Berry_Stage_4.png",26]],[["f","Sweet_Gem_Berry_Stage_5.png",26]],[["f","Sweet_Gem_Berry_Stage_6.png",26]],[["f","Sweet_Gem_Berry.png",48]]],[["2 天"],["4 天"],["6 天"],["6 天"],["6 天"],["共 24 天"]]]]]],["作物生长日历",2,[["p",["激素类型"]],["p",["无"]],["p",["生长激素"]],["p",["高级生长激素"]],["p",["顶级生长激素"]],["p",["农业学家"]]]],["送礼",2,[["t",[[{"h":1,"c":2,"v":["收到宝石甜莓后"]}],[{"h":1,"v":["普通\n+20"]},[["f","Harvey_Icon.png",24]," ",["l","哈维","哈维"]," • ",["f","Sam_Icon.png",24]," ",["l","山姆","山姆"]," • ",["f","Shane_Icon.png",24]," ",["l","谢恩","谢恩"]," • ",["f","Alex_Icon.png",24]," ",["l","亚历克斯","亚历克斯"]," • ",["f","Elliott_Icon.png",24]," ",["l","艾利欧特","艾利欧特"]," • ",["f","Sebastian_Icon.png",24]," ",["l","塞巴斯蒂安","塞巴斯蒂安"]," • ",["f","Haley_Icon.png",24]," ",["l","海莉","海莉"]," • ",["f","Leah_Icon.png",24]," ",["l","莉亚","莉亚"]," • ",["f","Maru_Icon.png",24]," ",["l","玛鲁","玛鲁"]," • ",["f","Penny_Icon.png",24]," ",["l","潘妮","潘妮"]," • ",["f","Emily_Icon.png",24]," ",["l","艾米丽","艾米丽"]," • ",["f","Abigail_Icon.png",24]," ",["l","阿比盖尔","阿比盖尔"]," • ",["f","Pierre_Icon.png",24]," ",["l","皮埃尔","皮埃尔"]," • ",["f","Caroline_Icon.png",24]," ",["l","卡洛琳","卡洛琳"]," • ",["f","Lewis_Icon.png",24]," ",["l","刘易斯","刘易斯"]," • ",["f","Marnie_Icon.png",24]," ",["l","玛妮","玛妮"]," • ",["f","Robin_Icon.png",24]," ",["l","罗宾","罗宾"]," • ",["f","Demetrius_Icon.png",24]," ",["l","德米特里厄斯","德米特里厄斯"]," • ",["f","Evelyn_Icon.png",24]," ",["l","艾芙琳","艾芙琳"]," • ",["f","George_Icon.png",24]," ",["l","乔治","乔治"]," • ",["f","Jas_Icon.png",24]," ",["l","贾斯","贾斯"]," • ",["f","Vincent_Icon.png",24]," ",["l","文森特","文森特"]," • ",["f","Jodi_Icon.png",24]," ",["l","乔迪","乔迪"]," • ",["f","Kent_Icon.png",24]," ",["l","肯特","肯特"]," • ",["f","Willy_Icon.png",24]," ",["l","威利","威利"]," • ",["f","Gus_Icon.png",24]," ",["l","格斯","格斯"]," • ",["f","Pam_Icon.png",24]," ",["l","潘姆","潘姆"]," • ",["f","Linus_Icon.png",24]," ",["l","莱纳斯","莱纳斯"]," • ",["f","Clint_Icon.png",24]," ",["l","克林特","克林特"]," • ",["f","Wizard_Icon.png",24]," ",["l","法师","法师"]," • ",["f","Dwarf_Icon.png",24]," ",["l","矮人","矮人"]," • ",["f","Krobus_Icon.png",24]," ",["l","科罗布斯","科罗布斯"]," • ",["f","Sandy_Icon.png",24]," ",["l","桑迪","桑迪"]," • ",["f","Leo_Icon.png",24]," ",["l","雷欧","雷欧"]]]]]]],["提示",2,[["p",[["l","种子生产器","种子生产器"],"用每个宝石甜莓制造 1~3 个",["l","稀有种子","稀有种子"],"的几率为 97.5%。 因为每个宝石甜莓在普通，银星和金星品质下分别价值",["f","Gold.png",18],"3,000，",["f","Gold.png",18],"3,750，和",["f","Gold.png",18],"4,500，而由",["l","种子生产器","种子生产器"],"制造的稀有种子的成本至少是每个",["f","Gold.png",18],"1,000（",["f","Gold.png",18],"3,000 ÷ 3），至多是每个",["f","Gold.png",18],"4,500（",["f","Gold.png",18],"4,500 ÷ 1），所以从旅行货车处购买每个",["f","Gold.png",18],"1,000 的稀有种子更划算。"]],["p",["考虑到宝石甜莓无法加工，因此使用宝石甜莓盈利时应该尽可能提高品质。但由于购买渠道不稳定，因此批量种植盈利时需要使用",["l","种子生产器","种子生产器"],"制作种子，需要投入尽可能低品质的作物减少收益浪费。因此最佳的种植策略应当为：投入一部分耕地施加",["l","激素","激素"],"缩短生长时间用于补充种子，另一部分施加",["l","肥料","肥料"],"用于提高品质出售盈利。经过计算，使用",["l","高级生长激素","高级激素"],"搭配",["l","肥料","肥料"],"的最佳耕地比例为 4:5。而更高的加速效果最佳比例则为 2:3。"]]]],["收集包",2,[["p",[["l","重新混合的收集包#茶水间","茶水间（重新混合后）"],"的",["f","Bundle_Teal.png",24]," ",["l","重新混合的收集包#稀有作物收集包","稀有作物收集包"],"需要 1 个宝石甜莓（作为可选项）"]]]],["食谱",2,[["p",["宝石甜莓不用于任何",["l","烹饪#食谱","食谱"],"。"]]]],["裁制",2,[["p",["宝石甜莓可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["i","(H)65","白色头巾"],"。宝石甜莓还可用作",["l","染色#染料罐","染料罐"],"和",["l","染色#缝纫机","缝纫机"],"的红色染料。"]]]],["任务",2,[["p",["宝石甜莓不用于任何",["l","任务","任务"],"。"]]]],["历史",2,[["l",false,[[1,["1.0：加入。"]],[1,["1.4：现在可用于裁缝。"]],[1,["1.4：旅行货车不再出售宝石甜莓。"]],[1,["1.5：加入铱星。现在可用于重新混合后的稀有作物收集包。"]]]]]]],"f":[["种子",[["i","(O)347","稀有种子"]]],["成熟需",["24天"]],["季节",[["f","Fall.png",24]," ",["l","秋季","秋季"]]],["经验值",["64 点 ",["f","Farming.png",20],["l","耕种#经验值","耕种经验值"]]],["能量",["不可食用"]],["售出价格",[["f","Sweet_Gem_Berry.png",24],"\n\n\n\n3,000\n\n\n\n",["f","Sweet_Gem_Berry.png",24],"\n\n",["f","Silver_Quality_Icon.png",24],"\n\n3,750\n\n\n\n",["f","Sweet_Gem_Berry.png",24],"\n\n",["f","Gold_Quality_Icon.png",24],"\n\n4,500\n\n\n\n",["f","Sweet_Gem_Berry.png",24],"\n\n",["f","Iridium_Quality_Icon.png",24],"\n\n6,000"]],["物品编号",["(O)417"]]]}