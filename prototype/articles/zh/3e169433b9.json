{"s":[[null,1,[["p",["宝石甜莓是一种",["l","农作物","农作物"],"，由",["l","稀有种子","稀有种子"],"在24天后长成。它不属于水果和蔬菜，因此不能放入",["l","小桶","小桶"],"或",["l","罐头瓶","罐头瓶"],"，也不受",["l","技能","收集者"],"或",["l","技能","植物学家"],"技能影响。"]],["p",[["l","稀有种子","稀有种子"],"可在",["l","旅行货车","旅行货车"],"购买，春季和夏季价格1,000金，其他季节600–1,000金。也可以把宝石甜莓放入",["l","种子生产器","种子生产器"],"来获得稀有种子。"]],["p",["尽管宝石甜莓售价高昂，但作为礼物时，所有村民的反应都是",["l","友谊","一般"],"。"]],["p",["如果你把一个宝石甜莓送给",["l","秘密森林","秘密森林"],"的",["l","老师傅香炸奶酪卷","老师傅香炸奶酪卷"],"，你将会得到一个",["l","星之果实","星之果实"],"，吃下后你的",["l","能量","最大能量"],"将永久提高34点。"]]]],["生长阶段",2,[["t",[[{"h":1,"v":["阶段 1"]},{"h":1,"v":["阶段 2"]},{"h":1,"v":["阶段 3"]},{"h":1,"v":["阶段 4"]},{"h":1,"v":["阶段 5"]},{"h":1,"v":["收成"]}],[["2天"],["4天"],["6天"],["6天"],["6天"],["共：24天"]]]]]],["作物生长日历",2,[["t",[[{"c":7,"h":1,"v":["基本"]}],[{"h":1,"v":["一"]},{"h":1,"v":["二"]},{"h":1,"v":["三"]},{"h":1,"v":["四"]},{"h":1,"v":["五"]},{"h":1,"v":["六"]},{"h":1,"v":["日"]}]]],["t",[[{"c":4,"h":1,"v":["农业学家和生长激素之间的比较"]}],[{"h":1,"v":[]},{"h":1,"v":[["l","生长激素","生长激素"]]},{"h":1,"v":[["l","高级生长激素","高级生长激素"]]},{"h":1,"v":[["l","顶级生长激素","顶级生长激素"]]}],[{"r":2,"h":1,"v":["通常"]},{"b":[["t",[[{"c":7,"h":1,"v":["10%※"]}],[{"h":1,"v":["一"]},{"h":1,"v":["二"]},{"h":1,"v":["三"]},{"h":1,"v":["四"]},{"h":1,"v":["五"]},{"h":1,"v":["六"]},{"h":1,"v":["日"]}]]]]},{"b":[["t",[[{"c":7,"h":1,"v":["25%"]}],[{"h":1,"v":["一"]},{"h":1,"v":["二"]},{"h":1,"v":["三"]},{"h":1,"v":["四"]},{"h":1,"v":["五"]},{"h":1,"v":["六"]},{"h":1,"v":["日"]}]]]]},{"b":[["t",[[{"c":7,"h":1,"v":["33%"]}],[{"h":1,"v":["一"]},{"h":1,"v":["二"]},{"h":1,"v":["三"]},{"h":1,"v":["四"]},{"h":1,"v":["五"]},{"h":1,"v":["六"]},{"h":1,"v":["日"]}]]]]}],[{"c":3,"v":["※请注意，不含任何肥料的10％表也适用于",["l","技能","农业学家职业"],"。"]}],[{"h":1,"v":["农业学家"]},{"b":[["t",[[{"c":7,"h":1,"v":["20%"]}],[{"h":1,"v":["一"]},{"h":1,"v":["二"]},{"h":1,"v":["三"]},{"h":1,"v":["四"]},{"h":1,"v":["五"]},{"h":1,"v":["六"]},{"h":1,"v":["日"]}]]]]},{"b":[["t",[[{"c":7,"h":1,"v":["35%"]}],[{"h":1,"v":["一"]},{"h":1,"v":["二"]},{"h":1,"v":["三"]},{"h":1,"v":["四"]},{"h":1,"v":["五"]},{"h":1,"v":["六"]},{"h":1,"v":["日"]}]]]]},{"b":[["t",[[{"c":7,"h":1,"v":["43%"]}],[{"h":1,"v":["一"]},{"h":1,"v":["二"]},{"h":1,"v":["三"]},{"h":1,"v":["四"]},{"h":1,"v":["五"]},{"h":1,"v":["六"]},{"h":1,"v":["日"]}]]]]}]]]]],["送礼",2,[["t",[[{"h":1,"v":["一般"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","雷欧","雷欧"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"]]]]]]],["提示",2,[["p",[["l","种子生产器","种子生产器"],"用每个宝石甜莓制造1-3个",["l","稀有种子","稀有种子"],"的几率为97.5%。 因为每个宝石甜莓在普通，银星和金星品质下分别价值3,000金，3,750金，和4,500金，而由",["l","种子生产器","种子生产器"],"制造的稀有种子的成本至少是每个1,000金(3,000金 ÷ 3)，至多是每个4,500金(4,500金 ÷ 1)，所以从旅行货车处购买每个1,000金的稀有种子更划算。"]]]],["收集包",2,[["p",["宝石甜莓是稀有作物收集包的一个可选项。"]]]],["食谱",2,[["p",["宝石甜莓不用于任何食谱。"]]]],["裁制",2,[["p",["宝石甜莓可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["i","(H)65","白色头巾"],"。宝石甜莓还可用作",["l","染色","染料罐"],"和",["l","染色","缝纫机"],"的红色染料。"]]]],["任务",2,[["p",["宝石甜莓不用于任何任务。"]]]]],"f":[["季节",["Fall"]],["生长时间",["24天"]],["种子",[["i","(O)347","稀有种子"]]],["售价",["3,000金"]]]}