{"s":[[null,1,[["p",["大理石火炬是一种可通过",["l","打造","打造"],"获得的",["l","打造#光源","光源"],"，可以用于照明。大理石火炬的制造配方需要在",["l","木匠的商店","木匠的商店"],"以",["f","Gold.png",18],"5,000 购买。"]],["p",["与大理石火炬互动可以切换其点燃或熄灭的状态。当大理石火炬处于点燃状态时，会照亮半径约 7 格的区域。"]],["p",["可以将大理石火炬放置在",["l","农场","农场"],"以外的区域，但如果其位置正好阻挡了",["l","居民","居民"],"的行进路径，大理石火炬会被",["l","居民","居民"],"摧毁。"]]]],["历史",2,[["l",false,[[1,["1.6：现在可以一次性在木匠的商店买到所有的火炬配方，而不再需要按顺序购买。"]]]]]]],"f":[["来源",[["l","打造","打造"]]],["售出价格",["不可出售"]],["配方来源",[["l","木匠的商店","木匠的商店"],"以",["f","Gold.png",18],"5,000 购买"]],["所需原料",[["i","(O)567","大理石"],"（1）",["i","(O)62","海蓝宝石"],"（1）",["i","(O)390","石头"],"（100）"]],["物品编号",["(BC)151"]]]}