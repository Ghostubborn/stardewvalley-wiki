{"s":[[null,1,[["p",["护目镜是一种",["l","帽子","帽子"],"，玩家可以在",["l","缝纫机","缝纫机"],"上使用",["l","布料","布料"],"和",["l","虫肉块","虫肉块"],"缝制该物品。玩家在",["l","沙漠节","沙漠节"],"中进入提供服装服务的小屋，并接受",["l","沙漠节#艾米丽的服装服务","艾米丽的服装服务"],"后，有约 2% 的概率获得带有护目镜的一套中性服装。"]],["p",["这顶帽子还有小概率通过以下方式获得：击杀",["l","怪物","怪物"],"；",["l","矿井#木箱和木桶","打破木箱和木桶"],"；砍",["l","树","树"],"；摇晃树木；挖掘",["l","远古斑点","远古斑点"],"；",["l","淘盘","淘金"],"。"]]]],["备注",2,[["l",0,[[1,["带有护目镜的一套中性服装还包括 ",["f","Shirt234.png",24]," ",["l","裁缝#上衣","电路板T恤"]," 和 ",["f","Baggy_Pants.png",24]," ",["l","裁缝#下装","宽松裤"],"（染色RGB值 60,99,62）。"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.5","1.5"],"：加入游戏。"]],[1,[["l","版本历史#1.6","1.6"],"：现在可以作为一套服装的部件从",["l","沙漠节","沙漠节"],"随机获得。现在有小概率通过玩家的多种行为活动获得。"]]]]]]]}