{"s":[[null,1,[["p",["火山晶石是一种资源，可以在",["l","火山地牢","火山地牢"],"内开采",["l","采矿#Cinder Shard Node","火山晶石矿"],"或开启",["l","火山地牢#宝箱","普通宝箱或稀有宝箱"],"获得。击杀",["l","熔岩精灵","熔岩精灵"],"、",["l","熔岩火球","熔岩火球"],"、",["l","熔岩掘地虫","熔岩掘地虫"],"和",["l","假熔岩菇","假熔岩菇"],"后也有概率掉落火山晶石。当饲养有",["l","黄貂鱼","黄貂鱼"],"的",["l","鱼塘","鱼塘"],"在数量到达 7 时，每天有 7.1~8% 的几率产出 2~5 个火山晶石。在",["l","矿井#挑战之神庙","危险的矿井"],"或",["l","骷髅洞穴","危险的骷髅洞穴"],"中击杀",["l","矿井#特殊物品","特殊怪物"],"（",["l","史莱姆#特殊史莱姆","特殊史莱姆"],"会有黄色星形触角的明显特征，其他特殊怪物与正常怪物无明显差异）也有概率获得火山晶石。"]]]],["锻造",2,[["n",["主条目：",["l","锻造","锻造"]]],["p",["火山晶石是",["l","锻造","锻造"],"过程中的主要消耗品。每次锻造工具、组合戒指、附魔、铸造",["l","银河之魂","银河之魂"],"时均需花费火山晶石。"]]]],["送礼",2,[["t",[[{"h":1,"v":["一般"]},[["l","克林特","克林特"]]],[{"h":1,"v":["不喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]],[{"h":1,"v":["讨厌"]},[["l","山姆","山姆"]]]]]]],["收集包",2,[["p",["火山晶石不用于任何",["l","收集包","收集包"],"。"]]]],["交易",2,[["p",["火山晶石可用于在",["l","姜岛商人","姜岛商人"],"和",["l","火山地牢#商店","火山地牢的矮人商店"],"中购买商品和配方。"]],["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["售价"]},{"h":1,"v":["来源"]}],[[["f","Cinderclown_Shoes.png",48]],[["l","灰烬小丑鞋","灰烬小丑鞋"]],["这双神奇鞋子的主人是一位著名的矮人小丑。"],[["i","(O)848","火山晶石×100"]],[["l","火山地牢#商店","火山地牢"],"中的矮人商店"]],[[["f","Jungle_Torch.png",48]],[["l","丛林火炬","丛林火炬"]],["这件家具不能布置在户外。"],[["i","(O)848","火山晶石×5"]],[["l","姜岛商人","姜岛商人"]]],[[["f","Wild_Double_Bed.png",96]],[["l","原野双人床","原