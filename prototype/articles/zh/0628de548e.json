{"s":[[null,1,[["p",["柳巷1号紧挨着",["l","鹈鹕镇","鹈鹕镇"],"的东南街道，是",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"和",["l","文森特","文森特"],"的家。柳巷1号和柳巷2号（",["l","海莉","海莉"],"和",["l","艾米丽","艾米丽"],"的家）相邻。"]],["p",[["l","肯特","肯特"],"第一年不在镇上，第二年的年初才会回来。"]],["p",["柳巷1号的地点名在游戏内被错误翻译为1柳巷。"]]]],["室内布局",2,[["p",["刚进房子右手边是",["l","文森特","文森特"],"的卧室。右上更大的卧室属于",["l","山姆","山姆"],"。前往",["l","乔迪","乔迪"],"和",["l","肯特","肯特"],"的卧室要途径厨房，它位于房子的最后方。"]],["p",["玩家必须和对应角色获得两颗心的",["l","友谊","好感值"],"才能进入他们各自的房间。"]],["g",[["1_Willow_Lane_Interior.webp",500,[]]]]]],["彩蛋",2,[["p",["如果把一个",["l","奇怪的小面包","奇怪的小面包"],"放到",["l","文森特","文森特"],"房间的玩具箱里，玩家可获得一个",["f","??Foroguemon??.png",24],["l","??碎屑雕像??","??碎屑雕像??"],"。"]]]]]}