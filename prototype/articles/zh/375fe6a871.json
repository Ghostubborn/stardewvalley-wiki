,["“你好啊，玩家名。你来这里是为了放松还是干活？”"],[]],["q",["“与山谷里相比，这里的水很暖和。太开心了！”"],[]],["q",["“我让格斯给我个惊喜，然后他做了一杯芒果皮冰绿茶。这太棒了！”"],[]],["q",["“（不回应）卡洛琳想打个盹。”"],[]],["q",["“我今晚会睡得很好！”"],[]],["p",["玩家行为"]],["p",["获得",["l","成就","成就"],"“厨子”后"]],["q",["“你家总是飘来香味，我想你在厨房忙得不亦乐乎吧！”"],[]],["p",[["i","(O)815","茶叶"],"成熟后"]],["q",["“我看到你在农场里种了茶叶，记得给我带一点啊！”"],[]],["p",[["l","农舍","农舍"],"升级 1 次后"]],["q",["“我听说你有了个新厨房！你会经常做饭吗？”"],[]],["p",["会做饭可是很实用的，你还有农场上的新鲜食材，条件可谓是得天独厚！"]],["p",["好吧，不过还是要健康膳食……营养是很重要的。"]],["p",[["l","星露谷展览会","星露谷展览会"],"获胜后"]],["q",["“皮埃尔之前在星露谷集市上输给你，他装作不在意，其实还耿耿于怀呢。”"],[]],["p",["特殊行程对话"]],["p",["周二"]],["q",["“唔……嗯……我是不是应该为今天的有氧运动聚会特意打扮下？”"],[]],["q",["“你看起来好健康啊，乔迪！练哑铃真的很管用吧？”"],[]],["q",["“唔……我想我今天能吃点儿饼干了。*咂巴*。”"],[]],["p",["周五"]],["q",["“终于……有了一点儿自己的时间。”"],[]],["p",["周日"]],["q",["“前任房主建造了祭坛室。我们不信宗教，但我们会让其他镇民随意使用。”"],[]],["p",[["l","电影院","电影院"],"开业"]],["q",["“镇上有个电影院真不错，我想去看西部片！”"],[]],["p",["其他额外对话"]],["q",["“哦，玩家名……好尴尬。我把你卖给我的[ ]中的一个，扔进了堆肥箱。 但是，从好的方面想，蠕虫喜欢极了！他们从没这么快乐过！”"],[]],["q",["“哦，玩家名……好尴尬。我把你卖给我的[ ]中的一个，扔进了堆肥箱。 现在，那整个东西难闻极了。你是在哪找到那东西的？”"],[]]]]]],["任务",2,[["l",false,[[1,["任务“雕刻南瓜”：秋季19日时，卡洛琳会来信请玩家给她带一个南瓜。任务奖励是",["f","Gold.png",18],"500并会增加与卡洛琳间的1心好感度。"]],[1,["特别任务“岛屿食材”：第一年秋季2日解锁特别任务板后，玩家有几率接到来自卡洛琳的特别任务，要求玩家在28天内售出100份特定农作物（芋头/姜/菠萝之一）。任务奖励为等同于普通品质农作物50%价格的金币，玩家还会在任务完成的第二天收到来自卡洛琳的太阳能板配方。"]],[1,["卡洛琳可能会随机在皮埃尔的杂货店外面的布告栏上发布求助任务，任务奖励金币为3倍普通品质需求物品的价格以及150点好感度。"]]]]]],["肖像",2,[["g",[["Caroline.png",64,[]],["Caroline_Happy.png",64,[]],["Caroline_Concerned.png",64,[]],["Caroline_Neutral.png",64,[]]]],["g",[["Caroline_Winter_00.png",64,[]],["Caroline_Winter_01.png",64,[]],["Caroline_Winter_02.png",64,[]],["Caroline_Winter_03.png",64,[]]]],["g",[["Caroline_Beach.png",64,[]],["Caroline_Beach_Happy.png",64,[]],["Caroline_Beach_Concerned.png",64,[]],["Caroline_Beach_Neutral.png",64,[]]]]]],["你知道吗",2,[["l",false,[[1,["卡洛琳会在信中给你寄防风草汤的菜谱，但她的丈夫却讨厌这道菜。"]],[1,["卡洛琳讨厌蛋黄酱，而需要用到蛋黄酱制作的鱼肉卷却是她的最爱。"]],[1,["不论天气如何，卡洛琳偶尔会有这样的对话：“今天天气真不错呢。在这样的日子里，我喜欢去帮艾芙琳照料公共花园。”"]],[2,["无论任何天气，游戏中都没有她帮助艾芙琳照料花园的画面。"]],[1,["卡洛琳日光房的茶苗是可以获得的，玩家需要用任意斧头砍茶树200下即可挖掉茶树获得一个茶苗，并且该茶树每天都会重新长出。"]]]]]],["漏洞",2,[["l",false,[[1,["即使玩家已经重建了社区中心，皮埃尔的杂货店也已经每天都营业。在夏季时，卡洛琳有时候依然会说：“周三的时候商店不开门哦。如果要买东西的话，可一定要牢记啊。”"]]]]]],["历史",2,[["l",false,[[1,["1.4：新增2心事件。新增绿茶为卡洛琳的最爱，茶叶为喜欢。修复了达到3心好感度后卡洛琳会寄送所有食谱的问题。"]],[1,["1.5：新增了卡洛琳在海滩度假村时的肖像。"]],[1,["1.6：现在卡洛琳喜欢野山葵。新增冬季肖像。新增收到特定礼物时独特对话。"]]]]]]]}