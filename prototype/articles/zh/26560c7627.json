{"s":[[null,1,[["p",["橙子树苗是一种",["l","果树","果树"],"树苗， 28 天能长成",["l","橙子树","橙子树"],"，成熟后在",["l","夏季","夏季"],"每天结出一颗果实。如同所有其他",["l","果树","果树"],"，被种植在",["l","温室","温室"],"中或者",["l","姜岛","姜岛"],"上成熟后会全年结果。"]],["p",["橙子树苗可以在",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"和",["l","旅行货车","旅行货车"],"购买，偶尔也会在",["l","骷髅洞穴","骷髅洞穴的宝箱层"],"中找到。橙子树苗也会作为",["l","镇长的庄园","兑奖机"],"的第2个奖品（50%概率），",["l","谜之盒","谜之盒"],"与",["l","金色谜之盒","金色谜之盒"],"也有概率开出。"]]]],["生长阶段",2,[["t",[[{"h":1,"v":["阶段 1"]},{"h":1,"v":["阶段 2"]},{"h":1,"v":["阶段 3"]},{"h":1,"v":["阶段 4"]},{"h":1,"v":["阶段 5 - 春季，夏季，秋季，冬季"]},{"h":1,"v":["收成"]}],[[["f","Orange_Stage_1.png",96]],[["f","Orange_Stage_2.png",96]],[["f","Orange_Stage_3.png",96]],[["f","Orange_Stage_4.png",96]],[["f","Orange_Stage_5.png",384]],[["f","Orange_Stage_5_Fruit.png",96]]],[["7天"],["7天"],["7天"],["7天"],["共：28天"],["夏季"]]]]]],["送礼",2,[["t",[[{"h":1,"v":["不喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","雷欧","雷欧"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"]]]]]]]]}