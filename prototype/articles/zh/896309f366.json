{"s":[[null,1,[["p",["茶具是一种",["l","家具","家具"],"，在",["l","冬日星盛宴","冬日星盛宴"],"进行",["l","冬日星盛宴#可能收到的礼物","秘密礼物交换"],"时有一定概率获得。除了",["l","克林特","克林特"],"、",["l","艾芙琳","艾芙琳"],"、",["l","玛妮","玛妮"],"、",["l","罗宾","罗宾"],"和",["l","威利","威利"],"以外的任何成年的村民都可能会送你茶具。"]],["p",["从第25年开始，",["l","旅行货车","旅行货车"],"将有5%的概率以1,000,000金的价格出售茶具。"]],["p",["茶具可在物品栏或箱子中堆叠。此外，与其它家具不同，茶具可以以200金的价格售出，也可以作为",["l","友谊#礼物","礼物"],"赠送。"]]]],["送礼",2,[["t",[[{"h":1,"v":["不喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.6","1.6"],"：",["l","旅行货车","旅行货车"],"从第25年开始有概率出售茶具。"]]]]]]]}