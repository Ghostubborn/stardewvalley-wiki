{"s":[[null,1,[["p",["怪物图鉴是一本由",["l","怪物","怪物"],"掉落获取的",["l","书","能力之书"],"。怪物掉落这本书的概率从 0.01% 开始计算，每杀死一只怪物增加 0.015% ，直到掉落为止。之后的获取概率会永久保持在 0.05% 。在玩家杀死 10 个以上怪物之前不会掉落这本书。"]],["p",["从第3年开始，玩家也可以用20,000金从",["l","书摊老板","书摊老板"],"处购买这本书（出现概率为 ~9%）。"]],["p",["首次阅读后，玩家将获得使怪物有 3% 概率掉落双倍战利品的能力，效果可以与",["l","窃贼戒指","窃贼戒指"],"叠加。并且它会在玩家菜单中的“特殊物品和能力”上点亮。重复阅读可以提供 100点 ",["f","Combat_Skill_Icon.png",20]," ",["l","技能","战斗经验值"],"。"]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","潘妮","潘妮"],"、",["l","科罗布斯","科罗布斯"]]],[{"h":1,"v":["喜欢"]},[["l","艾利欧特","艾利欧特"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"]]],[{"h":1,"v":["一般"]},[["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","乔迪","乔迪"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","莱纳斯","莱纳斯"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","雷欧","雷欧"]]],[{"h":1,"v":["不喜欢"]},[["l","亚历克斯","亚历克斯"]]]]]]],["裁制",2,[["p",["怪物图鉴可用于",["l","染色","染色"],"。放置在",["l","缝纫机","缝纫机"],"内时，怪物图鉴可用作黑色染料。"]]]],["趣闻",2,[["p",["获得这本书的能力之后，杀死",["l","史莱姆（怪物）","五彩史莱姆"],"之后可能会获得两份",["l","五彩胶冻","五彩胶冻"],"，但这并不会对",["l","法师","法师"],"的特别任务",["l","任务","“五彩胶冻”"],"造成影响。"]]]],["收集包",2,[["p",["怪物图鉴不用于任何",["l","收集包","收集包"],"。"]]]],["任务",2,[["p",["怪物图鉴不用于任何",["l","任务","任务"],"。"]]]],["交易",2,[["p",["在阅读过怪物图鉴之后，可以在",["l","书摊老板","书摊老板"],"处用两本怪物图鉴，兑换",["l","史莱姆孵化器","史莱姆孵化器"],"或",["l","史莱姆压蛋器","史莱姆压蛋器"],"。"]]]]],"f":[["来源",[["l","怪物","怪物"]," · ",["l","书摊老板","书摊老板"]]],["售价",["2,000金"]]]}