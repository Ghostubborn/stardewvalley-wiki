{"s":[[null,1,[["p",["仙人掌种子是一种种子。成熟的植株会产出",["l","仙人掌果子","仙人掌果子"],"。"]],["p",["仙人掌种子只在",["l","绿洲","绿洲"],"有售，价格为150金。",["l","沙鱼","沙鱼"],"和",["l","蝎鲤鱼","蝎鲤鱼"],"的鱼塘在容量达到10后，有概率产出仙人掌种子。偶尔也能从",["l","骷髅洞穴#宝藏房间","骷髅洞穴的宝箱层"],"中找到15个仙人掌种子。"]],["p",["仙人掌植株只能生长在",["l","姜岛","姜岛"],"上、",["l","温室","温室"],"里或其他建筑物内的",["l","花盆","花盆"],"中。把仙人掌种子直接种在",["l","农场","农场"],"上时会失败并显示消息。"]],["p",["从仙人掌植株上收获仙人掌果实时，会获得",["l","耕种","耕种"],"经验值。"]]]],["生長階段",2,[["t",[[{"h":1,"v":["階段 1"]},{"h":1,"v":["階段 2"]},{"h":1,"v":["階段 3"]},{"h":1,"v":["階段 4"]},{"h":1,"v":["階段 5"]},{"c":2,"h":1,"v":["收成"]}],[[["f","Cactus_Stage_1.png",48]],[["f","Cactus_Stage_2.png",48]],[["f","Cactus_Stage_3.png",48]],[["f","Cactus_Stage_4.png",48]],[["f","Cactus_Stage_5.png",48]],[["f","Cactus_Stage_6.png",48]],[["f","Cactus_Stage_7.png",48]]],[["2 天"],["2 天"],["2 天"],["3 天"],["3 天"],["總共: 12 天"],["每3天继续生产一次。"]]]]]],["送礼",2,[["t",[[{"h":1,"v":["不喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","皮埃尔","皮埃尔"],"、",["l","莱纳斯","莱纳斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.3.27","1.3.27"],"：加入游戏。"]],[1,[["l","版本历史#1.4","1.4"],"：可以通过鱼塘产出。"]],[1,[["l","版本历史#1.6","1.6"],"：现在在农场上种植仙人掌种子会失败，并显示消息。"]]]]]]]}