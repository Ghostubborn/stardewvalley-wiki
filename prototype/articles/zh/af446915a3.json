{"s":[[null,1,[["p",["斑点头巾是一种",["l","帽子","帽子"],"，玩家可以用",["l","布料","布料"],"和",["l","红蘑菇","红蘑菇"],"在",["l","缝纫机","缝纫机"],"上缝制该帽子。女性玩家角色在",["l","沙漠节","沙漠节"],"中进入提供服装服务的小屋，并接受",["l","沙漠节#艾米丽的服装服务","艾米丽的服装服务"],"后，有约 2% 的概率获得带有斑点头巾的一套服装。"]],["p",["这顶帽子还有小概率通过以下方式获得：击杀",["l","怪物","怪物"],"；",["l","矿井#木箱和木桶","打破木箱和木桶"],"；砍",["l","树","树"],"；摇晃树木；挖掘",["l","远古斑点","远古斑点"],"；",["l","淘盘","淘金"],"。"]]]],["备注",2,[["l",0,[[1,["带有斑点头巾的一套服装还包括 ",["f","Shirt202.png",24]," ",["l","裁缝#上衣","时髦上衣（女）"]," 和 ",["f","Long_Dress.png",24]," ",["l","裁缝#下装","长裙"],"（染色RGB值 142,1,1）。"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.4","1.4"],"：加入游戏。"]],[1,[["l","版本历史#1.6","1.6"],"：现在可以作为一套服装的部件从沙漠节随机获得。现在有小概率通过玩家的多种行为活动获得。"]]]]]]]}