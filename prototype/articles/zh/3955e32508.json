idium_Quality_Icon.png",20]],["130"],[["f","Health.png",20],"\n\n",["f","Iridium_Quality_Icon.png",20]],["58"]]]]]},{"b":[["t",[[[["f","Energy.png",20]],["25"],[["f","Health.png",20]],["11"]],[[["f","Energy.png",20],"\n\n",["f","Silver_Quality_Icon.png",20]],["35"],[["f","Health.png",20],"\n\n",["f","Silver_Quality_Icon.png",20]],["15"]],[[["f","Energy.png",20],"\n\n",["f","Gold_Quality_Icon.png",20]],["45"],[["f","Health.png",20],"\n\n",["f","Gold_Quality_Icon.png",20]],["20"]],[[["f","Energy.png",20],"\n\n",["f","Iridium_Quality_Icon.png",20]],["65"],[["f","Health.png",20],"\n\n",["f","Iridium_Quality_Icon.png",20]],["29"]]]]]},{"b":[["t",[[[["f","Energy.png",20]],["13"],[["f","Health.png",20]],["5"]],[[["f","Energy.png",20],"\n\n",["f","Silver_Quality_Icon.png",20]],["18"],[["f","Health.png",20],"\n\n",["f","Silver_Quality_Icon.png",20]],["8"]],[[["f","Energy.png",20],"\n\n",["f","Gold_Quality_Icon.png",20]],["23"],[["f","Health.png",20],"\n\n",["f","Gold_Quality_Icon.png",20]],["10"]],[[["f","Energy.png",20],"\n\n",["f","Iridium_Quality_Icon.png",20]],["33"],[["f","Health.png",20],"\n\n",["f","Iridium_Quality_Icon.png",20]],["14"]]]]]}]]],["h",["最差的回应"]],["p",["不论以上判定结果如何，都要在最后进行一次最差的回应判定，判定条件为："]],["l",false,[[1,["可食用性 > -300 且 <0 （食用后扣除能量值）"]]]],["h",["与村民好感度的叠加机制（多人游戏）"]],["p",["在多人游戏中，尽管州长的反应取决于最差的物品，但是与村民的",["l","友谊","好感度"],"却会根据每个人放入的物品的物品进行叠加。例如三人联机的情况下，若每个人都放入了最好的物品，那么每个人都能和在场的所有村民获得 +120 × 3 = +360 点好感度。这意味着在多人游戏中可以通过夏威夷宴会来更快地获得与村民的好感度。"]],["h",["举例"]],["p",["假设玩家在单人游戏中放入了一个金星品质的",["l","甜瓜","甜瓜"],":"]],["l",false,[[1,["首先判定最好的回应，金星品质的甜瓜，其基础售价为",["f","Gold.png",18],"250（普通品质的，不计算任何职业加成的售价），满足最好的回应结果"]],[1,["其次再判定最差的回应，由于甜瓜的可食用性为 45，不在 -299 ~ -1 的范围内，因此不满足最差的回应结果"]]]],["p",["综上，放入金星品质的甜瓜，得到的回应是最好的回应，玩家将与在场所有村民获得 120 好感度。"]],["p",["假设玩家在单人游戏中放入了一个金星品质的",["l","蔓越莓","蔓越莓"],":"]],["l",false,[[1,["首先判定最好的回应，金星品质的蔓越莓，不满足最好的回应结果，故转而判定好的回应"]],[1,["由于金星品质蔓越莓的基础售价为",["f","Gold.png",18],"75、可食用性为 15，虽不满足好的回应的前两条，但满足第三条，故满足好的回应结果"]],[1,["其次再判定最差的回应，蔓越莓不满足最差的回应结果"]]]],["p",["综上，放入金星品质的蔓越莓，得到的回应是好的回应，玩家将与在场所有村民获得 60 好感度。"]],["p",["假设玩家 A 在多人游戏中放入了一条金星品质的",["l","蝎鲤鱼","蝎鲤鱼"],"，而玩家 B 放入了一条幸运紫色短裤（或者什么也没有放）:"]],["l",false,[[1,["首先判定最好的回应，金星品质的蝎鲤鱼，其基础售价为",["f","Gold.png",18],"150，不满足最好的回应结果"]],[1,["然后判定好的回应，蝎鲤鱼基础售价为",["f","Gold.png",18],"150，满足好的回应结果"]],[1,["其次再判定最差的回应，虽然在前面的判定中，蝎鲤鱼满足好的回应的条件，但由于其可食用性为 -50，在 -299 ~ -1 的范围内，因此无视前面好的回应的判定结果，故玩家 A 放入的蝎鲤鱼得到的回应将会是最差的回应"]],[1,["但是，由于玩家 B 放入了一条幸运紫色短裤（或者什么也没有放），该判定结果高于玩家 A 的判定结果，因此将会覆盖放入蝎鲤鱼后最差的回应"]]]],["p",["综上，在这种情况下，得到的回应是特殊回应（或是缺了什么的回应），并且所有玩家将与在场的所有村民损失 100 点好感度（蝎鲤鱼的 -100 好感 + 幸运短裤/什么都没放的 0 好感）。"]],["p",["假设玩家 A 在多人游戏中放入了一个金星品质的",["l","甜瓜","甜瓜"],"，而玩家 B 放入了一条金星品质的",["l","蝎鲤鱼","蝎鲤鱼"],":"]],["l",false,[[1,["根据前面所述，金星品质的甜瓜得到的回应是最好的，金星品质的蝎鲤鱼得到的回应是最差的，最终结果取决于最差的物品"]]]],["p",["综上，在这种情况下，得到的回应是最差的回应，但是所有玩家们仍可以与在场的所有村民获得 20 点好感度（甜瓜的 +120 好感 + 蝎鲤鱼的 -100 好感）。"]]]]]],["对话",2,[["p",["在与",["l","刘易斯","刘易斯"],"镇长对话进入分百乐汤环节前，玩家可以与",["l","居民","居民"],"进行对话，在奇数年与偶数年和村民对话的内容不同。"]]]],["奇数年",3,[["d","对话内容",[["q",["“",["l","州长","州长"],"：真是美好的时光……星露谷总是那么的赏心悦目。回去得跟老婆大人协商下在这里买个度假小屋。”"],[]],["q",["“",["f","Lewis_Icon.png",24]," ",["l","刘易斯","刘易斯"],"：州长要来例行访问了。你要是带了额外材料来，那就快添加到汤锅里去。”"],[]],["q",["“",["f","Shane_Icon.png",24]," ",["l","谢恩","谢恩"],"：哇……大城市里面可买不到这种辣椒酱……”"],[]],["q",["“",["f","Linus_Icon.png",24]," ",["l","莱纳斯","莱纳斯"],"：缓慢而均匀的转动是做出完美烧烤的关键。”"],[]],["q",["“",["f","Clint_Icon.png",24]," ",["l","克林特","克林特"],"：吃得好饱，不过除了吃吃吃也没别的事可以做了。”"],[]],["q",["“",["f","Gus_Icon.png",24]," ",["l","格斯","格斯"],"：该死的沙蝇一直停靠在食物上！”"],[]],["q",["“",["f","Pam_Icon.png",24]," ",["l","潘姆","潘姆"],"：嘿嘿……免费大餐。住在星露谷真是福利多多啊。好好享受吧，小子！”"],[]],["q",["“",["f","Demetrius_Icon.png",24]," ",["l","德米特里厄斯","德米特里厄斯"],"：太累人了，甜心。准备好去吃自助餐没？*喘气*”"],[]],["q",["“",["f","Robin_Icon.png",24]," ",["l","罗宾","罗宾"],"：嗷……你踩到我脚的了，亲。”"],[]],["q",["“",["f","Caroline_Icon.png",24]," ",["l","卡洛琳","卡洛琳"],"：我把后院采的新鲜蔬菜加到了汤锅里。”"],[]],["q",["“",["f","Marlon_Icon.png",24]," ",["l","马龙","马龙"],"：我要待在树荫这里……这边气候凉爽多了。”"],[]],["q",["“",["f","Maru_Icon.png",24]," ",["l","玛鲁","玛鲁"],"：莱纳