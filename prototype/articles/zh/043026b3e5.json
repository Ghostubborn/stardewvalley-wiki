{"s":[[null,1,[["p",["绿藻是一种可在任意季节、任意淡水水体（",["l","农场地图#Standard","标准农场"],"上的",["l","农场池塘","池塘"],"除外）中使用",["l","钓鱼#钓鱼竿","钓鱼竿"],["l","钓鱼","钓鱼"],"获得的物品。",["l","蟹笼","蟹笼"],"不能捕获绿藻。钓上绿藻后，玩家会获得3点",["l","钓鱼#经验","钓鱼经验"],"。"]],["p",["绿藻是",["l","史莱姆（怪物）","绿色史莱姆"],"的一种稀有掉落物，也可由",["l","史莱姆鱼","史莱姆鱼"],"、",["l","小龙虾","小龙虾"],"、",["l","蜗牛","蜗牛"],"、",["l","玉黍螺","玉黍螺"],"在",["l","鱼塘","鱼塘"],"中产出。",["l","动物#宠物","宠物"],"猫达到最大",["l","动物#好感度","好感度"],"后，每天第一次被抚摸也有可能掉落一个绿藻。在任何季节的任何时间，翻动",["l","垃圾桶","垃圾桶"],"也有概率找到绿藻。"]],["p",["绿藻会显示在",["l","收集品#鱼","收集品 - 鱼"],"的页面之中，并且捕获的绿藻会计入四项和钓鱼相关的",["l","成就","成就"],"之中。除了上述情况之外，绿藻在分类上并不属于鱼，所以也不能被卖给",["l","威利","鱼店的威利"],"。"]]]],["送礼",2,[["t",[[{"h":1,"v":["讨厌"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","雷欧","雷欧"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"]]]]]]],["收集包",2,[["p",["绿藻不用于任何",["l","收集包","收集包"],"。"]]]],["菜谱",2,[["t",[[{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["所需原料"]},{"h":1,"v":["能量 / 生命值"]},{"h":1,"v":["增益效果"]},{"h":1,"v":["增益时长"]},{"h":1,"v":["食谱来源"]},{"h":1,"v":["售出价格"]}],[[["l","海藻汤","海藻汤"]],["有些粘稠。"],[["i","(O)153","绿藻×4"]],["能量 75\n生命值 33"],["无"],["无"],[["l","克林特","克林特"],"（邮件- 3+ ❤）"],["100金"]],[[["l","鳟鱼汤","鳟鱼汤"]],["很咸。"],[["i","(O)138","虹鳟鱼×1"],["i","(O)153","绿藻×1"]],["能量 100\n生命值 45"],[["l","钓鱼","钓鱼（+1）"]],["4分39秒"],["烹饪频道（奇数年秋季14日）"],["100金"]]]]]],["建造",2,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]}