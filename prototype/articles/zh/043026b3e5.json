{"s":[[null,1,[["p",["绿藻是一种可以通过多种方式获得的物品，可以在任意季节、任意淡水水体（",["l","农场地图#Standard","标准农场"],"上的",["l","农场池塘","池塘"],"除外）中通过",["l","钓鱼","钓鱼"],"获得。"]],["p",["杀死",["l","史莱姆","绿色史莱姆"],"也有概率会掉落绿藻。所有淡水",["l","蟹笼","蟹笼"],"鱼类以及",["l","史莱姆鱼","史莱姆鱼"],"的",["l","鱼塘","鱼塘"],"在数量到达 1 时都有概率产出 1~3 个海草。在任何季节时间翻动",["l","垃圾桶","垃圾桶"],"也有概率找到绿藻。",["l","宠物","宠物"],"猫达到最大",["l","宠物#好感度","好感度"],"后，每天第一次被抚摸也有可能掉落绿藻。"]],["p",["绿藻会显示在",["l","收集品#鱼","收集品 - 鱼"],"的页面之中，并计入和钓鱼相关的四个成就之中。然而，绿藻在分类上并不属于鱼，且不能在",["l","鱼店","鱼店"],"将其卖给",["l","威利","威利"],"。"]]]],["送礼",2,[["t",[[{"h":1,"v":["讨厌"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]]]]]],["收集包",2,[["p",["绿藻不用于任何",["l","收集包","收集包"],"。"]]]],["食谱",2,[["t",[[{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["所需原料"]},{"h":1,"v":["能量 / 生命值"]},{"h":1,"v":["增益效果"]},{"h":1,"v":["增益时长"]},{"h":1,"v":["食谱来源"]},{"h":1,"v":["售出价格"]}],[[["l","海藻汤","海藻汤"]],["有些粘稠。"],[["i","(O)153","绿藻×4"]],["能量 75\n生命值 33"],["无"],["无"],[["l","克林特","克林特"],"（邮件 - 3+ ❤）"],["100金"]],[[["l","鳟鱼汤","鳟鱼汤"]],["很咸。"],[["i","(O)138","虹鳟鱼×1"],["i","(O)153","绿藻×1"]],["能量 100\n生命值 45"],[["l","钓鱼","钓鱼（+1）"]],["4 分 40 秒"],["烹饪频道（奇数年秋季 14 日）"],["100金"]]]]]],["建筑",2,[["p",["建造",["l","鱼塘","鱼塘"],"需要 5 个绿藻。"]]]],["裁制",2,[["p",["绿藻可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成可染色的 ",["l","裁缝","有领衬衫"],"。绿藻可用于",["l","染色","染色"],"。放置在",["l","染色#染料罐","染料罐"],"内时，绿藻可用作绿色染料。放置在",["l","染色#缝纫机","缝纫机"],"内时，绿藻还可用作深绿色染料。"]]]],["任务",2,[["l",0,[[1,["绿藻会在任何季节，随机出现在",["l","任务#求助任务","皮埃尔的杂货店外边的布告栏"],"上。任务完成的奖励是45金和150点",["l","友谊","友谊"],"。"]],[1,[["l","大头鱼","大头鱼"],"、",["l","鲤鱼","鲤鱼"],"、",["l","大嘴鲈鱼","大嘴鲈鱼"],"以及",["l","午夜鲤鱼","午夜鲤鱼"],"的鱼塘容量从3提升到5的时候，可能会出现需要2~3个绿藻的",["l","鱼塘#任务","鱼塘任务"],"。"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.4#1.4","1.4"],"：成为鱼塘的建造材料。现在在裁缝中可用。现在会出现在鱼塘的任务之中。现在可由鱼塘产出。"]]]]]]],"f":[["来源",["* ",["l","钓鱼","钓鱼"],"\n* ",["l","史莱姆","绿色史莱姆"],"\n* ",["l","鱼塘","鱼塘"]]],["季节",["任意季节"]],["售价",["15金"]]]}