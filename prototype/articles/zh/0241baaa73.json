{"s":[[null,1,[["p",["樱桃炸弹是一种一次性的",["l","打造#炸弹","爆炸物"],"，它会摧毁爆炸范围内的部分物品（例如：岩石、矿脉、宝石矿等），对另一些物品则没有影响（例如：宝箱、建筑等）。用一个樱桃炸弹的威力就足够炸毁前往",["l","矮人","矮人"],"住处的岩石障碍。"]],["p",["樱桃炸弹可以在达到 ",["f","Mining_Skill_Icon.png",24]," ",["l","采矿","采矿"]," 1 级后通过",["l","打造","打造"],"获得，也可以花费",["f","Gold.png",18],"450 在",["l","矮人#出售货物","矮人商店"],"或",["l","火山地牢#商店","火山地牢的商店"],"处购买。"]],["p",["除此之外，樱桃炸弹还有机会通过以下方式获得："]],["l",false,[[1,["旅行货车会以 ",["f","Gold.png",18],"150 ~ ",["f","Gold.png",18],"1,000 的价格随机出售 1 个或 5 个樱桃炸弹"]]]],["l",false,[[1,["杀死矿井（1~29 层）的岩石蟹和掘地虫时有概率会掉落樱桃炸弹"]],[1,["在骷髅洞穴的宝箱层里打开宝箱时可能会获得 15 个樱桃炸弹"]],[1,["在第二次及以后完成特别任务：“洞穴巡查”后的次日，克林特可能会随信赠送 15 个樱桃炸弹作为礼物"]],[1,["当玩家与肯特的友谊值大于 0 时，他可能会随信赠送一个樱桃炸弹作为礼物"]],[1,["20 个樱桃炸弹可能作为兑奖机的第 10 个奖品（33% 概率）获得。"]],[1,["在危险的矿井或危险的骷髅洞穴中击杀特殊怪物（特殊史莱姆会有黄色星形触角的明显特征，其他特殊怪物与正常怪物无明显差异）也有概率获得樱桃炸弹。"]]]],["p",["如果玩家阅读过",["i","(O)Book_Bombs","矮人安全手册"],"，那么将减少 25% 来自樱桃炸弹的伤害。"]]]],["种类",2,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["配方来源"]},{"h":1,"v":["所需原料"]}],[[["f","Cherry_Bomb.png",48]],["樱桃炸弹"],["会发生小爆炸。靠后站！"],[["f","Mining_Skill_Icon.png",24]," ",["l","采矿","采矿"]," 1 级"],[["i","(O)378","铜矿石"],"（4）",["i","(O)382","煤炭"],"（1）"]],[[["f","Bomb.png",48]],[["l","炸弹","炸弹"]],["会发生爆炸。小心了！"],[["f","Mining_Skill_Icon.png",24]," ",["l","采矿","采矿"]," 6 级"],[["i","(O)380","铁矿石"],"（4）",["i","(O)382","煤炭"],"（1）"]],[[["f","Mega_Bomb.png",48]],[["l","超级炸弹","超级炸弹"]],["会发生大爆炸。使用时请格外小心。"],[["f","Mining_Skill_Icon.png",24]," ",["l","采矿","采矿"]," 8 级"],[["i","(O)384","黄金矿石"],"（4）",["i","(O)768","太阳精华"],"（1）",["i","(O)769","虚空精华"],"（1）"]]]]]],["影响",2,[["p",["物块破坏："]],["l",false,[[1,["爆炸范围内的杂草、树枝、岩石、矿石和宝石节点会掉落相应物品。"]],[1,["爆炸范围内的果树上如果有果实，则果实会掉落。"]],[1,["爆炸范围内的树上如果有苔藓，则苔藓会掉落。如果有树种，树种也会掉落。"]],[1,["爆炸范围内的树（包括果树）如果被爆炸击倒，或者残留的树桩被爆炸摧毁，则会掉落相应的掉落物，如树液、木材、果树树苗等。"]],[1,["爆炸范围内的可采集矿物、蘑菇、青草/蓝草会被直接摧毁。"]],[1,["爆炸范围内的农作物、饲料槽上的干草会被直接摧毁，没有掉落物"]],[1,["爆炸范围内放置的大部分可打造物品（例如小桶、宝石复制机等）都将会被直接摧毁。没有掉落物。"]],[2,["爆炸范围内的地板和小径会变为掉落物并可被玩家重新拾起。"]],[2,["蟹笼不会被爆炸破坏。"]],[2,["施在已经被开垦的耕地里的化肥不会被爆炸破坏。"]],[2,["宝箱、大箱子、石箱和石制大箱子不会被爆炸破坏，无论其中是否存有物品。"]],[2,["放在地上的帐篷不会被爆炸破坏。"]],[2,["茶苗和茶树不会被爆炸破坏。"]],[1,["爆炸无法摧毁任何体积超过1×1的物块，包括陨石、巨大作物、大树桩、大圆木、大型岩石。"]],[1,["爆炸无法摧毁任何家具"]],[1,["爆炸无法摧毁自动采集器、迷你出货箱和祝尼魔箱，无论其中是否存有物品。"]]]],["p",["物块伤害："]],["l",false,[[1,["⌊爆炸半径 / 2⌋ 的范围内每一格未开垦的地块和远古斑点、绿色斑点都有 90% 概率变成已被开垦的状态。但效果与玩家使用锄头不同，爆炸会直接摧毁斑点，最多只会掉落和开垦普通地块时一样有概率出现的粘土。"]],[1,["爆炸可以伤害并最终摧毁爆炸范围内的树木（包括果树）。"]],[2,["每次爆炸会对爆炸范围内的树木造成⌊爆炸半径 / 2⌋的物块伤害（⌊x⌋表示向下取整）。"]],[2,["还未长成小树的树种、树芽，以及果树的幼苗，会被直接摧毁。没有掉落物。"]],[2,["爆炸摧毁树木获得木材时，会受到技能职业护林人和伐木工人以及书籍伐木秘事的加成。"]]]],["l",false,[[1,["完全长成的果树或处于第 3~4 阶段的树的生命值为 10 点，树桩为 5 点。简单计算可知，使用樱桃炸弹摧毁一棵成熟的树一共需要 15 次爆炸：炸倒树干需要 10 次，摧毁树桩需要 5 次。"]]]]]],["影响区域",2,[["p",["樱桃炸弹的爆炸半径为 3。处于整个方形区域内的玩家、怪物会受到爆炸伤害，绿色圆形以内的区域则为爆炸范围，红色圆形区域有机会炸为开垦状态。具体造成伤害详见",["l","防御","防御"],"和",["l","战斗","战斗"],"的公式计算部分。"]]]],["成本比较",2,[["p",["两种稳定获取樱桃炸弹的成本计算如下："]],["l",false,[[1,["矿井矮人或火山矮人处直接购买：",["f","Gold.png",18],"450"]],[1,["从铁匠铺处购买原料制作："]],[2,["第一年：75 × 4 + 150 = ",["f","Gold.png",18],"450"]],[2,["第二年：150 × 4 + 250 = ",["f","Gold.png",18],"750"]]]],["p",["由此比较得： 直接购买樱桃炸弹的成本 ＝ 第一年购买原料制作樱桃炸弹的成本 < 第二年购买原料制作樱桃炸弹的成本"]]]],["送礼",2,[["t",[[{"h":1,"c":2,"v":["收到樱桃炸弹后"]}],[{"h":1,"v":["不喜欢\n-20"]},[["f","Harvey_Icon.png",24]," ",["l","哈维","哈维"]," • ",["f","Sam_Icon.png",24]," ",["l","山姆","山姆"]," • ",["f","Shane_Icon.png",24]," ",["l","谢恩","谢恩"]," • ",["f","Alex_Icon.png",24]," ",["l","亚历克斯","亚历克斯"]," • ",["f","Elliott_Icon.png",24]," ",["l","艾利欧特","艾利欧特"]," • ",["f","Sebastian_Icon.png",24]," ",["l","塞巴斯蒂安","塞巴斯蒂安"]," • ",["f","Haley_Icon.png",24]," ",["l","海莉","海莉"]," • ",["f","Leah_Icon.png",24]," ",["l","莉亚","莉亚"]," • ",["f","Maru_Icon.png",24]," ",["l","玛鲁","玛鲁"]," • ",["f","Penny_Icon.png",24]," ",["l","潘妮","潘妮"]," • ",["f","Emily_Icon.png",24]," ",["l","艾米丽","艾米丽"]," • ",["f","Abigail_Icon.png",24]," ",["l","阿比盖尔","阿比盖尔"]," • ",["f","Pierre_Icon.png",24]," ",["l","皮埃尔","皮埃尔"]," • ",["f","Caroline_Icon.png",24]," ",["l","卡洛琳","卡洛琳"]," • ",["f","Lewis_Icon.png",24]," ",["l","刘易斯","刘易斯"]," • ",["f","Marnie_Ic