{"s":[[null,1,[["p",["铱环是一种可通过",["l","打造","打造"],"获得的",["l","戒指","戒指"],"，可以在达到战斗 9 级后通过",["l","打造","打造"],"获得。在达到钓鱼 2 级后也有小概率在",["l","钓鱼#宝箱","钓鱼宝箱"],"中发现。击杀",["l","铱石魔","铱石魔"],"有 0.1% 的概率掉落铱环，在",["l","矿井#挑战之神庙","危险的矿井"],"或",["l","骷髅洞穴","危险的骷髅洞穴"],"中击杀",["l","矿井#特殊物品","特殊怪物"],"（",["l","史莱姆#特殊史莱姆","特殊史莱姆"],"会有黄色星形触角的明显特征，其他特殊怪物与正常怪物无明显差异）或者",["l","矿井#木箱和木桶","打破木箱和木桶"],"后小概率掉落铱环。"]],["p",[["l","铱环","铱环"],"结合了",["l","光辉戒指","光辉戒指"],"、",["l","磁铁戒指","磁铁戒指"],"和",["l","红宝石戒指","红宝石戒指"],"的所有效果（发出半径 10 格的光并增加 2 格收集范围，同时增加 10% 的攻击伤害），并且可与另一个",["l","铱环","铱环"],"、",["l","辉石戒指","辉石戒指"],"、",["l","光辉戒指","光辉戒指"],"、",["l","小型光辉戒指","小型光辉戒指"],"、",["l","磁铁戒指","磁铁戒指"],"、",["l","小型磁铁戒指","小型磁铁戒指"],"、或",["l","红宝石戒指","红宝石戒指"],"叠加。"]],["p",["玩家身处农舍、温室等建筑物内部时，铱环的发光半径会不足 10 格。"]]]],["染色",2,[["p",["铱环可用作",["l","染色#染料罐","染料罐"],"的紫色染料，放置在",["l","染色#缝纫机","缝纫机"],"内时还可用作亮紫色染料。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.6","1.6"],"：现在可以通过击杀",["l","铱石魔","铱石魔"],"掉落。"]]]]]]]}