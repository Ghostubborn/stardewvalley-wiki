{"s":[[null,1,[["p",["铱环是一种",["l","戒指","戒指"],"，可以在达到 ",["f","Combat_Skill_Icon.png",18],["l","战斗","战斗"],"等级 9 后通过",["l","打造","打造"],"获得，也能在达到 ",["f","Fishing_Skill_Icon.png",24]," ",["l","钓鱼","钓鱼等级 2"]," 后在",["l","钓鱼","钓鱼宝箱"],"中发现。击杀怪物",["l","铱石魔","铱石魔"],"也有概率掉落铱环，也能在“",["l","任务","深处的危险"],"”任务期间或激活“",["l","矿井","挑战之神庙"],"”后在",["l","矿井","矿井"],"中",["l","矿井","打破木箱和木桶"],"或通过杀死",["l","怪物","怪物"],"后的",["l","矿井","掉落物"],"获得。"]],["p",[["l","铱环","铱环"],"结合了",["l","光辉戒指","光辉戒指"],"、",["l","磁铁戒指","磁铁戒指"],"和",["l","红宝石戒指","红宝石戒指"],"的所有效果（发出半径10格的光并增加2格收集范围同时提升10%",["l","攻击","攻击"],"），并且可与另一个",["l","铱环","铱环"],"、",["l","辉石戒指","辉石戒指"],"、",["l","光辉戒指","光辉戒指"],"、",["l","小型光辉戒指","小型光辉戒指"],"、",["l","磁铁戒指","磁铁戒指"],"、",["l","小型磁铁戒指","小型磁铁戒指"],"、或",["l","红宝石戒指","红宝石戒指"],"叠加。"]]]],["染色",2,[["p",["铱环可用作",["l","染色","染料罐"],"的紫色染料，放置在",["l","染色","缝纫机"],"内时还可用作亮紫色染料。"]]]]]}