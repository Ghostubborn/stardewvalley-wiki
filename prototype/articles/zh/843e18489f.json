f","Ostrich_Incubator.png",48]],[["l","鸵鸟孵化器","鸵鸟孵化器"]],["将鸵鸟蛋孵化成鸵鸟雏鸟。放置在畜棚里。"],["完成",["l","岛屿办事处","岛屿办事处"],"的所有捐赠和调查任务"],[["i","(O)881","骨头碎片×50"],["i","(O)709","硬木×50"],["i","(O)848","火山晶石×20"]]],[[["f","Heavy_Tapper.png",48]],[["l","重型树液采集器","重型树液采集器"]],["放在枫树、橡树、松树上，然后等着装满树液吧！比普通树液采集器快一倍。"],[["l","齐先生的核桃房","齐先生的核桃房"],"以20齐钻 购买"],[["i","(O)709","硬木×30"],["i","(O)910","放射性矿锭×1"]]],[[["f","Mini-Obelisk.png",48]],[["l","迷你图腾尖塔","迷你图腾尖塔"]],["在农场中放置两个，就可以在它们之间传送。"],[["l","任务#A Curious Substance","特别任务：“奇特物质”"]],[["i","(O)709","硬木×30"],["i","(O)768","太阳精华×20"],["i","(O)336","金锭×3"]]],[[["f","Hopper.png",48]],[["l","加料器","加料器"]],["把东西放进去，会自动加进前面的机器里。"],[["l","齐先生的核桃房","齐先生的核桃房"],"以50齐钻 购买"],[["i","(O)709","硬木×10"],["i","(O)337","铱锭×1"],["i","(O)910","放射性矿锭×1"]]],[[["f","Fish_Smoker.png",48]],[["l","熏鱼机","熏鱼机"]],["放入鱼和一块煤炭即可烟熏，熏鱼价格是普通的两倍。"],[["l","鱼店","鱼店"],"以10,000金 购买"],[["i","(O)709","硬木×10"],["i","(O)SeaJelly","海凝胶×1"],["i","(O)RiverJelly","河凝胶×1"],["i","(O)CaveJelly","洞穴凝胶×1"]]],[[["f","Treasure_Totem.png",48]],[["l","宝藏图腾","宝藏图腾"]],["在可挖掘的地形上使用即可召唤一圈宝藏挖掘点。"],["采集精通"],[["i","(O)709","硬木×5"],["i","(O)MysticSyrup","神秘糖浆×1"],["i","(O)Moss","苔藓×10"]]]]]]],["建筑",2,[["p",["建造以下建筑需要硬木。"]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","罗宾","罗宾"]]],[{"h":1,"v":["不喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]]]]]],["收集包",2,[["p",["建筑收集包需要 10 个硬木。"]]]],["裁制",2,[["p",["硬木可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","上衣"],"。硬木可用于",["l","染色","染色"],"。放置在",["l","染色#染料罐","染料罐"],"内时，硬木可用作橙色染料。放置在",["l","染色#缝纫机","缝纫机"],"内时，硬木还可用作棕色染料。"]]]],["任务",2,[["l",0,[[1,["在",["l","冬季","冬季"],"21日通过",["l","罗宾","罗宾"],"的邮件，可以接到",["l","任务#Robins Request","“罗宾的请求”任务"],"，要求是10个硬木。完成任务的奖励是500金和1心",["l","友谊","好感度"],"。"]],[1,[["l","罗宾","罗宾"],"的",["l","任务#Robins Project","特别任务：罗宾的项目"],"任务期间会要求玩家收集并提交80个硬木。完成任务的奖励是2,000金和一张",["l","豪华红色双人床","豪华红色双人床"],"。"]],[1,[["l","鱼店#威利的船","威利的船"],"需要200个硬木来修复船身。"]],[1,["修复",["l","煤矿森林","煤矿森林"],"的",["l","大树桩（地点）","大树桩（地点）"],"需要100个硬木。"]],[1,["饲养有",["l","木跃鱼","木跃鱼"],"的",["l","鱼塘","鱼塘"],"在数量从1提升到3的时候，可能会出现要求玩家提供10个硬木的",["l","鱼塘#任务","鱼塘任务"],"。"]],[1,["饲养有",["l","玉黍螺","玉黍螺"],"、",["l","小龙虾","小龙虾"],"和",["l","蜗牛","蜗牛"],"的",["l","鱼塘","鱼塘"],"在数量从5提升到7时，可能会出现要求玩家提供5个硬木的",["l","鱼塘#任务","鱼塘任务"],"。"]]]]]],["备注",2,[["l",0,[[1,[["l","碎木机","碎木机"],"可将硬木转化为",["l","木材","木材"],"、",["l","枫糖浆","枫糖浆"],"、",["l","橡树树脂","橡树树脂"],"或",["l","松焦油","松焦油"],"。"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.4#1.4","1.4"],"：现在可用于",["l","裁缝","裁缝"],"。",["l","采集","护林人"],"技能不再提高硬木的销售价格。现在可用于",["l","传送图腾：沙漠","传送图腾：沙漠"],"的配方。现在",["l","鱼塘","鱼塘"],"可以产出硬木了。现在",["l","鱼塘#任务","鱼塘任务"],"可用。"]],[1,[["l","版本历史/1.5#1.5","1.5"],"：现在可以通过砍伐",["l","桃花心木树","桃花心木树"],"获得。现在",["l","任务#Robins Project","“罗宾的项目”"],"和修理",["l","鱼店#威利的船","威利的船"],"需要硬木。现在可用于",["l","传送图腾：姜岛","传送图腾：姜岛"],"、",["l","鸵鸟孵化器","鸵鸟孵化器"],"、",["l","重型树液采集器","重型树液采集器"],"、",["l","迷你图腾尖塔","迷你图腾尖塔"],"和",["l","加料器","加料器"],"的配方。现在",["l","骷髅火炬","骷髅火炬"],"配方不再需要硬木。"]],[1,[["l","版本历史#1.6","1.6"],"：现在砍伐",["l","神秘树","神秘树"],"、与",["l","书摊老板","书摊老板"],"交易、开启",["l","谜之盒","谜之盒"],"可以获得硬木。现在可用于",["l","熏鱼机","熏鱼机"],"、",["l","蘑菇树桩","蘑菇树桩"],"、",["l","便携帐篷","便携帐篷"],"和",["l","宝藏图腾","宝藏图腾"],"的配方。现在可以在",["l","沙漠节","沙漠节"],"购买。现在抚摸达到最大",["l","动物#好感度","好感度"],"的",["l","宠物","宠物"],"狗有概率掉落。"]],[1,[["l","版本历史#1.6.4","1.6.4"],"：现在可作为装饰品放入",["l","鱼缸","鱼缸"],"中。"]]]]]]],"f":[["来源",[["l","桃花心木树","桃花心木树"]," • ",["