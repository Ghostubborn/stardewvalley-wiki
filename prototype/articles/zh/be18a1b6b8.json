{"s":[[null,1,[["p",["海胆是",["l","沙滩","沙滩"],["l","采集","采集"],"获得的一种贝类，全季节都有。海胆的具体生成位置为沙滩的",["l","沙滩","潮汐池"],"，需要花费300木头修复位于主海滩最东边一条破损的小桥后才能到达该区域。在夏季12-14日，海滩上（包括潮汐池）会生成额外的海胆。"]],["p",["海滩",["l","沙滩","潮汐池"],"的海胆平均生成率为0.23只/天。在夏季12-14日期间，每天平均会额外生成0.8个海胆。此生成率不受海滩上其他可采集物品的影响；具体来说，海胆不算在每张地图最多6个可采集物品的限制中。每个海胆提供7采集值经验，并且所有采集加成都适用于海胆。"]],["p",["艾米丽偶尔会寄海胆作为礼物。此外，",["l","沙漠节","沙漠节"],"期间",["l","艾米丽","艾米丽"],"会以5卡利科蛋",["l","卡利科三花蛋","卡利科三花蛋"],"的价格出售海胆（限5个）。所有咸水",["l","蟹笼","蟹笼"],"生物的",["l","鱼塘","鱼塘"],"在生物数量到达5时开始概率产生海胆。",["l","动物","宠物"],"乌龟达到最大",["l","动物","好感度"],"后，每天第一次被抚摸也有可能掉落海胆。"]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","雷欧","雷欧"],"、",["l","艾芙琳","艾芙琳"]]],[{"h":1,"v":["一般"]},[["l","艾利欧特","艾利欧特"]]],[{"h":1,"v":["讨厌"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"]]]]]]],["收集包",2,[["p",["用于染料收集包。"]]]],["打造",2,[["t",[[{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["材料"]},{"h":1,"v":["配方来源"]}],[[["l","鱼饵制造机","鱼饵制造机"]],["放入鱼即可制造有针对性的鱼饵。"],[["i","(O)335","铁锭×3"],["i","(O)393","珊瑚×3"],["i","(O)397","海胆×1"]],[["l","钓鱼","钓鱼"]," 6 级"]]]]]],["裁制",2,[["p",["海胆可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成可染色的 ",["l","裁缝","吊带上衣"],"。海胆还可用作",["l","染色","染料罐"],"和",["l","染色","缝纫机"],"的紫色染料。"]]]],["鱼塘",2,[["p",["虽然海胆在其他情况下并不被当作",["l","鱼","鱼"],"，但它可以养殖在",["l","鱼塘","鱼塘"],"中，每四天繁殖一个。初始容量是10，不需要完成任何扩容任务。只产出紫色的",["l","鱼籽","海胆鱼籽"],"。"]],["p",[["l","鱼塘","产物"]]],["t",[[{"h":1,"v":["产出物品"]},{"h":1,"v":