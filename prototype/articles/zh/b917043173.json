{"s":[[null,1,[["g",[["The_Mountain.thumb.webp",320,[],"The_Mountain.webp"]]],["p",["深山位于",["l","Stardew Valley","星露谷"],"北部地区。最开始，深山只有两个出口，向南通往",["l","鹈鹕镇","鹈鹕镇"],"，向西通往",["l","边远森林","边远森林"],"高海拔区和",["l","农场","农场"],"。但是随着游戏进程的推进，有数个事件可以启用更多的道路："]],["l",0,[[1,["在第一年",["l","春季","春季"],"的第5天，堵塞了深山湖泊北侧木桥的碎石被清除了，现在玩家可以前往",["l","矿井","矿井"],"和",["l","探险家公会","探险家公会"],"。"]],[1,["在第一年",["l","夏季","夏季"],"的第3天，一场地震会打开由深山向北通往",["l","铁路","铁路"],"的通道。"]],[1,["位于深山最东侧通往",["l","采石场","采石场"],"的桥梁会被修复（完成全部的",["l","收集包#工艺室","工艺室收集包"],"或者依据",["l","Joja社区发展申请书","Joja社区发展申请书"],"花费 25,000金 购买桥梁修复服务。 )。"]],[1,[["l","矿井","矿井"],"入口左边闪闪发光的巨石将被移除（完成全部的",["l","收集包#鱼缸","鱼缸收集包"],"，或者依据",["l","Joja社区发展申请书","Joja社区发展申请书"],"花费 20,000金 购买解锁淘金碗。)。"]]]],["p",["每年",["l","春季","春季"],"的15~18日是",["l","美洲大树莓","美洲大树莓"],"的成熟日期，每年",["l","秋季","秋季"],"的8~11日是",["l","黑莓","黑莓"],"的成熟日期，你可以通过摇晃灌木丛",["l","采集","获得"],"这些美味多汁的果子。"]]]],["主要地点",2,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名字"]},{"h":1,"v":["描述"]},{"h":1,"v":["居民"]}],[[["f","Carpenter's_Shop.png",200]],[["l","木匠的商店","木匠的商店"]],["位于西侧，",["l","木匠的商店","木匠的商店"],"是",["l","罗宾","罗宾"],"经营木匠业务的地方。她的丈夫",["l","德米特里厄斯","德米特里厄斯"],"和孩子",["l","玛鲁","玛鲁"],"和",["l","塞巴斯蒂安","塞巴斯蒂安"],"也住在这里。"],[["l","罗宾","罗宾"],["l","德米特里厄斯","德米特里厄斯"],["l","玛鲁","玛鲁"],["l","塞巴斯蒂安","塞巴斯蒂安"]]],[[["f","Tent.png",64]],[["l","帐篷","帐篷"]],["木匠店的东北部;这是",["l","莱纳斯","莱纳斯"],"生活和大多数时间待着的地方。"],[["l","莱纳斯","莱纳斯"]]],[[["f","Treehouse_Exterior.png",150]],[["l","树屋","树屋"]],["位于深山，在通往铁路的通道东侧、莱纳斯的帐篷北侧的大树上。（在雷欧到来之前为一棵大树）"],[["l","雷欧","雷欧"]]],[[["f","TheMountainLake.webp",200]],["山湖"],["一个湖泊分割了这个地区，只有北部。在开始游戏的时候，湖后面通往矿山的路会被山体滑坡堵塞，在几天后被清除（此时",["l","莫里斯","莫里斯"],"会给你寄一封信）。"],[]],[[["f","MinesEntrance.png",200]],[["l","矿井","矿井"]],["穿过小桥，是一个通往怪物出没矿井的入口，这是石头和矿石的主要来源。"],[["l","矮人","矮人"]]],[[["f","Adventurer's_Guild.gif",120]],[["l","探险家公会","探险家公会"]],["沿着矿山旁的道路，是",["l","马龙","马龙"],"和",["l","吉尔","吉尔"],"的居住处。碎石被清除后，可以在这里购买",["l","武器","武器"],"，",["l","鞋类","靴子"],"和",["l","戒指","戒指"],"，或出售怪物掉落的物品。"],[["l","马龙","马龙"],["l","吉尔","吉尔"]]],[[["f","