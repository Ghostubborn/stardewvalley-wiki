{"s":[[null,1,[["p",["黄水晶戒指是一种",["l","戒指","戒指"],"，可以在完成任务",["l","任务#Initiation","“入门”"],"后在",["l","探险家公会","探险家公会"],"以1,000金购买，也能在达到 ",["f","Fishing_Skill_Icon.png",24]," ",["l","钓鱼#钓鱼技能","钓鱼等级 2"]," 后在",["l","钓鱼#宝箱","钓鱼宝箱"],"中发现。"]],["p",["装备黄水晶戒指会使玩家获得 +1 ",["f","Defense.png",24]," ",["l","防御","防御"],"。"]],["p",["装备两个黄水晶戒指的增益效果可叠加，即防御+2。"]]]],["染色",2,[["p",["黄水晶戒指可用作",["l","染色#染料罐","染料罐"],"和",["l","染色#缝纫机","缝纫机"],"的橙色染料。"]]]],["趣闻",2,[["l",0,[[1,["1.6版本之前，装备黄水晶戒指的效果为增加10%武器精准度（降低未命中敌人的概率），但这个效果没有用处，因为正常情况下武器并不会随机地发生未命中敌人的情况。"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.6","1.6"],"：效果从10%武器精准调整为+1防御，物品描述也从“增加10%的武器精准度”更改。"]]]]]]]}