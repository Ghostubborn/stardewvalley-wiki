{"s":[[null,1,[["p",["松焦油是一种",["l","树","树"],"汁液，可以通过",["l","树液采集器","树液采集器"],"采集",["l","松树","松树"],"获得，耗时5天。通过",["l","重型树液采集器","重型树液采集器"],"采集时耗时2天。将",["l","硬木","硬木"],"放入",["l","碎木机","碎木机"],"分解时，也有小概率产生松焦油。"]],["p",["采集松焦油需要的",["l","松树","松树"],"，可以是玩家种植的，也可以是星露谷中自然生长的（比如",["l","煤矿森林","煤矿森林"],"、",["l","铁路","铁路"],"区域和",["l","木匠的商店","木匠的商店"],"周围）。"]],["p",["尽管松焦油在游戏中的标签是“工匠物品”，但它不受耕种的",["l","技能","工匠"],"技能加成，反而受采集的",["l","技能","萃取者"],"技能加成（+25%售价）。"]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","玛鲁","玛鲁"]]],[{"h":1,"v":["不喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]]]]]],["收集包",2,[["p",["松焦油用于异国情调采集收集包。"]]]],["配方",2,[["t",[[{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["所需原料"]},{"h":1,"v":["配方来源"]},{"h":1,"v":["售出价格"]}],[[["f","Loom.png",48]],[["l","织布机","织布机"]],["将动物毛转换成美丽的布料。"],[["i","(O)388","木材×60"],["i","(O)771","纤维×30"],["i","(O)726","松焦油×1"]],[["f","Farming_Skill_Icon.png",24]," ",["l","耕种","耕种等级"]," 7"],["N/A"]]]]]],["裁制",2,[["p",["松焦油可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["i","(H)54","宽松毛线帽"],"。松焦油可用于",["l","染色","染色"],"。放置在",["l","染色","染料罐"],"内时，松焦油可用作橙色染料。放置在",["l","染色","缝纫机"],"内时，松焦油还可用作棕色染料。"]]]],["任务",2,[["p",["饲养有",["l","木跃鱼","木跃鱼"],"的",["l","鱼塘","鱼塘"],"在数量从5达到7的时候，会出现要求玩家提供1个松焦油的",["l","鱼塘","鱼塘任务"],"。"]]]]],"f":[["来源",[["l","打造","打造"]]],["季节",["All"]],["加工设备",[["i","(BC)105","树液采集器"]," ",["i",