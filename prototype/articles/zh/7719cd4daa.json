{"s":[[null,1,[["p",["鹈鹕镇是游戏开始时玩家搬入的地点，它位于",["l","设定","星露谷"],"，大部分的",["l","居民","居民"],"都在此生活、工作和进行社交。"]],["p",[["l","刘易斯","刘易斯"],"已经做了很多年的鹈鹕镇镇长了，他声称从他上任起，就没遇到过竞争者。"]],["p",["小镇的西北入口通往",["l","巴士站","巴士站"],"和",["l","农场","农场"],"。西南方向通往",["l","煤矿森林","煤矿森林"],"，那里有",["l","玛妮的牧场","玛妮的牧场"],"，",["l","莉亚的农舍","莉亚的农舍"],"和",["l","法师塔","法师塔"],"。小镇的南方直接通向",["l","沙滩","沙滩"],"。小镇的北方通往",["l","深山","深山"],"，在那里有",["l","木匠的商店","木匠的商店"],"，",["l","矿井","矿井"],"，",["l","探险家公会","探险家公会"],"，",["l","铁路","铁路"],"和",["l","采石场","采石场"],"。"]],["p",["最开始，在",["l","柳巷2号","柳巷2号"],"附近区域，",["l","Joja超市","Joja超市"],"和",["l","柳巷1号","柳巷1号"],"屋后的区域，以及",["l","社区中心","社区中心"],"的西边，鹈鹕镇游乐场下边的区域生长有",["l","杂草","杂草"],"。这些杂草会在",["l","冬季","冬季"],"时死去，但在每个新年伊始又会重新生成。"]]]],["重要场所",2,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["居民"]}],[[["f","Pierres_shop_ZH.png",150]],[["l","皮埃尔的杂货店","皮埃尔的杂货店"]],[["l","皮埃尔","皮埃尔"],["l","卡洛琳","卡洛琳"],["l","阿比盖尔","阿比盖尔"]]],[[],[["l","哈维的诊所","哈维的诊所"]],[["l","哈维","哈维"]]],[[["f","Community_Center_ZH.png",200]],[["l","社区中心","社区中心"]],[["f","Junimo_Icon.png",32]," ",["l","祝尼魔","祝尼魔"]]],[[],[["l","博物馆","博物馆"]],[["l","冈瑟","冈瑟"]]],[[],[["l","铁匠铺","铁匠铺"]],[["l","克林特","克林特"]]],[[["f","Jojamart_ZH.png",200]],[["l","Joja超市","Joja超市"]],[["l","莫里斯","莫里斯"]]],[[],[["l","星之果实酒吧","星之果实酒吧"]],[["l","格斯","格斯"]]],[[["f","Bookseller.png",175]],["书摊"],[["f","Bookseller_Icon.png",24],["l","书摊老板","书摊老板"]]]]]]],["其他居民",2,[["t",[[{"h":1,"v":["名称"]},{"h":1,"v":["居民"]}],[[["l","河间大道1号","河间大道1号"]],[["l","亚历克斯","亚历克斯"],["l","艾芙琳","艾芙琳"],["l","乔治","乔治"]]],[[["l","拖车","拖车"]],[["l","潘姆","潘姆"],["l","潘妮","潘妮"]]],[[["l","镇长的庄园","镇长的庄园"]],[["l","刘易斯","刘易斯"]]],[[["l","柳巷1号","柳巷1号"]],[["l","乔迪","乔迪"],["l","肯特","肯特"],["l","山姆","山姆"],["l","文森特","文森特"]]],[[["l","柳巷2号","柳巷2号"]],[["l","艾米丽","艾米丽"],["l","海莉","海莉"]]]]]]],["垃圾清理熊",2,[["p",["在第三年没有下雨的第一天，垃圾清理熊会出现在",["l","煤矿森林","煤矿森林"],"的南部。玩家带上垃圾清理熊要求的四件物品可以触发一个过场动画。垃圾清理熊会清理煤矿森林和",["l","拖车","拖车"],"前院的垃圾。",["l","狗窝","狗窝"],"也会得到翻新。"]]]],["采集",2,[["g",[[null,0,["鹈鹕镇可采集物品生成位置的 导航地图"],"Town