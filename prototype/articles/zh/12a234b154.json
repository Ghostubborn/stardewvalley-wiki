{"s":[[null,1,[["p",["大树桩是树死去留下的遗迹，在",["l","农场","农场"],"、",["l","秘密森林","秘密森林"],"和",["l","矿井#挑战之神庙","危险的矿井"],"中常见。移除大树桩需要一把",["l","工具#斧头","铜斧"],"（或质量更好的斧头），移除大树桩后，会掉落2",["l","硬木","硬木"],"和25",["l","采集","采集"],"经验，10%的几率掉落",["l","桃花心木种子","桃花心木种子"],"。如果玩家选择了",["l","采集","护林人"],"职业，会有50%的几率额外掉落1",["l","硬木","硬木"],"。"]],["p",["以下大树桩每天刷新，提供持续硬木来源："]],["l",0,[[1,["秘密森林会出现六个可再生的大树桩；"]],[1,[["l","农场#Forest","森林农场"],"会在其西侧出现八个可再生的大树桩；"]],[1,[["l","农场#Four Corners","四角农场"],"会在其左上角区域出现一个可再生的大树桩。"]],[1,[["l","矿井#挑战之神庙","危险的矿井"],"41-69层可以找到大树桩。"]]]],["p",["其他农场上的大树桩不会刷新。"]]]],["趣闻",2,[["l",0,[[1,["大树桩是游戏中最硬，可存在时间最长的木头。"]],[1,["以下是不同材质的斧头砍倒一个大树桩需要的次数：","\n",["l","斧头","铜斧头"],"：7下","\n",["l","斧头","钢斧头"],"：5下","\n",["l","斧头","金斧头"],"：4下","\n",["l","斧头","铱斧头"],"：3下","\n","附魔了",["l","锻造","强力"],"的铱斧头：2下"]],[1,["若用普通的斧头砍大树桩，则会提示：你的斧头不够锋利，无法砍破这个树桩。"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.5","1.5"],"：砍破大树桩后有机会掉落桃花心木种子。"]]]]]]],"f":[["来源",[["l","农场#Forest","森林农场"]," • ",["l","秘密森林","秘密森林"]," • ",["l","矿井#挑战之神庙","危险的矿井"]]],["季节",["All"]]]}