{"s":[[null,1,[["p",["圆石是一种地物，可以在",["l","农场","农场"],"、",["l","矿井","矿井"],"或",["l","骷髅洞穴","骷髅洞穴"],"中找到。圆石是",["l","石头","石头"],"的一种来源，然而，击破圆石不会获得任何",["l","采矿","采矿"],"经验。"]]]],["农场上的圆石",2,[["p",["游戏开始时，农场上有许多的圆石，经常阻碍玩家通往其他地方的通道。移除圆石需要一把",["l","十字镐#钢十字镐","钢十字镐"],"或更好的十字镐。破坏会掉落 15 个",["l","石头","石头"],"。"]],["p",["农场上的圆石被移除后不会刷新，不过，稀有的",["l","随机事件#陨石","陨石"],"会偶尔出现在农场上。"]],["p",["若尝试使用普通的普通的十字镐或铜十字镐敲击圆石，则会提示：你的十字镐不够强大，无法敲碎这块巨石。"]]]],["矿井内的圆石",2,[["p",["任意品质的",["l","十字镐","十字镐"],"均可以击碎矿井内的圆石，并掉落 10 个",["l","石头","石头"],"。"]],["p",["下面是在矿井 1~39 层，81~119 层和",["l","骷髅洞穴","骷髅洞穴"],"中随机生成的圆石。"]],["g",[["Mine_Boulder_1.png",96,[]],["Mine_Boulder_2.png",96,[]]]],["p",["下面是在矿井 41~79 层生成的圆石。"]],["g",[["Mine_Boulder_3.png",96,[]],["Mine_Boulder_4.png",96,[]]]]]]],"f":[["地点",[["l","农场","农场"]," • ",["l","矿井","矿井"]," • ",["l","骷髅洞穴","骷髅洞穴"]]],["产出",[["i","(O)390","石头"],"（10 或 15）"]],["物品编号",["(BC)78"]]]}