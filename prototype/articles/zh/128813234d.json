{"s":[[null,1,[["p",["松露油是一种",["l","工匠物品","工匠物品"],"，通过将",["l","松露","松露"],"放入",["l","产油机","产油机"],"加工而成，加工需6小时。它有10%概率掉落自",["l","松露蟹","松露蟹"],"。",["l","沙漠节","沙漠节"],"期间，",["l","玛妮","玛妮"],"会在其",["l","沙漠节","商铺"],"以50卡利科蛋 ",["l","卡利科三花蛋","卡利科三花蛋"],"的价格出售松露油（限1瓶）。\n尽管松露油的描述为“佳肴必备的原料”，但它并不用于任何食谱，只用来制作",["l","雨水图腾","雨水图腾"],"。"]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","哈维","哈维"]]],[{"h":1,"v":["喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]],[{"h":1,"v":["讨厌"]},[["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"]]]]]]],["收集包",2,[["p",["松露油可用于工匠收集包。"]]]],["制造",2,[["p",["松露油可以用来制作下列物品:"]],["t",[[{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["所需原料"]},{"h":1,"v":["配方来源"]},{"h":1,"v":["售出价格"]}]]]]],["裁制",2,[["p",["松露油可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成可染色的 ",["l","裁缝","男款深色丝巾上衣"]," 或 ",["l","裁缝","女款深色丝巾上衣"],"。松露油还可用作",["l","染色","染料罐"],"和",["l","染色","缝纫机"],"的黄色染料。"]]]],["任务",2,[["l",0,[[1,["镇长",["l","刘易斯","刘易斯"],"会在第二年的",["l","夏季","夏季"],"21号来信向玩家要求一瓶松露油（即使玩家没有养",["l","猪","猪"],"），任务奖励是750金和一心好感度。"]]]]]]],"f":[["来源",[["l","工匠物品","工匠物品"]]],["加工设备",[["i","(BC)19","产油机"]]],["原料",[["i","(O)430","松露×1"]]],["加工时间",["360分钟 (6小时)"]],["售价",["1,065金"]]]}