{"s":[[null,1,[["p",["大葱是一种",["l","采集","可采集"],"物品，仅于",["l","春季","春季"],"出现在",["l","煤矿森林","煤矿森林"],"的东南部大岛屿（即",["l","下水道","下水道"],"入口北侧）。有别于其他可采集物品，大葱为每日刷新，也就是说所有未收获的大葱会在一天结束时被移除，新的大葱随即出现。",["l","电视","电视"],"节目",["l","离地而居","离地而居"],"会在游戏第4天给出关于大葱的建议。大葱也会在",["l","旅行货车","旅行货车"],"中以100–1,000金的价格随机出售。"]],["p",["收获1根大葱给予玩家3点采集经验值。每个大葱植株仅可收获1根大葱。",["l","技能","采集者"],"职业对大葱无效。"]],["p",["在游戏早期，玩家很难获得足够的食物，此时大葱是很好的补充能量的方法。"]],["p",["一旦玩家跟",["l","贾斯","贾斯"],"和",["l","文森特","文森特"],"都达到8心好感度，便可触发特殊剧情。之后会获得",["l","青葱技术","青葱技术"],"，可以让大葱的售出价格变为原来的五倍。"]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","莱纳斯","莱纳斯"],"、",["l","莉亚","莉亚"],"、",["l","哈维","哈维"]]],[{"h":1,"v":["不喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]]]]]],["用大葱果汁送礼",3,[["p",["大葱",["l","果汁","果汁"],"是可用于送礼的最便宜果汁。"]],["t",[[{"h":1,"v":["喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、