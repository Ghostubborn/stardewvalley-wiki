{"s":[[null,1,[["p",["墓园在",["l","镇长的庄园","镇长的庄园"],"西侧。墓园中有四座墓碑，其中三个墓碑可以交互。"]]]],["墓碑",2,[["p",["墓园在地图中占地大约300格，这里分布着四座墓碑。"]]]],["莫娜的墓碑",3,[["g",[["Monas_Grave.png",70,[]],["Grave.jpg",70,[]]]],["p",["这是个唯一有名字的墓碑，它坐落于其他三个墓碑之间。碑文写着："]],["q",["“我们亲爱的莫娜”"],[]],["p",[["l","阿比盖尔","阿比盖尔"],"六心事件过场动画中，可以看到她坐在这个墓碑旁边。"]]]],["古老且褪色的墓碑",3,[["g",[["Old_and_Faded_Gravestone.png",70,[]]]],["p",["如果你右键单击莫娜左边的墓碑，你会得到这样的信息："]],["q",["“很古老，而且都褪色了……”"],[]]]],["矮人墓碑",3,[["g",[["Dwarvish_Gravestone.png",70,[]]]],["p",["捐赠四个",["l","古物#古物","矮人卷轴"],"到",["l","博物馆","博物馆"],"，获得",["l","矮人语教程","矮人语教程"],"之后，就可以阅读莫娜右边的墓碑。"]],["q",["“你翻译了该段矮人语：\n\n站在三根柱子间，\n怀中礼物像天空一样珍贵：\n彩虹从陆地而不是海上升起，\n银河将会听见你的呼唤。 ”"],[]],["p",["这里指的是",["l","沙漠#三根柱子","卡利科沙漠东北的三根柱子"],"。手持",["l","五彩碎片","五彩碎片"],"站在柱子的中心时，五彩碎片会转化为",["l","银河剑","银河剑"],"。"]]]],["未知",3,[["g",[["Unknown_Gravestone.png",70,[]]]],["p",["玩家无法与左下角的墓碑交互。"]]]]]}