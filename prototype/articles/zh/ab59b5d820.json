{"s":[[null,1,[["p",["海盗帽是一种",["l","帽子","帽子"],"，玩家可以用",["l","布料","布料"],"和",["l","财宝箱","财宝箱"],"在",["l","缝纫机","缝纫机"],"上缝制该帽子。"]],["p",["这顶帽子还有小概率通过以下方式获得：击杀",["l","怪物","怪物"],"；",["l","矿井","打破木箱和木桶"],"；砍",["l","树","树"],"；摇晃树木；挖掘",["l","远古斑点","远古斑点"],"；",["l","淘盘","淘金"],"。"]]]],["秘密",2,[["d","详情",[["p",["戴着海盗帽与",["l","姜岛","海盗湾"],"里的海盗酒保对话，他会送给玩家一瓶",["l","蜜蜂酒","蜂蜜酒"],"（每天只能触发一次）。"]]]]]]]}