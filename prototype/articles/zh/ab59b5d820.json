{"s":[[null,1,[["p",["海盗帽是一顶",["l","帽子","帽子"],"，可以用",["l","布料","布料"],"和",["l","财宝箱","财宝箱"],"在",["l","缝纫机","缝纫机"],"上",["l","裁缝","裁制"],"获得。"]],["p",["这顶帽子还有小概率通过以下方式获得：击杀",["l","怪物","怪物"],"、打破矿井内的",["l","矿井#木箱和木桶","木箱和木桶"],"、摇晃或砍伐",["l","树","树"],"、使用",["l","锄头","锄头"],"挖掘",["l","远古斑点","远古斑点"],"、",["l","淘盘","淘金"],"。"]]]],["彩蛋",2,[["d","详情",[["p",["戴着海盗帽与",["l","姜岛#海盗湾","海盗湾"],"里的海盗酒保对话，他会送给玩家一瓶",["l","蜜蜂酒","蜂蜜酒"],"（每天只能触发一次）。"]]]]]],["历史",2,[["l",false,[[1,["1.4：加入游戏。"]],[1,["1.6：现在有小概率通过玩家的多种行为活动获得。"]]]]]]]}