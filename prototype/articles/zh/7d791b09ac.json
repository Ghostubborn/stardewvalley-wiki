{"s":[[null,1,[["p",["紫水晶戒指是一种",["l","戒指","戒指"],"，可以在完成任务",["l","任务","“入门”"],"后在",["l","探险家公会","探险家公会"],"以1,000金购买，也能在达到 ",["f","Fishing_Skill_Icon.png",24]," ",["l","钓鱼","钓鱼等级 2"]," 后在",["l","钓鱼","钓鱼宝箱"],"中发现。打开",["l","谜之盒","谜之盒"],"也有概率获得。"]],["p",["装备紫水晶戒指会使玩家获得增加 10% ",["f","Weight.png",24]," ",["l","重量","击退"],"率的效果。"]],["p",["装备第二个紫水晶戒指可额外增加10%击退效果，总计提升20%。"]]]],["染色",2,[["p",["紫水晶戒指可用作",["l","染色","染料罐"],"和",["l","染色","缝纫机"],"的紫色染料。"]]]]]}