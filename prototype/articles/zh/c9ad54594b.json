{"s":[[null,1,[["p",["大蒜种子是一种种子，播种并生长 4 天成熟后可以获得",["l","蒜","蒜"],"。大蒜种子可以从第二年起在",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"和",["l","冬季","冬季"]," 15 日",["l","夜市#魔法商船","夜市上的魔法商船"],"处买到。"]],["p",[["l","旅行货车","旅行货车"],"会以 ",["f","Gold.png",18],"100 ~ ",["f","Gold.png",18],"1,000 的价格随机出售 1 个或 5 个大蒜种子 。大蒜种子也可以通过将蒜放入",["l","种子生产器","种子生产器"],"中获得。在",["l","骷髅洞穴#宝藏房间","骷髅洞穴"],"的宝箱层里打开宝箱也可能会获得 5~20 个大蒜种子。在",["l","矿井#挑战之神庙","危险的矿井"],"或",["l","骷髅洞穴","危险的骷髅洞穴"],"中击杀",["l","矿井#特殊物品","特殊怪物"],"（",["l","史莱姆#特殊史莱姆","特殊史莱姆"],"会有黄色星形触角的明显特征，其他特殊怪物与正常怪物无明显差异）也有概率获得大蒜种子。"]]]],["生长阶段",2,[["t",[[{"h":1,"v":["阶段 1"]},{"h":1,"v":["阶段 2"]},{"h":1,"v":["阶段 3"]},{"h":1,"v":["阶段 4"]},{"h":1,"v":["收获"]}],[[["f","Garlic_Stage_1.png",48]],[["f","Garlic_Stage_2.png",48]],[["f","Garlic_Stage_3.png",48]],[["f","Garlic_Stage_4.png",48]],[["f","Garlic_Stage_5.png",48]],[["f","Garlic.png",48]]],[["1 天"],["1 天"],["1 天"],["1 天"],["共 4 天"]]]]]],["送礼",2,[["t",[[{"h":1,"c":2,"v":["收到大蒜种子后"]}],[{"h":1,"v":["不喜欢\n-20"]},[["f","Harvey_Icon.png",24]," ",["l","哈维","哈维"]," • ",["f","Sam_Icon.png",24]," ",["l","山姆","山姆"]," • ",["f","Shane_Icon.png",24]," ",["l","谢恩","谢恩"]," • ",["f","Alex_Icon.png",24]," ",["l","亚历克斯","亚历克斯"]," • ",["f","Elliott_Icon.png",24]," ",["l","艾利欧特","艾利欧特"]," • ",["f","Sebastian_Icon.png",24]," ",["l","塞巴斯蒂安","塞巴斯蒂安"]," • ",["f","Haley_Icon.png",24]," ",["l","海莉","海莉"]," • ",["f","Leah_Icon.png",24]," ",["l","莉亚","莉亚"]," • ",["f","Maru_Icon.png",24]," ",["l","玛鲁","玛鲁"]," • ",["f","Penny_Icon.png",24]," ",["l","潘妮","潘妮"]," • ",["f","Emily_Icon.png",24]," ",["l","艾米丽","艾米丽"]," • ",["f","Abigail_Icon.png",24]," ",["l","阿比盖尔","阿比盖尔"]," • ",["f","Pierre_Icon.png",24]," ",["l","皮埃尔","皮埃尔"]," • ",["f","Caroline_Icon.png",24]," ",["l","卡洛琳","卡洛琳"]," • ",["f","Lewis_Icon.png",24]," ",["l","刘易斯","刘易斯"]," • ",["f","Marnie_Icon.png",24]," ",["l","玛妮","玛妮"]," • ",["f","Robin_Icon.png",24]," ",["l","罗宾","罗宾"]," • ",["f","Demetrius_Icon.png",24]," ",["l","德米特里厄斯","德米特里厄斯"]," • ",["f","Evelyn_Icon.png",24]," ",["l","艾芙琳","艾芙琳