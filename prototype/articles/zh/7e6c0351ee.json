{"s":[[null,1,[["p",["小巷自助餐是一本",["l","书","能力之书"],"，可以在",["l","Joja超市","Joja超市"],"和",["l","铁匠铺","铁匠铺"],"之间被树挡住的黄金垃圾桶中找到，需要通过一个隐藏在栅栏上的洞。进入该区域之后，需要升级到至少钢制斧头和钢制镐子才能清除道路上的",["l","大圆木","大圆木"],"和",["l","圆石","大石块"],"。玩家也可以用 20,000金 从",["l","书摊老板","书摊老板"],"处购买这本书（出现概率为 ~9%）。"]],["p",["首次阅读后，玩家在垃圾桶里找到物品的概率增加 20%。并且它会在特殊物品和能力的选项卡上被点亮。再次阅读可以提供 100点 ",["f","Foraging_Skill_Icon.png",20]," ",["l","技能","采集经验值"],"。"]],["g",[[null,0,["位置示意图"],"ThewaytoTheAlleywayBuffet.png"]]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","莱纳斯","莱纳斯"],"、",["l","潘妮","潘妮"]]],[{"h":1,"v":["喜欢"]},[["l","艾利欧特","艾利欧特"]]],[{"h":1,"v":["一般"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","雷欧","雷欧"],"、",["l","克林特","克林特"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","肯特","肯特"],"、",["l","玛妮","玛妮"],"、",["l","格斯","格斯"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","山姆","山姆"],"、",["l","谢恩","谢恩"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","哈维","哈维"]]],[{"h":1,"v":["不喜欢"]},[["l","亚历克斯","亚历克斯"]]]]]]],["收集包",2,[["p",["小巷自助餐不用于任何",["l","收集包","收集包"],"。"]]]],["裁制",2,[["p",["小巷自助餐不用于任何",["l","裁缝","裁缝"],"。可用于",["l","染色","染色"],"。放置在",["l","染色","染料罐"],"内时，它可用作深灰色染料。放置在",["l","染色","缝纫机"],"内时，它还可用作深灰色染料。"]]]],["任务",2,[["p",["小巷自助餐不用于任何",["l","任务","任务"],"。"]]]]],"f":[["来源",[["l","鹈鹕镇","鹈鹕镇"]," · ",["l","书摊老板","书摊老板"]]],["售价",["3,000金"]]]}