{"s":[[null,1,[["p",["野炊工具是一种可消耗的",["l","打造","打造"],"品，可以用来制造一个可用于烹饪的篝火，以",["l","农舍","农舍"],"之外的其他地方进行",["l","烹饪","烹饪"],"。野炊工具的制造配方可以在达到采集 3 级后解锁。"]],["p",["放置后的野炊工具会在次日消失，玩家也可通过空手多次点击或使用工具手动摧毁，摧毁之后不会有任何掉落物。"]],["p",["完成野生药材收集包后，可以获得 2 个野炊工具作为奖励。"]]]],["送礼",2,[["t",[[{"h":1,"v":["讨厌"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]]]]]],["画廊",2,[["g",[["Campfire_Cooker.png",48,["放置后的野炊工具"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.5#1.5","1.5"],"：加入游戏。"]],[1,[["l","版本历史/1.5#1.5.2","1.5.2"],"：其售出价格从3,000金降低到80金。"]],[1,[["l","版本历史#1.6","1.6"],"：配方获取从",["l","采集#采集技能","采集"],"等级9修改成等级3。"]]]]]]],"f":[["来源",[["l","打造","打造"]]],["原料",[["i","(O)388","木材×15"],["i","(O)771","纤维×10"],["i","(O)382","煤炭×3"]]],["售价",["80金"]]]}