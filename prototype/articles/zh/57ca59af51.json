{"s":[[null,1,[["p",["软木塞浮标是一种",["l","渔具","渔具"],"，可以使玩家在",["l","钓鱼","钓鱼"],"时的",["l","钓鱼#绿条尺寸","绿条尺寸"],"增加 24 像素。达到钓鱼 7 级后可以通过",["l","打造","打造"],"获得，此后即可在",["l","鱼店","鱼店"],"以750金购买。"]],["p",["旅行货车会以 750–1,250金 的价格随机出售。在达到钓鱼 6 级打开",["l","谜之盒","谜之盒"],"和",["l","金色谜之盒","金色谜之盒"],"后也有概率获得 1 个软木塞浮标。"]],["p",["如果在",["l","高级铱金鱼竿","高级铱金鱼竿"],"中装备两个软木塞浮标，则绿条尺寸增加 48 像素。"]],["p",["只有",["l","铱金鱼竿","铱金鱼竿"],"和",["l","高级铱金鱼竿","高级铱金鱼竿"],"可以装备",["l","渔具","渔具"],"。铱金鱼竿每次只能装备一个渔具，而高级铱金鱼竿能装备两个。要装上渔具时，先鼠标左键点击渔具，然后鼠标右键点选鱼竿。要卸下渔具时，先鼠标右键点击鱼竿卸下鱼饵，再次右键点击鱼竿就可以卸下渔具。如果是移除",["l","高级铱金鱼竿","高级铱金鱼竿"],"的钓具，会先移除左边的。"]],["p",["渔具不能在",["l","物品栏","物品栏"],"或",["l","宝箱","箱子"],"中堆叠，每个渔具占据一个空格。"]]]],["送礼",2,[["t",[[{"h":1,"v":["不喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]]]]]],["收集包",2,[["p",["软木塞浮标不用于任何",["l","收集包","收集包"],"。"]]]],["任务",2,[["p",["软木塞浮标不用于任何",["l","任务","任务"],"。"]]]],["注意",2,[["l",0,[[1,["这个配方是有利润的，利润为105金。不过，将",["l","史莱姆泥","史莱姆泥"],"压成",["l","史莱姆蛋","史莱姆蛋"],"并将硬木放入",["l","碎木机","碎木机"],"中加工，其平均利润会更高。"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.0#1.0","1.0"],"：加入游戏。"]],[1,[["l","版本历史#1.6","1.6"],"：同时装备两个软木塞浮标可使钓鱼绿条尺寸增加48像素。"]]]]]]],"f":[["来源",[["l","打造","打造"]," • ",["l","鱼店","鱼店"]]],["原料",[["i","(O)388","木材×10"],["i","(O)709","硬木×5"],["i","(O)766","史莱姆泥×10"]]],["售价",["250金"]]]}