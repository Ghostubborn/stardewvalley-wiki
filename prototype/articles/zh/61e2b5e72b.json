{"s":[[null,1,[["p",["枫糖浆是一种",["l","树","树"],"汁液，可以通过",["l","树液采集器","树液采集器"],"采集",["l","枫树","枫树"],"获得，耗时9天。通过",["l","重型树液采集器","重型树液采集器"],"采集时耗时4天。将",["l","硬木","硬木"],"放入",["l","碎木机","碎木机"],"分解时，也有小概率产生枫糖浆。"]],["p",["采集枫糖浆需要的",["l","枫树","枫树"],"，可以是玩家种植的，也可以是星露谷中自然生长的（比如",["l","煤矿森林","煤矿森林"],"）。"]],["p",["尽管枫糖浆在游戏中的标签是“工匠物品”，但它不受耕种的",["l","技能#耕种","工匠"],"技能加成，反而受采集的",["l","技能#采集","萃取者"],"技能加成（+25%售价）。"]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]],[{"h":1,"v":["不喜欢"]},[["l","玛鲁","玛鲁"]]]]]]],["收集包",2,[["p",["它被用于厨师收集包，同时也是异国情调采集收集包的选择之一。"]]]],["配方",2,[]],["烹饪",3,[["t",[[{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["所需原料"]},{"h":1,"v":["能量 / 生命值"]},{"h":1,"v":["增益效果"]},{"h":1,"v":["增益时长"]},{"h":1,"v":["食谱来源"]},{"h":1,"v":["售出价格"]}],[[["l","枫糖棒","枫糖棒"]],["浇上枫糖的甜甜圈。"],[["i","(O)724","枫糖浆×1"],["i","(O)245","糖×1"],["i","(O)246","大麦粉×1"]],["能量 225\n生命值 101"],[["l","耕种","耕种（+1）"],["l","钓鱼","钓鱼（+1）"],["l","采矿","采矿（+1）"]],["16分47秒"],["烹饪频道（偶数年夏季14日）"],["300金"]]]]]],["制造",3,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["材料"]},{"h":1,"v":["配方来源"]}],[[["f","Bee_House.png",48]],[["l","蜂房","蜂房"]],["置放在屋外，然后等着吃甜蜜的蜂蜜吧！（除了冬天）。"],[["i","(O)388","木材×40"],["i","(O)382","煤炭×8"],["i","(O)335","铁锭×1"],["i","(O)724","枫糖浆×1"]],[["f","Farming_Skill_Icon.png",24]," ",["l","技能#耕种