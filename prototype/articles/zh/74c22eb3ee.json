{"s":[[null,1,[["p",["紫蘑菇是一种",["l","采集","采集品"],"，可以在",["l","农场地图#Forest","森林农场"],"西侧、",["l","矿井","矿井"],"（81 层开始）、",["l","骷髅洞穴","骷髅洞穴"],"或姜岛的",["l","姜岛#挖掘场","蘑菇洞"],"里",["l","采集","采集"],"获得。周围存在枫树或神秘树的",["l","蘑菇树桩","蘑菇树桩"],"也可能产出紫蘑菇。也可以在",["l","蘑菇树","蘑菇树"],"上放置树液采集器或砍伐蘑菇树获得。如果玩家选择了",["l","山洞#蘑菇","蘑菇"],"类型的",["l","山洞","农场山洞"],"，那么还可以在",["l","山洞","山洞"],"中获得紫蘑菇。"]],["p",["旅行货车会以 750–1,250金 的价格随机出售。在抵达矿井 40 层以后，翻动",["l","垃圾桶","垃圾桶"],"时也有概率找到紫蘑菇。当与",["l","法师","法师"],"的友谊值大于 0 时，他可能会随信赠送一个紫蘑菇作为礼物。在",["l","冬日星盛宴","冬日星盛宴"],"上，如果给玩家送礼物的村民是除",["l","克林特","克林特"],"、",["l","艾芙琳","艾芙琳"],"、",["l","玛妮","玛妮"],"、",["l","罗宾","罗宾"],"或",["l","威利","威利"],"以外的成人，玩家也可能获得一个紫蘑菇。"]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","法师","法师"]]],[{"h":1,"v":["喜欢"]},[["l","德米特里厄斯","德米特里厄斯"],"、",["l","哈维","哈维"],"、",["l","莉亚","莉亚"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛鲁","玛鲁"]]],[{"h":1,"v":["一般"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","克林特","克林特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","肯特","肯特"],"、",["l","刘易斯","刘易斯"],"、",["l","玛妮","玛妮"],"、",["l","潘姆","潘姆"],"、",["l","罗宾","罗宾"],"、",["l","桑迪","桑迪"]]],[{"h":1,"v":["不喜欢"]},[["l","卡洛琳","卡洛琳"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","山姆","山姆"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"]]]]]]],["收集包",2,[["l",0,[[1,["土地研究收集包需要 1 个紫蘑菇；"]],[1,["异国情调采集收集包需要 1 个紫蘑菇（作为可选项）；"]],[1,["野生药材收集包需要 1 个紫蘑菇（作为可选项）。"]]]]]],["打造",2,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["材料"]},{"h":1,"v":["能量 / 生命值"]},{"h":1,"v":["配方来源"]},{"h":1,"v":["售价"]}],[[["f","Life_Elixir.png",48]],[["l","生命药水","生命药水"]],["恢复全部的生命值。"],[["i","(O)420","红蘑菇×1"],["i","(O)422","紫蘑菇×1"],["i","(O)257","羊肚菌×1"],["i","(O)281","鸡油菌×1"]],[["f","Energy.png",24]," 0 \n",["f","Health.png",24]," 100%"],[["f","Combat_Skill_Icon.png",24]," ",["l","战斗","战斗"]," 2 级"],["250金"]]]]]],["裁制",2,[["p",["紫蘑菇可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","上衣"],"。紫蘑菇还可用作",["l","染色#染料罐","染料罐"],"和",["l","染色#缝纫机","缝纫机"],"的紫色染料。"]]]],["任务",2,[["l",0,[[1,["紫蘑菇可能会在任何季节出现在",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"外边的",["l","任务#求助任务","“布告栏”"],"上的随机任务中。任务完成的奖励是 750金 和 150",["l","友谊","友谊点"],"。在你达到矿井40层及以上之前，紫蘑菇不会出现在布告栏中。"]],[1,["饲养有",["l","鲶鱼","鲶鱼"],"、",["l","章鱼","章鱼"],"、",["l","虹鳟鱼","虹鳟鱼"],"、",["l","幽灵鱼","幽灵鱼"],"或",["l","大海参","大海参"],"的",["l","鱼塘","鱼塘"],"在数量从5提升到7时，会出现要求玩家提供2~3个紫蘑菇的",["l","鱼塘#任务","鱼塘任务"],"。"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.4#1.4","1.4"],"：现在可用于",["l","裁缝","裁缝"],"。现在是",["l","鱼塘#任务","鱼塘任务"],"需求物品。"]],[1,[["l","版本历史/1.5#1.5","1.5"],"：现在可以在姜岛的蘑菇洞中找到。现在是野生药材收集包的可选物品之一。"]],[1,[["l","版本历史#1.6","1.6"],"：现在可由",["l","蘑菇树桩","蘑菇树桩"],"产出。现在",["l","玛鲁","玛鲁"],"喜欢紫蘑菇。现在紫蘑菇可以制成腌菜。现在收获农场山洞的蘑菇给予5点采集经验值。"]]]]]]],"f":[["来源",[["l","采集","采集"]," • ",["l","山洞","山洞"]," • ",["l","蘑菇树","蘑菇树"]," • ",["l","蘑菇树桩","蘑菇树桩"]]],["季节",["任意季节"]],["售价",["250金"]]]}