{"s":[[null,1,[["p",["煤炭是一种资源，广泛用于各种物品的",["l","打造","打造"],"，并且是在",["l","熔炉","熔炉"],"和",["l","重型熔炉","重型熔炉"],"中熔炼物品以及在",["l","熏鱼机","熏鱼机"],"中熏鱼的必要材料。煤炭可以通过",["l","采矿","采矿"],"获得，也可以直接从",["l","铁匠铺","铁匠铺"],"购买。"]]]],["获取",2,[["l",0,[[1,["在",["l","铁匠铺","铁匠铺"],"直接购买，第一年售价为150金，第二年起售价为250金"]],[1,["在",["l","采石场","采石场"],"、",["l","采石场矿井","采石场矿井"],"和",["l","火山地牢","火山地牢"],"中开采",["l","采矿#Coal Node","煤矿"]]],[1,["在任意位置开采普通岩石。从多数岩石中找到煤炭的概率会受到",["l","运气#每日运气","每日运气"],"、",["l","运气#运气增益","运气增益"],"、",["l","技能#采矿","采矿等级"],"、",["l","采矿#采矿技能","勘探者职业"],"以及",["l","矮人之王雕像","矮人之王雕像"],"的影响"]],[1,["在",["l","矿井","矿井"],"、",["l","采石场矿井","采石场矿井"],"、",["l","骷髅洞穴","骷髅洞穴"],"和",["l","火山地牢","火山地牢"],"中打破",["l","矿井#木箱和木桶","木箱和木桶"]]],[1,["在矿井特定层和",["l","骷髅洞穴","骷髅洞穴"],"随机层中收取装满煤的矿车或棕色矿工包，每个矿车和矿工包中都可获得 6 个煤炭。矿井里的矿车会在每年刷新其内容物，而矿工包则不会"]],[1,["击杀怪物有概率掉落煤炭，详细概率如下："]],[2,[["l","灰尘精灵","灰尘精灵（50%）"]]],[2,["红色史莱姆（10%）"]],[2,["紫色史莱姆（10%）"]],[2,["黑色史莱姆（10%）"]],[2,[["l","石魔","石魔（10%）"]]],[2,[["l","荒野石魔","荒野石魔（10%）"]]],[2,[["l","铱石魔","铱石魔（10%）"]]],[2,[["l","金属大头","金属大头（10%）"]]],[2,[["l","熔岩大头","熔岩大头（10%）"]]],[1,["使用",["l","煤炭窑","煤炭窑"],"焚烧 10 个",["l","木材","木材"],"获得"]],[1,["在",["l","边远森林","边远森林"],"、",["l","煤矿森林","煤矿森林"],"、",["l","深山","深山"],"或",["l","农场","农场"],"中挖掘",["l","远古斑点","远古斑点"]]],[1,["在任意区域",["l","淘盘","淘金"]]],[1,["打开",["l","钓鱼#宝箱","钓鱼宝箱"],"或",["l","钓鱼#金宝箱","金色钓鱼宝箱"]]],[1,["在",["l","回收机","回收机"],"中回收",["l","垃圾（物品）","垃圾"],"（30% 概率）或",["l","浮木","浮木"],"（25% 概率）"]],[1,["打开任意类型的",["l","矿物#晶球","晶球"]]],[1,["旅行货车会以 100–1,000金 的价格随机出售"]],[1,["在",["l","书摊老板","书摊老板"],"处使用 1 本",["l","采矿月刊","采矿月刊"],"兑换 20 个煤炭"]],[1,[["l","沙漠节","沙漠节"],"期间，",["l","克林特","克林特"],"会在其",["l","沙漠节#村民商铺","商铺"],"以5卡利科蛋 ",["l","卡利科三花蛋","卡利科三花蛋"],"的价格出售煤炭（限 50 个）"]],[1,["当",["l","果树","果树"],"被",["l","闪电","闪电"],"击中后，若当前季节不是冬季，则其将在接下来的 4 天内每天产出一个煤炭"]],[1,["翻动铁匠铺外的",["l","垃圾桶","垃圾桶"],"有约 6.67% 的概率找到 1~4 个煤炭"]],[1,[["l","铁路","铁路"],"上驶过的火车有一定概率掉落"]]]],["p",["第 1 年铁匠铺的煤炭售价为150金，而",["l","木材","木材"],"的售价为10金，故此时花费100金 从",["l","木匠的商店","木匠的商店"],"购买 10 个木材，然后用",["l","煤炭窑","煤炭