{"s":[[null,1,[["p",["番红花是在",["l","冬季","冬季"],"通过",["l","采集","采集"],"找到的",["l","花","花"],"。番红花可在",["l","鹈鹕镇","鹈鹕镇"],"、",["l","铁路","铁路"],"、",["l","巴士站","巴士站"],"、",["l","深山","深山"],"、",["l","煤矿森林","煤矿森林"],"或",["l","边远森林","边远森林"],"找到。也可通过种植",["l","冬季种子","冬季野生种子"],"来获得番红花。在冬季翻动",["l","垃圾桶","垃圾桶"],"也有概率找到番红花。"]]]],["治疗效果",2,[["p",["番红花是可食用的，但不会增加能量或健康。"]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","桑迪","桑迪"]]],[{"h":1,"v":["喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]],[{"h":1,"v":["不喜欢"]},[["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","乔治","乔治"],"、",["l","克林特","克林特"]]]]]]],["收集包",2,[["p",["它用于冬季采集收集包。"]]]],["配方",2,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名字"]},{"h":1,"v":["描述"]},{"h":1,"v":["原料"]},{"h":1,"v":["配方来源"]},{"h":1,"v":["售价"]}],[[["f","Winter_Seeds.png",48]],[["l","冬季种子","冬季种子"]],["各种各样的冬季种子。\n（每次制作产生10个冬季种子）"],[["i","(O)418","番红花×1"],["i","(O)414","水晶果×1"],["i","(O)416","雪山药×1"],["i","(O)412","冬根×1"]],[["f","Foraging_Skill_Icon.png",24]," ",["l","采集","采集"]," Level 7"],["30金"]]]]]],["裁制",2,[["p",["番红花可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","上衣"],"。番红花可用于",["l","染色","染色"],"。放置在",["l","染色#染料罐","染料罐"],"内时，番红花可用作紫色染料。放置在",["l","染色#缝纫机","缝纫机"],"内时，番红花还可用作紫色染料，染色强度为中等。"]]]],["任务",2,[["l",0,[[1,["番红花会在冬季出现在",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"外边的",["l","任务#求助任务","“布告栏”"],"上的随机任务，完成任务可以获得 180金 和 150 ",["l","友谊","友谊点"],"。"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.4","1.4"],"：现在在裁缝中可用。"]]]]]]]