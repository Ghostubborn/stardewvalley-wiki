{"s":[[null,1,[["p",["齐豆是一种种子，在特别任务",["l","任务","“齐先生的作物”"],"期间在星露谷和",["l","姜岛","姜岛"],"上发现。"]],["p",["在任务进行期间，齐豆可以通过击碎石头、砍倒",["l","树","树"],"或树桩、破坏",["l","杂草","杂草"],"、翻",["l","垃圾桶","垃圾桶"],"、击杀",["l","怪物","怪物"],"、敲开",["l","矿物","晶球"],"/",["l","古物宝藏","古物宝藏"],"/",["l","金色椰子","金色椰子"],"/",["l","谜之盒","谜之盒"],"/",["l","金色谜之盒","金色谜之盒"],"、挖掘",["l","远古斑点","远古斑点"],"、摇晃",["l","姜岛","姜岛"],"的",["l","棕榈树","棕榈树"],"、在",["l","火山地牢","火山地牢"],"内打开",["l","火山地牢","宝箱"],"或击碎",["l","火山地牢","金属板条箱"],"，以及",["l","钓鱼","钓鱼"],"等方式获得。也可以将",["l","齐瓜","齐瓜"],"放入",["l","种子生产器","种子生产器"],"中来制造。"]],["p",["任务结束时（即玩家售出它们或任务计时器结束的第二天），所有",["l","齐瓜","齐瓜"],"和齐豆都会消失，包括种植作物、所有玩家的",["l","物品栏","物品栏"],"、",["l","宝箱","宝箱"],"、",["l","罐头瓶","罐头瓶"],"、",["l","小桶","小桶"],"和",["l","马龙","马龙"],"的",["l","探险家公会","物品找回服务"],"列表。",["l","农作物","巨大齐瓜"],"不会消失。"]]]],["生长阶段",2,[["p",["齐瓜可以长成",["l","农作物","巨大作物"],"。"]],["t",[[{"h":1,"v":["阶段 1"]},{"h":1,"v":["阶段 2"]},{"h":1,"v":["阶段 3"]},{"h":1,"v":["阶段 4"]},{"h":1,"v":["收获"]}],[["1 天"],["1 天"],["1 天"],["1 天"],["总计: 4 天"]]]]]],["送礼",2,[["t",[[{"h":1,"v":["不喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]]]]]],["染色",2,[["p",["齐豆可用作",["l","染色","染料罐"],"和",["l","染色","缝纫机"],"的蓝色染料。"]]]],["提示",2,[["l",0,[[1,["鉴于",["l","钓鱼","钓鱼宝箱"],"在任务期间有 48% 的几率产生一组最多 4 个齐豆，当与",["l","磁铁","磁铁"],"鱼饵、",["l","技能","海盗职业"],"和",["l","寻宝者","寻宝者"],"渔具相结合时，钓鱼是齐豆的一个可靠来源。"]],[1,["将齐瓜放入",["l","种子生产器","种子生产器"],"中，并种植所产生的齐豆，平均而言，齐瓜的产量将增加一倍。在任务初期种出的齐瓜可以用这种方法翻倍。"]],[1,["敲开任何种类的",["l","矿物","晶球"],"可能会开出 1 个或 5 个齐豆。"]],[1,["使用",["l","生长激素","生长激素"],"、",["l","高级生长激素","高级生长激素"],"或",["l","顶级生长激素","顶级生长激素"],"，以及",["l","技能","农业学家职业"],"可以将生长周期缩短 1~2 天。"]],[1,["齐豆也可以使用",["l","宝藏图腾","宝藏图腾"],"来快速获得。在任务中，",["l","远古斑点","远古斑点"],"有25%的机会掉落2-5个齐豆，所以每个图腾平均会产生14个齐豆，假设没有障碍物阻挡16格中的任何1格的话。"]]]]]]]}