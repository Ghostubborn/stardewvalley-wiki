{"s":[[null,1,[["p",["海草可以在任何季节，通过在",["l","沙滩","海边"],["l","钓鱼","钓鱼"],"获得。在",["l","冬季","冬季"],"的",["l","夜市","夜市"],"的钓鱼潜水艇上钓鱼，将有41%的机率钓到海草。",["l","蟹笼","蟹笼"],"不能捕获海草。"]],["p",["海草会在海滩的",["l","沙滩#潮汐池","潮汐池"],"南边狭长的海岸上生成，但此处生成海草的概率相当低（每晚只有3%的几率）。当",["l","鱼塘","鱼塘"],"内饲养的",["l","鸟蛤","鸟蛤"],"、",["l","螃蟹","螃蟹"],"、",["l","龙虾","龙虾"],"、",["l","蚌","蚌"],"、",["l","牡蛎","牡蛎"],"或",["l","虾","虾"],"等咸水鱼（",["l","鱼#蟹笼鱼类","蟹笼鱼类"],"）数量至少1个的时候，鱼塘产出1~3个海草的几率是8.8%。"]],["p",["使用",["l","钓鱼#钓鱼竿","钓鱼竿"],"钓到海草只能获得3点",["l","钓鱼#经验值","钓鱼经验值"],"，以及一个普通品质的海草。从",["l","沙滩#采集","沙滩"],"上经",["l","采集","采集"],"捡起一个海草能获得7点",["l","钓鱼#经验值","钓鱼经验值"],"，海草的品质则会因为",["l","采集","采集"],"技能的等级不同而不同（可能会捡到铱星品质的海草）。"]],["p",["在任何季节的任何时间，翻动",["l","垃圾桶","垃圾桶"],"也有概率找到海草。"]],["p",["海草会显示在",["l","收集品#鱼","收集品 - 鱼"],"的页面之中，并计入和钓鱼相关的四个成就之中。然而，除了上述情况之外，海草不会被分类为",["l","鱼","鱼类"],"，因此玩家不能把海草卖给",["l","鱼店","鱼店"],"的",["l","威利","威利"],"。"]],["p",["海草可以作为装饰品放入",["l","鱼缸","鱼缸"],"中。"]]]],["地图",2,[["p",["海草可以在海洋和",["l","沙滩","沙滩"],"上找到。"]]]],["送礼",2,[["t",[[{"h":1,"v":["不喜欢"]},[["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"]]],[{"h":1,"v":["讨厌"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","雷欧","雷欧"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"]]]]]]],["收集包",2,[["p",["海草不用于任何",["l","收集包","收集包"],"。"]]]],["食谱",2,[["t",[[{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["所需原料"]},{"h":1,"v":["能量 / 生命值"]},{"h":1,"v":["食谱来源"]},{"h":1,"v":["售出价格"]}],[[["l","生鱼寿司","生鱼寿司"]],["紫菜裹着的鱼和米饭。"],[["f","Fish