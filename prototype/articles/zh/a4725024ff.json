{"s":[[null,1,[["n",["关于工作效率更高的树液采集设备，请见 “",["l","重型树液采集器","重型树液采集器"],"”。"]],["p",["树液采集器是一种",["l","打造#精炼设备","精炼设备"],"，可以放置在不同的",["l","树","树"],"上采集各种树脂产品，特别的，当放置在",["l","桃花心木树","桃花心木树"],"上时会产出",["l","树液","树液"],"、放在",["l","蘑菇树","蘑菇树"],"上时会产出各种蘑菇、放置在",["l","绿雨树","蕨菜树"],"上时会产出",["l","蕨菜","蕨菜"],"。树液采集器的制造配方可以在达到",["f","Foraging_Skill_Icon.png",24]," ",["l","采集","采集"]," 4 级后解锁。"]],["p",["可以使用",["l","斧头","斧头"],"或",["l","十字镐","十字镐"],"来把树液采集器从树上移除。"]],["p",["如果挂有树液采集器的树被",["l","闪电","闪电"],"击中或被",["l","打造#炸弹","炸弹"],"影响，则采集器及其产出物品均会被破坏。"]],["p",["放置在",["l","枫树","枫树"],"、",["l","橡树","橡树"],"、",["l","松树","松树"],"和",["l","桃花心木树","桃花心木树"],"上的树液采集器在",["l","冬季","冬季"],"可继续工作。由于",["l","蘑菇树","蘑菇树"],"和",["l","绿雨树","蕨菜树"],"在",["l","冬季","冬季"],"会变成树桩，因此放在上面的树液采集器在冬季不会继续工作。"]],["p",["即使中途经历绿雨变成了绿雨树，树液采集器也会按时产出原本的产物。但是在变成绿雨树时收获产物无法开始一轮新的工作。"]]]],["产品",2,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["来源"]},{"h":1,"v":["时间"]},{"h":1,"v":["售价"]},{"h":1,"v":["恢复"]}],[[["f","Maple_Syrup.png",48]],[["l","枫糖浆","枫糖浆"]],["有着独特风味的甜浆。"],[["l","枫树","枫树"]],["9天"],[["f","Gold.png",18],"200"],[["f","Energy.png",24],"50",["f","Health.png",24],"20"]],[[["f","Oak_Resin.png",48]],[["l","橡树树脂","橡树树脂"]],["从橡树树液中提取的粘稠、芬芳的物质。"],[["l","橡树","橡树"]],["7天"],[["f","Gold.png",18],"150"],["非食用"]],[[["f","Pine_Tar.png",48]],[["l","松焦油","松焦油"]],["从松树树液中提取的刺鼻的物质。"],[["l","松树","松树"]],["5天"],[["f","Gold.png",18],"100"],["非食用"]],[[["f","Sap.png",48]],[["l","树液","树液"]],["树里取出来的液体。"],[["l","桃花心木树","桃花心木树"]],["1 天"],[["f","Gold.png",18],"2"],[["f","Poison.png",24]," -2"]],[[["f","Common_Mushroom.png",48]],[["l","普通蘑菇","普通蘑菇"]],["稍微坚硬，肉质滑。"],[["l","蘑菇树","蘑菇树"]],["时间不定，详见",["l","蘑菇树#Tapper_Product","蘑菇树"]],[["f","Gold.png",18],"40"],[["f","Energy.png",24],"38",["f","Health.png",24],"17"]],[[["f","Red_Mushroom.png",48]],[["l","红蘑菇","红蘑菇"]],["这种斑点蘑菇偶尔出现在山洞中。"],[["l","蘑菇树","蘑菇树"]],["时间不定，详见",["l","蘑菇树#Tapper_Product","蘑菇树"]],[["f","Gold.png",18],"75"],[["f","Poison.png",24]," -50"]],[[["f","Purple_Mushroom.p