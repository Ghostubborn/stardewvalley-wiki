{"s":[[null,1,[["p",["古代种子是一种",["l","古物","古物"],"，挖掘在",["l","煤矿森林","煤矿森林"],"和",["l","深山","深山"],"（包括",["l","采石场","采石场"],"）的",["l","远古斑点","远古斑点"],"有几率找到，打开",["l","钓鱼#宝箱","釣魚宝箱"],"或",["l","古物宝藏","古物宝藏"],"也有机会获得。此外，它也可能从",["l","臭虫","臭虫"],"、",["l","苍蝇","苍蝇"],"、",["l","蛆","蛆"],"、",["l","突变苍蝇","突变苍蝇"],"或",["l","突变蛆","突变蛆"],"身上掉落（0.5%）。在骷髅洞穴",["l","骷髅洞穴#史前层","史前层"],"、危险",["l","矿井","矿井"],"或",["l","火山地牢","火山地牢"],"清理杂草时也能找到。将",["l","上古种子","上古种子"],"放入",["l","分解机","分解机"],"后也可以分解出一颗古代种子。"]],["p",["古代种子也可以作为原材料",["l","打造","制作"],"成",["l","上古种子","上古种子"],"。",["l","上古种子","上古种子"],"可以在",["l","春季","春季"],"、",["l","夏季","夏季"],"和",["l","秋季","秋季"],"生长，产出",["l","上古水果","上古水果"],"。"]]]],["捐赠",2,[["p",["捐赠该物品可以增加",["l","博物馆","博物馆"],"的捐赠总数。"]],["p",["此外，玩家会获得一颗",["l","上古种子","上古种子"],"和它的合成配方。"]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","矮人","矮人"],"、",["l","潘妮","潘妮"]]],[{"h":1,"v":["不喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]]]]]],["收集包",2,[["p",["不用于任何",["l","收集包","收集包"],"。"]]]],["配方",2,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名字"]},{"h":1,"v":["描述"]},{"h":1,"v":["成分"]},{"h":1,"v":["配方来源"]}],[[["f","Ancient_Seeds.png",48]],[["l","上古种子","上古种子"]],["还能长出来吗？"],[["i","(O)114","古代种子×1"]],["捐赠",["l","古代种子","古代种子"],"到",["l","博物馆","博物馆"],"。"]]]]]],["裁制",2,[["p",["古代种子可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","棕色西装"],"。"]]]],["任务",2,[["p",["古代种子不用于任何",["l",