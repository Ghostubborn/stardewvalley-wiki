{"s":[[null,1,[["p",["紫水晶是",["l","矿物","矿物"],"的一种，可以通过在",["l","矿井","矿井"],"中开采",["l","采矿","紫水晶矿"],"和",["l","采矿","宝石矿"],"获得。使用",["l","淘盘","淘盘"],"淘金时，也可能会淘到",["l","淘盘","紫水晶"],"。紫水晶是",["l","史莱姆（怪物）","史莱姆（怪物）"],"的罕见掉落物。击杀",["l","火山地牢","火山地牢"],"的",["l","矮人哨兵","矮人哨兵"],"也有10%的概率掉落紫水晶。紫水晶同样可以在",["l","钓鱼","钓鱼宝箱"],"、",["l","垃圾桶","垃圾桶"],"内找到。饲养有",["l","大海参","大海参"],"的",["l","鱼塘","鱼塘"],"当数量达到9的时候，可能会产出1~3个",["l","鱼塘","紫水晶"],"。",["l","无尽财富之雕像","无尽财富之雕像"],"会在",["l","阿比盖尔","阿比盖尔"],"生日时（秋13日）生产一个紫水晶。"]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","克林特","克林特"],"、",["l","艾米丽","艾米丽"],"、",["l","矮人","矮人"]]],[{"h":1,"v":["喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","卡洛琳","卡洛琳"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]],[{"h":1,"v":["不喜欢"]},[["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","莉亚","莉亚"]]]]]]],["收集包",2,[["p",["紫水晶可用于宝藏猎人收集包。"]]]],["配方",2,[["p",["没有任何配方中需要用到紫水晶。"]]]],["裁制",2,[["p",["紫水晶可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","上衣"],"。紫水晶还可用作",["l","染色","染料罐"],"和",["l","染色","缝纫机"],"的紫色染料。"]]]],["任务",2,[["l",0,[[1,[["l","任务","“克林特的努力”"],"：第一年",["l","冬季","冬季"],"的第6天，克林特会请求玩家给",["l","艾米丽","艾米丽"],"送一个紫水晶，并告诉她这是克林特送的。任务奖励是和",["l","艾米丽","艾米丽"],"的",["l","友谊","友谊"],"增加1心。"]],[1,["在",["l","刘易斯","刘易斯"],"房子外边的",["l","任务","特别任务"],"板上出现的“宝石能量”任务中，",["l","艾米丽","艾米丽"],"会要求玩家提供一个紫水晶。"]],[1,["紫水晶会在任何季节出现在",["l","任务","布告栏"],"上的随机求助任务中，奖励是300金和150",["l","友谊","友谊点"],"。"]],[1,["饲养了",["l","太阳鱼","太阳鱼"],"、",["l","幽灵鱼","幽灵鱼"],"或者",["l","鲶鱼","鲶鱼"],"的",["l","鱼塘","鱼塘"],"会要求玩家提供1~3个紫水晶。"]],[1,["紫水晶可用于解开",["l","姜岛","姜岛"],"的",["l","姜岛","宝石鸟谜题"],"。"]]]]]],["锻造",2,[["p",["可用于提高武器",["l","重量","击退"],"（每级1重量）"]]]]]}