{"s":[[null,1,[["p",["鱼店是",["l","威利","威利"],"的家，位于",["l","鹈鹕镇","鹈鹕镇"],"南部的",["l","沙滩","沙滩"],"上的码头。如果玩家没有阅读在第一年春季第二天来自威利的信，那玩家将无法进入鱼店。威利每",["l","周循环","周六"],"闭店休息，除非",["l","天气","下雨"],"，但鱼店的门在周六没有上锁，依然可以进入。"]],["p",["威利会向玩家提供一系列用于",["l","钓鱼","钓鱼"],"的器具，例如",["l","工具","钓鱼竿"],"、",["l","鱼饵","鱼饵"],"、",["l","渔具","渔具"],"和",["l","蟹笼","蟹笼"],"。随着玩家的",["l","钓鱼","钓鱼技能"],"的不断提升，鱼店出售的钓鱼器具也会相继更新升级。玩家的技能升级后鱼店就会出售和新技能等级搭配的商品货物，不必等到第二天。其他一些物品（例如",["l","淘盘","淘盘"],"、",["l","豪华鱼缸","豪华鱼缸"],"）需要在玩家完成特定",["l","任务","任务"],"后才能购买。"]]]],["商店货物",2,[["p",[["l","鳟鱼汤","鳟鱼汤"],"、",["l","针对性鱼饵","针对性鱼饵"],"、",["l","竹鱼竿","竹鱼竿"],"、",["l","训练用鱼竿","训练用鱼竿"],"、",["l","小鱼缸","小鱼缸"],"、",["l","大鱼缸","大鱼缸"],"、",["l","咸鱼挂件","咸鱼挂件"],"、",["l","渔夫双人床","渔夫双人床"],"和",["l","熏鱼机","熏鱼机"],"配方在鱼店开张后立即就能购买。"]],["t",[[{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["价格"]},{"h":1,"v":["需要的钓鱼等级"]}],[[["l","熏鱼机","熏鱼机"],"（配方）"],[],["10,000金"],["N/A"]],[[["l","鳟鱼汤","鳟鱼汤"]],["很咸。"],["250金"],["N/A"]],[[["l","鱼饵（物品）","鱼饵"]],[],["5金"],["2"]],[[["l","高级鱼饵","高级鱼饵"]],["使鱼更快咬钩，并且让“钓鱼条”更长。"],["100金"],["4"]],[[["l","针对性鱼饵","针对性鱼饵"]],["增加钓到（鱼的名字）的几率。\n威利会根据当前的季节，以此种鱼饵的出货箱售出价格的两倍，售出一定数量的某一类型的针对性鱼饵（例如：",["l","鲶鱼","鲶鱼"],"鱼饵、",["l","沙丁鱼","沙丁鱼"],"鱼饵）。可在章节针对性鱼饵中查看不同季节售卖的针对性鱼饵类型。"],["100金"],["N/A"]],[[["l","蟹笼","蟹笼"]],["放在水中，装上诱饵，隔一天再检查有没有抓到东西。可以在溪流、湖泊和大海使用。"],["1,500金"],["3"]],[[["l","声纳浮漂","声纳浮漂"]],["在钓到鱼之前显示上钩的鱼种。"],["500金"],["6"]],[[["l","旋式鱼饵","旋式鱼饵"]],["它的形状会使它在水中打转。稍稍提升钓鱼时的上钩率。"],["500金"],["6"]],[[["l","陷阱浮标","陷阱浮标"]],["让你没在拉钩的时候，鱼会逃跑的慢一些。"],["500金"],["6"]],[[["l","铅制浮标","铅制浮标"]],["为你的“钓鱼条”添加了重量，阻止它在触底的时候反弹。"],["200金"],["6"]],[[["l","寻宝者","寻宝者"]],["在收集宝藏的时候鱼是不会逃走的。并且它能够稍微增加找到宝藏的几率。"],["750金"],["7"]],[[["l","软木塞浮标","软木塞浮标"]],["稍微增加你的“钓鱼条”的大小。"],["750金"],["7"]],[[["l","倒刺钩","倒刺钩"]],["上钩的鱼更不容易跑掉，使“钓鱼条”靠紧猎物。对速度慢、弱小的鱼最有效。"],["1,000金"],["8"]],[[["l","精装旋式鱼饵","精装旋式鱼饵"]],["金属片和彩色飘带构成的景象会吸引来鱼。增加钓鱼时的上钩率。"],["1,000金"],["8"]],[[["l","磁铁","磁铁"]],["增加钓鱼时发现宝藏的概率。但是，鱼儿可不喜欢它的味道。"],["1,000金"],["9"]],[[["l","竹鱼竿","竹鱼竿"]],["用于在水中捕鱼。"],["500金"],["N/A"]],[[["l","训练用鱼竿","训练用鱼竿"]],["它比其他鱼竿容易使用，但只能钓到基础鱼类。"],["25金"],["N/A"]],[[["l","玻璃纤维鱼竿","玻璃纤维鱼竿"]],["用于在水中捕鱼。"],["1,800金"],["2"]],[[["l","铱金鱼竿","铱金鱼竿"]],["用于在水中捕鱼。"],["7,500金"],["6"]],[[["l","高级铱金鱼竿","高级铱金鱼竿"]],["可以在水中钓鱼。最多同时安装两个浮漂。 \n从",["l","精通山洞","精通山洞"],"获得后解锁"],["25,000金"],["N/A"]],[[["l","淘盘","铜淘盘"]],["用来从溪流中收集矿石。\n完成",["l","收集包","鱼缸收集包"],"后解锁"],["2,500金"],["N/A"]],[[["l","大鱼缸","大鱼缸"]],["这件家具不能布置在户外。"],["2,000金"],["N/A"]],[[["l","小鱼缸","小鱼缸"]],["这件家具不能布置在户外。"],["500金"],["N/A"]],[[["l","豪华鱼缸","豪华鱼缸"]],["这件家具不能布置在户外。\n完成特别任务",["l","任务","“热带鱼”"],"后解锁)"],["5,000金"],["N/A"]],[[["l","咸鱼挂件","咸鱼挂件"]],["这件家具不能布置在户外。"],["1,000金"],["N/A"]],[[["l","渔夫双人床","渔夫双人床"]],["这件家具不能布置在户外。"],["25,000金"],["N/A"]]]]]],["针对性鱼饵",3,[["p",["鱼店每日会随机出售8-12个某一类型的",["l","针对性鱼饵","针对性鱼饵"],"，其单价是此种鱼饵售出价格的两倍。威利卖的鱼饵种类取决于季节。以下是威利在不同季节会出售的",["l","针对性鱼饵","针对性鱼饵"],"的表格。"]],["t",[[{"h":1,"v":["季节"]},{"h":1,"v":["可能出售的针对性鱼饵"]}],[["春季"],[["l","鳀鱼","鳀鱼"],"鱼饵，",["l","沙丁鱼","沙丁鱼"],"鱼饵，",["l","鲷鱼","鲷鱼"],"鱼饵，",["l","大嘴鲈鱼","大嘴鲈鱼"],"鱼饵，",["l","小嘴鲈鱼","小嘴鲈鱼"],"鱼饵，",["l","鲶鱼","鲶鱼"],"鱼饵，",["l","鳗鱼","鳗鱼"],"鱼饵，",["l","比目鱼","比目鱼"],"鱼饵，",["l","石鱼","石鱼"],"鱼饵"]],[["夏季"],[["l","河豚","河豚"],"鱼饵，",["l","金枪鱼","金枪鱼"],"鱼饵，",["l","沙丁鱼","沙丁鱼"],"鱼饵，",["l","鲷鱼","鲷鱼"],"鱼饵，",["l","大嘴鲈鱼","大嘴鲈鱼"],"鱼饵，",["l","虹鳟鱼","虹鳟鱼"],"鱼饵，",["l","狗鱼","狗鱼"],"鱼饵，",["l","红鲻鱼","红鲻鱼"],"鱼饵，",["l","章鱼","章鱼"],"鱼饵，",["l","大海参","大海参"],"鱼饵，",["l","比目鱼","比目鱼"],"鱼饵，",["l","鲟鱼","鲟鱼"],"鱼饵，",["l","麻哈脂鲤","麻哈脂鲤"],"鱼饵，",["l","罗非鱼","罗非鱼"],"鱼饵，",["l","冰柱鱼","冰柱鱼"],"鱼饵"]],[["秋季"],[["l","鳀鱼","鳀鱼"],"鱼饵，",["l","沙丁鱼","沙丁鱼"],"鱼饵，",["l","鲷鱼","鲷鱼"],"鱼饵，",["l","大嘴鲈鱼","大嘴鲈鱼"],"鱼饵，",["l","小嘴鲈鱼","小嘴鲈鱼"],"鱼饵，",["l","鲑鱼","鲑鱼"],"鱼饵，",["l","章鱼","章鱼"],"鱼饵，",["l","鲶鱼","鲶鱼"],"鱼饵，",["l","鳗鱼","鳗鱼"],"鱼饵，",["l","午夜鲤鱼","午夜鲤鱼"],"鱼饵，",["l","罗非鱼","罗非鱼"],"鱼饵，",["l","青花鱼","青花鱼"],"鱼饵，",["l","岩浆鳗鱼","岩浆鳗鱼"],"鱼饵"]],[["冬季"],[["l","金枪鱼","金枪鱼"],"鱼饵，",["l","沙丁鱼","沙丁鱼"],"鱼饵，",["l","鲷鱼","鲷鱼"],"鱼饵，",["l","大嘴鲈鱼","大嘴鲈鱼"],"鱼饵，",["l","大眼鱼","大眼鱼"],"鱼饵，",["l","河鲈","河鲈"],"鱼饵，",["l","鲶鱼","鲶鱼"],"鱼饵，",["l","狗鱼","狗鱼"],"鱼饵，",["l","红鲻鱼","红鲻鱼"],"鱼饵，",["l","鱿鱼","鱿鱼"],"鱼饵，",["l","大海参","大海参"],"鱼饵，",["l","午夜鲤鱼","午夜鲤鱼"],"鱼饵，",["l","鲟鱼","鲟鱼"],"鱼饵，",["l","青花鱼","青花鱼"],"鱼饵，",["l","蛇齿单线鱼","蛇齿单线鱼"],"鱼饵，",["l","石鱼","石鱼"],"鱼饵，",["l","冰柱鱼","冰柱鱼"],"鱼饵，",["l","岩浆鳗鱼","岩浆鳗鱼"],"鱼饵"]]]]]],["收购",2,[["p",["威利会收购玩家向他出售的下列物品："]],["l",0,[[1,["所有的",["l","鱼","鱼"]]],[1,["所有的",["l","鱼饵","鱼饵"]]],[1,["所有的",["l","渔具","渔具"]]],[1,["可在沙滩上获得的",["l","采集","采集物品"],"（",["l","海草","海草"],"除外）"]],[1,[["l","鱼籽","鱼籽"],"（不包括",["l","腌鱼籽","腌鱼籽"],"或",["l","鱼籽酱","鱼籽酱"],"）"]],[1,[["l","鱿鱼墨汁","鱿鱼墨汁"]]]]],["p",["他不会收购其他的物品（",["l","垃圾","垃圾"],"、",["l","绿藻","绿藻"],"、",["l","海草","海草"],"、",["l","白藻","白藻"],"、",["l","海凝胶","海凝胶"],"、",["l","河凝胶","河凝胶"],"或",["l","洞穴凝胶","洞穴凝胶"],"）。他也不会收购",["l","腌鱼籽","腌鱼籽"],"、",["l","鱼籽酱","鱼籽酱"],"或",["l","熏鱼","熏鱼"],"。"]]]],["来自玩家的商店货物",2,[["p",["如果玩家选择将物品卖给威利，尤其是大量出售的时候，这些物品有几率出现在鱼店的商品货物列表中，且只能限量购买。将物品卖给威利后与其他",["l","居民","居民"],"对话，可能还会出现一些特别的对话，表示他们已经看到或购买了这些物品。"]]]],["浮标机器",2,[["p",["鱼店的右方有一个浮标机器，玩家可以在此更换浮标的样式。玩家可以选定某种样式的浮标，也可以选择使用随机浮标，这会在每次抛竿时从已解锁的选项中随机挑选一个作为浮标样式。部分浮标可以改变渔线颜色。"]],["p",["游戏刚开始时只能选择默认浮标。玩家每钓到两种新的鱼就会按顺序解锁下一个浮标。例如，玩家钓到18种不同的鱼后将解锁第10个浮标。"]],["p",["共有39种不同的浮标。这意味着除默认浮标外，玩家需要捕获76种鱼才能解锁全部浮标。目前游戏中有77种不同的鱼（72种",["l","收集品","收集品"],"一栏中的",["l","收集品","鱼"],"与5种",["l","鱼","传说鱼类二代"],"）。"]]]],["威利的船",2,[["p",["在完成了3个",["l","收集包","收集包"],"后，进入鱼店时，会触发一个过场动画。威利是否在鱼店中以及",["l","天气","天气"],"都不会影响这个过场动画的触发。在过场动画中，他会问玩家最近钓鱼方面的收获如何，最后暗示：如果",["l","社区中心","社区中心"],"被修复，他会给玩家“看一些东西”。"]],["p",["完成社區中心的最后一个收集包或",["l","Joja社区发展申请书","Joja社区发展申请书"],"最后一个项目的两天之後，威利會寄信並邀請玩家到魚店后面的房间。需触发",["l","社区中心","社区中心重建完成"],"或",["l","Joja社区发展申请书","Joja社区发展项目竣工"],"的过场动画，第二天才可收到威利的来信。"]],["p",["进入魚店后面的房间之後，玩家會看到一個隱藏的碼頭以及一隻舊船。威利可以用这艘船载着玩家去",["l","姜岛","姜岛"],"，但他没有修復舊船所需的材料。\n玩家需要提供以下材料修复这艘船："]],["l",0,[[1,["船身需要",["i","(O)709","硬木×200"]]],[1,["船票售賣機需要",["i","(O)787","电池组×5"]]],[1,["銥錨需要 ",["i","(O)337","铱锭×5"]]]]],["p",["当玩家提交所有需要的材料后，当天晚上会有一个过场动画，显示罗宾和威利正在修理这艘船。注意，如果还有另一个也在这天夜间触发的过场动画，修船的动画将推迟一天触发。"]],["p",["船被修復後，玩家可以支付1,000金购买船票，前往",["l","姜岛","姜岛"],"。并且，魚店的开门时间提前到每天早上8點，但",["l","威利","威利的行程"],"維持不變。即使威利不在店內，也可以购买船票并前往姜岛。"]],["p",["在鱼店后室中钓鱼，有20%的几率钓到",["l","救生圈","救生圈"],"。"]]]],["趣闻",2,[["l",0,[[1,["与鱼店后墙上的梯子交互时，会出现一条信息，提示威利住在楼上。但他的卧室暂时无法进入。"]],[1,["如果玩家试图在第一年春1日进入鱼店，会看到门上有一张字条：“钓鱼去也。明日归。”"]],[1,["调查鱼店左侧箱子有概率出现“海之霸餐厅”。"]],[1,["他晚上12：30回家后会站在柜台后面，如设法进屋仍然可以买东西"]]]]]]]}