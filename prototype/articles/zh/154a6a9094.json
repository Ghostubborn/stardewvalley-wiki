{"s":[[null,1,[["p",["姜汁汽水是一种",["l","烹饪","饮料"],"。需要通过升级后的",["l","农舍","农舍"],"厨房或",["l","野炊工具","野炊工具"],"制作。"]],["p",["喝下后，它将为玩家附加持续时间为5分钟的",["l","运气","运气"],"+1",["l","效果","效果"],"。作为一种饮料，姜汁汽水的",["l","效果","效果"],"可以与任何来自食物的增益效果叠加，但会替换任何来自饮料的增益效果（即来自",["l","咖啡","咖啡"],"或",["l","绿茶","绿茶"],"的增益效果）。"]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","文森特","文森特"]]],[{"h":1,"v":["喜欢"]},[["l","罗宾","罗宾"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","德米特里厄斯","德米特里厄斯"]]],[{"h":1,"v":["不喜欢"]},[["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]]]]]],["裁制",2,[["p",["姜汁汽水可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["i","(S)1292","姜汁背带裤"],"。姜汁汽水还可用作",["l","染色","染料罐"],"和",["l","染色","缝纫机"],"的绿色染料。"]]]],["注意",2,[["p",["同",["l","姜","姜"],"一样，姜汁汽水也可以消除",["l","效果","恶心"],"。"]]]]]}