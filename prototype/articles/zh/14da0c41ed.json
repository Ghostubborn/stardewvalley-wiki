{"s":[[null,1,[["p",["海蓝宝石是一种",["l","矿物","矿物"],"。主要通过挖掘",["l","海蓝宝石矿","海蓝宝石矿"],"或",["l","紫色宝石矿","紫色宝石矿"],"获得。击杀",["l","火山地牢","火山地牢"],"的",["l","矮人哨兵","矮人哨兵"],"有 10% 的概率掉落海蓝宝石。在矿井 41~79 层打破",["l","矿井#木箱和木桶","木箱和木桶"],"也有 2.24% 的概率获得海蓝宝石。海蓝宝石也有小概率通过打开",["l","钓鱼#宝箱","钓鱼宝箱"],"、使用淘盘",["l","淘盘","淘金"],"或在到达矿井 40 层后翻动",["l","垃圾桶","垃圾桶"],"获得。"]],["p",["每周的星期三，可以在",["l","沙漠商人","沙漠商人"],"处使用 3 颗海蓝宝石交换一块",["l","布料","布料"],"。"]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","克林特","克林特"],"、",["l","矮人","矮人"],"、",["l","艾米丽","艾米丽"]]],[{"h":1,"v":["喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]],[{"h":1,"v":["不喜欢"]},[["l","莉亚","莉亚"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"]]]]]]],["收集包",2,[["p",["宝藏猎人收集包需要 1 颗海蓝宝石（作为可选项）。"]],["p",["染料收集包需要 1 颗海蓝宝石（作为可选项）"]]]],["打造",2,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["配方来源"]},{"h":1,"v":["所需原料"]}],[[["f","Marble_Brazier.png",48]],[["l","大理石火炬","大理石火炬"]],["提供一点亮光。"],[["l","木匠的商店","木匠的商店"],"以5,000金 购买"],[["i","(O)567","大理石×1"],["i","(O)62","海蓝宝石×1"],["i","(O)390","石头×100"]]]]]]],["裁制",2,[["p",["海蓝宝石可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","上衣"],"。海蓝宝石可用于",["l","染色","染色"],"。放置在",["l","染色#染料罐","染料罐"],"内时，海蓝宝石可用作蓝色染料。放置在",["l","染色#缝纫机","缝纫机"],"内时，海蓝宝石还可用作蓝绿色染料。"]]]],["任务",2,[["l",0,[[1,["在玩家到达矿井 40 层后，海蓝宝石可能会出现在",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"门前",["l","任务#求助任务","“布告栏”"],"上的随机任务中。任务完成的奖励是540金 和 150 ",["l","友谊","友谊点"],"。"]],[1,["海蓝宝石可用于解开",["l","姜岛","姜岛"],"的",