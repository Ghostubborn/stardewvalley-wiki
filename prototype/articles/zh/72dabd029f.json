{"s":[[null,1,[["p",["红莓酱是一道",["l","烹饪","菜肴"],"，可通过升级后的",["l","农舍","农舍"],"内的厨房或",["l","野炊工具","野炊工具"],"制作。"]],["p",["旅行货车会以 360–1,000金 的价格随机出售。红莓酱可能作为每日特色菜出现在",["l","星之果实酒吧#不固定商品","星之果实酒吧"],"的菜单中，售价为240金。当天翻动酒吧外的",["l","垃圾桶","垃圾桶"],"时也有概率获得 1 份红莓酱。也有可能在每周周六出现在",["l","科罗布斯#滚动出售","科罗布斯商店"],"中，售价为50金 ~ 500金。在",["l","骷髅洞穴#宝藏房间","骷髅洞穴"],"的宝箱层里打开宝箱也可能会获得 5 份红莓酱。打开",["l","谜之盒","谜之盒"],"也有概率获得 1 份红莓酱。红莓酱也可以在",["l","冰雪节#商店","冰雪节商店"],"以200金 的价格购买，限 1 份。在",["l","矿井#挑战之神庙","危险的矿井"],"或",["l","骷髅洞穴","危险的骷髅洞穴"],"中击杀",["l","矿井#特殊物品","特殊怪物"],"（",["l","史莱姆#特殊史莱姆","特殊史莱姆"],"会有黄色星形触角的明显特征，其他特殊怪物与正常怪物无明显差异）也有概率获得红莓酱。"]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","莉亚","莉亚"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","法师","法师"]]],[{"h":1,"v":["不喜欢"]},[["l","哈维","哈维"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"],"、",["l","威利","威利"]]]]]]],["收集包",2,[["p",["红莓酱不用于任何",["l","收集包","收集包"],"。"]]]],["裁制",2,[["p",["红莓酱可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["i","(H)63","平顶帽"],"。红莓酱可用于",["l","染色","染色"],"。放置在",["l","染色#染料罐","染料罐"],"内时，红莓酱可用作红色染料。放置在",["l","染色#缝纫机","缝纫机"],"内时，红莓酱还可用作红色染料，染色强度为强烈。"]]]],["任务",2,[["p",["红莓酱不用于任何",["l","任务","任务"],"。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.0#1.0","1.0"],"：加入游戏。"]],[1,[["l","版本历史/1.1#1.1","1.1"],"：价格从175金下调至120金。"]],[1,[["l","版本历史/1.4#1.4","1.4"],"：",["l","哈维","哈维"],"现在不喜欢红莓酱。现在可用于",["l","裁缝","裁缝"],"。"]],[1,[["l","版本历史/1.5#1.5","1.5"],"：现在可以用",["l","野炊工具","野炊工具"],"烹饪。现在会由",["l","冰雪节","冰雪节"],"的"