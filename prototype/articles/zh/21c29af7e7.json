{"s":[[null,1,[["p",["伐木秘事是一本",["l","书#能力之书","能力之书"],"，砍倒树木时随机掉落，概率从 0.03% 开始递增，每次砍树增加 0.001%，直到这本书掉落，概率最多增加到 0.1%。玩家至少要砍20棵树才能掉落这本书。玩家也可以第三年之后在书摊老板处以 20,000金 的价格购买（出现概率为 ~9%）。"]],["p",["首次阅读之后，使玩家砍倒的树有5%的概率掉落双倍木头，该效果可以和 ",["l","技能#采集","护林人"],"职业的效果叠加。并且它会在特殊物品和能力的选项卡上被点亮。再次阅读可以提供 100点 ",["f","Foraging_Skill_Icon.png",20]," ",["l","技能#采集","采集经验值"],"。"]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","罗宾","罗宾"],"、",["l","潘妮","潘妮"]]],[{"h":1,"v":["喜欢"]},[["l","艾利欧特","艾利欧特"]]],[{"h":1,"v":["一般"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","乔迪","乔迪"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","雷欧","雷欧"],"、",["l","法师","法师"]]],[{"h":1,"v":["不喜欢"]},[["l","亚历克斯","亚历克斯"]]]]]]],["收集包",2,[["p",["伐木秘事不用于任何",["l","收集包","收集包"],"。"]]]],["裁制",2,[["p",["伐木秘事不用于任何",["l","裁缝","裁缝"],"。可用于",["l","染色","染色"],"。放置在",["l","染色#染料罐","染料罐"],"内时，它可用作橙色染料。放置在",["l","染色#缝纫机","缝纫机"],"内时，它还可用作棕色染料。"]]]],["任务",2,[["p",["伐木秘事不用于任何",["l","任务","任务"],"。"]]]],["交易",2,[["p",["在阅读过伐木秘事之后，可以在",["l","书摊老板","书摊老板"],"处用一本伐木秘事，兑换 20 个",["l","硬木","硬木"],"。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.6","1.6"],"：加入游戏。"]]]]]]],"f":[["来源",[["l","树","树"]," · ",["l","书摊老板","书摊老板"]]],["售价",["500金"]]]}