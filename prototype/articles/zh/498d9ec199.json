{"s":[[null,1,[["p",["岩浆晶球是是一种可能包裹着",["l","矿物","矿物"],"、",["l","古物","古物"],"、矿石或基础资源的一种",["l","矿物#晶球","晶球"],"。岩浆晶球可以在",["l","矿井","矿井"],"的81~119层或者",["l","钓鱼#宝箱","钓鱼宝箱"],"中找到。同",["l","晶球","晶球"],"一样，在",["l","冬日星盛宴","冬日星盛宴"],"期间，玩家可能会收到作为礼物的岩浆晶球。打破",["l","骷髅洞穴","骷髅洞穴"],"洞中的木箱和木桶，可能会找到作为额外掉落物品的岩浆晶球。饲养有",["l","岩浆鳗鱼","岩浆鳗鱼"],"的",["l","鱼塘","鱼塘"],"至少包含9条鱼后，可能会产出5个岩浆晶球，若有10条鱼，则可能会产出10个岩浆晶球。岩浆晶球也可以通过敲碎",["l","采矿#Magma Geode Node","岩浆晶球矿"],"获得，这些矿藏可在",["l","农场地图#Hilltop","山顶农场"],"和",["l","农场地图#Four Corners","四角农场"],"的小型采石场中找到。岩浆晶球也会掉落自",["l","铁路#火车","火车"],"。"]],["p",["岩浆晶球可以交给",["l","铁匠铺","铁匠铺"],"的",["l","克林特","克林特"],"敲开以获取内含的物品，费用为 25金。它也可使用",["l","晶球破开器","晶球破开器"],"打开。"]],["p",[["l","运气#每日运气","每日运气"],"和运气",["l","效果","效果"],"都不会影响岩浆晶球的开出物品。"]]]],["岩浆晶球的内容物",2,[]],["古物",3,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["出现几率"]}],[[["f","Dwarf_Gadget.png",24]],[["l","矮人小工具","矮人小工具"]],["1/26"]]]]]],["可采集矿物",3,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["出现几率"]}],[[["f","Fire_Quartz.png",24]],[["l","火水晶","火水晶"]],["1/16"]]]]]],["晶球矿物",3,[["p",["每种晶球矿物的出现几率均为 1/26。"]],["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]}],[[["f","Baryte.png",24]],[["l","重晶石","重晶石"]]],[[["f","Basalt.png",24]],[["l","玄武岩","玄武岩"]]],[[["f","Bixite.png",24]],[["l","黑方石","黑方石"]]],[[["f","Dolomite.png",24]],[["l","白云石","白云石"]]],[[["f","Fire_Opal.png",24]],[["l","赤红猫眼石","赤红猫眼石"]]],[[["f","Helvite.png",24]],[["l","日光榴石","日光榴石"]]],[[["f","Jasper.png",24]],[["l","碧玉","碧玉"]]],[[["f","Lemon_Stone.png",24]],[["l","柠檬石","柠檬石"]]],[[["f","Neptunite.png",24]],[["l","柱星叶石","柱星叶石"]]],[[["f","Obsidian.png",24]],[["l","黑曜石","黑曜石"]]],[[["f","Star_Shards.png",24]],[["l","陶瓷碎片","陶瓷碎片"]]],[[["f","Tigerseye.png",24]],[["l","虎眼石","虎眼石"]]]]]]],["资源",3,[["p",["煤炭、铜矿石、铁矿石和黄金矿石将按以下数量概率获得：30%概率获得1个，30%概率获得3个，30%概率获得5个，9%概率获得10个，1%概率获得20个。石头有50%概率采用以上数值，另有50%概率只获得1个。铱矿石有30%概率获得1个，30%概率获得2个，30%概率获得3个，9%概率获得6个，1%概率获得11个。每开启一个晶球仅能获得1个粘土。"]],["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["出现几率"]}],[[["f","Stone.png",24]],[["l","石头","石头"]],["1/8"]],[[["f","Clay.png",24]],[["l","粘土","粘土"]],["1/16"]],[[["f","Coal.png",24]],[["l","煤炭","煤炭"]],["1/20"]],[[["f","Copper_Ore.png",24]],[["l","铜矿石","铜矿石"]],["1/20"]],[[["f","Iron_Ore.png",24]],[["l","铁矿石","铁矿石"]],["1/20"]],[[["f","Gold_Ore.png",24]],[["l","黄金矿石","黄金矿石"]],["1/20"]],[[["f","Iridium_Ore.png",24]],[["l","铱矿石","铱矿石"]],["1/20"]]]]]],["送礼",2,[["t",[[{"h":1,"v":["不喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]]]]]],["裁制",2,[["p",["岩浆晶球可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","红色卫衣"],"。岩浆晶球还可用作",["l","染色#染料罐","染料罐"],"和",["l","染色#缝纫机","缝纫机"],"的红色染料。"]]]],["任务",2,[["l",0,[[1,[["l","大树桩（地点）#浣熊的请求","大树桩"],"浣熊的第五个任务、第六个以及之后的任务可能会要求玩家提供3个岩浆晶球。"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.4","1.4"],"：现在在裁缝中可用。现在可由鱼塘产出。"]],[1,[["l","版本历史#1.6","1.6"],"：现在是浣熊任务的随机需求物品。"]]]]]]]}