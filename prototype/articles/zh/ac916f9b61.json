{"s":[[null,1,[["n",["关于",["l","鹈鹕镇","鹈鹕镇"],"中的垃圾桶，请见 “",["l","垃圾桶","垃圾桶"],"”。"]],["p",["垃圾桶是一种在",["l","物品栏","物品栏"],"菜单中用来丢弃物品的",["l","工具","工具"],"。升级后，丢弃物品时会返还一部分物品价值。"]],["p",["游戏开始时",["l","玩家角色","玩家"],"的",["l","物品栏","物品栏"],"里有一个基础垃圾桶。垃圾桶可以在",["l","铁匠铺","铁匠铺"],"升级。每次升级所需的费用和资源如下表所示。"]]]],["垃圾桶等级",2,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["所需金币"]},{"h":1,"v":["所需材料"]},{"h":1,"v":["工具特点"]}],[[],["垃圾桶"],["初始工具"],[],["用于在物品栏中丢弃物品"]],[[["f","Trash_Can_Copper.png",48]],["铜垃圾桶"],[["f","Gold.png",18],"1,000"],[["i","(O)334","铜锭"],"（5）"],["回收物品价值的 15%"]],[[["f","Trash_Can_Steel.png",48]],["钢垃圾桶"],[["f","Gold.png",18],"2,500"],[["i","(O)335","铁锭"],"（5）"],["回收物品价值的 30%"]],[[["f","Trash_Can_Gold.png",48]],["金垃圾桶"],[["f","Gold.png",18],"5,000"],[["i","(O)336","金锭"],"（5）"],["回收物品价值的 45%"]],[[["f","Trash_Can_Iridium.png",48]],["铱垃圾桶"],[["f","Gold.png",18],"12,500"],[["i","(O)337","铱锭"],"（5）"],["回收物品价值的 60%"]]]]]],["注意事项",2,[["l",false,[[1,["与其他工具不同，在铁匠铺升级垃圾桶期间，原有的垃圾桶仍然可以使用。"]],[1,["垃圾桶回收物品的价值会因为职业对物品价值的影响而有所变化（如渔夫、农耕人等）。"]],[1,["某些不可出售的物品（如咖啡机、汽水机、缝纫机等）通过垃圾桶删除后，被删除的物品将无法通过正常方式获取。"]],[1,["垃圾桶升级后，丢弃（包括无法从目录和家具目录获取的）地板、家具、墙纸仍然不会返还金币，尽管它们在游戏数据中有“价值”数据。"]]]]]],["历史",2,[["l",false,[[1,["1.0：加入游戏。"]],[1,["1.4：可以在铁匠铺升级。"]]]]]]]}