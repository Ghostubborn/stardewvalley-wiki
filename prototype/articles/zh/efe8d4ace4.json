{"s":[[null,1,[["p",["织布机是一种用来制作",["l","工匠物品","工匠物品"],"的",["l","打造#工匠设备","工匠设备"],"。它会把",["l","动物毛","动物毛"],"加工成",["l","布料","布料"],"。"]],["p",["将高品质的",["l","动物毛","动物毛"],"放入",["l","织布机","织布机"],"有概率产出双份布料。具体概率为：银星：15%，金星：50%，铱星：100%。这使得布料成为游戏中唯一一个实际性受到投入原料的品质影响的工匠物品。"]]]],["产品",2,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["材料"]},{"h":1,"v":["加工时间"]},{"h":1,"v":["售价"]}],[[["f","Cloth.png",48]],[["l","布料","布料"]],["一匹上好的羊毛布料。"],[["i","(O)440","动物毛×1"]],["4小时"],["470金"]]]]]],["漏洞",2,[["l",0,[[1,["将",["l","黄色沙发","黄色沙发"],"放入织布机能够产出",["l","动物毛","动物毛"],"。该漏洞属于物品ID重合问题，已在1.6版本修复。"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.4","1.4"],"：为放入高品质",["l","动物毛","动物毛"],"增加产出双倍",["l","布料","布料"],"的机会。织布机现在可以堆放在玩家的",["l","物品栏","物品栏"],"和",["l","宝箱","宝箱"],"中。"]],[1,[["l","版本历史#1.6","1.6"],"：织布机现在在处理高品质",["l","动物毛","动物毛"],"时将有更高的机会产出双倍",["l","布料","布料"],"。"]]]]]]],"f":[["来源",[["l","打造","打造"]]],["原料",[["i","(O)388","木材×60"],["i","(O)771","纤维×30"],["i","(O)726","松焦油×1"]]],["售价",["不可出售"]]]}