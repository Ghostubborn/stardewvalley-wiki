{"s":[[null,1,[["p",["神秘树是一种",["l","树","树"],"，可以通过",["l","神秘树种","神秘树种"],"种植。"]],["p",["在成熟的神秘树上放置",["l","树液采集器","树液采集器"],"，每 7 天会产出一瓶",["l","神秘糖浆","神秘糖浆"],"，使用",["l","重型树液采集器","重型树液采集器"],"则为 3 天。"]]]],["生长",2,[["p",["除了",["l","冬季","冬季"],"，神秘树每晚都有大约 15% 的概率生长到下一阶段。总共有 5 个生长阶段，平均成熟时间约为 33.3 天，超过 90% 的神秘树能在 52 天内完全成熟。"]],["p",["使用",["l","树肥","树肥"],"可以让神秘树每晚都有 30% 的概率生长到下一个阶段，包括",["l","冬季","冬季"],"，此时的平均成熟时间约为 16.7 天。"]],["p",["神秘树上不会生长",["l","苔藓","苔藓"],"。"]]]],["砍伐",2,[["p",["神秘树可使用",["l","斧头","斧头"],"砍伐，砍伐后会掉落 8~11 块",["l","硬木","硬木"],"。"]],["p",["当神秘树处于于生长的第 1 阶段和第 2 阶段时，使用",["l","斧头","斧头"],"砍掉树苗可能会掉落 1 个木材，概率为 当前采集等级 × 10%（包括",["l","效果","增益效果"],"加成），即当达到 采集 10 级 时必然掉落一个木材。使用其他",["l","工具","工具"],"清除不会掉落木头。"]],["p",["砍伐或摇晃神秘树不会获得",["l","神秘树种","神秘树种"],"。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.6","1.6"],"：加入游戏。"]]]]]]],"f":[["种子",[["i","(O)MysticTreeSeed","神秘树种"]]],["树液采集器产出",[["i","(O)MysticSyrup","神秘糖浆"]]],["生长时间",["33.3 天"]]]}