{"s":[[null,1,[["p",["史莱姆蛋是",["l","史莱姆（怪物）","史莱姆"],"的罕见掉落物。可以将 100 个",["l","史莱姆泥","史莱姆泥"],"放进",["l","史莱姆压蛋器","史莱姆压蛋器"],"加工制成史莱姆蛋。紫色或者红色史莱姆蛋可以在",["l","骷髅洞穴","骷髅洞穴"],"的宝箱层找到。饲养有",["l","史莱姆鱼","史莱姆鱼"],"的",["l","鱼塘","鱼塘"],"（数量达到 9 条鱼时）每天可能会产出一个绿色史莱姆蛋。在",["l","火山地牢","火山地牢"],"或",["l","姜岛","姜岛"],"西部",["l","姜岛","老虎史莱姆小树林"],"杀死老虎史莱姆时，有几率掉落老虎史莱姆蛋。饲养有",["l","狮子鱼","狮子鱼"],"的",["l","鱼塘","鱼塘"],"（数量达到 9 条鱼时）每天可能会产出一个老虎史莱姆蛋。"]],["p",["史莱姆压蛋器产出的史莱姆蛋的颜色是随机的。一个史莱姆蛋的颜色有 5% 的几率为紫色，9.5% 的几率为红色，21.375% 的几率为蓝色，以及 64.125% 的几率为绿色。"]],["p",["一旦玩家在农场上建造了",["l","史莱姆屋","史莱姆屋"],"，当玩家（在任意地点）杀死一只史莱姆的时候，有 1% 的几率会掉落一个史莱姆蛋。掉落的史莱姆蛋的颜色由被杀死的史莱姆的颜色决定，例如绿色史莱姆掉落绿色史莱姆蛋，以此类推。"]],["p",["不同颜色的史莱姆蛋的售价不同；史莱姆蛋可以放入",["l","史莱姆孵化器","史莱姆孵化器"],"进行孵化。"]]]],["孵化",2,[["p",["史莱姆蛋可以在",["l","史莱姆孵化器","史莱姆孵化器"],"中孵化成",["l","史莱姆（怪物）","史莱姆"],"。孵化需要 4,000m (2d 13h 20m)。",["l","耕种","鸡舍大师"],"职业可以把孵化时间减半。"]],["p",["孵出的史莱姆颜色取决于孵化的蛋的颜色，例如蓝色史莱姆蛋会孵化出一个蓝色史莱姆，以此类推。孵化出的史莱姆性别是随机的。"]]]],["送礼",2,[["t",[[{"h":1,"v":["讨厌"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","雷欧","雷欧"],"、",["l","潘姆","潘姆"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","艾利欧特","艾利欧特"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","艾米丽","艾米丽"],"、",["l","山姆","山姆"],"、",["l","玛妮","玛妮"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"]]]]]]],["收集包",2,[["p",["史莱姆蛋不用于任何收集包。"]]]],["裁制",2,[["p",["史莱姆蛋（任意颜色）可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成可染色的 ",["i","(P)10","宽松裤"],"。"]],["p",["史莱姆蛋可用于",["l","染色","染色"],"，",["l","染色","缝纫机"],"和",["l","染色","染料罐"],"均可使用。染料颜色与物品颜色相对应（其中老虎史莱姆蛋为橙色）。"]]]],["任务",2,[["p",["史莱姆蛋不用于任何任务。"]]]]],"f":[["来源",[["l","史莱姆压蛋器","史莱姆压蛋器"]," · ",["l","史莱姆（怪物）","史莱姆"]," · ",["l","鱼塘","鱼塘"]]],["售价",[["f","Green_Slime_Egg.png",24]," 1,000金\n",["f","Blue_Slime_Egg.png",24]," 1,750金\n",["f","Red_Slime_Egg.png",24]," 2,500金\n",["f","Purple_Slime_Egg.png",24]," 5,000金\n",["f","Tiger_Slime_Egg.png",24]," 8,000金"]]]}