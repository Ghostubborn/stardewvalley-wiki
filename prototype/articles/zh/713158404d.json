{"s":[[null,1,[["p",["长满苔藓的种子是一种",["l","树","树"],"苗，可以长出三种",["l","绿雨树","绿雨树"],"之一。在达到 ",["l","技能","采集等级 1"],"以上后，可以通过摇晃或砍倒一棵",["l","绿雨树","绿雨树"],"（包括在",["l","秋季","秋季"],"、",["l","冬季","冬季"],"或",["l","天气","绿雨"],"期间转化为",["l","绿雨树","绿雨树"],"的树木）获得。长满苔藓的种子也有 5% 概率通过在",["l","天气","绿雨"],"期间破坏",["l","杂草","巨大杂草"],"获得。"]],["p",["长满苔藓的种子可以种植在农场内外任何未占用的可耕种方格中，但该方格必须未使用",["l","锄头","锄头"],"开垦过。"]],["p",["除了",["l","冬季","冬季"],"，长满苔藓的种子每晚都有大约 20% 的概率生长到下一阶段。总共有 5 个生长阶段，平均成熟时间约为 18 天，超过90%的长满苔藓的种子能在32天内完全成熟。"]],["p",["使用",["l","树肥","树肥"],"可以让长满苔藓的种子每晚都生长到下一个阶段，包括",["l","冬季","冬季"],"。"]],["p",["在其他树木附近种植长满苔藓的种子可以最大化",["l","苔藓","苔藓"],"的收益。"]]]],["送礼",2,[["t",[[{"h":1,"v":["不喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","雷欧","雷欧"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"]]]]]]],["收集包",2,[["p",["长满苔藓的种子不用于任何",["l","收集包","收集包"],"。"]]]],["裁缝",2,[["p",["长满苔藓的种子不用于",["l","裁缝","裁缝"],"或",["l","染色","染色"],"。"]]]],["任务",2,[["p",["长满苔藓的种子不用于任何",["l","任务","任务"],"。"]]]]]}