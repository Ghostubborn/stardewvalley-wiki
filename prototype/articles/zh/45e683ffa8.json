{"s":[[null,1,[["p",["腌菜是一种",["l","工匠物品","工匠物品"],"，可以通过将",["l","蔬菜","蔬菜"],"或部分采集品放入",["l","罐头瓶","罐头瓶"],"加工获得，加工时间为 2 天 13 小时 20 分钟。"]],["p",["腌菜的品质不受原料",["l","蔬菜","蔬菜"],"或",["l","采集","采集品"],"的品质影响，不论在",["l","罐头瓶","罐头瓶"],"内放入什么品质的蔬菜或采集品，产出的腌菜均为基础品质。一般而言，大部分腌菜的价格高于金星原材料的价格，存在利润空间。但若在未选择",["l","耕种#技能","工匠"],"职业的情况下使用铱星原材料制作腌菜，则极有可能亏损。"]],["p",["旅行货车会以 300–1,000金 的价格随机出售。这种腌菜没有蔬菜或采集品名字前缀，并且不可食用。它的售价是100金。"]],["p",["腌菜的",["l","可食用性","可食用性"],"取决于原材料："]],["l",0,[[1,["如果原材料蔬菜或采集品的可食用性为正值，则腌菜的可食用性是原材料的 1.75 倍，即食用后可恢复相当于普通品质原材料蔬菜或采集品 1.75 倍的",["f","Energy.png",20],["l","能量","能量值"],"与",["f","Health.png",20],["l","生命值","生命值"],"；"]],[1,["如果原材料蔬菜或采集品不可食用，则腌菜的可食用性值为原材料售价的 0.25 倍；"]],[1,["如果原材料蔬菜或采集品可食用性为负值，则腌菜的可食用性值等于原材料的可食用性；"]],[1,["没有蔬菜或采集品名字前缀的腌菜不可食用。"]]]]]],["原料",2,[["p",["所有蔬菜和部分",["l","采集","采集品"],"可以用于加工腌菜，详细列表如下："]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","哈维","哈维"]]],[{"h":1,"v":["喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","法师","法师"]]],[{"h":1,"v":["不喜欢"]},[["l","雷欧","雷欧"]]],[{"h":1,"v":["讨厌"]},[["l","贾斯","贾斯"],"、",["l","玛鲁","玛鲁"],"、",["l","山姆","山姆"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"]]]]]]],["收集包",2,[["p",["腌菜不用于任何",["l","收集包","收集包"],"。"]]]],["裁制",2,[["p",["腌菜可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","上衣"],"。腌菜可用于",["l","染色","染色"],"。放置在",["l","染色#缝纫机","缝纫机"],"内时，腌菜可用作绿色染料。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.5#1.5","1.5"],"：可以腌制",["l","姜","姜"],"了。"]],[1,[["l","版本历史#1.6","1.6"],"：果酱、腌菜、果酒和果汁都会根据配料变色了。"]],[1,[["l","版本历史#1.6","1.6"],"：可以腌制",["l","胡萝卜","胡萝卜"],"、",["l","金皮西葫芦","金皮西葫芦"],"、",["l","西蓝花","西蓝花"],"了。"]],[1,[["l","版本历史#1.6.2","1.6.2"],"：修复了某些不可食用的原料制成的腌菜有毒的问题。"]],[1,[["l","版本历史#1.6.4","1.6.4"],"：部分",["l","采集","采集品"],"也可以制成腌菜了。"]]]]]]],"f":[["来源",[["l","工匠物品","工匠物品"]]],["加工设备",[["i","(BC)15","罐头瓶"]]],["原料",["任意",["l","蔬菜","蔬菜"],"及部分",["l","采集","采集品"],"（1）"]],["加工时间",["4000 分钟\n（约 2 天 13 小时）"]],["售价",[["l","蔬菜","蔬菜"],"的基础价格 × 2 + 50"]]]}