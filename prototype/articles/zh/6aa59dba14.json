{"s":[[null,1,[["p",["平顶帽是一种",["l","帽子","帽子"],"，玩家可以在",["l","缝纫机","缝纫机"],"上使用",["l","布料","布料"],"和一个",["l","红莓酱","红莓酱"],"或",["l","塞料面包","塞料面包"],"缝制该帽子。"]],["p",["这顶帽子还有小概率通过以下方式获得：击杀",["l","怪物","怪物"],"；",["l","矿井#木箱和木桶","打破木箱和木桶"],"；砍",["l","树","树"],"；摇晃树木；挖掘",["l","远古斑点","远古斑点"],"；",["l","淘盘","淘金"],"。"]]]],["趣闻",2,[["p",["这种帽子类似于与美国的朝圣者和感恩节相关的平顶帽。其原料",["l","红莓酱","红莓酱"],"和",["l","塞料面包","塞料面包"],"是传统的感恩节配菜。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.4","1.4"],"：加入游戏."]],[1,[["l","版本历史#1.6","1.6"],"：现在有小概率通过玩家的多种行为活动获得。"]]]]]]]}