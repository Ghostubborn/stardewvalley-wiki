{"s":[[null,1,[["p",["燃烧弹戒指是一种",["l","戒指","戒指"],"。完成",["l","探险家公会#Serpent","击杀 250 只飞蛇"],"的目标后可前往",["l","探险家公会","探险家公会"],"向",["l","吉尔","吉尔"],"领取，此后即可在",["l","探险家公会","探险家公会"],"以30,000金 的价格购买。"]],["p",["佩戴燃烧弹戒指击杀",["l","怪物","怪物"],"后会以怪物所处格为中心造成一次小爆炸，爆炸能摧毁附近的岩石和",["l","采集#矿井","采集物品"],"、击杀被击倒的",["l","木乃伊","木乃伊"],"，但不会对玩家造成伤害。"]],["p",["佩戴燃烧弹戒指击倒一只",["l","木乃伊","木乃伊"],"并不会直接杀死它，爆炸效果仅能击杀处于爆炸范围内，并且先前已经被击倒的",["l","木乃伊","木乃伊"],"。"]],["p",["装备多个燃烧弹戒指可以触发多次爆炸，对范围内的怪物造成多次爆炸伤害，被饰品“",["l","魔法箭筒","魔法箭筒"],"”杀死的怪物也可以触发爆破效果。"]],["p",["在",["l","农场","农场"],"和",["l","史莱姆屋","史莱姆屋"],"中击杀怪物不会触发爆炸效果。"]]]],["影响",2,[["l",0,[[1,["这意味着使用燃烧弹戒指摧毁一棵",["l","树","树"],"一共需要 15 次爆炸：炸倒树干需要 10 次，摧毁树桩需要 5 次。"]],[1,["不同于其他爆炸，在农场或史莱姆屋中不会对物块和土地造成破坏，但依旧会对伤害范围内的怪物造成伤害。（在姜岛农场会正常造成破坏）"]]]]]],["影响区域",2,[["p",["燃烧弹戒指的爆炸半径为 2。处于整个方形区域内的怪物会受到爆炸伤害，绿色圆形以内的区域则为爆炸范围，红色圆形区域有机会炸为开垦状态。具体造成伤害详见",["l","防御","防御"],"和",["l","战斗","战斗"],"的公式计算部分。"]]]],["染色",2,[["p",["燃烧弹戒指可用作",["l","染色#染料罐","染料罐"],"和",["l","染色#缝纫机","缝纫机"],"的橙色染料。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.4#1.4","1.4"],"：加入游戏。"]],[1,[["l","版本历史/1.5#1.5","1.5"],"：",["l","皇家飞蛇","皇家飞蛇"],"现在计入击杀数量。"]],[1,[["l","版本历史#1.6","1.6"],"：现在当",["l","猪","猪"],"挖",["l","松露","松露"],"时，小概率挖出视为怪物的",["l","松露蟹","松露蟹"]]],[1,[["l","版本历史#1.6.4","1.6.4"],"：现在在农场和史莱姆小屋中击杀怪物不会触发其爆炸效果。"]]]]]]]}