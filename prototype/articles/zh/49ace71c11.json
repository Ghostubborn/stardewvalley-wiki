{"s":[[null,1,[["p",["燃烧弹戒指是一种",["l","戒指","戒指"],"，完成",["l","探险家公会#Serpent","杀死250只飞蛇的目标"],"后可前往",["l","探险家公会","探险家公会"],"向",["l","吉尔","吉尔"],"领取，此后可以以30,000金的价格从",["l","探险家公会","探险家公会"],"购买。"]],["p",["佩戴燃烧弹戒指时，击杀一只",["l","怪物","怪物"],"会造成一次小爆炸，类似于引爆一个小",["l","打造#炸弹","炸弹"],"，不会对玩家造成伤害，但能摧毁附近的岩石和",["l","采集#矿井","采集物品"],"（以及被击倒的",["l","木乃伊","木乃伊"],"）。"]],["p",["佩戴两枚燃烧弹戒指时会同时触发两次完全相同的爆炸，使附近怪物受到两次伤害。"]],["p",["佩戴燃烧弹戒指击倒一只",["l","木乃伊","木乃伊"],"并不会直接杀死它，爆炸效果仅能击杀处于爆炸范围内，并且先前已经被击倒的",["l","木乃伊","木乃伊"],"。"]],["p",["被饰品“",["l","魔法箭筒","魔法箭筒"],"”杀死的怪物也可以触发爆破效果。"]],["p",["注意：在",["l","农场","农场"],"和",["l","史莱姆屋","史莱姆屋"],"中击杀怪物不会触发其爆炸效果。"]]]],["染色",2,[["p",["燃烧弹戒指可用作",["l","染色#染料罐","染料罐"],"和",["l","染色#缝纫机","缝纫机"],"的橙色染料。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.4","1.4"],"：加入游戏。"]],[1,[["l","版本历史#1.5","1.5"],"：",["l","皇家飞蛇","皇家飞蛇"],"现在计入击杀数量。"]],[1,[["l","版本历史#1.6","1.6"],"：现在当",["l","猪","猪"],"挖",["l","松露","松露"],"时，小概率挖出视为怪物的",["l","松露蟹","松露蟹"]]],[1,[["l","版本历史#1.6.4","1.6.4"],"：现在在农场和史莱姆小屋中击杀怪物不会触发其爆炸效果。"]]]]]]]}