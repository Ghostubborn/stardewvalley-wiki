{"s":[[null,1,[["p",["传送图腾：山岭是一种",["l","传送图腾","传送图腾"],"，在物品栏中选中并右键点击屏幕中无法直接交互的任意处，便可传送玩家至",["l","深山","深山"],"。它可在达到",["l","采集","采集等级"]," 7 解锁配方后",["l","打造","打造"],"获得。也可通过挖掘",["l","远古斑点","远古斑点"],"获得。"]],["p",["打开",["l","谜之盒","谜之盒"],"有概率获得一个传送图腾：山岭。"]],["p",["饲养",["l","小龙虾","小龙虾"],"、",["l","玉黍螺","玉黍螺"],"或",["l","蜗牛","蜗牛"],"的",["l","鱼塘","鱼塘"],"，在鱼的数量达到至少9条后，每天都有小概率产出1个传送图腾：山岭。这三种鱼的鱼塘对于传送图腾：山岭的每日产出概率是相同的（9条鱼和10条鱼皆为7%）。"]],["p",["第1年",["l","夏季","夏季"],"1日开始，传送图腾：山岭有10%概率在",["l","远古斑点","远古斑点"],"中替换",["l","粘土","粘土"],"出现。"]]]],["送礼",2,[["t",[[{"h":1,"v":["讨厌"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","雷欧","雷欧"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"]]]]]]],["收集包",2,[["p",["传送图腾：山岭不用于任何",["l","收集包","收集包"],"。"]]]],["裁制",2,[["p",["传送图腾可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["i","(H)44","图腾面具"],"。传送图腾可用于",["l","染色","染色"],"。放置在",["l","染色","染料罐"],"内时，传送图腾可用作橙色染料。放置在",["l","染色","缝纫机"],"内时，传送图腾还可用作棕色染料。"]]]],["任务",2,[["p",["传送图腾：山岭不用于任何",["l","任务","任务"],"。"]]]]]}