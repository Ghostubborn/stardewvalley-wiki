{"s":[[null,1,[["p",["珍珠是一种特殊物品，可以通过多种方式获得。"]]]],["获取途径",2,[["p",["珍珠可通过以下途径找到："]],["l",0,[[1,["7%概率从",["l","钓鱼#金宝箱","金色钓鱼宝箱"],"中开出。"]],[1,["在",["l","夜市#钓鱼潜艇","夜市的深海潜水艇"],"中钓鱼时，有0.4％的几率钓起一颗珍珠（如果装备了",["l","珍稀诱钩","珍稀诱钩"],"则为0.9%）。"]],[1,[["l","水滴鱼","水滴鱼"],"的",["l","鱼塘","鱼塘"],"在鱼的数目达到9后，每天有1.7~1.9%概率产出。"]],[1,["0.49%概率从",["l","谜之盒","谜之盒"],"开出。"]],[1,["0.94%概率从",["l","金色谜之盒","金色谜之盒"],"开出。"]],[1,["3.7%概率从",["l","古物宝藏","古物宝藏"],"开出。"]],[1,["冬12日",["l","鱿鱼节","鱿鱼节"],"金级别必得奖励之一。"]],[1,["在",["l","姜岛","姜岛"],"得到",["l","日记残页#日记残页 #6","日记残页 #6"],"后可以在纸条中描述的位置挖出一个。"]],[1,["玩家在一个",["l","鱼塘","鱼塘"],"中养满10只",["l","螃蟹","螃蟹"],"后与",["l","威利","威利"],"对话，威利会赠给玩家一个珍珠。"]],[1,["在激活",["l","矿井#挑战之神庙","挑战之神庙"],"后或在",["l","任务#Danger In The Deep","“深处的危险”"],"任务期间可在",["l","矿井","矿井"],"中",["l","采集","采集"],"。"]],[1,["在",["l","夜市#美人鱼秀","夜市的美人鱼船"],"内以正确的顺序点击蛤壳可获得一颗。",["l","秘密纸条#秘密纸条 #15","秘密纸条 #15"],"中列出了正确的顺序。每个存档只能从美人鱼船上获得一颗珍珠，",["l","合作","多人联机"],"中每个玩家只能从美人鱼船上获得一颗（点击下方查看顺序）。"]]]],["d","正确的顺序",[["p",["从左到右，1-5-4-2-3"]]]]]],["用途",2,[["l",0,[[1,["珍珠可以作为普遍最爱的礼物赠送。"]],[1,["可以以2,500金的价格出售。"]],[1,["珍珠可以在缝纫机中用于制作服装（参见下文的裁缝）。"]],[1,[["l","沙漠商人","沙漠商人"],"会以一个珍珠的价格出售1个",["l","桦木双人床","桦木双人床"],"。"]],[1,["珍珠可以作为装饰品放进",["l","鱼缸","鱼缸"],"中。"]]]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]]]]]],["收集包",2,[["p",["珍珠不用于任