{"s":[[null,1,[["p",["魔法糖冰棍是一种特殊的可食用物品，它有多种获取途径。"]]]],["获取途径",2,[["p",["魔法糖冰棍可以通过以下方式获取："]],["l",0,[[1,["每",["l","周循环#星期四","周四"],"在",["l","沙漠商人","沙漠商人"],"处使用 3 个",["l","五彩碎片","五彩碎片"],"兑换 1 个。"]],[1,["掌握",["l","精通山洞#精通","采集精通"],"并完成浣熊的请求第六个任务后，可以在",["l","大树桩（地点）#浣熊妻子的商店","浣熊妻子的商店"],"处使用 20 个",["l","金色谜之盒","金色谜之盒"],"兑换。"]],[1,[["l","镇长的庄园#兑奖机","兑奖机"],"的第 22 个奖品。"]],[1,[["l","博物馆","博物馆"],"捐赠 90 件物品后的奖励。"]],[1,[["l","沙漠节","沙漠节"],"第 3 天，",["l","沙漠节#卡利科三花蛋商人","卡利科三花蛋商人"],"会以250卡利科蛋 ",["l","卡利科三花蛋","卡利科三花蛋"],"的价格出售 1 个。"]],[1,["沙漠节期间，提交给",["l","吉尔","吉尔"],"的",["l","沙漠节#骷髅洞穴挑战","三花蛋分数"],"在 55~999 时，奖励会包括 1 个魔法糖冰棍。"]],[1,[["l","贾斯","贾斯"],"在",["l","沙漠节","沙漠节"],"开设",["l","沙漠节#村民商铺","商铺"],"时，会以300卡利科蛋 卡利科三花蛋的价格出售 1 个。"]],[1,["打开",["l","谜之盒","谜之盒"],"（0.2% 概率）或",["l","金色谜之盒","金色谜之盒"],"（0.4% 概率）。"]],[1,[["l","幽灵头骨","幽灵头骨"],"掉落（0.13% 概率）。"]]]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]]]]]],["收集包",2,[["p",["魔法糖冰棍不用于任何",["l","收集包","收集包"],"。"]]]],["裁制",2,[["p",["魔法糖冰棍可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","魔法斑点衣"],"。"]]]],["任务",2,[["p",["魔法糖冰棍不用于任何",["l","任务","任务"],"。"]]]],["备注",2,[["l",0,[[1,["尽管魔法糖冰棍不能由烹饪制作，但它在游戏文件中的分类依然是“烹饪”。所以魔法糖冰棍在游戏中赠送给村民的分类归为“菜品”。"]],[1,["因为魔法糖冰棍属于“菜品”，所以它不能被加入",["l","夏威夷宴会","夏威夷宴会"],"的汤中。"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.4#1.4"