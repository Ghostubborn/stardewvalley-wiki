{"s":[[null,1,[["p",["洋蓟种子是种子的一种，成熟后得到",["l","洋蓟","洋蓟"],"。"]],["p",["洋蓟种子可以从第二年开始在",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"和",["l","冬季","冬季"],"17日",["l","夜市","夜市上的魔法商船"],"买到，偶尔也会在",["l","旅行货车","旅行货车"],"上出售。洋蓟种子也可以通过",["l","种子生产器","种子生产器"],"获得。种下",["l","混合种子","混合种子"],"也有可能变为洋蓟种子。骷髅洞穴",["l","骷髅洞穴","宝藏房间"],"的宝箱偶尔也能开出5-20个洋蓟种子。在",["l","秋季","秋季"],"和",["l","冬季","冬季"],"打开",["l","谜之盒","谜之盒"],"有概率获得8个或20个洋蓟种子，打开",["l","金色谜之盒","金色谜之盒"],"有概率获得20个洋蓟种子。"]]]],["生长阶段",2,[["t",[[{"h":1,"v":["阶段 1"]},{"h":1,"v":["阶段 2"]},{"h":1,"v":["阶段 3"]},{"h":1,"v":["阶段 4"]},{"h":1,"v":["阶段 5"]},{"h":1,"v":["收成"]}],[["2天"],["2天"],["1天"],["2天"],["1天"],["共：8天"]]]]]],["趣闻",2,[["p",[["l","混合种子","混合种子"],"可以在第1年变为洋蓟种子，尽管洋蓟种子直到第2年才可在",["l","皮埃尔的杂货店","杂货店"],"购买。"]]]],["送礼",2,[["t",[[{"h":1,"v":["不喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]]]]]]]}