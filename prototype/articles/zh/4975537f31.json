{"s":[[null,1,[["p",["铱制科罗布斯是一种装饰型",["l","家具","家具"],"，可以在",["l","煤矿森林","煤矿森林"],"最南边靠近",["l","下水道","下水道"],"门口前的河流中",["l","钓鱼","钓鱼"],"得到。"]],["p",["正常情况下，",["l","钓鱼#钓鱼技能","钓鱼等级"],"最少需要达到15级后才能从下水道门口处抛竿到下方。"]],["h",["在",["l","钓鱼#钓鱼技能","钓鱼等级"],"达到10级后，可以通过以下方法达到15级："]],["l",0,[[1,["食用添加",["l","齐氏调味料","齐氏调味料"],"后",["l","烹饪","烹饪"],"的金星品质",["l","海泡布丁","海泡布丁"],"（",["l","钓鱼","钓鱼（+5）"],"）"]],[1,["使用",["l","锻造#附魔","附魔"],"出",["l","锻造#工具的附魔","精通"],"效果（",["l","钓鱼","钓鱼（+1）"],"）的",["l","铱金鱼竿","铱金鱼竿"]]],[2,["配合普通品质的",["l","海泡布丁","海泡布丁"],"（",["l","钓鱼","钓鱼（+4）"],"）"]],[2,["配合添加",["l","齐氏调味料","齐氏调味料"],"后",["l","烹饪","烹饪"],"出金星品质的",["l","海之菜肴","海之菜肴"],"、",["l","烩鱼汤","烩鱼汤"],"、",["l","龙虾浓汤","龙虾浓汤"],"（",["l","钓鱼","钓鱼（+4）"],"）"]]]],["p",["首次在此处钓鱼必定钓起铱制科罗布斯。每个存档每人只能获得一个。"]],["g",[["Iridium_Krobus_Location.thumb.webp",320,["钓鱼地点"],"Iridium_Krobus_Location.webp"]]],["p",["若不慎遗失或损毁，可以在",["l","秘密森林","秘密森林"],"的",["l","秘密森林#失物回购","遗失物品商店"],"花费10,000金 重新购买。"]]]],["漏洞",2,[["l",0,[[1,["用其他物品填充满背包后，再去钓取铱制科罗布斯可以突破每个存档只能获得一个的数量限制。"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.5#1.5","1.5"],"：加入游戏。"]]]]]]]}