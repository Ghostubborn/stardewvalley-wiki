{"s":[[null,1,[["p",["电池组是一种资源，可以在",["l","天气#雷雨","雷雨"],"天气下由",["l","避雷针","避雷针"],"产生，也可以由放置在户外的",["l","太阳能板","太阳能板"],"经过 7 个晴天后产出。"]],["p",["对于避雷针，在雷雨天气期间，被",["l","闪电","闪电"],"击中的",["l","避雷针","避雷针"],"会进入充能状态，并在第二天早上生成一个电池组。闪电发生时，玩家不需要在位于农场中。"]],["p",["对于太阳能板，无论何时放置/收获太阳能板，它都会在 6 个晴天后的 19:20 准时产出一个电池组。"]],["p",["旅行货车会以 1,500–2,500金 的价格随机出售。完成儿童收集包可以获得 3 个电池组作为奖励。击杀",["l","骷髅洞穴","骷髅洞穴"],"内的",["l","蝙蝠#变种","铱蝠"],"也有 5% 的概率会掉落一个电池组。破坏",["l","骷髅洞穴","骷髅洞穴"],"里的木桶也有极小的概率（0.18%）掉落一个电池组。击杀",["l","矿井#特殊物品","特殊怪物"],"（",["l","史莱姆#特殊史莱姆","特殊史莱姆"],"会有黄色星形触角的明显特征，其他特殊怪物与正常怪物无明显差异）也会有概率掉落一个电池组。当饲养有",["l","黄貂鱼","黄貂鱼"],"的",["l","鱼塘","鱼塘"],"在数量达到 9 时，每天有 8.7~9.5% 的几率产出 1 个电池组。"]],["p",["当玩家与",["l","潘姆","潘姆"],"或",["l","肯特","肯特"],"的友谊值大于 0 时，他们有可能会随信赠送一个电池组作为礼物。"]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","玛鲁","玛鲁"]]],[{"h":1,"v":["不喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]]]]]],["收集包",2,[["p",["工程师收集包需要 1 个电池组。"]]]],["打造",2,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["配方来源"]},{"h":1,"v":["所需原料"]}],[[["f","Iridium_Sprinkler.png",48]],[["l","铱制洒水器","铱制洒水器"]],["每天早晨灌溉临近的 24 个地块。"],["耕种 9 级"],[["i","(O)336","金锭×1"],["i","(O)337","铱锭×1"],["i","(O)787","电池组×1"]]],[[["f","Crystalarium.png",48]],[["l","宝石复制机","宝石复制机"]],["置入你的宝石，它就会被复制。"],["采矿 9 级"],[["i","(O)390","石头×99"],["i","(O)336","金锭×5"],["i","(O)337"