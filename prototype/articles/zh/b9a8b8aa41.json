{"s":[[null,1,[["p",["顶级肥料是一种可用于培育",["l","农作物","高品质作物"],"的",["l","肥料","肥料"],"。顶级肥料能够在",["l","齐先生的核桃房","齐先生的核桃房"],"以20齐钻 购买制造配方后通过",["l","打造","打造"],"获得，破坏",["l","矿井","危险的矿井"],"里或",["l","骷髅洞穴","危险的骷髅洞穴"],"里的木桶也有极小的概率（0.23%）掉落一个顶级肥料。"]],["p",["撒上顶级肥料的作物将有几率收获铱星品质，这也是目前唯一得到铱星品质农作物的方法。"]],["p",["顶级肥料可以在作物的任何生长阶段施在犁过的土壤中。在收获作物时，顶级肥料只影响收获的第一个农作物，这意味着能够一次收获多个产品的作物（例如",["l","蓝莓","蓝莓"],"、",["l","蔓越莓","蔓越莓"],"等）在收获时获得的额外产物永远是普通品质。顶级肥料对",["l","打造#种子","野生种子"],"不起作用"]]]],["送礼",2,[["t",[[{"h":1,"v":["不喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]]]]]],["任务",2,[["p",["顶级肥料不用于任何",["l","任务","任务"],"。"]]]],["你知道吗",2,[["p",["顶级肥料是能够在作物成熟时施在耕地上，并直接影响收获的作物品质的，但是在正常游戏中这种操作无法实现，因为尝试将顶级肥料施在耕地上时会首先将作物收获下来。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.5#1.5","1.5"],"：加入游戏。"]]]]]]],"f":[["来源",[["l","打造","打造"]]],["产出",["5"]],["原料",[["i","(O)337","铱锭×1"],["i","(O)92","树液×40"]]],["售价",["70金"]]]}