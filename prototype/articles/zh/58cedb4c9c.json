{"s":[[null,1,[["p",["黄金矿石是一种矿物资源。主要通过用",["l","十字镐","十字镐"],"开采",["l","采矿","金矿"],"获得。"]]]],["获取途径",2,[["l",0,[[1,["可以无限量在",["l","铁匠铺","铁匠铺"],"中购买，第一年售价400金，第二年之后售价750金。"]],[1,["拥有",["l","分解机","分解机"],"之后，可以以1,600金从",["l","矮人","矮人"],"处购买",["l","超级炸弹","超级炸弹"],"后分解获得4个黄金矿石。(如果玩家需要的是金锭，可以从威利处以750金购买",["l","寻宝者","寻宝者"],"分解获取2个金锭。)"]],[1,["开采",["l","采矿","金矿"],"："]],[2,[["l","矿井","矿井"],"中的金矿只在80层之后出现。"]],[2,[["l","骷髅洞穴","骷髅洞穴"],"中的金矿在60层后开始出现，80层以后会更加常见。"]],[2,["金矿可能出现在",["l","火山地牢","火山地牢"],"的任意层。"]],[2,[["l","深山","深山"],"中的",["l","采石场","采石场"],"、以及",["l","农场地图","山顶农场"],"和",["l","农场地图","四角农场"],"中的小型采石场中也会偶尔生成金矿。"]],[1,["打破矿井中的",["l","矿井","木箱和木桶"],"时有可能获得。"]],[1,[["l","幽灵","幽灵"],"有20%的概率掉落1~3个黄金矿石。"]],[1,["有几率出现在",["l","钓鱼","釣魚宝箱"],"中。"]],[1,["挖掘",["l","沙滩","沙滩"],"上的",["l","远古斑点","远古斑点"],"时有几率获得。"]],[1,["打开",["l","冰封晶球","冰封晶球"],"、",["l","岩浆晶球","岩浆晶球"],"或",["l","万象晶球","万象晶球"],"时有几率获得。"]],[1,["使用",["l","淘盘","淘盘"],"淘金时有几率获得。"]],[1,["偶尔可以在",["l","旅行货车","旅行货车"],"中以100–1,000金的价格购买。"]],[1,[["l","岩浆鳗鱼","岩浆鳗鱼"],"的",["l","鱼塘","鱼塘"],"在容量达到3之后，有概率产出黄金矿石。"]]]]]],["熔炼",2,[["p",["黄金矿石可与",["l","煤炭","煤炭"],"一起在",["l","熔炉","熔炉"],"中熔炼出",["l","金锭","金锭"],"。每熔炼一个",["l","金锭","金锭"],"需要5个黄金矿石和1个",["l","煤炭","煤炭"],"，花费5小时",["l","游戏内时间","游戏内时间"],"制得。"]]]],["制作",2,[["p",["黄金矿石可以制作下列物品："]],["t",[[{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["材料"]},{"h":1,"v":["配方来源"]}],[[["l","超级炸弹","超级炸弹"]],["会发生大爆炸。使用时请格外小心。"],[["i","(O)384","黄金矿石×4"],["i","(O)768","太阳精华×1"],["i","(O)769","虚空精华×1"]],[["l","采矿","采矿"],"等级8"]]]]]],["送礼",2,[["t",[[{"h":1,"v":["一般"]},[["l","克林特","克林特"]]],[{"h":1,"v":["不喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l",