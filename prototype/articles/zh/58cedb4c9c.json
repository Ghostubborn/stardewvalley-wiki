{"s":[[null,1,[["p",["黄金矿石是一种资源，可以通过",["l","采矿","采矿"],"获得，也可以直接从",["l","铁匠铺","铁匠铺"],"购买。"]]]],["获取",2,[["l",0,[[1,["在",["l","铁匠铺","铁匠铺"],"直接购买，第一年售价为400金，第二年起售价为750金"]],[1,["在",["l","矿井","矿井"],"、",["l","骷髅洞穴","骷髅洞穴"],"、",["l","采石场","采石场"],"、",["l","采石场矿井","采石场矿井"],"和",["l","火山地牢","火山地牢"],"中开采",["l","采矿#Iron Node","金矿"]]],[2,[["l","矿井","矿井"],"中的金矿只会在 81 层之后出现"]],[2,[["l","骷髅洞穴","骷髅洞穴"],"和",["l","火山地牢","火山地牢"],"的任意层中都可以生成金矿，其中",["l","骷髅洞穴","骷髅洞穴"],"中的金矿会随着玩家的深入而逐渐增多"]],[2,[["l","采石场","采石场"],"、",["l","采石场矿井","采石场矿井"],"、",["l","农场地图#Hilltop","山顶农场"],"和",["l","农场地图#Four Corners","四角农场"],"的采矿区中都会生成金矿"]],[1,["在",["l","矿井","矿井"],"、",["l","采石场矿井","采石场矿井"],"、",["l","骷髅洞穴","骷髅洞穴"],"和",["l","火山地牢","火山地牢"],"中打破",["l","矿井#木箱和木桶","木箱和木桶"]]],[1,["击杀",["l","幽灵","幽灵"],"有 20% 概率掉落 1~3 个黄金矿石"]],[1,["打开",["l","冰封晶球","冰封晶球"],"、",["l","岩浆晶球","岩浆晶球"],"或",["l","万象晶球","万象晶球"]]],[1,["在",["l","沙滩","沙滩"],"上挖掘",["l","远古斑点","远古斑点"]]],[1,["在任意区域",["l","淘盘","淘金"]]],[1,["打开",["l","钓鱼#宝箱","钓鱼宝箱"],"或",["l","钓鱼#金宝箱","金色钓鱼宝箱"]]],[1,["旅行货车会以 100–1,000金 的价格随机出售"]],[1,["饲养有",["l","岩浆鳗鱼","岩浆鳗鱼"],"的",["l","鱼塘","鱼塘"],"在数量到达 3 时，每天有 3.9~6.5% 的几率产出 5 个黄金矿石"]]]]]],["熔炼",2,[["p",["黄金矿石可与",["l","煤炭","煤炭"],"一起在",["l","熔炉","熔炉"],"中熔炼出",["l","金锭","金锭"],"。每熔炼一个",["l","金锭","金锭"],"需要5个黄金矿石和1个",["l","煤炭","煤炭"],"，花费5小时",["l","游戏内时间","游戏内时间"],"制得。"]]]],["打造",2,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["配方来源"]},{"h":1,"v":["所需原料"]}],[[["f","Mega_Bomb.png",48]],[["l","超级炸弹","超级炸弹"]],["会发生大爆炸。使用时请格外小心。"],["采矿 8 级"],[["i","(O)384","黄金矿石×4"],["i","(O)768","太阳精华×1"],["i","(O)769","虚空精华×1"]]]]]]],["送礼",2,[["t",[[{"h":1,"v":["一般"]},[["l","克林特","克林特"]]],[{"h":1,"v":["不喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]],[{"h":1,"v":["讨厌"]},[["l","山姆","山姆"]]]]]]],["裁制",2,[["p",["黄金矿石可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成可染色的 ",["l","裁缝","龟脖毛衣"],"。黄金矿石可用于",["l","染色","染色"],"。放置在",["l","染色#染料罐","染料罐"],"内时，黄金矿石可用作黄色染料。放置在",["l","染色#缝纫机","缝纫机"],"内时，黄金矿石还可用作金色染料。"]]]],["任务",2,[["p",["某些鱼的鱼塘在容量从5提升到7的时候，可能会出现要求玩家提供3个黄金矿石的",["l","鱼塘#任务","鱼塘任务"],"。"]]]],["提示",2,[["l",0,[[1,["在拥有了",["l","分解机","分解机"],"之后，可以在",["l","矮人","矮人"],"处花费1,600金 购买",["l","超级炸弹","超级炸弹"],"并将其分解为 4 个黄金矿石，相当于每个黄金矿石400金。若需要",["l","金锭","金锭"],"，则可在",["l","鱼店","鱼店"],"花费750金 购买",["l","寻宝者","寻宝者"],"，其可被分解为 2 个金锭。"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.3#1.3.27","1.3.27"],"：第二年之后，在",["l","铁匠铺","铁匠铺"],"中的价格从第一年的400金 上涨到750金。"]],[1,[["l","版本历史/1.4#1.4","1.4"],"：现在可用于",["l","裁缝","裁缝"],"。可能会用于",["l","鱼塘#任务","鱼塘任务"],"中。鱼塘中有概率产出。"]]]]]]],"f":[["来源",[["l","采矿","采矿"]," • ",["l","铁匠铺","铁匠铺"]]],["售价",["25金"]]]}