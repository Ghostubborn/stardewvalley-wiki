{"s":[[null,1,[["p",["保护戒指是一种",["l","戒指","戒指"],"，可以通过打开",["l","火山地牢#普通宝箱","火山地牢的普通宝箱"],"获得。"]],["p",["玩家佩戴保护戒指时，受击后的无敌时间会提升0.4秒（无敌时间是指受到攻击后角色闪烁动画的时长，玩家角色闪烁期间不会受到任何伤害）。佩戴一个保护戒指可将无敌时间增加至1.6秒，佩戴两个则为2.0秒。"]],["p",["无敌期间",["l","幽灵","幽灵"],"攻击到玩家依旧会瞬移。"]]]],["染色",2,[["p",["保护戒指可用作放置在",["l","染色#缝纫机","缝纫机"],"内时的灰色染料。"]]]],["趣闻",2,[["l",0,[[1,["闪烁过程中",["l","帽子","帽子"],"不会跟着一起闪烁。"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.5","1.5"],"：加入游戏。"]]]]]]]}