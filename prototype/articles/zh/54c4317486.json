{"s":[[null,1,[["p",["无尽财富之雕像是一件",["l","家具","家具"],"，可从",["l","赌场","赌场"],"购买，价格为1,000,000金，可购买的数量不限。"]],["p",["无尽财富之雕像每天会生产出一件物品。如果当天没有收取，第二天会被新生产的物品替代。"]],["p",["这个雕像是游戏中最贵的物品之一，也是获得",["l","铱锭","铱锭"],"的最简单方法之一，但是其产出并不匹配它高昂的价格。"]]]],["通常",2,[["p",["如果当天没有",["l","居民","居民"],"过生日，雕像随机生产以下四种物品之一，概率相同。"]],["p",[["i","(O)72","钻石"],"、",["i","(O)337","铱锭"],"、",["i","(O)749","万象晶球"],"或",["i","(O)336","金锭"],"。"]]]],["生日",2,[["p",["如果当天有",["l","居民","居民"],"过生日，雕像会生产一件该村民最爱的礼物，品质始终为普通品质（即最低品质）。"]],["t",[[{"h":1,"v":["生成道具"]},{"h":1,"v":["寿星"]}],[[["i","(O)66","紫水晶"]],[["l","阿比盖尔","阿比盖尔"]]],[[["i","(O)207","豆类火锅"]],[["l","德米特里厄斯","德米特里厄斯"]]],[[["i","(O)90","仙人掌果子"]],[["l","山姆","山姆"]]],[[["i","(O)88","椰子"]],[["l","莱纳斯","莱纳斯"]]],[[["i","(O)201","完美早餐"]],[["l","亚历克斯","亚历克斯"]]],[[["i","(O)18","黄水仙"]],[["l","桑迪","桑迪"]]],[[["i","(O)72","钻石"]],[["l","艾芙琳","艾芙琳"]," • ",["l","格斯","格斯"]," • ",["l","乔迪","乔迪"]," • ",["l","科罗布斯","科罗布斯"]," • ",["l","玛妮","玛妮"]," • ",["l","玛鲁","玛鲁"]," • ",["l","威利","威利"]]],[[["i","(O)444","鸭毛"]],[["l","雷欧","雷欧"]]],[[["i","(O)60","绿宝石"]],[["l","克林特","克林特"]," • ",["l","艾米丽","艾米丽"]," • ",["l","潘妮","潘妮"]]],[[["i","(O)213","鱼肉卷"]],[["l","卡洛琳","卡洛琳"]]],[[["i","(O)202","炸鱿鱼"]],[["l","皮埃尔","皮埃尔"]]],[[["i","(O)84","泪晶"]],[["l","塞巴斯蒂安","塞巴斯蒂安"]]],[[["i","(O)20","韭葱"]],[["l","乔治","乔治"]]],[[["i","(O)554","柠檬石"]],[["l","矮人","矮人"]]],[[["i","(O)715","龙虾"]],[["l","艾利欧特","艾利欧特"]]],[[["i","(O)24","防风草"]],[["l","潘姆","潘姆"]]],[[["i","(O)221","粉红蛋糕"]],[["l","海莉","海莉"]," • ",["l","贾斯","贾斯"]," • ",["l","文森特","文森特"]]],[[["i","(O)206","披萨"]],[["l","谢恩","谢恩"]]],[[["i","(O)607","烤榛子"]],[["l","肯特","肯特"]]],[[["i","(O)196","沙拉"]],[["l","莉亚","莉亚"]]],[[["i","(O)224","意大利面"]],[["l","罗宾","罗宾"]]],[[["i","(O)155","大海参"]],[["l","法师","法师"]]],[[["i","(O)200","蔬菜杂烩"]],[["l","刘易斯","刘易斯"]]],[[["i","(O)348","果酒"]],[["l","哈维","哈维"]]]]]]],["趣闻",2,[["l",0,[[1,["无尽财富之雕像外观近似于招财猫。招财猫是好运的象征，一般比较常见于中国和日本。"]],[1,["在最佳条件下雕像仍是亏损的，即使拉长游戏内游玩的时间也无法收回成本。"]]]]]]]}