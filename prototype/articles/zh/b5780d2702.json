{"s":[[null,1,[["p",["芒果幼苗是一种",["l","果树","果树"],"幼苗。种下后经28天生长可以长成",["l","芒果树","芒果树"],"。芒果树在",["l","夏季","夏季"],"每一天都会结出一个芒果。像其他果树一样，如果种植在",["l","温室","温室"],"里或",["l","姜岛","姜岛"],"上，它会全年结果。"]],["p",["芒果幼苗可以通过下列途径获得："]],["l",0,[[1,["以75个",["l","蚌","蚌"],"与",["l","姜岛商人","姜岛商人"],"交换"]],[1,["敲开",["l","金色椰子","金色椰子"],"概率获得（概率大约为 1/7）"]],[1,[["l","岛屿办事处","岛屿办事处"],"的收集奖励（捐赠整套蛇骨头）"]],[1,["击败",["l","史莱姆（怪物）","老虎史莱姆"],"概率掉落（概率为 0.5%）"]]]]]],["生长阶段",2,[["t",[[{"h":1,"v":["阶段 1"]},{"h":1,"v":["阶段 2"]},{"h":1,"v":["阶段 3"]},{"h":1,"v":["阶段 4"]},{"h":1,"v":["阶段 5 - 春季，夏季，秋季，冬季"]},{"h":1,"v":["收成"]}],[[["f","Mango_Stage_1.png",100]],[["f","Mango_Stage_2.png",100]],[["f","Mango_Stage_3.png",100]],[["f","Mango_Stage_4.png",100]],[["f","Mango_Stage_5.png",384]],[["f","Mango_Stage_5_Fruit.png",96]]],[["7 天"],["7 天"],["7 天"],["7 天"],["总计: 28 天"],["夏季"]]]]]],["送礼",2,[["t",[[{"h":1,"v":["不喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","雷欧","雷欧"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"]]]]]]]]}