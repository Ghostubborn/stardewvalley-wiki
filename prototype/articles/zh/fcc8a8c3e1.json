{"s":[[null,1,[["p",["森林魔法永久解锁阅读",["l","祝尼魔","祝尼魔"],"语言的能力，通过完成任务 ",["l","任务#Meet the Wizard","会见法师"]," 后获得，这个任务在",["l","玩家角色","玩家"],"调查",["l","社区中心","社区中心"],"的第一个金色卷轴后的第二天早上解锁。"]],["p",["森林魔法可以在",["l","玩家角色","玩家"],"菜单的",["l","特殊物品与能力","特殊物品与能力"],"选项卡中找到。如果没有这个能力，则无法向",["l","社区中心","社区中心"],"捐赠",["l","收集包","收集包"],"。"]]]],["注意",2,[["p",["如果玩家之前未去过",["l","法师塔","法师塔"],"触发任务",["l","任务","会见法师"],"，则在玩家选择",["l","Joja超市","Joja超市"],"会员并在",["l","社区中心","社区中心"],"改建为",["l","Joja仓库","Joja仓库"],"后永远无法解锁该能力。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.0","1.0"],"：加入游戏。"]],[1,[["l","版本历史#1.6","1.6"],"：现在在",["l","特殊物品与能力","特殊物品与能力"],"选项卡中可见。"]]]]]]],"f":[["来源",["完成任务 ",["l","任务#剧情任务","会见法师"]," 获得"]]]}