{"s":[[null,1,[["p",["黑莓是一种",["l","水果","水果"],"。可以在",["l","秋季","秋季"],"通过",["l","采集","采集"],"或种植",["l","秋季种子","秋季种子"],"获得。也能够在黑莓收获季（秋季 8~11 日）时户外的灌木丛中找到。如果玩家选择了",["l","山洞#果蝠","果蝠"],"类型的",["l","山洞","农场山洞"],"，那么还可以在",["l","山洞","山洞"],"中找到黑莓。"]],["p",["旅行货车会以 100–1,000金 的价格随机出售。在秋季翻动",["l","垃圾桶","垃圾桶"],"也有概率找到黑莓。"]],["p",["在黑莓成熟季时，在每个生产黑莓的灌木丛中获取的数量会随着",["l","采集","采集"],"的等级的上升而增加。每升级 4 级收获数量 +1，即 采集 4 级时，每个灌木丛收获 2 个黑莓；采集 8 级时，每个灌木丛收获 3 个黑莓，依此类推。如果通过进食带有",["l","采集","采集"],"等级的菜品将采集等级暂时地提高到 12 级或更高，那么每个灌木丛就能得到 4 个黑莓。每收获 1 个黑莓会获得1 点采集经验值。"]]]],["品质",2,[["p",["在黑莓成熟季时，从灌木丛中摇下来的黑莓永远为普通品质，从地上拾起或种植",["l","秋季种子","秋季种子"],"而得到的黑莓有可能为普通、银星、金星品质。若选择了",["l","技能#采集","植物学家"],"职业，那么它们都会变成铱星品质。"]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","德米特里厄斯","德米特里厄斯"],"、",["l","艾利欧特","艾利欧特"],"、",["l","哈维","哈维"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","莉亚","莉亚"],"、",["l","莱纳斯","莱纳斯"],"、",["l","潘姆","潘姆"],"、",["l","罗宾","罗宾"],"、",["l","桑迪","桑迪"],"、",["l","谢恩","谢恩"]]],[{"h":1,"v":["一般"]},[["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","矮人","矮人"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","玛妮","玛妮"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","山姆","山姆"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","威利","威利"],"、",["l","法师","法师"]]],[{"h":1,"v":["不喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","玛鲁","玛鲁"],"、",["l","文森特","文森特"]]]]]]],["收集包",2,[["l",0,[[1,["秋季采集收集包需要 1 个黑莓；"]],[1,["秋季采集收集包需要 1 个黑莓；"]],[1,["采集者收集包需要 50 个黑莓（作为可选项）。"]]]]]],["食谱",2,[["t",[[{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["所需原料"]},{"h":1,"v":["能量 / 生命值"]},{"h":1,"v":["增益效果"]},{"h":1,"v":["增益时长"]},{"h":1,"v":["食谱来源"]},{"h":1,"v":["售出价格"]}],[[["l","黑莓脆皮饼","黑莓脆皮饼"]],["没有比这更好吃的了。"],[["i","(O)410","黑莓×2"],["i","(O)245","糖×1"],["i","(O)246","大麦粉×1"]],["能量 175\n生命值 78"],["无"],["无"],["烹饪频道（偶数年秋季 14 日）"],["260金"]]]]]],["打造",2,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["配方来源"]},{"h":1,"v":["所需原料"]}],[[["f","Fall_Seeds.png",48]],["野生种子（秋季）（10）"],["各种各样的秋季种子。"],["采集 6 级"],[["i","(O)404","普通蘑菇×1"],["i","(O)406","野梅×1"],["i","(O)408","榛子×1"],["i","(O)410","黑莓×1"]]]]]]],["裁制",2,[["p",["黑莓可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","上衣"],"。黑莓可用于",["l","染色","染色"],"。放置在",["l","染色#染料罐","染料罐"],"内时，黑莓可用作蓝色染料。放置在",["l","染色#缝纫机","缝纫机"],"内时，黑莓还可用作深蓝色染料。"]]]],["任务",2,[["l",0,[[1,["黑莓可能会随机地出现在",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"外的",["l","任务#求助任务","\"需要帮助\" 公告板"],"中，完成奖励为60金和150",["l","友谊","友谊"],"点数。"]]]]]],["漏洞",2,[["l",0,[[1,["在秋季 8 日，电视节目“",["l","离地而居","离地而居"],"” 会通知“现在是黑莓收获季！”"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.3#1.3","1.3"],"：加入了 ",["l","熊的知识","熊的知识"],"。"]],[1,[["l","版本历史#1.6","1.6"],"：现在每收获1个",["l","美洲大树莓","美洲大树莓"],"或1个黑莓，将会获得1点采集经验值。"]]]]]]],"f":[["来源",[["l","采集","采集"]," • ",["l","秋季种子","秋季种子"]," • ",["l","山洞#果蝠","山洞（果蝠）"],"\n黑莓季（",["l","秋季","秋季"]," 8~11 日）的灌木丛"]],["季节",[["l","秋季","秋季"]]],["售价",["20金"]]]}