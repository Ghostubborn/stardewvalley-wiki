{"s":[[null,1,[["p",["黑莓是一种能在星露谷通过",["l","采集","采集"],"而找到的",["l","水果","水果"],"。它能够在秋天的地上或在黑莓收获季（",["l","秋季","秋季"],"8~11）时户外的灌木丛中找到。它也能通过种植",["l","秋季种子","秋季种子"],"得到。在秋季翻动",["l","垃圾桶","垃圾桶"],"也有概率找到黑莓。"]],["p",["在黑莓收获季时，在每个生产黑莓的灌木丛中获取的数量随着",["l","采集","采集"],"的等级的上升而增加。等级4时，每个灌木丛能得到2个黑莓。等级8时，每个灌木丛会得到3个黑莓。如果",["l","采集","采集"],"等级通过进食烹饪的食物被暂时地提高到12或13级，那么每个灌木丛就能得到4个黑莓。每收获1个黑莓会获得1点采集经验值。"]]]],["品质",2,[["p",["黑莓在黑莓收获季时，被玩家从灌木丛中摇下来时为普通品质。除非在",["l","技能","植物学家"],"的影响下，它们会永远呈现为铱星品质。除了在植物学家的影响下，从地上拾起或种植",["l","秋季种子","秋季种子"],"而得到的黑莓会表现为普通、银星、金星品质。"]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","潘姆","潘姆"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","艾利欧特","艾利欧特"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"]]],[{"h":1,"v":["一般"]},[["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","艾米丽","艾米丽"],"、",["l","山姆","山姆"],"、",["l","玛妮","玛妮"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"]]],[{"h":1,"v":["不喜欢"]},[["l","玛鲁","玛鲁"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"]]]]]]],["收集包",2,[["l",0,[[1,["用于秋季采集收集包。"]],[1,["黑莓是采集者收集包的可选项之一，数量需求为50。"]]]]]],["配方",2,[]],["烹饪",3,[["t",[[{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["所需原料"]},{"h":1,"v":["能量 / 生命值"]},{"h":1,"v":["食谱来源"]},{"h":1,"v":["售出价格"]}],[[["l","黑莓脆皮饼","黑莓脆皮饼"]],["没有比这更好吃的了。"],[["i","(O)410","黑莓×2"],["i","(O)245","糖×1"],["i","(O)246","大麦粉×1"]],["能量 175\n生命值 78"],["烹饪频道（偶数年秋季14日）"],["260金"]]]]]],["打造",3,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["材料"]},{"h":1,"v":["配方来源"]},{"h":1,"v":["售价"]}],[[["f","Fall_Seeds.png",48]],[["l","秋季种子","秋季种子"]],["各种各样的秋季种子。\n（每次会制作出10个秋季种子）"],[["i","(O)410","黑莓×1"],["i","(O)404","普通蘑菇×1"],["i","(O)408","榛子×1"],["i","(O)406","野梅×1"]],[["f","Foraging_Skill_Icon.png",24]," ",["l","采集","采集"]," 6级"],["45金"]]]]]],["裁制",2,[["p",["黑莓可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","上衣"],"。黑莓可用于",["l","染色","染色"],"。放置在",["l","染色","染料罐"],"内时，黑莓可用作蓝色染料。放置在",["l","染色","缝纫机"],"内时，黑莓还可用作深蓝色染料。"]]]],["任务",2,[["l",0,[[1,["黑莓可能会随机地出现在",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"外的",["l","任务","\"需要帮助\" 公告板"],"中，完成奖励为60金和150",["l","友谊","友谊"],"点数。"]]]]]],["漏洞",2,[["l",0,[[1,["在秋季的4号到8号，电视节目\"",["l","离地而居","离地而居"],"\" 会通知\"现在是黑莓收获季!\""]]]]]]],"f":[["来源",[["l","采集","采集"]," • ",["l","秋季种子","秋季种子"]]],["季节",[["l","秋季","秋季"]]],["售价",["20金"]]]}