,["l","季节性植物","季节性植物"],"（编号 #1/2/3/6）"]],[1,["夏季 = ",["l","室内椰子树","室内椰子树"],"、(如果温布斯正在上映：",["l","温布斯雕像","温布斯雕像"],"、",["l","波波雕像","波波雕像"],")、(如果草原之王之旅正在上映: ",["l","长棕榈","长棕榈"],"、",["l","长仙人掌","长仙人掌"],")"]],[1,["秋季 = ",["l","小壁挂南瓜","小壁挂南瓜"],"、",["l","壁挂南瓜","壁挂南瓜"],"、",["l","风干太阳花","风干太阳花"],"、",["l","墓石","墓石"],"、",["l","绿蛇雕像","绿蛇雕像"],"、",["l","紫蛇雕像","紫蛇雕像"]]],[1,["冬季 = ",["l","冬季树贴纸","冬季树贴花"],"、",["l","大红杖","大红杖"],"、",["l","大绿杖","大绿杖"],"、",["l","绿杖","绿杖"],"、",["l","红杖","红杖"],"、",["l","混色杖","混色杖"],"、",["l","冬日星树","冬日星树"]]]]]]],["注释",2,[["l",0,[[1,[["l","科罗布斯","科罗布斯"],"在周五不看电影。"]],[1,["与赠送礼物不同的，看电影的冷却时间在周一刷新。"]],[1,["尽管",["l","谢恩","谢恩"],"讨厌Joja可乐作为礼物，但对于小卖部里的Joja可乐，谢恩态度为最爱。"]],[1,["尽管两者十分相似，但村民们对个人披萨和披萨的喜好度却明显不同；许多喜欢披萨的村民不喜欢个人披萨。"]],[1,["值得一提的是，可以出现在电影院的NPC包括",["l","冈瑟","冈瑟"],"、",["l","州长","州长"],"、",["l","夜市#著名画家卢皮尼","著名画家卢皮尼"],"、",["l","电视#每日占卜","预言家维尔维克"],"以及在",["l","哈维","哈维"],"10心事件中出现的",["l","书摊老板","书摊老板"],"马尔赛罗。"]],[1,["节日期间也可以买",["l","电影票","电影票"],"，但是你无法进入电影院，也无法赠送给村民。"]],[1,["玩家不能使用",["l","小镇钥匙","小镇钥匙"],"来进入关闭的电影院。"]],[1,["玩家在与",["l","雷欧","雷欧"],"达到6心之前不能邀请他看电影。"]],[1,[["l","莱纳斯","莱纳斯"],"不喜欢所有的电影。"]],[1,[["l","矮人","矮人"],"和",["l","桑迪","桑迪"],"对所有的电影都是最爱。"]],[1,["第一年以解锁电影院开始计算。如在冬季解锁电影院，那么下一年春天将放映第一年的电影而不是第二年的。"]],[1,[["l","Joja超市","Joja超市"],"是否改造为电影院不影响",["l","特殊的魅力","特殊的魅力"],"的获得（尽管货车司机就在由",["l","Joja超市","Joja超市"],"旁边）。"]]]]]],["你知道吗",2,[["l",0,[[1,[["l","ConcernedApe","ConcernedApe"],"在2011年创作了一系列叫作Wumbus World（温布斯世界）的漫画。"]],[1,["如果玩家携带了“",["l","鹦鹉蛋","鹦鹉蛋"],"”进入了放映厅，那么鹦鹉会在电影途中鸣叫（也许应该从饰品栏上拿下来）。"]],[1,["值得注意的是从",["l","电影院","抓娃娃机"],"小游戏获得的“家居植物 #6”的物品代码为(BC)2而不是(F)1381，其简介也与正常家居植物不同“为你的房子或农场增加一些特色”，放在地上对其右键可以使其外观按(BC)0~(BC)7的顺序（家居植物 #4~#11）进行切换。这也是正常游戏中唯一可以获取(BC)类家居植物的方法。"]]]]]],["漏洞",2,[["l",0,[[1,["如果玩家邀请了",["l","潘妮","潘妮"],"去看电影，",["l","潘姆","潘姆"],"一定不会随机进入电影院。但是如果在",["l","合作","多人游戏"],"中两名玩家同时邀请她们去看电影，仍可以让她们一起看电影。"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.4#1.4","1.4"],"：加入游戏。"]],[1,[["l","版本历史/1.4#1.4.4","1.4.4"],"：",["l","山姆","山姆"],"对电影院内的Joja可乐的喜好变更为喜欢。"]],[1,[["l",