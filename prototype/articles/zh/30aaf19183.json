{"s":[[null,1,[["p",["泪晶是一种",["l","矿物","矿物"],"。泪晶可在",["l","矿井","矿井"],"的40~79层通过",["l","采集","采集"],"找到，或作为",["l","灰尘精灵","灰尘精灵"],"的掉落物（几率为2%）出现。泪晶还可以通过",["l","淘盘","淘金"],"、敲开",["l","冰封晶球","冰封晶球"],"和",["l","万象晶球","万象晶球"],"、",["l","钓鱼","钓鱼宝箱"],"、翻找",["l","垃圾桶","垃圾桶"],"（当玩家到达矿井底部）等多种途径获得。饲养有",["l","冰柱鱼","冰柱鱼"],"的",["l","鱼塘","鱼塘"],"在数量达到9的时候，可能会产出5个泪晶。",["l","无尽财富之雕像","无尽财富之雕像"],"会在",["l","塞巴斯蒂安","塞巴斯蒂安"],"生日时（冬10日）生产一个泪晶。"]],["p",["放置在地上的地晶可以被",["l","打造","炸弹"],"炸成掉落的可拾取物品。"]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","塞巴斯蒂安","塞巴斯蒂安"]]],[{"h":1,"v":["喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]],[{"h":1,"v":["不喜欢"]},[["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","莉亚","莉亚"]]]]]]],["收集包",2,[["p",["泪晶用于地理学家的收集包。"]]]],["配方",2,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["材料"]},{"h":1,"v":["配方來源"]}],[[["f","Warrior_Ring.png",48]],[["l","战士戒指","战士戒指"]],["在杀死怪物后，偶尔输送“战士能量”给佩戴者。"],[["i","(O)335","铁锭×10"],["i","(O)382","煤炭×25"],["i","(O)84","泪晶×10"]],[["f","Combat_Skill_Icon.png",24]," ",["l","战斗","战斗"]," 4级"]]]]]],["裁制",2,[["p",["泪晶可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","深色夹克"],"。泪晶可用于",["l","染色","染色"],"。放置在",["l","染色","染料罐"],"内时，泪晶可用作蓝色染料。放置在",["l","染色","缝纫机"],"内时，泪晶还可用作青色染料。"]]]],["任务",2,[["l",0,[[1,["泪晶会在任意季节出现在",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"外边的",["l","任务","“布告栏”"],"上，任务完成的奖励是 225金 和 150 ",["l","友谊","友谊点"],"。这个任务只有在你到达矿井的80层以及后，才会出现。"]],[1,[