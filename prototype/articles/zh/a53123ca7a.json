{"s":[[null,1,[["p",["章鱼是在",["l","夏季","夏季"],["l","沙滩","沙滩"],"和",["l","姜岛","姜岛"],"西部的海洋中可以发现的鱼（包括",["l","农场地图","海滩农场"],"）。在夏季翻动",["l","垃圾桶","垃圾桶"],"也有概率找到章鱼。当然，无论在什么季节，它都会随机出现在",["l","旅行货车","旅行货车"],"里，价格为450–1,000金。又或者，你可以通过乘坐",["l","夜市","夜市"],"的深海潜艇到深海钓鱼来获得它，上钩的概率为2％（如果使用",["l","珍稀诱钩","珍稀诱钩"],"，则为1.6%）。"]],["p",["可以使用",["l","魔法鱼饵","魔法鱼饵"],"不受季节和时间限制地钓到章鱼。"]],["p",["章鱼和",["l","石鱼","石鱼"],"是唯二必须",["l","烹饪","烹饪"],"或使用",["l","熏鱼机","熏鱼机"],"制成",["l","熏鱼","熏鱼"],"后才能食用的",["l","鱼","用鱼竿钓到的鱼"],"。"]],["p",["这是游戏中除了",["l","鱼","传说之鱼"],"以外最难钓到的鱼。每次抛竿有4-11%的几率在海滩钓到章鱼，在姜岛西部则有5-18%的几率，概率在某种程度上取决于确切的时间和天气，并且在较高的钓鱼等级和钓鱼区有更高的概率。"]]]],["地图",2,[["p",["章鱼可以在海洋和姜岛西部被发现。"]]]],["攻略",2,[["p",["这是一种极难钓到的鱼，即使与传说鱼相比也是如此。更苛刻的是，钓到章鱼的概率很小，捕获章鱼的时间窗口都非常短。为了更好的钓到章鱼，可以先达到",["l","钓鱼","钓鱼等级10"],"，使用",["l","铱金鱼竿","铱金鱼竿"],"，吃一种能提供钓鱼",["l","效果","效果"],"的食物，并且在鱼竿上装",["l","陷阱浮标","陷阱浮标"],"或",["l","软木塞浮标","软木塞浮标"],"。\n1.6版本更新过后，因为加入了",["l","高级鱼饵","高级鱼饵"],"和",["l","高级铱金鱼竿","高级铱金鱼竿"],"从而使垂钓时更为便捷。"]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","威利","威利"]]],[{"h":1,"v":["喜欢"]},[["l","艾利欧特","艾利欧特"]]],[{"h":1,"v":["一般"]},[["l","德米特里厄斯","德米特里厄斯"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","雷欧","雷欧"]]],[{"h":1,"v":["不喜欢"]},[["l","罗宾","罗宾"],"、",["l","玛鲁","玛鲁"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","艾米丽","艾米丽"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","科罗布斯","科罗布斯"]]],[{"h":1,"v":["讨厌"]},[["l","皮埃尔","皮埃尔"],"、",["l","艾芙琳","艾芙琳"],"、",["l","潘姆","潘姆"],"、",["l","海莉","海莉"]]]]]]],["收集包",2,[["p",["章鱼可用于钓鱼大师收集包。"]]]],["配方",2,[["t",[[{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["所需原料"]},{"h":1,"v":["能量 / 生命值"]},{"h":1,"v":["食谱来源"]},{"h":1,"v":["售出价格"]}],[[["l","生鱼寿司",