{"s":[[null,1,[["p",["枫树种子是一种",["l","树","树"],"苗，可以长出",["l","枫树","枫树"],"。在达到 ",["f","Foraging_Skill_Icon.png",24]," ",["l","技能","采集等级 1"],"以上后，可以通过摇晃或砍倒一棵",["l","枫树","枫树"],"获得枫树种子。成熟",["l","枫树","枫树"],"掉落的未发芽的枫树种子也可以用",["l","斧头","斧头"],"，",["l","十字镐","镐"],"或",["l","锄头","锄头"],"从土地中挖出。翻找",["l","垃圾桶","垃圾桶"],"也有可能会得到一个枫树种子。饲养有",["l","木跃鱼","木跃鱼"],"的",["l","鱼塘","鱼塘"],"在数量达到 9 时，可能会产出1~5个枫树种子。"]],["p",["枫树种子可以种植在农场内外任何未占用的可耕种方格中，但该方格必须未使用",["l","锄头","锄头"],"开垦过。"]],["p",["除了",["l","冬季","冬季"],"，枫树种子每晚都有大约 20% 的概率生长到下一阶段。总共有 5 个生长阶段，平均成熟时间约为 18 天，超过90%的枫树种子能在32天内完全成熟。"]],["p",["使用",["l","树肥","树肥"],"可以让枫树种子每晚都生长到下一个阶段，包括",["l","冬季","冬季"],"。"]]]],["送礼",2,[["t",[[{"h":1,"v":["不喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","雷欧","雷欧"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"]]]]]]],["收集包",2,[["p",["10个枫树种子可用于 森林收集包。"]]]],["配方",2,[["t",[[{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["所需原料"]},{"h":1,"v":["配方来源"]},{"h":1,"v":["售出价格"]}],[[["f","Mystic_Tree_Seed.png",48]],[["l","神秘树种","神秘树种"]],["可以种出特别的树。"],[["i","(O)309","橡子×5"],["i","(O)310","枫树种子×5"],["i","(O)311","松果×5"],["i","(O)292","桃花心木种子×5"]],[["f","Foraging_Skill_Icon.png",24]," ",["l","精通山洞","采集精通"]],["100金"]]]]]],["裁制",2,[["p",["枫树种子可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["i","(H)53","毛线帽"],"。枫树种子可用于",["l","染色","染色"],"。放置在",["l","染色","染料罐"],"内时，枫树种子可用作橙色染料。放置在",["l","染色","缝纫机"],"内时，枫树种子还可用作棕色染料