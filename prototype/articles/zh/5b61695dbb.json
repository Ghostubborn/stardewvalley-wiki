[],[["l","玉米种子","玉米种子"]],["150金"]],[[],[["l","茄子种子","茄子种子"]],["20金"]],[[],[["l","南瓜种子","南瓜种子"]],["100金"]],[[],[["l","小白菜种子","小白菜种子"]],["50金"]],[[],[["l","山药种子","山药种子"]],["60金"]],[[],[["l","蔓越莓种子","蔓越莓种子"]],["240金"]],[[],[["l","小麦种子","小麦种子"]],["10金"]],[[],[["l","玫瑰仙子种子","玫瑰仙子种子"]],["200金"]],[[],[["l","苋菜种子","苋菜种子"]],["70金"]],[[],[["l","葡萄种子","葡萄种子"]],["60金"]],[[],[["l","向日葵种子","向日葵种子"]],["200金"]],[[],[["l","洋蓟种子","洋蓟种子"]],["30金"]],[[],[["l","铱壁炉","铱壁炉"]],["15,000金"]],[[],[["l","稻草人","稀有稻草人 #7"]],["5,000金"]],[[],[["l","稻草人","稀有稻草人 #8"]],["5,000金"]],[[],[["l","水晶椅","水晶椅"]],["2,500金"]],[[],[["l","立式钢琴","立式钢琴"]],["100,000金"]]]]]]]],["美人鱼秀",3,[["p",["美人鱼船在下午5点至12点30分之间可以进入。进入后，会出现一只美人鱼，并开始唱歌，伴随着漂亮的动画。她的表演持续1小时40分钟，玩家可随时离开。如果玩家在美人鱼表演中途离开，之后再进入美人鱼船，美人鱼会从头开始表演。"]],["p",["表演结束后，玩家可以点击船内的蛤壳弹奏音符。如果玩家以正确的顺序弹奏出一段旋律，就会获得一个特殊物品。"]],["p",["可以在",["l","秘密纸条","秘密纸条 #15"],"中找到正确的音符顺序，然而秘密纸条对于完成谜题并不是必需的，美人鱼表演中演奏的曲调也暗示了谜题的答案。点击下方查看有关特殊物品的解决方案和信息。"]],["d","解決方案",[["p",["如果按照1-5-4-2-3（从左到右）的顺序进行弹奏，玩家将得到一个",["l","珍珠","珍珠"],"。每个",["l","存档","存档"],"中每个玩家只能通过这种方式获得一个珍珠，但美人鱼表演可以通过离开并重新进入美人鱼船随时重复观看。通过此方式获得珍珠后，玩家还有其他一些方式获得额外的珍珠。"]]]]]],["裹布人",3,[["p",["营业时间从下午5点到凌晨2点。只要支付250金，神秘魔法师就会将玩家传送到",["l","农场","农场"],"。与",["l","传送图腾：农场","传送图腾：农场"],"的作用相同。"]]]],["旅行货车",3,[["p",["营业时间从下午5点到凌晨2点。",["l","旅行货车","旅行货车"],"会乘着木筏出现在夜市的码头上。她出售一系列常用商品，包括",["l","合作","合作"],"模式中",["l","结婚戒指","结婚戒指"],"的配方。"]]]],["参加夜市的村民",2,[["p",["和其他",["l","节日","节日"],"不同，会参加夜市的",["l","居民","居民"],"在这一天都有特殊的行程表。夜市开放期间，这些村民会去往",["l","沙滩","沙滩"],"，因此无法在其他场景中找到他们。下面的列表显示了哪些村民每年参加哪一天的活动。"]],["p",["请注意：夜市期间玩家仍然可以完成收集、杀怪和钓鱼",["l","任务","任务"],"。与村民交谈可以完成相应任务，然后才会进行脚本化的节日对话。"]],["p",["与玩家结婚的村民不会参加夜市，而是普通地遵循他们相应日期的婚后时间表行动。"]],["p",[["l","罗宾","罗宾"],"如在",["l","农场","农场"],"中进行建设也不会参加夜市。"]],["p",["较于平时，",["l","威利","威利"],"在夜市这三天会更早前往",["l","星之果实酒吧","星之果实酒吧"],"，更晚回家。"]],["p",["夜市第一天\n",["l","阿比盖尔","阿比盖尔"],["l","克林特","克林特"],["l","艾米丽","艾米丽"],["l","哈维","哈维"],["l","贾斯","贾斯"],["l","莉亚","莉亚"],["l","雷欧","雷欧"],["l","莱纳斯","莱纳斯"],["l","潘妮","潘妮"],["l","谢恩","谢恩"]]],["p"