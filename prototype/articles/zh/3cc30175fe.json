{"s":[[null,1,[["g",[["Farm_Pond.jpg",200,["放有蟹笼的农场池塘"]]]],["p",["农场池塘泛指玩家",["l","农场","农场"],"内的所有水体。"]],["p",["在所有地图中，",["l","蟹笼","蟹笼"],"可以放入到农场池塘中，并且它们会和在其他淡水水体的蟹笼一样，发挥相同的效果。所有的池塘都可以用来给",["l","喷壶","喷壶"],"装满水，灌溉",["l","农作物","农作物"],"。"]],["p",["所有的地图的详细特质和玩家选择的",["l","农场地图","农场地图"],"有很大的关系："]],["l",0,[[1,["在",["l","农场地图","标准农场"],"，在池塘",["l","钓鱼","钓鱼"],"能钓到的只有",["l","回收机","垃圾"],"。"]],[1,["在",["l","农场地图","河边农场"],"："]],[2,["70%的情况下，玩家会钓到可在",["l","鹈鹕镇","鹈鹕镇"],"钓到的",["l","鱼","鱼"],"，参见",["l","鹈鹕镇","鹈鹕镇可钓到的鱼"],"。"]],[2,["30%的情况下，玩家会钓到可在",["l","煤矿森林","煤矿森林"],"的池塘钓到的鱼，参见",["l","煤矿森林","煤矿森林的池塘可钓到的鱼"],"。"]],[1,["在",["l","农场地图","森林农场"],"："]],[2,["5%的情况下，（取决于当日的",["l","运气","运气"],"），玩家可能会钓到",["l","木跃鱼","木跃鱼"],"。"]],[2,["45%的情况下，玩家会钓到可在",["l","煤矿森林","煤矿森林"],"的池塘钓到的鱼，参见",["l","煤矿森林","煤矿森林的池塘可钓到的鱼"],"。"]],[2,["其他情况下，玩家只能钓到垃圾。"]],[1,["在",["l","农场地图","山顶农场"],"："]],[2,["50%的情况下，玩家可以钓到可在",["l","煤矿森林","煤矿森林"],"的河里面钓到的鱼，参见",["l","煤矿森林","煤矿森林的河流可钓到的鱼"],"。"]],[2,["50%的情况下，玩家只能钓到垃圾。"]],[1,["在",["l","农场地图","荒野农场"],"："]],[2,["35%的情况下，玩家可以钓到可在",["l","深山","深山"],"山湖钓到的鱼，参见",["l","深山","深山的湖泊可钓到的鱼"],"。"]],[2,["65%的情况下，玩家只能钓到垃圾。"]],[1,["在",["l","农场地图","四角农场"],"："]],[2,["西南角的大池塘和森林农场的池塘类似：玩家有50%的机会钓到可在",["l","煤矿森林","煤矿森林"],"的池塘钓到的，参见",["l","煤矿森林","煤矿森林的池塘可钓到的鱼"],"。"]],[2,["其他三个角落的小池塘只能钓到垃圾。"]],[1,["在",["l","农场地图","海滩农场"]," ："]],[2,["两处池塘都只能钓到",["l","垃圾","垃圾"],"。"]]]]]]]}