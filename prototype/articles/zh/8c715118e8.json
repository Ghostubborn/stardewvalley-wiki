{"s":[[null,1,[["p",["青蛙木乃伊是一种可在",["l","岛屿办事处#捐赠","岛屿办事处"],"捐赠的化石。可以通过清除",["l","姜岛东部","姜岛东部"],"或",["l","矿井","危险的矿井"],"第 41~69 层内的",["l","杂草#特殊杂草","特殊杂草"],"获得。在解锁了",["l","岛屿办事处","岛屿办事处"],"且还未获得过青蛙木乃伊的情况下，破坏特殊杂草得到青蛙木乃伊的概率为 10%。通过这种获得青蛙木乃伊后的次日，这一概率将降低至 1%。"]]]],["捐赠",2,[["p",["青蛙木乃伊是",["l","岛屿办事处","岛屿办事处"],"青蛙化石的一部分。完成青蛙化石捐赠后，可以获得 1 个",["i","(O)73","金色核桃"],"，若玩家使用",["l","金色核桃#金色 Joja 鹦鹉","金色 Joja 鹦鹉"],"提前获取了全部的金色核桃，则将获得一个",["l","野炊工具","野炊工具"],"。"]]]],["送礼",2,[["t",[[{"h":1,"v":["讨厌"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]]]]]],["裁制",2,[["p",["青蛙木乃伊可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","骨架T恤"],"。青蛙木乃伊可用于",["l","染色","染色"],"。放置在",["l","染色#染料罐","染料罐"],"内时，青蛙木乃伊可用作黄色染料。放置在",["l","染色#缝纫机","缝纫机"],"内时，青蛙木乃伊还可用作沙色染料。"]]]],["任务",2,[["p",["在",["l","任务#Fragments of the past","特别任务：“历史的碎片”"],"期间，玩家需要提交 100 件骨头类物品，青蛙木乃伊可作为其中的一个可选项。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.5#1.5","1.5"],"：加入游戏。"]]]]]]],"f":[["来源",["清除",["l","姜岛东部","姜岛东部"],"或",["l","矿井","危险的矿井"],"的",["l","杂草#特殊杂草","特殊杂草"],"（10%）"]],["售价",["100金"]]]}