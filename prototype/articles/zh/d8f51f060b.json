{"s":[[null,1,[["p",["鸭蛋是一种动物制品，可由",["l","鸭","鸭子"],"产出。鸭蛋会在",["l","鸡舍","鸡舍"],"内有足够的空间时生成在鸡舍的地板上，玩家拾取后可获得 5 点耕种经验值。玩家也可以在鸡舍内放置",["l","自动采集器","自动采集器"],"以收集鸭蛋，但这样不会获得任何经验值。"]],["p",["旅行货车会以 285–1,000金 的价格随机出售。"]],["p",["鸭蛋可以放入",["l","鸡舍","大鸡舍或豪华鸡舍"],"的",["l","孵化器","孵化器"],"中孵化出小鸭子。孵化需要9000 分钟（5 天 16 小时 40 分钟），如果玩家选择了",["l","耕种#耕种技能","鸡舍大师"],"职业，则孵化时间减半。"]],["p",["当",["l","鸭","鸭"],"达到一定的",["l","动物#好感","好感度"],"和",["l","动物#心情","心情值"],"时，它将有几率产出",["l","鸭毛","鸭毛"],"。"]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","亚历克斯","亚历克斯"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","哈维","哈维"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","莉亚","莉亚"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","山姆","山姆"],"、",["l","谢恩","谢恩"]]],[{"h":1,"v":["一般"]},[["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","玛鲁","玛鲁"],"、",["l","潘妮","潘妮"],"、",["l","罗宾","罗宾"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"]]],[{"h":1,"v":["不喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","矮人","矮人"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","潘姆","潘姆"],"、",["l","文森特","文森特"],"、",["l","法师","法师"]]],[{"h":1,"v":["讨厌"]},[["l","塞巴斯蒂安","塞巴斯蒂安"]]]]]]],["收集包",2,[["p",["动物收集包需要 1 个鸭蛋（作为可选项）"]]]],["工匠物品",2,[["n",["另见：",["l","加工动物制品的收益","加工动物制品的收益"]]],["p",["鸭蛋可用于制作",["l","鸭蛋黄酱","鸭蛋黄酱"],"。"]]]],["裁制",2,[["p",["鸭蛋可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成可染色的 ",["l","裁缝","绿色T恤夹克"],"。鸭蛋可用于",["l","染色","染色"],"。放置在",["l","染色#缝纫机","缝纫机"],"内时，鸭蛋可用作白色染料。"]]]],["任务",2,[["p",[["l","格斯","格斯"],"的",["l","任务#Gus' Famous Omelet","特别任务：格斯的著名煎蛋卷"],"将会需要玩家在任务期间收集并提交24个蛋（任何蛋都适用）。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.0#1.0","1.0"],"：添加了鸭蛋。"]],[1,[["l","版本历史/1.1#1.1","1.1"],"：售价从 75金 提高到 95金。"]],[1,[["l","版本历史/1.4#1.4","1.4"],"：现在在裁缝中可用。"]]]]]]],"f":[["来源",[["l","鸭","鸭"]]],["售价",["95金"]]]}