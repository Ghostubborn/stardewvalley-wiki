{"s":[[null,1,[["p",["铱镰刀是选择",["l","精通山洞#精通","耕种精通"],"后从",["l","精通山洞","精通山洞"],"获得的工具。铱镰刀是最高品质的镰刀。"]],["p",["铱镰刀的升级效果如下:"]],["l",0,[[1,["可以收获其作用范围内的成熟作物，包括常规作物、生长在",["l","花盆","花盆"],"中的作物、",["l","大葱","大葱"],"、从",["l","打造","野生种子"],"中生长出来的作物。"]],[1,["铱镰刀的作用范围比",["l","金色的镰刀","金色的镰刀"],"更大，并且在挥舞时有更高的几率收割范围内的所有杂草。"]],[1,["铱镰刀收获干草的几率从",["l","金色的镰刀","金色的镰刀"],"的 75% 提升到了 100%。"]],[1,["作为武器时，铱镰刀的伤害提升到了 20。"]]]],["p",["铱镰刀除了左键主动使用，还可面对着",["l","农作物#作物分类","镰收作物"],"右键被动使用，效果与左键相同。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.6","1.6"],"：加入游戏。"]],[1,[["l","版本历史#1.6.9","1.6.9"],"：修复了使用铱镰刀收获",["l","打造","野生种子"],"生长出的采集物时只能获得普通品质并且不会获得任何经验的问题。"]]]]]]]}