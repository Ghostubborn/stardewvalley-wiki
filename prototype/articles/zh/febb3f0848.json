"潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"]]]]]]],["染色",2,[["p",["蟹笼可用于",["l","染色","染色"],"。放置在",["l","染色#染料罐","染料罐"],"内时，蟹笼可用作橙色染料。"]]]],["收益计算",2,[["l",0,[[1,["如果将蟹笼产出的所有",["l","垃圾","垃圾"],"都用",["l","回收机","回收机"],"回收且售出，一个蟹笼在淡水中平均每天收益是47金，海水中则是50金。"]]]],["l",0,[[1,["如果你选择了",["l","技能#钓鱼","水手"],"这一职业并且把所有价格低于75金的鱼做成",["l","烹饪","生鱼片"],"，那么淡水中的收益将达到每天75金，海水中的收益将达到每天81金。"]]]]]],["注意",2,[["l",0,[[1,["因为蟹笼在淡水水域捕获的鱼类价值很低，且易于被大量捕获，所以它们是用于制造",["l","高级肥料","高级肥料"],"或",["l","生鱼片","生鱼片"],"的理想原料。在游戏早期阶段，你不妨购买一些蟹笼放置在你的农场池塘中（因为离家近，方便每天收集捕获物），这样你就可以用它们的捕获物来制作高级肥料或生鱼片，并获得一点钓鱼经验。"]],[1,["当你选择了",["l","钓鱼#钓鱼技能","诱饵大师"],"后，很容易在收获蟹笼捕获物后立即不小心捡起蟹笼。自1.5版本，可以轻松避免此情况：光标对准还未收获的蟹笼，然后长按收获键。只要按键未松开，就不会不小心捡起蟹笼。"]],[2,["如果没有选择这个职业，最简单的方法就是手持鱼饵，在收获蟹笼的同时放入鱼饵。装有鱼饵的蟹笼是不能被捡起的。"]],[1,["如果没有",["l","技能#钓鱼","捕猎者"],"这一职业，纯靠钱来购买蟹笼材料需要3,100金。有了这一职业也需要花费1,300金。并且，这只是第一年的价格。第二年时原材料价格上涨，而威利",["l","鱼店","鱼店"],"的购买价格仍固定为1,500金。因此，在第二年后直接购买蟹笼会更划算，即使玩家选择了捕猎者职业。"]],[1,["节日期间的",["l","沙滩","沙滩"],"场景有单独的地图，因此，放置在",["l","沙滩","沙滩"],"上的蟹笼、",["l","宝箱","宝箱"],"等物品会在",["l","夜市","夜市"],"期间消失，并在冬季18日重新回来。"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.0","1.0"],"：加入游戏。"]],[1,[["l","版本历史#1.01","1.01"],"：修复了在放置和移动蟹笼时的漏洞。"]],[1,[["l","版本历史#1.02","1.02"],"：修复了蟹笼相关的漏洞。"]],[1,[["l","版本历史#1.4","1.4"],"：修复了移动蟹笼时的漏洞。"]],[1,[["l","版本历史#1.4.4","1.4.4"],"：修复在",["l","沙漠","沙漠"],"放置蟹笼时出现的漏洞。"]],[1,[["l","版本历史#1.5.2","1.5.2"],"：修复了多人游戏中玩家移除蟹笼时导致的崩溃问题。"]],[1,[["l","版本历史#1.5.3","1.5.3"],"：现在游戏会检测在蟹笼中放置鱼饵的玩家的职业。这修复了多人游戏中",["l","钓鱼#钓鱼技能","水手"],"职业失效的漏洞。"]],[1,[["l","版本历史#1.6","1.6"],"：现在是",["l","鳟鱼大赛","鳟鱼大赛"],"的奖励之一。现在",["l","蛤","蛤"],"视为鱼。增加了在",["l","农场地图#地图类型","海滩农场"],"捕获垃圾的概率。在蟹笼中放入特定鱼饵会有增益效果。《",["l","捕蟹秘籍","捕蟹秘籍"],"》使蟹笼有 25% 的概率双倍产出。"]],[1,[["l","版本历史#1.6.4","1.6.4"],"：蟹笼在收获后有 0.75 秒不能从水中取出，这避免了在收获蟹笼时的误操作。"]]]]]]],"f":[["来源",[["l","打造","打造"]," • ",["l","鱼店","鱼店"]]],["原料",[["i","(O)388","木材×40"],["i","(O)335","铁锭×3"]]],["售价",["50金"]]]}