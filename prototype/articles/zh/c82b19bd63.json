{"s":[[null,1,[["p",["白藻是一种可以通过多种方式获得的物品，可以在任何季节、任何地下水域（",["l","矿井","矿井"]," 20 层与 60 层、",["l","下水道","下水道"],"、",["l","突变虫穴","突变虫穴"],"或",["l","巫婆沼泽","巫婆沼泽"],"）中通过",["l","钓鱼","钓鱼"],"获得。"]],["p",["杀死",["l","蛆","蛆"],"、",["l","突变蛆","突变蛆"],"、",["l","苍蝇","苍蝇"],"、",["l","突变苍蝇","突变苍蝇"],"、",["l","臭虫","臭虫"],"和",["l","史莱姆","史莱姆"],"（仅限红色、紫色、铜和铁四种变种史莱姆）也有概率会掉落白藻。当饲养有",["l","鬼鱼","鬼鱼"],"的",["l","鱼塘","鱼塘"],"在数量到达 9 时，每天有 4.3~4.8% 的几率产出 5 个白藻。"]],["p",["白藻会显示在",["l","收集品#鱼","收集品 - 鱼"],"的页面之中，并计入和钓鱼相关的四个成就之中。然而，白藻在分类上并不属于鱼，且不能在",["l","鱼店","鱼店"],"将其卖给",["l","威利","威利"],"。"]]]],["送礼",2,[["t",[[{"h":1,"v":["讨厌"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]]]]]],["收集包",2,[["p",["野生药材收集包需要 5 个白藻（作为可选项）"]]]],["食谱",2,[["t",[[{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["所需原料"]},{"h":1,"v":["能量 / 生命值"]},{"h":1,"v":["增益效果"]},{"h":1,"v":["增益时长"]},{"h":1,"v":["食谱来源"]},{"h":1,"v":["售出价格"]}],[[["l","清汤","清汤"]],["带有一点黄色的精致清汤。"],[["i","(O)157","白藻×2"]],["能量 125\n生命值 56"],["无"],["无"],[["l","玛妮","玛妮"],"（邮件 - 3+ ❤）"],["150金"]]]]]],["裁制",2,[["p",["白藻可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成可染色的",["l","裁缝","有领衬衫"],"。白藻可用于",["l","染色","染色"],"。放置在",["l","染色#缝纫机","缝纫机"],"内时，白藻可用作白色染料。"]]]],["任务",2,[["l",0,[[1,[["l","鬼鱼","鬼鱼"],"会在",["l","鱼塘#任务","鱼塘扩容任务"],"中要求 5 个白藻，以将鱼塘的容量从 5 增加到 7。"]],[1,["在",["l","大树桩（地点）#任务线","浣熊的请求"],"的第三个任务、第六个以及之后的任务中，浣熊可能会要求玩家提供 5 个白藻。"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.4#1.4","1.4"],"：现在可用于",["l","裁缝","裁缝"],"。现在可用于",["l","鱼塘#鱼塘任务","鱼塘任务"],"。现在可由鱼塘产出。"]],[1,[["l","版本历史/1.5#1.5","1.5"],"：现在是",["l","重新混合的收集包#野生药材收集包","野生药材收集包"],"的一个可选项。"]],[1,[["l","版本历史#1.6","1.6"],"：现在是",["l","大树桩（地点）#任务线","浣熊任务"],"的随机需求物品。"]]]]]]],"f":[["来源",["*",["l","钓鱼","钓鱼"],"\n*",["l","怪物","怪物"],"掉落\n*",["l","鱼塘","鱼塘"],"（",["l","鬼鱼","鬼鱼"],"）"]],["季节",["任意季节"]],["售价",["25金"]]]}