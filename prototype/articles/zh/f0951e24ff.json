{"s":[[null,1,[["p",["烘干机是一种用于制造",["l","工匠物品","工匠物品"],"的",["l","打造#工匠设备","工匠设备"],"，它可以将",["l","水果","水果"],"或除",["l","红蘑菇","红蘑菇"],"外的所有蘑菇烘干并加工成",["l","果干","果干"],"或",["l","蘑菇干","蘑菇干"],"。烘干机的制造配方需要在",["l","皮埃尔的杂货店","皮埃尔的杂货店"],"花费10,000金 购买后解锁。"]],["p",["烘干机也可作为",["l","镇长的庄园#兑奖机","兑奖机"],"的第 12 个奖品（50% 概率）获得。如果玩家选择了",["l","山洞#蘑菇","蘑菇"],"类型的",["l","山洞","农场山洞"],"，那么山洞里会自带一台烘干机。"]]]],["产品",2,[["p",["烘干机加工需要五个名称和品质都相同的蘑菇或",["l","水果","水果"],"，无论何时放入都会在次日早上完成并产出。"]],["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["原料"]},{"h":1,"v":["加工时间"]},{"h":1,"v":["售出价格"]},{"h":1,"v":["食用效果"]}],[[["f","Dried_Mushrooms.png",48]],[["l","蘑菇干","蘑菇干"]],["一包烘干的蘑菇。"],["5个蘑菇（任意，",["l","红蘑菇","红蘑菇"],"除外）"],["1 天（次日早上完成）"],["蘑菇的基础价格 × 7.5 + 25"],["蘑菇的基础恢复效果 × 3"]],[[["f","Dried_Fruit.png",48]],[["l","果干","果干"]],["用水果制成的果干，有嚼劲。"],["5个",["l","水果","水果"],"（任意）"],["1 天（次日早上完成）"],[["l","水果","水果"],"的基础价格 × 7.5 + 25"],[["l","水果","水果"],"的基础恢复效果 × 3"]],[[["f","Raisins.png",48]],[["l","葡萄干","葡萄干"]],["据说是祝尼魔最喜欢的食物。"],["5个",["l","葡萄","葡萄"]],["1 天（次日早上完成）"],["600金"],["能量 125生命值 56"]]]]]],["提示",2,[["l",0,[[1,["烘干后物品的品质星级不会保留。"]],[1,["一些不可食用的",["l","水果","水果"],"在烘干后转变为可食用。回复",["l","能量","能量"],"的计算公式为：基础水果售价 × 1.25. 这与基础银星品质的基准卖价计算方法相同，但是计算结果是四舍五入而不是抹零。"]],[2,[["l","上古水果","上古水果"],"烘干后可回复 688 ",["l","能量","能量"],"和 309 ",["l","生命值","生命值"],"。"]],[2,[["l","椰子","椰子"],"烘干后可回复 125 ",["l","能量","能量"],"和 56 ",["l","生命值","生命值"],"。"]],[2,[["l","大黄","大黄"],"烘干后可回复 275 ",["l","能量","能量"],"和 123 ",["l","生命值","生命值"],"。"]],[1,["由于烘干机需要 5 个水果或者蘑菇，而产品的基础恢复效果只是原来的 3 倍，所以食用水果干和蘑菇干是亏损的。"]],[1,["烘干机可以有效地使金星品质的蘑菇或",["l","水果","水果"],"以每个价格 +5 出售。"]],[1,[["l","宝石甜莓","宝石甜莓"],"不属于",["l","水果","水果"],"，",["l","松露","松露"],"不属于蘑菇，二者都不能放入烘干机。"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.6","1.6"],"：加入游戏。"]]]]]]],"f":[["来源",[["l","打造","打造"]]],["原料",[["i","(O)388","木材×30"],["i","(O)330","粘土×2"],["i","(O)82","火水晶×1"]]]]}