{"s":[[null,1,[["p",["混合种子是一种能种出随机作物的种子，可种植出一定种类的作物（如下表种子清单所列）。会种出的作物种类由种植季节决定。不论在哪个季节收集的混合种子，成长后都为种植季节的作物。除非种在",["l","温室","温室"],"或室内",["l","花盆","花盆"],"里，否则不能在冬季种植混合种子。当在温室或室内",["l","花盆","花盆"],"里种植时，可以长出任何季节的随机作物。无论季节如何，在",["l","姜岛","姜岛"],"种植的混合种子总是会变为特定种类种子。"]]]],["获取来源",2,[["l",0,[[1,["使用",["l","镰刀","镰刀"],"、",["l","斧头","斧头"],"、",["l","十字镐","十字镐"],"、",["l","锄头","锄头"],"、",["l","武器","剑"],"或",["l","打造","炸弹"],"破坏",["l","杂草","杂草"],"时如果没有",["l","纤维","纤维"],"掉落，那么有5%的概率掉落混合种子（阅读",["l","浣熊日记","浣熊日记"],"后概率提升至9%）。"]],[1,["用",["l","锄头","锄头"],"挖掘泥土或沙子。"]],[1,[["l","钓鱼","钓鱼宝箱"],"。"]],[1,["于星期四在",["l","科罗布斯","科罗布斯"],"的商店以30金的价格购买。"]],[1,[["l","星露谷展览会","星露谷展览会"],"的商店有20%概率以1,000奖券星星币出售24个混合种子。"]],[1,["击杀",["l","农场地图","荒野农场"],"上的",["l","荒野石魔","荒野石魔"],"和",["l","铱石魔","铱石魔"],"有50%概率掉落1个混合种子，达到",["l","战斗","战斗等级"]," 5 后有20%概率掉落第2个。"]],[1,["饲养",["l","小龙虾","小龙虾"],"、",["l","玉黍螺","玉黍螺"],"或",["l","蜗牛","蜗牛"],"的",["l","鱼塘","鱼塘"],"在鱼的数量达到5条后，可能会产出2-3个混合种子。"]],[1,["把任何作物放入",["l","种子生产器","种子生产器"],"，都有1.99%的概率获得1-4个混合种子而非原作物种子。"]],[1,[["l","农场地图","海滩农场"],"的",["l","补给箱","补给箱"],"中偶尔能找到3-5个混合种子。"]],[1,["打开",["l","谜之盒","谜之盒"],"有概率获得10个种子。"]],[1,[["l","沙漠节","沙漠节"],"期间在",["l","艾芙琳","艾芙琳"],"的商铺、",["l","乔迪","乔迪"],"的商铺以及",["l","沙漠节","卡利科三花蛋商人"],"处有售。"]],[1,["完成大树桩浣熊第四个任务后，可以在",["l","大树桩（地点）","浣熊妻子的商店"],"用1个山洞萝卜兑换。"]],[1,[["l","镇长的庄园","兑奖机"],"的第3个奖品有50%概率为10个混合种子。"]]]]]],["种子清单",2,[["p",["种植时，混合种子会变为下列种子中的一种。注意，混合种子可以在第1年变为",["l","洋蓟种子","洋蓟种子"],"，尽管洋蓟种子直到第2年才可在",["l","皮埃尔的杂货店","杂货店"],"购买。春季时种在",["l","农场","农场"],"里的混合种子，其变为防风草种子的可能性是变为花椰菜种子和土豆种子的两倍。"]],["t",[[{"h":1,"v":["季节"]},{"h":1,"v":["种子"]}],[{"h":1,"v":["春季"]},[["i","(O)474","花椰菜种子"]," • ",["i","(O)472","防风草种子"]," • ",["i","(O)475","土豆种子"]]],[{"h":1,"v":["夏季"]},[["i","(O)487","玉米种子"]," • ",["i","(O)482","辣椒种子"]," • ",["i","(O)484","萝卜种子"]," • ",["i","(O)483","小麦种子"]]],[{"h":1,"v":["秋季"]},[["i","(O)489","洋蓟种子"]," • ",["i","(O)487","玉米种子"]," • ",["i","(O)488","茄子种子"]," • ",["i","(O)490","南瓜种子"]]],[{"h":1,"v":["冬季"]},["以上任何一种（只可种在",["l","温室","温室"],"里或室内",["l","花盆","花盆"],"）。"]],[{"h":1,"v":["姜岛"]},[["i","(O)481","蓝莓种子"]," • ",["i","(O)479","甜瓜种子"]," • ",["i","(O)833","菠萝种子"]," • ",["i","(O)478","大黄种子"]]]]]]],["送礼",2,[["t",[[{"h":1,"v":["不喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]]]]]],["配方",2,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["材料"]},{"h":1,"v":["配方来源"]}],[[["f","Fiber_Seeds.png",48]],[["l","纤维种子","纤维种子"]],["所有季节都可以种植。不需要浇水。用镰刀收割。7 天长成。"],[["i","(O)770","混合种子×1"],["i","(O)92","树液×5"],["i","(O)330","粘土×1"]],[["l","莱纳斯","莱纳斯"],"（",["l","任务","特别任务"],"）"]]]]]],["任务",2,[["p",["一些鱼的",["l","鱼塘","鱼塘任务"],"可能会需要3个或5个混合种子。"]]]],["交易",2,[["p",["完成大树桩浣熊的",["l","大树桩（地点）","第三个任务"],"后，可以在",["l","大树桩（地点）","浣熊妻子的商店"],"处使用10个混合种子兑换1顶",["l","浣熊帽","浣熊帽"],"。"]]]]]}