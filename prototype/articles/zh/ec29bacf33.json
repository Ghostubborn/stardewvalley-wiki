{"s":[[null,1,[["p",["鸵鸟蛋是一种动物制品，可由",["l","鸵鸟","鸵鸟"],"产出。鸵鸟需要饲养在",["l","畜棚","畜棚"],"中，鸵鸟蛋会在当",["l","畜棚","畜棚"],"内有足够的空间时生成在畜棚的地板上，玩家拾取后可获得 5 点耕种经验值。玩家也可以在畜棚内放置",["l","自动采集器","自动采集器"],"以收集鸵鸟蛋，但这样不会获得任何经验值。"]],["p",["在找到",["l","日记残页#日记残页 #10","日记残页 #10"]," 后，用",["l","锄头","锄头"],"挖掘标记位置可以获得一个鸵鸟蛋。除此之外，鸵鸟蛋还可以通过打开",["l","火山地牢","火山地牢"],"内的宝箱",["l","火山地牢#宝箱","稀有宝箱"],"获得，概率为 1/9。"]],["p",["鸵鸟蛋可以放入",["l","鸵鸟孵化器","鸵鸟孵化器"],"中孵化出鸵鸟。孵化需要9000 分钟（5 天 16 小时 40 分钟），如果玩家选择了",["l","耕种#耕种技能","鸡舍大师"],"职业，则孵化时间减半。"]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","雷欧","雷欧"]]],[{"h":1,"v":["喜欢"]},[["l","亚历克斯","亚历克斯"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","莉亚","莉亚"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","山姆","山姆"],"、",["l","谢恩","谢恩"]]],[{"h":1,"v":["一般"]},[["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","哈维","哈维"],"、",["l","科罗布斯","科罗布斯"],"、",["l","刘易斯","刘易斯"],"、",["l","玛鲁","玛鲁"],"、",["l","潘妮","潘妮"],"、",["l","罗宾","罗宾"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"]]],[{"h":1,"v":["不喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","矮人","矮人"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","潘姆","潘姆"],"、",["l","文森特","文森特"],"、",["l","法师","法师"]]],[{"h":1,"v":["讨厌"]},[["l","塞巴斯蒂安","塞巴斯蒂安"]]]]]]],["工匠物品",2,[["n",["另见：",["l","加工动物制品的收益","加工动物制品的收益"]]],["p",["鸵鸟蛋可用于制作",["l","蛋黄酱","蛋黄酱"],"。制成的蛋黄酱的品质等同于鸵鸟蛋的品质。将任意品质的鸵鸟蛋放入蛋黄酱机中加工，都会得到 10 份与鸵鸟蛋品质相同的蛋黄酱。"]],["p",["使用鸵鸟蛋加工蛋黄酱是唯一获得铱星品质蛋黄酱的方法。"]]]],["裁制",2,[["p",["鸵鸟蛋可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["i","(H)93","战士头盔"],"。鸵鸟蛋可用于",["l","染色","染色"],"。放置在",["l","染色#缝纫机","缝纫机"],"内时，鸵鸟蛋可用作白色染料。"]]]],["任务",2,[["p",[["l","格斯","格斯"],"的",["l","任务#Gus' Famous Omelet","特别任务：格斯的著名煎蛋卷"],"将会需要玩家在任务期间收集并提交24个蛋（任何蛋都适用）。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史/1.5#1.5","1.5"],"：加入游戏。"]]]]]]],"f":[["来源",[["l","鸵鸟","鸵鸟"]," • ",["l","日记残页#日记残页 #10","日记残页 #10"]," • ",["l","火山地牢#稀有宝箱","火山地牢宝箱"]]],["产出",["10"]],["售