{"s":[[null,1,[["p",["地晶是一种",["l","矿物","矿物"],"。地晶可以在",["l","矿井","矿井"],"中（尤其是1~39层）经",["l","采集","采集"],"获得。敲开",["l","晶球","晶球"],"或",["l","万象晶球","万象晶球"],"，可能会得到地晶。地晶可能会出现在杀死 ",["l","掘地虫","掘地虫"],"（",["l","矿井","矿井"],"的1~29层）、",["l","幽灵头骨","幽灵头骨"],"后获得的掉落物中。",["l","淘盘","淘金"],"和",["l","钓鱼#宝箱","钓鱼宝箱"],"也有可能获得地晶。在任何季节的任何时间，翻动",["l","垃圾桶","垃圾桶"],"也有概率找到地晶。"]],["p",[["l","农场地图#Wilderness","荒野农场"],"的",["l","荒野石魔","荒野石魔"],"在被杀死后有0.05%的几率掉落地晶。"]],["p",["放置在地上的地晶可以被",["l","打造#炸弹","炸弹"],"炸成掉落的可拾取物品。"]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]],[{"h":1,"v":["不喜欢"]},[["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"]]]]]]],["收集包",2,[["p",["地晶用于地理学家的收集包。"]]]],["配方",2,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["原料"]},{"h":1,"v":["配方来源"]}],[[["f","Mayonnaise_Machine.png",48]],[["l","蛋黄酱机","蛋黄酱机"]],["将鸡蛋转换为蛋黄酱。"],[["i","(O)388","木材×15"],["i","(O)390","石头×15"],["i","(O)86","地晶×1"],["i","(O)334","铜锭×1"]],[["f","Farming_Skill_Icon.png",24]," ",["l","耕种","耕种"]," 2 级"]]]]]],["建筑",2,[["p",["向",["l","法师","法师"],"购买",["l","土之图腾柱","土之图腾柱"],"时，需要玩家给法师提供一些地晶。"]],["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["费用"]},{"h":1,"v":["尺寸"]}],[[["f","Earth_Obelisk.png",48]],[["l","土之图腾柱","土之图腾柱"]],["将你传送到山岭。"],["500,000金",["i","(O)337","铱锭×10"],["i","(O)86","地晶×10"]],["3x2\n",["f","Marker3x2.pn