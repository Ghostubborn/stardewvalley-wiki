{"s":[[null,1,[["p",["橡树树脂是一种",["l","树","树"],"汁液，可以通过",["l","树液采集器","树液采集器"],"采集",["l","橡树","橡树"],"获得，耗时7天。通过",["l","重型树液采集器","重型树液采集器"],"采集时耗时3天。击杀",["l","幽灵头骨","幽灵头骨"],"有1.30%的概率掉落橡树树脂；将",["l","硬木","硬木"],"放入",["l","碎木机","碎木机"],"分解时，也有小概率产生橡树树脂。"]],["p",["采集橡树树脂需要的",["l","橡树","橡树"],"，可以是玩家种植的，也可以是星露谷中自然生长的（比如",["l","煤矿森林","煤矿森林"],"）。"]],["p",["尽管橡树树脂在游戏中的标签是“工匠物品”，但它不受耕种的",["l","技能","工匠"],"技能加成，反而受采集的",["l","技能","萃取者"],"技能加成（+25%售价）。"]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","玛鲁","玛鲁"]]],[{"h":1,"v":["不喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]]]]]],["收集包",2,[["p",["橡树树脂被用于魔法师收集包，同时也是异国情调采集收集包的可选项之一。"]]]],["裁制",2,[["p",["橡树树脂可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["i","(H)54","宽松毛线帽"],"。橡树树脂还可用作",["l","染色","染料罐"],"和",["l","染色","缝纫机"],"的绿色染料。"]]]],["配方",2,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["材料"]},{"h":1,"v":["配方来源"]}],[[["f","Deluxe_Speed-Gro.png",48]],[["l","高级生长激素","高级生长激素"],"（5）"],["促进叶子生长。保证能让植物的生长速度加快 25%。使用时加到犁过的土地中。"],[["i","(O)725","橡树树脂×1"],["i","(O)881","骨头碎片×5"]],[["f","Farming_Skill_Icon.png",24]," ",["l","耕种","耕种"]," 8 级"]],[[["f","Keg.png",48]],[["l","小桶","小桶"]],["置放水果或蔬菜在内。最终会变成饮品。"],[["i","(O)388","木材×30"],["i","(O)334","铜锭×1"],["i","(O)335","铁锭×1"],["i","(O)725","橡树树脂×1"]],[["f","Farming_Skill_Icon.png",24]," ",["l","耕种","耕种"]," 8 级"]]]]]]