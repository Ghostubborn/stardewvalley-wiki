{"s":[[null,1,[["p",["钓鱼帽是一种",["l","帽子","帽子"],"。玩家可以在",["l","缝纫机","缝纫机"],"上使用",["l","布料","布料"],"和",["l","石鱼","石鱼"],"、",["l","冰柱鱼","冰柱鱼"],"、",["l","蝎鲤鱼","蝎鲤鱼"],"、",["l","幽灵鱼","幽灵鱼"],"、",["l","午夜鱿鱼","午夜鱿鱼"],"、",["l","虚空鲑鱼","虚空鲑鱼"],"或",["l","史莱姆鱼","史莱姆鱼"],"缝制该顶帽子。"]],["p",["这顶帽子还有小概率通过以下方式获得：击杀",["l","怪物","怪物"],"；",["l","矿井","打破木箱和木桶"],"；砍",["l","树","树"],"；摇晃树木；挖掘",["l","远古斑点","远古斑点"],"；",["l","淘盘","淘金"],"。"]]]]]}