{"s":[[null,1,[["p",["纤维种子是一种通过",["l","打造","打造"],"得到的种子。种下后无需浇水、甚至在",["l","冬季","冬季"],"也可以生长，但必须种在可耕种的土壤上。如果不在",["l","稻草人","稻草人"],"的保护范围中，它们也可能会被乌鸦吃掉。"]],["p",["制造配方在完成了特别任务告示板上的",["l","任务","特别任务：社区清理"],"后，由",["l","莱纳斯","莱纳斯"],"附信赠予。"]],["p",["在完全长成后用",["l","镰刀","镰刀"],"收获可以掉落大约4到7个",["l","纤维","纤维"],"，还有10%的概率掉落一个",["l","混合种子","混合种子"],"。"]]]],["生长阶段",2,[["t",[[{"h":1,"v":["季节"]},{"h":1,"v":["第一阶段"]},{"h":1,"v":["第二阶段"]},{"h":1,"v":["第三阶段"]},{"h":1,"v":["第四阶段"]},{"h":1,"v":["可收获"]}],[{"h":1,"v":["春季\n夏季"]},[],[],[],[],[]],[{"h":1,"v":["秋季"]},[],[],[],[],[]],[{"h":1,"v":["冬季"]},[],[],[],[],[]],[["天数："],["一天"],["两天"],["两天"],["两天"],["共计：七天"]]]]]],["Tips",2,[["l",0,[[1,["可以通过在每个季节（特别是",["l","秋季","秋季"],"）最后一天种植纤维种子以避免",["l","季节","换季"],"造成的",["l","肥料","肥料"],"流失。"]],[1,["虽然",["l","纤维","纤维"],"并非一种农作物，在",["l","祝尼魔屋","祝尼魔屋"],"范围内的",["l","祝尼魔","祝尼魔"],"也会收集成熟的纤维。"]]]]]]]}