{"s":[[null,1,[["p",["硬木围栏是一种",["l","打造#围栏","打造物品"],"，可以让玩家在",["l","农场","农场"],"中隔开某些区域。硬木围栏是游戏中最坚固的围栏，可以维持完好状态 502~505 天，玩家的配偶有时会修理损坏的围栏。"]],["p",["与其它",["l","打造#围栏","围栏"],"一样，硬木围栏在放置的当天可以被工具破坏并掉落自身，经过了游戏内一天后（可以认为围栏寿命发生了损耗）再使用工具破坏则不再掉落任何物品。若在农场中建造了",["l","黄金时钟","黄金时钟"],"且处于开启状态，则围栏将不再损耗，任何时候使用工具破坏时都可以掉落其自身。"]],["p",["在解锁",["l","赌场","赌场"],"后，可以在赌场中使用100齐币 购买 1 个硬木围栏（每天限购 20 个）。"]]]],["送礼",2,[["t",[[{"h":1,"v":["不喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","矮人","矮人"],"、",["l","艾利欧特","艾利欧特"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","海莉","海莉"],"、",["l","哈维","哈维"],"、",["l","贾斯","贾斯"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","科罗布斯","科罗布斯"],"、",["l","莉亚","莉亚"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","莱纳斯","莱纳斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","潘姆","潘姆"],"、",["l","潘妮","潘妮"],"、",["l","皮埃尔","皮埃尔"],"、",["l","罗宾","罗宾"],"、",["l","山姆","山姆"],"、",["l","桑迪","桑迪"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","谢恩","谢恩"],"、",["l","文森特","文森特"],"、",["l","威利","威利"],"、",["l","法师","法师"]]]]]]]],"f":[["来源",[["l","打造","打造"]," • ",["l","赌场","赌场"]]],["原料",[["i","(O)709","硬木×1"]]],["售价",["10金"]]]}