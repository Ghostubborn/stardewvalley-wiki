{"s":[[null,1,[["p",["南瓜灯是一种可",["l","打造","打造"],"的光源装饰物，玩家还可以在",["l","万灵节","万灵节"],"期间",["l","皮埃尔","皮埃尔"],"的摊位处以750金的价格直接购买南瓜灯。万灵节的摊位还会以2,000金的价格出售南瓜灯的制作配方，每位玩家只能购买一次配方，之后即可用",["l","南瓜","南瓜"],"和",["l","火把","火把"],"进行制作。"]],["p",["南瓜灯可以直接拿在手上，或放置在室内外及",["l","矿井","矿井"],"以提供大约半径1格的微光。放置后，可以通过使用",["l","锄头","锄头"],"、",["l","十字镐","十字镐"],"或者",["l","斧头","斧头"],"移除。与可开关的火炬不同，南瓜灯始终处于点亮状态。它是所有可打造的光源中亮度最低的。"]],["p",["每年",["l","秋季","秋季"],"17日（即",["l","星露谷展览会","星露谷展览会"],"后），以下地点的门前会出现南瓜灯：",["l","柳巷1号","柳巷1号"],"（乔迪、肯特、山姆和文森特的家）、",["l","柳巷2号","柳巷2号"],"（海莉和艾米丽的家）、",["l","河间大道1号","河间大道1号"],"（艾芙琳、乔治和亚历克斯的家）、",["l","木匠的商店","木匠的商店"],"（罗宾、德米特里厄斯、玛鲁和塞巴斯蒂安的家）以及",["l","拖车","拖车"],"（潘姆和潘妮的家）。"]],["p",["进入",["l","冬季","冬季"],"后，被放置的南瓜灯将会变成",["l","腐烂的植物","腐烂的植物"],"，将其回收至",["l","宝箱","宝箱"],"或玩家的",["l","物品栏","物品栏"],"中可以避免这一现象。"]]]],["送礼",2,[["t",[[{"h":1,"v":["不喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","雷欧","雷欧"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"]]]]]]],["收集包",2,[["p",["南瓜灯可用于 幽灵之夜收集包。"]]]],["裁制",2,[["p",["南瓜灯可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["i","(H)48","南瓜面具"],"。南瓜灯还可用作",["l","染色","染料罐"],"和",["l","染色","缝纫机"],"的橙色染料。"]]]],["任务",2,[["p",["南瓜灯不用于任何",["l","任务","任务"],"。"]]]],["备注",2,[["p",["由于南瓜灯发出的光要弱于",["l","火把","火把"],"，它作为装饰要比作为灯具更合适。"]]]]],"f":[["来源",[["l","打造","打造"]," 或 ",["l","万灵节","万灵节"]]],["原料",[["i","(O)276","南瓜×1"],["i","(O)93","火把×1"]]],["售价",["0金"]]]