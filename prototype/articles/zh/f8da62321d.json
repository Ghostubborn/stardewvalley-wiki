{"s":[[null,1,[["p",["粘土是一种可以通过挖掘土壤、沙子、",["l","远古斑点","远古斑点"],"，在",["l","姜岛","姜岛挖掘场"],"挖掘",["l","采矿","粘土矿"],"，或者敲开",["l","矿物","晶球"],"来找到的资源。它也可以作为",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"或",["l","雷欧","雷欧"],"的礼物在",["l","冬日星盛宴","冬日星盛宴"],"时收到。",["l","沙漠节","沙漠节"],"期间，",["l","文森特","文森特"],"会在其",["l","沙漠节","商铺"],"以1卡利科蛋个",["l","卡利科三花蛋","卡利科三花蛋"],"的价格出售粘土（限20个）。",["l","动物","宠物"],"狗达到最大",["l","动物","好感度"],"后，每天第一次被抚摸也有可能掉落2个粘土。"]],["p",["粘土可以作为装饰品放入",["l","鱼缸","鱼缸"],"中，若如此做，粘土会变成一座“城堡”。"]]]],["配方",2,[["t",[[{"h":1,"v":["图标"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["材料"]},{"h":1,"v":["配方来源"]}],[[["f","Quality_Retaining_Soil.png",48]],[["l","高级保湿土壤","高级保湿土壤"],"（2）"],["大概率让土壤在经过一晚后保持湿润，使用在锄过的土地。"],[["i","(O)390","石头×3"],["i","(O)330","粘土×1"]],[["f","Farming_Skill_Icon.png",24]," ",["l","耕种","耕种"],"等级7"]],[[["f","Garden_Pot.png",48]],[["l","花盆","花盆"]],["在室内时，可种植任何季节的作物。在户外时，只能容纳季节性作物。"],[["i","(O)330","粘土×1"],["i","(O)390","石头×10"],["i","(O)338","精炼石英×1"]],["完成",["l","温室","温室"],"后",["f","Evelyn_Icon.png",24],["l","艾芙琳","艾芙琳"],"过场动画"]],[[["f","Brick_Floor.png",48]],[["l","红砖地板","红砖地板"]," (5)"],["放在地上修建小路，也可以装饰地板。"],[["i","(O)330","粘土×2"],["i","(O)390","石头×5"]],[["f","Robin_Icon.png",24]," ",["l","木匠的商店","木匠的商店"]," (500金)"]],[[["f","Fiber_Seeds.png",48]],[["l","纤维种子","纤维种子"]," (4)"],["所有季节都可以种植。不需要浇水。用镰刀收割。7 天长成。"],[["i","(O)330","粘土×1"],["i","(O)770","混合种子×1"],["i","(O)92","树液×5"]],[["f","Linus_Icon.png",24]," ",["l","莱纳斯","莱纳斯"]," (",["l","任务","鹈鹕镇的特别任务"],")"]],[[["f","Deluxe_Retaining_Soil.png",48]],[["l","顶级保湿土壤","顶级保湿土壤"]],["这种土壤能够隔夜依然百分百保持湿润。使用时加到犁过的土地中。"],[["i","(O)330","粘土×1"],["i","(O)390","石头×5"],["i","(O)771","纤维×3"]],[["f","Island_Trader_Icon.png",24]," ",["l","姜岛商人","姜岛商人"],"，消耗 ",["i","(O)848","火山晶石×50"]]],[[["f","Bone_Mill.png",48]],[["l","碎骨机","碎骨机"]],["可以把骨头制成肥料。"],[["i","(O)330","粘土×3"],["i","(O)881","骨头碎片×10"],["i","(O)390","石头×20"]],[["f","Gunther_Icon.png",24]," ",["l","冈瑟","冈瑟"]," (",["l","任务","鹈鹕镇的特别任务"],")"]],[[["f","Dehydrator.png",48]],[["l","烘干机","烘干机"]],["放入 5 个水果或可食用的蘑菇即可烘干。"],[["i","(O)388","木材×30"],["i","(O)330","粘土×2"],["i","(O)82","火水晶×1"]],[["f","Pierre_Icon.png",24]," ",["l","皮埃尔的杂货店","皮埃尔的杂货店"]," (10,000金)"]]]]]],["建筑",2,[["t",[[{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["成本"]},{"h":1,"v":["尺寸"]}],[[["l","筒仓","筒仓"]],["让你把割下来的草料储存起来。"],["100金",["i","(O)390","石头×100"],["i","(O)330","粘土×10"],["i","(O)334","铜锭×5"]],["3x3\n",["f","Marker3x3.png",48]]]]]]],["送礼",2,[["t",[[{"h":1,"v":["不喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","亚历克斯","亚历克斯"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]],[{"h":1,"v":["讨厌"]},[["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","玛妮","玛妮"]]]]]]],["收集包",2,[["p",["粘土不用于任何",["l","收集包","收集包"],"。"]]]],["裁制",2,[["p",["粘土可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","上衣"],"。粘土可用于",["l","染色","染色"],"。放置在",["l","染色","染料罐"],"内时，粘土可用作橙色染料。放置在",["l","染色","缝纫机"],"内时，粘土还可用作棕色染料。"]]]],["任务",2,[["p",["在",["l","鱼塘","鱼塘任务"],"中，一些鱼可能会要求2、3或5个粘土。"]]]],["提示",2,[["l",0,[[1,["可以考虑在",["l","矿井","矿井"],"中挖取粘土，因为这会产生额外的",["l","山洞萝卜","山洞萝卜"],"。",["l","炸弹","炸弹"],"或其他爆炸物可用以更快地挖掘。"]]]]]]],"f":[["来源",[["l","远古斑点","远古斑点"]," • ",["l","矿物","晶球"]," • ",["l","采矿","粘土矿"]]],["售价",["20金"]]]}