{"s":[[null,1,[["p",["啤酒是一种",["l","工匠物品","工匠物品"],"，可以用",["l","小麦","小麦"],"作为原料在",["l","小桶","小桶"],"中制作而成，加工时间为1-2天；也可以在",["l","星之果实酒吧","星之果实酒吧"],"花费400金，或者在",["l","姜岛","姜岛海滩度假村"],"花费500金购买。玩家可能在",["l","冬日星盛宴","冬日星盛宴"],"中收到啤酒作为礼物。",["l","沙漠节","沙漠节"],"期间，",["l","潘姆","潘姆"],"会在其",["l","沙漠节","商铺"],"以20卡利科蛋 ",["l","卡利科三花蛋","卡利科三花蛋"],"的价格出售啤酒。"]],["p",["玩家饮用啤酒后会出现",["l","效果","眩晕"],"，效果是",["l","速度","速度"],"-1。"]]]],["陈酿价值",2,[["p",["啤酒可以放置在",["l","木桶","木桶"],"中进行陈酿，从普通品质升到银星、金星，最终到达铱星品质。铱星品质啤酒的基础售价是普通啤酒的2倍。"]],["p",["通常情况下，可以随时用",["l","斧头","斧头"],"、",["l","锄头","锄头"],"或",["l","十字镐","十字镐"],"收取木桶，以从木桶中提早取出普通、银星或金星啤酒。"]],["t",[[{"h":1,"v":["基础品质"]},{"h":1,"v":["银星 (x 1.25)"]},{"h":1,"v":["金星 (x 1.5)"]},{"h":1,"v":["铱星 (x 2)"]}],[["200金"],["200金 陈酿：7天"],["200金 陈酿：7天\n总计：14 天"],["200金 陈酿：14天\n总计：28 天"]]]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","潘姆","潘姆"],"、",["l","谢恩","谢恩"]]],[{"h":1,"v":["喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"]]],[{"h":1,"v":["讨厌"]},[["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","潘妮","潘妮"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","雷欧","雷欧"]]]]]]],["收集包",2,[["p",["没有收集包需要这件物品。"]]]],["裁制",2,[["p",["啤酒可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","黑皮夹克"],"。啤酒还可用作",["l","染色","染料罐"],"和",["l","染色","缝纫机"],"的黄色染料。"]]]],["任务",2,[["p",["没有出现在任何任务中。"]]]]],"f":[["来源",[["l","工匠物品","工匠物品"]," • ",["l","星之果实酒吧","星之果实酒吧"]]],["加工设备",[["i","(BC)12","小桶"]]],["原料",[["i","(O)262","小麦×1"]]],["加工时间",["1750m (≈29h)"]],["售价",["200金"]]]}