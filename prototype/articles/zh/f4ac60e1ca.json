{"s":[[null,1,[["p",["蜜蜂酒是一种将",["l","蜂蜜","蜂蜜"],"放入",["l","小桶","小桶"],"制造的",["l","工匠物品","工匠物品"],"，酿造需要10个小时。蜜蜂酒的基础售价为300金，只有",["l","木桶","陈酿"],"或者",["l","耕种","工匠"],"能够提升它。"]],["p",["区别于",["l","果酒","果酒"],"和",["l","果汁","果汁"],"，使用任何种类的",["l","蜂蜜","蜂蜜"],"对蜜蜂酒的价值没有任何影响。",["l","虞美人花","虞美人"],["l","蜂蜜","蜂蜜"],"和",["l","玫瑰仙子","玫瑰仙子"],["l","蜂蜜","蜂蜜"],"的售价比蜜蜂酒的售价贵，这两种",["l","蜂蜜","蜂蜜"],"更适合直接出售获利而不是用来酿造蜜蜂酒。"]],["p",["蜜蜂酒在",["l","姜岛","姜岛"],"的",["l","姜岛","海滩度假村"],"中有售，价格为800金。",["l","沙漠节","沙漠节"],"期间，",["l","潘姆","潘姆"],"会在其",["l","沙漠节","商铺"],"以20卡利科蛋 ",["l","卡利科三花蛋","卡利科三花蛋"],"的价格出售蜜蜂酒。海盗活动期间（偶数天且非下雨天气的晚上8点后）进入",["l","姜岛","姜岛"],["l","姜岛","海盗湾"],"，在戴着",["l","海盗帽","海盗帽"],"、",["l","眼罩","眼罩"],"、",["l","豪华海盗帽","豪华海盗帽"],"或",["l","鹦鹉蛋","鹦鹉蛋"],"饰品的情况下与海盗湾里的海盗调酒师对话，他会送你一瓶蜜蜂酒，每晚只能触发一次。"]],["p",["饮用蜜蜂酒后会获得一个",["l","效果","眩晕"],"的增益效果，",["l","速度","速度"],"-1。"]]]],["提示",2,[["l",0,[[1,["周五从桑迪处花200金购买",["l","蜂蜜","蜂蜜"],"进行加工会获得很高的收益。由于蜜蜂酒的加工速度远快于种植作物酿成",["l","果酒","果酒"],"，使用蜜蜂酒获利的速度和日收益上限是很高的。"]]]]]],["陈酿价值",2,[["p",["蜜蜂酒能被放在",["l","木桶","木桶"],"中进行陈酿，从普通品质升到银星、金星、最终铱星品质。铱星品质的价格是普通蜜蜂酒的2倍。"]],["p",["通常情况下，可以随时通过用",["l","斧头","斧头"],"，",["l","锄头","锄头"],"或",["l","十字镐","十字镐"],"取下木桶和木桶内的酒。"]],["t",[[{"h":1,"v":["普通品质"]},{"h":1,"v":["银星品质（x 1.25）"]},{"h":1,"v":["金星品质（x 1.5）"]},{"h":1,"v":["铱星品质（x 2）"]}],[["300金"],["300金 陈酿：7天"],["300金 陈酿：7天\n共计：14天"],["300金 陈酿：14天\n共计：28天"]]]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","潘姆","潘姆"],"、",["l","威利","威利"]]],[{"h":1,"v":["喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","科罗布斯","科罗布斯"],"、",["l","谢恩","谢恩"]]],[{"h":1,"v":["讨厌"]},[["l","贾斯","贾斯"],"、",["l","潘妮","潘妮"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","文森特","文森特"],"、",["l","雷欧","雷欧"]]]]]]],["收集包",2,[["p",["蜜蜂酒是酿酒师收集包的可选物品之一。"]]]],["裁制",2,[["p",["蜜蜂酒可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","黑皮夹克"],"。蜜蜂酒可用于",["l","染色","染色"],"。放置在",["l","染色","染料罐"],"内时，蜜蜂酒可用作黄色染料。放置在",["l","染色","缝纫机"],"内时，蜜蜂酒还可用作金色染料。"]]]],["食谱",2,[["p",["不用于任何食谱。"]]]],["任务",2,[["p",["不用于任何任务。"]]]],["备注",2,[["p",["“蜜蜂酒”其实是翻译错误，正确的译名应为“蜂蜜酒”。"]]]]],"f":[["来源",[["l","工匠物品","工匠物品"]]],["加工设备",[["i","(BC)12","小桶"]]],["原料",[["l","蜂蜜","蜂蜜×1"]]],["加工时间",["10小时"]],["售价",["300金"]]]}