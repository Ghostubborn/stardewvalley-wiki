{"s":[[null,1,[["p",["星之果茶是一种物品，可以从",["l","镇长的庄园","镇长的庄园"],"里的",["l","镇长的庄园#兑奖机","兑奖机"],"中获得，也可以从",["l","钓鱼#金色钓鱼宝箱","金色钓鱼宝箱"],"（概率为 7%）中获得。完成",["l","大树桩（地点）#任务线","浣熊"],"的第六个以及之后的任务也有机会获得。完成热心居民收集包会奖励 1 杯星之果茶。"]],["p",["星之果茶可以作为",["l","友谊#礼物","礼物"],"送给",["l","居民","居民"],"，能够增加250点",["l","友谊","好感度"],"（1颗心）。如果作为生日礼物或在",["l","冬日星盛宴","冬日星盛宴"],"期间赠送，可以获得750点好感度（3颗心）。星之果茶不计入每日或每周的礼物数量限制，即使送礼次数已经达到上限，玩家也可以赠送星之果茶。玩家可在一天内多次向同一村民赠送星之果茶。"]],["p",["赠送星之果茶不计入",["l","任务#Qi's Kindness","齐先生的善意"],"任务的总数。"]],["p",["星之果茶在送礼时，村民会有特殊对话。"]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"],"、",["l","海莉","海莉"]]]]]]],["收集包",2,[["p",["星之果茶不用于任何",["l","收集包","收集包"],"。"]]]],["裁制",2,[["p",["星之果茶不可用于",["l","裁缝","裁缝"],"。星之果茶可用于",["l","染色","染色"],"。放置在",["l","染色#染料罐","染料罐"],"内时，星之果茶可用作紫色染料。放置在",["l","染色#缝纫机","缝纫机"],"内时，星之果茶还可用作亮紫色染料。"]]]],["任务",2,[["p",["星之果茶不用于任何",["l","任务","任务"],"。"]]]],["提示",2,[["l",0,[[1,["在村民生日那天，将星之果茶与另一件物品一起赠送，两者都可以获得生日礼物的好感度加成。"]],[2,["由于在一天内可以将多个星之果茶赠送给村民，玩家可以在村民生日当天将2-4个星之果茶送给他们。这样可以迅速提升村民与玩家的好感度。"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.6","1.6"],"：加入游戏。"]]]]]]],"f":[["来源",[["l","镇长的庄园#兑奖机","兑奖机"]," • ",["l","钓鱼#金色钓鱼宝箱","金色钓鱼宝箱"]," • ",["l","大树桩（地点）","浣熊"]]],["售价",["77金"]]]}