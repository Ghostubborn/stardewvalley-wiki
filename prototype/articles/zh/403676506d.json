{"s":[[null,1,[["p",["茶树是一种灌木。种下",["l","茶苗","茶苗"],"20天后成熟，之后在",["l","春季","春季"],"、",["l","夏季","夏季"],"、",["l","秋季","秋季"],"（室内种植则包括",["l","冬季","冬季"],"）的最后一周里每天产出一个",["l","茶叶","茶叶"],"。",["l","卡洛琳","卡洛琳"],"的阳光房内也生长着一棵茶树，并且每个月的最后一周也可以在上面收获茶叶。"]],["p",["与果树相同，未成熟的茶树不需要浇水也会一直生长（即使种在冬季或室外）。茶树上不能使用",["l","树肥","树肥"],"。"]],["p",["砍倒一棵成熟的茶树将返还一个",["l","茶苗","茶苗"],"。"]]]],["生长阶段",2,[["p",["一旦茶树种下，玩家和动物都不能穿过茶树，不论其处于哪个阶段。成熟的茶树可以使用",["l","斧头","金或铱斧头"],"砍两次可以砍倒，但它不会受到其他工具的影响。砍倒后不会掉落木头。"]],["t",[[{"h":1,"v":["阶段1"]},{"h":1,"v":["阶段2"]},{"h":1,"v":["阶段3"]},{"c":2,"h":1,"v":["收成"]}],[[["f","Tea_Stage_1.png",45]],[["f","Tea_Stage_2.png",45]],[["f","Tea_Stage_3.png",45]],[["f","Tea_Stage_4.png",45]],[["f","Tea_Stage_3.png",45]]],[["10天"],["10天"],["至当月21日"],["共：20天"],["每天持续产出茶叶"]]]]]],["提示",2,[["p",["茶树可以种植在动物棚附近来圈养动物。"]],["p",["茶苗雖然不能直接種植在農場外面，不過可以種植在農場外的",["l","花盆","花盆"],"中。"]],["p",["将茶苗种植在撒有肥料的花盆里并不能影响",["l","茶叶","茶叶"],"的品质。"]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.4","1.4"],"：加入游戏。"]],[1,[["l","版本历史#1.6","1.6"],"：现在砍倒一棵成熟的茶树将返还一个茶苗。"]]]]]]],"f":[["季节",["春季 • 夏季 • 秋季"]],["生长时间",["20天"]],["种子",[["i","(O)251","茶苗"]]],["产出",[["i","(O)815","茶叶"]]]]}