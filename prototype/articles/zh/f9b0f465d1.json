{"s":[[null,1,[["p",["淡啤酒是一种",["l","工匠物品","工匠物品"],"。可以用",["l","啤酒花","啤酒花"],"作为原料、用",["l","小桶","小桶"],"制作而成，制作时间为1-2天。也可以在",["l","姜岛#海滩度假村","姜岛海滩度假村"],"以1,000金的价格购买。",["l","沙漠节","沙漠节"],"期间，",["l","潘姆","潘姆"],"会在其",["l","沙漠节#村民商铺","商铺"],"以30卡利科蛋 ",["l","卡利科三花蛋","卡利科三花蛋"],"的价格出售淡啤酒。"]],["p",["淡啤酒的售出价格是普通品质",["l","啤酒花","啤酒花"],"的12倍。对比所有在",["l","小桶","小桶"],"中以作物为原料酿造出的产品，它的",["l","小桶生产力","日利润"],"排第二名（第一是",["l","杨桃","杨桃"],"），且比起其余作物，其制作所需时间最短（和",["l","小麦","小麦"],"相同）。"]],["p",["玩家饮用淡啤酒后会出现",["l","效果#Tipsy","眩晕"],"，效果是速度-1。"]]]],["陈酿价值",2,[["p",["淡啤酒可以放置在",["l","木桶","木桶"],"中进行陈酿，从普通品质升到银星、金星，最终达到铱星品质。铱星品质淡啤酒的基础售价是普通淡啤酒的2倍。"]],["p",["通常情况下，可以随时用",["l","斧头","斧头"],"、",["l","锄头","锄头"],"或",["l","十字镐","十字镐"],"取下木桶，以从木桶中提早取出普通、银星或金星淡啤酒。"]],["t",[[{"h":1,"v":["普通品质"]},{"h":1,"v":["银星品质（x 1.25）"]},{"h":1,"v":["金星品质（x 1.5）"]},{"h":1,"v":["铱星品质（x 2）"]}],[["300金"],["300金 天数：9天"],["300金 天数：8天\n总计：17天"],["300金 天数：17天\n总计：34天"]]]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","潘姆","潘姆"]]],[{"h":1,"v":["喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"]]],[{"h":1,"v":["讨厌"]},[["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","潘妮","潘妮"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","雷欧","雷欧"]]]]]]],["收集包",2,[["p",["淡啤酒是酿酒师收集包的可选物品之一。"]]]],["裁制",2,[["p",["淡啤酒可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","黑皮夹克"],"。淡啤酒可用于",["l","染色","染色"],"。放置在",["l","染色#染料罐","染料罐"],"内时，淡啤酒可用作黄色染料。放置在",["l","染色#缝纫机","缝纫机"],"内时，淡啤酒还可用作金色染料。"]]]],["任务",2,[["l",0,[[1,[["l","任务#潘姆