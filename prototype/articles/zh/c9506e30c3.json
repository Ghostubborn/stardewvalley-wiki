{"s":[[null,1,[["p",["恐龙蛋是一种",["l","古物","古物"],"，也是一种",["l","动物","动物产品"],"。"]],["p",[["l","恐龙蛋","恐龙蛋"],"可以通过挖掘",["l","深山","深山"],"（包括",["l","采石场","采石场"],"）的",["l","远古斑点","远古斑点"],"，或打开",["l","钓鱼","钓鱼宝箱"],"，杀死",["l","霸王喷火龙","霸王喷火龙"],"获得掉落物，采集于",["l","骷髅洞穴","骷髅洞穴史前层"],"获得，也可通过",["l","电影院","抓娃娃机"],"获得。",["l","动物","宠物"],"狗达到最大",["l","动物","好感度"],"后，每天第一次被抚摸也有可能掉落恐龙蛋。"]],["p",["把恐龙蛋放入",["l","鸡舍","大鸡舍"],"的",["l","孵化器","孵化器"],"中，经过12天会孵化出一只",["l","恐龙","恐龙"],"（如果玩家具有",["l","耕种","鸡舍大师"],"职业，则只需要6天）。"]],["p",["孵化后，恐龙会每七天产一次蛋，每个恐龙蛋的基础售价是 350金。"]]]],["捐赠",2,[["p",["捐赠该物品可以增加",["l","博物馆","博物馆"],"的捐赠总数。"]],["p",["小提示：将发现的第一个恐龙蛋放入孵化器中而不是捐献给博物馆，可以确保玩家既能获得一只恐龙，又能完成博物馆的收藏。"]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","矮人","矮人"],"、",["l","潘妮","潘妮"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","亚历克斯","亚历克斯"]]],[{"h":1,"v":["不喜欢"]},[["l","罗宾","罗宾"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]]]]]],["工匠物品",2,[["p",["另见：",["l","加工动物制品的收益","加工动物制品的收益"]]],["p",["恐龙蛋可用于制作",["l","恐龙蛋黄酱","恐龙蛋黄酱"],"。"]],["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名字"]},{"h":1,"v":["描述"]},{"h":1,"v":["成分"]},{"h":1,"v":["设备"]},{"h":1,"v":["时间"]},{"h":1,"v":["售价"]}],[[["f","Dinosaur_Mayonnaise.png",48]],[["l","恐龙蛋黄酱","恐龙蛋黄酱"]],["粘稠且呈乳脂状，带有鲜艳的绿色。闻起来有草和皮革的味道。"],[["i","(O)107","恐龙蛋"]],[["f","Mayonnaise_Machine.png",40],["l","蛋黄酱机","蛋黄酱机"]],["三小时"],["800金"]]]]]],["收集包",2,[["p",["不用於任何收集包。"]]]],["食谱",2,[["p",["不用于任何食谱。"]]]],["裁制",2,[["p",["恐龙蛋可通过",["l","缝纫机","缝纫机"],"使用",["l",