{"s":[[null,1,[["p",["恐龙蛋是一种",["l","古物","古物"],"。可以通过挖掘",["l","深山","深山"],"和",["l","采石场","采石场"],"内的",["l","远古斑点","远古斑点"],"、打开",["l","钓鱼#宝箱","钓鱼宝箱"],"或击杀",["l","霸王喷火龙","霸王喷火龙"],"获得，也可以在",["l","骷髅洞穴#恐龙层","骷髅洞穴恐龙层"],"通过采集获得，还有较小概率可通过",["l","电影院#抓娃娃","抓娃娃机"],"获得。"]],["p",["恐龙蛋可以放入",["l","鸡舍","大鸡舍或豪华鸡舍"],"的",["l","孵化器","孵化器"],"中孵化出小恐龙。孵化需要",["f","Time_Icon.png",24]," 18000 分钟（11 天 6 小时 40 分钟），如果玩家选择了",["l","耕种#耕种技能","鸡舍大师"],"职业，则孵化时间减半。"]],["p",["将恐龙蛋孵化得到",["l","恐龙","恐龙"],"后，恐龙会每 7 天产一次蛋。因此，将发现的第一个恐龙蛋放入孵化器中而不是捐献给博物馆，可以确保玩家既能获得一只恐龙，又能完成博物馆的收藏。"]]]],["送礼",2,[["t",[[{"h":1,"c":2,"v":["收到恐龙蛋后"]}],[{"h":1,"v":["喜欢\n+45"]},[["f","Alex_Icon.png",24]," ",["l","亚历克斯","亚历克斯"]," • ",["f","Penny_Icon.png",24]," ",["l","潘妮","潘妮"]," • ",["f","Demetrius_Icon.png",24]," ",["l","德米特里厄斯","德米特里厄斯"]," • ",["f","Dwarf_Icon.png",24]," ",["l","矮人","矮人"]]],[{"h":1,"v":["不喜欢\n-20"]},[["f","Harvey_Icon.png",24]," ",["l","哈维","哈维"]," • ",["f","Sam_Icon.png",24]," ",["l","山姆","山姆"]," • ",["f","Shane_Icon.png",24]," ",["l","谢恩","谢恩"]," • ",["f","Elliott_Icon.png",24]," ",["l","艾利欧特","艾利欧特"]," • ",["f","Sebastian_Icon.png",24]," ",["l","塞巴斯蒂安","塞巴斯蒂安"]," • ",["f","Haley_Icon.png",24]," ",["l","海莉","海莉"]," • ",["f","Leah_Icon.png",24]," ",["l","莉亚","莉亚"]," • ",["f","Maru_Icon.png",24]," ",["l","玛鲁","玛鲁"]," • ",["f","Emily_Icon.png",24]," ",["l","艾米丽","艾米丽"]," • ",["f","Abigail_Icon.png",24]," ",["l","阿比盖尔","阿比盖尔"]," • ",["f","Pierre_Icon.png",24]," ",["l","皮埃尔","皮埃尔"]," • ",["f","Caroline_Icon.png",24]," ",["l","卡洛琳","卡洛琳"]," • ",["f","Lewis_Icon.png",24]," ",["l","刘易斯","刘易斯"]," • ",["f","Marnie_Icon.png",24]," ",["l","玛妮","玛妮"]," • ",["f","Robin_Icon.png",24]," ",["l","罗宾","罗宾"]," • ",["f","Evelyn_Icon.png",24]," ",["l","艾芙琳","艾芙琳"]," • ",["f","George_Icon.png",24]," ",["l","乔治","乔治"]," • ",["f","Jas_Icon.png",24]," ",["l","贾斯","贾斯"]," • ",["f","Vincent_Icon.png",24]," ",["l","文森特","文森特"]," • ",["f","Jodi_Icon.png",24]," ",["l","乔迪","乔迪"]," • ",["f","Kent_Icon.png",24]," ",["l","肯特","肯特"]," • ",["f","Willy_Icon.png",24]," ",["l","威利","威利"]," • ",["f","Gus_Icon.png",24]," ",["l","格斯","格斯"]," • ",["f","Pam_Icon.png",24]," ",["l","潘姆","潘姆"]," • ",["f","Linus_Icon.png",24]," ",["l","莱纳斯","莱纳斯"]," • ",["f","Clint_Icon.png",24]," ",["l","克林特","克林特"]," • ",["f","Wizard_Icon.png",24]," ",["l","法师","法师"]," • ",["f","Krobus_Icon.png",24]," ",["l","科罗布斯","科罗布斯"]," • ",["f","Sandy_Icon.png",24]," ",["l","桑迪","桑迪"]," • ",["f","Leo_Icon.png",24]," ",["l","雷欧","雷欧"]]]]]]],["收集包",2,[["p",["恐龙蛋不用于任何",["l","收集包","收集包"],"。"]]]],["工匠物品",2,[["n",["参见：",["l","加工动物制品的收益","加工动物制品的收益"]]],["p",["恐龙蛋可用于制作",["l","恐龙蛋黄酱","恐龙蛋黄酱"],"。"]],["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},{"h":1,"v":["加工原料"]},{"h":1,"v":["加工设备"]},{"h":1,"v":["加工用时"]},{"h":1,"v":["售出价格"]}],[[["f","Dinosaur_Mayonnaise.png",48]],[["l","恐龙蛋黄酱","恐龙蛋黄酱"]],["粘稠且呈乳脂状，带有鲜艳的绿色。闻起来有草和皮革的味道。"],[["i","(O)107","恐龙蛋"],"（1）"],[["i","(BC)24","蛋黄酱机"]],[["f","Time_Icon.png",24]," 180 分钟（3 小时）"],{"b":[["t",[[[["f","Dinosaur_Mayonnaise.png",24]],["800"]]]]]}]]]]],["食谱",2,[["p",["恐龙蛋不用于任何",["l","烹饪#食谱","食谱"],"。"]]]],["裁制",2,[["p",["恐龙蛋可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["i","(H)43","恐龙帽"],"。恐龙蛋可用于",["l","染色","染色"],"。放置在",["l","染色#染料罐","染料罐"],"内时，恐龙蛋可用作绿色染料。放置在",["l","染色#缝纫机","缝纫机"],"内时，恐龙蛋还可用作绿色染料，染色强度为强烈。"]]]],["任务",2,[["p",[["l","格斯","格斯"],"的",["l","任务#Gus'_Famous_Omelet","特别任务：格斯的著名煎蛋卷"],"将会需要玩家在任务期间收集并提交24个蛋（任何蛋都适用）。"]]]],["你知道吗",2,[["p",["恐龙蛋与《超级马里奥》游戏系列中的“耀西蛋（Yoshi's Egg）”非常相似，可能是参考了它们。"]]]],["彩蛋",2,[["l",false,[[1,["首次孵化恐龙蛋后与德米特里厄斯对话，他会给玩家赠送一杯三倍浓缩咖啡。"]],[2,["“我没听错吧？！你成功孵化了恐龙蛋？简直是史无前例！来，这杯咖啡就给你了，我现在兴奋得不得了……不能再喝了。”"]]]]]],["历史",2,[["l",false,[[1,["1.0：加入游戏。"]],[1,["1.4：加入恐龙蛋黄酱，此前用恐龙蛋只能制出金星品质的蛋黄酱。加入了霸王喷火龙的掉落物，抓娃娃机的奖品中。现在可在恐龙层采集获得。现在可用于裁缝。"]],[1,["1.5：现在潘妮和矮人喜欢古物，其他居民对古物的态度从讨厌变成了不喜欢。"]],[1,["1.6：现在德米特里厄斯和亚历克斯喜欢恐龙蛋，并且在收到恐龙蛋后会有独特的对话。现在恐龙蛋的售价会受到古代珍宝鉴定指南增益。"]]]]]]]}