{"s":[[null,1,[["p",["葡萄是一种",["l","水果","水果"],"，既是一种",["l","农作物","农作物"],"，也是一种",["l","采集#可采集物品","采集品"],"。可以在",["l","夏季","夏季"],"通过",["l","采集","采集"],"或种植",["l","夏季种子","夏季种子"],"获得。也可以在",["l","秋季","秋季"],"通过种植",["l","葡萄种子","葡萄种子"],"生长 10 天成熟后获得。成熟后，每 3 天可以收获一次。"]],["p",["葡萄生长在一个自带的棚架上，棚架会阻挡玩家移动，因此在种植时需要预留通道以便收获。"]],["p",["旅行货车会以 240–1,000金 的价格随机出售。在夏季翻动",["l","垃圾桶","垃圾桶"],"时也有概率找到葡萄。"]],["p",[["l","秋季","秋季"],"作为",["l","农作物","农作物"],"生长而成的葡萄售价和其他",["l","农作物","农作物"],"一样受到",["l","技能#耕种","农耕人"],"职业加成影响。然而，",["l","夏季","夏季"],"由",["l","采集","采集"],"或",["l","夏季种子","夏季种子"],"获得的葡萄售价不受农耕人职业影响。如果将",["l","农作物","农作物"],"葡萄和",["l","采集","采集"],"葡萄堆叠后售卖，将全部视为农作物葡萄。（详见",["l","水果#农耕人职业适用范围详解","水果"],"）。除此之外，两种来源的葡萄没有其他区别，在用于",["l","打造","打造"],"、",["l","友谊","礼物"],"、",["l","收集包","收集包"],"、",["l","烹饪","烹饪"],"和",["l","任务","任务"],"时可以通用。"]],["p",["与别的水果不同的是，把葡萄放入",["l","烘干机","烘干机"],"将产出",["l","葡萄干","葡萄干"],"，而不是普通的",["l","果干","果干"],"。"]]]],["生长阶段",2,[["p",["葡萄植株在任何生长阶段都不能行走通过，除了枯萎状态。"]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","文森特","文森特"]]],[{"h":1,"v":["喜欢"]},[["l","德米特里厄斯","德米特里厄斯"],"、",["l","艾利欧特","艾利欧特"],"、",["l","哈维","哈维"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","莉亚","莉亚"],"、",["l","莱纳斯","莱纳斯"],"、",["l","潘姆","潘姆"],"、",["l","罗宾","罗宾"],"、",["l","桑迪","桑迪"],"、",["l","谢恩","谢恩"]]],[{"h":1,"v":["一般"]},[["l","亚历克斯","亚历克斯"],"、",["l","卡洛琳","卡洛琳"],"、",["l","克林特","克林特"],"、",["l","矮人","矮人"],"、",["l","艾米丽","艾米丽"],"、",["l","艾芙琳","艾芙琳"],"、",["l","乔治","乔治"],"、",["l","格斯","格斯"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"],"、",["l","刘易斯","刘易斯"],"、",["l","玛妮","玛妮"],"、",["l","玛鲁","玛鲁"],"、",["l","皮埃尔","皮埃尔"],"、",["l","山姆","山姆"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","威利","威利"],"、",["l","法师","法师"]]],[{"h":1,"v":["不喜欢"]},[["l","阿比盖尔","阿比盖尔"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"]]],[{"h":1,"v":["讨厌"]},[["l","潘妮","潘妮"]]]]]]],["收集包",2,[["l",0,[[1,["夏季采集收集包需要 1 个葡萄"]],[1,["夏季采集收集包需要 1 个葡萄"]]]]]],["食谱",2,[["p",["葡萄不用于任何",["l","烹饪#食谱","食谱"],"。"]]]],["打造",2,[["t",[[{"h":1,"v":["图片"]},{"h":1,"v":["名称"]},{"h":1,"v":["描述"]},