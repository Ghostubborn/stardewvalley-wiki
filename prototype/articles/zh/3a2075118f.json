{"s":[[null,1,[["p",["生命药水是一种",["l","打造","可食用的制造物品"],"，达到 ",["f","Combat_Skill_Icon.png",24]," ",["l","战斗","战斗"],"等级2 后可以通过",["l","打造","打造"],"获得，还可以以2,000金在",["l","矮人","矮人"],"处购买。",["l","蝙蝠","铱蝠"],"有 5% 的概率掉落生命药水，",["l","骷髅洞穴","骷髅洞穴"],"的宝箱层也可能会发现 2-4 个生命药水。打开",["l","谜之盒","谜之盒"],"或",["l","金色谜之盒","金色谜之盒"],"也有概率获得2瓶生命药水。"]]]],["送礼",2,[["t",[[{"h":1,"v":["喜欢"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘妮","潘妮"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"]]],[{"h":1,"v":["不喜欢"]},[["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]]]]]],["裁制",2,[["p",["生命药水可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成可染色的 ",["l","裁缝","男款深色荧光衬衫"]," 或 ",["l","裁缝","女款深色荧光衬衫"],"。生命药水可用于",["l","染色","染色"],"。放置在",["l","染色","染料罐"],"内时，生命药水可用作紫色染料。放置在",["l","染色","缝纫机"],"内时，生命药水还可用作亮粉色染料。"]]]],["任务",2,[["p",["生命药水不用于任何",["l","任务","任务"],"。"]]]],["趣闻",2,[["l",0,[[1,["1.6.4以前单独食用普通品质的",["l","紫蘑菇","紫蘑菇"],"+",["l","羊肚菌","羊肚菌"],"+",["l","鸡油菌","鸡油菌"],"可恢复 220 点",["l","能量","能量"],"，这比生命药水能提供的能量还要多。然而，食用这些蘑菇只能回复 98 点",["l","生命值","生命值"],"并不能补满。"]],[1,["制作并出售这个物品会导致亏损，因为原材料的售价更高（总共 645 金）。"]]]]]]]}