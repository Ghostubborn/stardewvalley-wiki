{"s":[[null,1,[["p",["兔子的脚是一个由",["l","兔子","兔子"],"产出的动物产品。在玩家同兔子的",["l","动物#友谊","友谊"],"足够高、兔子有足够的",["l","动物#心情","心情"],"、当日",["l","运气#每日运气","基础运气"],"足够高的情况下，兔子就有概率产出该物品。兔子的脚可以从",["l","旅行货车","旅行货车"],"以 1,695–2,825金的价格购买；或者在",["l","骷髅洞穴","骷髅洞穴"],"杀死",["l","飞蛇","飞蛇"],"有0.8%的几率掉落该物品。",["l","沙漠节","沙漠节"],"期间，",["l","贾斯","贾斯"],"会在其",["l","沙漠节#村民商铺","商铺"],"以100卡利科蛋 ",["l","卡利科三花蛋","卡利科三花蛋"],"的价格出售兔子的脚（限1个）。",["l","动物#宠物","宠物"],"猫达到最大",["l","动物#好感度","好感度"],"后，每天第一次被抚摸也有可能掉落一个兔子的脚。"]],["p",["尽管物品描述中提及运气，但",["l","效果","运气增益效果"],"并不影响兔子的脚的掉落几率，携带兔子的脚也不会增加运气。"]]]],["送礼",2,[["t",[[{"h":1,"v":["最爱"]},[["l","罗宾","罗宾"],"、",["l","德米特里厄斯","德米特里厄斯"],"、",["l","玛鲁","玛鲁"],"、",["l","塞巴斯蒂安","塞巴斯蒂安"],"、",["l","莱纳斯","莱纳斯"],"、",["l","皮埃尔","皮埃尔"],"、",["l","卡洛琳","卡洛琳"],"、",["l","阿比盖尔","阿比盖尔"],"、",["l","亚历克斯","亚历克斯"],"、",["l","乔治","乔治"],"、",["l","艾芙琳","艾芙琳"],"、",["l","刘易斯","刘易斯"],"、",["l","克林特","克林特"],"、",["l","潘姆","潘姆"],"、",["l","艾米丽","艾米丽"],"、",["l","海莉","海莉"],"、",["l","贾斯","贾斯"],"、",["l","文森特","文森特"],"、",["l","乔迪","乔迪"],"、",["l","肯特","肯特"],"、",["l","山姆","山姆"],"、",["l","莉亚","莉亚"],"、",["l","谢恩","谢恩"],"、",["l","玛妮","玛妮"],"、",["l","艾利欧特","艾利欧特"],"、",["l","格斯","格斯"],"、",["l","矮人","矮人"],"、",["l","法师","法师"],"、",["l","哈维","哈维"],"、",["l","桑迪","桑迪"],"、",["l","威利","威利"],"、",["l","科罗布斯","科罗布斯"],"、",["l","雷欧","雷欧"]]],[{"h":1,"v":["讨厌"]},[["l","潘妮","潘妮"]]]]]]],["收集包",2,[["p",["兔子的脚用于魔法师收集包。"]]]],["食谱",2,[["p",["不用于任何食谱。"]]]],["裁制",2,[["p",["兔子的脚可通过",["l","缝纫机","缝纫机"],"使用",["l","布料","布料"],"制成 ",["l","裁缝","上衣"],"。兔子的脚还可用作",["l","染色#染料罐","染料罐"],"和",["l","染色#缝纫机","缝纫机"],"的黄色染料。"]]]],["任务",2,[["p",["不用于任何任务。"]]]],["其他用途",2,[["l",0,[[1,["兔子的脚用于解开",["l","秘密纸条","秘密纸条 #20"],"。"]],[1,["兔子的脚用于防止",["l","花束","群体10心事件"],"出现负面结局。"]]]]]],["历史",2,[["l",0,[[1,[["l","版本历史#1.0","1.0"],"：加入游戏。"]],[1,[["l","版本历史#1.1","1.1"],"：价值从450金上调到565金。"]],[1,[["l","版本历史#1.3.27","1.3.27"],"：现在用于解开秘密纸条 #20。现在可用于“群体10心事件”。"]],[1,[["l","版本历史#1.4","1.4"],"：现在在裁缝中可用。"]],[1,[["l","版本历史#1.6","1.6"],"：现在抚摸达到最大",["l","动物#好感度","好感度"],"的",["l","动物#宠物","宠物"],"猫有概率掉落。现在可以在",["l","沙漠节","沙漠节"],"期间从贾斯的商铺购买获得。"]]]]]]],"f":[["来源",[["l","兔子","兔子"],["l","旅行货车","旅行货车"],["l","飞蛇","飞蛇"],"掉落（0.8%）",["l","动物#猫和狗","猫"]]],["售价",["565金"]]]}