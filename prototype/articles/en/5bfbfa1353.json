{"s":[[null,1,[["p",["The Magma Cap is a mushroom found via ",["l","采集","foraging"]," throughout the ",["l","火山地牢","Volcano Dungeon"],". It can be confused at a distance with a ",["l","假熔岩菇","False Magma Cap"],". False Magma Caps have a 99% chance to drop a Magma Cap when slain. It can also be acquired from a ",["l","黄貂鱼","Stingray"]," ",["l","鱼塘","Fish Pond"]," with a population of at least 4."]],["p",["Magma Caps can be used to purchase ",["l","菠萝种子","Pineapple Seeds"]," from the ",["l","姜岛商人","Island Trader"]," (1 Pineapple Seed for 1 Magma Cap)."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Like"]},[["l","莱纳斯","Linus"],", ",["l","莉亚","Leah"],", ",["l","哈维","Harvey"],", ",["l","玛鲁","Maru"]]],[{"h":1,"v":["Neutral"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","肯特","Kent"],", ",["l","玛妮","Marnie"],", ",["l","格斯","Gus"],", ",["l","桑迪","Sandy"]]],[{"h":1,"v":["Dislike"]},[["l","塞巴斯蒂安","Sebastian"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","雷欧","Leo"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","山姆","Sam"],", ",["l","谢恩","Shane"],", ",["l","艾利欧特","Elliott"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"]]]]]]],["Bundles",2,[["p",["Magma Cap is not used in any ",["l","收集包","bundles"],"."]]]],["Tailoring",2,[["p",["Magma Cap is used in the spool of the ",["l","柳巷2号","Sewing Machine"]," to create a ",["l","裁缝","Magenta Shirt"],". It can be used in ",["l","染色","dyeing"],", serving as a purple dye at the dye pots, located in ",["l","艾米丽","Emily"],"'s and ",["l","海莉","Haley"],"'s house, ",["l","柳巷2号","2 Willow Lane"],"."]]]],["Quests",2,[["p",["Magma Cap is not used in any ",["l","任务","quests"],"."]]]]],"f":