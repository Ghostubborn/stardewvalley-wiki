{"s":[[null,1,[["p",["Quality Retaining Soil is a ",["l","肥料","Fertilizer"]," that has a chance to keep soil watered. It can be purchased from ",["l","皮埃尔的杂货店","Pierre's General Store"]," for 150g from year 2 onward, from the ",["l","绿洲","Oasis"]," for 200g on Saturdays, or ",["l","打造","crafted"]," once the player has reached ",["l","耕种","farming level 7"],". 5-7 Quality Retaining Soil may occasionally found in ",["l","补给箱","Supply Crate"],"s on the ",["l","农场地图","Beach Farm"]," if the player has not upgraded the ",["l","农舍","Farmhouse"]," or only upgraded it once. Quality Retaining Soil may randomly appear in the ",["l","旅行货车","Traveling Cart"],"'s stock for 100–1,000g."]],["p",["Quality Retaining Soil can be placed on tilled soil before or after planting a seed, or at any stage of crop growth. The chance for retaining water is about 66%."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Dislike"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","雷欧","Leo"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"]]]]]]],["Bundles",2,[["p",["Quality Retaining Soil is not used in any ",["l","收集包","bundles"],"."]]]],["Tailoring",2,[["p",["Quality Retaining Soil can be used in the spool of the ",["l","柳巷2号","Sewing Machine"]," to create the dyeable ",["l","裁缝","High-Waisted Shirt"],". ",["f","Shirt175.png",24]," It can be used in ",["l","染色","dyeing"],", serving as an orange dye at the dye pots, located in ",["l","艾米丽","Emily"],"'s and ",["l","海莉","Haley"],"'s house, ",["l","柳巷2号","2 Willow Lane"],"."]]]],["Quests",2,[["p",["Quality Retaining Soil is not used in any ",["l","任务","quests"],"."]]]]]}