{"s":[[null,1,[["p",["The Frozen Tear is a ",["l","矿物","Mineral"]," that can be found:"]],["l",0,[[1,["via ",["l","采集","foraging"]," in ",["l","矿井","The Mines"]," between floors 40 and 79."]],[2,["this is reduced to floors 71-79 if the ",["l","矿井","Dangerous Mines"]," are active."]],[1,["from slain ",["l","灰尘精灵","Dust Sprite"],"s in The Mines (2% chance)."]],[1,["in containers in The Mines between floors 40 and 79 after the player has reached the bottom of The Mines (4.62% chance)"]],[1,["by ",["l","淘盘","panning"]," (4.9% chance)."]],[1,["in ",["l","冰封晶球","Frozen Geode"],"s (6.25% chance) and ",["l","万象晶球","Omni Geode"],"s (2.0833% chance)."]],[1,["in ",["l","钓鱼","Fishing Treasure Chests"]," (4% chance)."]],[1,["occasionally in a ",["l","垃圾桶","Garbage Can"]," after the player has reached the bottom of The Mines."]],[1,["in an ",["l","冰柱鱼","Ice Pip"]," ",["l","鱼塘","Fish Pond"],", which may produce 5 Frozen Tears when the population of the pond reaches 9."]],[1,["through the mail from the ",["l","法师","Wizard"]," at any ",["l","友谊","friendship"]," level greater than zero friendship points."]],[1,["at the ",["l","无尽财富之雕像","Statue Of Endless Fortune"]," on Winter 10, ",["l","塞巴斯蒂安","Sebastian"],"'s birthday."]],[1,["as an item sometimes sold for 2,500g from ",["l","皮埃尔","Pierre"],"'s booth at the ",["l","冬日星盛宴","Feast of the Winter Star"],"."]],[1,["via ",["l","采集","foraging"]," in the ",["l","骷髅洞穴","Skull Cavern"]]]]],["p",["Frozen Tear can be destroyed by ",["l","打造","bombs"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Love"]},[["l","塞巴斯蒂安","Sebastian"]]],[{"h":1,"v":["Like"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],