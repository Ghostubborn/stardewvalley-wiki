{"s":[[null,1,[["p",["The Warp Totem: Mountains is a ",["l","传送图腾","Warp Totem"]," that transports the player to ",["l","深山","The Mountain"]," by selecting it in inventory and right-clicking. It can be ",["l","打造","crafted"]," when the recipe becomes available at ",["l","采集","Foraging"]," Level 7."]],["p",["One Warp Totem: Mountains may be received from opening a ",["l","谜之盒","Mystery Box"],"."]],["p",["The following ",["l","蟹笼","Crab Pot"]," ",["l","鱼","fish"]," have a small daily chance to produce one Warp Totem: Mountains in a ",["l","鱼塘","Fish Pond"]," once the population is 9 or higher: ",["l","小龙虾","Crayfish"],", ",["l","玉黍螺","Periwinkle"],", and ",["l","蜗牛","Snail"],". All fish have the same daily chance (7% for population level 9, and 7% for population level 10)."]],["p",["Starting ",["l","夏季","Summer"]," 1 of year 1, there is a 10% chance for a Warp Totem: Mountains to replace ",["l","粘土","Clay"]," in an ",["l","远古斑点","Artifact Spot"],"."]]]],["Destination",2,[["g",[["Warp_Totem_Mountain_location.png",400,[]]]]]],["Gifting",2,[["t",[[{"h":1,"v":["Hate"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","雷欧","Leo"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"]]]]]]],["Bundles",2,[["p",["The Warp Totem: Mountains is not used in any ",["l","收集包","bundles"],"."]]]],["Tailoring",2,[["p",["The Warp Totem: Mountains can be used in the spool of the ",["l","柳巷2号#Sewing Machine","Sewing Machine"]," to create the ",["i","(H)44","Totem Mask"],". It can be used in ",["l","染色","dyeing"],", serving as an orange dye at the dye pots, located in ",["l","艾米丽","Emily"],"'s and ",["l","海莉","Haley"],"'s house, ",["l","柳巷2号","2 Willow Lane"],"."]]]],["Quests",2,[["p",["The Warp Totem: Mountains is not used in any ",["l","任务","quests"],"."]]]],["History",2,[["l",0,[[1,[["l","版本历史#1.4","1.4"],": Can now be used in ",["l","裁缝","Tailoring"],". Can be produced by ",["l","鱼塘","Fish Pond"],"s."]],[1,[["l","版本历史#1.5","1.5"],": Can replace ",["l","粘土","clay"]," in ",["l","远古斑点","artifact spots"],"."]],[1,[["l","版本历史#1.6","1.6"],": Added as possible prize from ",["l","谜之盒","Mystery Box"],"."]]]]]]]}