{"s":[[null,1,[["p",["Fiber Seeds are a type of ",["l","打造","crafted"]," seed. They do not require daily watering and can even grow in ",["l","冬季","Winter"],", but they must still be planted on tilled soil. They can also be eaten by ",["l","动物","Crows"]," if not protected by a ",["l","稻草人","Scarecrow"],"."]],["p",["The recipe is obtained from ",["l","莱纳斯","Linus"]," in the mail the day after completing the Special Order ",["l","任务","\"Community Cleanup\""],"."]],["p",["Each fully-grown plant drops between 4 and 7 ",["l","纤维","Fiber"]," when harvested with a ",["l","镰刀","Scythe"],". There is also a 10% chance to drop 1 ",["l","混合种子","Mixed Seeds"],"."]]]],["Stages",2,[["t",[[{"h":1,"v":["Season"]},{"h":1,"v":["Stage 1"]},{"h":1,"v":["Stage 2"]},{"h":1,"v":["Stage 3"]},{"h":1,"v":["Stage 4"]},{"h":1,"v":["Harvest"]}],[{"h":1,"v":["Spring\nSummer"]},[["f","Fiber_Stage_1.png",45]],[["f","Fiber_Stage_2.png",45]],[["f","Fiber_Stage_3.png",45]],[["f","Fiber_Stage_4.png",45]],[["f","Fiber_Stage_5.png",45]]],[{"h":1,"v":["Fall"]},[["f","Fiber_Stage_1_Fall.png",45]],[["f","Fiber_Stage_2_Fall.png",45]],[["f","Fiber_Stage_3_Fall.png",45]],[["f","Fiber_Stage_4_Fall.png",45]],[["f","Fiber_Stage_5_Fall.png",45]]],[{"h":1,"v":["Winter"]},[["f","Fiber_Stage_1_Winter.png",45]],[["f","Fiber_Stage_2_Winter.png",45]],[["f","Fiber_Stage_3_Winter.png",45]],[["f","Fiber_Stage_4_Winter.png",45]],[["f","Fiber_Stage_5_Winter.png",45]]],[["Days:"],["1 Day"],["2 Days"],["2 Days"],["2 Days"],["Total: 7 Days"]]]]]],["Tips",2,[["l",0,[[1,["Fiber Seeds can be planted during the last week of ",["l","秋季","Fall"]," to prevent ",["l","肥料","fertilizer"],"s from disappearing on the first day of ",["l","冬季","Winter"],"."]],[1,["Although they are not considered \"",["l","农作物","Crops"],"\", ",["l","祝尼魔","Junimos"]," will still harvest them if in range of a ",["l","祝尼魔屋","Junimo Hut"],"."]]]]]]]}