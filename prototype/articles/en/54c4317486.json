{"s":[[null,1,[["p",["The Statue of Endless Fortune is a piece of ",["l","家具","Furniture"]," that can be purchased for 1,000,000g from a shady male NPC in the ",["l","赌场","Casino"],". It produces one gift or item each day. If an item is not collected, it will be replaced by a new item the next day. ",["l","玩家角色","The player"]," can purchase as many of these statues as desired."]],["p",["The statue is one of the most expensive items in the game but also one of the easiest ways to obtain ",["l","铱锭","Iridium Bar"],"s."]]]],["Normal Days",2,[["p",["On days when no ",["l","居民","villager"]," has a birthday, the statue has an equal chance of producing one of four items: ",["i","(O)72","Diamond"],", ",["i","(O)337","Iridium Bar"],", ",["i","(O)749","Omni Geode"],", or ",["i","(O)336","Gold Bar"],"."]]]],["Birthdays",2,[["p",["On a villager's birthday, the statue will produce a specific one of their \"loved\" items. The quality of the item is always normal (lowest quality)."]],["t",[[{"h":1,"v":["Item Produced"]},{"h":1,"v":["Villager's Birthday"]}],[[["i","(O)66","Amethyst"]],[["l","阿比盖尔","Abigail"]]],[[["i","(O)207","Bean Hotpot"]],[["l","德米特里厄斯","Demetrius"]]],[[["i","(O)90","Cactus Fruit"]],[["l","山姆","Sam"]]],[[["i","(O)88","Coconut"]],[["l","莱纳斯","Linus"]]],[[["i","(O)201","Complete Breakfast"]],[["l","亚历克斯","Alex"]]],[[["i","(O)18","Daffodil"]],[["l","桑迪","Sandy"]]],[[["i","(O)72","Diamond"]],[["l","艾芙琳","Evelyn"]," • ",["l","格斯","Gus"]," • ",["l","乔迪","Jodi"]," • ",["l","科罗布斯","Krobus"]," • ",["l","玛妮","Marnie"]," • ",["l","玛鲁","Maru"]," • ",["l","威利","Willy"]]],[[["i","(O)444","Duck Feather"]],[["l","雷欧","Leo"]]],[[["i","(O)60","Emerald"]],[["l","克林特","Clint"]," • ",["l","艾米丽","Emily"]," • ",["l","潘妮","Penny"]]],[[["i","(O)213","Fish Taco"]],[["l","卡洛琳","Caroline"]]],[[["i","(O)202","Fried Calamari"]],[["l","皮埃尔","Pierre"]]],[[["i","(O)84","Frozen Tear"]],[["l","塞巴斯蒂安","Sebastian"]]],[[["i","(O)20","Leek"]],[["l","乔治","George"]]],[[["i","(O)554","Lemon Stone"]],[["