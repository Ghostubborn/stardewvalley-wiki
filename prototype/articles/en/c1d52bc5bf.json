{"s":[[null,1,[["p",["See also: ",["l","游戏内时间","Day Cycle"]]],["p",["This article lists events/conditions that change based on the day of the week."]]]],["Monday",2,[["l",0,[[1,[["l","玛妮","Marnie"]," at ",["l","玛妮的牧场","Marnie's Ranch"]," does not sell or buy anything on Mondays, although the building can still be entered."]],[2,["If it is raining, Marnie does not leave the Ranch and is open during normal business hours."]],[1,[["l","桑迪","Sandy"]," at the ",["l","绿洲","Oasis"]," sells 10 ",["l","椰子","Coconut"],"s for 400g each."]],[1,[["l","科罗布斯","Krobus"]," in ",["l","下水道","The Sewers"]," sells a limited quantity (50) ",["l","史莱姆泥","Slime"],"s for 10g each."]],[1,["The ",["l","沙漠商人","Desert Trader"]," sells 3 ",["l","干草","Hay"]," for 1 ",["l","万象晶球","Omni Geode"],"."]],[1,["The ",["l","姜岛商人","Island Trader"]," sells 1 ",["l","小帽子","Small Cap"]," for 30 ",["l","芋头","Taro Root"],"s."]],[1,["The Special Orders Board in ",["l","鹈鹕镇","Pelican Town"]," and in ",["l","齐先生的核桃房","Qi's Walnut Room"]," refreshes each Monday, with two new quests to choose from."]],[1,["Lone ",["l","杂草","Weeds"]," spawn on ",["l","姜岛#Island West","Ginger Island West"],"."]]]]]],["Tuesday",2,[["l",0,[[1,[["l","罗宾","Robin"],", ",["l","乔迪","Jodi"],", ",["l","卡洛琳","Caroline"],", ",["l","艾米丽","Emily"]," and ",["l","玛妮","Marnie"]," attend exercise class inside ",["l","皮埃尔的杂货店","Pierre's General Store"],". As a result, the ",["l","木匠的商店","Carpenter's Shop"]," and ",["l","玛妮的牧场","Marnie's Ranch"]," do not buy or sell on Tuesdays, although the buildings can still be entered."]],[2,["If it is raining, exercise class is canceled and both shops are open for normal business hours."]],[1,[["l","桑迪","Sandy"]," at the ",["l","绿洲","Oasis"]," sells ",["l","仙人掌果子","Cactus Fruit"]," for 150g."]],[1,[["l","科罗布斯","Krobus"]," in ",["l","下水道","The Sewers"]," sells a single ",["l","万象晶球","Omni Geode"]," for 300g."]],[1,["The ",["l","沙漠商人","Desert Trader"]," sells 1 ",["l","纤维","Fiber"]," for 5 ",["l","石头","Stone"],"."]],[1,["The ",["l","姜岛商人","Island Trader"]," sells 1 ",["l","棕榈树墙饰","Palm Wall Ornament"]," for 1 ",["l","菠萝","Pineapple"],"."]]]]]],["Wednesday",2,[["l",0,[[1,[["l","皮埃尔的杂货店","Pierre's General Store"]," is closed on Wednesdays, and the building cannot be entered. Once the ",["l","社区中心","Community Center"]," is restored or ",["l","玩家角色","the Player"]," has obtained the ",["l","小镇钥匙","Key To The Town"],", the store stays open all week."]],[1,["The ",["l","电视","Television"]," plays a re-run of an episode of ",["l","酱料女皇","The Queen of Sauce"]," (except on Year 1 Spring 3)."]],[1,[["l","桑迪","Sandy"]," at the ",["l","绿洲","Oasis"]," sells 3 ",["l","万象晶球","Omni Geode"],"s for 1,000g each."]],[1,[["l","科罗布斯","Krobus"]," in ",["l","下水道","The Sewers"]," sells a random ",["l","鱼","Fish"]," or ",["l","磁铁","Magnet"]," for 200g."]],[1,["The ",["l","沙漠商人","Desert Trader"]," sells 1 ",["l","布料","Cloth"]," for 3 ",["l","海蓝宝石","Aquamarine"],"s."]],[1,["The ",["l","姜岛商人","Island Trader"]," sells 1 ",["l","蓝鸟面具","Bluebird Mask"]," for 30 ",["l","芋头","Taro Root"],"s."]]]]]],["Thursday",2,[["l",0,[[1,[["l","桑迪","Sandy"]," at the ",["l","绿洲","Oasis"]," sells ",["l","高级生长激素","Deluxe Speed-Gro"]," for 80g."]],[1,[["l","科罗布斯","Krobus"]," in ",["l","下水道","The Sewers"]," sells a limited quantity (10) of ",["l","混合种子","Mixed Seeds"]," for 30g each."]],[1,["The ",["l","沙漠商人","Desert Trader"]," sells a single ",["l","魔法糖冰棍","Magic Rock Candy"]," for 3 ",["l","五彩碎片","Prismatic Shard"],"s."]],[1,["The ",["l","姜岛商人","Island Trader"]," sells 1 ",["l","《火山》照片","'Volcano' Photo"]," for 5 ",["l","芒果","Mango"],"es."]]]]]],["Friday",2,[["l",0,[[1,["The ",["l","旅行货车","Traveling Cart"]," is open in ",["l","煤矿森林","Cindersap Forest"]," from 6am to 8pm."]],[1,["If the ",["l","社区中心","Community Center"]," has been restored, villagers can be found hanging out there."]],[2,["This includes ",["l","克林特","Clint"]," who spends his Fridays there. As a result, he is unavailable for purchasing supplies, upgrading ",["l","工具","Tools"]," or breaking open ",["l","矿物#Geodes","geodes"]," at the ",["l","铁匠铺","Blacksmith"],"."]],[1,["A large number of villagers congregate at ",["l","星之果实酒吧","the Stardrop Saloon"]," after 6pm."]],[1,[["l","桑迪","Sandy"]," at the ",["l","绿洲","Oasis"]," sells ",["l","蜂蜜","Honey"]," for 200g."]],[1,[["l","科罗布斯","Krobus"]," in ",["l","下水道","The Sewers"]," sells a single ",["l","铱制洒水器","Iridium Sprinkler"]," for 10,000g."]],[1,["The ",["l","沙漠商人","Desert Trader"]," sells 1 ",["l","奶酪","Cheese"]," for 1 ",["l","绿宝石","Emerald"],"."]],[1,["The ",["l","姜岛商人","Island Trader"]," sells 1 ",["l","豪华牛仔帽","Deluxe Cowboy Hat"]," for 30 ",["l","芋头","Taro Root"],"s."]]]]]],["Saturday",2,[["l",0,[[1,[["l","威利","Willy"]," goes fishing all day unless it is raining, so the ",["l","鱼店","Fish Shop"]," is closed, although the building can still be entered."]],[1,[["l","桑迪","Sandy"]," at the ",["l","绿洲","Oasis"]," sells ",["l","高级保湿土壤","Quality Retaining Soil"]," for 200g."]],[1,[["l","科罗布斯","Krobus"]," in ",["l","下水道","The Sewers"]," sells five of a random cooked dish."]],[1,["The ",["l","沙漠商人","Desert Trader"]," sells ",["l","打造#Seeds","Wild Seeds"]," for ",["l","打造#Seeds","Wild Seeds"]," from a different ",["l","季节","season"],"."]],[1,["The ",["l","姜岛商人","Island Trader"]," sells 1 ",["l","海洋地毯","Oceanic Rug"]," for 3 ",["l","蓝铁饼鱼","Blue Discus"],"."]]]]]],["Sunday",2,[["l",0,[[1,["The ",["l","友谊#Gifts","gifting"]," limit of 2 gifts per villager per week is reset at the start of the day."]],[1,[["l","采集","Forageable"]," items that had not been picked up disappear overnight between Saturday and Sunday, and new forageables spawn at triple the normal rate."]],[1,["The ",["l","远古斑点","Artifact Spot"]," spawning and removal procedure is run three times (as though 3 days have passed), so artifact spots are more likely to be seen in new positions."]],[1,["The ",["l","电视","Television"]," plays an episode of ",["l","酱料女皇","The Queen of Sauce"],"; during years one and two the episode is new and always teaches the player a ",["l","烹饪#Recipes","recipe"],"."]],[1,["Several villagers attend morning ",["l","由巴","religious services"]," in the chapel inside ",["l","皮埃尔的杂货店","Pierre's General Store"],"."]],[1,["The ",["l","旅行货车","Traveling Cart"]," is open in ",["l","煤矿森林","Cindersap Forest"]," from 6am to 8pm."]],[1,[["l","桑迪","Sandy"]," at the ",["l","绿洲","Oasis"]," sells ",["l","冰淇淋","Ice Cream"]," for 240g."]],[1,[["l","科罗布斯","Krobus"]," in ",["l","下水道","The Sewers"]," sells ten ",["l","蝙蝠翅膀","Bat Wing"],"s for 30g each."]],[1,["The ",["l","沙漠商人","Desert Trader"]," sells 1 ",["l","楼梯","Staircase"]," for 1 ",["l","翡翠","Jade"],"."]],[1,["The ",["l","姜岛商人","Island Trader"]," sells 1 ",["l","热带双人床","Tropical Double Bed"]," for 5 ",["l","香蕉","Banana"],"s."]]]]]]]}