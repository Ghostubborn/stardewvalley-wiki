{"s":[[null,1,[["p",["The Wizard Catalogue is a catalogue of furniture and decor items that can be purchased at ",["l","科罗布斯","Krobus"],"' shop for 150,000g."]],["p",["Once placed, Right-click on the catalogue allows the player to obtain unlimited wizard-themed furniture items at no cost."]],["p",["Tip: Shift + Left-click on an item to add it directly to inventory, instead of attaching it to the mouse cursor."]]]],["Wizard's Letter",2,[["p",["When the player first interacts with the Wizard Catalogue, a letter from the Wizard is shown."]],["q",["My ex-wife took all the furniture.\nFortunately, I had the good sense to make ethereal copies of everything and transcribe them into this book. Enjoy.\n-M. Rasmodius"],[]]]],["Available Furniture",2,[["t",[[{"b":[["t",[[{"h":1,"v":["Name"]}],[[["l","法师床","Wizard Bed"]]],[[["l","法师抽屉柜","Wizard Dresser"]]],[[["l","法师椅子","Wizard Chair"]]],[[["l","法师凳子","Wizard Stool"]]],[[["l","法师桌子","Wizard Table"]]],[[["l","法师茶几","Wizard Tea Table"]]],[[["l","法师小茶几","Wizard End Table"]]],[[["l","法师书架","Wizard Bookcase"]]],[[["l","法师大书架","Large Wizard Bookcase"]]],[[["l","法师矮书架","Short Wizard Bookcase"]]],[[["l","法师小书架","Small Wizard Bookcase"]]],[[["l","法师书桌","Wizard Study"]]],[[["l","法师壁挂书架","Wizard Bookshelf"]]],[[["l","药水架","Elixir Shelf"]]],[[["l","小药水架","Small Elixir Shelf"]]],[[["l","双层药水架","Stacked Elixir Shelf"]]]]]]},{"b":[["t",[[{"h":1,"v":["Name"]}],[[["l","双层小药水架","Small Stacked Elixir Shelf"]]],[[["l","药水桌子","Elixir Table"]]],[[["l","药水长桌","Long Elixir Table"]]],[[["l","两瓶药水","Two Elixirs"]]],[[["l","多瓶药水","Elixir Bundle"]]],[[["l","坩埚","Cauldron"]]],[[["l","法师壁炉","Wizard Fireplace"]]],[[["l","水晶球","Crystal Ball"]]],[[["l","紫水晶球","Amethyst Crystal Ball"]]],[[["l","蓝水晶球","Aquamarine Crystal Ball"]]],[[["l","绿水晶球","Emerald Crystal Ball"]]],[[["l","红水晶球","Ruby Crystal Ball"]]],[[["l","黄水晶球","Topaz Crystal Ball"]]],[[["l","蓝色书","Blue Book"]]],[[["l","散落的蓝色书","Fallen Blue Book"]]],[[["l","棕色书","Brown Book"]]]]]]},{"b":[["t",[[{"h":1,"v