{"s":[[null,1,[["p",["The Sea Cucumber is a ",["l","鱼","fish"]," that can be caught in the ocean at ",["l","沙滩","The Beach"]," or on the ",["l","农场地图#Beach","Beach Farm"]," during ",["l","秋季","Fall"]," and ",["l","冬季","Winter"],". It can also be randomly found in ",["l","垃圾桶","Garbage Can"],"s during ",["l","秋季","Fall"]," and ",["l","冬季","Winter"],", or at the ",["l","旅行货车","Traveling Cart"]," for 225–1,000g. There is a 5% chance to catch a Sea Cucumber during the deep-sea submarine ride at the ",["l","夜市","Night Market"]," during Winter 15-17 (4% if using a ",["l","珍稀诱钩","Curiosity Lure"],")."]],["p",["Sea Cucumber can be caught regardless of time of day or season using ",["l","魔法鱼饵","Magic Bait"],"."]]]],["Map",2,[["p",["The Sea Cucumber can be found in the ocean and in the submarine ride at the Night Market (Winter 15-17)."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Love"]},[["l","威利","Willy"]]],[{"h":1,"v":["Neutral"]},[["l","德米特里厄斯","Demetrius"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","潘姆","Pam"],", ",["l","雷欧","Leo"]]],[{"h":1,"v":["Dislike"]},[["l","罗宾","Robin"],", ",["l","玛鲁","Maru"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","艾米丽","Emily"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","科罗布斯","Krobus"]]],[{"h":1,"v":["Hate"]},[["l","皮埃尔","Pierre"],", ",["l","艾芙琳","Evelyn"],", ",["l","海莉","Haley"],", ",["l","艾利欧特","Elliott"]]]]]]],["Bundles",2,[["p",["Sea Cucumber is not used in any ",["l","收集包","bundles"],"."]]]],["Recipes",2,[["t",[[{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Ingredients"]},{"h":1,"v":["Ene