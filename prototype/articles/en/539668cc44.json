{"s":[[null,1,[["p",["The Eye Patch is a ",["l","帽子","hat"]," that can be purchased from the ",["l","废弃的屋子","Abandoned House"]," for 5,000g after earning the \"Master Angler\" ",["l","成就","Achievement"]," (catch every ",["l","鱼","fish"],")."]]]],["Secret",2,[["d","Details",[["p",["While wearing it, speaking to the bartender in the ",["l","姜岛#Pirate Cove","Pirate Cove"]," causes him to give the player ",["l","蜜蜂酒","mead"],". This can only be done once per night."]]]]]],["History",2,[["l",0,[[1,[["l","版本历史#1.0","1.0"],": Introduced."]],[1,[["l","版本历史#1.6","1.6"],": Purchase price increased from 1,000g to 5,000g."]]]]]]]}