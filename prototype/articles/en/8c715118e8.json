{"s":[[null,1,[["p",["The Mummified Frog is an item that can be obtained by cutting jungle ",["l","杂草","weeds"]," in the ",["l","姜岛#Island East","Ginger Island jungle"]," or in floors 40 – 69 of the ",["l","矿井#Shrine of Challenge","Dangerous Mines"],". Jungle weeds normally have a 1% chance to drop a Mummified Frog, except for the first Mummified Frog found after unlocking the ",["l","岛屿办事处","Island Field Office"],", which has a 10% chance instead."]],["g",[["JungleWeeds.png",144,["Weeds that drop the Mummified Frog"]]]]]],["Donations",2,[["p",["The Mummified Frog can be donated to the ",["l","岛屿办事处","Island Field Office"],", which rewards 1 ",["l","金色核桃","Golden Walnut"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Hate"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"],", ",["l","雷欧","Leo"]]]]]]],["Bone Mill",2,[["p",["The Mummified Frog can be turned into ",["l","高级肥料","Quality Fertilizer"],", ",["l","生长激素","Speed-Gro"],", ",["l","高级生长激素","Deluxe Speed-Gro"]," or ",["l","树肥","Tree Fertilizer"]," in the ",["l","碎骨机","Bone Mill"],"."]]]],["Tailoring",2,[["p",["Mummified Frog is used in the spool of a ",["l","柳巷2号#Sewing Machine","Sewing Machine"]," to create the ",["l","裁缝","Skeleton Shirt"],". ",["f","Shirt014.png",24]," It can be used in ",["l","染色","dyeing"],", serving as a yellow dye at the dye pots, located in ",["l","艾米丽","Emily"],"'s and ",["l","海莉","Haley"],"'s house, ",["l","柳巷2号","2 Willow Lane"],"."]]]],["Quests",2,[["l",0,[[1,[["l","任务#Fragments of the past","\"Fragments of the past\""],": ",["l","冈瑟","Gunther"]," may make a request on the ",["l","任务#List of Special Orders","Special Orders board"]," for 100 of any combination of bone items that must be gathered while the quest is active. You have 7 days to complete the quest. The reward is 3,500g and the ",["l","碎骨机","Bone Mill"]," recipe."]]]]]],["History",2,[["l",0,[[1,[["l","版本历史#1.5","1.5"],": Introduced."]]]]]]],"f":[["Source",["*",["l","姜岛","Ginger Island"]," Jungle\n*",["l","矿井#Shrine of Challenge","Dangerous Mines"]," (Floors 41-69)"]],["Sell Price",["100g"]]]}