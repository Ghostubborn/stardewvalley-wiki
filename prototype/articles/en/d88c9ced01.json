{"s":[[null,1,[["p",["The Flounder is a ",["l","鱼","fish"]," that can be caught in the ocean at ",["l","沙滩","The Beach"]," or on the ",["l","农场地图","Beach Farm"]," during ",["l","春季","Spring"]," and ",["l","夏季","Summer"],". It can also be caught during any season on ",["l","姜岛","Ginger Island"]," West (ocean), South, Southeast, and in the Pirate Cove. It may also randomly appear at the ",["l","旅行货车","Traveling Cart"]," for 300–1,000g or in ",["l","垃圾桶","Garbage Can"],"s during Spring or Summer."]],["p",["Flounder can be caught regardless of time of day or season using ",["l","魔法鱼饵","Magic Bait"],"."]]]],["Map",2,[["p",["Flounder can be found in the ocean and on Ginger Island."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Like"]},[["l","塞巴斯蒂安","Sebastian"]]],[{"h":1,"v":["Neutral"]},[["l","德米特里厄斯","Demetrius"],", ",["l","艾利欧特","Elliott"],", ",["l","莱纳斯","Linus"],", ",["l","潘姆","Pam"],", ",["l","威利","Willy"],", ",["l","雷欧","Leo"]]],[{"h":1,"v":["Dislike"]},[["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","卡洛琳","Caroline"],", ",["l","克林特","Clint"],", ",["l","矮人","Dwarf"],", ",["l","艾米丽","Emily"],", ",["l","乔治","George"],", ",["l","格斯","Gus"],", ",["l","哈维","Harvey"],", ",["l","贾斯","Jas"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","科罗布斯","Krobus"],", ",["l","莉亚","Leah"],", ",["l","刘易斯","Lewis"],", ",["l","玛妮","Marnie"],", ",["l","玛鲁","Maru"],", ",["l","潘妮","Penny"],", ",["l","罗宾","Robin"],", ",["l","山姆","Sam"],", ",["l","桑迪","Sandy"],", ",["l","谢恩","Shane"],", ",["l","文森特","Vincent"],", ",["l","法师","Wizard"]]],[{"h":1,"v":["Hate"]},[["l","艾芙琳","Evelyn"],", ",["l","海莉","Haley"],", ",["l","皮埃尔","Pierre"]]]]]]],["Bundles",2,[["p",["Flounder is not used in any ",["l","收集包","bundles"],"."]]]],["Recipes",2,[["t",[[{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Ingredients"]},{"h":1,"v":["Energy / Health"]},{"h":1,"v":["Buff(s)"]},{"h":1,"v":["Buff Duration"]},{"h":1,"v":["Recipe Source(s)"]},{"h":1,"v":["Sell Price"]}],[[["l","生鱼寿司","Maki Roll"]]