{"s":[[null,1,[["p",["See also: ",["l","烟花（紫色）","Fireworks (Purple)"],", ",["l","烟花（绿色）","Fireworks (Green)"],"."]],["p",["Fireworks (Red) are an item that can be purchased from ",["l","齐先生的核桃房","Qi's Walnut Room"]," for 1 Qi Gem or from the ",["l","赌场","Casino"]," for 200 Qi Coins. When used, the firework is placed on the ground. After a short delay, it goes into the air and creates red sparkles in the shape of a heart. The player's screen is also briefly tinted red."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Dislike"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","雷欧","Leo"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"]]]]]]],["Bundles",2,[["p",["Fireworks (Red) are not used in any ",["l","收集包","bundles"],"."]]]],["Tailoring",2,[["p",["Fireworks (Red) can be used in the spool of the ",["l","柳巷2号","Sewing Machine"]," to create the ",["i","(H)57","Party Hat (red)"],". It can be used in ",["l","染色","dyeing"],", serving as a red dye at the dye pots located in ",["l","艾米丽","Emily"],"'s and ",["l","海莉","Haley"],"'s house, ",["l","柳巷2号","2 Willow Lane"],". It can also be used as a red dye when used in the spool of the Sewing Machine with a dyeable clothing item in the feed."]]]],["Quests",2,[["p",["Fireworks (Red) are not used in any ",["l","任务","q