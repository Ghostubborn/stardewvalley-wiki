{"s":[[null,1,[["p",["Ginger is a root found growing wild on ",["l","姜岛","Ginger Island"],". It must be harvested with a ",["l","锄头","hoe"],". It can also be dropped by ",["l","史莱姆","Tiger Slimes"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Like"]},[["l","哈维","Harvey"],", ",["l","莉亚","Leah"],", ",["l","莱纳斯","Linus"]]],[{"h":1,"v":["Neutral"]},[["l","亚历克斯","Alex"],", ",["l","阿比盖尔","Abigail"],", ",["l","艾米丽","Emily"],", ",["l","玛鲁","Maru"],", ",["l","潘妮","Penny"],", ",["l","克林特","Clint"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","艾芙琳","Evelyn"],", ",["l","乔治","George"],", ",["l","格斯","Gus"],", ",["l","肯特","Kent"],", ",["l","刘易斯","Lewis"],", ",["l","玛妮","Marnie"],", ",["l","潘姆","Pam"],", ",["l","罗宾","Robin"],", ",["l","桑迪","Sandy"]]],[{"h":1,"v":["Dislike"]},[["l","艾利欧特","Elliott"],", ",["l","山姆","Sam"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","谢恩","Shane"],", ",["l","海莉","Haley"],", ",["l","卡洛琳","Caroline"],", ",["l","矮人","Dwarf"],", ",["l","贾斯","Jas"],", ",["l","乔迪","Jodi"],", ",["l","科罗布斯","Krobus"],", ",["l","雷欧","Leo"],", ",["l","皮埃尔","Pierre"],", ",["l","文森特","Vincent"],", ",["l","威利","Willy"],", ",["l","法师","Wizard"]]]]]]],["Recipes",2,[]],["Cooking",3,[["t",[[{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Ingredients"]},{"h":1,"v":["Energy / Health"]},{"h":1,"v":["Buff(s)"]},{"h":1,"v":["Buff Duration"]},{"h":1,"v":["Recipe Source(s)"]},{"h":1,"v":["Sell Price"]}],[[["l","姜汁汽水","Ginger Ale"]],["A zesty soda known for its soothing effect on the stomach."],[["i","(O)829","Ginger ×3"],["i","(O)245","Sugar ×1"]],["Energy 63\nHealth 28"],[["l","运气","Luck (+1)"]],["5m"],[["l","火山地牢#Shop","Dwarf Shop"]," in Volcano Dungeon for 1,000g"],["200g"]]]]]],["Crafting",3,[["t",[[{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Ingredients"]},{"h":1,"v":["Recipe Source(s)"]},{"h":1,"v":["Sell Price"]}]]]]],["Tailoring",2,[["p",["It is used in the spool of the ",["l","柳巷2号#Sewing Machine","Sewing Machine"]," to create the ",["i","(H)90","Forager's Hat