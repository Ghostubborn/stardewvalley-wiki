{"s":[[null,1,[["p",["The Field Snack is an ",["l","打造","edible crafted item"],". The recipe is earned at ",["l","采集","Foraging Skill"]," level 1. Field Snacks can occasionally be found in ",["l","垃圾桶","Garbage Can"],"s throughout ",["l","鹈鹕镇","Pelican Town"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Like"]},[["l","亚历克斯","Alex"]]],[{"h":1,"v":["Dislike"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"],", ",["l","雷欧","Leo"]]]]]]],["Tailoring",2,[["p",["Field Snack is used in the spool of the ",["l","柳巷2号","Sewing Machine"]," to create the ",["l","裁缝","Denim Jacket"],". It can be used in ",["l","染色","dyeing"],", serving as an orange dye at the dye pots, located in ",["l","艾米丽","Emily"],"'s and ",["l","海莉","Haley"],"'s house, ",["l","柳巷2号","2 Willow Lane"],"."]]]],["Quests",2,[["p",["One Field Snack may be requested by ",["l","小龙虾","Crayfish"],", ",["l","玉黍螺","Periwinkle"],", or ",["l","蜗牛","Snail"]," in a ",["l","鱼塘","Fish Pond quest"]," to increase the capacity of the pond from 7 to 10."]]]]]}