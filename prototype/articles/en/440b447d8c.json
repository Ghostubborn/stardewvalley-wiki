{"s":[[null,1,[["p",["Driftwood is a type of ",["l","垃圾","trash"]," that can be caught when fishing during all seasons, in any location, using either a ",["l","工具","Fishing Pole"]," or a ",["l","蟹笼","Crab Pot"],". Also, any crab pot fish may produce Driftwood when placed in a ",["l","鱼塘","Fish Pond"],". It can also be gifted by a ",["l","动物","pet"]," cat or dog with max ",["l","动物","friendship"],"."]],["p",["Driftwood may be ",["l","回收机","recycled"]," into ",["l","木材","Wood"]," or ",["l","煤炭","Coal"],", or ",["l","碎木机","chipped"]," into ",["l","木材","Wood"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Like"]},[["l","莉亚","Leah"]]],[{"h":1,"v":["Dislike"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","雷欧","Leo"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"]]]]]]],["Recycling",2,[["t",[[{"h":1,"v":["Item"]},{"h":1,"v":["Equipment"]},{"h":1,"v":["Product"]},{"h":1,"v":["Recycling Time"]}],[[["i","(O)169","Driftwood"]],[["i","(BC)20","Recycling Machine"]],["1-3 ",["i","(O)388","Wood (75%)"]," or\n1-3 ",["i","(O)382","Coal (25%)"]],["60 mins (1 hour)"]],[[["i","(O)169","Driftwood"]],[["i","(BC)211","Wood Chipper"]],["5-10 ",["i","(O)388","Wood (100%)"]],["180 mins (3 hours)"]]]]]],["Bundles",2,[["p",["Driftwood is not used in any ",["l","收集包","bundles"],"."]]]],["Recipes",2,[["p",["Driftwood is not used in any recipes."]]]],["Tailoring",2,[["p",["Driftwood is used in the spool of the ",["l","柳巷2号","Sewing Machine"]," with ",["l","布料","Cloth"]," in the feed to create a ",["l","裁缝","Trash Can Shirt"],". It is a brown dye when used in the spool of the Sewing Machine with a dyeable clothing item in the feed. It can be placed in the orange dye pot at Emily's and Haley's house for use in ",["l","染色","dyeing"],"."]]]],["Quests",2,[["p",["Three Driftwood may be requested by several fish in ",["l","鱼塘","Fish Pond quests"],"."]],["p",["During the special order quest ",["l","任务","Community Cleanup"]," the player is tasked with gathering 20 trash items (except Joja Cola)."]]]]],"f":[["Source",[["l","工具","Fishing Pole"]," • ",["l","蟹笼","Crab Pot"]," • ",["l","鱼塘","Fish Pond"]," • ",["l","动物","Cat"]," • ",["l","动物","Dog"]]],["Season",["All"]],["Sell Price",["0g"]]]}