{"s":[[null,1,[["p",["A Mahogany Tree is a common ",["l","树","tree"]," that grows from a ",["l","桃花心木种子","Mahogany Seed"],". It yields ",["l","树液","Sap"]," every day when ",["l","树液采集器","tapped"],". It can be chopped down with an ",["l","斧头","axe"],", producing 8-13 ",["l","硬木","Hardwood"],"."]],["p",[["l","桃花心木种子","Mahogany Seed"],"s fertilized with ",["l","树肥","Tree Fertilizer"]," have a 60% chance of growing to the next stage each night, including during ",["l","冬季","Winter"],". Unfertilized seeds have a 15% chance of growing to the next stage. This means that unfertilized mahogany trees usually grow in 26±12 days, while fertilized ones usually grow in 7±2 days."]],["p",["Mahogany Trees may spawn on ",["l","矿井#Floors (dangerous)","floors 41-69"]," of ",["l","矿井","The Mines"]," when either the ",["l","任务#List of Mr. Qi's Special Orders","\"Danger in the Deep\" Quest"]," is active or the ",["l","矿井#Shrine of Challenge","Shrine of Challenge"]," is toggled on."]]]],["Stages of Growth",2,[["t",[[{"h":1,"v":["Stage 1"]},{"h":1,"v":["Stage 2"]},{"h":1,"v":["Stage 3"]},{"h":1,"v":["Stage 4"]},{"h":1,"v":["Stage 5 - Spring, Summer, Fall, Winter"]},{"h":1,"v":["Stump - Spring, Summer, Fall, Winter"]}],[[["f","Mahogany_Stage_1.png",28]],[["f","Mahogany_Stage_2.png",28]],[["f","Mahogany_Stage_3.png",36]],[["f","Mahogany_Stage_4.png",36]],[["f","Mahogany_Stage_5.png",400]],[["f","Mahogany_stump_Spring.png",48]," ",["f","Mahogany_stump_Spring.png",48]," ",["f","Mahogany_stump_Fall.png",36]," ",["f","Mahogany_stump_Winter.png",36]]]]]]],["History",2,[["l",0,[[1,[["l","版本历史#1.5","1.5"],": Introduced."]]]]]]],"f":[["Seed",[["i","(O)292","Mahogany Seed"]]],["Tapper Product",[["i","(O)92","Sap"]]],["Growth Time",["Variable"]]]}