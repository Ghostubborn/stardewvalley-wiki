{"s":[[null,1,[["p",["Quality Fertilizer is a ",["l","肥料","Fertilizer"]," that improves the chance to grow a ",["l","农作物","quality crop"],". It can be ",["l","打造","crafted"],", obtained from a ",["l","碎骨机","Bone Mill"],", or purchased for 150g from ",["l","皮埃尔的杂货店","Pierre's General Store"]," beginning in Year 2. It may also occasionally be sold by the ",["l","旅行货车","Traveling Cart"]," (in any year) for 100–1,000g. Thirty Quality Fertilizer are the reward for completing the Vault. 10-20 Quality Fertilizer may be received from opening a ",["l","谜之盒","Mystery Box"]," or ",["l","金色谜之盒","Golden Mystery Box"],"."]],["p",["Quality Fertilizer must be placed on tilled soil before a seed has sprouted."]],["p",["Quality Fertilizer only affects the basic harvest, which means that extra crops gained at harvest (i.e., ",["l","咖啡豆","Coffee Bean"],", ",["l","蓝莓","Blueberry"],", ",["l","蔓越莓","Cranberries"],") will be of regular quality."]]]],["Chance for Quality Crops",2,[["t",[[{"h":1,"v":[["l","耕种","Farming level"]]},{"h":1,"v":["% Regular quality"]},{"h":1,"v":["% Silver quality"]},{"h":1,"v":["% Gold quality"]},{"h":1,"v":["Average price"]}],[["0"],["78%"],["14%"],["8%"],["1.07"]],[["1"],["64%"],["23%"],["13%"],["1.12"]],[["2"],["52%"],["30%"],["18%"],["1.17"]],[["3"],["40%"],["36%"],["24%"],["1.21"]],[["4"],["30%"],["41%"],["29%"],["1.25"]],[["5"],["21%"],["45%"],["34%"],["1.28"]],[["6"],["15%"],["45%"],["40%"],["1.31"]],[["7"],["14%"],["41%"],["45%"],["1.33"]],[["8"],["13%"],["37%"],["50%"],["1.34"]],[["9"],["11%"],["33%"],["56%"],["1.36"]],[["10"],["10%"],["29%"],["61%"],["1.38"]],[["11"],["9%"],["25%"],["66%"],["1.39"]],[["12"],["7%"],["21%"],["72%"],["1.41"]],[["13"],["6%"],["17%"],["77%"],["1.43"]],[["14"],["4%"],["13%"],["82%"],["1.44"]]]]]],["When to turn fish into Quality Fertilizer",2,[["p",["Below are quick-reference tables showing when to turn fish into Quality Fertilizer, based on the quality of the fish."]],["p",["(The tables consider fish whose sell price is exactly 300g to be not good to turn into Quality Fertilizer, since the addition of the sell price of 4 ",["l","树液","sap"]," (8g) makes it technically better to purchase Quality Fertilizer.)"]]]],["Fishing Pole Fish",3,[["t",[[{"h":1,"v":["Fish"]},{"h":1,"v":["No Profession"]},{"h":1,"v":["Fisher"]},{"h":1,"v":["Angler"]}],[[["i","(O)705","Albacore"]],["Always"],["Always"],["Always"]],[[["i","(O)129","Anchovy"]],["Always"],["Always"],["Always"]],[[["i","(O)838","Blue Discus"]],["Always"],["Regular, Silver, Gold"],["Regular, Silver, Gold"]],[[["i","(O)132","Bream"]],["Always"],["Always"],["Always"]],[[["i","(O)700","Bullhead"]],["Always"],["Always"],["Always"]],[[["i","(O)142","Carp"]],["Always"],["Always"],["Always"]],[[["i","(O)143","Catfish"]],["Regular, Silver"],["Regular"],["Never"]],[[["i","(O)702","Chub"]],["Always"],["Always"],["Always"]],[[["i","(O)704","Dorado"]],["Always"],["Always"],["Regular, Silver, Gold"]],[[["i","(O)148","Eel"]],["Always"],["Always"],["Always"]],[[["i","(O)267","Flounder"]],["Always"],["Always"],["Regular, Silver, Gold"]],[[["i","(O)156","Ghostfish"]],["Always"],["Always"],["Always"]],[[["i","(O)Goby","Goby"]],["Regular, Silver, Gold"],["Regular, Silver, Gold"],["Regular, Silver"]],[[["i","(O)708","Halibut"]],["Always"],["Always"],["Always"]],[[["i","(O)147","Herring"]],["Always"],["Always"],["Always"]],[[["i","(O)136","Largemouth Bass"]],["Always"],["Always"],["Regular, Silver, Gold"]],[[["i","(O)707","Lingcod"]],["Always"],["Regular, Silver, Gold"],["Regular, Silver, Gold"]],[[["i","(O)837","Lionfish"]],["Always"],["Always"],["Regular, Silver, Gold"]],[[["i","(O)269","Midnight Carp"]],["Regular, Silver, Gold"],["Regular, Silver, Gold"],["Regular, Silver"]],[[["i","(O)798","Midnight Squid"]],["Always"],["Always"],["Regular, Silver, Gold"]],[[["i","(O)149","Octopus"]],["Regular, Silver, Gold"],["Regular, Silver, Gold"],["Regular, Silver"]],[[["i","(O)141","Perch"]],["Always"],["Always"],["Always"]],[[["i","(O)144","Pike"]],["Always"],["Alw