{"s":[[null,1,[["p",["Mixed Seeds are a random type of seed capable of producing a specific set of crops (listed below). The crop that will grow from a Mixed Seed is decided when it is planted. Mixed Seeds collected in any season always grow to become crops of the season in which they are planted, including those planted in the ",["l","温室","Greenhouse"]," and indoors via the ",["l","花盆","Garden Pot"],". Mixed Seeds cannot be planted in winter except in the Greenhouse and indoors in garden pots, where they become one of the random crops from any season. Mixed Seeds planted on ",["l","姜岛","Ginger Island"]," are always the same no matter the season."]]]],["Sources",2,[["l",0,[[1,["Harvesting ",["l","杂草","Weeds"]," with a ",["l","镰刀","Scythe"],", ",["l","斧头","Axe"],", ",["l","十字镐","Pickaxe"],", ",["l","锄头","Hoe"],", ",["l","武器","Sword"],", or ",["l","打造","bomb"]," may drop mixed seeds if no ",["l","纤维","Fiber"]," drops (9% chance if ",["l","浣熊日记","Raccoon Journal"]," has been read, otherwise 5%)."]],[1,[["l","锄头","Tilling"]," dirt or sand."]],[1,[["l","钓鱼","Fishing Treasure Chests"],"."]],[1,["Sold by ",["l","科罗布斯","Krobus"]," on ",["l","周循环","Thursdays"]," for 30g each."]],[1,["1/5 chance of being sold at the shop at the ",["l","星露谷展览会","Stardew Valley Fair"]," for 1,000 Prize Tickets for 24 seeds."]],[1,[["l","荒野石魔","Wilderness Golem"],"s and ",["l","铱石魔","Iridium Golem"],"s on the ",["l","农场地图","Wilderness Farm map"]," have a 50% chance of dropping Mixed Seeds, and a 20% chance (after reaching ",["l","战斗","Combat"]," Level 5) for a second one when slain."]],[1,[["l","小龙虾","Crayfish"],", ",["l","玉黍螺","Periwinkle"],", or ",["l","蜗牛","Snail"]," ",["l","鱼塘","Fish Pond"],"s may produce 2-3 Mixed Seeds when the population of the pond reaches 5."]],[1,["Whenever the ",["l","种子生产器","Seed Maker"]," is used with any crop, there is a 1.99% chance you will get 1-4 Mixed Seeds instead of the crop's seeds."]],[1,["3-5 Mixed Seeds may occasionally be found in ",["l","补给箱","Supply Crate"],"s on the ",["l","农场地图","Beach Farm"],"."]],[1,["10 Mixed Seeds may be received from opening a ",["l","谜之盒","Mystery Box"],"."]],[1,["Sold by the ",["l","沙漠节","Calico Egg Merchant"],", ",["l","艾芙琳","Evelyn"],", and ",["l","乔迪","Jodi"]," at the ",["l","沙漠节","Desert Festival"],"."]],[1,["Sold by the ",["l","大树桩（地点）","Raccoon's wife"]," after completing the fourth request."]],[1,["15 from the prize machine in the ",["l","镇长的庄园","Mayor's Manor"]," (50% chance to be the 3rd prize)."]]]]]],["List of Seeds",2,[["p",["Mixed Seeds will turn into the following seeds upon planting. Note that Mixed Seeds can turn into ",["l","洋蓟种子","Artichoke Seeds"]," during year 1, despite the fact that Artichoke Seeds are normally unavailable until year 2. During Spring, on ",["l","农场","the Farm"],", ",["l","防风草种子","Parsnip Seeds"]," are twice as likely to be chosen as Cauliflower or Potato Seeds."]],["t",[[{"h":1,"v":["Season"]},{"h":1,"v":["Seeds"]}],[{"h":1,"v":["Spring"]},[["i","(O)474","Cauliflower Seeds"]," • ",["i","(O)472","Parsnip Seeds"]," • ",["i","(O)475","Potato Seeds"]]],[{"h":1,"v":["Summer"]},[["i","(O)487","Corn Seeds"]," • ",["i","(O)482","Pepper Seeds"]," • ",["i","(O)484","Radish Seeds"]," • ",["i","(O)483","Wheat Seeds"]]],[{"h":1,"v":["Fall"]},[["i","(O)489","Artichoke Seeds"]," • ",["i","(O)487","Corn Seeds"]," • ",["i","(O)488","Eggplant Seeds"]," • ",["i","(O)490","Pumpkin Seeds"]]],[{"h":1,"v":["Winter"]},["Any of the above (",["l","温室","Greenhouse"]," and indoor ",["l","花盆","Garden Pot"]," only)."]],[{"h":1,"v":["Ginger Island"]},[["i","(O)481","Blueberry Seeds"]," • ",["i","(O)479","Melon Seeds"]," • ",["i","(O)833","Pineapple Seeds"]," • ",["i","(O)478","Rhubarb Seeds"]]]]]]],["Recipes",2,[["t",[[{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Ingredients"]},{"h":1,"v":["Recipe Source"]}],[[["l","纤维种子","Fiber Seeds"]],["Plant these in any season. Does not require watering. Harvest with the scythe. Takes 7 days to grow."],[["i","(O)770","Mixed Seeds ×1"],["i","(O)92","Sap ×5"],["i","(O)330","Clay ×1"]],["Special Order Board quest ",["l","任务","Community Cleanup"],"."]]]]]],["Gifting",2,[["t",[[{"h":1,"v":["Dislike"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"],", ",["l","雷欧","Leo"]]]]]]],["Quests",2,[["p",["Three or five Mixed Seeds may be requested by several fish in ",["l","鱼塘","Fish Pond quests"],"."]]]],["Trading",2,[["p",["Ten Mixed Seeds can be traded to the ",["l","大树桩（地点）","Raccoon's wife"]," for 1 ",["l","浣熊帽","Raccoon Hat"],", after the ",["l","大树桩（地点）","third request"]," from the Raccoon family is completed."]]]]]}