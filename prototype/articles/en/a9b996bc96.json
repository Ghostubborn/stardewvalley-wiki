{"s":[[null,1,[["p",["The Double Bed is a piece of ",["l","家具","furniture"],". It can be purchased at the ",["l","木匠的商店","Carpenter's Shop"]," for 2,000g after the player's farmhouse is ",["l","农舍#Upgrades","upgraded"]," for the first time."]],["p",["It's also available from the ",["l","家具目录","Furniture Catalogue"]," for 0g."]],["p",["The original ",["l","床","Bed"]," that comes with the ",["l","农舍","Farmhouse"]," is automatically changed into a Double Bed when the house is ",["l","农舍#Upgrades","upgraded"]," for the first time."]]]],["History",2,[["l",0,[[1,[["l","版本历史#1.0","1.0"],": Introduced."]],[1,[["l","版本历史#1.5","1.5"],": Beds can now be moved."]]]]]]]}