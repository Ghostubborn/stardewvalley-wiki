{"s":[[null,1,[["p",["Coral is a ",["l","采集","forageable"]," item found year-round in the ",["l","沙滩","Tide Pool"]," section of ",["l","沙滩","the Beach"],", i.e., to the east of the wooden footbridge, the southwest area of ",["l","姜岛","Ginger Island West"],", or in ",["l","矿井","The Mines"]," after activating the ",["l","矿井","Shrine of Challenge"]," or during the ",["l","任务","Danger In The Deep"]," quest. During ",["l","夏季","Summer"]," 12-14, extra Coral appears anywhere on the beach (including possibly the western section)."]],["p",["The average spawn rate for Coral in the tide pool section of the beach is 0.93/day. An additional 3.2 (on average) Coral per day will spawn during Summer 12-14. These spawn rates are not affected by the presence of other forageable items on the beach; in particular, Coral are not part of the standard six item per map limit on forageable items. 7 ",["l","采集","Foraging"]," XP are granted for every Coral picked up, and all Foraging bonuses apply to Coral."]],["p",["Several ",["l","蟹笼","Crab Pot"]," ",["l","鱼","fish"]," may produce 1 Coral in a ",["l","鱼塘","Fish Pond"]," when the population of the pond reaches 5. It can also be gifted by a ",["l","动物","pet"]," turtle with max ",["l","动物","friendship"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Like"]},[["l","艾芙琳","Evelyn"]]],[{"h":1,"v":["Neutral"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","雷欧","Leo"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"],", ",["l","玛妮","Marnie"]]],[{"h":1,"v":["Hate"]},[["l","哈维","Harvey"]]]]]]],["Bundles",2,[["p",["Coral is not used in any ",["l","收集包","Bundles"],"."]]]],["Crafting",2,[["t",[[{"h":1,"v":["Image"]},{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Ingredients"]},{"h":1,"v":["Recipe Source"]}],[[["f","Warp_Totem_Beach.png",48]],[["l","传送图腾：海滩","Warp Totem: Beach"]],["Warp directly to the beach. Consumed on use."],[["i","(O)709","Hardwood ×1"],["i","(O)393","Coral ×2"],["i","(O)771","Fiber ×10"]],[["f","Foraging_Skill_Icon.png",24]," ",["l","采集","Foraging"]," Level 6"]],[[["f","Bait_Maker.png",48]],[["l","鱼饵制造机","Bait Maker"]],["Place a fish inside to create targeted bait."],[["i","(O)335","Iron Bar ×3"],["i","(O)393","Coral ×3"],["i","(O)397","Sea Urchin ×1"]],[["f","Fishing_Skill_Icon.png",24]," ",["l","钓鱼","Fishing"]," Level 6"]]]]]],["Buildings",2,[["p",["Ten coral are required to purchase the ",["l","水之图腾柱","Water Obelisk"]," from the ",["l","法师塔","Wizard's Tower"],"."]],["t",[[{"h":1,"v":["Image"]},{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Cost"]},{"h":1,"v":["Size"]}],[[["f","Water_Obelisk.png",48]],[["l","水之图腾柱","Water Obelisk"]],["Warps you to the beach."],["500,000g",["i","(O)337","Iridium Bar ×5"],["i","(O)372","Clam ×10"],["i","(O)393","Coral ×10"]],["3x2\n",["f","Marker3x2.png",48]]]]]]],["Tailoring",2,[["p",["Coral can be used in the spool of the ",["l","柳巷2号","Sewing Machine"]," to create the dyeable ",["l","裁缝","Strapped Top"],". ",["f","Shirt139.png",24]," It can be also used as a red dye color at the dye pots in ",["l","艾米丽","Emily"],"'s and ",["l","海莉","Haley"],"'s house, ",["l","柳巷2号","2 Willow Lane"],"."]]]],["Fish Pond",2,[["p",["Although Coral is not otherwise considered to be ",["l","鱼","fish"],", it can be placed in a ",["l","鱼塘","Fish Pond"],", where it will reproduce every 2 days. The initial pond capacity is 10 Coral; no quests are necessary to increase the pond capacity. Instead of producing ",["l","鱼籽","Roe"],", Coral ponds produce ",["l","白云石","Dolomite"]," and ",["l","石灰石","Limestone"],", but only once the population reaches 9."]],["p",[["l","鱼塘","Produce"]]],["t",[[{"h":1,"v":["Item(s) Produced"]},{"h":1,"v":["Fishing XP Granted"]},{"h":1,"v":["Population"]},{"h":1,"v":["% of Items"]},{"h":1,"v":["Overall Daily Chance"]}],[[["i","(O)543","Dolomite ×1"]],["130"],["9-10"],["6%"],["5-6%"]],[[["i","(O)571","Limestone ×1"]],["16"],["9-10"],["6%"],["5%"]],[{"r":2,"v":["Nothing"]},{"r":2,"v":[]},["1-8"],["100%"],["100%"]],[["9-10"],["88%"],["90-89%"]]]]]],["Quests",2,[["l",0,[[1,["One to three Coral may be requested by several fish in ",["l","鱼塘","Fish Pond quests"],"."]],[1,["Four Coral may be requested by the Raccoon at the ",["l","大树桩（地点）","Giant Stump"]," as part of his fifth request, or as part of any request starting with the sixth."]]]]]]]}