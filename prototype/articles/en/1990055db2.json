{"s":[[null,1,[["p",["The Cherry Sapling is a ",["l","果树","Fruit Tree"]," sapling that takes 28 days to grow into a ",["l","樱桃树","Cherry Tree"],", after which it will produce one fruit each day during the ",["l","春季","Spring"],". Like all Fruit Trees, it will produce fruit all year round if planted in the ",["l","温室","Greenhouse"],"."]],["p",["It can be purchased from ",["l","皮埃尔的杂货店","Pierre's General Store"]," and occasionally from the ",["l","旅行货车","Traveling Cart"],". It may occasionally be found in ",["l","骷髅洞穴","treasure rooms"]," in the Skull Cavern. One Cherry Sapling may be received from opening a ",["l","谜之盒","Mystery Box"]," or ",["l","金色谜之盒","Golden Mystery Box"],"."]]]],["Stages",2,[["t",[[{"h":1,"v":["Stage 1"]},{"h":1,"v":["Stage 2"]},{"h":1,"v":["Stage 3"]},{"h":1,"v":["Stage 4"]},{"h":1,"v":["Stage 5 - Spring, Summer, Fall, Winter"]},{"h":1,"v":["Harvest"]}],[["7 Days"],["7 Days"],["7 Days"],["7 Days"],["Total: 28 Days"],["Spring"]]]]]],["Gifting",2,[["t",[[{"h":1,"v":["Dislike"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","雷欧","Leo"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"]]]]]]]]}