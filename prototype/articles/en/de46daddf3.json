{"s":[[null,1,[["p",["Lobster Bisque is a ",["l","烹饪","cooked dish"],". It is prepared using either the kitchen inside an upgraded ",["l","农舍","farmhouse"]," or a ",["l","野炊工具","Cookout Kit"],". It can randomly be found at the ",["l","旅行货车","Traveling Cart"]," for 615–1,025g. Five can be purchased from ",["l","格斯","Gus"],"'s ",["l","沙漠节#Villager Shops","shop"]," at the ",["l","沙漠节","Desert Festival"]," for 30 Calico Eggs ",["l","卡利科三花蛋","Calico Egg"],"s each. One Lobster Bisque may be received from opening a ",["l","谜之盒","Mystery Box"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Like"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","哈维","Harvey"]]],[{"h":1,"v":["Dislike"]},[["l","科罗布斯","Krobus"],", ",["l","雷欧","Leo"]]]]]]],["Bundles",2,[["p",["Lobster Bisque is not used in any ",["l","收集包","bundles"],"."]]]],["Tailoring",2,[["p",["Lobster Bisque is used in the spool of the ",["l","柳巷2号#Sewing Machine","Sewing Machine"]," to create a ",["l","裁缝","Shirt"],". ",["f","Shirt125.png",24]]]]],["Quests",2,[["p",["Lobster Bisque is not used in any ",["l","任务","quests"],"."]]]],["Trivia",2,[["l",0,[[1,["Receiving the letter from ",["l","威利","Willy"]," with the Lobster Bisque recipe on 14 Winter, Year 2 and watching ",["l","酱料女皇","The Queen of Sauce"]," before checking the mail will result in the letter still in the mailbox, but the recipe box at the bottom of the letter will be blank."]],[1,["Although its description states that it is \"a secret family recipe\", it can be learned from The Queen of Sauce."]]]]]],["History",2,[["l",0,[[1,[["l","版本历史#1.3.27","1.3.27"],": The Lobster Bisque recipe now accepts ",["l","大壶牛奶","Large Milk"]," in addition to ",["l","牛奶","regular milk"],"."]],[1,[["l","版本历史#1.4","1.4"],": Can now be used in ",["l","裁缝","Tailoring"],"."]],[1,[["l","版本历史#1.5","1.5"],": Can now be prepared using a ",["l","野炊工具","Cookout Kit"],"."]],[1,[["l","版本历史#1.6","1.6"],": Now obtainable during ",["l","沙漠节","Desert Festival"],"."]]]]]]]}