{"s":[[null,1,[["p",["Iridium Ore is a resource that can be obtained in a variety of locations (see \"Locations\" below)."]]]],["Locations",2,[["l",0,[[1,["Mining ",["l","采矿","Iridium Nodes"]," and ",["l","采矿","Mystic Stones"],"."]],[2,["Iridium Nodes can be found in the ",["l","采石场","Quarry"],", ",["l","骷髅洞穴","Skull Cavern"],", and ",["l","火山地牢","Volcano Dungeon"],". They can also spawn on ",["l","农场地图","Hill-top"]," and ",["l","农场地图","Four Corners"]," farm maps at Mining Skill level 10.\nTips: The chance to find Iridium Ore increases steadily the further one descends into the Skull Cavern. Large amounts of ",["l","楼梯","staircase"],"s or ",["l","打造","bombs"]," can get one deep into the Skull Cavern quickly."]],[2,["Mystic Stones can be found in ",["l","矿井","the Mines"]," (Floor 100+), ",["l","采石场","Quarry"],", ",["l","骷髅洞穴","Skull Cavern"]," and ",["l","火山地牢","Volcano Dungeon"],"."]],[1,["Opening ",["l","岩浆晶球","Magma Geode"],"s, ",["l","万象晶球","Omni Geode"],"s, and ",["l","金色椰子","Golden Coconut"],"s."]],[2,["To further enhance geode frequency, choose the ",["l","采矿","Geologist Profession"]," at ",["l","采矿","Mining"]," Level 5 and the ",["l","采矿","Excavator Profession"]," at ",["l","采矿","Mining"]," Level 10."]],[2,[["l","科罗布斯","Krobus"]," sells 1 ",["l","万象晶球","Omni Geode"]," every ",["l","周循环","Tuesday"]," for 300g each, and the ",["l","绿洲","Oasis"]," sells 3 Omni Geodes every ",["l","周循环","Wednesday"]," for 500g each."]],[2,["The ",["l","绿洲","Oasis"]," sells 10 ",["l","椰子","Coconut"],"s every ",["l","周循环","Monday"]," for 200g each, which can then be traded with the ",["l","姜岛商人","Island Trader"]," for 1 ",["l","金色椰子","Golden Coconut"]," after having cracked at least one Golden Coconut."]],[1,["Rare drop from high level ",["l","怪物","Monsters"],"."]],[2,[["l","史莱姆（怪物）","Purple Slimes"]," in the ",["l","骷髅洞穴","Skull Cavern"]," have a chance to drop both Iridium Ore and ",["l","铱锭","Iridium Bar"],"s. They can be raised in ",["l","史莱姆屋","Slime Hutch"],"es."]],[2,[["l","蝙蝠","Iridium Bats"]," in the ",["l","骷髅洞穴","Skull Cavern"]," may drop an Iridium Bar (0.8% chance) and up to 4 Iridium Ore when slain."]],[2,[["l","铱蟹","Iridium Crab"],"s in the ",["l","骷髅洞穴","Skull Cavern"]," may drop up to 3 Iridium Ore when slain."]],[2,[["l","铱石魔","Iridium Golem"],"s have a 20% chance to drop Iridium Ore. After reaching ",["l","战斗","Combat"]," level 10, both ",["l","铱石魔","Iridium Golem"],"s and ",["l","荒野石魔","Wilderness Golem"],"s have a 1% chance to drop Iridium Ore, and a 1% chance of dropping a second one."]],[1,["Breaking ",["l","矿井","crates and barrels"]," in the ",["l","矿井","dangerous Mines"]," and ",["l","火山地牢","Volcano Dungeon"],"."]],[1,["Catching regular and golden ",["l","钓鱼","Fishing Treasure Chests"],"."]],[1,["A ",["l","大海参","Super Cucumber"]," ",["l","鱼塘","Fish Pond"]," may produce 1-3 Iridium Ore when the population of the pond reaches 9."]],[1,[["l","淘盘","Panning"]," in any area."]],[1,["A fallen ",["l","随机事件","meteorite"]," on ",["l","农场","the Farm"]," will drop 10 Iridium Ore when mined."]],[1,["The ",["l","旅行货车","Traveling Cart"]," will occasionally sell it for 300–1,000g."]],[1,["The ",["l","完美雕像","Statue Of Perfection"],", which can be obtained after getting four candles during ",["l","爷爷","Grandpa's Evaluation"],", gives the player 2-8 Iridium Ore per day."]]]]]],["Smelting",2,[["p",["Iridium Ore can be smelted in a ",["l","熔炉","Furnace"]," to create an ",["l","铱锭","Iridium Bar"],". The smelting requires 5 Iridium Ore and 1 ",["l","煤炭","Coal"]," and takes 8 in-game hours."]]]],["Crafting",2,[["t",[[{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Ingredients"]},{"h":1,"v":["Recipe Source"]}],[[["l","豪华稻草人","Deluxe Scarecrow"]],["Prevents crows from attacking your crops. Has a large radius (about 16 \"tiles\")."],[["i","(O)388","Wood ×50"],["i","(O)386","Iridium Ore ×1"],["i","(O)771","Fiber ×40"]],["Mail, after collecting all 8 ",["l","稻草人","Rarecrows"]]],[[["l","传送图腾：沙漠","Warp Totem: Desert"]],["Warp directly to Calico Desert. Consumed on use."],[["i","(O)709","Hardwood ×2"],["i","(O)88","Coconut ×1"],["i","(O)386","Iridium Ore ×4"]],[["l","沙漠商人","Desert Trader"]," for ",["i","(O)337","Iridium Bar ×10"]]]]]]],["Gifting",2,[["t",[[{"h":1,"v":["Neutral"]},[["l","克林特","Clint"]]],[{"h":1,"v":["Dislike"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","雷欧","Leo"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"]]],[{"h":1,"v":["Hate"]},[["l","山姆","Sam"]]]]]]],["Bundles",2,[["p",["One Iridium Ore is used in the engineers Bundle."]]]],["Tailoring",2,[["p",["Iridium Ore can be used in the spool of the ",["l","柳巷2号","Sewing Machine"]," to create the ",["l","裁缝","Iridium Energy Shirt"],". It can be used in ",["l","染色","dyeing"],", serving as a purple dye at the dye pots located in ",["l","艾米丽","Emily"],"'s and ",["l","海莉","Haley"],"'s house, ",["l","柳巷2号","2 Willow Lane"],". It can also be used as an iridium dye when used in the spool of the Sewing Machine with a dyeable clothing item in the feed."]]]],["Quests",2,[["l",0,[[1,["One Iridium Ore may be requested by ",["l","虹鳟鱼","Rainbow Trout"],", ",["l","幽灵鱼","Spook Fish"],", ",["l","大海参","Super Cucumber"],", or ",["l","虚空鲑鱼","Void Salmon"]," in a ",["l","鱼塘","Fish Pond quest"]," to increase the capacity of the pond from 7 to 10."]],[1,[["l","马龙","Marlon"]," may request the player to obtain 15 Iridium Ore in the ",["l","沙漠节","\"Treasure Hunt\" quest"]," during the ",["l","沙漠节","Desert Festival"],"."]]]]]],["Trading",2,[["p",["Five Iridium Ore can be traded to the ",["l","沙漠商人","Desert Trader"]," for 1 ",["l","超级炸弹","Mega Bomb"],"."]]]],["Notes",2,[["p",["When used with ",["l","武器","Slingshots"],", Iridium Ore deals more damage to monsters than any other ammunition."]]]]],"f":[["Source",[["l","采矿","Mining"]," • ",["l","岩浆晶球","Magma Geode"]," • ",["l","万象晶球","Omni Geode"]," • ",["l","金色椰子","Golden Coconut"]," • ",["l","怪物","Monster"]," drop • ",["l","钓鱼","Fishing Treasure Chests"]," • ",["l","大海参","Super Cucumber"]," ",["l","鱼塘","Fish Pond"]," • ",["l","淘盘","Panning"]," • ",["l","完美雕像","Statue Of Perfection"]]],["Sell Price",["100g"]]]}