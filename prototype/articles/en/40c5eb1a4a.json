{"s":[[null,1,[["p",["Fish Taco is a ",["l","烹饪","cooked dish"],". It is prepared using either the kitchen inside an upgraded ",["l","农舍","farmhouse"]," or a ",["l","野炊工具","Cookout Kit"],". It can also be found in ",["l","钓鱼#Golden Treasure Chests","Golden Fishing Treasure Chests"]," (7% chance)."]],["p",["It can randomly appear in ",["l","科罗布斯","Krobus"],"' shop on ",["l","周循环#Saturday","Saturdays"]," for 50g-500g, in ",["l","星之果实酒吧","the Stardrop Saloon"],"'s rotating stock for 1,000g, or at the ",["l","旅行货车","Traveling Cart"]," for 1,500–2,500g. It can also randomly be found in ",["l","垃圾桶","Garbage Can"],"s outside the saloon. One Fish Taco may be received from opening a ",["l","谜之盒","Mystery Box"],". The ",["l","无尽财富之雕像","Statue Of Endless Fortune"]," produces one Fish Taco per year on ",["l","卡洛琳","Caroline"],"'s birthday, ",["l","冬季","Winter 7"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Love"]},[["l","卡洛琳","Caroline"],", ",["l","格斯","Gus"]]],[{"h":1,"v":["Like"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"]]],[{"h":1,"v":["Dislike"]},[["l","科罗布斯","Krobus"],", ",["l","雷欧","Leo"]]],[{"h":1,"v":["Hate"]},[["l","艾米丽","Emily"]]]]]]],["Bundles",2,[["p",["Fish Taco is not used in any ",["l","收集包","bundles"],"."]]]],["Tailoring",2,[["p",["Fish Taco is used in the spool of the ",["l","柳巷2号#Sewing Machine",