{"s":[[null,1,[["p",["Crab Cakes are a ",["l","烹饪","cooked dish"],". They are prepared using either the kitchen inside an upgraded ",["l","农舍","farmhouse"]," or a ",["l","野炊工具","Cookout Kit"],"."]],["p",[["l","铱蟹","Iridium Crab"],"s in the ",["l","骷髅洞穴","Skull Cavern"]," may drop Crab Cakes when slain (50% chance). ",["l","格斯","Gus"]," will also sell an unlimited number of Crab Cakes at ",["l","星之果实酒吧","The Stardrop Saloon"]," for 550g each for approximately 4 days after viewing ",["l","威利","Willy"],"'s 6-heart cutscene. It is also sold by the ",["l","沙漠节","Calico Egg Merchant"]," in the ",["l","沙漠节","Desert Festival"]," for 10 Calico Eggs ",["l","卡利科三花蛋","Calico Egg"],"s. 5 Crab Cakes can be obtained as a prize from the ",["l","镇长的庄园","Prize Machine"],". One Crab Cakes may be received from opening a ",["l","谜之盒","Mystery Box"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Love"]},[["l","艾利欧特","Elliott"]]],[{"h":1,"v":["Like"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"]]],[{"h":1,"v":["Dislike"]},[["l","科罗布斯","Krobus"],", ",["l","雷欧","Leo"]]]]]]],["Bundles",2,[["p",["Crab Cakes are not used in any ",["l","收集包","bundles"],"."]]]],["Tailoring",2,[["p",["Crab Cakes are used in the spool of the ",["l","柳巷2号","Sewing Machine"]," to create the ",["l","裁缝","Crab Cake