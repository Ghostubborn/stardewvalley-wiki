{"s":[[null,1,[["p",["Life Elixir is an ",["l","打造#Edible Items","edible crafted item"],". The recipe is earned at ",["l","战斗","Combat"]," skill level 2. ",["l","蝙蝠","Iridium Bats"]," in the ",["l","骷髅洞穴","Skull Cavern"]," may drop a Life Elixir when slain (5% chance). The ",["l","矮人","Dwarf"]," sells Life Elixir for 2,000g each. Two to four Life Elixirs may occasionally be found in ",["l","骷髅洞穴#Treasure Rooms","treasure rooms"]," in the Skull Cavern. Two Life Elixirs may be received from opening a ",["l","谜之盒","Mystery Box"]," or ",["l","金色谜之盒","Golden Mystery Box"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Like"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"]]],[{"h":1,"v":["Dislike"]},[["l","威利","Willy"],", ",["l","科罗布斯","Krobus"],", ",["l","雷欧","Leo"]]]]]]],["Tailoring",2,[["p",["Life Elixir can be used in the spool of the ",["l","柳巷2号#Sewing Machine","Sewing Machine"]," to create the dyeable ",["l","裁缝","Dark Highlight Shirt"],". ",["f","Shirt263a.png",24]," It can be used in ",["l","染色","dyeing"],", serving as a purple dye at the dye pots, located in ",["l","艾米丽","Emily"],"'s and ",["l","海莉","Haley"],"'s house, ",["l","柳巷2号","2 Willow Lane"],"."]]]],["Quests",2,[["p",["Life Elixir is not used in any ",["l","任务","quests"],"."]]]],["Trivia",2,[["l",0,[[1,["It is not profitable to make this item for sale, as the components would sell for more (635g total)."]]]]]],["History",2,[["l",0,[[1,[["l","版本历史#1.4","1.4"],": Can now be used in ",["l","裁缝","Tailoring"],"."]],[1,[["l","版本历史#1.6","1.6"],": Reduced sell price from 500g to 250g. Added as possible prize from ",["l","谜之盒","Mystery Box"],"es and ",["l","金色谜之盒","Golden Mystery Box"],"es."]],[1,[["l","版本历史#1.6.4","1.6.4"],": No longer restores energy when consuming. The tooltip now shows it restores \"100%\" health instead of 90 health and 200 energy."]]]]]]]}