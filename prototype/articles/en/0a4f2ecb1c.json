{"s":[[null,1,[["p",["Weight is a statistic that affects how far an enemy will be knocked back when attacked by ",["l","玩家角色","the player"]," with a ",["l","武器","weapon"],"."]],["p",["Each weapon type has a default weight: ",["l","武器","Daggers"]," have a weight of 5, ",["l","武器","swords"]," 10, and ",["l","武器","clubs"]," 15. Some weapons have a weight modifier, which is added to or subtracted from the default weight. ",["l","锻造","Forging"]," a weapon with ",["l","紫水晶","Amethyst"],"s will add +10 per amethyst to the weight."]],["p",[["l","紫水晶戒指","Amethyst Ring"],"s and ",["l","锻造","innate enchantments"]," affect the weight multiplicatively: the multiplier starts out as 1.0. Each Amethyst Ring adds 0.1 to the multiplier, while a \"-X Weight\" innate enchantment will subtract X/10 from the multiplier. The actual weight value is then the weapon's weight times this multiplier."]],["p",["This means 2 Amethyst rings increase the amount of knockback by 1.2x, while a maximum-level innate enchantment (-5 Weight) will halve the knockback amount."]]]],["Weapons",2,[["p",["The following weapons affect Weight. The effect is permanent while using the weapon."]],["t",[[{"h":1,"v":["Name"]},{"h":1,"v":["Effect"]}],[[["l","水晶匕首","Crystal Dagger"]],[["l","暴击力量","Crit. Power (+50)"],["l","重量","Weight (+5)"]]],[[["l","疾风利剑","Wind Spire"]],[["l","暴击力量","Crit. Power (+10)"],["l","重量","Weight (+5)"]]],[[["l","双刃大剑","Claymore"]],["Speed (−4)",["l","防御","Defense (+2)"],["l","重量","Weight (+3)"]]],[[["l","黑暗剑","Dark Sword"]],["Speed (−5)",["l","重量","Weight (+5)"]]],[[["l","骨剑","Bone Sword"]],["Speed (+4)",["l","重量","Weight (+2)"]]],[[["l","熔岩武士刀","Lava Katana"]],[["l","防御","Defense (+3)"],["l","暴击力量","Crit. Power (+25)"],["l","重量","Weight (+3)"]]],[[["l","木锤","Wood Mallet"]],["Speed (+2)",["l","重量","Weight (+3)"]]],[[["l","铁刃","Iron Edge"]],["Speed (−2)",["l","防御","Defense (+1)"],["l","重量","Weight (+3)"]]],[[["l","海王星大剑","Neptune's Glaive"]],["Speed (−1)",["l","防御","Defense (+2)"],["l","重量","Weight (+4)"]]],[[["l","银河匕首","Galaxy Dagger"]],["Speed (+1)",["l","重量","Weight (+5)"]]],[[["l","银河之锤","Galaxy Hammer"]],["Speed (+2)",["l","重量","Weight (+5)"]]],[[["l","骨化剑","Ossified Blade"]],["Speed (−2)",["l","防御","Defense (+1)"],["l","重量","Weight (+2)"]]],[[["l","淬火阔剑","Tempered Broadsword"]],["Speed (−3)",["l","防御","Defense (+3)"],["l","重量","Weight (+3)"]]],[[["l","矮人匕首","Dwarf Dagger"]],["Speed (+1)",["l","防御","Defense (+6)"],["l","暴击率","Crit. Chance (+2)"],["l","重量","Weight (+5)"]]],[[["l","龙牙小刀","Dragontooth Shiv"]],[["l","暴击率","Crit. Chance (+3)"],["l","暴击力量","Crit. Power (+100)"],["l","重量","Weight (+5)"]]],[[["l","无限匕首","Infinity Dagger"]],["Speed (+1)",["l","防御","Defense (+3)"],["l","暴击率","Crit. Chance (+4)"],["l","重量","Weight (+5)"]]],[[["l","长柄锤","Kudgel"]],["Speed (−1)",["l","暴击力量","Crit. Power (+4)"],["l","重量","Weight (+2)"]]],[[["l","矮人锤","Dwarf Hammer"]],[["l","防御","Defense (+2)"],["l","重量","Weight (+5)"]]],[[["l","龙牙棒","Dragontooth Club"]],[["l","暴击力量","Crit. Power (+50)"],["l","重量","Weight (+3)"]]],[[["l","无限之锤","Infinity Gavel"]],["Speed (+2)",["l","防御","Defense (+1)"],["l","重量","Weight (+5)"]]]]]]],["Rings",2,[["p",["The following rings increase Weight (knockback). The effect is permanent while the ring is equipped."]],["t",[[{"h":1,"v":["Name"]},{"h":1,"v":["Effect"]}],[[["l","紫水晶戒指","Amethyst Ring"]],["Increases knockback by 10%."]]]]]]]}