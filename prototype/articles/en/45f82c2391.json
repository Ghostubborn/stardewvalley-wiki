{"s":[[null,1,[["p",["The Raccoon Journal is a power ",["l","书","book"]," that can be obtained as the reward for the ",["l","大树桩（地点）","second request"]," from the Raccoon family at the Giant Stump. After fulfilling that request, 999 ",["l","纤维","Fiber"]," can be traded for one Raccoon Journal at the ",["l","大树桩（地点）","Raccoon Wife's Shop"],". It can also be purchased from the ",["l","书摊老板","Bookseller"]," for 20,000g starting in Year 3 (≈9% chance to appear)."]],["p",["The first reading grants the player a power that increases the chances to receive ",["l","混合种子","Mixed Seeds"]," or ",["l","混合花卉种子","Mixed Flower Seeds"]," from cutting ",["l","杂草","Weeds"]," by 4%. Once read, it can be found in ",["l","玩家角色","the Player"],"'s menu on the ",["l","特殊物品与能力","Special Items & Powers"]," tab. Each subsequent reading gives the player 100 ",["l","采集","Foraging"]," ",["l","技能","XP"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Love"]},[["l","潘妮","Penny"]]],[{"h":1,"v":["Like"]},[["l","艾利欧特","Elliott"]]],[{"h":1,"v":["Neutral"]},[["l","阿比盖尔","Abigail"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","乔迪","Jodi"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"],", ",["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","雷欧","Leo"],", ",["l","法师","Wizard"]]],[{"h":1,"v":["Dislike"]},[["l","亚历克斯","Alex"]]]]]]],["Bundles",2,[["p",["Raccoon Journal is not used in any ",["l","收集包","bundles"],"."]]]],["Tailoring",2,[["p",["Raccoon Journal is not used in any ",["l","裁缝","tailoring"],". It can be used in ",["l","染色","dyeing"],", serving as a green dye at the dye pots located in ",["l","艾米丽","Emily"],"'s and ",["l","海莉","Haley"],"'s house, ",["l","柳巷2号","2 Willow Lane"],". It can also be used as a green dye when used in the spool of the ",["l","缝纫机","Sewing Machine"]," with a dyeable clothing item in the feed."]]]],["Quests",2,[["p",["Raccoon Journal is not used in any ",["l","任务","quests"],"."]]]]],"f":[["Source",[["l","大树桩（地点）","Giant Stump"]," • ",["l","大树桩（地点）","Raccoon Wife's Shop"]," • ",["l","书摊老板","Bookseller"]]],["Sell Price",["1,000g"]]]}