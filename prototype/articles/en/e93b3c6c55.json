{"s":[[null,1,[["p",["An Earth Crystal is a type of ",["l","矿物","Mineral"],". It can be foraged in ",["l","矿井","The Mines"]," (especially floors 1 - 39), or obtained from ",["l","晶球","Geode"],"s and ",["l","万象晶球","Omni Geode"],"s, dropped from ",["l","掘地虫","Duggies"]," in the Mines (floors 1 - 29), dropped from ",["l","幽灵头骨","Haunted Skull"],"s, or from ",["l","淘盘","panning"],". It can also be found in ",["l","钓鱼","Fishing Treasure Chests"]," or in a ",["l","垃圾桶","Garbage Can"],"."]],["p",[["l","荒野石魔","Wilderness Golem"],"s and ",["l","铱石魔","Iridium Golem"],"s on the ",["l","农场地图","Wilderness Farm map"]," have a 0.5% chance of dropping an Earth Crystal when slain."]],["p",["Earth Crystals can be destroyed by ",["l","打造","bombs"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Like"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"],", ",["l","雷欧","Leo"]]],[{"h":1,"v":["Dislike"]},[["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"]]]]]]],["Bundles",2,[["p",["Earth Crystal is used in the Boiler Room."]]]],["Recipes",2,[["t",[[{"h":1,"v":["Image"]},{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Ingredients"]},{"h":1,"v":["Recipe Source"]}],[[["f","Mayonnaise_Machine.png",48]],[["l","蛋黄酱机","Mayonnaise Machine"]],["Turns eggs into mayonnaise."],[["i","(O)388"