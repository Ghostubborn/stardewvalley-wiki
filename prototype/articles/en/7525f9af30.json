{"s":[[null,1,[["p",["The Sunfish is a ",["l","鱼","fish"]," that can be caught in the river (in ",["l","鹈鹕镇","Pelican Town"]," or ",["l","煤矿森林","Cindersap Forest"],") during ",["l","春季","Spring"]," and ",["l","夏季","Summer"]," during sunny ",["l","天气","weather"],". It may also be caught on the ",["l","农场地图","Riverlands Farm"],", ",["l","农场地图","Forest Farm"],", or ",["l","农场地图","Hill-top Farm"],". It can also be gifted by a ",["l","动物","pet"]," cat with max ",["l","动物","friendship"],". It may also randomly be found at the ",["l","旅行货车","Traveling Cart"]," for 100–1,000g or in ",["l","垃圾桶","Garbage Can"],"s during ",["l","春季","Spring"]," and ",["l","夏季","Summer"],"."]],["p",["The Sunfish replaces any ineligible fish or non-fish items for the ",["l","鱼","tutorial catch"],". This can happen regardless of time, weather, season, or location."]],["p",["One Sunfish is contained in the ",["l","收集包","Community Center Fish Tank"]," right after it is repaired."]],["p",["Sunfish can be caught regardless of weather, time, or season using ",["l","魔法鱼饵","Magic Bait"],"."]]]],["Map",2,[["p",["Sunfish can be found in the river."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Neutral"]},[["l","德米特里厄斯","Demetrius"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","潘姆","Pam"],", ",["l","艾利欧特","Elliott"],", ",["l","威利","Willy"],", ",["l","雷欧","Leo"]]],[{"h":1,"v":["Dislike"]},[["l","罗宾","Robin"],", ",["l","玛鲁","Maru"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","艾米丽","Emily"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","科罗布斯","Krobus"]]],[{"h":1,"v":["Hate"]},[["l","皮