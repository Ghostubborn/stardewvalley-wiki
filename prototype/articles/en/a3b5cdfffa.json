{"s":[[null,1,[["p",["The Book Of Stars is a skill ",["l","书","book"]," that can be purchased from the ",["l","书摊老板","Bookseller"]," for 15,000g (25% chance to appear). It is also a possible reward for quests beyond the 5th one from the ",["l","大树桩（地点）","Raccoon"]," (20% chance). After the player has received one ",["l","谜之书","Book of Mysteries"],", the Book of Stars can be obtained randomly from opening ",["l","谜之盒","Mystery Box"],"es or ",["l","金色谜之盒","Golden Mystery Box"],"es."]],["p",["Upon reading the book, players will earn 250 ",["l","技能","XP"]," in all skills. If they have already reached Level 10 in all skills, they will instead earn 1,125 ",["l","技能","Mastery"]," points."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Love"]},[["l","潘妮","Penny"]]],[{"h":1,"v":["Like"]},[["l","艾利欧特","Elliott"]]],[{"h":1,"v":["Neutral"]},[["l","阿比盖尔","Abigail"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","乔迪","Jodi"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"],", ",["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","雷欧","Leo"],", ",["l","法师","Wizard"]]],[{"h":1,"v":["Dislike"]},[["l","亚历克斯","Alex"]]]]]]],["Bundles",2,[["p",["Book of Stars is not used in any ",["l","收集包","bundles"],"."]]]],["Tailoring",2,[["p",["Book of Stars is not used in any ",["l","裁缝","tailoring"],". It can be used in ",["l","染色","dyeing"],", serving as a purple dye at the dye pots located in ",["l","艾米丽","Emily"],"'s and ",["l","海莉","Haley"],"'s house, ",["l","柳巷2号","2 Willow Lane"],". It can also be used as an iridium dye when used in the spool of the ",["l","缝纫机","Sewing Machine"]," with a dyeable clothing item in the feed."]]]],["Quests",2,[["p",["Book of Stars is not used in any ",["l","任务","quests"],"."]]]],["Trading",2,[["p",["One Book of Stars can be traded to the ",["l","书摊老板","Bookseller"]," for 8 ",["l","仙尘","Fairy Dust"],"."]]]]],"f":[["Source",[["l","书摊老板","Bookseller"]," • ",["l","大树桩（地点）","Giant Stump"]," • ",["l","谜之盒","Mystery Box"],"es • ",["l","金色谜之盒","Golden Mystery Box"],"es"]],["Sell Price",["2,500g"]]]}