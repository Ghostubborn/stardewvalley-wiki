{"s":[[null,1,[["p",["Maple Bar is a ",["l","烹饪","cooked dish"],". It is prepared using either the kitchen inside an upgraded ",["l","农舍","farmhouse"]," or a ",["l","野炊工具","Cookout Kit"],". It may rotate into stock at the ",["l","旅行货车","Traveling Cart"]," and is sold for 900–1,500g. It can be purchased from ",["l","山姆","Sam"],"'s ",["l","沙漠节","shop"]," at the ",["l","沙漠节","Desert Festival"]," for 20 Calico Eggs ",["l","卡利科三花蛋","Calico Egg"],"s. One Maple Bar may be received from opening a ",["l","谜之盒","Mystery Box"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Love"]},[["l","山姆","Sam"]]],[{"h":1,"v":["Like"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"]]],[{"h":1,"v":["Dislike"]},[["l","威利","Willy"],", ",["l","科罗布斯","Krobus"],", ",["l","雷欧","Leo"]]]]]]],["Bundles",2,[["p",["Maple Bar is not used in any ",["l","收集包","bundles"],"."]]]],["Tailoring",2,[["p",["Maple Bar is used in the spool of the ",["l","柳巷2号","Sewing Machine"]," to create the ",["l","裁缝","Dirt Shirt"],". ",["f","Shirt275.png",24]," It can be used in ",["l","染色","dyeing"],", serving as an orange dye at the dye pots, located in ",["l","艾米丽","Emily"],"'s and ",["l","海莉","Haley"],"'s house, ",["l","柳巷2号","2 Willow Lane"],"."]]]],["Quests",2,[["p",["Maple Bar is not used in any ",["l","任务","quests"],"."]]]]]}