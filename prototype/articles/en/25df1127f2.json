{"s":[[null,1,[["p",["Wool is an animal product obtained from a ",["l","兔子","Rabbit"]," or ",["l","绵羊","Sheep"],". It can also be available at the ",["l","旅行货车","Traveling Cart"]," for 1,020–1,700g. ",["l","艾米丽","Emily"]," may also send you one Wool in the mail as a gift. Wool sells for a base price of 340g."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Love"]},[["l","艾米丽","Emily"]]],[{"h":1,"v":["Like"]},[["l","桑迪","Sandy"]]],[{"h":1,"v":["Neutral"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","雷欧","Leo"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘姆","Pam"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"]]],[{"h":1,"v":["Dislike"]},[["l","潘妮","Penny"]]]]]]],["Bundles",2,[["p",["Wool is one of the options for the Pantry."]]]],["Artisan Goods",2,[["p",["See also: ",["l","加工动物制品的收益","Animal Products Profitability"]]],["p",["Placing quality ",["l","动物毛","Wool"]," into a ",["l","织布机","Loom"]," gives a higher chance to produce 2 Cloth. Silver gives a 10% chance, gold gives a 50% chance, and iridium gives a 100% chance."]],["t",[[{"h":1,"v":["Image"]},{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Equipment"]},{"h":1,"v":["Time"]},{"h":1,"v":["Sell Price"]}],[[["f","Cloth.png",48]],[["l","布料","Cloth"]],["A bolt of fine wool cloth."],[["f","Loom.png",40],["l","织布机","Loom"]],["4 Hours"],["470g"]]]]]],["Recipes",2,[["p",["Wool is not used in any recipes."]]]],["Tail