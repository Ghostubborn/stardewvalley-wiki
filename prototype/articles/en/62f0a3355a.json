{"s":[[null,1,[["p",["The Warp Totem: Island is a ",["l","传送图腾","Warp Totem"]," that transports the player to ",["l","姜岛","Ginger Island"]," by selecting it in inventory and right-clicking. It can be ",["l","打造","crafted"]," after purchasing the recipe from the ",["l","火山地牢#Shop","Volcano Dwarf"]," for 10,000g. One is obtained after repairing the ",["l","农场图腾柱","Farm Obelisk"]," on ",["l","姜岛","Ginger Island"],"."]]]],["Destination",2,[["g",[["Warp_Totem_Island_location.png",400,[]]]]]],["Gifting",2,[["t",[[{"h":1,"v":["Hate"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"],", ",["l","雷欧","Leo"]]]]]]],["Bundles",2,[["p",["The Warp Totem: Island is not used in any ",["l","收集包","bundles"],"."]]]],["Tailoring",2,[["p",["The Warp Totem: Island can be used in the spool of the ",["l","柳巷2号#Sewing Machine","Sewing Machine"]," to create the ",["i","(H)44","Totem Mask"],". It can be used in ",["l","染色","dyeing"],", serving as an orange dye at the dye pots, located in ",["l","艾米丽","Emily"],"'s and ",["l","海莉","Haley"],"'s house, ",["l","柳巷2号","2 Willow Lane"],"."]]]],["Quests",2,[["p",["The Warp Totem: Island is not used in any ",["l","任务","quests"],"."]]]],["History",2,[["l",0,[[1,[["l","版本历史#1.5","1.5"],": Introdu