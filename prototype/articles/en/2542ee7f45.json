{"s":[[null,1,[["p",["The Diamond Hunter is a power ",["l","书","book"]," that can be traded from the ",["l","火山地牢#Shop","Volcano Dwarf"]," in the ",["l","火山地牢","Volcano Dungeon"]," for 10 ",["l","钻石","Diamond"],"s."]],["p",["The first reading grants the player a power that makes all stones have a 0.66% chance to drop a diamond when mined with a ",["l","十字镐","pickaxe"],", with a 50% chance to drop double if the player has the ",["l","技能#Mining","Geologist"]," profession. These drops are not affected by ",["l","精通山洞#Masteries","Mining Mastery"],". Once read, it can be found in ",["l","玩家角色","the Player"],"'s menu on the ",["l","特殊物品与能力","Special Items & Powers"]," tab. Each subsequent reading gives the player 100 ",["l","采矿","Mining"]," ",["l","技能","XP"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Love"]},[["l","潘妮","Penny"]]],[{"h":1,"v":["Like"]},[["l","艾利欧特","Elliott"]]],[{"h":1,"v":["Neutral"]},[["l","阿比盖尔","Abigail"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","乔迪","Jodi"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"],", ",["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","雷欧","Leo"],", ",["l","法师","Wizard"]]],[{"h":1,"v":["Dislike"]},[["l","亚历克斯","Alex"]]]]]]],["Bundles",2,[["p",["The Diamond Hunter is not used in any ",["l","收集包","bundles"],"."]]]],["Tailoring",2,[["p",["The Diamond Hunter is not used in any ",["l","裁缝","tailoring"],". It can be used in ",["l","染色","dyeing"],", serving as a blue dye at the dye pots located in