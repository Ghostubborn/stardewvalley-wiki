{"s":[[null,1,[["p",["The Pine Cone is a seed that grows into a ",["l","松树","Pine Tree"],". It can be obtained by shaking/chopping down a ",["l","松树","Pine Tree"]," at ",["l","采集","Foraging"]," level 1, in ",["l","垃圾桶","Garbage Can"],"s, or by using an ",["l","斧头","Axe"]," or ",["l","十字镐","Pickaxe"]," to dig up a Pine Cone dropped by a fully grown ",["l","松树","Pine Tree"]," on ",["l","农场","The Farm"],". One to five Pine Cones may be produced in a ",["l","木跃鱼","Woodskip"]," ",["l","鱼塘","Fish Pond"]," when the population reaches 9."]],["p",["Pine Cones can be planted in tillable ground outside ",["l","农场","The Farm"],". The ground must be un-tilled to plant the seed."]],["p",["A pine cone has approximately a 20% chance to grow to the next stage each night during ",["l","春季","Spring"],", ",["l","夏季","Summer"],", or ",["l","秋季","Fall"],". There are 5 growth stages in total. The median time to maturity is about 18 days, with over 90% of seeds maturing in less than 32 growing days."]],["p",["The use of ",["l","树肥","Tree Fertilizer"]," guarantees growth by one stage each night, including during ",["l","冬季","Winter"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Dislike"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","雷欧","Leo"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"]]]]]]],["Bundles",2,[["p",["Pine Cone is not used in any ",["l","收集包","bundles"],"."]]]],["Recipes",2,[["t",[[{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Ingredients"]},{"h":1,"v":["Energy / Health"]},{"h":1,"v":["Recipe Source(s)"]},{"h":1,"v":["Sell Price"]}],[[["l","工作小食","Field Snack"]],["A quick snack to fuel the hungry forager."],[["i","(O)309","Acorn ×1"],["i","(O)310","Maple Seed ×1"],["i","(O)311","Pine Cone ×1"]],["Energy 45\nHealth 20"],[["l","采集","Foraging"]," Level 1"],["20g"],[],[["l","神秘树种","Mystic Tree Seed"]],["This can be planted to grow a special tree."],[["i","(O)309","Acorn ×5"],["i","(O)310","Maple Seed ×5"],["i","(O)311","Pine Cone ×5"],["i","(O)292","Mahogany Seed ×5"]],["N/A"],[["l","精通山洞","Foraging Mastery"]],["100g"]]]]]],["Tailoring",2,[["p",["Pine Cone can be used in the spool of the ",["l","柳巷2号","Sewing Machine"]," to create the ",["i","(H)53","Beanie"],". It can be used in ",["l","染色","dyeing"],", serving as an orange dye at the dye pots, located in ",["l","艾米丽","Emily"],"'s and ",["l","海莉","Haley"],"'s house, ",["l","柳巷2号","2 Willow Lane"],"."]]]],["Quests",2,[["p",["Three Pine Cones may be requested by several fish in ",["l","鱼塘","Fish Pond quests"],"."]]]],["Trading",2,[["p",["Once unlocked, the Raccoon's wife near the ",["l","大树桩（地点）","Giant Stump"]," will trade for Pine Cones."]],["t",[[{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Price"]},{"h":1,"v":["Requirements"]}],[[["l","霜瓜种子","Powdermelon Seeds"]],["This special melon grows in the winter. Takes 7 days to grow."],[["i","(O)311","Pine Cone ×2"]],["1st Request Completed"]]]]]]]}