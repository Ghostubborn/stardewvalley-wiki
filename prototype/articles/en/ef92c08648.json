{"s":[[null,1,[["p",["The Cookout Kit is a ",["l","打造","craftable item"]," that can be used to create a small cooking fire used for ",["l","烹饪","Cooking"]," outside of the player's ",["l","农舍","Farmhouse"],". Once placed, it can be destroyed using an ",["l","斧头","axe"],", ",["l","锄头","hoe"],", or ",["l","十字镐","pickaxe"],". Any Cookout Kits left overnight will disappear the next day."]],["p",["Two Cookout Kits are the reward for completing the Wild Medicine Bundle. If a player has already used the ",["l","金色核桃#Golden Joja Parrot","Golden Joja Parrot"],", then ",["l","蜗牛教授","Professor Snail"]," will give one Cookout Kit as a reward for donating the ",["l","青蛙木乃伊","Mummified Frog"]," to the ",["l","岛屿办事处","Island Field Office"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Hate"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","雷欧","Leo"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"]]]]]]],["Bundles",2,[["p",["Cookout Kit is not used in any ",["l","收集包","bundles"],"."]]]],["Tailoring",2,[["p",["Cookout Kit is not used in any ",["l","裁缝","tailoring"]," or ",["l","染色","dyeing"],"."]]]],["Quests",2,[["p",["Cookout Kit is not used in any ",["l","任务","quests"],"."]]]],["Gallery",2,[["g",[["Campfire_Cooker.png",48,["The Cookout Kit when placed"]]]]]],["H