{"s":[[null,1,[["p",["The Void Egg is an animal product obtained from a ",["l","虚空鸡","Void Chicken"],"."]],["p",["Initially, a Void Egg can be obtained through a ",["l","陨石#The Witch","random event"]," involving a witch. The random event can occur as long as ",["l","玩家角色","the player"]," owns a ",["l","鸡舍","Big or Deluxe Coop"]," that is not full. The witch will fly over the coop during the night and leave a Void Egg inside."]],["p",["A Void Egg can also be purchased from ",["l","科罗布斯","Krobus"]," for 5,000g. If the player is married to ",["l","谢恩","Shane"],", there is a chance he may present them with one as a gift on rainy days. A ",["l","虚空鲑鱼","Void Salmon"]," ",["l","鱼塘","Fish Pond"]," may produce a Void Egg when the population of the pond reaches 9."]],["p",["A Void Egg sells for a base of 65g. This is 15g more than a Small ",["l","蛋","Egg"],", but 30g less than a ",["l","大鸡蛋","Large Egg"],"."]],["p",["A Void Egg can hatch a ",["l","虚空鸡","Void Chicken"]," by placing it in a Big or Deluxe Coop's ",["l","孵化器","incubator"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Love"]},[["l","塞巴斯蒂安","Sebastian"],", ",["l","科罗布斯","Krobus"]]],[{"h":1,"v":["Dislike"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","雷欧","Leo"]]],[{"h":1,"v":["Hate"]},[["l","莉亚","Leah"]]]]]]],["Bundles",2,[["