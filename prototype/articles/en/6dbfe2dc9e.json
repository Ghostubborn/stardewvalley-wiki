{"s":[[null,1,[["p",["Mining is the ",["l","技能","skill"]," associated with breaking rocks, mainly in ",["l","矿井","the Mines"],". Larger or more valuable rocks and nodes take more hits, and in some cases, require a stronger ",["l","十字镐","Pickaxe"]," to break."]]]],["Mines Access",2,[["p",["During the first four days of the game, ",["l","矿井","the Mines"]," are closed due to a landslide caused by the ",["l","Joja超市","Joja Corporation"],". On ",["l","春季","Spring"]," 5 in the first year, a letter will be received in the mail saying that Joja Corp. has cleared the landslide, and then the Mines are unlocked."]]]],["Mining Skill",2,[["p",["Mining Skill is increased by breaking rocks, ",["l","淘盘","panning"],", or by reading ",["l","采矿月刊","Mining Monthly"]," or the ",["l","星之书","Book Of Stars"],". Each level adds +1 to ",["l","十字镐","Pickaxe"]," ",["l","技能#Proficiency","proficiency"],"."]],["p",["Mining skill points are awarded when rocks are destroyed -- it doesn't matter if this is done by ",["l","十字镐","Pickaxe"]," or ",["l","打造#Bombs","Bombs"],". Rocks destroyed by ",["l","怪物","Monsters"]," grant no XP."]],["t",[[{"h":1,"v":["Level 1"]},{"h":1,"v":["Level 2"]},{"h":1,"v":["Level 3"]},{"h":1,"v":["Level 4"]},{"c":2,"h":1,"v":["Level 5"]}],[["Crafting Recipes:"],["Crafting Recipes:"],["Cooking Recipes:"],["Crafting Recipes:"],{"c":2,"v":["Choose a Profession:"]}],[[["f","Cherry_Bomb.png",24]," ",["l","樱桃炸弹","Cherry Bomb"]],[["i","(BC)71","Staircase"]],[["f","Miner's_Treat.png",24]," ",["l","矿工特供","Miner's Treat"]],[["f","Glowstone_Ring.png",24]," ",["l","辉石戒指","Glowstone Ring"],"\n",["f","Iron_Bar.png",24]," ",["l","铁锭","Transmute (Fe)"]],[["f","Miner.png",24]," Miner\n+1 ore per ",["l","采矿#Mining Nodes","vein"],"."],[["f","Geologist.png",24]," Geologist\nChance for ",["l","矿物#Gems","gems"]," to appear in pairs.\n(50% chance per ",["l","采矿#Mining Nodes","mining node"],". Also applies to ",["l","矿物#Geodes","geodes"]," spawned from breaking rocks.)"]],[{"h":1,"v":["Level 6"]},{