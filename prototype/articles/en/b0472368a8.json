{"s":[[null,1,[["g",[["Artifact_tile.gif",130,["An ",["l","远古斑点","Artifact Spot"]]]]],["p",["For an index to the completed artifacts collection, see ",["l","收集品#Artifacts","Collections"],"."]],["p",["Artifacts are items found primarily by digging up ",["l","远古斑点","Artifact Spot"],"s, though they can be acquired in other ways. There are 42 artifacts in total, and one of each must be donated to the ",["l","博物馆","Museum"]," to complete its collection. Donating to the ",["l","博物馆","Museum"]," will yield rewards when donation milestones are reached, or when specific artifacts are donated."]]]],["Acquisition",2,[["p",["Artifacts can be acquired in the following ways:"]],["l",0,[[1,["Using the ",["l","锄头","Hoe"]," on an ",["l","远古斑点","Artifact Spot"],". Different parts of the map will produce different artifacts. Artifact Spots are much more common in ",["l","冬季","winter"],"."]],[1,["Using the ",["l","锄头","Hoe"]," on dirt in ",["l","矿井","The Mines"]," and the ",["l","骷髅洞穴","Skull Cavern"],"."]],[1,["Killing ",["l","怪物","Monsters"],"."]],[1,["Solving ",["l","秘密纸条","Secret Notes"],"."]],[1,["Breaking open ",["l","古物宝藏","Artifact Trove"],"s."]],[1,["Breaking open ",["l","晶球","Geode"],"s, ",["l","冰封晶球","Frozen Geode"],"s, ",["l","岩浆晶球","Magma Geode"],"s, and ",["l","万象晶球","Omni Geode"],"s."]],[1,[["l","钓鱼","Fishing"]," for treasure chests."]],[1,["Breaking ",["l","采矿#Bone Node","Bone Nodes"],"."]]]],["p",["The table below lists specific locations for each artifact."]]]],["Use",2,[["p",["All artifacts can be used for:"]],["l",0,[[1,["Donation to the museum"]],[1,["Gifting to ",["l","潘妮","Penny"]," and the ",["l","矮人","Dwarf"]," as liked gifts"]],[1,[["l","裁缝","Tailoring"]," at a ",["l","缝纫机","Sewing Machine"]]]]],["p",["Some artifacts have other specific uses:"]],["l",0,[[1,[["l","锚","Anchor"]," and ",["l","古剑","Ancient Sword"]," can be used in ",["l","鱼缸","Fish Tanks"]," as decoration."]],[1,[["l","古代玩偶","Ancient Doll"]," is an option for the Children's Bundle. It is a loved gift for ",["l","贾斯","Jas"],". It can be used to obtain a ",["l","彩蛋#Meowmere","secret item"],"."]],[1,[["l","古代种子","Ancient Seed"]," may be ",["l","打造","crafted"]," into a plantable ",["l","上古种子","Ancient Seeds"]," pack after one is donated to the museum."]],[1,[["l","古剑","Ancient Sword"]," and ",["l","骨笛","Bone Flute"]," are liked gifts for ",["l","阿比盖尔","Abigail"],"."]],[1,[["l","恐龙蛋","Dinosaur Egg"]," may be used to hatch a ",["l","恐龙","Dinosaur"]," in an ",["l","孵化器","Incubator"]," or turned into ",["l","恐龙蛋黄酱","Dinosaur Mayonnaise"],". It is a liked gift for ",["l","亚历克斯","Alex"]," and ",["l","德米特里厄斯","Demetrius"],"."]],[1,[["l","矮人小工具","Dwarf Gadget"]," is required to craft the ",["l","农场电脑","Farm Computer"],". It is a loved gift for ",["l","玛鲁","Maru"],"."]],[1,[["l","矮人卷轴 I","Dwarf Scroll I"],", ",["l","矮人卷轴 II","Dwarf Scroll II"],", ",["l","矮人卷轴 III","Dwarf Scroll III"],", ",["l","干海星","Dried Starfish"],", and ",["l","黄金遗物","Golden Relic"]," may be required for some ",["l","鱼塘#Quests","Fish Pond quests"],"."]],[1,[["l","生锈的汤匙","Rusty Spoon"]," may be requested by the ",["l","大树桩（地点）","Raccoon"],"."]],[1,[["l","诡异玩偶（绿）","Strange Doll (green)"]," and ",["l","诡异玩偶（黄）","Strange Doll (yellow)"]," are loved gifts for ",["l","贾斯","Jas"],"."]],[1,[["l","骨笛","Bone Flute"]," and all fossil (including ",["l","三叶虫","Trilobite"],"), prehistoric (excluding ",["l","史前手斧","Prehistoric Handaxe"]," and ",["l","史前工具","Prehistoric Tool"],"), and skeletal artifacts may be processed in the ",["l","碎骨机","Bone Mill"]," to obtain ",["l","肥料","Fertilizer"],"."]]]]]],["Donation",3,[["p",["Donating the following artifacts grant unique rewards:"]],["l",0,[[1,["Donating the ",["l","古代鼓","Ancient Drum"],", along with at least 2 other artifacts, rewards the player with a ",["l","鼓块","Drum Block"],"."]],[1,["Donating an ",["l","古代种子","Ancient Seed"]," rewards the player with an Ancient Seed crafting recipe and 1 Ancient Seeds pack, which can then be planted to harvest ",["l","上古水果","Ancient Fruit"],"."]],[1,["Donating the ",["l","骨笛","Bone Flute"],", along with at least 2 other artifacts, rewards the player with a ",["l","长笛块","Flute Block"],"."]],[1,["Donating the ",["l","鸡雕像","Chicken Statue"],", along with at least 4 other artifacts, rewards the player with a ",["l","鸡雕像（家具）","Chicken Statue furniture"]," item."]],[1,["Donating all four Dwarf Scrolls unlocks the ",["l","矮人语教程","Dwarvish Translation Guide"],", allowing the ability to speak to the ",["l","矮人","Dwarf"]," merchant in ",["l","矿井","the Mines"]," and in the ",["l","火山地牢","Volcano Dungeon"],"."]],[1,["Donating the prehistoric bone pieces rewards the player with the ",["l","树懒骨架","Sloth Skeleton"]," furniture pieces."]],[1,["Donating the ",["l","稀有圆盘","Rare Disc"]," and ",["l","矮人小工具","Dwarf Gadget"],", along with at least 9 other artifacts, rewards the player with the ",["l","《烧焦的祭品》","'Burnt Offering'"]," painting."]]]]]],["Artifacts",2,[["p",["Map regions specified under \"Location\" are places where the artifact can be found when digging up an ",["l","远古斑点","Artifact Spot"],", along with the chance per artifact spot of finding the artifact."]],["t",[[{"h":1,"v":["Image"]},{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Sell Price"]},{"h":1,"v":["Location"]}],[[["f","Dwarf_Scroll_I.png",48]],[["l","矮人卷轴 I","Dwarf Scroll I"]],["A yellowed scroll of parchment filled with dwarven script. This one's tied with a red bow."],["1g"],{"b":[["l",0,[[1,["Tilling in Mines/Skull Cavern (any floor) (0.16%)"]],[1,["Several monsters (0.5% each)"]]]]]}],[[["f","Dwarf_Scroll_II.png",48]],[["l","矮人卷轴 II","Dwarf Scroll II"]],["A yellowed scroll of parchment filled with dwarven script. This one's tied with a green ribbon."],["1g"],{"b":[["l",0,[[1,["Tilling in Mines (floor 1-39) (0.1%)"]],[1,[["l","幽灵","Ghost"]," drop (0.5%)"]],[1,["Frost Bat drop (0.5%)"]],[1,[["l","灰尘精灵","Dust Sprite"]," drop (0.5%)"]],[1,["Blue Slime drop (0.5%)"]]]]]}],[[["f","Dwarf_Scroll_III.png",48]],[["l","矮人卷轴 III","D