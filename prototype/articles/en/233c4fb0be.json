{"s":[[null,1,[["p",["Sunflower Seeds are a type of seed. Mature plants yield ",["l","向日葵","Sunflower"],"s and 0-2 Sunflower Seeds."]],["p",["They can be purchased at ",["l","皮埃尔的杂货店","Pierre's General Store"],", at ",["l","Joja超市","JojaMart"],", from the Magic Shop Boat at the ",["l","夜市","Night Market"]," on Winter 16 & 17, and occasionally from the ",["l","旅行货车","Traveling Cart"],". They can also be obtained by using the ",["l","种子生产器","Seed Maker"]," or by planting ",["l","混合花卉种子","Mixed Flower Seeds"],". Sunflower Seeds are the only seeds you can buy cheaper at ",["l","Joja超市","JojaMart"]," than at ",["l","皮埃尔的杂货店","Pierre's General Store"],"."]]]],["Stages",2,[["t",[[{"h":1,"v":["Stage 1"]},{"h":1,"v":["Stage 2"]},{"h":1,"v":["Stage 3"]},{"h":1,"v":["Stage 4"]},{"h":1,"v":["Harvest"]}],[[["f","Sunflower_Stage_1.png",50]],[["f","Sunflower_Stage_2.png",50]],[["f","Sunflower_Stage_3.png",50]],[["f","Sunflower_Stage_4.png",50]],[["f","Sunflower_Stage_5.png",50]]],[["1 Day"],["2 Days"],["3 Days"],["2 Days"],["Total: 8 Days"]]]]]],["Gifting",2,[["t",[[{"h":1,"v":["Dislike"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"],", ",["l","雷欧","Leo"]]]]]]],["Recipes",2,[["p",["Sunflower Seeds are not used in any recipes."]]]],["Artisan Goods",2,[["p",["Note that the game does not consider ",["l","油","Oil"]," to be an ",["l","工匠物品","Artisan Good"],", so it does not benefit from the ",["l","耕种","Artisan Profession"],"."]],["t",[[{"h":1,"v":["Image"]},{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Ingredients"]},{"h":1,"v":["Equipment"]},{"h":1,"v":["Time"]},{"h":1,"v":["Energy / Health"]},{"h":1,"v":["Sell Price"]}],[[["f","Oil.png",48]],[["l","油","Oil"]],["All purpose cooking oil."],[["i","(O)431","Sunflower Seeds ×1"]],[["f","Oil_Maker.png",48],["l","产油机","Oil Maker"]],["3200m (≈53.33h)"],["Energy 13Health 5"],["100g"]]]]]],["Bug",2,[["l",0,[[1,["When selling Sunflower Seeds to Pierre, seeds collected by harvesting Sunflowers or purchased from Pierre sell for 20g each. However, seeds purchased from JojaMart sell for 100g. Thus, if you purchase one seed from JojaMart, then add collected seeds to that stack in inventory, all the seeds will sell for 100g each."]],[2,["If you instead add the purchased seed to the stack of collected seeds (or seeds purchased from Pierre), all the seeds will sell for 20g each."]]]]]]]}