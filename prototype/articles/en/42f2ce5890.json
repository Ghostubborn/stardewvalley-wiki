laxy Sword"],"."],["75,000g"],["600g"]],[[["f","Sneakers.png",48]],[["l","运动鞋","Sneakers"]],["A little flimsy... but fashionable!"],[],["500g"],["50g"]],[[["f","Leather_Boots.png",48]],[["l","皮靴","Leather Boots"]],["The leather is very supple."],["Reach Floor 10 of ",["l","矿井","the Mines"],"."],["500g"],["100g"]],[[["f","Work_Boots.png",48]],[["l","工作靴","Work Boots"]],["Steel-toed for extra protection."],["Reach Floor 10 of ",["l","矿井","the Mines"],"."],["700g"],["100g"]],[[["f","Tundra_Boots.png",48]],[["l","冻土靴","Tundra Boots"]],["The fuzzy lining keeps your ankles so warm."],["Reach Floor 50 of ",["l","矿井","the Mines"],"."],["750g"],["150g"]],[[["f","Combat_Boots.png",48]],[["l","战靴","Combat Boots"]],["Reinforced with iron mesh."],["Reach Floor 40 of ",["l","矿井","the Mines"],"."],["1,250g"],["150g"]],[[["f","Firewalker_Boots.png",48]],[["l","蹈火者靴","Firewalker Boots"]],["It's said these can withstand the hottest magma."],["Reach Floor 80 of ",["l","矿井","the Mines"],"."],["2,000g"],["300g"]],[[["f","Dark_Boots.png",48]],[["l","黑暗之靴","Dark Boots"]],["Made from thick black leather."],["Reach Floor 80 of ",["l","矿井","the Mines"],"."],["2,500g"],["300g"]],[[["f","Space_Boots.png",48]],[["l","太空之靴","Space Boots"]],["An iridium weave gives them a purple sheen."],["Reach Floor 110 of ",["l","矿井","the Mines"],"."],["5,000g"],["400g"]],[[["f","Amethyst_Ring.png",48]],[["l","紫水晶戒指","Amethyst Ring"]],["Increases knockback by 10%."],[],["1,000g"],["100g"]],[[["f","Topaz_Ring.png",48]],[["l","黄水晶戒指","Topaz Ring"]],["You feel a little bit safer wearing this."],[],["1,000g"],["100g"]],[[["f","Aquamarine_Ring.png",48]],[["l","海蓝宝石戒指","Aquamarine Ring"]],["Increases critical strike chance by 10%."],["Reach Floor 40 of ",["l","矿井","the Mines"],"."],["2,500g"],["200g"]],[[["f","Jade_Ring.png",48]],[["l","翡翠戒指","Jade Ring"]],["Increases critical strike power by 10%."],["Reach Floor 40 of ",["l","矿井","the Mines"],"."],["2,500g"],["200g"]],[[["f","Emerald_Ring.png",48]],[["l","绿宝石戒指","Emerald Ring"]],["Increases weapon speed by 10%."],["Reach Floor 80 of ",["l","矿井","the Mines"],"."],["5,000g"],["300g"]],[[["f","Ruby_Ring.png",48]],[["l","红宝石戒指","Ruby Ring"]],["Increases attack by 10%."],["Reach Floor 80 of ",["l","矿井","the Mines"],"."],["5,000g"],["300g"]],[[["f","Slingshot.png",48]],[["l","弹弓","Slingshot"]],["Requires stones for ammo."],["Reach Floor 40 of ",["l","矿井","the Mines"],"."],["500g"],["N/A"]],[[["f","Master_Slingshot.png",48]],[["l","高级弹弓","Master Slingshot"]],["Requires stones for ammo."],["Reach Floor 70 of ",["l","矿井","the Mines"],"."],["1,000g"],["N/A"]],[[["f","Explosive_Ammo.png",48]],[["l","爆炸弹丸","Explosive Ammo"]],["Fire this with the slingshot."],["Unlock the recipe for ",["l","爆炸弹丸","Explosive Ammo"],"."],["300g"],["20g"]],[[["f","Wall_Sword.png",24]],[["l","挂剑","Wall Sword"]],["Can be placed inside your house."],[],["2,000g"],["N/A"]],[[["f","Decorative_Sword.png",48]],[["l","装饰剑","Decorative Sword"]],["Can be placed as decoration."],[],["10,000g"],["N/A"]],[[["f","Slime_Charmer_Ring.png",48]],[["l","史莱姆克星戒指","Slime Charmer Ring"]],["Prevents damage from slimes."],["Kill 1000 ",["l","史莱姆","Slimes"]],["25,000g"],["350g"]],[[["f","Savage_Ring.png",48]],[["l","野蛮人戒指","Savage Ring"]],["Gain a short speed boost whenever you slay a monster."],["Kill 150 Void Spirits (",["l","暗影萨满","Shadow Shaman"]," / ",["l","暗影狂徒","Shadow Brute"],")"],["25,000g"],["750g"]],[[["f","Burglar's_Ring.png",48]],[["l","窃贼戒指","Burglar's Ring"]],["Monsters have a greater chance of dropping loot."],["Kill 500 ",["l","灰尘精灵","Dust Sprite"],"s"],["20,000g"],["750g"]],[[["f","Vampire_Ring.png",48]],[["l","吸血戒指","Vampire Ring"]],["Gain a little health every time you slay a monster."],["Kill 200 ",["l","蝙蝠","Bats"]],["15,000g"],["750g"]],[[["f","Crabshell_Ring.png",48]],[["l","蟹壳戒指","Crabshell Ring"]],["The top of the ring is made from enchanted crab shell."],["Kill 60 ",["l","岩石蟹","Rock Crab"],"s"],["15,000g"],["1,000g"]],[[["f","Napalm_Ring.png",48]],[["l","燃烧弹戒指","Napalm Ring"]],["When you defeat an enemy, they explode."],["Kill 250 ",["l","飞蛇","Serpent"],"s"],["30,000g"],["1,000g"]],[[["f","Skeleton_Mask.png",54]],[["l","骷髅面具","Skeleton Mask"]],["The red eyes are glowing mysteriously."],["Kill 50 ",["l","骷髅","Skeleton"],"s"],["20,000g"],["N/A"]],[[["f","Hard_Hat.png",54]],[["l","安全帽","Hard Hat"]],["Keep your dome in one piece."],["Kill 30 ",["l","掘地虫","Duggies"]],["20,000g"],["N/A"]],[[["f","Arcane_Hat.png",54]],[["l","神秘帽","Arcane Hat"]],["The type of cowboy hat worn by a wizard."],["Kill 100 ",["l","木乃伊","Mummies"]],["20,000g"],["N/A"]],[[["f","Knight's_Helmet.png",54]],[["l","骑士头盔","Knight's Helmet"]],["It looks just like the real thing!"],["Kill 50 ",["l","霸王喷火龙","Pepper Rex"]],["20,000g"],["N/A"]],[[["f","Insect_Head.png",48]],[["l","昆虫头部","Insect Head"]],["Not very pleasant to wield."],["Kill 80 ",["l","苍蝇","Cave Insects"]],["10,000g"],["200g"]]]]]],["Item Recovery Service",2,[["p",["The player can lose items if they collapse due to low health in ",["l","矿井","the Mines"],", ",["l","采石场矿井","Quarry Mine"],", ",["l","骷髅洞穴","Skull Cavern"]," or ",["l","火山地牢","Volcano Dungeon"],". In that case they can speak to ",["l","马龙","Marlon"]," in the Adventurer's Guild to use the \"Item Recovery Service\", which will recover one of the lost items for a fee. The fee is equivalent to the sell price of the item or stack - recovering a non-saleable item is free. The item will be mailed to the player overnight. Only one item (or one stack) can be recovered; the rest are lost permanently after it's selected. The player can make their choice anytime until their next collapse due to low health, which will reset it to the new lost items."]],["p",["If the player has completed the Monster Eradication Goal of killing 150 Magma Sprites, they will receive Marlon's phone number. This allows the player to use the Item Recovery Service from a ",["l","电话","Telephone"],"."]],["p",["If a player has obtained the power from the ",["l","洞穴地图绘制法","Mapping Cave Systems"]," book, they will get a 50% discount on the recovery fee."]]]],["History",2,[["l",0,[[1,[["l","版本历史#1.1","1.1"],": Changed Monster Eradication Goal for cave insects from 150 to 125."]],[1,[["l","版本历史#1.4","1.4"],": Added Monster Eradication Goals for ",["l","岩石蟹","Rock Crab"],", ",["l","木乃伊","Mummy"],", ",["l","霸王喷火龙","Pepper Rex"],", and ",["l","飞蛇","Serpent"],". Added Item Recovery Service."]],[1,[["l","版本历史#1.4.1","1.4.1"],": Increased price of ",["l","爆炸弹丸","Explosive Ammo"]," from 100g to 300g. Unlocks once the player learns the crafting recipe instead of when they have a ",["l","武器#Slingshot","slingshot"]," weapon in inventory."]],[1,[["l","版本历史#1.5","1.5"],": Added ",["l","弹弓","Slingshot"]," and ",["l","高级弹弓","Master Slingshot"]," to shop inventory. Fixed bug where Iridium Bats were not counted towards the relevant Monster Eradication Goal. Added Monster Eradication Goal for ",["l","熔岩精灵","Magma Sprite"],"."]],[1,[["l","版本历史#1.6","1.6"],": Changed open hours from 2pm-10pm to 2pm-2am. Changed Monster Eradication Goal for cave insects from 125 to 80. Added wall and decorative swords to shop inventory. Reading ",["l","洞穴地图绘制法","Mapping Cave Systems"]," will decrease the price to retrieve items."]],[1,[["l","版本历史#1.6.2","1.6.2"],": Now shows the Guild is open from 2pm-2am rather than 2pm-10pm."]],[1,[["l","版本历史#1.6.9","1.6.9"],": Added ",["l","生锈的剑","Rusty Sword"],", ",["l","股骨","Femur"],", ",["l","精灵之刃","Elf Blade"],", ",["l","钢制轻剑","Steel Smallsword"],", ",["l","水晶匕首","Crystal Dagger"],", ",["l","黑曜石之刃","Obsidian Edge"],", and ",["l","工作靴","Work Boots"]," to shop inventory."]]]]]]]}