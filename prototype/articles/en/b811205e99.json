{"s":[[null,1,[["p",["A Radioactive Bar is crafted by smelting 5 ",["l","放射性矿石","Radioactive Ore"]," and 1 ",["l","煤炭","Coal"]," in a ",["l","熔炉","Furnace"],"."]],["p",["A Radioactive Bar can be ",["l","售卖","shipped"]," or sold to ",["l","克林特","Clint"]," at the ",["l","铁匠铺","Blacksmith"]," Shop for 3,000g (4,500g with the ",["l","采矿#Mining Skill","Blacksmith profession"],")."]],["p",["10 Radioactive Bars can be traded to the ",["l","姜岛商人","Island Trader"]," for one ",["l","银河之魂","Galaxy Soul"]," on the last day of a season after killing at least 50 ",["l","怪物#Dangerous Monsters","dangerous monsters"],"."]]]],["Crafting",2,[["t",[[{"h":1,"v":["Image"]},{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Ingredients"]},{"h":1,"v":["Recipe Source"]}],[[["f","Heavy_Tapper.png",48]],[["l","重型树液采集器","Heavy Tapper"]],["Place on a maple, oak, or pine tree and wait for the reservoir to fill with product! Works twice as fast as a normal tapper."],[["i","(O)910","Radioactive Bar ×1"],["i","(O)709","Hardwood ×30"]],[["l","齐先生的核桃房","Qi's Walnut Room"]," for 20 Qi Gems"]],[[["f","Hopper.png",48]],[["l","加料器","Hopper"]],["Items placed inside will automatically be loaded into the machine in front of it."],[["i","(O)910","Radioactive Bar ×1"],["i","(O)709","Hardwood ×10"],["i","(O)337","Iridium Bar ×1"]],[["l","齐先生的核桃房","Qi's Walnut Room"]," for 50 Qi Gems"]]]]]],["Gifting",2,[["t",[[{"h":1,"v":["Love"]},[["l","玛鲁","Maru"]]],[{"h":1,"v":["Hate"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l