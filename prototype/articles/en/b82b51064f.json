{"s":[[null,1,[["p",["Vegetable Medley (also called \"Vegetable Stew\" in the Cooking interface) is a ",["l","烹饪","cooked dish"],". It is prepared using either the kitchen inside an upgraded ",["l","农舍","farmhouse"]," or a ",["l","野炊工具","Cookout Kit"],"."]],["p",["Vegetable Medley may randomly appear in ",["l","科罗布斯","Krobus"],"' shop on ",["l","周循环","Saturdays"],", in the ",["l","垃圾桶","Garbage Can"]," outside the saloon, or in ",["l","星之果实酒吧","the Stardrop Saloon"],"'s rotating stock. One Vegetable Medley may be received from opening a ",["l","谜之盒","Mystery Box"],". The ",["l","无尽财富之雕像","Statue Of Endless Fortune"]," produces one Vegetable Medley per year on ",["l","刘易斯","Lewis"],"' birthday, ",["l","春季","Spring 7"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Love"]},[["l","刘易斯","Lewis"],", ",["l","乔迪","Jodi"],", ",["l","莉亚","Leah"]]],[{"h":1,"v":["Like"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"]]],[{"h":1,"v":["Dislike"]},[["l","威利","Willy"],", ",["l","科罗布斯","Krobus"],", ",["l","雷欧","Leo"]]]]]]],["Bundles",2,[["p",["Vegetable Medley is not used in any ",["l","收集包","bundles"],"."]]]],["Recipes",2,[["p",["Vegetable Medley is not used in any recipes."]]]],["Tailoring",2,[["p",["Vegetable Medley is used in the spool of the ",["l","柳巷2号","Sewing Machine"]," with ",["l","布料","Cloth"]," in the feed to create a ",["l","裁缝","Mayoral Suspenders"],". It is a green dye when used in the spool of the Sewing Machine with a dyeable clothing item in the feed. It can be placed in the green dye pot at Emily's and Haley's house for use in ",["l","染色","dyeing"],"."]]]],["Quests",2,[["p",["Vegetable Medley is not used in any ",["l","任务","quests"],"."]]]]]}