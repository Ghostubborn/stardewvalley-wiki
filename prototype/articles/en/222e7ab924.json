{"s":[[null,1,[["p",["The Mushroom Tree Seed is a seed that grows into a ",["l","蘑菇树","Mushroom Tree"],". It's purchasable from ",["l","齐先生","Mr. Qi"],"'s shop in ",["l","齐先生的核桃房","Qi's Walnut Room"],", for 5 Qi Gems ",["l","齐钻","Qi Gems"],". They can also be obtained from the natural seed spread near a Mushroom Tree. They cannot be obtained by shaking Mushroom Trees."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Dislike"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","雷欧","Leo"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"]]]]]]],["Tailoring",2,[["p",["Mushroom Tree Seed can be used in the spool of the ",["l","柳巷2号#Sewing Machine","Sewing Machine"]," to create the ",["i","(H)87","Star Helmet"],". It can also serve as a red dye color in the sewing machine or dye pots, located at ",["l","艾米丽","Emily"],"'s and ",["l","海莉","Haley"],"'s house, ",["l","柳巷2号","2 Willow Lane"],"."]]]],["History",2,[["l",0,[[1,[["l","版本历史#1.5","1.5"],": Introduced."]],[1,[["l","版本历史#1.6","1.6"],": Can now be obtained from the natural seed spread near a ",["l","蘑菇树","Mushroom Tree"],"."]]]]]]]}