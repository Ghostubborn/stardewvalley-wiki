{"s":[[null,1,[["p",["Trout Soup is a ",["l","烹饪","cooked dish"],". It is prepared using either the kitchen inside an upgraded ",["l","农舍","farmhouse"]," or a ",["l","野炊工具","Cookout Kit"],"."]],["p",["It can be purchased at ",["l","鱼店","Willy's Fish Shop"]," for 250g and can randomly appear in ",["l","科罗布斯","Krobus"],"' shop on ",["l","周循环#Saturday","Saturdays"]," for 50g-500g, in ",["l","星之果实酒吧","The Stardrop Saloon"],"'s rotating stock for 200g, or at the ",["l","旅行货车","Traveling Cart"]," for 300–1,000g. It can also randomly be found in the ",["l","垃圾桶","Garbage Can"]," outside the saloon. One Trout Soup may be received from opening a ",["l","谜之盒","Mystery Box"],"."]],["p",["Note: this recipe is ",["l","烹饪#Profitable Recipes","profitable"]," without the ",["l","技能#Fishing","Angler profession"]," - as then it will always result in profit when using the lowest quality ingredients."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Like"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"]]],[{"h":1,"v":["Dislike"]},[["l","科罗布斯","Krobus"],", ",["l","雷欧","Leo"]]],[{"h":1,"v":["Hate"]},[["l","艾芙琳","Evelyn"]]]]]]],["Bundles",2,[["p",["Trout Soup is not used in any ",["l","收集包","bundles"],"."]]]],["Recipes",2,[["p",["Trout Soup is not used in any recipes."]]]],["Tailoring",2,[["p",["Trout Soup is used in the spool of the ",["l","柳巷2号#Sewing Machine","Sewing Machine"]," to create the ",["l","裁缝","Ranger Uniform"],". ",["f","Shirt241.png",24]," It can be used in ",["l","染色","dyeing"],", serving as an orange dye at the dye pots, located in ",["l","艾米丽","Emily"],"'s and ",["l","海莉","Haley"],"'s house, ",["l","柳巷2号","2 Willow Lane"],"."]]]],["Quests",2,[["p",["Trout Soup is not used in any ",["l","任务","quests"],"."]]]],["History",2,[["l",0,[[1,[["l","版本历史#1.4","1.4"],": Can now be used in ",["l","裁缝","Tailoring"],"."]],[1,[["l","版本历史#1.5","1.5"],": Can now be prepared using a ",["l","野炊工具","Cookout Kit"],"."]]]]]]]}