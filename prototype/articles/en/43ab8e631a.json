{"s":[[null,1,[["p",["Jade is a ",["l","矿物","Mineral"]," that can be found in ",["l","采矿","Jade Node"],"s and ",["l","采矿","Gem Node"],"s in ",["l","矿井","the Mines"]," (floors 40+), destroying barrels and crates (floors 40+), dropped by Blue ",["l","史莱姆（怪物）","Slimes"]," and ",["l","矮人哨兵","Dwarvish Sentries"],", in ",["l","钓鱼","Fishing Treasure Chests"],", or received as a gift at the ",["l","冬日星盛宴","Feast of the Winter Star"],". Jade may also occasionally be found in a ",["l","垃圾桶","Garbage Can"]," after the player has reached the bottom of the mines."]],["p",["The ",["l","沙漠商人","Desert Trader"]," in the ",["l","沙漠","Calico Desert"]," will trade one ",["l","楼梯","Staircase"]," in exchange for one Jade on ",["l","周循环","Sunday"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Love"]},[["l","克林特","Clint"],", ",["l","艾米丽","Emily"],", ",["l","矮人","Dwarf"]]],[{"h":1,"v":["Like"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"],", ",["l","雷欧","Leo"]]],[{"h":1,"v":["Dislike"]},[["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","莉亚","Leah"]]]]]]],["Bundles",2,[["p",["Jade is not used in any ",["l","收集包","bundles"],"."]]]],["Forging",2,[["p",["Jade can be used at the ",["l","锻造","Forge"]," to increase the critical hit damage of a melee weapon."]]]],["Recipes",2,[["p",["Jade is not used in any recipes."]]]],["Tailoring",2,[["p",["Jade is used in the spool of the ",["l","柳巷2号","Sewing Machine"]," to create a ",["l","裁缝","Shirt"],". It can be used in ",["l","染色","dyeing"],", serving as a green dye at the dye pots, located in ",["l","艾米丽","Emily"],"'s and ",["l","海莉","Haley"],"'s house, ",["l","柳巷2号","2 Willow Lane"],"."]]]],["Quests",2,[["l",0,[[1,["Jade may be randomly requested during any season at the ",["l","任务","\"Help Wanted\" board"]," outside ",["l","皮埃尔的杂货店","Pierre's General Store"]," for a reward of 600g and 150 ",["l","友谊","Friendship"]," points. Jade will never be requested until you have reached floors 40+ of ",["l","矿井","The Mines"],"."]],[1,["Two Jade may be requested by several fish in ",["l","鱼塘","Fish Pond quests"],"."]],[1,["Jade will be requested by ",["l","艾米丽","Emily"]," as part of the \"Rock Rejuvenation\" quest at the ",["l","任务","Special Orders"]," board outside Mayor ",["l","刘易斯","Lewis"],"' house."]]]]]]]}