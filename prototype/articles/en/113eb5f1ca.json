{"s":[[null,1,[["p",["Quartz is a ",["l","矿物","Mineral"]," that can be found by foraging in ",["l","矿井","The Mines"]," or ",["l","采石场矿井","Quarry Mine"]," and in ",["l","骷髅洞穴","Skull Cavern"],". It can also occasionally be found in ",["l","垃圾桶","Garbage Can"],"s. ",["l","石魔","Stone Golem"],"s have a 10% chance to drop Quartz when slain. A ",["l","鬼鱼","Ghostfish"]," ",["l","鱼塘","Fish Pond"]," may produce 1 Quartz when the population reaches 3, and 3 Quartz when the population reaches 9."]],["p",["Quartz can be destroyed by ",["l","打造","bombs"],"."]],["p",["Quartz can be used along with 1 ",["l","煤炭","coal"]," in a ",["l","熔炉","furnace"]," to produce ",["l","精炼石英","Refined Quartz"],", taking 1.5 in-game hours to smelt."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Like"]},[["l","罗宾","Robin"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","阿比盖尔","Abigail"],", ",["l","艾米丽","Emily"],", ",["l","玛妮","Marnie"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","雷欧","Leo"],", ",["l","科罗布斯","Krobus"]]],[{"h":1,"v":["Dislike"]},[["l","德米特里厄斯","Demetrius"],", ",["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","艾芙琳","Evelyn"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"]]],[{"h":1,"v":["Hate"]},[["l","卡洛琳","Caroline"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","刘易斯","Lewis"],", ",["l","谢恩","Shane"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"]]]]]]],["Bundles",2,[["p",["Quartz is used in the Boiler Room."]]]],["Recipes",2,[["p",["Quartz is not used in any recipes."]]]],["Smelting",2,[["p",["To smelt Quartz, equip it and activate the ",["l","熔炉","furnace"]," while there is ",["l","煤炭","Coal"]," in inventory. One unit of Coal is required for each smelting operation, regardless of the material or duration."]],["t",[[{"h":1,"v":["Ingredients"]},{"h":1,"v":["Equipment"]},{"h":1,"v":["Smelting Time"]},{"h":1,"v":["Produces"]}],[[["i","(O)80","Quartz ×1"],["i","(O)382","Coal ×1"]],[["l","熔炉","Furnace"]],["1.5 hours"],[["i","(O)338","Refined Quartz ×1"]]]]]]],["Trading",2,[["p",["Five Quartz can be traded at the ",["l","沙漠商人","Desert Trader"]," in ",["l","沙漠","the Calico Desert"]," for one ",["l","炸弹","Bomb"],"."]]]],["Tailoring",2,[["p",["Quartz is used in the spool of the ",["l","柳巷2号","Sewing Machine"]," to create the ",["l","裁缝","Gray Vest"],"."]]]],["Quests",2,[["l",0,[[1,["Quartz may be randomly requested during any season at the ",["l","任务","\"Help Wanted\" board"]," outside ",["l","皮埃尔的杂货店","Pierre's General Store"]," for a reward of 75g and 150 ",["l","友谊","Friendship"]," points."]],[1,["5 Quartz are requested by ",["l","鬼鱼","Ghostfish"]," in a ",["l","鱼塘","Fish Pond quest"]," to increase the capacity of the pond from 1 to 3."]],[1,["5 Quartz may be requested by ",["l","螃蟹","Crab"],", ",["l","鸟蛤","Cockle"],", ",["l","龙虾","Lobster"],", ",["l","蚌","Mussel"],", ",["l","牡蛎","Oyster"],", or ",["l","虾","Shrimp"]," in a ",["l","鱼塘","Fish Pond quest"]," to increase the capacity of the pond from 5 to 7."]]]]]]]}