{"s":[[null,1,[["p",["Not to be confused with ",["i","(O)586","Nautilus Fossil"],"."]],["p",["The Nautilus Shell is found via ",["l","采集","foraging"]," at ",["l","沙滩","The Beach"]," in ",["l","冬季","Winter"],". The player may randomly receive one in the mail from ",["l","德米特里厄斯","Demetrius"],". It can also be received as a gift at the ",["l","冬日星盛宴","Feast of the Winter Star"],". It may also spawn on the ",["l","农场地图","Beach Farm"]," during any season. It may also be found foraging on levels 1-29 of ",["l","矿井","the Mines"]," while the ",["l","矿井","Shrine of Challenge"]," is enabled, or the ",["l","任务","Danger in The Deep"]," quest is active. It can also be gifted by a ",["l","动物","pet"]," turtle with max ",["l","动物","friendship"],", or randomly found at the ",["l","旅行货车","Traveling Cart"]," for 360–1,000g. One Nautilus Shell can be purchased from ",["l","德米特里厄斯","Demetrius"],"' ",["l","沙漠节","shop"]," at the ",["l","沙漠节","Desert Festival"]," for 50 Calico Eggs ",["l","卡利科三花蛋","Calico Egg"],"s."]],["p",["Several ",["l","蟹笼","Crab Pot"]," ",["l","鱼","fish"]," may produce a Nautilus Shell in a ",["l","鱼塘","Fish Pond"]," when the population of the pond reaches 9."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Like"]},[["l","雷欧","Leo"],", ",["l","艾芙琳","Evelyn"]]],[{"h":1,"v":["Neutral"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"]]],[{"h":1,"v":["Hate"]},[["l","哈维","Harvey"]]]]]]],["Bundles",2,[["p",["A Nautilus Shell is used in the Bulletin Board."]]]],["Recipes",2,[["p",["Nautilus Shell is not used in any recipes."]]]],["Tailoring",2,[["p",["The Nautilus Shell can be used in the spool of the ",["l","柳巷2号","Sewing Machine"]," to create the dyeable ",["f","Shirt139.png",24]," ",["l","裁缝","Strapped Top"],". It can be used in ",["l","染色","dyeing"],", serving as an orange dye at the dye pots, located in ",["l","艾米丽","Emily"],"'s and ",["l","海莉","Haley"],"'s house, ",["l","柳巷2号","2 Willow Lane"],"."]]]],["Quests",2,[["p",["One Nautilus Shell is requested by ",["l","鲟鱼","Sturgeon"]," in a ",["l","鱼塘","Fish Pond quest"]," to increase the capacity of the pond from 7 to 10."]]]]]}