{"s":[[null,1,[["p",["A Copper Bar is created by smelting 5 ",["l","铜矿石","Copper Ore"]," in a ",["l","熔炉","furnace"]," with 1 ",["l","煤炭","coal"]," for fuel. Smelting the copper in a furnace takes 30 in-game minutes. Copper Bar may occasionally be found in ",["l","垃圾桶","Garbage Can"],"s after receiving the ",["l","熔炉","Furnace"]," blueprints from ",["l","克林特","Clint"],". ",["l","暗影狂徒","Shadow Brute"],"s and ",["l","暗影萨满","Shadow Shaman"]," may also drop a Copper Bar when slain (4% chance)."]],["p",["Copper bars are used in a variety of ",["l","打造","crafting"]," recipes and are used to upgrade ",["l","工具","tools"],". They can be sold for 60g, or 90g with the ",["l","技能#Mining","Blacksmith Profession"],"."]]]],["Tool Upgrades",2,[["p",["Copper Bars are required for the first upgrade of tools."]],["t",[[{"h":1,"v":["Image"]},{"h":1,"v":["Name"]},{"h":1,"v":["Cost"]},{"h":1,"v":["Ingredients"]}],[[["f","Copper_Hoe.png",48]],[["l","锄头","Copper Hoe"]],["2,000g"],[["i","(O)334","Copper Bar ×5"]]],[[["f","Copper_Pickaxe.png",48]],[["l","十字镐","Copper Pickaxe"]],["2,000g"],[["i","(O)334","Copper Bar ×5"]]],[[["f","Copper_Axe.png",48]],[["l","斧头","Copper Axe"]],["2,000g"],[["i","(O)334","Copper Bar ×5"]]],[[["f","Copper_Watering_Can.png",48]],[["l","喷壶","Copper Watering Can"]],["2,000g"],[["i","(O)334","Copper Bar ×5"]]],[[["f","Trash_Can_Copper.png",48]],[["l","垃圾桶（工具）","Copper Trash Can"]],["1,000g"],[["i","(O)334","Copper Bar ×5"]]]]]]],["Crafting",2,[["p",["Copper Bars are used to make the following items:"]],["t",[[{"h":1,"v":["Image"]},{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Ingredients"]},{"h":1,"v":["Recipe Source"]}],[[["f","Charcoal_Kiln.png",48]],[["l","煤炭窑","Charcoal Kiln"]],["Turns 10 pieces of wood into one piece of coal."],[["i","(O)388","Wood ×20"],["i","(O)334","Copper Bar ×2"]],[["f","Foraging_Skill_Icon.png",24]," ",["l","采集","Foraging"]," Level 2"]],[[["f","Cheese_Press.png",48]],[["l","压酪机","Cheese Press"]],["Turns milk into cheese."]