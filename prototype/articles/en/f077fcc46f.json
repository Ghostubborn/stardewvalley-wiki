{"s":[[null,1,[["p",["Slime is a ",["l","怪物战利品","Monster Loot"]," item which is dropped by ",["l","史莱姆（怪物）","Slimes"],". Killing a single ",["l","史莱姆（怪物）","Slime"]," can drop up to two Slime. Slime can also be obtained from ",["l","史莱姆球","Slime Ball"],"s or purchased from ",["l","科罗布斯","Krobus"]," for 10g on ",["l","周循环","Mondays"]," (up to 50 per Monday). It may randomly appear in the ",["l","旅行货车","Traveling Cart"]," for 100–1,000g. A ",["l","史莱姆鱼","Slimejack"]," ",["l","鱼塘","Fish Pond"]," may also produce 10, 30, or 50 Slime daily when the population reaches 9."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Dislike"]},[["l","法师","Wizard"]]],[{"h":1,"v":["Hate"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","雷欧","Leo"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"]]]]]]],["Bundles",2,[["p",["99 Slime is one of the options for the Boiler Room."]]]],["Recipes",2,[["t",[[{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Ingredient"]},{"h":1,"v":["Equipment"]},{"h":1,"v":["Time"]},{"h":1,"v":["Sell Price"]}],[[["l","史莱姆蛋","Slime Egg"]],["Can be hatched in a slime incubator."],[["i","(O)766","Slime ×100"]],[["l","史莱姆压蛋器","Slime Egg-Press"]],["1200m (20h)"],{"b":[["t",[[["1,000g"]],[["1,750g"]],[["2,500g"]],[["5,000g"]]]]]}]]],["p",["The color of the resulting slim