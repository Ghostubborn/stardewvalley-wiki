{"s":[[null,1,[["p",["Sashimi is a ",["l","烹饪","cooked dish"],". It is prepared using either the kitchen inside an upgraded ",["l","农舍","farmhouse"]," or a ",["l","野炊工具","Cookout Kit"],"."]],["p",["Sashimi may randomly appear in ",["l","科罗布斯","Krobus"],"' shop on ",["l","周循环","Saturdays"],", in the ",["l","垃圾桶","Garbage Can"]," outside the saloon, or in ",["l","星之果实酒吧","the Stardrop Saloon"],"'s rotating stock. ",["l","莱纳斯","Linus"]," may randomly send one Sashimi in the mail as a gift. One Sashimi may be received from opening a ",["l","谜之盒","Mystery Box"],"."]],["p",["Note: This recipe can be ",["l","烹饪","profitable"]," if using ",["l","鱼","fish"]," worth less than 75g (see ",["l","鱼","When to turn fish into sashimi"]," for more info). Saving fish worth less than 75g for ",["l","任务","Help Wanted quests"]," may be a better option, though, since these quests generally pay triple the fish's base value. (",["l","玉黍螺","Periwinkle"]," is an exception -- at 20g base price it's more profitable to turn into Sashimi than save for quests)."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Love"]},[["l","塞巴斯蒂安","Sebastian"]]],[{"h":1,"v":["Like"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"]]],[{"h":1,"v":["Neutral"]},[["l","威利","Willy"]]],[{"h":1,"v":["Dislike"]},[["l","科罗布斯","Krobus"],", ",["l","雷欧","Leo"]]],[{"h":1,"v":["Hate"]},[["l","艾芙琳","Evelyn"],", ",["l","艾米丽","Emily"],