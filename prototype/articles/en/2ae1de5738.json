{"s":[[null,1,[["p",["The Golden Egg is an animal product obtained from ",["l","金色的鸡","Golden Chicken"],"s. They will produce a Golden \nEgg every day as long as they are fed."]],["p",["To obtain Golden Eggs and Golden Chickens, ",["l","完美","Perfection"]," must have been achieved. Progress can be tracked in ",["l","齐先生的核桃房#Perfection Tracker","Qi's Walnut Room"],"."]],["p",["After reaching Perfection, the first Golden Egg can be obtained in four ways:"]],["l",0,[[1,[["l","玛妮的牧场","Marnie's Ranch"]," for 100,000g."]],[1,[["l","齐先生的核桃房","Qi's Walnut Room"]," for 100 Qi Gems."]],[1,[["l","陨石#The Witch","Random Event"]," that occurs after the player goes to sleep. A golden witch will fly over a ",["l","鸡舍","Coop"]," and leave a Golden Egg inside."]],[1,["Randomly from a ",["l","钓鱼#Treasure Chests","Fishing Treasure Chest"]," (0.12% chance)."]]]],["p",["Golden Eggs can be put into an ",["l","孵化器","incubator"]," in a ",["l","木匠的商店#Farm Buildings","Big or Deluxe Coop"]," to hatch a Golden Chicken 6 days later, or 3 days with the ",["l","耕种#Farming Skill","Coopmaster Profession"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Like"]},[["l","德米特里厄斯","Demetrius"],", ",["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","亚历克斯","Alex"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"]]],[{"h":1,"v":["Neutral"]},[["l","罗宾","Robin"],", ",["l","玛鲁","Maru"],", ",["l","卡洛琳","Caroline"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","艾米丽","Emily"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"],", ",["l","雷欧","Leo"]]],[{"h":1,"v":["Dislike"]},[["l","阿比盖尔","Abigail"],", ",["l","潘姆","Pam"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"]]],[