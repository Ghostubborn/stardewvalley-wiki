{"s":[[null,1,[["p",["The Midnight Squid is a ",["l","鱼","fish"]," that can be caught in the submarine ride at the ",["l","夜市","Night Market"],", which takes place at ",["l","沙滩","The Beach"]," during ",["l","冬季","Winter"]," 15-17. It can also be caught by using ",["l","魔法鱼饵","Magic Bait"]," in the southwest corner of the beach: From the left-most pier, in the southwestern corner, fish facing west."]],["p",["In the submarine ride at the Night Market, there is a 21% chance to hook a Midnight Squid (17% if using a ",["l","珍稀诱钩","Curiosity Lure"],"). If using Magic Bait in the southwest corner of the beach, there is a 3.3% chance to hook a Midnight Squid (10.2% if using a Curiosity Lure)."]],["p",["When placed in a ",["l","鱼塘","Fish Pond"],", Midnight Squid will produce ",["l","鱿鱼墨汁","Squid Ink"]," instead of ",["l","鱼籽","Roe"],". However, Midnight Squid Roe can be found in ",["l","钓鱼","Fishing Treasure Chests"]," after obtaining the power from the ",["l","海之宝石","Jewels Of The Sea"]," book."]]]],["Map",2,[["p",["Midnight Squid can be found in the submarine ride at the ",["l","夜市","Night Market"]," (",["l","冬季","Winter"]," 15-17)."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Neutral"]},[["l","德米特里厄斯","Demetrius"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","潘姆","Pam"],", ",["l","艾利欧特","Elliott"],", ",["l","威利","Willy"],", ",["l","雷欧","Leo"]]],[{"h":1,"v":["Dislike"]},[["l","罗宾","Robin"],", ",["l","玛鲁","Maru"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","艾米丽","Emily"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","科罗布斯","Krobus"]]],[{"h":1,"v":