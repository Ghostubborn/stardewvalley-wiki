{"s":[[null,1,[["p",["The Tub o' Flowers is a ",["l","打造","crafted"]," piece of ",["l","家具","Furniture"]," that blooms in the ",["l","春季","Spring"]," and ",["l","夏季","Summer"],". Both the Tub o' Flowers and its recipe can be purchased from ",["l","皮埃尔","Pierre"]," at the ",["l","花舞节","Flower Dance"],"."]]]],["Note",2,[["p",["The seeds required for this crafting recipe cost 200g at ",["l","皮埃尔的杂货店","Pierre's General Store"]," when bought in the correct season."]]]]],"f":[["Source",[["l","打造","Crafting"]," • ",["l","花舞节","Flower Dance"]," for 250g"]],["Ingredients",[["i","(O)388","Wood ×15"],["i","(O)427","Tulip Bulb ×1"],["i","(O)429","Jazz Seeds ×1"],["i","(O)453","Poppy Seeds ×1"],["i","(O)455","Spangle Seeds ×1"]]],["Sell Price",["Cannot be sold"]]]}