{"s":[[null,1,[["p",["The Purple Mushroom can be found:"]],["l",0,[[1,["via ",["l","采集","foraging"]," in ",["l","矿井","the Mines"]," (starting at floor 81) or the ",["l","骷髅洞穴","Skull Cavern"],"."]],[1,["at a tapped or chopped ",["l","蘑菇树","Mushroom Tree"],"."]],[1,["grown in ",["l","山洞","the Farm Cave"]," if converted for mushrooms (2.5% chance)."]],[1,["as a possible gift at the ",["l","冬日星盛宴","Feast of the Winter Star"]," from any adult except Clint, Evelyn, Marnie, Robin, or Willy."]],[1,["occasionally in a ",["l","垃圾桶","Garbage Can"]," after the player has reached floor 40 of the Mines."]],[1,["occasionally at the ",["l","旅行货车","Traveling Cart"]," for 750–1,250g."]],[1,["through the mail from the ",["l","法师","Wizard"]," at any ",["l","友谊","friendship"]," level greater than zero friendship points."]],[1,["on the ",["l","农场地图","Forest Farm Map"]," during ",["l","秋季","Fall"]," (25% chance)."]],[1,["in the ",["l","姜岛","Ginger Island mushroom cave"],"."]],[1,["on a ",["l","蘑菇树桩","Mushroom Log"],"."]]]]]],["Gifting",2,[["t",[[{"h":1,"v":["Love"]},[["l","法师","Wizard"]]],[{"h":1,"v":["Like"]},[["l","德米特里厄斯","Demetrius"],", ",["l","莱纳斯","Linus"],", ",["l","莉亚","Leah"],", ",["l","哈维","Harvey"],", ",["l","玛鲁","Maru"]]],[{"h":1,"v":["Neutral"]},[["l","罗宾","Robin"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","肯特","Kent"],", ",["l","玛妮","Marnie"],", ",["l","格斯","Gus"],", ",["l","桑迪","Sandy"]]],[{"h":1,"v":["Dislike"]},[["l","塞巴斯蒂安","Sebastian"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","潘妮","Penny"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","山姆","Sam"],", ",["l","谢恩","Shane"],", ",["l","艾利欧特","Elliott"],", ",["l","矮人","Dwarf"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"],", ",["l","雷欧","Leo"]]]]]]],["Bundles",2,[["l",0,[[