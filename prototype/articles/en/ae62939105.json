{"s":[[null,1,[["p",["Amethyst is a ",["l","矿物","Mineral"]," that can be obtained from ",["l","采矿#Mining Nodes","Amethyst Node"],"s and ",["l","采矿#Mining Nodes","Gem Node"],"s in ",["l","矿井","the Mines"],", ",["l","淘盘","panning"],", or as a rare drop from ",["l","史莱姆","Green Slimes"],". It has a 10% chance to be dropped by a slain ",["l","矮人哨兵","Dwarvish Sentry"]," in the ",["l","火山地牢","Volcano Dungeon"],". It may also occasionally be found in ",["l","钓鱼#Treasure Chests","Fishing Treasure Chests"]," or in a ",["l","垃圾桶","Garbage Can"],". A ",["l","大海参","Super Cucumber"]," ",["l","鱼塘","Fish Pond"]," may produce 1-3 Amethyst when the population of the pond reaches 9. The ",["l","无尽财富之雕像","Statue Of Endless Fortune"]," produces one Amethyst per year, on ",["l","阿比盖尔","Abigail"],"'s birthday, ",["l","秋季","Fall 13"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Love"]},[["l","阿比盖尔","Abigail"],", ",["l","克林特","Clint"],", ",["l","艾米丽","Emily"],", ",["l","矮人","Dwarf"]]],[{"h":1,"v":["Like"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","卡洛琳","Caroline"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"],", ",["l","雷欧","Leo"]]],[{"h":1,"v":["Dislike"]},[["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","莉亚","Leah"]]]]]]],["Bundles",2,[["p",["Amethyst is one of the options for the treasure hunter Bundle."]]]],["Forging",2,[["p",["Amethyst can be used at the ",["l","锻造","Forge"]," to increase the knockback of a melee weapon."]]]],["Recipes",2,[["p",["Amethyst is not used in any ",["l","烹饪","recipes"],"."]]]],["Tailoring",2,[["p",["Amethyst is used in the spool of the ",["l","柳巷2号#Sewing Machine","Sewing Machine"]," with ",["l","布料","Cloth"]," in the feed to create a ",["l","裁缝","Shirt"],". It is a purple dye when used in the spool of the Sewing Machine with a dyeable clothing item in the feed. It can be placed in the purple dye pot at Emily's and Haley's house for use in ",["l","染色","dyeing"],"."]]]],["Quests",2,[["l",0,[[1,["In the ",["l","任务#Clint's Attempt","\"Clint's Attempt\" Quest"],", ",["l","克林特","Clint"]," sends you a letter on the 6th of ",["l","冬季","Winter"]," requesting that you give ",["l","艾米丽","Emily"]," an amethyst and tell her it's from him. The reward is 1 ",["l","友谊","Friendship"]," heart with Emily."]],[1,["Amethyst may be randomly requested during any season at the ",["l","任务#Help Wanted Quests","\"Help Wanted\" board"]," outside ",["l","皮埃尔的杂货店","Pierre's General Store"]," for a reward of 300g and 150 ",["l","友谊","Friendship"]," points."]],[1,["1-3 Amethyst may be requested by ",["l","鲶鱼","Catfish"],", ",["l","幽灵鱼","Spook Fish"],", or ",["l","太阳鱼","Sunfish"]," in ",["l","鱼塘#Quests","Fish Pond quests"],"."]],[1,["Amethyst will be requested by ",["l","艾米丽","Emily"]," as part of the \"Rock Rejuvenation\" quest at the ",["l","任务#List of Special Orders","Special Orders"]," board outside Mayor ",["l","刘易斯","Lewis"],"' house."]],[1,["May be used in the ",["l","姜岛#Gem Birds","Gem Birds"]," puzzle on Ginger Island."]]]]]],["History",2,[["l",0,[[1,[["l","版本历史#1.4","1.4"],": Can now be used in ",["l","裁缝","Tailoring"],". Can be requested in ",["l","鱼塘#Quests","Fish Pond quests"],". Can be produced by ",["l","鱼塘","Fish Pond"],"s."]],[1,[["l","版本历史#1.5","1.5"],": Can be requested in a ",["l","任务#List of Special Orders","Special Order quest"],". Can be used in ",["l","锻造","Forging"],". Also used in ",["l","姜岛#Gem Birds","Gem Birds puzzle"],". Is now an option in the Treasure Hunter's Bundle."]]]]]]]}