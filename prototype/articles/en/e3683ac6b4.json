{"s":[[null,1,[["p",["The Survival Burger is a ",["l","烹饪","cooked dish"],". It is prepared using either the kitchen inside an upgraded ",["l","农舍","farmhouse"]," or a ",["l","野炊工具","Cookout Kit"],". It is also cooked by ",["l","格斯","Gus"]," during the ",["l","星露谷展览会","Stardew Valley Fair"]," and can be eaten for free. 1-2 Survival Burger may occasionally be found in ",["l","补给箱","Supply Crate"],"s on the ",["l","农场地图#Beach","Beach Farm"]," if the player has not upgraded the ",["l","农舍","Farmhouse"]," yet."]],["p",["Survival Burger may randomly appear in ",["l","科罗布斯","Krobus"],"' shop on ",["l","周循环#Saturday","Saturdays"],". 5 Survival Burgers may occasionally be found in a ",["l","骷髅洞穴#Treasure Rooms","treasure room"]," in the Skull Cavern."]],["p",["Note: this recipe is ",["l","烹饪#Profitable Recipes","profitable"]," - it will always result in profit when using the lowest quality ingredients as well as ",["l","面包","Bread"]," made from ",["l","大麦粉","Wheat Flour"]," made in the ",["l","磨坊","Mill"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Love"]},[["l","艾米丽","Emily"]]],[{"h":1,"v":["Like"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"]]],[{"h":1,"v":["Dislike"]},[["l","莉亚","Leah"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"],", ",["l","雷欧","Leo"]]]]]]],["Bundles",2,[["p",["Survival Burger is not 