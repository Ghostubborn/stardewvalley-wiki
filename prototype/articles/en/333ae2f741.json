{"s":[[null,1,[["p",["Broken Glasses are a type of ",["l","垃圾","trash"]," that can be caught when fishing during all seasons, in any location, using either a ",["l","工具#Fishing Poles","Fishing Pole"]," or a ",["l","蟹笼","Crab Pot"],". They can also be found in ",["l","垃圾桶","Garbage Can"],"s, and any crab pot fish may produce Broken Glasses when placed in a ",["l","鱼塘","Fish Pond"],". It can also be gifted by a ",["l","动物#Pets","pet"]," cat with max ",["l","动物#Friendship","friendship"],"."]],["p",["Broken Glasses can be ",["l","回收机","recycled"]," into ",["l","精炼石英","Refined Quartz"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Like"]},[["l","艾芙琳","Evelyn"]]],[{"h":1,"v":["Hate"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","雷欧","Leo"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"]]]]]]],["Recycling",2,[["t",[[{"h":1,"v":["Item"]},{"h":1,"v":["Equipment"]},{"h":1,"v":["Product"]},{"h":1,"v":["Recycling Time"]}],[[["i","(O)170","Broken Glasses"]],[["i","(BC)20","Recycling Machine"]],[["i","(O)338","Refined Quartz ×1"]],["1h"]]]]]],["Bundles",2,[["p",["Broken Glasses are not used in any ",["l","收集包","bundles"],"."]]]],["Recipes",2,[["p",["Broken Glasses are not used in any recipes."]]]],["Tailoring",2,[["p",["Broken Glasses can be used in the spool of the ",["l","柳巷2号#Sewing Machine","Sewing Machine"]," to create the ",["l","裁缝","Trash Can Shirt"],". ",["f","Shirt232.png",24]," It can be used in ",["l","染色","dyeing"],", serving as a blue dye at the dye pots, located in ",["l","艾米丽","Emily"],"'s and ",["l","海莉","Haley"],"'s house, ",["l","柳巷2号","2 Willow Lane"],"."]]]],["Quests",2,[["p",["During the special order quest ",["l","任务#List of Special Orders","Community Cleanup"]," the player is tasked with gathering 20 trash items (except Joja Cola)."]]]],["Trading",2,[["p",["Once unlocked, the Raccoon's wife near the ",["l","大树桩（地点）","Giant Stump"]," will trade for Broken Glasses."]],["t",[[{"h":1,"v":["Image"]},{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Price"]},{"h":1,"v":["Requirements"]}],[[["f","Jungle_Tank.png",48]],[["l","丛林鱼缸","Jungle Tank"]],["Can be placed inside your house."],[["i","(O)170","Broken Glasses ×5"]],["5th Request Completed"]]]]]],["History",2,[["l",0,[[1,[["l","版本历史#1.4","1.4"],": Can now be used in ",["l","裁缝","Tailoring"],". Can be produced by Fish Ponds."]],[1,[["l","版本历史#1.6","1.6"],": Now used to trade for ",["l","丛林鱼缸","Jungle Tank"],". Can now be gifted by a ",["l","动物#Pets","pet"]," cat with max ",["l","动物#Friendship","friendship"],". Now liked by ",["l","艾芙琳","Evelyn"],"."]]]]]]],"f":[["Source",[["l","工具#Fishing Poles","Fishing Pole"]," • ",["l","蟹笼","Crab Pot"]," • ",["l","垃圾桶","Garbage Can"],"s • ",["l","鱼塘","Fish Pond"]," • ",["l","动物#Cat or Dog","Cat"]]],["Season",["All"]],["Sell Price",["0g"]]]}