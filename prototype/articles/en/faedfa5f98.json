{"s":[[null,1,[["p",["Juice is an ",["l","工匠物品","Artisan Good"]," made from placing a ",["l","蔬菜","vegetable"]," or ",["l","采集","foraged item"]," inside a ",["l","小桶","Keg"],", taking approximately 4 ",["l","游戏内时间","days"],". Its selling price is the base value of the ingredient input multiplied by 2.25 (3.15 with the ",["l","技能","Artisan"]," profession)."]],["p",["The ",["l","能量","energy"]," and ",["l","生命值","health"]," restored by Juice is equal to 2 × Base Ingredient Value for edible vegetables and foraged items. For inedible vegetables, Juice will restore energy equal to exactly Base ",["l","蔬菜","Vegetable"]," Value and health equal to 45% Base ",["l","蔬菜","Vegetable"]," Value. The color of the Juice also depends on the item used."]],["p",["Although ",["l","小麦","Wheat"],", ",["l","啤酒花","Hops"],", and ",["l","茶叶","Tea Leaves"]," are classified as ",["l","蔬菜","vegetables"],", when used with a ",["l","小桶","Keg"],", they produce ",["l","啤酒","Beer"],", ",["l","淡啤酒","Pale Ale"],", and ",["l","绿茶","Green Tea"]," respectively."]],["p",["The following foraged items can be made into Juice: ",["l","山洞萝卜","Cave Carrot"],", ",["l","蒲公英","Dandelion"],", ",["l","姜","Ginger"],", ",["l","榛子","Hazelnut"],", ",["l","韭葱","Leek"],", ",["l","大葱","Spring Onion"],", ",["l","雪山药","Snow Yam"],", ",["l","野山葵","Wild Horseradish"],", and ",["l","冬根","Winter Root"],"."]],["p",["Juice cannot be put in a ",["l","木桶","cask"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Like"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"],", ",["l","雷欧","Leo"]]],[{"h":1,"v":["Hate"]},[["l","塞巴斯蒂安","Sebastian"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"]]]]]]],["Bundles",2,[["p",["Juice is one of the options for the brewers Bundle."]]]],["Recipes",2,[["p",["Juice is not used in any recipes."]]]],["Tailoring",2,[["p",["Juice is used in the spool of the ",["l","柳巷2号","Sewing Machine"]," to create the dyeable ",["l","裁缝","Sports Shirt"],". It can be used in ",["l","染色","dyeing"],", serving as a green dye at the dye pots, located in ",["l","艾米丽","Emily"],"'s and ",["l","海莉","Haley"],"'s house, ",["l","柳巷2号","2 Willow Lane"],"."]]]],["Quests",2,[["l",0,[[1,[["l","潘姆","Pam"]," requests 12 Potato Juice in the ",["l","任务","\"The Strong Stuff\""]," Special Order."]],[1,["One Juice is requested by the Raccoon at the ",["l","大树桩（地点）","Giant Stump"]," as part of his fourth request. It may also be requested as part of any request starting with the sixth."]]]]]],["Trivia",2,[["p",["Juice sold by the ",["l","旅行货车","Traveling Cart"]," will not be of any ingredients type, will sell for 150g (or 210g with the ",["l","技能","Artisan Profession"],"), and will restore 75 ",["l","能量","energy"]," and 33 ",["l","生命值","health"],"."]]]]],"f":[["Source",[["l","工匠物品","Artisan Goods"]]],["Equipment",[["i","(BC)12","Keg"]]],["Ingredients",["Any ",["l","蔬菜","vegetable"]," (1) (other than ",["l","小麦","Wheat"],", ",["l","啤酒花","Hops"],", & ",["l","茶叶","Tea Leaves"],") or\nAny positive energy ",["l","采集","foraged item"]," (1) (other than Mushrooms)"]],["Processing Time",["6000m (≈4d)"]],["Sell Price",["2.25 × Base ",["l","蔬菜","Vegetable"]," / ",["l","采集","Forage"]," Price"]]]}