{"s":[[null,1,[["p",["An Iron Bar is created by smelting 5 ",["l","铁矿石","Iron Ore"]," in a ",["l","熔炉","furnace"]," with 1 ",["l","煤炭","coal"]," for fuel, or by ",["l","打造","Crafting"]," the \"Transmute (Fe)\" recipe (3 ",["l","铜锭","Copper Bar"],"s into one Iron Bar which is unlocked at mining level 4)."]],["p",["Iron Bars may occasionally be found in ",["l","垃圾桶","Garbage Can"],"s after receiving the ",["l","熔炉","Furnace"]," blueprints from ",["l","克林特","Clint"],". An Iron Bar may also drop from a ",["l","暗影狂徒","Shadow Brute"]," (2% chance) or ",["l","暗影萨满","Shadow Shaman"]," (2% chance) when slain."]],["p",["Smelting iron ore in a furnace takes 2 in-game hours. The \"Transmute (Fe)\" recipe is earned at ",["l","采矿","Mining"]," Level 4."]],["p",["Iron bars are used in a variety of ",["l","打造","crafting"]," recipes and are used to upgrade ",["l","工具","tools"]," to tier 3. Each iron bar can be sold for 120g, or 180g with the ",["l","技能#Mining","Blacksmith Profession"],"."]]]],["Tool Upgrades",2,[["p",["Iron Bars are required for the second upgrade of tools."]],["t",[[{"h":1,"v":["Image"]},{"h":1,"v":["Name"]},{"h":1,"v":["Cost"]},{"h":1,"v":["Ingredients"]}],[[["f","Steel_Hoe.png",48]],[["l","锄头","Steel Hoe"]],["5,000g"],[["i","(O)335","Iron Bar ×5"]]],[[["f","Steel_Pickaxe.png",48]],[["l","十字镐","Steel Pickaxe"]],["5,000g"],[["i","(O)335","Iron Bar ×5"]]],[[["f","Steel_Axe.png",48]],[["l","斧头","Steel Axe"]],["5,000g"],[["i","(O)335","Iron Bar ×5"]]],[[["f","Steel_Watering_Can.png",48]],[["l","喷壶","Steel Watering Can"]],["5,000g"],[["i","(O)335","Iron Bar ×5"]]],[[["f","Trash_Can_Steel.png",48]],[["l","垃圾桶（工具）","Steel Trash Can"]],["2,500g"],[["i","(O)335","Iron Bar ×5"]]],[[["f","Steel_Pan.png",48]],[["l","淘盘","Steel Pan"]],["5,000g"],[["i","(O)335","Iron Bar ×5"]]]]]]],["Crafting",2,[["p",["Iron Bars are used to make the following items:"]],["t",[[{"h":1,"v":["Image"]},{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Ingredients"]},{"h":1,"v":["Recipe S