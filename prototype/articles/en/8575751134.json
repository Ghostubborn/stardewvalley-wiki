","Lewis"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"],", ",["l","雷欧","Leo"]]],[{"h":1,"v":["Dislike"]},[["l","塞巴斯蒂安","Sebastian"],", ",["l","乔治","George"],", ",["l","克林特","Clint"]]]]]]],["Bundles",2,[["l",0,[[1,["Sunflower is used in the Bulletin Board."]],[1,["Sunflower is one of the options for the garden Bundle."]]]]]],["Recipes",2,[["p",["Sunflower is not used in any recipes."]]]],["Artisan Goods",2,[["p",["Note that the game does not consider ",["l","油","Oil"]," to be an ",["l","工匠物品","Artisan Good"],", so it does not benefit from the ",["l","耕种","Artisan Profession"],"."]],["t",[[{"h":1,"v":["Image"]},{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Ingredients"]},{"h":1,"v":["Equipment"]},{"h":1,"v":["Time"]},{"h":1,"v":["Energy / Health"]},{"h":1,"v":["Sell Price"]}],[[["f","Oil.png",48]],[["l","油","Oil"]],["All purpose cooking oil."],[["i","(O)421","Sunflower ×1"]],[["f","Oil_Maker.png",48],["l","产油机","Oil Maker"]],["60m (1 hour)"],["Energy 13Health 5"],["100g"]]]]]],["Tailoring",2,[["p",["Sunflower is used in the spool of the ",["l","柳巷2号","Sewing Machine"]," with ",["l","布料","Cloth"]," in the feed to create a dyeable ",["i","(P)2","Long Dress"],". It is a yellow dye when used in the spool of the Sewing Machine with a dyeable clothing item in the feed. It can be placed in the yellow dye pot at Emily's and Haley's house for use in ",["l","染色","dyeing"],"."]]]],["Quests",2,[["p",["Sunflower is not used in any ",["l","任务","quests"],"."]]]],["Notes",2,[["l",0,[[1,["If placed within proper range of a ",["l","蜂房","Bee House"]," (5 squares in any cardinal direction), a Sunflower will cause the ",["l","蜂蜜","Honey"]," produced to become more profitable."]],[1,["Since both sunflowers and their seeds can be processed into oil using an ",["l","产油机","Oil Maker"],", when processing sunflowers into oil it is more profitable to first process the crop into ",["l","向日葵种子","Sunflower Seeds"]," using a ",["l","种子生产器","Seed Maker"],". This will yield on average 2 seeds, producing on average 2 oil for 1 sunflower instead of only 1 oil."]],[1,["Sunflowers only produce 5xp instead of 14xp, since the price of sunflower seeds, not the sunflowers themselves, is used for the xp calculation. (code reference Crop::harvest)"]]]]]]],"f":[["Season",["Summer • Fall"]],["Growth Time",["8 days"]],["Seed",[["i","(O)431","Sunflower Seeds"]]],["Sell Price",["80g"]]]}