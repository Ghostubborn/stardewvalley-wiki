{"s":[[null,1,[["p",["Bug Meat is a ",["l","怪物战利品","Monster Loot"]," item which is dropped from any type of ",["l","探险家公会#Cave Insect","insect"],", including ",["l","甲虫","Armored Bug"],"s and ",["l","甲虫（危险）","Dangerous Armored Bugs"]," if the player has forged their weapon with a ",["l","锻造#Combat enchantments","Bug Killer enchantment"],"."]],["p",[["l","麻哈脂鲤","Dorado"],", ",["l","蛇齿单线鱼","Lingcod"],", or ",["l","狗鱼","Pike"]," ",["l","鱼塘","Fish Pond"],"s may produce 20 Bug Meat when the population of the pond reaches 9."]],["p",[["l","文森特","Vincent"]," sells Bug Meat in his ",["l","沙漠节#Villager Shops","shop"]," at the ",["l","沙漠节","Desert Festival"]," for 1 Calico Egg ",["l","卡利科三花蛋","Calico Egg"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Hate"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","雷欧","Leo"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"]]]]]]],["Crafting",2,[["p",["Note that the ",["l","训练用鱼竿","Training Rod"]," and ",["l","竹鱼竿","Bamboo Pole"]," cannot use any type of bait. A ",["l","玻璃纤维鱼竿","Fiberglass Rod"],", ",["l","铱金鱼竿","Iridium Rod"]," or ",["l","高级铱金鱼竿","Advanced Iridium Rod"]," is required."]],["t",[[{"h":1,"v":["Image"]},{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Ingredients"]},{"h":1,"v":["Recipe Source"]}],[[["f","Bait.png",48]],[["l","鱼饵（物品）","Bait"]," (5)"],["Causes fish to bite faster. Must first be attached to a fishing rod."],[["i","(O)684","Bug Meat ×1"]],[["f","Fishing_Skill_Icon.png",24]," ",["l","钓鱼#Fishing Skill","Fishing"]," Level 2"]],[[["f","Wild_Bait.png",48]],[["l","万能鱼饵","Wild Bait"]," (5)"],["A unique recipe from Linus that gives you a chance to catch two fish at once."],[["i","(O)684","Bug Meat ×5"],["i","(O)771","Fiber ×10"],["i","(O)766","Slime ×5"]],[["f","Linus_Icon.png",24]," ",["l","莱纳斯","Linus"]," 4-heart event"]],[[["f","Sturdy_Ring.png",48]],[["l","结实戒指","Sturdy Ring"]],["Cuts the duration of negative status effects in half."],[["i","(O)684","Bug Meat ×25"],["i","(O)334","Copper Bar ×2"],["i","(O)766","Slime ×25"]],[["f","Combat_Skill_Icon.png",24]," ",["l","战斗#Combat Skill","Combat"]," Level 1"]],[[["f","Bug_Steak.png",48]],[["l","虫肉块","Bug Steak"]],["The last resort of the hungry cave diver."],[["i","(O)684","Bug Meat ×10"]],[["f","Combat_Skill_Icon.png",24]," ",["l","战斗#Combat Skill","Combat"]," Level 1"]],[[["f","Magic_Bait.png",48]],[["l","魔法鱼饵","Magic Bait"]," (5)"],["Allows you to catch fish from any season, time, or weather, from whichever type of water you cast into."],[["i","(O)684","Bug Meat ×3"],["i","(O)909","Radioactive Ore ×1"]],[["f","Mr._Qi_Icon.png",24]," ",["l","齐先生的核桃房","Mr. Qi"]," (20 Qi Gems)"]]]]]],["Bundles",2,[["p",["Bug Meat is not used in any ",["l","收集包","bundles"],"."]]]],["Tailoring",2,[["p",["Bug Meat is used in the spool of the ",["l","柳巷2号#Sewing Machine","Sewing Machine"]," with ",["l","布料","Cloth"]," in the feed to create a ",["l","裁缝","Pink Striped Shirt"],". It is a dark pink dye when used in the spool of the Sewing Machine with a dyeable clothing item in the feed. It can be placed in the purple dye pot at Emily's and Haley's house for use in ",["l","染色","dyeing"],"."]]]],["Quests",2,[["l",0,[[1,["Ten Bug Meat may be requested by several fish in ",["l","鱼塘#Quests","Fish Pond quests"],"."]],[1,[["l","威利","Willy"]," requests 100 Bug Meat in the ",["l","任务#Juicy Bugs Wanted","\"Juicy Bugs Wanted!\""]," Special Order. The rewards are 3,000g and the ",["l","优质浮标","Quality Bobber"]," recipe."]],[1,["Twenty Bug Meat may be requested by the Raccoon at the ",["l","大树桩（地点）","Giant Stump"]," as part of his fifth request, or as part of any request starting with the sixth."]]]]]],["History",2,[["l",0,[[1,[["l","版本历史#1.0","1.0"],": Introduced."]],[1,[["l","版本历史#1.4","1.4"],": Used as an ingredient to the ",["l","结实戒指","Sturdy Ring"]," recipe. Can now be used in ",["l","裁缝","Tailoring"],". Can be requested in ",["l","鱼塘#Quests","Fish Pond quests"],". Can be produced by ",["l","鱼塘","Fish Pond"],"s."]],[1,[["l","版本历史#1.5","1.5"],": Needed in the ",["l","任务#Juicy Bugs Wanted","\"Juicy Bugs Wanted!\" Special Order"],". Used as an ingredient to the ",["l","虫肉块","Bug Steak"]," and ",["l","魔法鱼饵","Magic Bait"]," recipes."]],[1,[["l","版本历史#1.6","1.6"],": Can now be purchased at ",["l","沙漠节","Desert Festival"],". May now be requested by the Raccoon."]]]]]]],"f":[["Source",[["l","臭虫","Bug (76%)"],"Bug (dangerous) (76%)",["l","苍蝇","Cave Fly (90%)"],"Cave Fly (dangerous) (90%)",["l","蛆","Grub (60%)"],"Grub (dangerous) (60%)",["l","突变苍蝇","Mutant Fly (90%)"],["l","突变蛆","Mutant Grub (60%)"],["l","甲虫","Armored Bug (76%)"],"Armored Bug (dangerous) (76%)"]],["Sell Price",["8g"]]]}