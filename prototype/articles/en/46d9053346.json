{"s":[[null,1,[["p",["The Banana Sapling is a ",["l","果树","Fruit Tree"]," sapling that takes 28 days to grow into a ",["l","香蕉树","Banana Tree"],", after which it will produce one fruit each day during the ",["l","夏季","Summer"],", or year-round on ",["l","姜岛","Ginger Island"],". Like all Fruit Trees, it will also produce fruit all year round if planted in the ",["l","温室","Greenhouse"],"."]],["p",["It can be purchased from the ",["l","姜岛商人","Island Trader"]," in exchange for 5 ",["l","龙牙","Dragon Teeth"],". Banana Saplings can sometimes be found by breaking open a ",["l","金色椰子","Golden Coconut"],". ",["l","蜗牛教授","Professor Snail"]," also gives a Banana Sapling as a reward for completing the Large Animal collection in the ",["l","岛屿办事处","Island Field Office"],". One can be purchased from ",["l","雷欧","Leo"],"'s ",["l","沙漠节#Villager Shops","shop"]," during the ",["l","沙漠节","Desert Festival"]," for 100 Calico Eggs ",["l","卡利科三花蛋","Calico Egg"],"s."]]]],["Stages",2,[["t",[[{"h":1,"v":["Stage 1"]},{"h":1,"v":["Stage 2"]},{"h":1,"v":["Stage 3"]},{"h":1,"v":["Stage 4"]},{"h":1,"v":["Stage 5 - Spring, Summer, Fall, Winter"]},{"h":1,"v":["Harvest"]}],[[["f","Banana_Stage_1.png",100]],[["f","Banana_Stage_2.png",100]],[["f","Banana_Stage_3.png",100]],[["f","Banana_Stage_4.png",100]],[["f","Banana_Stage_5.png",384]],[["f","Banana_Stage_5_Fruit.png",96]]],[["7 Days"],["7 Days"],["7 Days"],["7 Days"],["Total: 28 Days"],["Summer"]]]]]],["Gifting",2,[["t",[[{"h":1,"v":["Dislike"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","雷欧","Leo"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"]]]]]]],["History",2,[["l",0,[[1,[["l","版本历史#1.5","1.5"],": Introduced."]],[1,[["l","版本历史#1.6","1.6"],": Now purchasable at ",["l","沙漠节","Desert Festival"],". Can now be obtained by chopping down a ",["l","香蕉树","Banana Tree"],"."]]]]]]]}