{"s":[[null,1,[["p",["Fire Quartz is a ",["l","矿物","Mineral"],". It can be foraged in ",["l","矿井","the Mines"]," (floors 80+), in the ",["l","骷髅洞穴","Skull Cavern"],", or found inside a ",["l","岩浆晶球","Magma Geode"]," or ",["l","万象晶球","Omni Geode"],". It can also be found by ",["l","淘盘","panning"]," or inside ",["l","钓鱼#Treasure Chests","Fishing Treasure Chests"],". It may occasionally be found in a ",["l","垃圾桶","Garbage Can"]," after the player reaches floor 80 of the mines. It can also be gifted randomly by the ",["l","法师","Wizard"]," in the mail, once the player has met him. One Fire Quartz can sometimes be purchased for 2,500g from ",["l","皮埃尔","Pierre"],"'s booth at the ",["l","冬日星盛宴","Feast of the Winter Star"],"."]],["p",["Fire Quartz can be destroyed by ",["l","打造#Bombs","bombs"],"."]],["p",["Fire Quartz can be used along with 1 ",["l","煤炭","coal"]," in a ",["l","熔炉","furnace"]," to produce 3 ",["l","精炼石英","Refined Quartz"],", taking 1.5 in-game hours to smelt."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Like"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"],", ",["l","雷欧","Leo"]]],[{"h":1,"v":["Dislike"]},[["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","莉亚","Leah"]]]]]]],["Bundles",2,[["p",["Fire Quartz is used in the Boiler Room."]]]],["Crafting",2,[["t",[[{"h":1,"v":["Image"]},{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Ingredients"]},{"h":1,"v":["Recipe Source"]}],[[["f","Slime_Egg-Press.png",48]],[["l","史莱姆压蛋器","Slime Egg-Press"]],["Compresses 100 pieces of slime into a slime egg. It's a miracle of science!"],[["i","(O)382","Coal ×25"],["i","(O)82","Fire Quartz ×1"],["i","(O)787","Battery Pack ×1"]],[["l","战斗","Combat"]," Level 6"]],[[["f","Dehydrator.png",48]],[["l","烘干机","Dehydrator"]],["Place 5 pieces of fruit or edible mushrooms inside to dry them."],[["i","(O)388","Wood ×30"],["i","(O)330","Clay ×2"],["i","(O)82","Fire Quartz ×1"]],[["f","Pierre_Icon.png",24]," ",["l","皮埃尔的杂货店","Pierre's General Store"]," (10,000g)"]]]]]],["Smelting",2,[["p",["To smelt Fire Quartz, equip it and activate the ",["l","熔炉","furnace"]," while there is ",["l","煤炭","Coal"]," in inventory. One unit of Coal is required for each smelting operation, regardless of the material or duration."]],["t",[[{"h":1,"v":["Ingredients"]},{"h":1,"v":["Equipment"]},{"h":1,"v":["Smelting Time"]},{"h":1,"v":["Produces"]}],[[["i","(O)82","Fire Quartz ×1"],["i","(O)382","Coal ×1"]],[["f","Furnace.png",48],["l","熔炉","Furnace"]],["1.5 hours"],[["i","(O)338","Refined Quartz ×3"]]]]]]],["Tailoring",2,[["p",["Fire Quartz is used in the spool of the ",["l","柳巷2号#Sewing Machine","Sewing Machine"]," to create a ",["f","Shirt057.png",24]," ",["l","裁缝","Shirt"],". It can also be used as a red dye color at the dye pots in ",["l","艾米丽","Emily"],"'s and ",["l","海莉","Haley"],"'s house, located at ",["l","柳巷2号","2 Willow Lane"],"."]]]],["Quests",2,[["l",0,[[1,["Fire Quartz may be randomly requested during any season at the ",["l","任务#Help Wanted Quests","\"Help Wanted\" board"]," outside ",["l","皮埃尔的杂货店","Pierre's General Store"]," for a reward of 300g and 150 ",["l","友谊","Friendship"]," points. Fire Quartz will never be requested until you have reached level 80+ of ",["l","矿井","The Mines"],"."]],[1,["Three Fire Quartz are requested by ",["l","岩浆鳗鱼","Lava Eel"]," in a ",["l","鱼塘#Quests","Fish Pond quest"]," to increase the capacity of the pond from 1 to 3."]]]]]],["History",2,[["l",0,[[1,[["l","版本历史#1.3.27","1.3.27"],": Added ability to smelt into ",["l","精炼石英","Refined Quartz"],"."]],[1,[["l","版本历史#1.4","1.4"],": Can now be used in ",["l","裁缝","Tailoring"],". Can be requested in a ",["l","鱼塘#Quests","Fish Pond quest"],"."]],[1,[["l","版本历史#1.6","1.6"],": Used as an ingredient for ",["l","烘干机","Dehydrator"],". Now sometimes sold at the ",["l","冬日星盛宴","Feast of the Winter Star"],"."]]]]]]]}