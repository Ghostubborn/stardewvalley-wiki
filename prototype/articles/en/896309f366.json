{"s":[[null,1,[["p",["The Tea Set is a piece of decor obtained as a gift from a Secret Gift-Giver at the ",["l","冬日星盛宴","Feast of the Winter Star"],". Any adult other than ",["l","克林特","Clint"],", ",["l","艾芙琳","Evelyn"],", ",["l","玛妮","Marnie"],", ",["l","罗宾","Robin"],", or ",["l","威利","Willy"]," may give you a Tea Set. From Year 25 onwards, there is a 5% chance for the ",["l","旅行货车","Traveling Cart"]," to sell the Tea Set for 1,000,000g during any season."]],["p",["The Tea Set can be stacked in a player's ",["l","物品栏","inventory"]," or ",["l","宝箱","chest"],", sold, and given as a ",["l","友谊","gift"],"."]],["p",["The Tea Set is the only item labeled as “decor” besides the craft-able floors."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Dislike"]},[["l","阿比盖尔","Abigail"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","乔迪","Jodi"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"],", ",["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","雷欧","Leo"],", ",["l","法师","Wizard"],", ",["l","亚历克斯","Alex"],", ",["l","潘妮","Penny"],", ",["l","艾利欧特","Elliott"]]]]]]]]}