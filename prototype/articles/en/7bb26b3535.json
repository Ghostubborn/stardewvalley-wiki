{"s":[[null,1,[["p",["Magic Hair Gel is a ",["l","饰品","trinket"]," item obtainable after claiming ",["l","精通山洞#Masteries","Combat Mastery"],". It can be purchased from ",["l","亚历克斯","Alex"],"'s ",["l","沙漠节#Villager Shops","shop"]," at the ",["l","沙漠节","Desert Festival"]," for 100 Calico Eggs ",["l","卡利科三花蛋","Calico Egg"],"s. It is the only trinket that cannot be dropped from ",["l","怪物","enemies"],", ",["l","矿井#Crates and Barrels","crates and barrels"],", or ",["l","骷髅洞穴#Treasure Rooms","Skull Cavern treasure chests"],"."]],["p",["While the Magic Hair Gel is equipped in the trinket slot, the player's hair color constantly cycles through the colors of a ",["l","五彩碎片","Prismatic Shard"],". This \"prismatic dye\" effect is the same as the one seen on the ",["l","魔法牛仔帽","Magic Cowboy Hat"]," or ",["l","魔法头巾","Magic Turban"],"."]],["p",["The Magic Hair Gel cannot be re-forged on an ",["l","铁砧","Anvil"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Like"]},[["l","法师","Wizard"]]],[{"h":1,"v":["Dislike"]},[["l","亚历克斯","Alex"],", ",["l","雷欧","Leo"],", ",["l","艾米丽","Emily"],", ",["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"],", ",["l","莉亚","Leah"]]]]]]],["History",2,[["l",0,[[1,[["l","版本历史#1.6","1.6"],": Introduced."]]]]]]]}