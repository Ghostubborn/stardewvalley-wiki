{"s":[[null,1,[["p",["The Snow Yam is a ",["l","采集","foraging"]," item found only in ",["l","冬季","Winter"],". Wild snow yams do not grow above ground, but instead they are buried in the snow/dirt and must be dug up with a ",["l","锄头","Hoe"]," (no other tools, even ",["l","打造","Bombs"],", will work)."]],["p",["The highest chance of finding a Snow Yam (11-16%, map-dependent) is when digging up an ",["l","远古斑点","Artifact Spot"],". There is also a 4% chance of finding a Snow Yam when digging standard tillable soil in any exterior location. Exceptions are in ",["l","农场","the Farm"],", where Snow Yams can be found at artifact spots, but not standard tillable soil, and in ",["l","沙漠","the Desert"],", where Snow Yams can not be found at all. Digging up a Snow Yam provides no experience."]],["p",["Snow Yams can also be grown from ",["l","冬季种子","Winter Seeds"],", in which case they are a standard wild-seed crop: they grow above ground, can be harvested without using a tool, give 7 Foraging XP each, and are affected by the ",["l","技能","Gatherer"]," and ",["l","技能","Botanist"]," professions."]],["p",["Snow Yam can also randomly be found in ",["l","垃圾桶","Garbage Can"],"s during Winter."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Like"]},[["l","莱纳斯","Linus"],", ",["l","莉亚","Leah"],", ",["l","哈维","Harvey"]]],[{"h":1,"v":["Neutral"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","玛妮","Marnie"],", ",["l","格斯","Gus"],", ",["l","桑迪","Sandy"]]],[{"h":1,"v":["Dislike"]},[["l","塞巴斯蒂安","Sebastian"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","谢恩","Shane"],", ",["l","艾利欧特","Elliott"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"],", ",["l","雷欧","Leo"]]],[{"h":1,"v":["Hate"]},[["l","玛鲁","Maru"]]]]]]],["Bundles",2,[["p",["Snow Yam is used in the Crafts Room."]]]],["Recipes",2,[["t",[[{"h":1,"v":["Image"]},{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Ingredients"]},{"h":1,"v":["Recipe Source"]},{"h":1,"v":["Sell Price"]}],[[["f","Winter_Seeds.png",48]],[["l","打造","Wild Seeds (Wi)"]],["An assortment of wild winter seeds.\n(Produces 10 Winter Seeds per craft.)"],[["i","(O)418","Crocus ×1"],["i","(O)414","Crystal Fruit ×1"],["i","(O)416","Snow Yam ×1"],["i","(O)412","Winter Root ×1"]],[["f","Foraging_Skill_Icon.png",24]," ",["l","采集","Foraging"]," Level 7"],["30g"]]]]]],["Tailoring",2,[["p",["Snow Yam is used in the spool of the ",["l","柳巷2号","Sewing Machine"]," to create a light blue ",["l","裁缝","Shirt"]," ",["f","Shirt044.png",24]," with a horizontal white stripe in the middle."]]]],["Quests",2,[["l",0,[[1,["The Snow Yam may be randomly requested in ",["l","冬季","Winter"]," at the ",["l","任务","\"Help Wanted\" board"]," outside ",["l","皮埃尔的杂货店","Pierre's General Store"]," for a reward of 300g and 150 ",["l","友谊","Friendship"]," points."]]]]]]],"f":[["Source",[["l","锄头","Tilling"]," • ",["l","冬季种子","Winter Seeds"]]],["Season",["Winter"]],["Sell Price",["100g"]]]}