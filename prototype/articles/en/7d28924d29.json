{"s":[[null,1,[["p",["The Sandfish is a ",["l","鱼","fish"]," that can be caught in the pond at ",["l","沙漠","The Desert"]," during all seasons. It can also randomly be found in ",["l","垃圾桶","Garbage Can"],"s after unlocking The Desert, or at the ",["l","旅行货车","Traveling Cart"]," for 225–1,000g."]],["p",["Sandfish can be caught regardless of time of day using ",["l","魔法鱼饵","Magic Bait"],"."]]]],["Map",2,[["p",["The Sandfish can be found at The Desert."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Love"]},[["l","潘妮","Penny"]]],[{"h":1,"v":["Neutral"]},[["l","德米特里厄斯","Demetrius"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","潘姆","Pam"],", ",["l","艾利欧特","Elliott"],", ",["l","威利","Willy"],", ",["l","雷欧","Leo"]]],[{"h":1,"v":["Dislike"]},[["l","罗宾","Robin"],", ",["l","玛鲁","Maru"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","艾米丽","Emily"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","科罗布斯","Krobus"]]],[{"h":1,"v":["Hate"]},[["l","皮埃尔","Pierre"],", ",["l","艾芙琳","Evelyn"],", ",["l","海莉","Haley"]]]]]]],["Bundles",2,[["p",["Sandfish is used in the Fish Tank."]]]],["Recipes",2,[["t",[[{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Ingredients"]},{"h":1,"v":["Energy / Health"]},{"h":1,"v":["Recipe Source(s)"]},{"h":1,"v":["Sell Price"]}],[[["l","生鱼寿司","Maki Roll"]],["Fish and rice wrapped in seaweed."],["Any ",["l","鱼","Fish"]," (1)",["i","(O)152","Seaweed ×1"],["i","(O)423","Rice ×1"]],["Energy 100\nHealth 45"],["The Queen of Sauce (21 Summer, Year 1)\n ",["l","星之果实酒吧","Stardrop Saloon"]," for 300g"],["220g"]],[[["l","高级肥料","Quality Fertilizer"]],["Improves soil quality, increasing your chance to grow quality crops. Mix into tilled soil."],[["i","(O)92","Sap ×4"]," Any ",["l","鱼","Fish"]," (1)"],["N/A"],[["l","耕种","Farming"]," Level 9"],["10g"]],[[["l","生鱼片","Sashimi"]],["Raw fish sliced into thin pieces."],["Any ",["l","鱼","Fish"]," (1)"],["Energy 75\nHealth 33"],[["l","莱纳斯","Linus"]," (Mail - 3+ ❤)"],["75g"]]]]]],["Tailoring",2,[["p",["Sandfish can be used in the spool of the ",["l","柳巷2号","Sewing Machine"]," to create the dyeable ",["l","裁缝","Fish Shirt"],". It can be used in ",["l","染色","dyeing"],", serving as a yellow dye at the dye pots, located in ",["l","艾米丽","Emily"],"'s and ",["l","海莉","Haley"],"'s house, ",["l","柳巷2号","2 Willow Lane"],"."]]]],["Fish Pond",2,[["p",["Sandfish can be placed in a ",["l","鱼塘","Fish Pond"],", where they will reproduce every 4 days. The initial pond capacity is 3 fish, but the capacity can be increased to 10 by completing two quests. The primary output is yellow Sandfish ",["l","鱼籽","Roe"],", but ",["l","仙人掌种子","Cactus Seeds"]," are also possible at population 10."]],["p",[["l","鱼塘","Quests"]]],["t",[[{"c":2,"h":1,"v":["Pond Capacity"]},{"r":2,"h":1,"v":["Quest Item"]},{"r":2,"h":1,"v":["Fishing XP Granted"]}],[{"h":1,"v":["Before Quest"]},{"h":1,"v":["After Quest"]}],[["3"],["5"],["3 ",["l","仙人掌果子","Cactus Fruit"],"s or 3 ",["l","椰子","Coconut"],"s"],["40"]],[["5"],["10"],["1 ",["l","黄金遗物","Golden Relic"]],["40"]]]],["p",[["l","鱼塘","Produce"]]],["t",[[{"h":1,"v":["Item(s) Produced"]},{"h":1,"v":["Fishing XP Granted"]},{"h":1,"v":["Population"]},{"h":1,"v":["% of Items"]},{"h":1,"v":["Overall Daily Chance"]}],[{"r":3,"v":[["l","鱼籽","Roe ×1"]]},{"r":3,"v":["12"]},["1-7"],["75%"],["17-53%"]],[["8-9"],["38%"],["30-33%"]],[["10"],["27%"],["25%"]],[{"r":2,"v":[["l","鱼籽","Roe ×2"]]},{"r":2,"v":["12"]},["8-9"],["50%"],["40-44%"]],[["10"],["36%"],["34%"]],[[["l","鱼籽","Roe ×3"]],["12"],["10"],["24%"],["23%"]],[[["i","(O)802","Cactus Seeds ×2-5"]],["10"],["10"],["5%"],["5%"]],[{"r":3,"v":["Nothing"]},{"r":3,"v":[]},["1-7"],["25%"],["83-47%"]],[["8-9"],["13%"],["31-24%"]],[["10"],["9%"],["13%"]]]]]],["Quests",2,[["l",0,[[1,["Item Delivery:  After unlocking ",["l","沙漠","The Desert"],", Sandfish may be randomly requested at the ",["l","任务","\"Help Wanted\" board"]," outside ",["l","皮埃尔的杂货店","Pierre's General Store"]," for a reward of 225g and 150 ",["l","友谊","Friendship"]," points."]],[1,["Two Sandfish may be requested by ",["l","麻哈脂鲤","Dorado"],", ",["l","蛇齿单线鱼","Lingcod"],", or ",["l","狗鱼","Pike"]," in a ",["l","鱼塘","Fish Pond quest"]," to increase the capacity of the pond from 7 to 10."]],[1,[["l","威利","Willy"]," requests the player to catch 3 Sandfish during the ",["l","沙漠节","Desert Festival"]," for his ",["l","沙漠节","fishing challenge"]," on Spring 15. The reward is 25 Calico Eggs."]]]]]],["Notes",2,[["l",0,[[1,["While the Sandfish has a theoretical maximum ",["l","钓鱼","Size"]," of 25\", in actual gameplay it is impossible to catch a Sandfish longer than 23\" due to the Desert pond's tiles only having a maximum ",["l","钓鱼","distance from land"]," of 2. A Fishing level of at least 18 is required to catch a 23\" Sandfish."]]]]]]]}