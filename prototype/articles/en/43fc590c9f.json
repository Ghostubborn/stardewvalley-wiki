{"s":[[null,1,[["p",["The Winter Root is a ",["l","采集","foraging"]," item found only in ",["l","冬季","Winter"],". Wild winter roots do not grow above ground, but instead they are buried in the snow/dirt and must be dug up with a ",["l","锄头","Hoe"]," (no other tools, even ",["l","打造#Bombs","Bombs"],", will work)."]],["p",["The highest chance of finding a Winter Root (17-24%, map-dependent) is when digging up an ",["l","远古斑点","Artifact Spot"],". There is also a 4% chance of finding a Winter Root when digging standard tillable soil in any exterior location. Exceptions are in ",["l","农场","the Farm"],", where Winter Roots can be found at artifact spots, but not standard tillable soil, and both ",["l","沙漠","the Desert"]," and ",["l","姜岛","Ginger Island"],", where Winter Roots can not be found at all. Digging up a Winter Root provides no experience."]],["p",["Winter Roots can also be grown from ",["l","冬季种子","Winter Seeds"],", in which case they are a standard wild-seed crop: they grow above ground, can be harvested without using a tool, give 7 Foraging XP each, and are affected by the ",["l","技能#Foraging","Gatherer"]," and ",["l","技能#Foraging","Botanist"]," professions."]],["p",["Occasionally they may be sold at the ",["l","旅行货车","Traveling Cart"]," or found in ",["l","垃圾桶","Garbage Can"],"s in ",["l","冬季","Winter"],". They may also be dropped by Blue ",["l","史莱姆（怪物）","Slimes"]," (8% chance) in ",["l","矿井","The Mines"]," (floors 41-79) or ",["l","秘密森林","Secret Woods"],". One Winter Root can sometimes be purchased for 500g from ",["l","皮埃尔","Pierre"],"'s booth at the ",["l","冬日星盛宴","Feast of the Winter Star"],"."]],["p",["Putting a Winter Root in a ",["l","种子生产器","Seed Maker"]," will generate 1-3 ",["l","冬季种子","Winter Seeds"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Like"]},[["l","莱纳斯","Linus"],", ",["l","莉亚","Leah"],", ",["l","哈维","Harvey"]]],[{"h":1,"v":["Neutral"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","肯特","Kent"],", ",["l","玛妮","Marnie"],", ",["l","格斯","Gus"],", ",["l","桑迪","Sandy"]]],[{"h":1,"v":["Dislike"]},[["l","塞巴斯蒂安","Sebastian"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","海莉","Haley"],", ",["l","雷欧","Leo"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","山姆","Sam"],", ",["l","谢恩","Shane"],", ",["l","艾利欧特","Elliott"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"]]]]]]],["Bundles",2,[["p",["Winter Root is used in the Crafts Room."]]]],["Recipes",2,[]],["Cooking",3,[["t",[[{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Ingredients"]},{"h":1,"v":["Energy / Health"]},{"h":1,"v":["Buff(s)"]},{"h":1,"v":["Buff Duration"]},{"h":1,"v":["Recipe Source(s)"]},{"h":1,"v":["Sell Price"]}],[[["l","块茎拼盘","Roots Platter"]],["This'll get you digging for more."],[["i","(O)78","Cave Carrot ×1"],["i","(O)412","Winter Root ×1"]],["Energy 125\nHealth 56"],[["l","攻击","Attack (+3)"]],["5m 35s"],[["f","Combat_Skill_Icon.png",24]," ",["l","战斗","Combat"]," Level 3"],["100g"]]]]]],["Crafting",3,[["t",[[{"h":1,"v":["Image"]},{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Ingredients"]},{"h":1,"v":["Recipe Source"]},{"h":1,"v":["Sell Price"]}],[[["f","Winter_Seeds.png",48]],[["l","打造#Seeds","Wild Seeds (Wi)"]],["An assortment of wild winter seeds.\n(Produces 10 Winter Seeds per craft.)"],[["i","(O)418","Crocus ×1"],["i","(O)414","Crystal Fruit ×1"],["i","(O)416","Snow Yam ×1"],["i","(O)412","Winter Root ×1"]],[["f","Foraging_Skill_Icon.png",24]," ",["l","采集","Foraging"]," Level 7"],["30g"]]]]]],["Tailoring",2,[["p",["Winter Root is used in the spool of the ",["l","柳巷2号#Sewing Machine","Sewing Machine"]," to create the ",["f","Shirt267.png",24]," ",["l","裁缝","Orange Bow Shirt"],". It can be used in ",["l","染色","dyeing"],", serving as an orange dye at the dye pots, located in ",["l","艾米丽","Emily"],"'s and ",["l","海莉","Haley"],"'s house, ",["l","柳巷2号","2 Willow Lane"],"."]]]],["Quests",2,[["l",0,[[1,["Winter Root may be randomly requested in ",["l","冬季","Winter"]," at the ",["l","任务#Help Wanted Quests","\"Help Wanted\" board"]," outside ",["l","皮埃尔的杂货店","Pierre's General Store"]," for a reward of 140g and 150 ",["l","友谊","Friendship"]," points."]]]]]],["Trivia",2,[["l",0,[[1,["Winter Roots are the only winter forageable that can be directly put into the ",["l","种子生产器","Seed Maker"],"."]]]]]],["History",2,[["l",0,[[1,[["l","版本历史#1.4","1.4"],": Winter Root can no longer be dug up in the Desert in Winter. Can now be used in ",["l","裁缝","Tailoring"],"."]],[1,[["l","版本历史#1.6","1.6"],": Now sometimes sold at the ",["l","冬日星盛宴","Feast of the Winter Star"],". Can now be made into Juice and Pickles."]]]]]]],"f":[["Source",[["l","锄头","Tilling"]," • ",["l","冬季种子","Winter Seeds"]," • ",["l","史莱姆（怪物）","Blue Slimes"]]],["Season",["Winter"]],["Sell Price",["70g"]]]}