{"s":[[null,1,[["p",["Pale Ale is an ",["l","工匠物品","Artisan Good"]," made from the ",["l","小桶","Keg"]," using ",["l","啤酒花","Hops"],", taking 1-2 days. It is also available at the ",["l","姜岛","Ginger Island Resort"]," for 1,000g. ",["l","潘姆","Pam"]," sells Pale Ale in her ",["l","沙漠节","shop"]," at the ",["l","沙漠节","Desert Festival"]," for 30 Calico Eggs ",["l","卡利科三花蛋","Calico Egg"],"s. When consumed, Pale Ale causes a ",["l","效果","Tipsy"]," buff that decreases ",["l","速度","Speed"]," by 1."]]]],["Aged Values",2,[["p",["Pale Ale can be placed inside a ",["l","木桶","Cask"]," to age from normal quality to silver, gold, and eventually iridium quality. Iridium quality doubles the base sell price of Pale Ale."]],["p",["Normal, silver, and gold quality Pale Ale can be prematurely removed from a cask at any time by striking the cask with an ",["l","斧头","Axe"],", ",["l","锄头","Hoe"],", or ",["l","十字镐","Pickaxe"],"."]],["t",[[{"h":1,"v":["Normal Quality"]},{"h":1,"v":["Silver Quality\n(x 1.25)"]},{"h":1,"v":["Gold Quality\n(x 1.5)"]},{"h":1,"v":["Iridium Quality\n(x 2)"]}],[["300g"],["300g Aged: 9 Days"],["300g Aged: 8 Days\nTotal: 17 Days"],["300g Aged: 17 Days\nTotal: 34 Days"]]]]]],["Gifting",2,[["t",[[{"h":1,"v":["Love"]},[["l","潘姆","Pam"]]],[{"h":1,"v":["Like"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"]]],[{"h":1,"v":["Hate"]},[["l"