{"s":[[null,1,[["p",["The Heavy Furnace is an improved version of the ",["l","熔炉","Furnace"],". It can be ",["l","打造","crafted"]," after claiming ",["l","精通山洞#Masteries","Mining Mastery"],". It takes 25 ores (or 5 quartz or fire quartz) and 3 ",["l","煤炭","Coal"]," to run."]]]],["Smelting",2,[["p",["To smelt any ore, equip it and activate the furnace while there is Coal in inventory. Three units of Coal are required for each smelting operation, regardless of the material or duration. Each possible output stack size is equally likely, i.e. ores have a 50% chance of yielding 5 bars and a 50% chance of yielding 6 bars."]],["p",["When smelting bars, on average, 9% of the ore and 45% of the ",["l","煤炭","Coal"]," is saved in comparison to normal ",["l","熔炉","Furnace"],"s."]],["t",[[{"h":1,"v":["Input"]},{"h":1,"v":["Output"]},{"h":1,"v":["Time to smelt"]},{"h":1,"v":["Sells For (Unit)"]},{"h":1,"v":["Sells For (Average total)"]}],[[["i","(O)458","Bouquet ×1"]],[["i","(O)277","Wilted Bouquet ×1"]],["≤10m"],{"c":2,"v":["100g"]}],[[["i","(O)378","Copper Ore ×25"]],[["i","(O)334","Copper Bar ×5-6"]],["30m"],["60g"],["330g"]],[[["i","(O)80","Quartz ×5"]],[["i","(O)338","Refined Quartz ×5-6"]],["90m (1h 30m)"],["50g"],["275g"]],[[["i","(O)82","Fire Quartz ×5"]],[["i","(O)338","Refined Quartz ×15-20"]],["90m (1h 30m)"],["50g"],["875g"]],[[["i","(O)380","Iron Ore ×25"]],[["i","(O)335","Iron Bar ×5-6"]],["120m (2h)"],["120g"],["660g"]],[[["i","(O)384","Gold Ore ×25"]],[["i","(O)336","Gold Bar ×5-6"]],["300m (5h)"],["250g"],["1,375g"]],[[["i","(O)386","Iridium Ore ×25"]],[["i","(O)337","Iridium Bar ×5-6"]],["480m (8h)"],["1,000g"],["5,500g"]],[[["i","(O)909","Radioactive Ore ×25"]],[["i","(O)910","Radioactive Bar ×5-6"]],["560m (9h 20m)"],["3,000g"],["16,500g"]]]]]],["History",2,[["l",0,[[1,[["l","版本历史#1.6","1.6"],": Introduced."]]]]]]],"f":[["Source",[["l","打造","Crafting"]]],["Ingredients",[["i","(BC)13","Furnace ×2"],["i","(O)335","Iron Bar ×3"],["i","(O)390","Stone ×50"]]],["Sell