{"s":[[null,1,[["p",["Basic Fertilizer is a ",["l","肥料","Fertilizer"]," that helps by improving soil quality. It can be ",["l","打造","crafted"]," or purchased from ",["l","皮埃尔的杂货店","Pierre's General Store"]," for 100g starting on ",["l","春季","Spring"]," 15th of year 1."]],["p",["Basic Fertilizer must be placed on tilled soil before a seed has sprouted."]],["p",["Basic Fertilizer affects only the basic harvest, which means that extra crops gained at a single harvest (i.e., ",["l","咖啡豆","Coffee Bean"],", ",["l","蓝莓","Blueberry"],", ",["l","蔓越莓","Cranberries"],") will be regular quality."]]]],["Chance for Quality Crops",2,[["t",[[{"h":1,"v":[["l","耕种#Farming Skill","Farming level"]]},{"h":1,"v":["% Regular quality"]},{"h":1,"v":["% Silver quality"]},{"h":1,"v":["% Gold quality"]},{"h":1,"v":["Average price"]}],[["0"],["88%"],["8%"],["4%"],["1.04"]],[["1"],["77%"],["15%"],["8%"],["1.08"]],[["2"],["68%"],["20%"],["12%"],["1.11"]],[["3"],["59%"],["26%"],["15%"],["1.14"]],[["4"],["50%"],["31%"],["19%"],["1.17"]],[["5"],["42%"],["35%"],["23%"],["1.20"]],[["6"],["35%"],["39%"],["26%"],["1.23"]],[["7"],["28%"],["42%"],["30%"],["1.25"]],[["8"],["22%"],["44%"],["34%"],["1.28"]],[["9"],["16%"],["47%"],["37%"],["1.30"]],[["10"],["15%"],["44%"],["41%"],["1.32"]],[["11"],["14%"],["41%"],["45%"],["1.33"]],[["12"],["13%"],["39%"],["48%"],["1.34"]],[["13"],["12%"],["36%"],["52%"],["1.35"]],[["14"],["11%"],["33%"],["56%"],["1.36"]]]]]],["Gifting",2,[["t",[[{"h":1,"v":["Dislike"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","雷欧","Leo"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","