{"s":[[null,1,[["p",["The Torch is a ",["l","打造#Lighting","craftable lighting"]," item that can be held to provide light at night, or in dark areas of ",["l","矿井","the Mines"]," for a radius of approximately 3 tiles. They can also be gathered by using a ",["l","锄头","hoe"],", a ",["l","十字镐","pickaxe"],", or an ",["l","斧头","axe"],". Torches can also be placed indoors or outdoors to provide lighting."]],["p",["When placing a ",["l","湿透的报纸","Soggy Newspaper"]," into the ",["l","回收机","Recycling Machine"],", it can sometimes produce 3 torches."]],["p",["Torches do not provide as much light as other sources, but they can be walked on by the player. Torches can also be placed on top of ",["l","打造#Fences","Fences"]," and ",["l","打造#Sprinklers","Sprinklers"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Hate"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","雷欧","Leo"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"]]]]]]],["Recipes",2,[["t",[[{"h":1,"v":["Image"]},{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Ingredients"]},{"h":1,"v":["Recipe Source"]}],[[["f","Jack-O-Lantern.png",48]],[["l","南瓜灯","Jack-O-Lantern"]],["A whimsical fall decoration."],[["i","(O)276","Pumpkin ×1"],["i","(O)93","Torch ×1"]],[["l","万灵节","Spirit's Eve"]," Festival"]]]]]],["Tailoring",2,[["p",["Torch is used in the spool of the ",["l","柳巷2号#Sewing Machine","Sewing Machine"]," to create the ",["l","裁缝","High Heat Shirt"],". ",["f","Shirt225.png",24]," It can be used in ",["l","染色","dyeing"],", serving as a yellow dye at the dye pots, located in ",["l","艾米丽","Emily"],"'s and ",["l","海莉","Haley"],"'s house, ",["l","柳巷2号","2 Willow Lane"],"."]]]],["Trivia",2,[["l",0,[[1,["If you water a torch with a ",["l","喷壶","watering can"],", it will remain lit."]]]]]],["History",2,[["l",0,[[1,[["l","版本历史#1.4","1.4"],": Can now be used in ",["l","裁缝","Tailoring"],"."]],[1,[["l","版本历史#1.6","1.6"],": Can now be placed on top of ",["l","打造#Sprinklers","Sprinklers"],"."]]]]]]],"f":[["Source",[["l","打造","Crafting"]]],["Ingredients",[["i","(O)388","Wood ×1"],["i","(O)92","Sap ×2"]]],["Sell Price",["5g"]]]}