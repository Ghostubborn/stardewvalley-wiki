{"s":[[null,1,[["p",["The Cork Bobber is a ",["l","渔具","tackle"]," that helps ",["l","钓鱼","fishing"]," by increasing the ",["l","钓鱼","fishing bar size"]," by 24 pixels (48 pixels if the player is using an ",["l","高级铱金鱼竿","Advanced Iridium Rod"]," with 2 Cork Bobbers). It can be ",["l","打造","crafted"]," or purchased from ",["l","鱼店","Willy's Fish Shop"]," for 750g after reaching ",["l","钓鱼","Fishing level 7"],". It may also randomly appear at the ",["l","旅行货车","Traveling Cart"]," for 750–1,250g. It can also be found in ",["l","谜之盒","Mystery Box"],"es and ",["l","金色谜之盒","Golden Mystery Box"],"es after reaching Fishing level 6."]],["p",["Only the ",["l","铱金鱼竿","Iridium Rod"]," or the ",["l","高级铱金鱼竿","Advanced Iridium Rod"]," can equip tackle. The Iridium Rod can only attach one tackle at a time, while the Advanced Iridium Rod can attach two. To attach tackle, left-click on the tackle, then right-click on the rod. To remove tackle, first right-click to remove any bait, then right-click to remove the tackle. For an Advanced Iridium Rod, the left tackle will be the first one removed."]],["p",["Tackle does not stack in ",["l","物品栏","inventory"]," or ",["l","宝箱","chest"],"s; each tackle takes up one inventory slot."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Dislike"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","雷欧","Leo"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"]]]]]]],["Bundles",2,[["p",["The Cork Bobber is not used in any ",["l","收集包","bundles"],"."]]]],["Quests",2,[["p",["The Cork Bobber is not used in any ",["l","任务","quests"],"."]]]],["Notes",2,[["l",0,[[1,["This recipe is profitable. It will result in a profit of 105g. However, pressing ",["l","史莱姆泥","Slime"]," into a ",["l","史莱姆蛋","Slime Egg"]," and processing hardwood in the ",["l","碎木机","Wood Chipper"]," results in slightly more profit on average."]]]]]]],"f":[["Source",[["l","鱼店","Fish Shop"]," • ",["l","打造","Crafting"]]],["Ingredients",[["i","(O)388","Wood ×10"],["i","(O)709","Hardwood ×5"],["i","(O)766","Slime ×10"]]],["Sell Price",["250g"]]]}