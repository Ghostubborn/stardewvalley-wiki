{"s":[[null,1,[["p",["The Crab is a ",["l","鱼","fish"]," that can be caught using a ",["l","蟹笼","Crab Pot"]," in any ",["l","蟹笼#Saltwater","saltwater"]," body of water. It can also be dropped by a ",["l","岩石蟹","Rock Crab"]," (15% chance) or ",["l","熔岩蟹","Lava Crab"]," (25% chance) when slain. It can also be gifted by a ",["l","动物#Pets","pet"]," turtle with max ",["l","动物#Friendship","friendship"],", or randomly found at the ",["l","旅行货车","Traveling Cart"]," for 300–1,000g. Five can be purchased from ",["l","艾利欧特","Elliott"],"'s ",["l","沙漠节#Villager Shops","shop"]," at the ",["l","沙漠节","Desert Festival"]," for 30 Calico Eggs ",["l","卡利科三花蛋","Calico Egg"],"s each. Like all fish caught from the crab pot, it cannot be eaten unless it is used in a ",["l","烹饪","Cooking"]," recipe or ",["l","熏鱼","smoked"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Neutral"]},[["l","德米特里厄斯","Demetrius"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","潘姆","Pam"],", ",["l","艾利欧特","Elliott"],", ",["l","威利","Willy"],", ",["l","雷欧","Leo"]]],[{"h":1,"v":["Dislike"]},[["l","罗宾","Robin"],", ",["l","玛鲁","Maru"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","艾米丽","Emily"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","科罗布斯","Krobus"]]],[{"h":1,"v":["Hate"]},[["l","皮埃尔","Pierre"],", ",["l","艾芙琳","Evelyn"],", ",["l","海莉","Haley"]]]]]]],["Bundles",2,[["p",["A Crab is an option for the Fish Tank."]]]],["Recipes",2,[["t",[[{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Ingredients"]},{"h":1,"v":["Energy / Health"]},{"h":1,"v":["Buff(s)"]},{"h":1,"v":["Buff Duratio