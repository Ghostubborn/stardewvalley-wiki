{"s":[[null,1,[["p",["Iron Ore is obtained from ",["l","采矿","Iron Nodes"]," with a ",["l","十字镐","pickaxe"],". Mining an Iron Node will yield between 1 and 3 Iron Ore. The ",["l","技能","Miner Profession"]," can further increase this."]]]],["Locations",2,[["l",0,[[1,["Can be bought at the ",["l","铁匠铺","Blacksmith"]," for 150g each in Year 1 and for 250g each in Year 2+"]],[1,[["l","矿井","The Mines"]," (Floors 41 - 79) have a high concentration of ",["l","采矿","Iron Nodes"]," with potential abundance at Floors 71 - 79."]],[1,["Nodes can spawn in the ",["l","采石场","Quarry"],", the ",["l","采石场矿井","Quarry Mine"],", or in the quarry on the ",["l","农场地图","Hill-top"]," and ",["l","农场地图","Four Corners"]," Farm Maps."]],[1,["Can be found at any floor of the ",["l","骷髅洞穴","Skull Cavern"]," and ",["l","火山地牢","Volcano Dungeon"],"."]],[1,["Can be found by ",["l","锄头","tilling"]," soil in ",["l","矿井","the Mines"],"."]],[1,["Can be found in breakable crates and barrels in ",["l","矿井","the Mines"],"."]],[1,["Can be dropped by ",["l","金属大头","Metal Head"],"s in Floors 81-119 of ",["l","矿井","the Mines"],", by ",["l","石魔","Stone Golem"],"s in Floors 31-39 or by ",["l","史莱姆（怪物）","Iron Slimes"],"."]],[1,["Can be found inside any of the 4 types of ",["l","矿物","Geode"],"."]],[1,["Can be found in ",["l","钓鱼","Fishing Treasure Chests"],"."]],[1,["Can be found by ",["l","淘盘","panning"],"."]],[1,["Occasionally sold at the ",["l","旅行货车","Traveling Cart"]," for 100–1,000g."]],[1,["Can be found in ",["l","垃圾桶","Garbage Can"],"s outside the ",["l","铁匠铺","Blacksmith"],"."]],[1,["Can be ",["l","回收机","recycled"]," from ",["l","垃圾（物品）","Trash"]," with a 21% chance."]],[1,["An ",["l","冰柱鱼","Ice Pip"]," ",["l","鱼塘","Fish Pond"]," can produce 5 Iron Ore when the population of the pond reaches 3."]],[1,["Can be purchased from ",["l","克林特","Clint"],"'s ",["l","沙漠节","shop"]," at the ",["l","沙漠节","Desert Festival"]," for 4 Calico Eggs ",["l","卡利科三花蛋","Calico Egg"],"s each."]]]]]],["Smelting",2,[["p",["Iron ore can be smelted in a ",["l","熔炉","Furnace"]," to create an ",["l","铁锭","Iron Bar"],". The smelting requires 5 iron ore and 1 ",["l","煤炭","coal"]," to begin and takes 2 in-game hours to complete."]]]],["Crafting",2,[["t",[[{"h":1,"v":["Image"]},{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Ingredients"]},{"h":1,"v":["Recipe Source"]}],[[["f","Bomb.png",48]],[["l","炸弹","Bomb"]],["Generates an explosion. Watch out!"],[["i","(O)380","Iron Ore ×4"],["i","(O)382","Coal ×1"]],[["f","Mining_Skill_Icon.png",24]," ",["l","采矿","Mining"]," Level 6"]]]]]],["Gifting",2,[["t",[[{"h":1,"v":["Hate"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","雷欧","Leo"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"]]]]]]],["Tailoring",2,[["p",["Iron Ore can be used in the spool of the ",["l","柳巷2号","Sewing Machine"]," to create the dyeable ",["l","裁缝","Turtleneck Sweater"],". ",["f","Shirt178.png",24]]]]],["Quests",2,[["p",["Ten Iron Ore are requested by ",["l","冰柱鱼","Ice Pip"]," in a ",["l","鱼塘","Fish Pond quest"]," to increase the capacity of the pond from 1 to 3."]]]]],"f":[["Source",[["l","矿井","Mines"]," • ",["l","铁匠铺","Blacksmith"]," • ",["l","钓鱼","Fishing"]," • ",["l","矿物","Geodes"]," • ",["l","淘盘","Panning"]," • ",["l","旅行货车","Traveling Cart"]]],["Sell