{"s":[[null,1,[["p",["The Spice Berry is a ",["l","水果","fruit"]," found via ",["l","采集","foraging"]," throughout Stardew Valley in the ",["l","夏季","Summer"],". It can also be grown from ",["l","夏季种子","Summer Seeds"]," and can be found at any time (randomly) in the ",["l","山洞","Farm Cave"]," if the fruit bat option is chosen. Three Spice Berries can be purchased from ",["l","德米特里厄斯","Demetrius"],"' ",["l","沙漠节","shop"]," at the ",["l","沙漠节","Desert Festival"]," for 10 Calico Eggs ",["l","卡利科三花蛋","Calico Egg"],"s each. It can also randomly be found in ",["l","垃圾桶","Garbage Can"],"s during Summer."]],["p",["Putting a Spice Berry in a ",["l","种子生产器","Seed Maker"]," will generate 1-3 ",["l","夏季种子","Summer Seeds"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Like"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","莱纳斯","Linus"],", ",["l","潘姆","Pam"],", ",["l","肯特","Kent"],", ",["l","莉亚","Leah"],", ",["l","雷欧","Leo"],", ",["l","谢恩","Shane"],", ",["l","艾利欧特","Elliott"],", ",["l","桑迪","Sandy"]]],[{"h":1,"v":["Neutral"]},[["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","艾米丽","Emily"],", ",["l","山姆","Sam"],", ",["l","玛妮","Marnie"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"]]],[{"h":1,"v":["Dislike"]},[["l","阿比盖尔","Abigail"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"]]],[{"h":1,"v":["Hate"]},[["l","艾芙琳","Evelyn"],", ",["l","乔迪","Jodi"],", ",["l","哈维","Harvey"]]]]]]],["Bundles",2,[["p",["A Spice Berry is used in the Crafts Room."]]]],["Recipes",2,[["t",[[{"h":1,"v":["Image"]},{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Ingredients"]},{"h":1,"v":["Recipe Source"]},{"h":1,"v":["Sell Price"]}],[[["f","Summer_Seeds.png",48]],[["l","打造","Wild Seeds (Su)"]],["An ass