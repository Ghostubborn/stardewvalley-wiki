{"s":[[null,1,[["p",["Void Mayonnaise is an ",["l","工匠物品","Artisan Good"]," made by placing a ",["l","虚空蛋","Void Egg"]," inside the ",["l","蛋黄酱机","Mayonnaise Machine"],". It can also be obtained by ",["l","钓鱼","fishing"]," in the ",["l","巫婆沼泽","Witch's Swamp"]," if the player does not have one in inventory and the ",["l","仆从","Henchman"]," is guarding the ",["l","女巫小屋","Witch's Hut"]," (5% chance)."]],["p",["Gifting a Void Mayonnaise to the Henchman outside the ",["l","女巫小屋","Witch's Hut"]," will allow players to pass during the quest ",["l","任务","Goblin Problem"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Love"]},[["l","科罗布斯","Krobus"]]],[{"h":1,"v":["Hate"]},[["l","塞巴斯蒂安","Sebastian"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","山姆","Sam"],", ",["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","卡洛琳","Caroline"],", ",["l","雷欧","Leo"]]]]]]],["Bundles",2,[["p",["Void Mayonnaise is not used in any ",["l","收集包","bundles"],"."]]]],["Recipes",2,[["t",[[{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Ingredients"]},{"h":1,"v":["Energy / Health"]},{"h":1,"v":["Recipe Source(s)"]},{"h":1,"v":["Sell Price"]}],[[["l","奇怪的小面包","Strange Bun"]],["What's inside?"],[["i","(O)246","Wheat Flour ×1"],["i","(O)722","Periwinkle ×1"],["i","(O)308","Void Mayonnaise ×1"]],["Energy 100\nHealth 45"],[["l","谢恩","Shane"]," (Mail - 7+ ❤)"],["225g"]]]]]],