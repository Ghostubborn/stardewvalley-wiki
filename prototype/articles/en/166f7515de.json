{"s":[[null,1,[["p",["The Cave Carrot is found via ",["l","采集","foraging"]," in ",["l","矿井","The Mines"],". It can also be found in ",["l","垃圾桶","Garbage Can"],"s. Large quantities can be easily obtained by digging underground patches of dirt in ",["l","矿井","The Mines"]," (on levels 10-20) with the ",["l","锄头","Hoe"],". It may also randomly be found in the ",["l","旅行货车","Traveling Cart"]," stock for 100–1,000g. ",["l","文森特","Vincent"]," sells a Cave Carrot in his ",["l","沙漠节","shop"]," at the ",["l","沙漠节","Desert Festival"]," for 2 Calico Eggs ",["l","卡利科三花蛋","Calico Egg"],"s. One Cave Carrot can sometimes be purchased for 500g from ",["l","皮埃尔","Pierre"],"'s booth at the ",["l","冬日星盛宴","Feast of the Winter Star"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Like"]},[["l","矮人","Dwarf"]]],[{"h":1,"v":["Dislike"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","雷欧","Leo"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"]]]]]]],["Bundles",2,[["p",["Cave Carrot is one of the options for the Crafts Room."]]]],["Recipes",2,[["t",[[{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Ingredients"]},{"h":1,"v":["Energy / Health"]},{"h":1,"v":["Buff(s)"]},{"h":1,"v":["Buff Duration"]},{"h":1,"v":["Recipe Source(s)"]},{"h":1,"v":["Sell Price"]}],[[["l","矿工特供","Miner's Treat"]],["This should keep your energy up."],[["i","(O)78","Cave Carrot ×2"],["i","(O)245","Sugar ×1"],["i","(O)184","Milk ×1"]],["Energy 125\nHealth 56"],[["l","采矿","Mining (+3)"],["l","磁性","Magnetism (+32)"]],["5m 35s"],[["l","采矿","Mining"]," Level 3"],["200g"]],[[["l","块茎拼盘","Roots Platter"]],["This'll get you digging for more."],[["i","(O)78","Cave Carrot ×1"],["i","(O)412","Winter Root ×1"]],["Energy 125\nHealth 56"],[["l","攻击","Attack (+3)"]],["5m 35s"],[["l","战斗","Combat"]," Level 3"],["100g"]],[[["l","蔬菜什锦盖饭","Stir Fry"]],["Julienned vegetables on a bed of rice."],[["i","(O)78","Cave Carrot ×1"],["i","(O)404","Common Mushroom ×1"],["i","(O)250","Kale ×1"],["i","(O)247","Oil ×1"]],["Energy 200\nHealth 90"],["N/A"],["N/A"],["The Queen of Sauce (7 Spring, Year 1)"],["335g"]],[[["l","救生汉堡","Survival Burger"]],["A convenient snack for the explorer."],[["i","(O)216","Bread ×1"],["i","(O)78","Cave Carrot ×1"],["i","(O)272","Eggplant ×1"]],["Energy 125\nHealth 56"],[["l","采集","Foraging (+3)"]],["5m 35s"],[["l","采集","Foraging"]," Level 8"],["180g"]]]]]],["Tailoring",2,[["p",["Cave Carrot is used in the spool of the ",["l","柳巷2号","Sewing Machine"]," with ",["l","布料","Cloth"]," in the feed to create a ",["l","裁缝","Green Belted Shirt"],". It is a brown dye when used in the spool of the Sewing Machine with a dyeable clothing item in the feed. It can be placed in the orange dye pot at Emily's and Haley's house for use in ",["l","染色","dyeing"],"."]]]],["Quests",2,[["l",0,[[1,["The Cave Carrot may be randomly requested during any ",["l","季节","season"]," at the ",["l","任务","\"Help Wanted\" board"]," outside ",["l","皮埃尔的杂货店","Pierre's General Store"]," for a reward of 75g and 150 ",["l","友谊","Friendship"]," points."]],[1,["One, two, or five Cave Carrots may be requested by several fish in ",["l","鱼塘","Fish Pond quests"],"."]],[1,["After reaching 3 ",["l","友谊","friendship"]," hearts with ",["l","玛妮","Marnie"],", she will request that you bring her a Cave Carrot in the ",["l","任务","\"Marnie's Request\" quest"],". The reward is 100 ",["l","友谊","friendship"]," points with ",["l","玛妮","Marnie"],"."]],[1,["5 Cave Carrots may be requested by the Raccoon at the ",["l","大树桩（地点）","Giant Stump"]," as part of his third request, or as part of any request starting with the sixth."]]]]]],["Trading",2,[["p",["Once unlocked, the Raccoon's wife near the ",["l","大树桩（地点）","Giant Stump"]," will trade for Cave Carrots."]],["t",[[{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Price"]},{"h":1,"v":["Requirements"]}],[[["l","混合种子","Mixed Seeds"]],["There's a little bit of everything here. Plant them and see what grows!"],[["i","(O)78","Cave Carrot ×1"]],["4th Request Completed"]]]]]]],"f":[["Source",[["l","采集","Foraging"]]],["Season",["All"]],["Sell Price",["25g"]]]}