{"s":[[null,1,[["p",["Jellies and Pickles can be produced by inserting either a ",["l","水果","fruit"]," or a ",["l","蔬菜","vegetable"]," / ",["l","采集","foraged item"]," in a ",["l","罐头瓶","preserves jar"],", respectively. The value of a single jar of jelly or pickles is equal to (2 * Base ",["l","农作物","Crop"]," Value + 50). Jelly and pickles are unaffected by the quality of the fruit or vegetable used."]],["p",["A ",["l","罐头瓶","preserves jar"]," requires 4000 minutes, or 2-3 days, to produce jelly or pickles."]],["t",[[{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Ingredients"]},{"h":1,"v":["Recipe Source"]}],[[["l","罐头瓶","Preserves Jar"]],["Turns vegetables into pickles and fruit into jam."],[["i","(O)388","Wood ×50"],["i","(O)390","Stone ×40"],["i","(O)382","Coal ×8"]],[["l","耕种","Farming"]," Level 4"]]]]]],["Products",2,[["p",["Quality of ingredients makes no difference to the finished product. The value of the finished product is determined using the base value (i.e., with no silver or gold star) of the ",["l","水果","fruit"],"/",["l","蔬菜","vegetable"],". However, the preserved version is always at least as profitable as even gold star produce, although the profit margin is lower compared to normal produce."]],["t",[[{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Ingredients"]},{"h":1,"v":["Processing Time"]},{"h":1,"v":["Sell Price"]},{"h":1,"v":["Energy / Health"]}],[[["l","果酱和腌菜","Pickles"]],["A jar of your home-made pickles."],["Any ",["l","蔬菜","vegetable"]," (1) or any positive energy ",["l","采集","Forage"]," (1)"],["4000m (2-3 days)"],["2 × Base Ingredient Price + 50"],["Energy 1.75 × Base Ingredient EnergyHealth 1.75 × Base Ingredient Health"]],[[["l","果酱和腌菜","Jelly"]],["Gooey."],["Any ",["l","水果","fruit"]," (1)"],["4000m (2-3 days)"],["2 × Base ",["l","水果","Fruit"]," Price + 50"],["Energy 2 × Base ",["l","水果","Fruit"]," EnergyHealth 2 × Base ",["l","水果","Fruit"]," Health"]]]],["p",["Notes"]],["l",0,[[1,["Pickles made from an inedible vegetable will instead give 0.625 × Base ",["l","蔬菜","Vegetable"]," Price and 0.28125 × Base ",["l","蔬菜","Vegetable"]," Price."]],[1,["Jelly made from an inedible fruit will instead give 0.5 × Base ",["l","水果","Fruit"]," Price and 0.225 × Base ",["l","水果","Fruit"]," Price."]],[1,["The following foraged items can be pickled: ",["l","山洞萝卜","Cave Carrot"],", ",["l","鸡油菌","Chanterelle"],", ",["l","普通蘑菇","Common Mushroom"],", ",["l","蒲公英","Dandelion"],", ",["l","姜","Ginger"],", ",["l","榛子","Hazelnut"],", ",["l","韭葱","Leek"],", ",["l","熔岩菇","Magma Cap"],", ",["l","羊肚菌","Morel"],", ",["l","紫蘑菇","Purple Mushroom"],", ",["l","雪山药","Snow Yam"],", ",["l","大葱","Spring Onion"],", ",["l","野山葵","Wild Horseradish"],", and ",["l","冬根","Winter Root"],"."]],[1,["The color of Jelly or Pickles changes depending on the item used to make it."]]]]]],["Gifting Jelly",2,[["t",[[{"h":1,"v":["Like"]},[["l","潘姆","Pam"],", ",["l","海莉","Haley"],", ",["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","莱纳斯","Linus"],", ",["l","哈维","Harvey"],", ",["l","潘妮","Penny"],", ",["l","格斯","Gus"],", ",["l","艾芙琳","Evelyn"],", ",["l","阿比盖尔","Abigail"],", ",["l","乔治","George"],", ",["l","亚历克斯","Alex"],", ",["l","克林特","Clint"],", ",["l","谢恩","Shane"],", ",["l","威利","Willy"],", ",["l","艾利欧特","Elliott"],", ",["l","科罗布斯","Krobus"],", ",["l","莉亚","Leah"],", ",["l","乔迪","Jodi"],", ",["l","山姆","Sam"],", ",["l","玛妮","Marnie"],", ",["l","法师","Wizard"],", ",["l","肯特","Kent"],", ",["l","矮人","Dwarf"],", ",["l","刘易斯","Lewis"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","桑迪","Sandy"],", ",["l","艾米丽","Emily"],", ",["l","玛鲁","Maru"],", ",["l","文森特","Vincent"],", ",["l","贾斯","Jas"],", ",["l","雷欧","Leo"]]],[{"h":1,"v":["Hate"]},[["l","塞巴斯蒂安","Sebastian"]]]]]]],["Gifting Pickles",2,[["t",[[{"h":1,"v":["Love"]},[["l","哈维","Harvey"]]],[{"h":1,"v":["Like"]},[["l","潘姆","Pam"],", ",["l","海莉","Haley"],", ",["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","莱纳斯","Linus"],", ",["l","潘妮","Penny