{"s":[[null,1,[["p",["The Ancient Doll is an ",["l","古物","Artifact"]," that can be found by digging up an ",["l","远古斑点","Artifact Spot"]," in ",["l","深山","The Mountain"],", ",["l","煤矿森林","Cindersap Forest"],", ",["l","巴士站","Bus Stop"],", or ",["l","鹈鹕镇","Pelican Town"],", and inside ",["l","钓鱼#Treasure Chests","Fishing Treasure Chests"]," and ",["l","古物宝藏","Artifact Trove"],"s. It can also be received as a gift from ",["l","贾斯","Jas"],", ",["l","雷欧","Leo"],", or ",["l","文森特","Vincent"]," at the ",["l","冬日星盛宴","Feast of the Winter Star"],". It can also be gifted by a ",["l","动物#Pets","pet"]," dog with max ",["l","动物#Friendship","friendship"],"."]],["p",["It is sold by Jas at the ",["l","沙漠节","Desert Festival"]," for 1 Calico Egg ",["l","卡利科三花蛋","Calico Egg"],"."]]]],["Donation",2,[["p",["Donation of this item contributes to the total count of donations for the ",["l","博物馆","Museum"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Love"]},[["l","贾斯","Jas"]]],[{"h":1,"v":["Like"]},[["l","矮人","Dwarf"],", ",["l","潘妮","Penny"]]],[{"h":1,"v":["Dislike"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"],", ",["l","雷欧","Leo"]]]]]]],["Bundles",2,[["p",["Ancient Doll is an option in the Childrens Bundle."]]]],["Tailoring",2,[["p",["Ancient Doll is used in the spool of the ",["l","柳巷2号#Sewing Machine","Sewing Machine"]," to create the ",["l","裁缝","Doll Shirt"],". ",["f","Shirt229.png",24]," It can be used in ",["l","染色","dyeing"],", serving as a blue dye at the dye pots, located in ",["l","艾米丽","Emily"],"'s and ",["l","海莉","Haley"],"'s house, ",["l","柳巷2号","2 Willow Lane"],"."]]]],["Quests",2,[["p",["Ancient Doll is not used in any ",["l","任务","quests"],"."]]]],["Secrets",2,[["l",0,[[1,["The Ancient Doll is a recurring part of the ",["l","彩蛋#Dove Children","dove children secrets"],"."]],[1,["The Ancient Doll can be used to obtain a ",["l","异界晶石","secret item"]," by throwing it (right-clicking) into the lava pool on floor 100 of ",["l","矿井","the Mines"]," or in the ",["l","锻造","Volcano Caldera"],"."]]]]]],["History",2,[["l",0,[[1,[["l","版本历史#1.0","1.0"],": Introduced."]],[1,[["l","版本历史#1.4","1.4"],": Added ",["l","古物宝藏","Artifact Trove"]," as a source. Can now be used in ",["l","裁缝","Tailoring"],". Added secret source."]],[1,[["l","版本历史#1.5","1.5"],": ",["l","古物","Artifacts"]," are now liked by the ",["l","矮人","Dwarf"]," and ",["l","潘妮","Penny"],", disliked by all other NPCs. Is now used in a remixed bundle."]],[1,[["l","版本历史#1.6","1.6"],": Can now be used to obtain ",["l","异界晶石","Far Away Stone"],". Now obtainable during Desert Festival. Now loved by ",["l","贾斯","Jas"],". Can now be gifted by a ",["l","动物#Pets","pet"]," dog with max ",["l","动物#Friendship","friendship"],"."]]]]]]]}