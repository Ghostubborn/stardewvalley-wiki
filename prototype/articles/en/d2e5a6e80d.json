{"s":[[null,1,[["p",["The Ancient Sword is an ",["l","古物","Artifact"]," that can be found by digging up an ",["l","远古斑点","Artifact Spot"]," in ",["l","煤矿森林","Cindersap Forest"]," or ",["l","深山","the Mountain"],"s, and from ",["l","钓鱼","Fishing Treasure Chests"]," or ",["l","古物宝藏","Artifact Trove"],"s. It can also be gifted by a ",["l","动物","pet"]," dog with max ",["l","动物","friendship"],"."]]]],["Donation",2,[["p",["Donation of this item contributes to the total count of donations for the ",["l","博物馆","Museum"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Like"]},[["l","矮人","Dwarf"],", ",["l","潘妮","Penny"],", ",["l","阿比盖尔","Abigail"]]],[{"h":1,"v":["Dislike"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"],", ",["l","雷欧","Leo"]]]]]]],["Bundles",2,[["p",["Ancient Sword is not used in any ",["l","收集包","bundles"],"."]]]],["Recipes",2,[["p",["Ancient Sword is not used in any recipes."]]]],["Tailoring",2,[["p",["Ancient Sword is used in the spool of the ",["l","柳巷2号","Sewing Machine"]," with ",["l","布料","Cloth"]," in the feed to create a ",["l","裁缝","Green Tunic"],". It is a gray dye when used in the spool of the Sewing Machine with a dyeable clothing item in the feed."]]]],["Quests",2,[["p",["Ancient Sword is not used in any ",["l","任务","quests"],"."]]]],["Trivia",2,[["p",["The green tunic ",["l","裁缝","tailored"]," from ancient sword and ",["l","布料","cloth"]," is similar to the green tunic worn by Link in The Legend of Zelda series of video games."]]]]]}