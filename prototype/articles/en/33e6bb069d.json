{"s":[[null,1,[["p",["The Tiger Trout is a ",["l","鱼","fish"]," that can be caught in the river (in ",["l","鹈鹕镇","Pelican Town"]," or ",["l","煤矿森林","Cindersap Forest"],") and the ",["l","农场地图","Riverlands Farm"],", ",["l","农场地图","Forest Farm"],", ",["l","农场地图","Meadowlands Farm"],", or ",["l","农场地图","Hill-Top Farm"]," during ",["l","秋季","Fall"]," and ",["l","冬季","Winter"],". It can also be gifted by a ",["l","动物","pet"]," cat with max ",["l","动物","friendship"],". It may also randomly appear in ",["l","科罗布斯","Krobus"],"' shop on ",["l","周循环","Wednesdays"]," for 200g, or at the ",["l","旅行货车","Traveling Cart"]," for 450–1,000g."]],["p",["Tiger Trout can be caught regardless of time of day or season using ",["l","魔法鱼饵","Magic Bait"],"."]]]],["Map",2,[["p",["The Tiger Trout can be found in the river."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Like"]},[["l","威利","Willy"]]],[{"h":1,"v":["Neutral"]},[["l","德米特里厄斯","Demetrius"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","潘姆","Pam"],", ",["l","艾利欧特","Elliott"],", ",["l","雷欧","Leo"]]],[{"h":1,"v":["Dislike"]},[["l","罗宾","Robin"],", ",["l","玛鲁","Maru"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","艾米丽","Emily"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","科罗布斯","Krobus"]]],[{"h":1,"v":["Hate"]},[["l","皮埃尔","Pierre"],", ",["l","艾芙琳","Evelyn"],", ",["l","海莉","Haley"]]]]]]],["Bundles",2,[["p",["Tiger Trout is used in the Fish Tank."]]]],["Recipes",2,[["t",[[{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Ingredients"]},{"h":1,"v":["Energy / Health"]},{"h":1,"v":["Recipe Source(s)"]},{"h