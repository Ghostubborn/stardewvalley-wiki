{"s":[[null,1,[["p",["Deluxe Fertilizer is a ",["l","肥料","Fertilizer"]," that improves the chance to grow a ",["l","农作物","quality crop"],". It can be placed on tilled soil before or after planting a seed, or at any stage of crop growth. Use of Deluxe Fertilizer allows for the chance to gain iridium quality crops on harvest. Using this fertilizer is the only way to get an iridium quality crop."]],["p",["Deluxe Fertilizer only affects the basic harvest, which means that extra crops gained at harvest (i.e., ",["l","咖啡豆","Coffee Bean"],", ",["l","蓝莓","Blueberry"],", ",["l","蔓越莓","Cranberries"],") will be of regular quality."]],["p",["The recipe can be purchased for 20 Qi Gems."]]]],["Chance for Quality Crops",2,[["p",["Normal quality crops cannot be produced when using Deluxe Fertilizer."]],["t",[[{"h":1,"v":[["l","耕种","Farming level"]]},{"h":1,"v":["% Silver quality"]},{"h":1,"v":["% Gold quality"]},{"h":1,"v":["% Iridium Quality"]},{"h":1,"v":["Average price"]}],[["0"],["84%"],["10%"],["6%"],["1.32"]],[["1"],["75%"],["16%"],["9%"],["1.36"]],[["2"],["66%"],["22%"],["13%"],["1.40"]],[["3"],["57%"],["27%"],["16%"],["1.44"]],[["4"],["49%"],["31%"],["20%"],["1.47"]],[["5"],["42%"],["35%"],["23%"],["1.51"]],[["6"],["35%"],["39%"],["27%"],["1.55"]],[["7"],["28%"],["42%"],["30%"],["1.58"]],[["8"],["22%"],["45%"],["34%"],["1.61"]],[["9"],["16%"],["47%"],["37%"],["1.64"]],[["10"],["11%"],["48%"],["41%"],["1.67"]],[["11"],["7%"],["49%"],["44%"],["1.70"]],[["12"],["3%"],["50%"],["47%"],["1.73"]],[["13"],["0%"],["49%"],["51%"],["1.76"]],[["14"],["0%"],["46%"],["55%"],["1.77"]]]]]],["Gifting",2,[["t",[[{"h":1,"v":["Dislike"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","雷欧","Leo"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],"