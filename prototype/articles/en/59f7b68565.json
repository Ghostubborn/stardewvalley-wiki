{"s":[[null,1,[["p",["The Fiddlehead Fern is a ",["l","蔬菜","vegetable"]," that can be found:"]],["l",0,[[1,[["l","采集","Foraging"]," in the ",["l","秘密森林","Secret Woods"]," during ",["l","夏季","Summer"]," (78%)."]],[1,["Foraging in the ",["l","骷髅洞穴#Prehistoric Floors","Prehistoric floors"]," of the ",["l","骷髅洞穴","Skull Cavern"],"."]],[1,["Foraging on levels 41-69 of ",["l","矿井","the Mines"]," while the ",["l","矿井#Shrine of Challenge","Shrine of Challenge"]," is active."]],[1,["Foraging in the ",["l","姜岛#Island East","Ginger Island jungle"]," in all ",["l","季节","seasons"],"."]],[1,["Occasionally at the ",["l","旅行货车","Traveling Cart"]," for 270–1,000g."]],[1,["By chopping ",["l","绿雨树","Green Rain Trees (type 3)"]," during ",["l","天气","Green Rain"],"."]],[1,["By placing a ",["l","树液采集器","Tapper"]," on fully-grown ",["l","绿雨树","Green Rain Trees (type 3)"],"."]],[1,["In ",["l","肯特","Kent"],"'s ",["l","沙漠节#Villager Shops","shop"]," at the ",["l","沙漠节","Desert Festival"]," for 10 Calico Eggs ",["l","卡利科三花蛋","Calico Egg"],"s."]]]],["p",["The Fiddlehead Fern is the only foraged item categorized as a vegetable. Being a vegetable, its sell price benefits from the ",["l","技能#Farming","Tiller"]," 10% bonus and it can be turned into ",["l","果酱","Pickles"]," or ",["l","果汁","Juice"]," using a ",["l","罐头瓶","Preserves Jar"]," or ",["l","小桶","Keg"],". However, it also receives several ",["l","采集","Foraging"],"-related benefits, because it is obtained by foraging. Specifically, 7 Foraging XP is granted per fern and it benefits from the ",["l","技能#Foraging","Gatherer"]," double-harvest bonus and ",["l","技能#Foraging","Botanist"]," iridium-quality bonus."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Like"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","雷欧","Leo"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"]]],[{"h":1,"v":["Dislike"]},[["l","阿比盖尔","Abigail"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","山姆","Sam"]]]]]]],["Bundles",2,[["l",0,[[1,["Fiddlehead Fern is used in the Bulletin Board."]],[1,["Five Fiddlehead Ferns are one of the options for the Wild Medicine Bundle."]]]]]],["Recipes",2,[["t",[[{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Ingredients"]},{"h":1,"v":["Energy / Health"]},{"h":1,"v":["Recipe Source(s)"]},{"h":1,"v":["Sell Price"]}],[[["l","意式蕨菜炖饭","Fiddlehead Risotto"]],["A creamy rice dish served with sauteed fern heads. It's a little bland."],[["i","(O)247","Oil ×1"],["i","(O)259","Fiddlehead Fern ×1"],["i","(O)248","Garlic ×1"]],["Energy 225\nHealth 101"],["The Queen of Sauce (28 Fall, Year 2)"],["350g"]]]]]],["Tailoring",2,[["p",["Fiddlehead Fern is used in the spool of the ",["l","柳巷2号#Sewing Machine","Sewing Machine"]," with ",["l","布料","Cloth"]," in the feed to create ",["l","裁缝","Green Overalls"],". It is a green dye when used in the spool of the Sewing Machine with a dyeable clothing item in the feed. It can be placed in the green dye pot at Emily's and Haley's house for use in ",["l","染色","dyeing"],"."]]]],["Quests",2,[["p",["Fiddlehead Fern is not used in any ",["l","任务","quests"],"."]]]],["History",2,[["l",0,[[1,[["l","版本历史#1.4","1.4"],": Added to Prehistoric Levels in the ",["l","骷髅洞穴","Skull Cavern"],". Can now be used in ",["l","裁缝","Tailoring"],"."]],[1,[["l","版本历史#1.5","1.5"],": Can now be found on ",["l","姜岛","Ginger Island"],". Is now an option in the Wild Medicine Bundle."]],[1,[["l","版本历史#1.6","1.6"],": Can now be obtained from ",["l","绿雨树","Green Rain Trees (type 3)"],". Now obtainable during ",["l","沙漠节","Desert Festival"],"."]]]]]]],"f":[["Source",[["l","采集","Foraging"]]],["Season",["Summer\nAny season on ",["l","姜岛#Island East","Ginger Island Jungle"],", ",["l","骷髅洞穴","Skull Cavern"]," and ",["l","矿井#Shrine of Challenge","Dangerous Mines"]]],["Sell Price",["90g"]]]}