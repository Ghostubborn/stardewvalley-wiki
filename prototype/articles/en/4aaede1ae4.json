{"s":[[null,1,[["p",["A Bat Wing is a type of ",["l","怪物战利品","Monster Loot"]," dropped by ",["l","蝙蝠","Bats"]," (any variant except for Iridium Bats) when slain. 10 Bat Wings can also be purchased for 30g each from ",["l","科罗布斯","Krobus"]," on ",["l","周循环","Sundays"],". It can also be gifted by a ",["l","动物","pet"]," cat with max ",["l","动物","friendship"],"."]],["p",["The ",["l","沙漠商人","Desert Trader"]," in ",["l","沙漠","the Calico Desert"]," will trade one ",["l","蝴蝶笼","Butterfly Hutch"]," for 200 Bat Wings."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Hate"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"],", ",["l","雷欧","Leo"]]]]]]],["Bundles",2,[["l",0,[[1,["Ten Bat Wings are an option for the Boiler Room."]],[1,["Ten Bat Wings are required for the Spirit's Eve Bundle."]]]]]],["Crafting",2,[["t",[[{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Ingredients"]},{"h":1,"v":["Recipe Source"]}],[[["l","避雷针","Lightning Rod"]],["Collects energy from lightning storms and turns it into battery packs."],[["i","(O)767","Bat Wing ×5"],["i","(O)335","Iron Bar ×1"],["i","(O)338","Refined Quartz ×1"]],[["l","采集","Foraging"]," Level 6"]],[[["l","怪兽香水","Monster Musk"]],["Spray this on to draw more monsters out of