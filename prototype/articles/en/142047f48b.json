{"s":[[null,1,[["p",["Cloth is an ",["l","工匠物品","Artisan Good"]," made from the ",["l","织布机","Loom"]," using ",["l","动物毛","Wool"],", taking 4 hours. Occasionally the Traveling Cart will offer it in her rotating stock. It can also be made by recycling a ",["l","湿透的报纸","Soggy Newspaper"]," using the ",["l","回收机","Recycling Machine"],", or dropped from ",["l","木乃伊","Mummies"]," when slain. ",["l","艾米丽","Emily"]," may occasionally send you a Cloth in the mail. She also sells a set of five Cloth at her ",["l","沙漠节","shop"]," at the ",["l","沙漠节","Desert Festival"]," for 25 Calico Eggs ",["l","卡利科三花蛋","Calico Egg"],"s. The ",["l","沙漠商人","Desert Trader"]," will trade three ",["l","海蓝宝石","Aquamarine"],"s for one cloth on Wednesdays."]],["p",["Placing quality ",["l","动物毛","Wool"]," into a ",["l","织布机","Loom"]," gives a chance to produce 2 Cloth. Silver gives a 10% chance, gold gives a 50% chance, and iridium gives a 100% chance."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Love"]},[["l","艾米丽","Emily"]]],[{"h":1,"v":["Like"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","海莉","Haley"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"],", ",["l","雷欧","Leo"]]],[{"h":1,"v":["Hate"]},[["l","塞巴斯蒂安","Sebastian"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"]]]]]]],["Bundles",2,[["p",["Cloth is an option for the Pantry."]]]],["Crafting",2,[["p",["In addition to ",["l","裁缝","Tailoring"]," clothing, cloth is used to make the following items:"]],["t",[[{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Ingredients"]},{"h":1,"v":["Recipe Source"]}],[[["l","精装旋式鱼饵","Dressed Spinner"]],["The metal tab and colorful streamers create an enticing spectacle for fish. Increases the bite-rate when fishing."],[["i","(O)335","Iron Bar ×2"],["i","(O)428","Cloth ×1"]],[["l","钓鱼","Fishing"]," Level 8"]],[[["l","便携帐篷","Tent Kit"]],["Use this to deploy a one-time-use tent for sleeping. Can only be used outdoors."],[["i","(O)709","Hardwood ×10"],["i","(O)771","Fiber ×25"],["i","(O)428","Cloth ×1"]],[["l","采集","Foraging"]," Level 8"]]]]]],["Building",2,[["p",["Cloth is required to purchase the following buildings from the ",["l","木匠的商店","Carpenter's Shop"],":"]],["t",[[{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Ingredients"]}],[[["l","磨坊","Mill"]],["Allows you to mill wheat, beets and rice."],[["i","(O)390","Stone ×50"],["i","(O)388","Wood ×150"],["i","(O)428","Cloth ×4"]]]]]]],["Quests",2,[["p",["Cloth is not used in any quests."]]]]],"f":[["Source",[["l","工匠物品","Artisan Goods"],["l","回收机","Recycling"],["l","木乃伊","Mummy"],["l","沙漠商人","Desert Trader"],["l","旅行货车","Traveling Cart"]]],["Equipment",[["i","(BC)17","Loom"]]],["Ingredients",[["i","(O)440","Wool ×1"]]],["Processing Time",["240m (≈4h)"]],["Sell Price",["470g"]]]}