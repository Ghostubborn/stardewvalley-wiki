{"s":[[null,1,[["p",["Aquamarine is a ",["l","矿物","Mineral"],". It can be obtained from ",["l","采矿","Aquamarine Node"],"s and ",["l","采矿","Gem Node"],"s in ",["l","矿井","the Mines"]," (floors 40+), from ",["l","淘盘","panning"],", and from ",["l","钓鱼","Fishing Treasure Chests"],". It has a 10% chance to be dropped by a slain ",["l","矮人哨兵","Dwarvish Sentry"]," in the ",["l","火山地牢","Volcano Dungeon"],". It may occasionally be found in a ",["l","垃圾桶","Garbage Can"]," after the player has reached the bottom of the mines."]],["p",["The ",["l","沙漠商人","Desert Trader"]," in the ",["l","沙漠","Calico Desert"]," will trade one ",["l","布料","Cloth"]," in exchange for three Aquamarine on ",["l","周循环","Wednesday"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Love"]},[["l","克林特","Clint"],", ",["l","艾米丽","Emily"],", ",["l","矮人","Dwarf"]]],[{"h":1,"v":["Like"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"],", ",["l","雷欧","Leo"]]],[{"h":1,"v":["Dislike"]},[["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","莉亚","Leah"]]]]]]],["Bundles",2,[["l",0,[[1,["Aquamarine is used in the Bulletin Board."]],[1,["Aquamarine is one of the options for the treasure hunter Bundle."]]]]]],["Forging",2,[["p",["Aquamarine can be used at the ",["l","锻造","Forge"]," to increase the critical hit chance of a melee weapon."]]]],["Recipes",2,[["t",[[{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Ingredients"]},{"h":1,"v":["Recipe Source"]}],[[["l","大理石火炬","Marble Brazier"]],["Provides a moderate amount of light."],[["i","(O)567","Marble ×1"],["i","(O)62","Aquamarine ×1"],["i","(O)390","Stone ×100"]],[["l","木匠的商店","Carpenter's Shop"]," for 5,000g"]]]]]],["Tailoring",2,[["p",["Aquamarine is used in the spool of the ",["l","柳巷2号","Sewing Machine"]," to create a ",["l","裁缝","Shirt"],". It can be used in ",["l","染色","dyeing"],", serving as a blue dye at the dye pots, located in ",["l","艾米丽","Emily"],"'s and ",["l","海莉","Haley"],"'s house, ",["l","柳巷2号","2 Willow Lane"],"."]]]],["Quests",2,[["l",0,[[1,["Aquamarine may be randomly requested during any season at the ",["l","任务","\"Help Wanted\" board"]," outside ",["l","皮埃尔的杂货店","Pierre's General Store"]," for a reward of 540g and 150 ",["l","友谊","Friendship"]," points. Aquamarine will never be requested until you have reached floors 40+ of ",["l","矿井","The Mines"],"."]],[1,["2 Aquamarine may be requested by several ocean fish in ",["l","鱼塘","Fish Pond quests"]," to increase the capacity of the pond from 7 to 10."]],[1,["May be used in the ",["l","姜岛","Gem Birds"]," puzzle on Ginger Island."]]]]]]]}