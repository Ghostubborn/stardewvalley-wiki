{"s":[[null,1,[["p",["The Ice Pip is a ",["l","鱼","fish"]," that can be caught in ",["l","矿井","the Mines"]," on the 60th floor during all seasons. The only other fish that can be caught there is the ",["l","鬼鱼","Ghostfish"],"."]],["p",["The chances of hooking an Ice Pip depends on fishing level and on the distance from land of the spot fished, increasing by 4.5% if a ",["l","珍稀诱钩","Curiosity Lure"]," is equipped and by 9% if ",["l","针对性鱼饵","Ice Pip Bait"]," is equipped. For example, at level 10 fishing and distance of 5, the chances of hooking an Ice Pip is 6.45%. This increases to 10.95% with a Curiosity Lure equipped, to 15.45% with Ice Pip Bait equipped, and to 19.95% with both a Curiosity Lure and Ice Pip Bait equipped."]]]],["Map",2,[["p",["The Ice Pip can be found in The Mines."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Neutral"]},[["l","德米特里厄斯","Demetrius"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","潘姆","Pam"],", ",["l","艾利欧特","Elliott"],", ",["l","威利","Willy"],", ",["l","雷欧","Leo"]]],[{"h":1,"v":["Dislike"]},[["l","罗宾","Robin"],", ",["l","玛鲁","Maru"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","艾米丽","Emily"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","科罗布斯","Krobus"]]],[{"h":1,"v":["Hate"]},[["l","皮埃尔","Pierre"],", ",["l","艾芙琳","Evelyn"],", ",["l","海莉","Haley"]]]]]]],["Bundles",2,[["p",["The Ice Pip is not used in any ",["l","收集包","bundles"],"."]]]],["Recipes",2,[["t",[[{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Ingredients"]},{"h":1,"v":["Energy / Health"]},{"h":1,"v":["Recipe Source(s)"]},{"h":1,"v":["Se