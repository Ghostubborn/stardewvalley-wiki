{"s":[[null,1,[["p",["The Swashbuckler Hat is a ",["l","帽子","hat"]," that can be ",["l","裁缝","tailored"]," using ",["l","布料","Cloth"]," and a ",["l","龙牙","Dragon Tooth"]," at the sewing machine inside ",["l","柳巷2号","Emily's house"]," or the ",["l","缝纫机","Sewing Machine"]," received as a reward for the ",["l","任务","\"Rock Rejuvenation\""]," special order."]],["p",["There is a small chance to receive this hat from slaying ",["l","怪物","monsters"],", breaking ",["l","矿井","crates and barrels"],", chopping ",["l","树","trees"],", shaking trees with seeds, digging ",["l","远古斑点","Artifact Spot"],"s, or by ",["l","淘盘","panning"],"."]]]]]}