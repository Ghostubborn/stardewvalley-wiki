{"s":[[null,1,[["p",["The Dwarf Scroll II is an ",["l","古物","Artifact"]," that can be found by ",["l","锄头","tilling"]," soil in ",["l","矿井","The Mines"]," (floors 1-39, 0.1% chance), as a drop from a ",["l","蝙蝠","Frost Bat"]," (floors 40-79), as a drop from a ",["l","灰尘精灵","Dust Sprite"]," (floors 40-79), or as a drop from Blue ",["l","史莱姆","Slimes"]," or ",["l","幽灵","Ghost"],"s."]]]],["Donation",2,[["p",["Donation of this item contributes to the total count of donations for the ",["l","博物馆","Museum"],"."]],["p",["Donating all 4 Dwarf Scrolls rewards the player with the ",["l","矮人语教程","Dwarvish Translation Guide"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Like"]},[["l","矮人","Dwarf"],", ",["l","潘妮","Penny"]]],[{"h":1,"v":["Dislike"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"],", ",["l","雷欧","Leo"]]]]]]],["Tailoring",2,[["p",["Dwarf Scroll II can be used in the spool of the ",["l","柳巷2号#Sewing Machine","Sewing Machine"]," to create the dyeable ",["l","裁缝","Gold Trimmed Shirt"],". ",["f","Shirt222.png",24]," It can be used in ",["l","染色","dyeing"],", serving as a green dye at the dye pots, located in ",["l","艾米丽","Emily"],"'s and ",["l","海莉","Haley"],"'s house, ",["l","柳巷2号","2 Willow Lane"],"."]]]],["Quests",2,[["p",["One Dwarf Scroll II may be requested by ",["l","鬼鱼","Ghostfish"]," in a ",["l","鱼塘#Quests","Fish Pond quest"]," to increase the capacity of the pond from 7 to 10."]]]],["Tip",2,[["l",0,[[1,["Level 15 in the Mines has tillable soil near the entrance to the floor. The player can repeatedly revisit Floor 15 via the elevator to till the soil and farm for Dwarf Scrolls I and II."]]]]]],["History",2,[["l",0,[[1,[["l","版本历史#1.4","1.4"],": Can now be used in ",["l","裁缝","Tailoring"],". Can be requested in ",["l","鱼塘#Quests","Fish Pond quests"],"."]],[1,[["l","版本历史#1.5","1.5"],": ",["l","古物","Artifacts"]," are now liked by the ",["l","矮人","Dwarf"]," and ",["l","潘妮","Penny"],", disliked by all other NPCs."]]]]]]]}