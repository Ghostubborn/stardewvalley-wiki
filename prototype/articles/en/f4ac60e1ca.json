{"s":[[null,1,[["p",["Mead is an ",["l","工匠物品","Artisan Good"]," made from placing ",["l","蜂蜜","Honey"]," inside a ",["l","小桶","Keg"],", taking 10 hours. It is also available at the ",["l","姜岛","Ginger Island Resort"]," for 800g. ",["l","潘姆","Pam"]," sells Mead in her ",["l","沙漠节","shop"]," at the ",["l","沙漠节","Desert Festival"]," for 20 Calico Eggs ",["l","卡利科三花蛋","Calico Egg"],"s. Unlike ",["l","果酒","Wine"]," and ",["l","果汁","Juice"]," however, the value of the Mead is not affected by the type of honey used. The sell price of Mead is 300g, and only ",["l","木桶","aging"]," or the ",["l","技能","Artisan Profession"]," can increase it. Several types of ",["l","蜂蜜","Flower Honey"]," sell for more than Mead, so the player can actually lose gold by making Mead."]],["p",["Mead can also be obtained for free from the bar in the ",["l","姜岛","Pirate Cove"]," by speaking with the bartender while wearing the ",["l","海盗帽","Pirate Hat"],", ",["l","豪华海盗帽","Deluxe Pirate Hat"],", ",["l","眼罩","Eye Patch"],", or ",["l","鹦鹉蛋","Parrot Egg"]," trinket. This can only be done once per night."]],["p",["When consumed, Mead causes a ",["l","效果","Tipsy"]," buff that decreases ",["l","速度","Speed"]," by 1."]]]],["Aged Values",2,[["p",["Mead can be placed inside a ",["l","木桶","Cask"]," to age from normal quality to silver, gold, and eventually iridium quality. Iridium quality doubles the base sell price of Mead."]],["p",["Normal, silver, and gold quality Mead can be prematurely removed from a cask at any time by striking the cask with an ",["l","斧头","Axe"],", ",["l","锄头","Hoe"],", or ",["l","十字镐","Pickaxe"],"."]],["t",[[{"h":1,"v":["Normal Quality"]},{"h":1,"v":["Silver Quality\n(x 1.25)"]},{"h":1,"v":["Gold Quality\n(x 1.5)"]},{"h":1,"v":["Iridium Quality\n(x 2)"]}],[["300g"],["300g Aged: 7 Days"],["300g Aged: 7 Days\nTotal: 14 Days"],["300g Aged: 14 Days\nTotal: 28 Days"]]]]]],["Gifting",2,[["t",[[{"h":1,"v":["Love"]},[["l","潘姆","Pam"],", ",["l","威利","Willy"]]],[{"h":1,"v":["Like"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","科罗布斯","Krobus"],", ",["l","谢恩","Shane"]]],[{"h":1,"v":["Hate"]},[["l","贾斯","Jas"],", ",["l","潘妮","Penny"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","文森特","Vincent"],", ",["l","雷欧","Leo"]]]]]]],["Bundles",2,[["p",["Mead is one of the options for the Brewers Bundle."]]]],["Recipes",2,[["p",["Mead is not used in any recipes."]]]],["Tailoring",2,[["p",["Mead can be used in the spool of the ",["l","柳巷2号","Sewing Machine"]," to create the ",["l","裁缝","Black Leather Jacket"],". It can be used in ",["l","染色","dyeing"],", serving as a yellow dye at the dye pots, located in ",["l","艾米丽","Emily"],"'s and ",["l","海莉","Haley"],"'s house, ",["l","柳巷2号","2 Willow Lane"],"."]]]],["Quests",2,[["p",["Mead is not used in any ",["l","任务","quests"],"."]]]]],"f":[["Source",["*",["l","工匠物品","Artisan Goods"],"\n*",["l","姜岛","Ginger Island Resort"]]],["Equipment",[["i","(BC)12","Keg"]]],["Ingredients",[["l","蜂蜜","Honey ×1"]]],["Processing Time",["10h"]],["Sell Price",["300g"]]]}