{"s":[[null,1,[["p",["Cranberry Sauce is a ",["l","烹饪","cooked dish"],". It is prepared using either the kitchen inside an upgraded ",["l","农舍","farmhouse"]," or a ",["l","野炊工具","Cookout Kit"],"."]],["p",["One Cranberry Sauce can be purchased each year from the ",["l","旅行货车","Traveling Merchant"],"'s shop at the ",["l","冰雪节","Festival of Ice"]," for 200g. It also may randomly appear in ",["l","科罗布斯","Krobus"],"' shop on ",["l","周循环","Saturdays"],", in the ",["l","垃圾桶","Garbage Can"]," outside the saloon, or in ",["l","星之果实酒吧","the Stardrop Saloon"],"'s rotating stock. Five Cranberry Sauce may occasionally be found in a ",["l","骷髅洞穴","treasure room"]," in the Skull Cavern. One Cranberry Sauce may be received from opening a ",["l","谜之盒","Mystery Box"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Like"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","桑迪","Sandy"]]],[{"h":1,"v":["Dislike"]},[["l","哈维","Harvey"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"],", ",["l","雷欧","Leo"]]]]]]],["Bundles",2,[["p",["Cranberry Sauce is not used in any ",["l","收集包","bundles"],"."]]]],["Tailoring",2,[["p",["Cranberry Sauce can be used in the spool of the ",["l","柳巷2号","Sewing Machine"]," to create the ",["i","(H)63","Flat Topped Hat"],". It can be also used as a red dye color at the dye pots in ",["l","艾米丽","E