{"s":[[null,1,[["p",["The Cheese Press is a type of ",["l","打造","Artisan Equipment"]," used to make ",["l","工匠物品","Artisan Goods"],". It takes ",["l","牛奶","Milk"]," and turns it into ",["l","奶酪","Cheese"],"."]],["p",["Regular quality ",["l","牛奶","Milk"]," produces regular quality ",["l","奶酪","Cheese"],", and regular quality ",["l","羊奶","Goat Milk"]," produces regular quality ",["l","山羊奶酪","Goat Cheese"],". ",["l","大壶牛奶","Large Milk"]," and ",["l","大瓶羊奶","Large Goat Milk"]," produce gold quality cheeses. Cheese and Goat Cheese can be aged in ",["l","木桶","Cask"],"s to increase their value."]],["p",["A Cheese Press is the reward for completing the Pantry."]]]],["Products",2,[["p",["See also: ",["l","加工动物制品的收益","Animal Products Profitability"]]],["t",[[{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Ingredients"]},{"h":1,"v":["Processing Time"]},{"h":1,"v":["Sell Price"]},{"h":1,"v":["Energy / Health"]}],[[["l","奶酪","Cheese"]],["It's your basic cheese."],[["i","(O)184","Milk ×1"]," or",["i","(O)186","Large Milk ×1"]],["200m (≈3h)"],["230g"],["Energy 125\nHealth 56"]],[[["l","山羊奶酪","Goat Cheese"]],["Soft cheese made from goat's milk."],[["i","(O)436","Goat Milk ×1"]," or",["l","大瓶羊奶","Large Goat Milk ×1"]],["200m (≈3h)"],["400g"],["Energy 125\nHealth 56"]]]]]]],"f":[["Source",[["l","打造","Crafting"]]],["Ingredients",[["i","(O)388","Wood ×45"],["i","(O)390","Stone ×45"],["i","(O)709","Hardwood ×10"],["i","(O)334","Copper Bar ×1"]]],["Sell Price",["Cannot be sold"]]]}