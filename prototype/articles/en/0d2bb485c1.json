{"s":[[null,1,[["p",["The Dwarf Scroll III is an ",["l","古物","Artifact"]," that can drop from Blue, Purple, Red, Copper, Iron, or Tiger ",["l","史莱姆（怪物）","Slimes"],", ",["l","蝙蝠","Lava Bats"],", ",["l","熔岩蟹","Lava Crab"],"s, ",["l","鱿鱼娃","Squid Kid"],"s, ",["l","暗影狂徒","Shadow Brute"],"s, ",["l","暗影萨满","Shadow Shaman"],", ",["l","蜘蛛","Spider"],"s, ",["l","金属大头","Metal Head"],"s or ",["l","蓝鱿鱼","Blue Squid"],"s."]]]],["Donation",2,[["p",["Donation of this item contributes to the total count of donations for the ",["l","博物馆","Museum"],"."]],["p",["Donating all 4 Dwarf Scrolls rewards the player with the ",["l","矮人语教程","Dwarvish Translation Guide"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Like"]},[["l","矮人","Dwarf"],", ",["l","潘妮","Penny"]]],[{"h":1,"v":["Dislike"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"],", ",["l","雷欧","Leo"]]]]]]],["Tailoring",2,[["p",["Dwarf Scroll III can be used in the spool of the ",["l","柳巷2号","Sewing Machine"]," to create the dyeable ",["l","裁缝","Gold Trimmed Shirt"],". It can be used in ",["l","染色","dyeing"],", serving as a blue dye at the dye pots, located in ",["l","艾米丽","Emily"],"'s and ",["l","海莉","Haley"],"'s house, ",["l","柳巷2号","2 Willow Lane"],"."]]]],["Quests",2,[["p",["One Dwarf Scroll III may be requested by ",["l