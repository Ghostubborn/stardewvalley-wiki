{"s":[[null,1,[["p",["Topaz is a type of ",["l","矿物","Mineral"]," that can be obtained from ",["l","采矿","Topaz Nodes"]," and ",["l","采矿","Gem Nodes"]," in ",["l","矿井","The Mines"],", from ",["l","淘盘","panning"],", or found in ",["l","钓鱼","Fishing Treasure Chests"],". It has a 10% chance to be dropped by a slain ",["l","矮人哨兵","Dwarvish Sentry"]," in the ",["l","火山地牢","Volcano Dungeon"],". It may occasionally be found in a ",["l","垃圾桶","Garbage Can"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Love"]},[["l","克林特","Clint"],", ",["l","艾米丽","Emily"],", ",["l","矮人","Dwarf"]]],[{"h":1,"v":["Like"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","雷欧","Leo"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"]]],[{"h":1,"v":["Dislike"]},[["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","莉亚","Leah"]]]]]]],["Bundles",2,[["p",["Topaz is one of the options for the treasure hunter Bundle."]]]],["Forging",2,[["p",["Topaz can be used at the ",["l","锻造","Forge"]," to increase the defense of a melee weapon."]]]],["Recipes",2,[["p",["Topaz is not used in any recipes."]]]],["Tailoring",2,[["p",["Topaz is used in the spool of the ",["l","柳巷2号","Sewing Machine"]," with ",["l","布料","Cloth"]," in the feed to create a ",["l","裁缝","Shirt"],". It is a gold dye when used in the spool of the Sewing Machine with a dyeable clothing item in the feed. It can be placed in the yellow dye pot at Emily's and Haley's house for use in ",["l","染色","dyeing"],"."]]]],["Quests",2,[["l",0,[[1,["Topaz may be randomly requested during any season at the ",["l","任务","\"Help Wanted\" board"]," outside ",["l","皮埃尔的杂货店","Pierre's General Store"]," for a reward of 240g and 150 ",["l","友谊","Friendship"]," points."]],[1,["Two Topaz may be requested by ",["l","鲶鱼","Catfish"]," in a ",["l","鱼塘","Fish Pond quest"]," to increase the capacity of the pond from 3 to 5."]],[1,["Topaz is requested by ",["l","艾米丽","Emily"]," as part of her ",["l","任务","\"Rock Rejuvenation\" special order"],"."]],[1,["May be used in the ",["l","姜岛","Gem Birds"]," puzzle on Ginger Island."]],[1,["Three Topaz may be requested by the Raccoon at the ",["l","大树桩（地点）","Giant Stump"]," as part of his fifth request, or as part of any request starting with the sixth."]]]]]]]}