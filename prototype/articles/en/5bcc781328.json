{"s":[[null,1,[["p",["The Skeletal Tail is an ",["l","古物","Artifact"]," that can be found from:"]],["l",0,[[1,[["l","钓鱼#Treasure Chests","Fishing Treasure Chests"],"."]],[1,[["l","锄头","tilling"]," soil in ",["l","矿井","The Mines"]," or ",["l","骷髅洞穴","Skull Cavern"],"."]],[1,["From ",["l","采矿#Bone Node","Bone Nodes"]," on the ",["l","姜岛","Ginger Island"]," Dig Site."]],[1,["Gifted by a ",["l","动物#Pets","pet"]," dog with max ",["l","动物#Friendship","friendship"],"."]]]]]],["Donation",2,[["p",["Donation of this item contributes to the total count of donations for the ",["l","博物馆","Museum"],"."]],["p",["Donating this item, along with the ",["l","史前胫骨","Prehistoric Tibia"],", will reward the player with the ",["l","树懒骨架","Sloth Skeleton R"]," statue."]]]],["Bone Mill",2,[["p",["The Skeletal Tail can be turned into ",["l","高级肥料","Quality Fertilizer"],", ",["l","生长激素","Speed-Gro"],", ",["l","高级生长激素","Deluxe Speed-Gro"]," or ",["l","树肥","Tree Fertilizer"]," in the ",["l","碎骨机","Bone Mill"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Like"]},[["l","矮人","Dwarf"],", ",["l","潘妮","Penny"]]],[{"h":1,"v":["Dislike"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"],", ",["l","雷欧","Leo"]]]]]]],["Bundles",2,[["p",["Skeletal Tail is not used in any ",["l","收集包","bundles"],"."]