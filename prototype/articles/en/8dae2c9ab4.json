{"s":[[null,1,[["p",["The Geode Crusher is a piece of ",["l","打造","Refining Equipment"]," that can be used to open ",["l","矿物","geodes"]," on ",["l","农场","the Farm"],". The player receives the recipe after completing ",["l","克林特","Clint"],"'s ",["l","任务","Special Order"]," ",["l","任务","\"Cave Patrol\""],". It takes 60m (1h) to process."]],["p",["The Geode Crusher cannot open ",["l","古物宝藏","artifact troves"],", ",["l","金色椰子","golden coconuts"],", ",["l","谜之盒","mystery boxes"],", or ",["l","金色谜之盒","golden mystery boxes"],"."]],["p",["This item provides an alternative to paying 25g for Clint ",["l","铁匠铺","to open"]," 1 geode."]]]]],"f":[["Source",[["l","打造","Crafting"]]],["Ingredients",[["i","(O)336","Gold Bar ×2"],["i","(O)390","Stone ×50"],["i","(O)72","Diamond ×1"]]]]}