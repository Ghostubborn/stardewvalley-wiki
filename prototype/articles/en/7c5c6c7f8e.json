{"s":[[null,1,[["p",["The Rotten Plant is a type of ",["l","垃圾","trash"],". It is produced by a ",["l","南瓜灯","Jack-O-Lantern"]," that decomposes on the 1st of ",["l","冬季","Winter"]," (unless it has been stored in ",["l","物品栏","inventory"]," or a ",["l","宝箱","chest"],")."]],["p",["It cannot be placed in a ",["l","回收机","Recycling Machine"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Hate"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","雷欧","Leo"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"]]]]]]],["Bundles",2,[["p",["The Rotten Plant is not used in any ",["l","收集包","bundles"],"."]]]],["Recipes",2,[["p",["The Rotten Plant is not used in any ",["l","烹饪","recipes"],"."]]]],["Dyeing",2,[["p",["Rotten Plant can be used in ",["l","染色","dyeing"],", serving as an orange dye at the dye pots, located in ",["l","艾米丽","Emily"],"'s and ",["l","海莉","Haley"],"'s house, ",["l","柳巷2号","2 Willow Lane"],"."]]]],["Quests",2,[["p",["The Rotten Plant can be used as an orange item in the Special Order ",["l","任务","\"Qi's Prismatic Grange\""],"."]]]],["Secret",2,[["p",["After reading ",["l","秘密纸条","Secret Note #19"],", solving the puzzle, and obtaining the special reward item, a Rotten Plant may be produced under specific circumstances."]],["d","Details",[["p",["The