{"s":[[null,1,[["p",["The Mahogany Seed is a seed that grows into a ",["l","桃花心木树","Mahogany Tree"],". It can be obtained by shaking or chopping down a ",["l","桃花心木树","Mahogany Tree"],", using an ",["l","斧头","Axe"]," or ",["l","十字镐","Pickaxe"]," to dig up a Mahogany Seed dropped by a fully grown ",["l","桃花心木树","Mahogany Tree"]," on ",["l","农场","The Farm"],", chopping a ",["l","大树桩","Large Stump"]," or a ",["l","大圆木","Large Log"],", inside of a ",["l","金色椰子","Golden Coconut"],", or killing ",["l","史莱姆（怪物）","Slimes"]," in the ",["l","秘密森林","Secret Woods"],"."]],["p",["Mahogany Seeds can also be purchased from the ",["l","姜岛商人","Island Trader"]," for 1 ",["l","黄貂鱼","Stingray"],", or from the ",["l","大树桩（地点）","Raccoon Wife's Shop"]," for 20 ",["l","煤炭","Coal"]," after completing four requests."]],["p",["Mahogany Seeds fertilized with ",["l","树肥","Tree Fertilizer"]," have a 60% chance of growing to the next stage each night. Unfertilized seeds have a 15% chance of growing to the next stage."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Dislike"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"],", ",["l","雷欧","Leo"]]]]]]],["Bundles",2,[["p",["Mahogany Seed is not used in any ",["l","收集包","bundles"],"."]]]],["Recipes",2,[["t",[[{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Ingredients"]},{"h":1,"v":["Energy / Health"]},{"h":1,"v":["Recipe Source(s)"]},{"h":1,"v":["Sell Price"]}],[[],[["l","神秘树种","Mystic Tree Seed"]],["This can be planted to grow a special tree."],[["i","(O)309","Acorn ×5"],["i","(O)310","Maple Seed ×5"],["i","(O)311","Pine Cone ×5"],["i","(O)292","Mahogany Seed ×5"]],["N/A"],[["l","精通山洞","Foraging Mastery"]],["100g"]]]]]],["Tailoring",2,[["p",["Mahogany Seed is used in the spool of the ",["l","柳巷2号","Sewing Machine"]," to create the ",["i","(H)53","Beanie"],". It can be used in ",["l","染色","dyeing"],", serving as an orange dye at the dye pots, located in ",["l","艾米丽","Emily"]," and ",["l","海莉","Haley"],"'s house, ",["l","柳巷2号","2 Willow Lane"],"."]]]]]}