{"s":[[null,1,[["p",["The Mystic Tree Seed is a ",["l","树","tree"]," seed that grows into a ",["l","神秘树","Mystic Tree"],". It can be ",["l","打造","crafted"]," after claiming ",["l","精通山洞","Foraging Mastery"],"."]],["p",["Note that Mystic Tree Seeds can only be obtained by crafting. They cannot be obtained from chopping or shaking Mystic Trees. Also, Mystic Trees do not spread seeds when fully grown."]],["p",["Mystic Tree Seeds fertilized with ",["l","树肥","Tree Fertilizer"]," have a 30% chance of growing to the next stage each night, including during ",["l","冬季","Winter"],". Unfertilized seeds have a 15% chance of growing to the next stage each night during ",["l","春季","Spring"],", ",["l","夏季","Summer"],", or ",["l","秋季","Fall"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Dislike"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","雷欧","Leo"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"]]]]]]],["Bundles",2,[["p",["Mystic Tree Seed is not used in any ",["l","收集包","bundles"],"."]]]],["Tailoring",2,[["p",["Mystic Tree Seed is not used in any ",["l","裁缝","tailoring"]," or ",["l","染色","dyeing"],"."]]]],["Quests",2,[["p",["Mystic Tree Seed is not used in any ",["l","任务","quests"],"."]]]]]}