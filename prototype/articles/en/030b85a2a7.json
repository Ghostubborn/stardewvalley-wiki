{"s":[[null,1,[["g",[["F.I.B.S..png",168,["Fishing Information Broadcasting Service"]]]],["q",["Thank you for tuning in to F.I.B.S., the Fishing Information Broadcast Service. Despite our unfortunate name, you can rest assured that we provide only the most trustworthy information about this season's fishing opportunities."],[]],["p",["The Fishing Information Broadcasting Service is a ",["l","电视","TV channel"]," unlocked after reading the letter in the mail sent by ",["l","潘姆","Pam"]," the day after the \"Potato Juice\" cutscene (which triggers after completing ",["l","任务#The Strong Stuff","\"The Strong Stuff\""]," Special Order), which asks if the player has ever tuned in to channel 736. It provides information about the current season's fishing opportunities (including species, time, weather requirement, and location)."]],["t",[[{"h":1,"v":["Season"]},{"h":1,"v":["Information"]}],[[["l","春季","Spring"]],[["l","鳀鱼","Anchovy"],"...... 6:00am-2:00am, ocean\n",["l","小嘴鲈鱼","Smallmouth Bass"],"...... 6:00am-2:00am, river\n",["l","鲤鱼","Carp"],"...... 6:00am-2:00am, lake\n",["l","鲶鱼","Catfish"],"...... 6:00am-12:00am, rainy days, river\n",["l","太阳鱼","Sunfish"],"...... 6:00am-7:00pm, sunny days, river\n",["l","鲱鱼","Herring"],"...... 6:00am-2:00am, ocean\n",["l","鳗鱼","Eel"],"...... 4:00pm-2:00am, rainy days, ocean\n",["l","比目鱼","Flounder"],"...... 6:00am-8:00pm, ocean"]],[[["l","夏季","Summer"]],[["l","河豚","Pufferfish"],"...... 12:00pm-4:00pm, sunny days, ocean\n",["l","金枪鱼","Tuna"],"...... 6:00am-7:00pm, ocean\n",["l","虹鳟鱼","Rainbow Trout"],"...... 6:00am-7:00pm, sunny days, river, lake\n",["l","鲤鱼","Carp"],"...... 6:00am-2:00am, lake\n",["l","狗鱼","Pike"],"...... 6:00am-2:00am, river\n",["l","太阳鱼","Sunfish"],"...... 6:00am-7:00pm, sunny days, river\n",["l","红鲻鱼","Red Mullet"],"...... 6:00am-7:00pm, ocean\n",["l","章鱼","Octopus"],"...... 6:00am-1:00pm, ocean\n",["l","红鲷鱼","Red Snapper"],"...... 6:00am-7:00pm, rainy days, ocean\n",["l","大海参","Super Cucumber"],"...... 6:00pm-2:00a