{"s":[[null,1,[["p",["Unmilled Rice is a ",["l","蔬菜","vegetable"]," ",["l","农作物","crop"]," that grows from ",["l","稻苗","Rice Shoot"],"s after 8 days (6 when irrigated). Unmilled Rice is harvested using a ",["l","镰刀","Scythe"],"."]],["p",["Players have the ability to craft ",["l","大米","Rice"]," from Unmilled Rice by using a ",["l","磨坊","Mill"],". Once placed in the Mill, one Unmilled Rice will make one ",["l","大米","Rice"],". Rice will appear in the box on the right side of the Mill the following morning."]],["p",["Rice Shoots planted in most farm tiles take 8 days to mature. Rice Shoots planted approximately within 3 tiles of a water source (such as a pond or a river) in any direction are considered to be irrigated. Paddies need not be continuous with each other or adjacent to water in order to count as irrigated. Irrigated Rice Shoots mature in 6 days."]]]],["Stages",2,[["p",["When harvested, each Rice Shoot has a 50/50 chance of giving either one or two Unmilled Rice at farming level 0, or one or three Unmilled Rice at farming level 10 or higher, plus an additional 10% chance of one or more extra rice (1.61 rice on average, or 2.11 at farming level 10+)."]],["t",[[{"h":1,"v":["Rice Type"]},{"h":1,"v":["Stage 1"]},{"h":1,"v":["Stage 2"]},{"h":1,"v":["Stage 3"]},{"h":1,"v":["Stage 4"]},{"h":1,"v":["Harvest"]}],[[],[["f","Unmilled_Rice_Stage_1.png",48]],[["f","Unmilled_Rice_Stage_2.png",48]],[["f","Unmilled_Rice_Stage_3.png",48]],[["f","Unmilled_Rice_Stage_4.png",48]],[["f","Unmilled_Rice_Stage_5.png",48]]],[["Non-Irrigated"],["1 Day"],["2 Days"],["2 Days"],["3 Days"],["Total: 8 Days"]],[["Irrigated"],["1 Day"],["1 Day"],["1 Day"],["3 Days"],["Total: 6 Days"]]]]]],["Crop Growth Calendar",2,[["t",[[{"b":[["t",[[{"c":7,"h":1,"v":["Base Unirrigated"]}],[{"h":1,"v":["Mon"]},{"h":1,"v":["Tue"]},{"h":1,"v":["Wed"]},{"h":1,"v":["Thu"]},{"h":1,"v":["Fri"]},{"h":1,"v":["Sat"]},{"h":1,"v":["Sun"]}],[[["f","Unmilled_Rice_Stage_1.png",48]],[["f","Unmilled_Rice_Stage_2.png",48]],[