nt Stock"]}],[{"h":1,"v":["Image"]},{"h":1,"v":["Name"]},{"h":1,"v":["Price"]}],[[["f","Seb's_Lost_Mace.png",48]],[["l","塞巴斯蒂安的遗失之锤","Seb's Lost Mace"]],["70 Calico Eggs"]],[[["f","Frozen_Geode.png",48]],[["l","冰封晶球","Frozen Geode"]," (5)"],["10 Calico Eggs"]],[[["f","Energy_Tonic.png",48]],[["l","哈维的诊所","Energy Tonic"]," (5)"],["25 Calico Eggs"]]]],["t",[[{"c":3,"h":1,"v":[["l","谢恩","Shane"]," - Permanent Stock"]}],[{"h":1,"v":["Image"]},{"h":1,"v":["Name"]},{"h":1,"v":["Price"]}],[[["f","Chicken_Decal.png",48]],[["l","小鸡贴纸","Chicken Decal"]],["60 Calico Eggs"]],[[["f","Pizza.png",48]],[["l","披萨","Pizza"]," (5)"],["5 Calico Eggs"]],[[["f","Egg.png",48]],[["l","蛋","Egg"]," (12)"],["1 Calico Egg"]],[[["f","Pepper_Poppers.png",48]],[["l","爆炒青椒","Pepper Poppers"]," x3 (3)"],["30 Calico Eggs"]]]],["t",[[{"c":3,"h":1,"v":[["l","文森特","Vincent"]," - Permanent Stock"]}],[{"h":1,"v":["Image"]},{"h":1,"v":["Name"]},{"h":1,"v":["Price"]}],[[["f","Fiber.png",48]],[["l","纤维","Fiber"]," x10 (1)"],["1 Calico Egg"]],[[["f","Bug_Meat.png",48]],[["l","虫肉","Bug Meat"]," (3)"],["1 Calico Egg"]],[[["f","Sap.png",48]],[["l","树液","Sap"]," (1)"],["1 Calico Egg"]],[[["f","Cave_Carrot.png",48]],[["l","山洞萝卜","Cave Carrot"]," (1)"],["2 Calico Eggs"]],[[["f","Skeletal_Hand.png",48]],[["l","手部骨骼","Skeletal Hand"]," (1)"],["2 Calico Eggs"]],[[["f","Clay.png",48]],[["l","粘土","Clay"]," (20)"],["1 Calico Egg"]],[[["f","Chipped_Amphora.png",48]],[["l","有缺口的土罐","Chipped Amphora"]," (1)"],["1 Calico Egg"]]]]]}]]]]],["Emily's Outfit Services",3,[["g",[["61_total_makeover_outfits.thumb.webp",200,["34 gender-neutral, 13 male-only, and 14 female-only"],"61_total_makeover_outfits.webp"]]],["p",["Every day, Emily and Sandy offer the player a random new outfit with a short cutscene in which Emily will pick the clothing that \"embodies the player\". The player's original outfit is placed in their inventory. If the player tries to re-enter the hut in which the clothing service happens, the player will be blocked from entering, with Emily saying that the player looks great in their new outfit. On days where Emily runs a Villager Shop, Sandy will take over after a bit of hesitation."]],["p",["There are 61 total makeover outfits: 34 gender-neutral, 13 male-only, and 14 female-only. Each outfit consists of a shirt, a pant, and possibly a hat. Of note, the ",["l","黑色棒球帽","Dark Ballcap"],", ",["l","Joja棒球帽","Joja Cap"],", and ",["l","月桂花冠","Laurel Wreath Crown"]," can be obtained with three of the gender-neutral outfits. In addition, the ",["l","紧身裤","Tight Pants"]," can be obtained from a few outfits, and a \"soft edge\" variant of ",["l","裁缝#Shirts","Basic Pullover (M)"]," can be obtained from one of the male-only outfits."]]]],["Chef",3,[["g",[["Chef_Desert_Festival.png",200,[]]]],["p",["The Chef gives the player a choice of ingredients to make them a meal with varying effects depending on the ingredients chosen. The player may do so repeatedly and choose different ingredients each time. The meal will be eaten; any effects will be applied immediately and last for 7 minutes. The buffs from dishes are a combination of buffs from both ingredient choices; e.g., Crystal Cake grants both ",["l","采矿","Mining (+3)"]," and ",["l","运气","Luck (+1)"]," buffs."]],["p",["Any dish will restore the player to maximum health and energy. In addition, these dishes will stack with any food or drink ",["l","效果","buffs"]," from the player."]],["t",[[{"h":1,"v":["Choices:"]},{"h":1,"v":["Rich Marinara ",["l","防御","Defense (+1)"]]},{"h":1,"v":["Mushroom Creme ",["l","采矿","Mining (+1)"]]},{"h":1,"v":["Cherry Syrup ",["l","运气","Luck (+1)"]]},{"h":1,"v":["Pungent Garlic ",["l","攻击","Attack (+1)"]]},{"h":1,"v":["Uncomfortably Hot Sauce ",["l","速度","Speed (+1)"]]}],[{"h":1,"v":["Hearty Beans ",["l","防御","Defense (+3)"]]},["N/A"],[["f","Earthy_Mousse.png",24]," Earthy Mousse"],[["f","Sweet_Bean_Cake.png",24]," Sweet Bean Cake"],[["f","Skull_Cave_Casserole.png",24]," Skull Cave Casserole"],[["f","Spicy_Tacos.png",24]," Spicy Tacos"]],[{"h":1,"v":["Cave Loaf ",["l","采矿","Mining (+3)"]]},[["f","Mountain_Chili.png",24]," Mountain Chili"],["N/A"],[["f","Crystal_Cake.png",24]," Crystal Cake"],[["f","Cave_Kebab.png",24]," Cave Kebab"],[["f","Hot_Log.png",24]," Hot Log"]],[{"h":1,"v":["Rare Fruit ",["l","运气","Luck (+3)"]]},[["f","Sour_Salad.png",24]," Sour Salad"],[["f","Superfood_Cake.png",24]," Superfood Cake"],["N/A"],[["f","Warrior_Smoothie.png",24]," Warrior Smoothie"],[["f","Rumpled_Fruit_Skin.png",24]," Rumpled Fruit Skin"]],[{"h":1,"v":["Extremely Sharp Cheddar ",["l","攻击","Attack (+3)"]]},[["f","Calico_Pizza.png",24]," Calico Pizza"],[["f","Stuffed_Mushrooms.png",24]," Stuffed Mushrooms"],[["f","Elf_Quesadilla.png",24]," Elf Quesadilla"],["N/A"],[["f","Nachos_Of_The_Desert.png",24]," Nachos Of The Desert"]],[{"h":1,"v":["Shrimp ",["l","钓鱼","Fishing (+3)"]]},[["f","Cioppino.png",24]," Cioppino"],[["f","Rainforest_Shrimp.png",24]," Rainforest Shrimp"],[["f","Shrimp_Donut.png",24]," Shrimp Donut"],[["f","Smell_Of_The_Sea.png",24]," Smell Of The Sea"],[["f","Desert_Gumbo.png",24]," Desert Gumbo"]]],"style=\"text-align: left;\"|All Available Dish Combinations:"]]],["Free Cactus",3,[["p",["Once per festival, the player may obtain a cactus decor item from the Cactus Salesman at the bottom of the map. This decor is one out of several, and its face, colors, and design vary. The player must have an empty inventory slot to receive the cactus."]],["g",[["Sly_Free_Cactus.png",320,["Sly Cactus and Free Cactus Salesman"]],["Cactus_Options.png",320,["Random Cactus Combinations"]]]]]],["Skull Cavern",3,[["p",["During the Desert Festival, ",["l","马龙","Marlon"]," offers one-day ",["l","骷髅洞穴","Skull Cavern"],"-related quests that will award the player Calico Eggs if completed. There are 3 types of quests offered; 2 will randomly be shown each day. The player does not need to have obtained the ",["l","头骨钥匙","Skull Key"]," to enter the Skull Cavern during the festival, and the Skull Cavern functions as it normally does (including Treasure Rooms and hard-mode (\"Dangerous\", \"Skull Cavern Invasion\"); as such, if hard-mode is toggled on, one may want to toggle it off before the festival!)."]],["t",[[{"c":4,"h":1,"v":["Skull Cavern Quests"]}],[{"h":1,"v":["Quest Name"]},{"h":1,"v":["Quest Text"]},{"h":1,"v":["Requirements"]},{"h":1,"v":["Reward"]}],[["Monster Hunt"],["Descend into the Skull Cavern and slay 10 [Monster]."],{"b":[["p",["Slay 10 of one of the following:"]],["l",0,[[1,[["l","飞蛇","Serpent"],"s"]],[1,[["l","史莱姆","Purple Slime"],"s"]],[1,[["l","木乃伊","Mummies"]]]]]]},["35 Calico Eggs"]],[["Deep Dive"],["Reach level 30 of the Skull Cavern."],["Reach level 30 of the Skull Cavern."],["50 Calico Eggs"]],[["Treasure Hunt"],["Collect [Item] from the Skull Cavern."],{"b":[["p",["Collect either of the following items:"]],["l",0,[[1,[["i","(O)749","Omni Geode ×12"]]],[1,[["i","(O)386","Iridium Ore ×15"]]]]]]},["40 Calico Eggs"]]]],["p",["The Skull Cavern has a few additions that are unique to the Desert Festival. There are ",["l","采矿#Mining Nodes","Calico Egg Nodes"]," which, when mined, yield 1-3. Players can also obtain 1-3 from slaying monsters and breaking crates and barrels. The chance of finding Calico Egg Nodes steadily increases as players go deeper into the Cavern. This is also true for drop chances from monsters and containers. The monster drop chance ranges from 2%-50%, while the container drop chance has a maximum of 33%. Additionally, any rock in the Skull Cavern during the Desert Festival has a chance to drop 1-3 when broken; this chance ranges from 1%-50% and slowly increases with each floor passed."]],["p",["Players also gain 1 \"Egg Rating\" for every 5 floors reached and every Calico Statue activated. Calico Statues may randomly appear once per floor (even Treasure Rooms). Activating the statue can grant a random effect that lasts throughout the player's current descent into the Cavern."]],["t",[[{"c":3,"h":1,"v":["Calico Statue Effects"]}],[{"h":1,"v":["Status"]},{"h":1,"v":["Description"]},{"h":1,"v":["Effect"]}],[{"r":7,"v":["Buff"]},["10 Calico Eggs"],["Receive 10 Calico Eggs."]],[["25 Calico Eggs"],["Receive 25 Calico Eggs."]],[["50 Calico Eggs"],["Receive 50 Calico Eggs."]],[["100 Calico Eggs!"],["Receive 100 Calico Eggs."]],[["Speed Boost"],["Gain ",["l","速度","Speed (+1)"]," for 5 minutes."]],[["Full refresh!"],[["l","能量","Energy"]," and ",["l","生命值","Health"]," restored to max."]],[["Monsters do less damage"],["Monsters do 25% less damage."]],[["Neutral"],["No effect"],["Nothing (except the usual +1 Egg Rating)."]],[{"r":10,"v":["Debuff"]},["More Ghosts"],["15% more ",["l","石碳幽灵","Carbon Ghost"],"s spawn; +1% to overall monster spawn chance."]],[["More Serpents"],["15% more ",["l","飞蛇","Serpent"],"s spawn; +1% to overall monster spawn chance."]],[["Skeletons are after you..."],["≈10% chance to spawn ",["l","骷髅（危险）","dangerous Skeletons"]," and ≈5% chance to spawn ",["l","幽灵头骨（危险）","dangerous Haunted Skulls"],"; +1% to overall monster spawn chance."]],[["More Bats"],["15% more ",["l","蝙蝠","Bats"]," spawn; +1% to overall monster spawn chance."]],[["Bugs become Assassin Bugs"],[["l","甲虫","Armored Bug"],"s are replaced with Assassin Bugs (50 Damage, 500 Health, increased Speed, not invincible, uses \"dangerous\" movement)."]],[["Lose more eggs when you're knocked out"],["Lose 50% of the Calico Eggs in inventory when knocked out."]],[["Food is half as effective"],["50% less Energy and Health from eating food."]],[["More monsters"],["20% more of all monster types spawn."]],[["Monsters do more damage"],["Monsters do 25% more damage."]],[["Mummies have become angry"],[["l","木乃伊","Mummies"]," are replaced with their ",["l","木乃伊（危险）","dangerous variants"]," and have doubled Speed."]]]],["p",["Talking to ",["l","吉尔","Gil"]," presents the option to submit the day's highest Egg Rating for prizes. These prizes, based on the player's Egg Rating, include Calico Eggs, food, drinks, and other items."]],["t",[[{"c":3,"h":1,"v":["Gil's Egg Rating Prizes"]}],[{"h":1,"v":["Egg Rating"]},{"h":1,"v":["Gil's Response"]},{"h":1,"v":["Rewards"]}],[["1-4"],["\"...[Egg Rating #]? Hahahaha.... okay, kiddo. Here's a little prizey for you... now, go along and play with the other kids.\""],{"b":[["l",0,[[1,[["i","(O)CalicoEgg","Calico Egg ×1"]]],[1,[["i","(O)243","Miner's Treat ×1"]]]]]]}],[["5-9"],["\"...[Egg Rating #]? That's not too impressive, but at least you had the gumption to try. Here's a little something.\""],{"b":[["l",0,[[1,[["i","(O)CalicoEgg","Calico Egg ×10"]]],[1,[["i","(O)395","Coffee ×1"]]]]]]}],[["10-14"],["\"[Egg Rating #], huh? Not bad, not bad... of course, when I was your age I was doin' twice that. With a Rusty Sword, and no food!\""],{"b":[["l",0,[[1,[["i","(O)CalicoEgg","Calico Egg ×25"]]],[1,[["i","(O)253","Triple Shot Espresso ×1"]]]]]]}],[["15-19"],["\"[Egg Rating #]... that ain't bad at all. That's the kind of number we're looking for in the Adventurer's Guild. Here's your prize.\""],{"b":[["l",0,[[1,[["i","(O)CalicoEgg","Calico Egg ×50"]]],[1,[["i","(O)253","Triple Shot Espresso ×3"]]]]]]}],[["20-24"],["\"[Egg Rating #]? Okay, now I'm impressed... Hey, Marlon! Get a load of this... an Egg Rating of [Egg Rating #] for the day!\""],{"b":[["l",0,[[1,[["i","(O)CalicoEgg","Calico Egg ×100"]]],[1,[["i","(O)253","Triple Shot Espresso ×5"]]]]]]}],[["25-54"],["\"[Egg Rating #]!?! Well, I'll be... We've got a real Calico Egg hunter here!\""],{"b":[["l",0,[[1,[["i","(O)CalicoEgg","Calico Egg ×200"]]],[1,[["i","(H)GilsHat","Gil's Hat"]," (can only be received once)"]],[1,[["i","(O)253","Triple Shot Espresso ×5"]," (if Gil's Hat has already been received)"]]]]]}],[["55-999"],["\"[Egg Rating #]!?!?!?!?!?!?!?\""],{"b":[["l",0,[[1,[["i","(O)CalicoEgg","Calico Egg ×500"]]],[1,[["i","(O)279","Magic Rock Candy ×1"]]]]]]}],[["1000+"],["You hear a voice in your head: ‘It would be dishonorable to submit an egg rating acquired through the use of cheat code software!’"],["None"]]]]]],["Harvey's Medical Station",3,[["p",["If the player loses all Health in the Skull Cavern and is knocked out, they will awaken at Harvey's \"shop\" located in the festival next to the Cavern entrance. The player will awaken with 10 Health, and they will not lose any additional Energy or ",["l","金币","Gold"],". The player will keep their items, but they will lose 20% of the Calico Eggs in their inventory. Talking to Harvey will result in the same dialogue as before the player died."]]]],["Willy's Fishing Quests",3,[["p",[["l","威利","Willy"]," offers one-day fishing-related quests that will award the player Calico Eggs upon completion. There is a different quest for each day of the festival. On Spring 17, the ",["i","(O)GoldenBobber","Golden Bobber"]," will appear in the first Treasure Chest fished up."]],["t",[[{"c":3,"h":1,"v":["Fishing Quests"]}],[{"h":1,"v":["Day"]},{"h":1,"v":["Quest Description"]},{"h":1,"v":["Reward"]}],[["Spring 15"],["Willy's Challenge: Catch 3 ",["l","沙鱼","Sandfish"],"."],["25 Calico Eggs"]],[["Spring 16"],["Willy's Challenge: Catch a ",["l","蝎鲤鱼","Scorpion Carp"],"."],["50 Calico Eggs"]],[["Spring 17"],["Willy: A fish swallowed me rare ",["l","黄金浮漂","golden bobber"],"! There's 30 eggs for whoever returns it."],["30 Calico Eggs"]]]]]],["Scholar",3,[["p",["The Scholar asks the player a series of four questions. If all four answers are correct, then the reward is 50 Calico Eggs. The player has one chance per day to achieve this. After a successful round of questions, the player must wait until next year to receive another reward. Questions are randomized every time they are asked."]],["p",["One of the questions asks the player to recall their total number of steps taken. Three options are given. The order of the options is randomized, but the numerically middle value will always be correct."]],["t",[[{"c":3,"h":1,"v":["Scholar's Questions and Answers"]}],[{"h":1},{"h":1,"v":["Questions"]},{"h":1,"v":["Answers"]}],[{"r":8,"v":["1"]}