{"s":[[null,1,[["p",["Fairy Seeds are a type of seed. Mature plants yield ",["l","玫瑰仙子","Fairy Rose"]," flowers."]],["p",["They can be purchased at ",["l","皮埃尔的杂货店","Pierre's General Store"],", at ",["l","Joja超市","JojaMart"],", from the Magic Shop Boat at the ",["l","夜市","Night Market"]," on Winter 17, and occasionally from the ",["l","旅行货车","Traveling Cart"],". ",["l","贾斯","Jas"]," sells twenty-five Fairy Seeds in her ",["l","沙漠节","shop"]," at the ",["l","沙漠节","Desert Festival"]," for 5 Calico Eggs ",["l","卡利科三花蛋","Calico Egg"],"s each. They can also be obtained by using the ",["l","种子生产器","Seed Maker"],"."]]]],["Stages",2,[["t",[[{"h":1,"v":["Stage 1"]},{"h":1,"v":["Stage 2"]},{"h":1,"v":["Stage 3"]},{"h":1,"v":["Stage 4"]},{"h":1,"v":["Harvest"]}],[["1 Day"],["4 Days"],["4 Days"],["3 Days"],["Total: 12 Days"]]]]]],["Gifting",2,[["t",[[{"h":1,"v":["Dislike"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"],", ",["l","雷欧","Leo"]]]]]]]]}