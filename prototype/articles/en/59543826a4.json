{"s":[[null,1,[["p",["The Ancient Drum is an ",["l","古物","Artifact"]," that can be found by digging up an ",["l","远古斑点","Artifact Spot"]," in ",["l","煤矿森林","Cindersap Forest"],", ",["l","鹈鹕镇","Pelican Town"],", or the ",["l","巴士站","Bus Stop"]," area. It can also be found inside ",["l","冰封晶球","Frozen Geode"],"s, ",["l","万象晶球","Omni Geode"],"s, and ",["l","古物宝藏","Artifact Trove"],"s."]]]],["Donation",2,[["p",["Donation of this item contributes to the total count of donations for the ",["l","博物馆","Museum"],". After donating at least 2 other ",["l","古物","artifacts"],", donation of the Ancient Drum rewards the player with a ",["l","鼓块","Drum Block"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Like"]},[["l","矮人","Dwarf"],", ",["l","潘妮","Penny"]]],[{"h":1,"v":["Dislike"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"],", ",["l","雷欧","Leo"]]]]]]],["Tailoring",2,[["p",["The Ancient Drum is used in the spool of the ",["l","柳巷2号#Sewing Machine","Sewing Machine"]," to create the ",["l","裁缝","Regal Mantle"],". ",["f","Shirt243.png",24]," It can be used in ",["l","染色","dyeing"],", serving as a purple dye at the dye pots, located in ",["l","艾米丽","Emily"],"'s and ",["l","海莉","Haley"],"'s house, ",["l","柳巷2号","2 Willow Lane"],"."]]]],["Quests",2,[["p",["The Ancient Drum i