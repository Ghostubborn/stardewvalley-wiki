{"s":[[null,1,[["p",["Cactus Seeds are a type of seed. Mature plants yield ",["l","仙人掌果子","Cactus Fruit"],"."]],["p",["They can be purchased only from ",["l","桑迪","Sandy"]," at the ",["l","绿洲","Oasis"]," for 150g. Two to five Cactus Seeds can also be obtained from a ",["l","沙鱼","Sandfish"]," or ",["l","蝎鲤鱼","Scorpion Carp"]," ",["l","鱼塘","Fish Pond"]," when the population of the pond reaches 10. Fifteen Cactus Seeds may occasionally be found in ",["l","骷髅洞穴","treasure rooms"]," in the Skull Cavern."]],["p",["Cactus seeds may only be planted in the ",["l","温室","Greenhouse"],", inside another building using a ",["l","花盆","Garden Pot"],", or on ",["l","姜岛","Ginger Island"],"."]],["p",["Harvesting Cactus plants gives ",["l","耕种","Farming"]," experience points."]]]],["Stages",2,[["t",[[{"h":1,"v":["Stage 1"]},{"h":1,"v":["Stage 2"]},{"h":1,"v":["Stage 3"]},{"h":1,"v":["Stage 4"]},{"h":1,"v":["Stage 5"]},{"h":1,"v":["Harvest"]},{"h":1,"v":["After-Harvest"]}],[[["f","Cactus_Stage_1.png",48]],[["f","Cactus_Stage_2.png",48]],[["f","Cactus_Stage_3.png",48]],[["f","Cactus_Stage_4.png",48]],[["f","Cactus_Stage_5.png",48]],[["f","Cactus_Stage_6.png",48]],[["f","Cactus_Stage_7.png",48]]],[["2 Days"],["2 Days"],["2 Days"],["3 Days"],["3 Days"],["Total: 12 Days"],["Regrowth: 3 Days"]]]]]],["Gifting",2,[["t",[[{"h":1,"v":["Dislike"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","皮埃尔","Pierre"],", ",["l","莱纳斯","Linus"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l",