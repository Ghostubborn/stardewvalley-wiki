q",["We require [quantity] [item]..."],[]],["q",["[quantity] [item] would allow us to multiply further."],[]],["q",["We've decided that we need [quantity] [item]."],[]],["q",["We need [quantity] [item]! We need [quantity] [item]!"],[]],["p",["Carnivorous fish"]],["q",["We're hungry... could you bring us [quantity] [item]?"],[]],["q",["Could you bring us [quantity] [item] for our dinner?"],[]],["q",["We need protein... [quantity] [item] should do the trick!"],[]],["p",["If player is male"]],["q",["Hey, landlubber, you think you could bring us [quantity] [item]?"],[]],["q",["Oi... leg boy! How about bringing us [quantity] [item], huh?"],[]],["q",["Psst... Hey, buddy... think you could send [quantity] [item] our way?"],[]],["p",["If player is female"]],["q",["Hey, land dweller, you think you could bring us [quantity] [item]?"],[]],["q",["Hey, lady... You got [quantity] [item] you can send our way?"],[]],["q",["Psst... think you could nab us [quantity] [item] on the sly?"],[]]]],["d","After Completing A Quest",[["p",["Ah... the [item] we requested."]],["q",["This [item] is satisfactory for our needs."],[]],["q",["The fish look satisfied with the [item]."],[]],["q",["Thank you! Thank you!"],[]],["q",["[item]! [item]! [item]! We're happy!"],[]],["q",["The fish are swimming in circles."],[]],["q",["Wow, thanks for the [item]!"],[]],["q",["Hey, look, it's [item]. Just what we needed!"],[]],["q",["Hey! This [item] looks pretty nice!"],[]],["q",["Thank you! This [item] will keep us healthy."],[]],["q",["Ah, [item]... this really makes us feel at home."],[]],["q",["Everyone, look... fresh [item]!"],[]],["q",["The fish seem happy."],[]],["p",["Eel"]],["q",["Cha cha cha! We're in business."],[]],["q",["Ah... it's the good stuff. Thanks, kid."],[]],["q",["Thanks, boss!"],[]],["p",["Carnivorous fish"]],["q",["Looks like [item] is on the menu tonight!"],[]],["q",["Fresh [item]! Yum..."],[]],["q",["This [item] looks delicious. Thank you!"],[]]]]]],["Notes",2,[["l",0,[[1,["The decorations around the Fish Pond can be changed only after the pond is populated by at least one fish. Right-clicking on the pond opens a menu where the decorations can be changed. The initial decoration style is chosen randomly when purchasing the pond."]],[1,[["l","鱼#Legendary Fish","Legendary Fish"],", ",["l","鱼#Legendary Fish II","Legendary Fish II"],", ",["l","岩浆鳗鱼","Lava Eel"],"s, ",["l","大海参","Super Cucumber"],"s, ",["l","史莱姆鱼","Slimejack"],"s, and ",["l","虚空鲑鱼","Void Salmon"],"s change the color of the pond water. For the Legendary Fish and Legendary Fish II, the color change happens overnight. For Lava Eels, the color change happens after the first quest is completed. For the other fish, the color changes when the population reaches 3 (if the third fish is thrown into the pond, the color change happens overnight)."]],[1,["Placing a sign (",["l","石牌","stone"],", ",["l","木牌","wood"]," or ",["l","深色牌子","dark"],") or a ",["l","船标","Sign Of The Vessel"]," on the pond will turn it into a counter of how many fish are inside, with a sprite of the fish visible on the sign, and a number in the lower right corner. This number won't be visible for ",["l","鱼#Legendary Fish","Legendary Fish"]," and ",["l","鱼#Legendary Fish II","Legendary Fish II"],"."]]]],["g",[["Fishpondsigns.PNG",320,["(Clockwise from upper left) ",["l","木牌","Wood Sign"],", ",["l","石牌","Stone Sign"],", ",["l","深色牌子","Dark Sign"],", and ",["l","船标","Sign Of The Vessel"]]],["Legend_Fish_Pond_Colours.png",320,["Legendary Fish pond water"]],["Legend_Family_Fish_Pond_Colours.png",320,["Legendary Fish II pond water"]]]],["l",0,[[1,["The pond can be used to refill ",["l","喷壶","Watering Cans"],"."]],[1,["After raising a pond full of 10 ",["l","螃蟹","Crab"],"s, the next time the player talks to ",["l","威利","Willy"],", he will have special dialogue and give the player a ",["l","珍珠","Pearl"],"."]]]]]],["Bugs",2,[["l",0,[[1,["Colored items like jelly will appear with their default color when thrown into a pond."]],[1,["If a sign is placed on a fish pond for a fish that triggers a quest at 1 fish, the sign will not show a quantity until after the 1-fish quest is completed."]]]]]],["History",2,[["l",0,[[1,[["l","版本历史#1.4","1.4"],": Introduced."]],[1,[["l","版本历史#1.4.4","1.4.4"],": Fixed bug where ",["l","鲶鱼","Catfish"],", ",["l","章鱼","Octopus"],", ",["l","大海参","Super Cucumber"],", and ",["l","虹鳟鱼","Rainbow Trout"]," fish ponds issued the wrong quests and yielded production and spawns at incorrect rates."]],[1,[["l","版本历史#1.5","1.5"],": Added ",["l","狮子鱼","Lionfish"],", ",["l","蓝铁饼鱼","Blue Discus"],", and ",["l","黄貂鱼","Stingray"]," fish ponds."]],[1,[["l","版本历史#1.6","1.6"],": Added ",["l","虾虎鱼","Goby"]," fish pond. Adjusted ",["l","比目鱼","Flounder"],", ",["l","午夜鲤鱼","Midnight Carp"],", and ",["l","岩浆鳗鱼","Lava Eel"]," fish ponds. When resetting a fish pond, existing fish will now flop out instead of simply vanish. Fish Ponds can now be buffed with ",["l","金色动物饼干","Golden Animal Cracker"],"s and now have a chance to produce extra ",["l","鱼籽","Roe"],"."]],[1,[["l","版本历史#1.6.4","1.6.4"],": Flopping fish can no longer fall back into fish ponds."]],[1,[["l","版本历史#1.6.9","1.6.9"],": The quantity of the item produced by a Fish Pond is now shown prior to collecting it. Fixed fish ponds accepting multiple ",["l","金色动物饼干","golden crackers"]," before the first one lands in the water. Fixed exploit where a Fish Pond with a golden cracker could produce unlimited output. Can now put ",["l","鱼#Legendary Fish","Legendary Fish"]," and ",["l","鱼#Legendary Fish II","Legendary Fish II"]," into fish ponds."]],[1,[["l","版本历史#1.6.13","1.6.13"],": Signs placed on legendary fish ponds no longer show a \"1\" under the fish."]],[1,[["l","版本历史#1.6.15","1.6.15"],": Increased roe production rate for ",["l","鱼#Legendary Fish","Legendary Fish"]," and ",["l","鱼#Legendary Fish II","Legendary Fish II"]," in fish ponds."]]]]]]],"f":[["Build cost",["5,000g"]],["Build materials",[["i","(O)390","Stone ×200"],["i","(O)152","Se