{"s":[[null,1,[["p",["The Strange Doll is an ",["l","古物","Artifact"]," that can be found by digging up an ",["l","远古斑点","Artifact Spot"]," in many locations (",["l","农场","The Farm"],", the ",["l","巴士站","Bus Stop"],", ",["l","鹈鹕镇","Pelican Town"],", ",["l","沙滩","The Beach"],", or ",["l","煤矿森林","Cindersap Forest"],"), or in ",["l","钓鱼","Fishing Treasure Chests"]," after reaching ",["l","钓鱼","Fishing level 2"],". It may also rarely be found by ",["l","锄头","tilling"]," soil in ",["l","矿井","The Mines"]," or ",["l","骷髅洞穴","Skull Cavern"],". One Strange Doll (green) is always obtained after solving the secret in ",["l","秘密纸条","Secret Note #17"],"."]]]],["Donation",2,[["p",["Donation of this item contributes to the total count of donations for the ",["l","博物馆","Museum"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Love"]},[["l","贾斯","Jas"]]],[{"h":1,"v":["Like"]},[["l","矮人","Dwarf"],", ",["l","潘妮","Penny"]]],[{"h":1,"v":["Dislike"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"],", ",["l","雷欧","Leo"]]]]]]],["Tailoring",2,[["p",["The Strange Doll (green) is used in the spool of the ",["l","柳巷2号","Sewing Machine"]," to create the ",["l","裁缝","Wumbus Shirt"],". ",["f","Shirt135.png",24]," It can be used in ",["l","染色","dyeing"],", serving as a green dye at the dye pots, located in ",["l","艾米丽","Emily"],"'s and ",["l","海莉","Haley"],"'s house, ",["l","柳巷2号","2 Willow Lane"],"."]]]],["Trivia",2,[["l",0,[[1,["Both the Strange Dolls resemble characters in a series of webcomics called Wumbus World, created by ",["l","ConcernedApe","ConcernedApe"]," in 2011. The green Strange Doll also resembles the ",["l","温布斯雕像","Wumbus Statue"]," and the protagonist of the film ",["l","电影院","Wumbus"],", which are also references to the webcomic."]]]]]]]}