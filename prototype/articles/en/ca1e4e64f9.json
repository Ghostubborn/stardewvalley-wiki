{"s":[[null,1,[["p",["The Immunity Band is a ",["l","戒指","ring"]," that can be dropped as a ",["l","矿井","special item"]," in ",["l","矿井","the Mines"]," on floors 100+, the ",["l","采石场矿井","Quarry Mine"],", and the ",["l","骷髅洞穴","Skull Cavern"],"."]],["p",["The Immunity Band increases ",["l","免疫","Immunity"]," by 4."]],["p",["Equipping a second Immunity Band adds a further 4 Immunity."]]]],["Dyeing",2,[["p",["Immunity Band can be used in ",["l","染色","dyeing"],", serving as a purple dye at the dye pots, located in ",["l","艾米丽","Emily"],"'s and ",["l","海莉","Haley"],"'s house, ",["l","柳巷2号","2 Willow Lane"],"."]]]]]}