{"s":[[null,1,[["p",["Tomato Seeds are a type of seed. Mature plants yield ",["l","西红柿","Tomato"],"es."]],["p",["They can be purchased at ",["l","皮埃尔的杂货店","Pierre's General Store"],", at ",["l","Joja超市","JojaMart"],", from the Magic Shop Boat at the ",["l","夜市","Night Market"]," on Winter 16, and occasionally from the ",["l","旅行货车","Traveling Cart"],". They can also be obtained by using the ",["l","种子生产器","Seed Maker"],". Five to twenty Tomato Seeds may occasionally be found in ",["l","骷髅洞穴#Treasure Rooms","treasure rooms"]," in the Skull Cavern."]]]],["Stages",2,[["p",["When harvested, each Tomato plant gives 1 Tomato every 4 days, with a 5% chance for more Tomatoes."]],["t",[[{"h":1,"v":["Stage 1"]},{"h":1,"v":["Stage 2"]},{"h":1,"v":["Stage 3"]},{"h":1,"v":["Stage 4"]},{"h":1,"v":["Stage 5"]},{"h":1,"v":["Harvest"]},{"h":1,"v":["After-Harvest"]}],[[["f","Tomato_Stage_1.png",48]],[["f","Tomato_Stage_2.png",48]],[["f","Tomato_Stage_3.png",48]],[["f","Tomato_Stage_4.png",48]],[["f","Tomato_Stage_5.png",42]],[["f","Tomato_Stage_6.png",42]],[["f","Tomato_Stage_7.png",42]]],[["2 Days"],["2 Days"],["2 Days"],["2 Days"],["3 Days"],["Total: 11 Days"],["Regrowth: 4 Days"]]]]]],["Gifting",2,[["t",[[{"h":1,"v":["Dislike"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","San