{"s":[[null,1,[["p",[["l","哈维的诊所","Harvey's Clinic"]," is located in the center of ",["l","鹈鹕镇","Pelican Town"],", next to ",["l","皮埃尔的杂货店","Pierre's General Store"],". ",["l","哈维","Harvey"]," lives and works at the clinic. ",["l","玛鲁","Maru"]," works there on ",["l","周循环","Tuesday"]," and ",["l","周循环","Thursday"],". Both of them often complain about the lack of patients."]],["p",["Most ",["l","居民","villagers"]," will visit the clinic for their annual checkup. ",["l","乔治","George"]," and ",["l","艾芙琳","Evelyn"]," visit the clinic once per season."]],["p",["Although you can enter the Clinic most days between 9am and 3pm, you cannot purchase medical supplies unless ",["l","玛鲁","Maru"]," or ",["l","哈维","Harvey"]," is behind the supplies counter."]]]],["Medical Supplies",2,[["p",["Gifting medical supplies is possible, but both items are ",["l","友谊","universally hated"],"."]],["t",[[{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Effects"]},{"h":1,"v":["Purchase Price"]},{"h":1,"v":["Sell Price"]},{"h":1,"v":["Other Sources"]}],[["Energy Tonic"],["Restores a lot of energy."],[["l","能量","Energy ×500"],["l","生命值","Health ×0"]],["1,000g"],["500g"],[["l","蝙蝠","Iridium Bat"]," drop (5%)Gift from ",["l","潘姆","Pam"]," in the mail",["l","骷髅洞穴","Treasure Rooms"]," in the Skull Cavern",["l","塞巴斯蒂安","Sebastian"],"'s ",["l","沙漠节","shop"]," during the ",["l","沙漠节","Desert Festival"]]],[["Muscle Remedy"],["When you've pushed your body too hard, drink this to remove 'Exhaustion'."],{"b":[["p",[["l","能量","Energy ×50"],["l","生命值","Health ×22"]]],["l",0,[[1,["Removes the ",["l","能量","Exhaustion"]," indicator"]]]]]},["1,000g"],["500g"],[["l","亚历克斯","Alex"],"'s ",["l","沙漠节","shop"]," during the ",["l","沙漠节","Desert Festival"]]]]]]],["Tailoring",2,[["p",["Energy Tonic is used in the spool of the ",["l","柳巷2号","Sewing Machine"]," to create the ",["l","裁缝","Letterman Jacket"],". It can be also used as a red dye color at the dye pots in ",["l","艾米丽","Emily"],"'s and ",["l","海莉","Haley"],"'s house, ",["l","柳巷2号","2 Willow Lane"],"."]],["p",["Muscle Remedy is used in the spool of the ",["l","柳巷2号","Sewing Machine"]," to create the dyeable ",["l","裁缝","Fake Muscles Shirt"],". It can be also used as a yellow dye color at the dye pots in ",["l","艾米丽","Emily"],"'s and ",["l","海莉","Haley"],"'s house, ",["l","柳巷2号","2 Willow Lane"],"."]]]],["Appointments",2,[["p",["Note that the start times are when the villager leaves home to travel to the clinic. The end times are when the villager leaves the clinic."]]]],["Spring",3,[["t",[[{"h":1,"v":["Day"]},{"h":1,"v":["Villager"]},{"h":1,"v":["Time"]}],[["02"],[["l","艾芙琳","Evelyn"]],["10:30am - 4:00pm"]],[["04"],[["l","阿比盖尔","Abigail"]],["12:30pm - 4:00pm"]],[["09"],[["l","威利","Willy"]],["10:10am - 4:00pm"]],[["11"],[["l","文森特","Vincent"]],["11:30am - 4:00pm"]],[["11"],[["l","乔迪","Jodi"]," (with Vincent)"],["11:30am - 4:00pm"]],[["16"],[["l","莉亚","Leah"]],["10:30am - 4:00pm"]],[["18"],[["l","乔迪","Jodi"]],["11:30am - 4:00pm"]],[["23"],[["l","乔治","George"]],["10:30am - 4:00pm"]],[["23"],[["l","艾芙琳","Evelyn"]," (with George)"],["10:40am - 4:10pm"]],[["25"],[["l","潘姆","Pam"]],["11:30am - 4:00pm"]]]]]],["Summer",3,[["t",[[{"h":1,"v":["Day"]},{"h":1,"v":["Villager"]},{"h":1,"v":["Time"]}],[["02"],[["l","艾芙琳","Evelyn"]],["10:30am - 4:00pm"]],[["04"],[["l","塞巴斯蒂安","Sebastian"]],["10:00am - 4:00pm"]],[["09"],[["l","艾利欧特","Elliott"]],["10:30am - 4:00pm"]],[["16"],[["l","亚历克斯","Alex"]],["10:30am - 4:00pm"]],[["18"],[["l","罗宾","Robin"]],["8:00am - 4:00pm"]],[["23"],[["l","乔治","George"]],["10:30am - 4:00pm"]],[["23"],[["l","艾芙琳","Evelyn"]," (with George)"],["10:40am - 4:10pm"]],[["25"],[["l","德米特里厄斯","Demetrius"]],["8:20am - 4:00pm"]]]]]],["Fall",3,[["t",[[{"h":1,"v":["Day"]},{"h":1,"v":["Villager"]},{"h":1,"v":["Time"]}],[["02"],[["l","艾芙琳","Evelyn"]],["10:30am - 4:00pm"]],[["04"],[["l","格斯","Gus"]],["10:30am - 4:00pm"]],[["09"],[["l","刘易斯","Lewis"]],["10:30am - 4:00pm"]],[["11"],[["l","山姆","Sam"]],["11:30am - 4:00pm"]],[