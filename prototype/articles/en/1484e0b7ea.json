{"s":[[null,1,[["p",["Emerald is a ",["l","矿物","Mineral"],". It can be obtained from ",["l","采矿","Emerald Node"],"s and ",["l","采矿","Gem Node"],"s in ",["l","矿井","the Mines"],", from ",["l","淘盘","panning"],", or in ",["l","钓鱼","Fishing Treasure Chests"],". It has a 10% chance to be dropped by a slain ",["l","矮人哨兵","Dwarvish Sentry"]," in the ",["l","火山地牢","Volcano Dungeon"],". It may occasionally be found in a ",["l","垃圾桶","Garbage Can"]," after the player has reached the bottom of the mines. It can also be received as a gift at the ",["l","冬日星盛宴","Feast of the Winter Star"],". The ",["l","无尽财富之雕像","Statue Of Endless Fortune"]," produces an Emerald on the birthdays of ",["l","克林特","Clint"],", ",["l","艾米丽","Emily"],", and ",["l","潘妮","Penny"],"."]],["p",[["l","奶酪","Cheese"]," may be purchased at the ",["l","沙漠商人","Desert Trader"]," on ",["l","周循环","Fridays"]," in exchange for 1 Emerald."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Love"]},[["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","艾米丽","Emily"],", ",["l","矮人","Dwarf"]]],[{"h":1,"v":["Like"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","潘姆","Pam"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"],", ",["l","雷欧","Leo"]]],[{"h":1,"v":["Dislike"]},[["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","莉亚","Leah"]]]]]]],["Bundles",2,[["p",["Emerald is one of the options for the treasure hunter Bundle."]]]],["Forging",2,[["p",["Emerald can be used at the ",["l","锻造","Forge"]," to increase the speed of a melee weapon."]]]],["Recipes",2,[["p",["Emerald is not used in any ",["l","烹饪","recipes"],"."]]]],["Tailoring",2,[["p",["Emerald is used in the spool of the ",["l","柳巷2号","Sewing Machine"]," to create a ",["l","裁缝","Shirt"],". ",["f","Shirt144.png",24]," It can be used in ",["l","染色","dyeing"],", serving as a green dye at the dye pots, located in ",["l","艾米丽","Emily"],"'s and ",["l","海莉","Haley"],"'s house, ",["l","柳巷2号","2 Willow Lane"],"."]]]],["Quests",2,[["l",0,[[1,["Emerald may be randomly requested during any season at the ",["l","任务","\"Help Wanted\" board"]," outside ",["l","皮埃尔的杂货店","Pierre's General Store"]," for a reward of 750g and 150 ",["l","友谊","Friendship"]," points. Emerald will never be requested until you have reached floors 80+ of ",["l","矿井","The Mines"],"."]],[1,["Two Emeralds may be requested by ",["l","章鱼","Octopus"],", ",["l","虹鳟鱼","Rainbow Trout"],", ",["l","幽灵鱼","Spook Fish"],", or ",["l","大海参","Super Cucumber"]," in a ",["l","鱼塘","Fish Pond quest"]," to increase the capacity of the pond from 5 to 7."]],[1,["Emerald will be requested by ",["l","艾米丽","Emily"]," as part of the \"Rock Rejuvenation\" quest at the ",["l","任务","Special Orders"]," board outside Mayor ",["l","刘易斯","Lewis"],"' house."]],[1,["May be used in the ",["l","姜岛","Gem Birds"]," puzzle on Ginger Island."]]]]]]]}