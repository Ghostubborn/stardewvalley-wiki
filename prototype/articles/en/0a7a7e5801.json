{"s":[[null,1,[["p",["Summer Squash Seeds are a type of seed. Mature plants yield ",["l","金皮西葫芦","Summer Squash"],"es."]],["p",["They cannot be purchased using ",["l","金币","Gold"]," from any traditional store, and are instead found in various other ways:"]],["l",0,[[1,["Digging up ",["l","绿色斑点","Seed Spot"],"s."]],[1,["Completing ",["l","大树桩（地点）","Raccoon"]," requests."]],[1,["Trading at the ",["l","大树桩（地点）","Raccoon Wife's Shop"]," for 15 ",["i","(O)92","Sap"],"."]],[1,["Catching ",["l","钓鱼","Golden Fishing Treasure Chests"]," (7% chance)."]],[1,["Using the ",["l","种子生产器","Seed Maker"],"."]],[1,["As the first prize from the Prize Machine in the ",["l","镇长的庄园","Mayor's Manor"],"."]],[1,["Opening ",["l","谜之盒","Mystery Box"],"es or ",["l","金色谜之盒","Golden Mystery Box"],"es."]],[1,["Breaking open ",["l","矿井","crates and barrels"]," in ",["l","矿井","the Mines"],", ",["l","骷髅洞穴","Skull Cavern"],", or ",["l","火山地牢","Volcano Dungeon"]," (2% chance)."]],[1,["Slaying ",["l","铱石魔","Iridium Golem"],"s (50% chance)."]]]],["p",["All methods, other than trading at the Raccoon Wife's Shop and using the Seed Maker, only yield Summer Squash Seeds between ",["l","春季","Spring"]," 24 and ",["l","夏季","Summer"]," 20."]]]],["Stages",2,[["t",[[{"h":1,"v":["Stage 1"]},{"h":1,"v":["Stage 2"]},{"h":1,"v":["Stage 3"]},{"h":1,"v":["Stage 4"]},{"h":1,"v":["Stage 5"]},{"h":1,"v":["Harvest"]},{"h":1,"v":["After-Harvest"]}],[[["f","Summer_Squash_Stage_1.png",48]],[["f","Summer_Squash_Stage_2.png",48]],[["f","Summer_Squash_Stage_3.png",48]],[["f","Summer_Squash_Stage_4.png",48]],[["f","Summer_Squash_Stage_5.png",48]],[["f","Summer_Squash_Stage_6.png",48]],[["f","Summer_Squash_Stage_7.png",48]]],[["1 Day"],["1 Day"],["1 Day"],["1 Day"],["2 Day"],["Total: 6 Days"],["Regrowth: 3 Days"]]]]]],["Gifting",2,[["t",[[{"h":1,"v":["Dislike"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","雷欧","Leo"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"]]]]]]],["Tailoring",2,[["p",["Summer Squash Seeds are not used in any ",["l","裁缝","tailoring"],". They can be used in ",["l","染色","dyeing"],", serving as an orange dye at the dye pots located in ",["l","艾米丽","Emily"],"'s and ",["l","海莉","Haley"],"'s house, ",["l","柳巷2号","2 Willow Lane"],". They can also be used as a brown dye when used in the spool of the ",["l","缝纫机","Sewing Machine"]," with a dyeable clothing item in the feed."]]]]]}