{"s":[[null,1,[["p",["Oak Resin is a ",["l","树","Tree"]," sap made from the ",["l","树液采集器","Tapper"]," when it is placed on an ",["l","橡树","Oak Tree"],", taking 7 days, or 3 days with a ",["l","重型树液采集器","Heavy Tapper"],"."]],["p",["Oak Resin can be obtained by tapping ",["l","橡树","Oak Tree"],"s grown by the player or growing naturally in Stardew Valley (e.g., in ",["l","煤矿森林","Cindersap Forest"],"). It is also a rare drop from ",["l","幽灵头骨","Haunted Skulls"],", and can rarely be obtained after processing ",["l","硬木","Hardwood"]," in a ",["l","碎木机","Wood Chipper"],"."]],["p",["Although Oak Resin is labeled \"Artisan Good\" in-game, it does not benefit from the ",["l","技能#Farming","Artisan Profession"],", but instead from the ",["l","技能#Foraging","Tapper Profession"]," (+25% value)."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Like"]},[["l","玛鲁","Maru"]]],[{"h":1,"v":["Dislike"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"],", ",["l","雷欧","Leo"]]]]]]],["Bundles",2,[["l",0,[[1,["Oak Resin is used in the Bulletin Board."]],[1,["Oak Resin is one of the options for the Crafts Room."]]]]]],["Recipes",2,[["t",[[{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Ingredients"]},{"h":1,"v":["Recipe Source(s)"]},{"h":1,"v":["Sell Price"]}],[[["f","Keg.png",48]],[["l","小桶","Keg"]],["Place a fruit or vegetable in here. Eventually it will turn into a beverage."],[["i","(O)388","Wood ×30"],["i","(O)334","Copper Bar ×1"],["i","(O)335","Iron Bar ×1"],["i","(O)725","Oak Resin ×1"]],[["f","Farming_Skill_Icon.png",24]," ",["l","耕种","Farming"]," Level 8"],["N/A"]]]]]],["Tailoring",2,[["p",["Oak Resin can be used in the spool of the ",["l","柳巷2号#Sewing Machine","Sewing Machine"]," to create the ",["i","(H)54","Floppy Beanie"],". It can be used in ",["l","染色","dyeing"],", serving as a green dye at the dye pots, located in ",["l","艾米丽","Emily"],"'s and ",["l","海莉","Haley"],"'s house, ",["l","柳巷2号","2 Willow Lane"],"."]]]],["Quests",2,[["p",["One Oak Resin may be requested by ",["l","木跃鱼","Woodskip"]," in a ",["l","鱼塘#Quests","Fish Pond quest"]," to increase the capacity of the pond from 5 to 7."]]]],["History",2,[["l",0,[[1,[["l","版本历史#1.0","1.0"],": Introduced."]],[1,[["l","版本历史#1.4","1.4"],": Can now be used in ",["l","裁缝","Tailoring"],". Can be requested in a Fish Pond quest."]],[1,[["l","版本历史#1.5","1.5"],": Added ",["l","重型树液采集器","Heavy Tapper"],"."]]]]]]],"f":[["Source",["*",["l","打造","Crafting"],"\n*",["l","幽灵头骨","Haunted Skull (1.30%)"],"\n*",["l","碎木机","Wood Chipper"]," (0.66%)"]],["Season",["All"]],["Equipment",[["i","(BC)105","Tapper"]," ",["i","(BC)264","Heavy Tapper"]]],["Ingredients",[["l","橡树","Oak Tree"]]],["Processing Time",["7 or 3 days"]],["Sell Price",["150g"]]]}