{"s":[[null,1,[["p",["Truffle Oil is an ",["l","工匠物品","Artisan Good"]," made in the ",["l","产油机","Oil Maker"]," from a ",["l","松露","Truffle"],", taking 6 hours to produce. It can also be dropped from ",["l","松露蟹","Truffle Crab"],"s. One may be purchased from ",["l","玛妮","Marnie"],"'s ",["l","沙漠节#Villager Shops","shop"]," at the ",["l","沙漠节","Desert Festival"]," for 50 Calico Eggs ",["l","卡利科三花蛋","Calico Egg"],"s. Occasionally the ",["l","旅行货车","Traveling Cart"]," will offer it in her rotating stock."]],["p",["Despite being listed as \"A gourmet cooking ingredient\" there are no cooking recipes that use it, but it is used to make the ",["l","雨水图腾","Rain Totem"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Love"]},[["l","哈维","Harvey"]]],[{"h":1,"v":["Like"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"],", ",["l","雷欧","Leo"]]],[{"h":1,"v":["Hate"]},[["l","塞巴斯蒂安","Sebastian"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"]]]]]]],["Bundles",2,[["p",["Truffle Oil is an option for the Pantry."]]]],["Crafting",2,[["p",["Truffle Oil is used to make the following items:"]],["t",[[{"h":1,"v":["Name"]},{"h":1,"v":["Description"]},{"h":1,"v":["Ingredients"]},{"h":1,"v":["Recipe Source(s)"]},{"h":1,"v":["Sell Price"]}]]]]],["Notes",2,[["p",["Without the ",["l","耕种#Farming Skill","Artisan Profession"],", iridium quality ",["l","松露","truffles"]," are worth more to sell outright rather than turn into oil."]]]],["Tailoring",2,[["p",["Truffle Oil can be used in the spool of the ",["l","柳巷2号#Sewing Machine","Sewing Machine"]," to create the dyeable ",["f","Shirt262a.png",24]," ",["l","裁缝","Dark Bandana Shirt"],". It can be used in ",["l","染色","dyeing"],", serving as a yellow dye at the dye pots, located in ",["l","艾米丽","Emily"],"'s and ",["l","海莉","Haley"],"'s house, ",["l","柳巷2号","2 Willow Lane"],"."]]]],["Quests",2,[["l",0,[[1,["Mayor ",["l","刘易斯","Lewis"]," requests Truffle Oil by mail on the 21st of ",["l","夏季","Summer"]," (year 2) in the ",["l","任务#Mayor's Need","\"Mayor's Need\" Quest"],". The reward is 750g and 1 ",["l","友谊","Friendship"]," heart.\nNote that Lewis will send the letter triggering the quest regardless of whether or not the player owns a ",["l","猪","pig"],"."]]]]]],["History",2,[["l",0,[[1,[["l","版本历史#1.0","1.0"],": Introduced."]],[1,[["l","版本历史#1.4","1.4"],": Can now be used in ",["l","裁缝","Tailoring"],"."]],[1,[["l","版本历史#1.6","1.6"],": Now dropped by ",["l","松露蟹","Truffle Crab"],"s. Now purchasable through ",["l","沙漠节","Desert Festival"],"."]]]]]]],"f":[["Source",[["l","工匠物品","Artisan Goods"]," • ",["l","沙漠节","Desert Festival"]," • ",["l","松露蟹","Truffle Crab"],"s • ",["l","旅行货车","Traveling Cart"]]],["Equipment",[["i","(BC)19","Oil Maker"]]],["Ingredients",[["i","(O)430","Truffle ×1"]]],["Processing Time",["360m (6h)"]],["Sell Price",["1,065g"]]]}