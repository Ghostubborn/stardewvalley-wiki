ey will reproduce every 2 days. The initial pond capacity is 3 fish, but the capacity can be increased to 10 by completing three quests. The primary output is orange Rainbow Trout ",["l","鱼籽","Roe"],". However, more valuable items are possible starting at population 9, including a 0.09% daily chance of producing a ",["l","五彩碎片","Prismatic Shard"],"."]],["p",[["l","鱼塘#Quests","Quests"]]],["t",[[{"c":2,"h":1,"v":["Pond Capacity"]},{"r":2,"h":1,"v":["Quest Item"]},{"r":2,"h":1,"v":["Fishing XP Granted"]}],[{"h":1,"v":["Before Quest"]},{"h":1,"v":["After Quest"]}],[["3"],["5"],["3 ",["l","珊瑚","Coral"],", 1 ",["l","蜂蜜","Honey"],", 1 ",["l","牡蛎","Oyster"],", or 3 ",["l","精炼石英","Refined Quartz"]],["30"]],[["5"],["7"],["1 ",["l","干海星","Dried Starfish"],", 2 ",["l","绿宝石","Emerald"],"s, 2-3 ",["l","万象晶球","Omni Geode"],"s, or 2-3 ",["l","紫蘑菇","Purple Mushroom"],"s"],["30"]],[["7"],["10"],["1 ",["l","钻石","Diamond"],", 3 ",["l","金锭","Gold Bar"],"s, 1 ",["l","铱矿石","Iridium Ore"],", 1 ",["l","果酱和腌菜","Jelly"],", or 1 ",["l","果酱和腌菜","Pickle"]],["30"]]]],["p",[["l","鱼塘#Produce","Produce"]]],["t",[[{"h":1,"v":["Item(s) Produced"]},{"h":1,"v":["Fishing XP Granted"]},{"h":1,"v":["Population"]},{"h":1,"v":["% of Items"]},{"h":1,"v":["Overall Daily Chance"]}],[{"r":2,"v":[["l","鱼籽","Roe ×1"]]},{"r":2,"v":["12"]},["1-8"],["100%"],["23-79%"]],[["9-10"],["98%"],["85-93%"]],[[["i","(O)394","Rainbow Shell ×1"]],["22"],["9-10"],["2%"],["1.7-1.9%"]],[[["i","(O)74","Prismatic Shard ×1"]],["90"],["9-10"],["0.1%"],["0.09%"]],[{"r":2,"v":["Nothing"]},{"r":2,"v":[]},["1-8"],["0%"],["77-21%"]],[["9-10"],["0%"],["13-5%"]]]]]],["Quests",2,[["l",0,[[1,["Item Delivery: One rainbow trout may be randomly requested in ",["l","夏季","Summer"]," at the ",["l","任务#Help Wanted Quests","\"Help Wanted\" board"]," outside ",["l","皮埃尔的杂货店","Pierre's General Store"]," for a reward of 195g and 150 ",["l","友谊","Friendship"]," points."]],[1,["Fishing: ",["l","德米特里厄斯","Demetrius"]," or ",["l","威利","Willy"]," may randomly request 1-4 rainbow trout during ",["l","夏季","Summer"]," at the ",["l","任务#Help Wanted Quests","\"Help Wanted\" board"]," outside ",["l","皮埃尔的杂货店","Pierre's General Store"]," for a reward of 65g per fish. (You get to keep the fish)."]],[1,["Aquatic Overpopulation: ",["l","德米特里厄斯","Demetrius"]," may request 10 Rainbow Trout to be caught in ",["l","夏季","Summer"]," at the ",["l","任务#List of Special Orders","Special Orders board"]," outside the ",["l","镇长的庄园","Mayor's Manor"]," for a reward of gold equivalent to selling the fish and the ",["l","农场电脑","Farm Computer"]," recipe."]]]]]],["History",2,[["l",0,[[1,[["l","版本历史#1.4","1.4"],": Added iridium quality. Can now be used in ",["l","裁缝","Tailoring"],"."]],[1,[["l","版本历史#1.4.4","1.4.4"],": Fixed a mistake in the game data that prevented rainbow trout-specific fish pond data from being applied (in earlier versions, rainbow trout used the same fish pond data as all generic river fish)."]],[1,[["l","版本历史#1.5","1.5"],": Special Order quest added."]],[1,[["l","版本历史#1.6","1.6"],": Can now be caught during the entire day and in the rain when the ",["l","鳟鱼大赛","Trout Derby"]," festival is active. Can now be gifted by a ",["l","动物#Pets","pet"]," cat with max ",["l","动物#Friendship","friendship"],"."]]]]]]]}