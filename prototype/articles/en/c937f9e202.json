{"s":[[null,1,[["p",["The Drum Block is a ",["l","打造","crafted"]," piece of Furniture. The recipe can be obtained from ",["l","罗宾","Robin"],"'s 6 heart event. One Drum Block is the reward for donating 3 ",["l","古物","artifacts"]," that include the ",["l","古代鼓","Ancient Drum"]," to the ",["l","博物馆","Museum"],"."]]]],["Music",2,[["p",["A placed drum block emits a percussive sound when a player walks next to it, and then once per second if they stay near it. You can right-click a drum block to change drum sound. There are 7 possible sounds, after which right-clicking again will reset to the first one."]],["p",["You can place a series of drum blocks and ",["l","长笛块","flute blocks"]," to create music as you walk along them."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Hate"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","雷欧","Leo"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","科罗布斯","Krobus"]]]]]]]],"f":[["Source",[["l","打造","Crafting"],["l","博物馆","Museum"]," donation"]],["Ingredients",[["i","(O)390","Stone ×10"],["i","(O)378","Copper Ore ×2"],["i","(O)771","Fiber ×20"]]],["Sell Price",["100g"]]]}