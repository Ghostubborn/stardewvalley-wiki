{"s":[[null,1,[["p",["See also: ",["l","鱿鱼节","SquidFest"],"."]],["p",["The Squid is a ",["l","鱼","fish"]," that can be caught in the ocean at ",["l","沙滩","The Beach"]," or on the ",["l","农场地图","Beach Farm"]," in the evening during ",["l","冬季","Winter"],". It can also randomly be found in ",["l","垃圾桶","Garbage Can"],"s during Winter, or at the ",["l","旅行货车","Traveling Cart"]," for 240–1,000g. Squid can be caught during the entire day on Winter 12th and 13th during the ",["l","鱿鱼节","SquidFest"]," festival. ",["l","皮埃尔","Pierre"]," sells five Squid for 10 Calico Eggs ",["l","卡利科三花蛋","Calico Egg"],"s each during the ",["l","沙漠节","Desert Festival"],"."]],["p",["When placed in a ",["l","鱼塘","Fish Pond"],", Squid will produce ",["l","鱿鱼墨汁","Squid Ink"]," instead of ",["l","鱼籽","Roe"],", although Squid Roe can be found in ",["l","钓鱼","Fishing Treasure Chests"]," after obtaining the power from the ",["l","海之宝石","Jewels Of The Sea"]," book."]],["p",["Squid can be caught regardless of time of day or season using ",["l","魔法鱼饵","Magic Bait"],"."]]]],["Map",2,[["p",["The Squid can be found in the ocean."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Like"]},[["l","艾利欧特","Elliott"]]],[{"h":1,"v":["Neutral"]},[["l","德米特里厄斯","Demetrius"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","威利","Willy"],", ",["l","雷欧","Leo"]]],[{"h":1,"v":["Dislike"]},[["l","罗宾","Robin"],", ",["l","玛鲁","Maru"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","艾米丽","Emily"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","科罗布斯","Krobus"]]],[{"h":1,"v":["Hate"]},[["l","皮埃尔","Pierre"],", ",["l