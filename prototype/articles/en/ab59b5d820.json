{"s":[[null,1,[["p",["The Pirate Hat is a ",["l","帽子","hat"]," that can be ",["l","裁缝#Hats","tailored"]," using ",["l","布料","Cloth"]," and a ",["l","财宝箱","Treasure Chest"]," at the sewing machine inside ",["l","柳巷2号","Emily's house"]," or the ",["l","缝纫机","Sewing Machine"]," received as a reward for the ",["l","任务#Rock Rejuvenation","\"Rock Rejuvenation\""]," special order."]],["p",["There is a small chance to receive this hat from slaying ",["l","怪物","monsters"],", breaking ",["l","矿井#Crates and Barrels","crates and barrels"],", chopping ",["l","树","trees"],", shaking trees with seeds, digging ",["l","远古斑点","Artifact Spot"],"s, or ",["l","淘盘","panning"],"."]]]],["Secret",2,[["d","Details",[["p",["While wearing it, speaking to the bartender in the ",["l","姜岛#Pirate Cove","Pirate Cove"]," causes him to give the player ",["l","蜜蜂酒","mead"],". This can only be done once per night."]]]]]],["History",2,[["l",0,[[1,[["l","版本历史#1.4","1.4"],": Introduced."]],[1,[["l","版本历史#1.6","1.6"],": Small chance added to receive from various player actions."]]]]]]]}