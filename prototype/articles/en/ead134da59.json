{"s":[[null,1,[["p",["The Wood Chipper is used to convert ",["l","硬木","Hardwood"]," and ",["l","浮木","Driftwood"]," into other products. It can be purchased from the ",["l","木匠的商店","Carpenter's Shop"]," for 1,000g starting the first day of ",["l","冬季","Winter"]," in year 1. The player receives a letter about the wood chipper from ",["l","罗宾","Robin"]," on the second day of Winter in year 1. A Wood Chipper may be purchased from ",["l","肯特","Kent"],"'s ",["l","沙漠节#Villager Shops","shop"]," at the ",["l","沙漠节","Desert Festival"]," for 25 Calico Eggs ",["l","卡利科三花蛋","Calico Egg"],"s."]]]],["Products",2,[["t",[[{"h":1,"v":["Input"]},{"c":2,"h":1,"v":["Outputs One Of"]},{"h":1,"v":["Processing Time"]}],[{"r":5,"v":[["i","(O)709","Hardwood ×1"]]},[["i","(O)388","Wood ×5–10"]],["96% chance"],{"r":6,"v":["180mins (3hrs)"]}],[[["i","(O)388","Wood ×15–20"]],["2% chance"]],[[["i","(O)724","Maple Syrup"]],["0.66% chance"]],[[["i","(O)725","Oak Resin"]],["0.66% chance"]],[[["i","(O)726","Pine Tar"]],["0.66% chance"]],[[["i","(O)169","Driftwood ×1"]],[["i","(O)388","Wood ×5–10"]],["100% chance"]]]]]],["History",2,[["l",0,[[1,[["l","版本历史#1.4","1.4"],": Introduced."]],[1,[["l","版本历史#1.6","1.6"],": Now obtainable from ",["l","沙漠节","Desert Festival"],"."]]]]]]],"f":[["Source",[["l","木匠的商店","Carpenter's Shop"]," for 1,000g"]]]}