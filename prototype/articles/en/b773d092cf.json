{"s":[[null,1,[["p",["Salad is a ",["l","烹饪","cooked dish"],". It is prepared using either the kitchen inside an upgraded ",["l","农舍","farmhouse"]," or a ",["l","野炊工具","Cookout Kit"],"."]],["p",["Salad is available for purchase daily at ",["l","星之果实酒吧","The Stardrop Saloon"]," for 220g and may randomly appear in ",["l","科罗布斯","Krobus"],"' shop on ",["l","周循环#Saturday","Saturdays"],". ",["l","莉亚","Leah"]," sells Salad for 20 Calico Eggs ",["l","卡利科三花蛋","Calico Egg"],"s in her ",["l","沙漠节#Villager Shops","shop"]," at the ",["l","沙漠节","Desert Festival"],". One Salad may be received from opening a ",["l","谜之盒","Mystery Box"],". The ",["l","无尽财富之雕像","Statue Of Endless Fortune"]," produces one Salad per year on ",["l","莉亚","Leah"],"'s birthday, ",["l","冬季","Winter 23"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Love"]},[["l","莉亚","Leah"]]],[{"h":1,"v":["Like"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","谢恩","Shane"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"]]],[{"h":1,"v":["Dislike"]},[["l","威利","Willy"],", ",["l","科罗布斯","Krobus"],", ",["l","雷欧","Leo"]]]]]]],["Bundles",2,[["p",["Salad is not used in any ",["l","收集包","bundles"],"."]]]],["Recipes",2,[["p",["Salad is not used in any recipes."]]]],["Tailoring",2,[["p",["Salad is used in the spool of the ",["l","柳巷2号#Sewing Machine","Sewing Machine"]," with ",["l","布料","Cloth"]," in the feed