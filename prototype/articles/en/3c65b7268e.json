{"s":[[null,1,[["p",["The Clam is a ",["l","鱼","fish"]," that can be caught using a ",["l","蟹笼","Crab Pot"]," in any ",["l","蟹笼#Saltwater","saltwater"]," body of water. It can also be ",["l","采集","foraged"]," from ",["l","沙滩","The Beach"],", gifted by a ",["l","动物#Pets","pet"]," turtle with max ",["l","动物#Friendship","friendship"],", or randomly found at the ",["l","旅行货车","Traveling Cart"]," for 150–1,000g. One Clam can sometimes be purchased for 500g from ",["l","皮埃尔","Pierre"],"'s booth at the ",["l","冬日星盛宴","Feast of the Winter Star"],". It may also be found foraging on levels 1-29 of ",["l","矿井","the Mines"]," while the ",["l","矿井#Shrine of Challenge","Shrine of Challenge"]," is enabled, or the ",["l","任务#Danger In The Deep","Danger in The Deep"]," quest is active. Like all fish caught from the crab pot, it cannot be eaten unless it is used in a ",["l","烹饪","Cooking"]," recipe or ",["l","熏鱼","smoked"],"."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Like"]},[["l","艾芙琳","Evelyn"]]],[{"h":1,"v":["Neutral"]},[["l","德米特里厄斯","Demetrius"],", ",["l","艾利欧特","Elliott"],", ",["l","雷欧","Leo"],", ",["l","莱纳斯","Linus"],", ",["l","潘姆","Pam"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","威利","Willy"]]],[{"h":1,"v":["Dislike"]},[["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","卡洛琳","Caroline"],", ",["l","克林特","Clint"],", ",["l","矮人","Dwarf"],", ",["l","艾米丽","Emily"],", ",["l","乔治","George"],", ",["l","格斯","Gus"],", ",["l","哈维","Harvey"],", ",["l","贾斯","Jas"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","科罗布斯","Krobus"],", ",["l","莉亚","Leah"],", ",["l","刘易斯","Lewis"],", ",["l","玛妮","Marnie"],", ",["l","玛鲁","Maru"],", ",["l","潘妮","Penny"],", ",["l","罗宾","Robin"],", ",["l","山姆","Sam"],", ",["l","桑迪","Sandy"],", ",["l","谢恩","Shane"],", ",["l","文森特","Vincent"],", ",["l","法师","Wizard"]]],[{"h":1,"v":["Hate"]},[["l","海莉","Haley"],", ",["l","皮埃尔","Pierre"]]]]]]],["Bundles",2,[["p",["Clam is an option for the Fish Tank."]]]],["Recipes",2,[["t",[[{"h":1,"v":["Name"]},{"h":1,"v"