{"s":[[null,1,[["p",["The Strange Bun is a ",["l","烹饪","cooked dish"],". It is prepared using either the kitchen inside an upgraded ",["l","农舍","farmhouse"]," or a ",["l","野炊工具","Cookout Kit"],"."]],["p",["Strange Bun may randomly appear in ",["l","科罗布斯","Krobus"],"' shop on ",["l","周循环#Saturday","Saturdays"],", in ",["l","星之果实酒吧","the Stardrop Saloon"],"'s rotating stock or the ",["l","垃圾桶","Garbage Can"]," outside the Saloon, or at the ",["l","旅行货车","Traveling Cart"]," for 675–1,125g. It may also be dropped by a ",["l","暗影狂徒","Shadow Brute"]," (4% chance). One Strange Bun may be received from opening a ",["l","谜之盒","Mystery Box"],". If ",["l","科罗布斯","Krobus"]," is the player's roommate, he may gift a Strange Bun in the morning."]],["p",["By offering a Strange Bun to the Dark Shrine of Night Terrors in the ",["l","女巫小屋","Witch's Hut"],", players can toggle ",["l","怪物","monster spawning"]," on or off on their farm."]]]],["Gifting",2,[["t",[[{"h":1,"v":["Like"]},[["l","科罗布斯","Krobus"]]],[{"h":1,"v":["Neutral"]},[["l","谢恩","Shane"]]],[{"h":1,"v":["Hate"]},[["l","罗宾","Robin"],", ",["l","德米特里厄斯","Demetrius"],", ",["l","玛鲁","Maru"],", ",["l","塞巴斯蒂安","Sebastian"],", ",["l","莱纳斯","Linus"],", ",["l","皮埃尔","Pierre"],", ",["l","卡洛琳","Caroline"],", ",["l","阿比盖尔","Abigail"],", ",["l","亚历克斯","Alex"],", ",["l","乔治","George"],", ",["l","艾芙琳","Evelyn"],", ",["l","刘易斯","Lewis"],", ",["l","克林特","Clint"],", ",["l","潘妮","Penny"],", ",["l","潘姆","Pam"],", ",["l","艾米丽","Emily"],", ",["l","海莉","Haley"],", ",["l","贾斯","Jas"],", ",["l","文森特","Vincent"],", ",["l","乔迪","Jodi"],", ",["l","肯特","Kent"],", ",["l","山姆","Sam"],", ",["l","莉亚","Leah"],", ",["l","玛妮","Marnie"],", ",["l","艾利欧特","Elliott"],", ",["l","格斯","Gus"],", ",["l","矮人","Dwarf"],", ",["l","法师","Wizard"],", ",["l","哈维","Harvey"],", ",["l","桑迪","Sandy"],", ",["l","威利","Willy"],", ",["l","雷欧","Leo"]]]]]]],["Bundles",2,[["p",["Strange Bun is not used in any ",["l","收集包","bundles"],"."]]]],["Recipes",2,[["p",["Strange Bun is not used in any recipes."]]]],["Tailoring",2,[["p",["Strange Bun is used in the spool of the ",["l","柳巷2号#Sewing Machine","Sewing Machine"]," to create the dyeable ",["l","裁缝","Heart Shirt"],". ",["f","Shirt028.png",24]," It can also be used as a red dye in the dye pots, located at ",["l","艾米丽","Emily"],"'s and ",["l","海莉","Haley"],"'s house, ",["l","柳巷2号","2 Willow Lane"],"."]]]],["Quests",2,[["p",["Strange Bun is not used in any ",["l","任务","quests"],"."]]]],["Secrets",2,[["p",["If a Strange Bun is placed in the toy chest inside ",["l","文森特","Vincent"],"'s room, at ",["l","柳巷1号","1 Willow Lane"],", the player will receive the ",["f","??Foroguemon??.png",16]," ",["l","??碎屑雕像??","??Foroguemon??"]," statue."]]]],["Trivia",2,[["l",0,[[1,["Although ",["l","谢恩","Shane"]," sends the recipe for the Strange Bun to the player, he's neutral to it as a gift."]]]]]],["History",2,[["l",0,[[1,[["l","版本历史#1.0","1.0"],": Introduced."]],[1,[["l","版本历史#1.1","1.1"],": Changed cooking ingredients; replaced ",["l","橡树树脂","Oak Resin"]," with ",["l","虚空蛋黄酱","Void Mayonnaise"],". Increased price."]],[1,[["l","版本历史#1.4","1.4"],": ",["l","谢恩","Shane"]," will now send a the recipe for Strange Bun in the mail after reaching 7 hearts, instead of 3 hearts. Fixed bug where an entire stack of Strange Buns would be consumed by interacting with ",["l","文森特","Vincent"],"'s toy chest. Can now be used in ",["l","裁缝","Tailoring"],"."]],[1,[["l","版本历史#1.5","1.5"],": Can now be prepared using a ",["l","野炊工具","Cookout Kit"],"."]],[1,[["l","版本历史#1.6","1.6"],": ",["l","科罗布斯","Krobus"]," now likes Strange Bun, ",["l","谢恩","Shane"]," is now neutral."]]]]]]]}